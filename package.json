{
  "name": "origin-english",
  "productName": "原境英语",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "author": "yuy",
  "description": "A calm Windows reading workspace for contextual English practice.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dictionary:build": "node scripts/build-simple-dictionary.mjs simplewiktionary-latest-pages-articles.xml src/main/assets/simple-wiktionary.data",
    "chinese-dictionary:build": "node scripts/build-ecdict-chinese.mjs ecdict.csv src/main/assets/simple-wiktionary.data src/main/assets/ecdict-chinese.data",
    "transcription:prepare": "node scripts/prepare-transcription-assets.mjs",
    "transcription:check": "node scripts/prepare-transcription-assets.mjs --check",
    "sentry:check": "node scripts/check-sentry-dsn.mjs",
    "sentry:check:send": "node scripts/check-sentry-dsn.mjs --send",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && electron-vite build",
    "release:win": "npm run transcription:check && npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "turndown": "^7.2.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/turndown": "^5.0.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "yazl": "^3.3.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.1": true
  }
}
