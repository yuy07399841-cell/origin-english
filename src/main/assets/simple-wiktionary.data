","l":"don","q":"noun"},"donned":{"h":"donned","l":"don","q":"verb"},"donning":{"h":"donning","l":"don","q":"verb"},"bout":{"h":"bout","i":"/ˈbaʊt/","a":"LL-Q1860 (eng)-Vealhurl-bout.wav","s":[{"p":"noun","d":[{"m":"(countable) A bout is a short period of activity, especially a painful or unpleasant one."}]}]},"bouts":{"h":"bouts","i":"/ˈbaʊts/","l":"bout","q":"noun"},"gargantuan":{"h":"gargantuan","i":"/ɡɑrˈɡæn.tʃu.ən/","a":"en-us-gargantuan.oga","s":[{"p":"adjective","d":[{"m":"If something is gargantuan, it is very big."}]}]},"bouillon":{"h":"bouillon","i":"/ˈbuː.jɒn/","a":"LL-Q1860 (eng)-Vealhurl-bouillon.wav","s":[{"p":"noun","d":[{"m":"(uncountable) A bouillon is a broth that is made by simmering meat, fish or vegetables."}]}]},"broth":{"h":"broth","i":"/brɔθ/","a":"en-us-broth.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Broth is water in which meat, fish or vegetable has been boiled."},{"m":"(countable) A broth is soup made from broth and other ingredients such as vegetables, herbs or diced meat."}]}]},"broths":{"h":"broths","l":"broth","q":"noun"},"belles":{"h":"belles","a":"LL-Q1860 (eng)-Vealhurl-belles.wav","l":"belle","q":"noun"},"regularise":{"h":"regularise","i":"/ˈrɛɡjəlɚaɪz/","a":"LL-Q1860 (eng)-Vealhurl-regularize.wav","s":[{"p":"verb","d":[{"m":"(transitive) To make regular.","e":"The regularisation of spelling was an important step in the advancement of literary society."},{"m":"(transitive) If you regularise something, you control it by defining it.","e":"The industry has fought the state's attempts to regularise its products."},{"m":"(transitive) If x regularises y, x causes y to function in a particular way.","e":"You turn this to regulate the water flow."}]}]},"regularises":{"h":"regularises","l":"regularise","q":"verb"},"regularised":{"h":"regularised","l":"regularise","q":"verb"},"regularising":{"h":"regularising","l":"regularise","q":"verb"},"monetizes":{"h":"monetizes","l":"monetize","q":"verb"},"monetizing":{"h":"monetizing","l":"monetize","q":"verb"},"monetized":{"h":"monetized","l":"monetize","q":"verb"},"monetise":{"h":"monetise","i":"/ˈmʌnətaɪz/","a":"LL-Q1860 (eng)-Vealhurl-monetize.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you monetise something, you find a new way to earn money from it.","e":"We will figure out how to monetise the largest user base on the Net."},{"m":"(transitive) If you monetise something such as coins, shells, or notes, you convert it into or use it as money.","e":"In the prison, cigarettes were monetised and used to buy other things."}]}]},"monetised":{"h":"monetised","l":"monetise","q":"verb"},"monetises":{"h":"monetises","l":"monetise","q":"verb"},"monetising":{"h":"monetising","l":"monetise","q":"verb"},"accessorize":{"h":"accessorize","i":"/əkˈsɛsəraɪz/","s":[{"p":"verb","d":[{"m":"If you accessorize something, you decorate it with."}]}]},"accessorizes":{"h":"accessorizes","l":"accessorize","q":"verb"},"accessorized":{"h":"accessorized","l":"accessorize","q":"verb"},"accessorizing":{"h":"accessorizing","l":"accessorize","q":"verb"},"accessorise":{"h":"accessorise","i":"/əkˈsɛsəraɪz/","s":[{"p":"verb","d":[{"m":"If you accessorise something, you decorate it with."}]}]},"accessorising":{"h":"accessorising","l":"accessorise","q":"verb"},"accessorises":{"h":"accessorises","l":"accessorise","q":"verb"},"accessorised":{"h":"accessorised","l":"accessorise","q":"verb"},"canalize":{"h":"canalize","i":"/ˈkæn.ə.laɪz/","s":[{"p":"verb","d":[{"m":"(transitive) If you canalize a river, you convert it into a canal."}]}]},"canalise":{"h":"canalise","i":"/ˈkæn.ə.laɪz/","s":[{"p":"verb","d":[{"m":"(transitive) If you canalise a river, you convert it into a canal."}]}]},"canalizing":{"h":"canalizing","l":"canalize","q":"verb"},"canalized":{"h":"canalized","l":"canalize","q":"verb"},"canalizes":{"h":"canalizes","l":"canalize","q":"verb"},"canalises":{"h":"canalises","l":"canalise","q":"verb"},"canalised":{"h":"canalised","l":"canalise","q":"verb"},"canalising":{"h":"canalising",