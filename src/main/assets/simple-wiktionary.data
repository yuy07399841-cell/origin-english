"a":"en-us-events.ogg","l":"event","q":"noun"},"pimps":{"h":"pimps","l":"pimp","q":"noun"},"ales":{"h":"ales","i":"/eɪlz/","l":"ale","q":"noun"},"logo":{"h":"logo","i":"/ˈləʊ.ɡəʊ/","a":"LL-Q1860 (eng)-Vealhurl-logo.wav","s":[{"p":"noun","d":[{"m":"(countable) A logo is a symbol used to identify a group or organization.","e":"The logo for Wiktionary shows letters in many different languages."}]}]},"purplish":{"h":"purplish","s":[{"p":"adjective","d":[{"m":"Purplish is something like or looks like the colour purple."}]}]},"octopus":{"h":"octopus","i":"/ˈɒkt.ə.pʊs/","a":"en-us-octopus.ogg","s":[{"p":"noun","d":[{"m":"(countable) An octopus is an animal (a mollusc) that has eight arms.","e":"I saw an octopus in the sea."}]}]},"oboe":{"h":"oboe","i":"/ˈoʊboʊ/","a":"en-us-oboe.ogg","s":[{"p":"noun","d":[{"m":"(countable) An oboe is a woodwind musical instrument.","e":"Three students in my class play the oboe."}]}]},"idle":{"h":"idle","i":"/ˈaɪd(ə)l/","a":"en-us-idle.ogg","s":[{"p":"adjective","d":[{"m":"If someone is idle, they are not active or working.","e":"The idle workers are going to be replaced by more ambitious employees."}]},{"p":"verb","d":[{"m":"If a car is idle, it is on but is not moving.","e":"Jack left his car idling while went inside the store to get bread."}]}]},"oboes":{"h":"oboes","l":"oboe","q":"noun"},"tuba":{"h":"tuba","i":"/ˈtuːbə/","s":[{"p":"noun","d":[{"m":"(countable) A tuba is a large brass musical instrument. It has a very low sound.","e":"This young boy plays the tuba very nicely."}]}]},"tubas":{"h":"tubas","l":"tuba","q":"noun"},"crash":{"h":"crash","i":"/kræʃ/","a":"en-us-crash.ogg","s":[{"p":"noun","d":[{"m":"(countable) A crash is something that happens between things. Something that comes together.","e":"I saw a horrible crash on my way home. Two cars had hit each other."},{"m":"(countable) A crash is a loud sound like a clang that happens when two things hit each other.","e":"I heard the crash of the cymbals clearly."}]},{"p":"adjective","d":[{"m":"If something is crash, it is very quick; it is very fast."}]},{"p":"verb","d":[{"m":"(transitive) If something crashes, it hits something else. This could be the ground.","e":"We crashed into each other because we were not looking."},{"m":"(transitive) If you crash something, you cause it to hit something.","e":"I crashed my car. Now I have to walk."},{"m":"(transitive) If you crash somewhere, you sleep there.","e":"I'm too tired to get home, could I just crash here?"},{"m":"(transitive) If you crash, you were on drugs and are now tired or sick because the drugs are gone.","e":"He felt so good when he was high, but when he crashed he wanted to die."}]}]},"fog":{"h":"fog","i":"/fɒg/","a":"en-us-fog.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Fog is a cloud that is close to or on the ground and sometimes prevents a person from being able to see.","e":"It was hard to see in the morning because there was a lot of fog."},{"m":"(uncountable) Fog is a mist or film that covers a surface."}]},{"p":"verb","d":[{"m":"(intransitive) If something becomes fogged, it becomes covered in fog."},{"m":"(intransitive) If something gets fogged, it becomes covered with condensation or drops of water, preventing you from being able to see the object.","e":"As he breathed on the mirror, it fogged up."},{"m":"(transitive) If you fog something, it becomes covered in fog."},{"m":"(transitive) If you fog something, you make it or you obscure something."}]}]},"crashes":{"h":"crashes","l":"crash","q":"noun"},"roadkill":{"h":"roadkill","s":[{"p":"noun","d":[{"m":"roadkill is usually an animal that has run in front of traffic and gets hit by a car, truck, etc."}]}]},"crashed":{"h":"crashed","l":"crash","q":"verb"},"crashing":{"h":"crashing","l":"crash","q":"verb"},"sightings":{"h":"sightings","l":"sighting","q":"noun"},"pimped":{"h":"pimped","l":"pimp","q":"verb","s":[{"p":"adjective","d":[{"m":"If something or someone is pimped, they are cool or nice; they are awesome."}]}]},"pimp