":"(countable) An improvement makes something better; it improves something.","e":"The improvement of this entry was well done."},{"m":"(uncountable) Improvement is the state of being improved or bettered."},{"m":"(countable) An improvement is an increase, advance, or growth."}]}]},"improvements":{"h":"improvements","a":"en-us-improvements.ogg","l":"improvement","q":"noun"},"cumbersome":{"h":"cumbersome","i":"/ˈkʌmbɚsəm/","a":"LL-Q1860 (eng)-Vealhurl-cumbersome.wav","s":[{"p":"adjective","d":[{"m":"If something or someone is cumbersome, they hinder you; they drag you down."},{"m":"If something is cumbersome, it is not very easy to handle; it is awkward.","e":"This dining table is cumbersome to carry because of its' odd shape."},{"m":"If something is cumbersome, it is not very easy to move; it is slow in movement."}]}]},"bulks":{"h":"bulks","l":"bulk","q":"noun"},"bulked":{"h":"bulked","l":"bulk","q":"verb"},"bulking":{"h":"bulking","l":"bulk","q":"verb"},"nugget":{"h":"nugget","i":"/ˈnʌɡət/","s":[{"p":"noun","d":[{"m":"(countable) A nugget is a small and compact piece of something, as in a gold nugget."},{"m":"(countable) A nugget is a small piece of something valuable.","e":"Can you give me a nugget of wisdom for my troubles?"},{"m":"(countable) A nugget is a small bud from the Cannabis Sativa plant."}]}]},"shoelace":{"h":"shoelace","i":"/ˈʃuːˌleɪs/","a":"LL-Q1860 (eng)-Vininn126-shoelace.wav","s":[{"p":"noun","d":[{"m":"A shoelace is a piece of rope or string used to tie shoes together."}]}]},"nuggets":{"h":"nuggets","l":"nugget","q":"noun"},"tasteless":{"h":"tasteless","i":"/ˈteɪstləs/","a":"LL-Q1860 (eng)-Vininn126-tasteless.wav","s":[{"p":"adjective","d":[{"m":"If something is tasteless, it does not have any flavor; it is bland.","e":"This chicken broth is tasteless because it is not good."},{"m":"If someone is tasteless, they are not delicate or refined; they are unbecoming."}]}]},"salty":{"h":"salty","i":"/ˈsɒl.ti/","a":"en-au-salty.ogg","s":[{"p":"adjective"