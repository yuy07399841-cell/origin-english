h":"cuddle","i":"/ˈkʌ.dl/","a":"LL-Q1860 (eng)-Vealhurl-cuddle.wav","s":[{"p":"noun","d":[{"m":"A cuddle is like a hug, but with more emotion.","e":"I gave my daughter a big cuddle when she finished school."}]},{"p":"verb","d":[{"m":"To cuddle someone means to hold them and touch them with affection. It is not sexual.","e":"I like to cuddle my boyfriend when we're watching a film"}]}]},"cuddling":{"h":"cuddling","l":"cuddle","q":"verb"},"cuddles":{"h":"cuddles","l":"cuddle","q":"noun"},"cuddled":{"h":"cuddled","l":"cuddle","q":"verb"},"siesta":{"h":"siesta","i":"/siˈɛstə/","a":"en-au-siesta.ogg","s":[{"p":"noun","d":[{"m":"(countable) A siesta is a rest or sleep in the middle of the day. The word comes directly from Spanish.","e":"Spanish people sometimes take a siesta in the afternoon when it is too hot to work."}]}]},"rhinoceros":{"h":"rhinoceros","i":"/raɪˈnɒsərəs/","a":"en-us-rhinoceros.ogg","s":[{"p":"noun","d":[{"m":"A rhinoceros is a large gray mammal with thick skin and a horn on its head.","e":"The rhinoceros is chasing against the cheetah."}]}]},"giraffe":{"h":"giraffe","i":"/dʒɪˈrɑːf/","a":"en-us-giraffe.ogg","s":[{"p":"noun","d":[{"m":"(countable) The giraffe is the tallest land animal in the world. It is from Africa and has a very long neck.","e":"The family went to see the giraffe in the zoo."}]}]},"d'oh":{"h":"d'oh","i":"/doʊ(ʔ)/","a":"en-uk-d'oh.ogg","s":[{"p":"interjection","d":[{"m":"People say d'oh when they are angry or frustrated. The word comes from the television show The Simpsons"}]}]},"mourn":{"h":"mourn","i":"/mɔrn/","a":"LL-Q1860 (eng)-Vealhurl-mourn.wav","s":[{"p":"verb","d":[{"m":"If you mourn someone, you feel sorrowful over them, after they have died.","e":"It was difficult mourning my sister's death, we were always together, I don't think i'll ever feel better, I loved her so much."}]}]},"ladder":{"h":"ladder","i":"/ˈladə/","a":"en-us-ladder.ogg","s":[{"p":"noun","d":[{"m":"(countable) A ladder is something you walk up use to get to a higher (or lower) position. There are two parallel sides and steps (rungs) between them."}]}]},"limb":{"h":"limb","i":"/lɪm/","a":"en-us-limb.ogg","s":[{"p":"noun","d":[{"m":"(countable) A limb is either a leg or an arm."}]}]},"inventor":{"h":"inventor","i":"/ɪnˈvɛntɚ/","a":"LL-Q1860 (eng)-Vealhurl-inventor.wav","s":[{"p":"noun","d":[{"m":"(countable) An inventor is someone who invents things.","e":"is an inventor. He invented the telephone."}]}]},"sharpen":{"h":"sharpen","i":"/ˈʃɑrpɨn/","a":"LL-Q1860 (eng)-Vealhurl-sharpen.wav","s":[{"p":"verb","d":[{"m":"If you sharpen something, you make it sharper."}]}]},"headache":{"h":"headache","i":"/ˈhɛdeɪk/","a":"en-us-headache.ogg","s":[{"p":"noun","d":[{"m":"(countable) A headache is a pain in your head.","e":"I can't think properly because I have a bad headache."}]}]},"speckled":{"h":"speckled","i":"/ˈspɛkəld/","s":[{"p":"adjective","d":[{"m":"If something is speckled, it has dots on it.","e":"The bird's eggs were speckled."},{"m":"marked."}]}]},"giraffes":{"h":"giraffes","l":"giraffe","q":"noun"},"headaches":{"h":"headaches","l":"headache","q":"noun"},"ladders":{"h":"ladders","l":"ladder","q":"noun"},"rhinoceroses":{"h":"rhinoceroses","l":"rhinoceros","q":"noun"},"sharpens":{"h":"sharpens","l":"sharpen","q":"verb"},"sharpened":{"h":"sharpened","l":"sharpen","q":"verb","s":[{"p":"adjective","d":[{"m":"A sharpened knife has a sharp point or edge."}]}]},"sharpening":{"h":"sharpening","l":"sharpen","q":"verb"},"inventors":{"h":"inventors","l":"inventor","q":"noun"},"limbs":{"h":"limbs","a":"En-us-limbs.ogg","l":"limb","q":"noun"},"mourns":{"h":"mourns","l":"mourn","q":"verb"},"mourned":{"h":"mourned","l":"mourn","q":"verb"},"mourning":{"h":"mourning","i":"/ˈmornɪŋ/","a":"en-us-mourning.ogg","l":"mourn","q":"verb"},"siestas":{"h":"siestas","l":"siesta","q":"noun"},"plop":{"h":"plop","i":"/plɒp/","a":"En-us-plop.ogg","s":[{"p":"verb","d":[{"m":"To drop into a liquid, making a sound."}]}]},"keyhole":{"h":"keyhole","s":[{"p":"