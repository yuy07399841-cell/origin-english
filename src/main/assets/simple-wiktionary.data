"/ˈæ.dɪkt/","a":"LL-Q1860 (eng)-Vealhurl-addict (noun).wav","s":[{"p":"noun","d":[{"m":"(countable) An addict is someone who is addicted to something, most often to a harmful drug.","e":"The addict needs more heroin in order to avoid withdrawal."}]},{"p":"verb","d":[{"m":"If you addict someone or something, you make them become addicted to something, usually a harmful drug."},{"m":"If you are addicted to something, you do it to the exclusion of everything else.","e":"She is addicted to the World of Warcraft."}]}]},"addicts":{"h":"addicts","l":"addict","q":"noun"},"addicted":{"h":"addicted","i":"/əˈdɪktɪd/","a":"LL-Q1860 (eng)-Persent101-addicted.wav","l":"addict","q":"verb","s":[{"p":"adjective","d":[{"m":"If a person is addicted to something that is harmful, they are unable to stop taking it."},{"m":"To be addicted to something means to be to or obsessed with something"}]}]},"addicting":{"h":"addicting","i":"/əˈdɪktɪŋ/","l":"addict","q":"verb"},"achievable":{"h":"achievable","i":"/əˈt͡ʃivəbəl/","a":"LL-Q1860 (eng)-Vealhurl-achievable.wav","s":[{"p":"adjective","d":[{"m":"When something is achievable, it is possible to do it; it can be achieved.","e":"I think climbing is an achievable goal."}]}]},"unachievable":{"h":"unachievable","s":[{"p":"adjective","d":[{"m":"When something is unachievable, it isn't achievable; it can not be achieved.","e":"Beating his world record seems unachievable."}]}]},"jobs":{"h":"jobs","l":"job","q":"noun"},"cracks":{"h":"cracks","l":"crack","q":"verb"},"cracked":{"h":"cracked","l":"crack","q":"verb"},"cracking":{"h":"cracking","l":"crack","q":"verb"},"maritime":{"h":"maritime","i":"/'mærɪtaɪm/","a":"en-us-maritime.ogg","s":[{"p":"adjective","d":[{"m":"If something or someone is maritime, they are related to the sea or sailing."},{"m":"If something is maritime, it is right next to the sea."},{"m":"If someone is maritime, they live right next to the sea."}]}]},"marina":{"h":"marina","i":"/məˈrinə/","a":"LL-Q1860 (eng)-Vealhurl-marina.wav",