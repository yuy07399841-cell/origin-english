ocial gathering attended by men only.","e":"The stag will be held in the hotel's ballroom."}]},{"p":"verb","d":[{"m":"(transitive) (British) If you stag, you buy shares and sell them at once for a profit."}]}]},"stags":{"h":"stags","l":"stag","q":"noun"},"stagged":{"h":"stagged","l":"stag","q":"verb"},"stagging":{"h":"stagging","l":"stag","q":"verb"},"parasite":{"h":"parasite","i":"/ˈpærəˌsaɪt/","a":"LL-Q1860 (eng)-Vealhurl-parasite.wav","s":[{"p":"noun","d":[{"m":"(pejorative) A parasite person who lives on other people's expense and gives little or nothing back."},{"m":"A parasite is an organism that lives on or in another organism of a different species and benefits from living on or in that other organism."}]}]},"parasites":{"h":"parasites","l":"parasite","q":"noun"},"fissure":{"h":"fissure","i":"/ˈfɪʃ.ə(r)/","a":"LL-Q1860 (eng)-Vealhurl-fissure.wav","s":[{"p":"noun","d":[{"m":"(countable) A fissure is a crack or opening in a rock."},{"m":"(countable) A fissure is a long, narrow opening,"}]},{"p":"verb","d":[{"m":"If you fissure, you split or crack something to form a [[#Noun|fissures]]."}]}]},"fissures":{"h":"fissures","l":"fissure","q":"noun"},"fissured":{"h":"fissured","l":"fissure","q":"verb"},"fissuring":{"h":"fissuring","l":"fissure","q":"verb"},"charcoal":{"h":"charcoal","i":"/ˈtʃɑː.kəʊl/","a":"en-us-charcoal.ogg","s":[{"p":"noun","d":[{"m":"Charcoal is a type of impure carbon obtained by heating wood it in the absence of oxygen."},{"m":"(countable) A charcoal is a stick of black carbon material used for drawing."},{"m":"(countable) A charcoal is a drawing made with charcoal."},{"m":"A very dark gray colour."}]}]},"charcoals":{"h":"charcoals","l":"charcoal","q":"noun"},"resignation":{"h":"resignation","i":"/rɛzɪɡˈneɪʃən/","a":"en-us-resignation.ogg","s":[{"p":"noun","d":[{"m":"Resignation is the act of resigning."},{"m":"A resignation is a document someone's intention to resign."}]}]},"resignations":{"h":"resignations","l":"resignation","q":"noun"},"myria