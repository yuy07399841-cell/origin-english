ən/","a":"en-us-plantation.ogg","s":[{"p":"noun","d":[{"m":"(countable) A plantation is a large-scale growth of crops, usually with only one type of crop grown."}]}]},"orchard":{"h":"orchard","i":"/ˈɔː.tʃəd/","a":"en-us-orchard.ogg","s":[{"p":"noun","d":[{"m":"(countable) An orchard is a plantation of fruit such as apples, plums, and peaches.","e":"Many farms allow people to come and pick apples in their orchards."}]}]},"leeway":{"h":"leeway","s":[{"p":"noun","d":[{"m":"(uncountable) Leeway is the amount of freedom to move or act that is available.","e":"The rules gives the person some leeway into his duties."}]}]},"orchards":{"h":"orchards","l":"orchard","q":"noun"},"dawned":{"h":"dawned","l":"dawn","q":"verb","s":[{"p":"verb","d":[{"m":"If something is dawned on"}]}]},"dawning":{"h":"dawning","l":"dawn","q":"verb"},"egyptians":{"h":"Egyptians","l":"egyptian","q":"noun"},"decrucifies":{"h":"decrucifies","l":"decrucify","q":"verb"},"decrucified":{"h":"decrucified","l":"decrucify","q":"verb"},"decrucifying":{"h":"decrucifying","l":"decrucify","q":"verb"},"serial":{"h":"serial","i":"/ˈsɪəriːəɫ/","a":"en-au-serial.ogg","s":[{"p":"noun","d":[{"m":"A serial is a story or play appearing in pieces on a radio or magazine.","e":"The Asterix comics appeared in magazines as a serial for many years."}]},{"p":"adjective","d":[{"m":"If something is considered to be serial, it takes place in multiple times.","e":"A newspaper is a serial publication."}]}]},"ejaculation":{"h":"ejaculation","i":"/iˌdʒækjuˈleɪʃən/","a":"en-au-ejaculation.ogg","s":[{"p":"noun","d":[{"m":"Ejaculation is the action of ejecting semen from the body.","e":"Ejaculation is essential to reproduction."}]}]},"cum":{"h":"cum","i":"/kʌm/","a":"en-uk-cum.ogg","s":[{"p":"verb","d":[{"m":"If you cum, you ejaculate."}]},{"p":"noun","d":[{"m":"Cum is semen."}]},{"p":"preposition","d":[{"m":"Cum is another word of \"combine with\"."}]}]},"cob":{"h":"cob","i":"/kɑb/","a":"en-us-cob.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cob is the part of the corn that is made of a hard husk surrounded by many kernels."}]}]},"cobs":{"h":"cobs","i":"/kɒbz/","a":"LL-Q1860 (eng)-Vealhurl-cobs.wav","l":"cob","q":"noun"},"justifiable":{"h":"justifiable","s":[{"p":"adjective","d":[{"m":"Something that is justifiable can be given a reason.","e":"The arrest of the man was perfectly justifiable given that he had just robbed a bank."}]}]},"kernel":{"h":"kernel","i":"/ˈkɜːnəl/","a":"en-au-kernel.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kernel is a seed of a corn."}]}]},"fort":{"h":"fort","i":"/fɔrt/","a":"en-us-fort.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fort is a fortified building designed for military defense."}]}]},"fortify":{"h":"fortify","i":"/ˈfɔrtɪfaɪ/","a":"LL-Q1860 (eng)-Vealhurl-fortify.wav","s":[{"p":"verb","d":[{"m":"If you fortify something, you strengthen it with tough materials.","e":"The castle was fortified with an extra layer of stone."}]}]},"fortified":{"h":"fortified","l":"fortify","q":"verb"},"grenade":{"h":"grenade","i":"/ɡrəˈneɪd/","a":"en-us-grenade.ogg","s":[{"p":"noun","d":[{"m":"A grenade is a hand-held military bomb that has a timed fuse."}]}]},"recursive":{"h":"recursive","i":"/rɪˈkɜː(r)sɪv/","a":"LL-Q1860 (eng)-Vealhurl-recursive.wav","s":[{"p":"adjective","d":[{"m":"If a process is recursive, it uses its previous output as its next input."}]}]},"withstand":{"h":"withstand","i":"/wɪðˈstænd/","a":"en-us-withstand.ogg","s":[{"p":"verb","d":[{"m":"If something can withstand something else, it can resist it.","e":"Their relationship withstood the test of time."}]}]},"vale":{"h":"vale","i":"/veɪl/","a":"en-us-vale.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vale is a valley."}]}]},"vermont":{"h":"Vermont","i":"/vəˈmɒnt/","a":"en-us-Vermont.ogg","s":[{"p":"proper noun","d":[{"m":"Vermont is a state in the northeast of the United States.","e":"Vermont was accepted as a state in 1791."}]}]},"foreman":{"h":"foreman","i":"/ˈfɔː(r)mən/","a":"en-us-foreman.ogg","s":[{"p":"noun","d":[{"m":"(countable) A foreman is a worker, especially a man, who supervises and directs other workers.","e":"The foreman told his employees to get back to work."}]}]},"foremen":{"h":"foremen","l":"foreman","q":"noun"},"delaware":{"h":"Delaware","i":"/ˈdɛləweə(r)/","a":"en-us-Delaware.ogg","s":[{"p":"proper noun","d":[{"m":"Delaware is a state in the northeast of the United States.","e":"Delaware is one of the 13 original states."}]}]},"elevator":{"h":"elevator","i":"/ˈɛləveɪtə/","a":"LL-Q1860 (eng)-Vealhurl-elevator.wav","s":[{"p":"noun","d":[{"m":"(countable) An elevator is a machine that moves people and goods up and down between floors of a building.","e":"Take the elevator to floor 13."},{"m":"(countable) A grain elevator is a building that is used to store wheat, corn, or other grains."}]}]},"elevators":{"h":"elevators","l":"elevator","q":"noun"},"federate":{"h":"federate","i":"/ˈfɛdəreɪt/","a":"LL-Q1860 (eng)-Vealhurl-federate (verb).wav","s":[{"p":"verb","d":[{"m":"(transitive) If a group of, etc. federate, they join in a federation or alliance.","e":"The colonies decided to federate, forming the country of Canada."}]}]},"noticeable":{"h":"noticeable","i":"/ˈnoʊtɪsəbl̩/","a":"LL-Q1860 (eng)-Vealhurl-noticeable.wav","s":[{"p":"adjective","d":[{"m":"Something that is noticeable is very easily seen or noticed.","e":"There was a noticeable increase in work being done."}]}]},"rotation":{"h":"rotation","i":"/roʊˈteɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-rotation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Rotation is the action of moving around an axis or center."},{"m":"(countable) A rotation is one full turn back to the original position.","e":"The planet Earth completes one rotation each day."}]}]},"rotations":{"h":"rotations","l":"rotation","q":"noun"},"scrambles":{"h":"scrambles","l":"scramble","q":"verb"},"scrambling":{"h":"scrambling","l":"scramble","q":"verb"},"scrambled":{"h":"scrambled","a":"en-us-scrambled.ogg","l":"scramble","q":"verb","s":[{"p":"adjective","d":[{"m":"Food that has been scrambled has been mixed and cooked.","e":"He made scrambled eggs for breakfast."}]}]},"legalise":{"h":"legalise","i":"/ˈliːɡəlaɪz/","a":"LL-Q1860 (eng)-Back ache-legalize.wav","s":[{"p":"verb","d":[{"m":"If something that was against the law is legalised, it becomes allowed under law.","e":"Canada recently legalised marijuana."}]}]},"eon":{"h":"eon","a":"en-us-eon.ogg","s":[{"p":"noun","d":[{"m":"(countable) An eon is a period of 1,000,000,000 (one billion) years."},{"m":"(informal) An eon is a very long period of time.","e":"It feels like it's been an eon since we last saw each other."}]}]},"photographing":{"h":"photographing","l":"photograph","q":"verb"},"photographed":{"h":"photographed","l":"photograph","q":"verb"},"tamper":{"h":"tamper","i":"/ˈtæm.pə(r)/","a":"LL-Q1860 (eng)-Vealhurl-tamper.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If something is tampered with, it is changed or altered without permission.","e":"The evidence for this case was tampered with."}]}]},"legalize":{"h":"legalize","i":"/ˈliːɡəlaɪz/","a":"LL-Q1860 (eng)-Back ache-legalize.wav","s":[{"p":"verb","d":[{"m":"If something that was against the law is legalized, it becomes allowed under law.","e":"There has been a recent push to legalize marijuana in the United States."}]}]},"myometria":{"h":"myometria","l":"myometrium","q":"noun"},"eons":{"h":"eons","l":"eon","q":"noun"},"partitioned":{"h":"partitioned","l":"partition","q":"verb"},"partitioning":{"h":"partitioning","l":"partition","q":"verb"},"primer":{"h":"primer","i":"/ˈpraɪ.mə/","a":"en-uk-primer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A primer is a part of a pistol, rifle and other firearms that is used to ignite gunpowder or other explosives when struck by the firing pin."}]}]},"primers":{"h":"primers","l":"primer","q":"noun"},"jewfro":{"h":"Jewfro","s":[{"p":"noun","d":[{"m":"A Jewfro is a type of curly hairstyle that is worn by people of the Ashkenazi Jewish descent."}]}]},"jewfros":{"h":"Jewfros","l":"jewfro","q":"noun"},"microsecond":{"h":"microsecond","s":[{"p":"noun","d":[{"m":"(countable) A microsecond is one millionth (0.000001 or 10−6 or 1/1,000,000) of a second. The symbol is μs/µs."}]}]},"microseconds":{"h":"microseconds","l":"microsecond","q":"noun"},"clothesline":{"h":"clothesline","i":"/ˈkləʊðzlaɪn/","a":"LL-Q1860 (eng)-Vealhurl-clothesline.wav","s":[{"p":"noun","d":[{"m":"(countable) A clothesline is a place to hang clothing to dry and is usually made of rope or plastic wire.","e":"Please help me to hang these towels on the clothesline outside."}]}]},"clotheslines":{"h":"clotheslines","l":"clothesline","q":"noun"},"decantation":{"h":"decantation","i":"/ˌdiːkænˈteɪʃən/","s":[{"p":"noun","d":[{"m":"Decantation refers to the act of pouring out the liquid or water (which contains the dust or soil particles) without disturbing the particles at the bottom."}]}]},"decantations":{"h":"decantations","l":"decantation","q":"noun"},"modification":{"h":"modification","i":"/ˌmɑdɪfɪˈkeɪʃən/","a":"en-us-modification.ogg","s":[{"p":"noun","d":[{"m":"(countable) A modification to something is a change or adjustment to something.","e":"The modification of the computer allowed it to access the Internet easier."}]}]},"modifications":{"h":"modifications","l":"modification","q":"noun"},"beatboxing":{"h":"beatboxing","s":[{"p":"noun","d":[{"m":"(uncountable) Beatboxing is making percussive noises with the mouth, lips, tongue and voice. Performers try an imitate the sounds of a drum machine and is used a lot in hip hop music."}]}]},"orbited":{"h":"orbited","l":"orbit","q":"verb"},"orbiting":{"h":"orbiting","l":"orbit","q":"verb"},"livelihood":{"h":"livelihood","i":"/ˈlaɪvlɪhʊd/","a":"LL-Q1860 (eng)-Vealhurl-livelihood.wav","s":[{"p":"noun","d":[{"m":"Someone's livelihood is how they support themselves, usually related to jobs and money.","e":"The livelihoods of the farmers were destroyed when the drought came."}]}]},"livelihoods":{"h":"livelihoods","l":"livelihood","q":"noun"},"interwoven":{"h":"interwoven","i":"/ˈɪntərwəʊvən/","a":"en-us-interwoven.ogg","l":"interweave","q":"verb"},"interweave":{"h":"interweave","i":"/ɪntərˈwiːv/","s":[{"p":"verb","d":[{"m":"(transitive) If something is interwoven, it is joined together by.","e":"The yarn was carefully interwoven to make the sweater."},{"m":"(intransitive) If two or more things are interwoven, they are connected closely.","e":"The courts are interwoven with the police."}]}]},"interweaves":{"h":"interweaves","l":"interweave","q":"verb"},"interwove":{"h":"interwove","i":"/ˈɪntərwoːv/","a":"en-us-interwove.ogg","l":"interweave","q":"verb"},"interweaving":{"h":"interweaving","l":"interweave","q":"verb"},"cd":{"h":"CD","s":[{"p":"noun","d":[{"m":"(countable) A CD is a type of plastic disk that is used to store computer files.","e":"The singer released his new CD album."},{"m":"This is the Roman numeral for four hundred (400). It may be written as CD or cd."}]}]},"brightens":{"h":"brightens","l":"brighten","q":"verb"},"brightened":{"h":"brightened","l":"brighten","q":"verb"},"brightening":{"h":"brightening","l":"brighten","q":"verb"},"flee":{"h":"flee","i":"/fliː/","a":"en-us-flee.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you flee, you run away or escape.","e":"The prisoner tried to flee, but was caught by the guards."},{"m":"(transitive) If you flee a place, you escape from it.","e":"The culprit fled the crime scene."}]}]},"flees":{"h":"flees","l":"flee","q":"verb"},"fled":{"h":"fled","l":"flee","q":"verb"},"fleeing":{"h":"fleeing","l":"flee","q":"verb"},"groupings":{"h":"groupings","l":"grouping","q":"noun"},"retrieve":{"h":"retrieve","i":"/rɪˈtriv/","a":"LL-Q1860 (eng)-Vealhurl-retrieve.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you retrieve something, you go and get it back.","e":"He went into the classroom to retrieve his textbook."}]}]},"retrieves":{"h":"retrieves","l":"retrieve","q":"verb"},"retrieved":{"h":"retrieved","l":"retrieve","q":"verb"},"retrieving":{"h":"retrieving","l":"retrieve","q":"verb"},"pervert":{"h":"pervert","i":"/ˈpəː.vəːt/","a":"LL-Q1860 (eng)-Vealhurl-pervert (noun).wav","s":[{"p":"noun","d":[{"m":"(countable) A pervert is a person who has inappropriate habits, specially about sex.","e":"That pervert was looking into the changeroom."}]},{"p":"verb","d":[{"m":"(informal) If someone perverts someone else or something he makes it work or behave in a bad way."}]}]},"councillor":{"h":"councillor","i":"/ˈkaʊns(ɪ)lə/","s":[{"p":"noun","d":[{"m":"(countable) A councillor is a member of a council.","e":"Half of the councillors voted against expanding the metro."}]}]},"councillors":{"h":"councillors","l":"councillor","q":"noun"},"gulf":{"h":"gulf","a":"en-us-gulf.ogg","s":[{"p":"noun","d":[{"m":"A gulf is a part of an ocean or sea that has land mostly around it."},{"m":"A deep hollow; chasm or abyss."},{"m":"Any wide separation, as in position, status, or education."},{"m":"Something that engulfs or swallows up."}]},{"p":"verb","d":[{"m":"When you gulf something, you swallow up or engulf it."}]}]},"trailer":{"h":"trailer","i":"/ˈtreɪlə(r)/","a":"LL-Q1860 (eng)-Vealhurl-trailer.wav","s":[{"p":"noun","d":[{"m":"(countable) A trailer is something that follows, or trails behind something else."},{"m":"(countable) A trailer is a vehicle with wheels that is connected to the back of a car or truck, usually to carry something.","e":"The trailer of the eighteen-wheeler was carrying fresh produce."},{"m":"(countable) A trailer is a home with wheels that can be moved around. When it is not being moved around, it can be lived in.","e":"We drove our trailer to."},{"m":"(countable) A movie trailer is a short video that shows a little bit of a movie, video game or television show.","e":"The new trailer for came out yesterday!"}]}]},"trailers":{"h":"trailers","l":"trailer","q":"noun"},"unwarier":{"h":"unwarier","l":"unwary","q":"adjective"},"unwariest":{"h":"unwariest","l":"unwary","q":"adjective"},"unrecyclables":{"h":"unrecyclables","l":"unrecyclable","q":"noun"},"unchangeables":{"h":"unchangeables","l":"unchangeable","q":"noun"},"sledgehammer":{"h":"sledgehammer","a":"en-us-sledgehammer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sledgehammer is a large hammer that has a large metal block attached to the handle.","e":"These sledgehammers will be used for construction work."}]},{"p":"verb","d":[{"m":"If you sledgehammer something, you hit it with a sledgehammer."}]}]},"lamebrain":{"h":"lamebrain","i":"/ˈleɪmbreɪn/","a":"en-au-lamebrain.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lamebrain is a person who is rather shallow."}]}]},"orthodox":{"h":"orthodox","i":"/ˈɔːθədɒks/","a":"en-us-orthodox.ogg","s":[{"p":"adjective","d":[{"m":"(religion) Something that is orthodox follows the practices that are accepted by a faith or religion.","e":"He's an orthodox Christian, not a Catholic."},{"m":"Something that is orthodox follows what is normal or is accepted more often.","e":"His fighting style was very orthodox."}]}]},"prediction":{"h":"prediction","i":"/prɪˈdɪkʃn/","a":"LL-Q1860 (eng)-Vealhurl-prediction.wav","s":[{"p":"noun","d":[{"m":"(countable) A prediction is an idea or guess of what will happen in the future.","e":"The president gave a prediction as to whether or not the bill would be passed."},{"m":"(countable) A prediction is a guess of the chance something will happen based on data.","e":"The prediction on who would win the election was off by 10%."}]}]},"predictions":{"h":"predictions","l":"prediction","q":"noun"},"elm":{"h":"elm","s":[{"p":"noun","d":[{"m":"(countable) An elm is a type of tree.","e":"The city cut down several of the elm trees in the forest."},{"m":"(uncountable) Elm wood is the wood that comes from this tree.","e":"The dining table is made entirely out of elm wood."}]}]},"elms":{"h":"elms","l":"elm","q":"noun"},"supercontinent":{"h":"supercontinent","s":[{"p":"noun","d":[{"m":"(countable) A supercontinent is a very large continent that was broken up into smaller ones in Earth's past.","e":"The supercontinent of was made up of all of today's continents."},{"m":"(countable) A supercontinent is a large area of land that is made up of many different continents, like Africa-Eurasia."}]}]},"supercontinents":{"h":"supercontinents","l":"supercontinent","q":"noun"},"vector":{"h":"vector","i":"/ˈvɛktə/","a":"en-us-vector.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vector is a quantity with both a size and a direction.","e":"In teaching physics, force or velocity vectors can be added to the animation."},{"m":"(countable) A vector is an animal or insect that carries and spreads a disease.","e":"Other forms of this disease used different insect vectors."}]}]},"beech":{"h":"beech","i":"/biːt͡ʃ/","a":"en-us-beech.ogg","s":[{"p":"noun","d":[{"m":"(countable) A beech is a type of tree.","e":"There were lots of beech trees in the forest."}]}]},"beeches":{"h":"beeches","l":"beech","q":"noun"},"sloth":{"h":"sloth","i":"/sləʊθ/","a":"en-uk-sloth.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Sloth is the quality of being lazy or unwilling to do work.","e":"Sloth is one of the seven deadly sins."},{"m":"(countable) A sloth is an animal from South America that eats leaves and is usually very slow and inactive.","e":"The zoo has several sloths from Brazil."}]}]},"sloths":{"h":"sloths","l":"sloth","q":"noun"},"slothful":{"h":"slothful","s":[{"p":"adjective","d":[{"m":"Someone who is slothful is lazy or does not want to work.","e":"Judging from his work, he's truly slothful."}]}]},"obnoxious":{"h":"obnoxious","i":"/əbˈnɒkʃəs/","a":"LL-Q1860 (eng)-Vealhurl-obnoxious.wav","s":[{"p":"adjective","d":[{"m":"Something that is obnoxious is not very pleasant or good.","e":"That person was acting in a very obnoxious way."}]}]},"algorithm":{"h":"algorithm","i":"/ˈælɡərɪðəm/","a":"en-us-algorithm.ogg","s":[{"p":"noun","d":[{"m":"An algorithm is a set of steps that reliably solve certain types of problems, such as sorting things alphabetically or doing long division.","e":"The new search algorithm was able to find a solution 5% faster than the previous algorithm."}]}]},"pine":{"h":"pine","i":"/paɪn/","a":"en-au-pine.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pine tree is a tree of the family.","e":"The pine trees were cut down to make room for new skyscrapers."},{"m":"(uncountable) Pine is the wood that comes from these trees."}]},{"p":"verb","d":[{"m":"(intransitive) If you pine for a person or thing, you long for them so much that it causes suffering.","e":"Laura was pining for Bill all the time he was gone."}]}]},"pines":{"h":"pines","l":"pine","q":"noun"},"pined":{"h":"pined","l":"pine","q":"verb"},"pining":{"h":"pining","l":"pine","q":"verb"},"graduation":{"h":"graduation","i":"/ˌɡrædʒuˈeɪʃən/","a":"en-uk-graduation.oga","s":[{"p":"noun","d":[{"m":"Graduation is when a student finishes a course (usually in school) and gets a diploma. This is usually done with a ceremony.","e":"My family was unable to come to my graduation ceremony."},{"m":"(countable) (science) A graduation is a mark (usually on a container) that is used to measure things."}]}]},"graduations":{"h":"graduations","l":"graduation","q":"noun"},"glen":{"h":"Glen","i":"/ɡlɛn/","s":[{"p":"proper noun","d":[{"m":"Glen is a male given name."}]}]},"dales":{"h":"dales","l":"dale","q":"noun"},"glens":{"h":"glens","l":"glen","q":"noun"},"juggernaut":{"h":"juggernaut","i":"/ˈdʒʌ.ɡə.nɔːt/","a":"en-us-juggernaut.ogg","s":[{"p":"noun","d":[{"m":"(countable) A juggernaut is something that is unstoppable and will destroy everything in its path.","e":"The administrator was a juggernaut of a man."},{"m":"(countable) A juggernaut is a group that is very powerful.","e":"The political juggernaut that was the president had seized power."}]}]},"juggernauts":{"h":"juggernauts","l":"juggernaut","q":"noun"},"fortissimo":{"h":"fortissimo","s":[{"p":"adverb","d":[{"m":"If something is played fortissimo it is played very loud.","e":"Play the opening section fortissimo instead of forte."}]},{"p":"noun","d":[{"m":"A fortissimo sign shows that a music piece should be played very loud."}]}]},"enlighten":{"h":"enlighten","i":"/ɪnˈlaɪtən/","a":"LL-Q1860 (eng)-Vealhurl-enlighten.wav","s":[{"p":"verb","d":[{"m":"If something enlightens someone, it makes them realize or understand something that they hadn't before, often something quite important.","e":"This group tries to enlighten student about these risks."},{"m":"If somebody is enlightened, they have a clear and true understanding of the world.","e":"My parents were not really unusual, but they were enlightened about their views of marriage."},{"m":"If something is enlightening, it makes you realize or understand something that you hadn't before, often something quite important.","e":"These past months living with her were very enlightening."}]}]},"enjoyable":{"h":"enjoyable","i":"/ɛnˈdʒɔɪ.jə.bəl/","a":"LL-Q1860 (eng)-Vealhurl-enjoyable.wav","s":[{"p":"adjective","d":[{"m":"Something that is enjoyable is able to give pleasure.","e":"The critic found the movie more enjoyable than others."}]}]},"uncouple":{"h":"uncouple","i":"/ʌnˈkʌpəl/","a":"LL-Q1860 (eng)-Vealhurl-uncouple.wav","s":[{"p":"verb","d":[{"m":"(transitive) If two or more things are uncoupled, they are disconnected from each other.","e":"The two railway cars were uncoupled at the train yard."}]}]},"insanity":{"h":"insanity","i":"/ɪnˈsænɪti/","a":"en-us-insanity.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Insanity is the condition of being seriously mentally ill and unable to perceive reality as other people do.","e":"The case had driven him to insanity."},{"m":"Insanity is a situation that is very foolish.","e":"It was pure insanity to rebel at a time like this."}]}]},"insanities":{"h":"insanities","l":"insanity","q":"noun"},"uncouples":{"h":"uncouples","l":"uncouple","q":"verb"},"uncoupling":{"h":"uncoupling","l":"uncouple","q":"verb"},"boardwalk":{"h":"boardwalk","i":"/ˈbɔːdwɔːk/","a":"en-au-boardwalk.ogg","s":[{"p":"noun","d":[{"m":"(countable) A boardwalk is a wooden path that goes over sandy or swampy ground. It may also go beside a body of water or beach.","e":"The boardwalks in the park needed repairs."}]}]},"boardwalks":{"h":"boardwalks","l":"boardwalk","q":"noun"},"trickster":{"h":"trickster","i":"/ˈtrɪkstə/","s":[{"p":"noun","d":[{"m":"(countable) A trickster is a person who tricks or cheats another person.","e":"The trickster cheated and gained all the money from everyone."}]}]},"tricksters":{"h":"tricksters","l":"trickster","q":"noun"},"ampere":{"h":"ampere","i":"/ˈæmˌpɪər/","a":"en-us-ampere.ogg","s":[{"p":"noun","d":[{"m":"(countable) An ampere is the unit used to measure electric current. It is represented by the letter A.","e":"The circuit had a current of 6 amperes."}]}]},"amperes":{"h":"amperes","l":"ampere","q":"noun"},"multilingual":{"h":"multilingual","i":"/ˌmʌltiˈlɪŋɡwəl/","a":"LL-Q1860 (eng)-Vealhurl-multilingual.wav","s":[{"p":"adjective","d":[{"m":"Something that is multilingual is related to many languages.","e":"The sign outside parliament is multilingual."},{"m":"Someone that is multilingual can speak many languages.","e":"Most immigrants are multilingual and can speak two languages."}]},{"p":"noun","d":[{"m":"(countable) A multilingual is someone who knows multiple languages.","e":"Being a multilingual gives more in the workforce."}]}]},"multilinguals":{"h":"multilinguals","l":"multilingual","q":"noun"},"oganesson":{"h":"oganesson","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-oganesson.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Oganesson is a radioactive element with an atomic number of 118 and symbol Og."}]}]},"tennessine":{"h":"tennessine","i":"/ˈtɛn.əˌsiːn/","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-tennessine.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Tennessine is a synthetic element with an atomic number of 117 and symbol Ts."}]}]},"moscovium":{"h":"moscovium","i":"/mɒˈskəʊ.vi.əm/","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-moscovium.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Moscovium is a synthetic element with an atomic number of 115 and symbol Mc."}]}]},"nihonium":{"h":"nihonium","i":"/nɪˈhoʊ.ni.əm/","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-nihonium.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Nihonium is a synthetic radioactive element with an atomic number of 113 and symbol Nh."}]}]},"cobblers":{"h":"cobblers","l":"cobbler","q":"noun"},"clerical":{"h":"clerical","i":"/ˈklɛrɪkəl/","a":"En-us-clerical.ogg","s":[{"p":"adjective","d":[{"m":"Clerical work, skills, and workers are those related to what a clerk does in an office.","e":"We didn't get the proper refund because of a clerical error."},{"m":"Clerical roles or items are those related to the clergy, the official leaders of religious activities.","e":"The preacher at our church doesn't wear a clerical collar."}]}]},"timeouts":{"h":"timeouts","l":"timeout","q":"noun"},"constable":{"h":"constable","i":"/ˈkʌnstəbəl/","a":"LL-Q1860 (eng)-Vealhurl-constable.wav","s":[{"p":"noun","d":[{"m":"(countable) A constable is a low-ranking member of the police.","e":"Thunder Point has a constable but no other local law enforcement."}]}]},"courtesy":{"h":"courtesy","i":"/ˈkɜːtəsi/","a":"en-us-courtesy.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Courtesy is beliefs and actions related to being polite and respectful.","e":"Our teachers treated us with courtesy and kindness."},{"m":"(countable) A courtesy is something you do for someone to make things nicer for them, but for which you are not paid.","e":"She sent you the photo as a small courtesy."},{"m":"(uncountable) If you receive something courtesy of someone else, they have provided it for free.","e":"All photos are courtesy of the city of Mississauga."},{"m":"A courtesy title is one that people call you, even though it has no true basis.","e":"Eveyone called the prince the Duke of Eaves as a courtesy title."}]}]},"thot":{"h":"thot","i":"/θɒt/","s":[{"p":"noun","d":[{"m":"(countable) A thot is a woman that has many sexual partners."}]}]},"ukraine":{"h":"Ukraine","i":"/juːˈkreɪn/","a":"en-us-Ukraine.ogg","s":[{"p":"proper noun","d":[{"m":"Ukraine is a country in Eastern Europe; the capital city is Kyiv."}]}]},"icosagon":{"h":"icosagon","s":[{"p":"noun","d":[{"m":"(countable) An icosagon is a shape that has 20 sides and 20 angles."}]}]},"icosahedron":{"h":"icosahedron","s":[{"p":"noun","d":[{"m":"(countable) An icosahedron is a polyhedron."}]}]},"dodecahedron":{"h":"dodecahedron","s":[{"p":"noun","d":[{"m":"(countable) A dodecahedron is a polyhedron with twelve faces."}]}]},"tridecagon":{"h":"tridecagon","s":[{"p":"noun","d":[{"m":"(countable) A tridecagon is a shape that has 13 sides and 13 angles."}]}]},"opportunistic":{"h":"opportunistic","i":"/ˌɑpərˌtuːˈnɪstɪk/","a":"LL-Q1860 (eng)-Vealhurl-opportunistic.wav","s":[{"p":"adjective","d":[{"m":"Opportunistic behaviour takes advantage of chances offered by the situation, often without regard to the harm that it might cause.","e":"Within the orgnization, there are many rules to regulate opportunistic behavior."},{"m":"An opportunistic infection is one that only sickens an organism whose immune system has been weakened by disease or drug treatment."}]}]},"dispatch":{"h":"dispatch","i":"/dəˈspætʃ/","a":"en-us-dispatch.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you dispatch people or equipment somewhere, you send them there to do a particular task.","e":"The government has reportedly dispatched elite army troops to Baghdad."},{"m":"(transitive) If you dispatch a message, package, etc., you send it.","e":"Before long, Edison was regularly dispatching instructions to his lab up north."},{"m":"(transitive) If you dispatch a living thing, you kill it.","e":"If the immune system has seen the viruses before, it can dispatch them swiftly."}]},{"p":"noun","d":[{"m":"(countable) A dispatch is a message or report sent by a someone in a distant location.","e":"The New York Times ran 10 stories on Rwanda, half of them brief wire service dispatches."},{"m":"(uncountable) Dispatch is part of an emergency response system, such as police or ambulance, which sends personnel to deal with emergencies.","e":"When dispatch couldn't contact him, they called and asked me to check on him."},{"m":"(uncountable) The dispatch of someone to a place is the act of sending them there to do a particular task.","e":"They recommended to the President the dispatch of six thousand to eight thousand American combat forces."},{"m":"(uncountable) If you do something with dispatch you finish it without wasting time.","e":"We want to make sure that that work continues with all due dispatch and speed."}]}]},"originate":{"h":"originate","i":"/əˈrɪdʒɪneɪt/","a":"en-us-originate.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If a person or thing originates from something, they come from or are created by that thing.","e":"Most scientists believe modern humans originated in Africa about 200,000 years ago."},{"m":"(transitive) If you originate something, you are the first to think of or it or to do it.","e":"George Takei, the actor who originated the role of Sulu on Star Trek, released a statement."}]}]},"despatch":{"h":"despatch","i":"/dəˈspætʃ/","a":"en-us-dispatch.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you despatch people or equipment somewhere, you send them there to do a particular task.","e":"The government has reportedly despatched elite army troops to Baghdad."},{"m":"(transitive) If you despatch a message, package, etc., you send it.","e":"Before long, Edison was regularly despatching instructions to his lab up north."},{"m":"(transitive) If you despatch a living thing, you kill it.","e":"If the immune system has seen the viruses before, it can despatch them swiftly."}]},{"p":"noun","d":[{"m":"(countable) A despatch is a message or report sent by a someone in a distant location.","e":"The New York Times ran 10 stories on Rwanda, half of them brief wire service despatches."},{"m":"(uncountable) despatch is part of an emergency response system, such as police or ambulance, which sends personnel to deal with emergencies.","e":"When despatch couldn't contact him, they called and asked me to check on him."},{"m":"(uncountable) The despatch of someone to a place is the act of sending them there to do a particular task.","e":"They recommended to the President the despatch of six thousand to eight thousand American combat forces."},{"m":"(uncountable) If you do something with despatch you finish it without wasting time.","e":"We want to make sure that that work continues with all due despatch and speed."}]}]},"divert":{"h":"divert","i":"/daɪˈvɜːt/","a":"en-us-divert.ogg","s":[{"p":"verb","d":[{"m":"If you divert something, you change its path or flow so that it avoids a place it would have gone.","e":"The news release about the new funding was an attempt to divert attention from the government's problems."},{"m":"(transitive) If you try to divert someone, you try to amuse them."}]}]},"envisage":{"h":"envisage","i":"/ɛnˈvɪzɪdʒ/","a":"en-us-envisage.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you envisage something, you think that it will very likely happen.","e":"The talks proved that things were a little more complicated than originally envisaged."},{"m":"(transitive) If you envisage something, you imagine what it looks like.","e":"It's hard to envisage him as a long-haired man walking through New York in torn jeans and Jesus sandals."}]}]},"hardy":{"h":"hardy","i":"/ˈhɑrdi/","a":"en-us-hardy.ogg","s":[{"p":"adjective","d":[{"m":"If a living thing is hardy, it has no difficulties growing and staying healthy, even under bad conditions.","e":"These trees are particularly hardy, and require very little attention."}]}]},"petrified":{"h":"petrified","l":"petrify","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are petrified, you are so scared that you cannot move.","e":"The young child was petrified after the dog barked."}]}]},"um":{"h":"um","s":[{"p":"interjection","d":[{"m":"You use um to show that you are thinking and not ready to speak.","e":"We were prepared, um, in our minds, in our heart, for -- for whatever."},{"m":"You use um to show that you doubt or are not sure about something somebody said.","e":"Um, I don't think that works."},{"m":"You use um with a falling tone to show that you agree.","e":"\"How does Tuesday sound?\" \"Um, sure. Sounds good!\""},{"m":"You use um to get somebody's attention.","e":"Um, excuse me! Are you busy?"},{"m":"You use um to bring attention to something that just happened or that was just said.","e":"Um, did you just call me \"stupid\"?"}]}]},"hussy":{"h":"hussy","i":"/ˈhʌsi/","a":"en-US-hussy.wav","s":[{"p":"noun","d":[{"m":"A hussy is a housekeeper."},{"m":"(countable) A hussy is a woman that is not respectful or shows inappropriate behaviour."}]}]},"gravity":{"h":"gravity","i":"/ˈɡrævɪti/","a":"en-us-gravity.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Gravity is the physical force that attracts all matter, for example what makes things fall to the ground.","e":"Because of the Earth's larger size, gravity here is stronger than the pull of gravity on the moon."},{"m":"(uncountable) The gravity of a situation is how serious and worrying it is.","e":"I don't think she understands the gravity of her crime."}]}]},"mooseknuckle":{"h":"mooseknuckle","i":"/muːsnɒkəl/","a":"en-au-mooseknuckle.ogg","s":[{"p":"noun","d":[{"m":"(countable) Mooseknuckle is the bulge in the crotch area of a man.","e":"Your mooseknuckle shows in those trousers."}]}]},"dis":{"h":"dis","s":[{"p":"verb","d":[{"m":"If you dis somebody, you insult them."}]}]},"metallic":{"h":"metallic","i":"/məˈtæl.ɪk/","a":"en-us-metallic.ogg","s":[{"p":"adjective","d":[{"m":"Something that is metallic is like metal.","e":"The bird's call was loud and metallic."},{"m":"Something that is metallic is made of or has metal in it.","e":"The object contained metallic particles."}]}]},"lav":{"h":"lav","i":"/læv/","a":"en-au-lav.ogg","s":[{"p":"noun","d":[{"m":"(countable) (UK) A lav is a lavatory, or washroom."}]}]},"banger":{"h":"banger","i":"/ˈbæŋ(ɡ)ə(r)/","a":"EN-AU ck1 banger.ogg","s":[{"p":"noun","d":[{"m":"(countable) A banger is someone that bangs things in any way."},{"m":"A banger is a firework or firecracker."},{"m":"A banger is a sausage.","e":"The restaurant was especially famous for the bangers and mash they serve."},{"m":"If a song is a banger, it is an energetic song that particularly stands out.","e":"The DJ at the club last night played some real bangers!"}]}]},"cramping":{"h":"cramping","i":"/ˈkræmpɪŋ/","l":"cramp","q":"verb"},"leapt":{"h":"leapt","l":"leap","q":"verb"},"annotate":{"h":"annotate","i":"/ˈanəteɪt/","a":"LL-Q1860 (eng)-Vealhurl-annotate.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you annotate a document or other text, you are adding notes to them, usually to explain them or add on to them.","e":"The research paper was annotated with an explanation of the context of one of the points."}]}]},"annotates":{"h":"annotates","l":"annotate","q":"verb"},"annotated":{"h":"annotated","l":"annotate","q":"verb"},"annotating":{"h":"annotating","l":"annotate","q":"verb"},"annotation":{"h":"annotation","i":"/anəˈteɪʃ(ə)n/","s":[{"p":"noun","d":[{"m":"(countable) An annotation is a note or comment that is added on a document or diagram that explains something.","e":"The annotations in the bibliography provided a helpful explanation of the sources."},{"m":"(uncountable) Annotation is the act of."}]}]},"annotations":{"h":"annotations","l":"annotation","q":"noun"},"skid":{"h":"skid","i":"/skɪd/","a":"LL-Q1860 (eng)-Vealhurl-skid.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If a vehicle skids, it slides sideways along a slippery surface, usually in an uncontrollable way.","e":"The truck skidded out of control on the ice."}]},{"p":"noun","d":[{"m":"(countable) A skid the act of something sliding out of control.","e":"The conditions on the road forced the car to go into a skid."},{"m":"(countable) A skid is a long, flat piece that is attached under an aircraft that helps the aircraft land."}]}]},"skids":{"h":"skids","l":"skid","q":"verb"},"skidded":{"h":"skidded","l":"skid","q":"verb"},"skidding":{"h":"skidding","l":"skid","q":"verb"},"pierces":{"h":"pierces","l":"pierce","q":"verb"},"pierced":{"h":"pierced","i":"/pɪrst/","a":"en-us-pierced.ogg","l":"pierce","q":"verb"},"piercing":{"h":"piercing","i":"/ˈpɪrsɪŋ/","a":"en-us-piercing.ogg","l":"pierce","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A piercing is a hole in the body that is made so jewellery can be put through it.","e":"She got an ear piercing after her birthday."},{"m":"(countable) A piercing is a piece of jewellery that is put into a piercing.","e":"The woman had several face and body piercings."}]},{"p":"adjective","d":[{"m":"A piercing look or sound is one that feels like it goes right through you because it is very intense.","e":"The man had a piercing gaze."}]}]},"piercings":{"h":"piercings","l":"piercing","q":"noun"},"literacy":{"h":"literacy","i":"/ˈlɪtərəsi/","a":"en-us-literacy.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Literacy is the ability to read and write.","e":"The city has a literacy program for troubled young people."}]}]},"deliquescent":{"h":"deliquescent","i":"/dɛlɪˈkɛsənt/","s":[{"p":"adjective","d":[{"m":"If a material is deliquescent, it is able to take in moisture from air and dissolve in the moisture.","e":"Most deliquescent materials are salts."}]}]},"bubbled":{"h":"bubbled","l":"bubble","q":"verb"},"bubbling":{"h":"bubbling","l":"bubble","q":"verb"},"preparation":{"h":"preparation","i":"/prɛpəˈreɪʃən/","a":"en-us-preparation.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Preparation is the act of or getting something ready.","e":"In preparation for the event, each person chipped in and bought a gift."},{"m":"(uncountable) Preparation is when something is prepared or ready for something."}]}]},"cheesy":{"h":"cheesy","i":"/ˈtʃiːzi/","a":"LL-Q1860 (eng)-Vealhurl-cheesy.wav","s":[{"p":"adjective","d":[{"m":"(informal) If something is cheesy, it is too dramatic, emotional, or cliché.","e":"The movie showing in theatres was fairly cheesy for a children's movie."},{"m":"If something is cheesy, it has, is made of, or is similar to cheese.","e":"The pizza had a certain cheesy flavour to it."}]}]},"seafood":{"h":"seafood","i":"/ˈsiːfuːd/","a":"LL-Q1860 (eng)-Vealhurl-seafood.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Seafood is any fish, shellfish, or underwater life that can be eaten.","e":"The restaurant typically has fresh seafood coming in each day."}]}]},"cheesier":{"h":"cheesier","l":"cheesy","q":"adjective"},"cheesiest":{"h":"cheesiest","l":"cheesy","q":"adjective"},"lobbyist":{"h":"lobbyist","i":"/ˈlɑ.bi.ɪst/","a":"LL-Q1860 (eng)-Vealhurl-lobbyist.wav","s":[{"p":"noun","d":[{"m":"(countable) A lobbyist is a person whose job is to lobby politicians and to try and make them vote or make a decision a certain way.","e":"lobbyists pushed for fewer restrictions on businesses."}]}]},"lobbyists":{"h":"lobbyists","l":"lobbyist","q":"noun"},"legalizes":{"h":"legalizes","l":"legalize","q":"verb"},"legalized":{"h":"legalized","l":"legalize","q":"verb"},"legalizing":{"h":"legalizing","l":"legalize","q":"verb"},"legalises":{"h":"legalises","l":"legalise","q":"verb"},"legalised":{"h":"legalised","l":"legalise","q":"verb"},"legalising":{"h":"legalising","l":"legalise","q":"verb"},"criminalize":{"h":"criminalize","s":[{"p":"verb","d":[{"m":"(transitive) If something is criminalized, it is made a crime.","e":"s pushed for gun possession to be criminalized."}]}]},"criminalizes":{"h":"criminalizes","l":"criminalize","q":"verb"},"criminalized":{"h":"criminalized","l":"criminalize","q":"verb"},"criminalizing":{"h":"criminalizing","l":"criminalize","q":"verb"},"flicks":{"h":"flicks","l":"flick","q":"noun"},"flicked":{"h":"flicked","l":"flick","q":"verb"},"flicking":{"h":"flicking","l":"flick","q":"verb"},"flourishes":{"h":"flourishes","l":"flourish","q":"verb"},"flourished":{"h":"flourished","l":"flourish","q":"verb"},"flourishing":{"h":"flourishing","l":"flourish","q":"verb"},"monetize":{"h":"monetize","i":"/ˈmʌnətaɪz/","a":"LL-Q1860 (eng)-Vealhurl-monetize.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you monetize something, you find a new way to earn money from it.","e":"We will figure out how to monetize the largest user base on the Net."},{"m":"(transitive) If you monetize something such as coins, shells, or notes, you convert it into or use it as money.","e":"In the prison, cigarettes were monetized and used to buy other things."}]}]},"primitive":{"h":"primitive","i":"/ˈprɪmɪtɪv/","a":"en-us-primitive.ogg","s":[{"p":"adjective","d":[{"m":"If an object is primitive, it is simple and created without much skill.","e":"He enjoyed doing primitive types of art."}]}]},"vegetarian":{"h":"vegetarian","i":"/vɛd͡ʒɪˈtɛri.ən/","a":"LL-Q1860 (eng)-Vealhurl-vegetarian.wav","s":[{"p":"noun","d":[{"m":"(countable) A vegetarian is a person or an animal that only eats plants and does not eat meat.","e":"The recipe is popular among vegetarians."}]},{"p":"adjective","d":[{"m":"Something that is vegetarian relates to having no meat or has no meat in it.","e":"The restaurant unveiled their new vegetarian menu."}]}]},"vegetarians":{"h":"vegetarians","l":"vegetarian","q":"noun"},"outhouse":{"h":"outhouse","s":[{"p":"noun","d":[{"m":"(countable) An outhouse is a small, free-standing building that contains a toilet.","e":"The building was so old, it had no plumbing—only an outhouse."}]}]},"outhouses":{"h":"outhouses","l":"outhouse","q":"noun"},"traumatic":{"h":"traumatic","i":"/ˈtrɔːmətɪk/","s":[{"p":"adjective","d":[{"m":"If something is traumatic, it causes trauma.","e":"Recovery from a traumatic brain injury is a complicated process."}]}]},"sever":{"h":"sever","i":"/ˈsɛv.ɚ/","a":"en-us-sever.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you sever something, you cut through or separate it completely.","e":"The man's arm was accidentally severed by a saw while he was working at the building."}]}]},"horrifying":{"h":"horrifying","l":"horrify","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is horrifying, it is extremely upsetting.","e":"We are now getting absolutely horrifying images of death and destruction from the area."}]}]},"flake":{"h":"flake","i":"/fleɪk/","a":"en-us-flake.ogg","s":[{"p":"noun","d":[{"m":"(countable) A flake is a small, flat piece of something, often broken off something larger.","e":"London was silent with snow; soft flakes of it dropping evenly into the white streets."}]},{"p":"verb","d":[{"m":"If something flakes, it breaks into small, flat pieces.","e":"The paint had started to flake off the wall."}]}]},"indigenous":{"h":"indigenous","i":"/ɪnˈdɪdʒɪnəs/","a":"en-au-indigenous.ogg","s":[{"p":"adjective","d":[{"m":"If a plant, animal, or person is indigenous to a certain area, its ancestors have been there for a very long time.","e":"Several indigenous plants went extinct as a result of climate change."},{"m":"Something that is indigenous is related to the native people of an area.","e":"Indigenous traditions have largely died out."}]}]},"synchronize":{"h":"synchronize","i":"/ˈsɪŋ.krə.naɪːz/","a":"en-us-synchronize.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you synchronize two or more clocks, watches, etc., you set them to show the same time.","e":"They synchronized their watches and agreed to meet at four o'clock."},{"m":"(transitive) If you synchronize two or more things, you make them happen at the same time or go at the same pace.","e":"The bus arrivals were now synchronized with the subway times."}]}]},"walkouts":{"h":"walkouts","l":"walkout","q":"noun"},"swarthiness":{"h":"swarthiness","s":[{"p":"noun","d":[{"m":"(uncountable) Swarthiness is the property of having darker skin."}]}]},"stool":{"h":"stool","i":"/stuːl/","a":"en-us-stool.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stool is a seat for one person that does not have a back or an armrest.","e":"The three men sat on the stools smoking cigarettes."},{"m":"; A stool is a piece of feces.","e":"Stool samples revealed that the animals had eaten an abnormal amount of plastic."},{"m":"(countable) A stool is a plant that has been cut to its base to let it grow again."}]},{"p":"verb","d":[{"m":"If a person or thing stools, it releases feces.","e":"It is common for babies to stool frequently during feeding."},{"m":"If a plant stools, it releases shoots from its roots."},{"m":"If a plant is stooled, it is cut down to its base to let it grow again."}]}]},"stools":{"h":"stools","l":"stool","q":"noun"},"attribution":{"h":"attribution","i":"/ˌætrɪˈbjuːʃən/","s":[{"p":"noun","d":[{"m":"Attribution is the act of clearly acknowledging the creator of or reason for something.","e":"An attribution error occurs when you see somebody as responsible for things they are not responsible for."}]}]},"orderly":{"h":"orderly","i":"/ˈɔrdɚli/","a":"en-us-orderly.ogg","s":[{"p":"adjective","d":[{"m":"If something is done in an orderly fashion or manner, it works very well as expected.","e":"He packed up his things in a very orderly fashion and left the next day."},{"m":"Something that is orderly is neat and organized.","e":"The orderly rows of the books in the library we calming."}]}]},"terminus":{"h":"terminus","i":"/ˈtəːmɪnəs/","a":"LL-Q1860 (eng)-Vininn126-terminus.wav","s":[{"p":"noun","d":[{"m":"(countable) The terminus of something is its end or final point, often the end of a bus or rail route or line.","e":"The train has arrived at the terminus of the line."},{"m":"(countable) A terminus is a boundary or border or a post that marks a boundary or border."}]}]},"termini":{"h":"termini","i":"/ˈtɜrməˌnaɪ/","l":"terminus","q":"noun"},"terminuses":{"h":"terminuses","l":"terminus","q":"noun"},"resistant":{"h":"resistant","i":"/rɪˈzɪstənt/","a":"LL-Q1860 (eng)-Vealhurl-resistant.wav","s":[{"p":"adjective","d":[{"m":"Something that is resistant to something else is against it or resists it.","e":"The country was particularly resistant to change after the war."}]}]},"aura":{"h":"aura","i":"/ˈɔː.rə/","a":"LL-Q1860 (eng)-Vealhurl-aura.wav","s":[{"p":"noun","d":[{"m":"(countable) An aura is a feeling, quality, or atmosphere that a certain person or place has or is associated with.","e":"That place had a distinctive aura of wonder and majesty."},{"m":"(countable) An aura is an invisible energy or force that surrounds a person or animal."}]}]},"manifesto":{"h":"manifesto","i":"/ˌmæn.ɪˈfɛs.təʊ/","a":"LL-Q1860 (eng)-Vealhurl-manifesto.wav","s":[{"p":"noun","d":[{"m":"(countable) A manifesto is a public statement that describes a person or group's aims, goals, and beliefs.","e":"The s' election manifesto detailed their plans for healthcare funding."}]}]},"refereed":{"h":"refereed","l":"referee","q":"verb"},"refereeing":{"h":"refereeing","l":"referee","q":"verb"},"manifestos":{"h":"manifestos","l":"manifesto","q":"noun"},"manifestoes":{"h":"manifestoes","l":"manifesto","q":"noun"},"inexplicable":{"h":"inexplicable","i":"/ˌɪn.ɪkˈsplɪ.kə.bl̩/","a":"LL-Q1860 (eng)-Vealhurl-inexplicable.wav","s":[{"p":"adjective","d":[{"m":"If something is inexplicable, it is very difficult to explain."}]}]},"apprehension":{"h":"apprehension","i":"/æp.rɪˈhɛn.ʃən/","a":"LL-Q1860 (eng)-Mélange a trois-apprehension.wav","s":[{"p":"noun","d":[{"m":"Apprehension is the anxiety or fear that something bad or unpleasant will happen."}]}]},"confrontation":{"h":"confrontation","i":"/ˌkɒn.frənˈteɪ.ʃən/","a":"en-uk-confrontation.ogg","s":[{"p":"noun","d":[{"m":"A confrontation between two or more groups is when they challenge or confront each other.","e":"In a tense confrontation, the two men argued with each other."},{"m":"A confrontation is a fight between two or more groups armed with weapons.","e":"The battalion was caught up in a confrontation with enemy troops."}]}]},"confrontations":{"h":"confrontations","l":"confrontation","q":"noun"},"democratic":{"h":"democratic","i":"/ˌdɛməˈkrætɪk/","a":"en-us-democratic.ogg","s":[{"p":"adjective","d":[{"m":"Something that is democratic is based on or relates to democracy, where the people choose the government.","e":"The United States is a democratic country, since the citizens choose the leaders in government."}]}]},"administer":{"h":"administer","i":"/ədˈmɪnɪstɚ/","a":"en-us-administer.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you administer a test, program etc., you organize and supervise it.","e":"The school administers IELTS and TOEFL tests for students who need to take them."},{"m":"(transitive) If a medical person administers drugs they put the drugs into the person or animal.","e":"Sometimes, nurses administer the drug to the wrong patient."}]}]},"knotty":{"h":"knotty","i":"/ˈnɒti/","a":"en-us-knotty.ogg","s":[{"p":"adjective","d":[{"m":"A knotty problem or issue is complicated and difficult to solve.","e":"Nobody can agree about how to deal with this extremely knotty problem."}]}]},"auxiliary":{"h":"auxiliary","i":"/ɔːkˈsɪljəri/","a":"LL-Q1860 (eng)-Vealhurl-auxiliary.wav","s":[{"p":"adjective","d":[{"m":"An auxiliary worker is one who assists the main workers.","e":"The auxiliary police receive basic police training but cannot carry a weapon."},{"m":"An auxiliary motor or power supply starts working if the main one stops.","e":"Because the computers are so important in an emergency, they need an auxiliary power supply."},{"m":"An auxiliary verb is a verb such as be, do, or will that works with another verb to show the tense, aspect, mood, or voice. (Here is a list of English auxiliary verbs.)","e":"The passive voice in English typically uses the auxiliary verbs be or get."}]},{"p":"noun","d":[{"m":"(countable) An auxiliary is a person who assists the main workers.","e":"A number of auxiliaries were brought in to cover the sick workers."},{"m":"(countable) An auxiliary is an organization that supports another organization.","e":"The Ladies’ Auxiliary started when women were asked to help injured soldiers returning home."},{"m":"(countable) An auxiliary is an auxiliary verb.","e":"That sentence needs an auxiliary."}]}]},"mojibake":{"h":"mojibake","i":"/ˌmoʊ.dʒiˈbɑ.ki/","a":"LL-Q1860 (eng)-Vealhurl-mojibake.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Mojibake occurs when a computer tries to display characters encoded in a different format.","e":"Mojibake often looks like this: � � � �ա�."}]}]},"skirmish":{"h":"skirmish","i":"/ˈskɜː(r)mɪʃ/","a":"LL-Q1860 (eng)-Vealhurl-skirmish.wav","s":[{"p":"noun","d":[{"m":"(countable) A skirmish is a small fight."}]},{"p":"verb","d":[{"m":"If two sides skirmish, they fight briefly."}]}]},"oughta":{"h":"oughta","i":"/ˈɒtə/","s":[{"p":"verb","d":[{"m":"Short for ought to.","e":"I oughta go home."}]}]},"conundrum":{"h":"conundrum","i":"/kəˈnʌn.drəm/","a":"en-us-conundrum.ogg","s":[{"p":"noun","d":[{"m":"(countable) A conundrum is a difficult question or riddle."},{"m":"(countable) A conundrum is a difficult choice or decision that has to be made."}]}]},"woulda":{"h":"woulda","i":"/ˈwʊdə/","s":[{"p":"verb","d":[{"m":"Short for would have.","e":"I woulda gone shopping, but it's late now."}]}]},"coulda":{"h":"coulda","i":"/ˈkʊdə/","s":[{"p":"verb","d":[{"m":"Short for could have.","e":"I coulda gone shopping, but it's late now."}]}]},"sigma":{"h":"sigma","i":"/ˈsɪɡmə/","a":"en-us-sigma.ogg","s":[{"p":"noun","d":[{"m":"Eighteen letter of Greek."},{"m":"Σσ, and in the word last position, writes as ς."},{"m":"Standard deviation,has formula:={\\displaystyle \\sigma = \\sqrt{\\frac{1}{n}\\sum_{\\iota =1}^{n} (a_{\\iota}-\\bar{x})^2}} the average symbol \\bar{x} often writes as μ"}]}]},"mu":{"h":"mu","i":"/muː/","a":"en-us-mu.ogg","s":[{"p":"noun","d":[{"m":"Mu is the twelfth letter of Greek."},{"m":"Μμ"}]}]},"cesium":{"h":"cesium","s":[{"p":"noun","d":[{"m":"Cesium is an American spelling of caesium."}]}]},"deuterium":{"h":"deuterium","i":"/djuːˈtɪərɪəm/","a":"LL-Q1860 (eng)-Vealhurl-deuterium.wav","s":[{"p":"noun","d":[{"m":"Deuterium is a kind of hydrogen atom that has a nucleus with one proton and one neutron. It can be written as ^{2}_{1}H or ^{2}H or D."},{"m":"Deuterium is a substance consisting of deuterium atoms."}]}]},"protium":{"h":"protium","s":[{"p":"noun","d":[{"m":"A type of Hydrogen atoms that they nuclear has only one proton. It can write as ^{1}_{1}H or ^{1}H or H, but not write as P."},{"m":"Substance consisted by protium atoms."}]}]},"tritium":{"h":"tritium","i":"/ˈtrɪti.əm/","a":"LL-Q1860 (eng)-Vealhurl-tritium.wav","s":[{"p":"noun","d":[{"m":"A type of atom that the nucleus has one proton and two neutrons. It can be written as ^{3}_{1}H or ^{3}H or T."},{"m":"Substance consisted by tritium atoms."}]}]},"archetype":{"h":"archetype","i":"/ˈɑːkɪtaɪp/","a":"en-au-archetype.ogg","s":[{"p":"noun","d":[{"m":"(countable) An archetype is something that all other similar ideas or objects are copied from.","e":"Things Fall Apart is considered an archetype for African literature."}]}]},"archetypes":{"h":"archetypes","l":"archetype","q":"noun"},"positron":{"h":"positron","i":"/ˈpɒz.ɪ.trɒn/","a":"LL-Q1860 (eng)-Vealhurl-positron.wav","s":[{"p":"noun","d":[{"m":"(countable) A positron is a particle that takes one positive charge and its mass and spin is equal to an electron's."}]}]},"positrons":{"h":"positrons","l":"positron","q":"noun"},"quadrillion":{"h":"quadrillion","i":"/kwɒˈdrɪɫjən/","a":"en-us-quadrillion.ogg","s":[{"p":"determiner","d":[{"m":"(ordinal quadrillionth) The number 1,000,000,000,000,000 (or 1,000,000,000,000,000,000,000,000 in old British usage)."}]},{"p":"noun","d":[{"m":"(countable) The number 1,000,000,000,000,000 (or 1,000,000,000,000,000,000,000,000 in old British usage).","e":"Quadrillions of dollars have been spent on the war in Iraq."}]}]},"gynoid":{"h":"gynoid","i":"/ˈɡaɪˌnɔɪd/","s":[{"p":"noun","d":[{"m":"(countable) A robot that looks like it is female.","e":"I'd rather have a gynoid cleaning my house than a robot that looks like a man."}]}]},"gynoids":{"h":"gynoids","l":"gynoid","q":"noun"},"natrium":{"h":"natrium","s":[{"p":"noun","d":[{"m":"Another term for sodium"}]}]},"kalium":{"h":"kalium","s":[{"p":"noun","d":[{"m":"Another term for potassium."}]}]},"nihon":{"h":"Nihon","s":[{"p":"proper noun","d":[{"m":"Another term for Japan."}]}]},"quasar":{"h":"quasar","i":"/ˈkweɪ.zɑː/","a":"en-us-quasar.ogg","s":[{"p":"noun","d":[{"m":"A radiation that comes from accretion disc of early universe. It has red-shift really high, it looks like a star but they radius approx a galaxy."}]}]},"vigintillion":{"h":"vigintillion","i":"/vɪdʒɪnˈtɪljən/","s":[{"p":"determiner","d":[{"m":"(ordinal vigintillionth) The number 1,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000."}]},{"p":"noun","d":[{"m":"The number 1,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000.","e":"One thousand novemdecillion is a vigintillion."}]}]},"resin":{"h":"resin","i":"/ˈrɛzɪn/","a":"en-us-resin.ogg","s":[{"p":"noun","d":[{"m":"Resin is a sticky organic compound from some plants."}]}]},"nuclide":{"h":"nuclide","i":"/ˈn(j)uːklaɪd/","s":[{"p":"noun","d":[{"m":"A nuclide is a specific kind of atom defined by the exact number of protons and neutrons in its nucleus."}]}]},"cuprum":{"h":"cuprum","s":[{"p":"noun","d":[{"m":"Another term for copper, the symbol Cu comes from this words."}]}]},"ferrum":{"h":"ferrum","s":[{"p":"noun","d":[{"m":"Another term for iron, the symbol Fe comes from this word."}]}]},"kinship":{"h":"kinship","i":"/ˈkɪnʃɪp/","a":"LL-Q1860 (eng)-Vealhurl-kinship.wav","s":[{"p":"noun","d":[{"m":"Kinship is the connection to other people in your family."},{"m":"Kinship is a feeling of close friendship or connection between people."}]}]},"validation":{"h":"validation","i":"/ˌvæl.əˈdeɪ.ʃən/","a":"LL-Q1860 (eng)-Vealhurl-validation.wav","s":[{"p