gs"}]}]},"uncork":{"h":"uncork","i":"/ʌnˈkɔːk/","a":"LL-Q1860 (eng)-Vealhurl-uncork.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you uncork a bottle of wine, you remove the cork from the bottle."}]}]},"hagiographies":{"h":"hagiographies","l":"hagiography","q":"noun"},"uncorks":{"h":"uncorks","l":"uncork","q":"verb"},"uncorked":{"h":"uncorked","l":"uncork","q":"verb"},"uncorking":{"h":"uncorking","l":"uncork","q":"verb"},"rusk":{"h":"rusk","i":"/rʌsk/","a":"LL-Q1860 (eng)-Vealhurl-rusk.wav","s":[{"p":"noun","d":[{"m":"(countable) A rusk is a dry biscuit or a piece of twice-baked bread."}]}]},"rusks":{"h":"rusks","l":"rusk","q":"noun"},"demouses":{"h":"demouses","l":"demouse","q":"verb"},"demoused":{"h":"demoused","l":"demouse","q":"verb"},"demousing":{"h":"demousing","l":"demouse","q":"verb"},"padlocked":{"h":"padlocked","l":"padlock","q":"verb"},"reconcile":{"h":"reconcile","i":"/ˈrɛkənsaɪl/","a":"en-us-reconcile.ogg","s":[{"p":"verb","d":[{"m":"If you reconcile with someone, you restore a friendly relationship with them."}]}]},"reconciles":{"h":"reconciles","l":"reconcile","q":"verb"},"reconciled":{"h":"reconciled","l":"reconcile","q":"verb"},"reconciling":{"h":"reconciling","l":"reconcile","q":"verb"},"freezer":{"h":"freezer","i":"/friːzə/","a":"LL-Q1860 (eng)-Vealhurl-freezer.wav","s":[{"p":"noun","d":[{"m":"(countable) A freezer is something that is used to store food at temperatures below 0° Celsius (32° Fahrenheit)."}]}]},"freezers":{"h":"freezers","l":"freezer","q":"noun"},"foundry":{"h":"foundry","i":"/faʊndri/","s":[{"p":"noun","d":[{"m":"A foundry is a place where molten (melted) metals are poured into casts, to make metal things of a certain shape."}]}]},"foundries":{"h":"foundries","l":"foundry","q":"noun"},"stark":{"h":"stark","i":"/stɑrk/","a":"en-us-stark.ogg","s":[{"p":"adjective","d":[{"m":"Is something is stark, it is plain and undecorated, often in a cold or unpleasant way.","e":"All the leaves were gone now, leaving the tree stark and bare."},{"m":"A stark contrast, difference, reminder, etc. is simple and clear, often in a cold or unpleasant way.","e":"The contrast between rich and poor is even more stark in health outcomes."}]}]},"starker":{"h":"starker","l":"stark","q":"adjective"},"starkest":{"h":"starkest","l":"stark","q":"adjective"},"sidekick":{"h":"sidekick","i":"/ˈsaɪdkɪk/","s":[{"p":"noun","d":[{"m":"(informal) (countable) A sidekick is someone who regularly travels with, and helps, another person."}]}]},"sidekicks":{"h":"sidekicks","l":"sidekick","q":"noun"},"defenestrate":{"h":"defenestrate","i":"/dɪˈfɛnɪstreɪt/","a":"LL-Q1860 (eng)-Vealhurl-defenestrate.wav","s":[{"p":"verb","d":[{"m":"If you defenestrate something or someone, you throw them from a window."}]}]},"pa":{"h":"pa","i":"/pɑː/","a":"LL-Q1860 (eng)-Vealhurl-pa.wav","s":[{"p":"noun","d":[{"m":"(countable) Some people refer to their father informally as 'pa'.","e":"Pa was busy on the phone."}]}]},"pas":{"h":"pas","l":"pa","q":"noun"},"defenestrates":{"h":"defenestrates","l":"defenestrate","q":"verb"},"defenestrated":{"h":"defenestrated","l":"defenestrate","q":"verb"},"defenestrating":{"h":"defenestrating","l":"defenestrate","q":"verb"},"tuck":{"h":"tuck","i":"/tʌk/","a":"en-us-tuck.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you tuck something, you place it somewhere safe or hidden.","e":"Tuck in your shirt."}]}]},"tucks":{"h":"tucks","l":"tuck","q":"verb"},"tucked":{"h":"tucked","l":"tuck","q":"verb"},"tucking":{"h":"tucking","l":"tuck","q":"verb"},"nominal":{"h":"nominal","i":"/ˈnɒm.ɪnl̩/","s":[{"p":"adjective","d":[{"m":"The nominal price, rate, or wage is the one before adjustments to reflect the true value.","e":"GDP grew at a nominal rate of 3.4%, or 1.4% after adjusting for inflation."},{"m":"A nominal position, change, etc. is one in name only, without reflection what actually happens.","e":"They gained nominal independence from Britain in 1941, but Britain continued to exercise a good deal of control for years."},{"m":"A nominal sum, fee, charge, gift, etc. is a small one compared to the true value.","e":"He lives with his parents who only charge him a nominal rent."},{"m":"A nominal form, position, phrase, etc. is related to nouns.","e":"The nominal form of the word is aki."}]},{"p":"noun","d":[{"m":"A nominal is a noun or phrase that functions as head of a noun phrase.","e":"This sentence contains two nominals."},{"m":"A nominal is a word or phrase that shares features with nouns."}]}]},"nominals":{"h":"nominals","l":"nominal","q":"noun"},"oh":{"h":"oh","i":"/əʊ/","a":"en-uk-oh.ogg","s":[{"p":"interjection","d":[{"m":"You say oh to express surprise, pain, or other feelings.","e":"Oh! I couldn't believe you done that!"}]}]},"cherub":{"h":"cherub","i":"/ˈtʃɛrəb/","a":"en-uk-cherub.oga","s":[{"p":"noun","d":[{"m":"(countable) A cherub is a type of angel, usually in the form a child with wings, but they were described in other ways in the past."}]}]},"suffrage":{"h":"suffrage","i":"/ˈsʌfrɪdʒ/","a":"LL-Q1860 (eng)-Vealhurl-suffrage.wav","s":[{"p":"noun","d":[{"m":"A suffrage is when you can vote in an election."}]}]},"suffrages":{"h":"suffrages","l":"suffrage","q":"noun"},"cherubs":{"h":"cherubs","l":"cherub","q":"noun"},"mirage":{"h":"mirage","i":"/mɪˈrɑːdʒ/","a":"en-us-mirage.ogg","s":[{"p":"noun","d":[{"m":"A mirage is an optical phenomenon which causes distant objects to appear at a different location than they really are."}]}]},"mirages":{"h":"mirages","l":"mirage","q":"noun"},"optical":{"h":"optical","i":"/ˈɒptɪkəl/","a":"LL-Q1860 (eng)-Vealhurl-optical.wav","s":[{"p":"adjective","d":[{"m":"If something is optical, it is related to sight, optics or visible light."}]}]},"alembic":{"h":"alembic","i":"/əˈlɛmbɪk/","a":"LL-Q1860 (eng)-Vealhurl-alembic.wav","s":[{"p":"noun","d":[{"m":"(countable) An alembic is a old chemical apparatus that consists of two retorts connected by a tube. It is used to purify substances by distillation"}]}]},"alembics":{"h":"alembics","l":"alembic","q":"noun"},"retort":{"h":"retort","i":"/rɪˈtɔrt/","a":"LL-Q1860 (eng)-AcpoKrane-retort.wav","s":[{"p":"noun","d":[{"m":"(countable) A retort sharp or witty reply made in an argument."}]},{"p":"verb","d":[{"m":"If you retort, you reply someone with a sharp or witty remark in an argument."}]}]},"retorts":{"h":"retorts","l":"retort","q":"noun"},"retorted":{"h":"retorted","l":"retort","q":"verb"},"retorting":{"h":"retorting","l":"retort","q":"verb"},"witty":{"h":"witty","i":"/ˈwɪti/","a":"LL-Q1860 (eng)-Vealhurl-witty.wav","s":[{"p":"adjective","d":[{"m":"If someone gave a witty reply, the reply is clever and funny.","e":"His speech was both witty and informative."}]}]},"wittier":{"h":"wittier","l":"witty","q":"adjective"},"wittiest":{"h":"wittiest","l":"witty","q":"adjective"},"safe-conduct":{"h":"safe-conduct","s":[{"p":"noun","d":[{"m":"A safe-conduct is a document that allows a person to pass for a forbidden place, for example in cases of war."}]}]},"safe-conducts":{"h":"safe-conducts","l":"safe-conduct","q":"noun"},"dumbbell":{"h":"dumbbell","i":"/ˈdʌm.bɛl/","a":"en-ca-dumbbell.oga","s":[{"p":"noun","d":[{"m":"(countable) (weightlifting) A dumbbell is a weight consisting of two disks or spheres attached to a short bar."},{"m":"(countable) (pejorative) A dumbbell is a stupid person."}]}]},"dumbbells":{"h":"dumbbells","l":"dumbbell","q":"noun"},"weightlifting":{"h":"weightlifting","i":"/ˈweɪtˌlɪftɪŋ/","s":[{"p":"noun","d":[{"m":"Weightlifting is a type of exercise in which weights are lifted."}]}]},"verboten":{"h":"verboten","i":"/ˌvɜː(r)ˈbəʊ.tən/","s":[{"p":"adjective","d":[{"m":"If something is verboten, it is forbidden or prohibited."}]}]},"flock":{"h":"flock","i":"/flɒk/","a":"en-us-flock.ogg","s":[{"p":"noun","d":[{"m":"(countable) A flock is a large number of birds, especially those gathered together for the purpose of migration."},{"m":"(countable) A flock is a large number of animals, especially sheep or goats kept together."}]},{"p":"verb","d":[{"m":"(transitive) If you flock to a place, you go towards a place in large numbers.","e":"People flocked to the cinema to see the new film."}]}]},"flocks":{"h":"flocks","i":"/flɒks/","a":"en-us-flocks.ogg","l":"flock","q":"noun"},"flocked":{"h":"flocked","l":"flock","q":"verb"},"flocking":{"h":"flocking","l":"flock","q":"verb"},"pejoratives":{"h":"pejoratives","l":"pejorative","q":"noun"},"illustrator":{"h":"illustrator","i":"/ˈɪləˌstreɪtər/","s":[{"p":"noun","d":[{"m":"(countable) An illustrator is a person who draws illustrations in books or magazines)","e":"Terry is one of the best illustrators of children's books in the country."}]}]},"illustrators":{"h":"illustrators","l":"illustrator","q":"noun"},"shrine":{"h":"shrine","i":"/ʃraɪ̯n/","a":"en-us-shrine.ogg","s":[{"p":"noun","d":[{"m":"(countable) A shrine is a holy or sacred place dedicated to a certain deity or a person who is respected."}]}]},"shrines":{"h":"shrines","l":"shrine","q":"noun"},"deity":{"h":"deity","i":"/ˈdiː.ɪ.tɪ/","a":"en-uk-deity1.ogg","s":[{"p":"noun","d":[{"m":"(countable) A deity is a god, goddess or any supernatural divine being."}]}]},"deities":{"h":"deities","l":"deity","q":"noun"},"confiscate":{"h":"confiscate","i":"/ˈkɒnfɪskeɪt/","a":"en-us-confiscate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you confiscate something, you use your authority to take it from someone.","e":"In schools it is common for teachers to confiscate electronic games and other distractions."}]}]},"confiscated":{"h":"confiscated","l":"confiscate","q":"verb"},"confiscating":{"h":"confiscating","l":"confiscate","q":"verb"},"confiscates":{"h":"confiscates","l":"confiscate","q":"verb"},"orca":{"h":"orca","i":"/ˈɔrkə/","a":"en-ca-orca.oga","s":[{"p":"noun","d":[{"m":"(countable) An orca is a sea mammal that is related to dolphins and porpoises. It is commonly called the killer whale."}]}]},"orcas":{"h":"orcas","l":"orca","q":"noun"},"porpoise":{"h":"porpoise","i":"/ˈpɔːpəs/","a":"en-us-porpoise.ogg","s":[{"p":"noun","d":[{"m":"(countable) A porpoise is a small aquatic mammal of the family. It is related to dolphins and whales."}]},{"p":"verb","d":[{"m":"If you porpoise, you move through water like a [[#Noun|porpoise]]."}]}]},"porpoises":{"h":"porpoises","l":"porpoise","q":"noun"},"porpoised":{"h":"porpoised","l":"porpoise","q":"verb"},"porpoising":{"h":"porpoising","l":"porpoise","q":"verb"},"venom":{"h":"venom","i":"/ˈvɛnəm/","a":"en-us-venom.ogg","s":[{"p":"noun","d":[{"m":"Venom is a type of poison carried by an animals. It is usually injected into an enemy or prey by biting or stinging."}]}]},"venoms":{"h":"venoms","l":"venom","q":"noun"},"recreational":{"h":"recreational","i":"/rɛkrɪˈeɪʃənl/","s":[{"p":"adjective","d":[{"m":"If a place is used for recreational purposes, it is used for that are done for leisure when one is not working."}]}]},"griffin":{"h":"griffin","i":"/ɡrɪfɪn/","s":[{"p":"noun","d":[{"m":"(countable) A griffin is a mythical beast that has a body of a lion and the wings and head of an eagle."}]}]},"griffins":{"h":"griffins","l":"griffin","q":"noun"},"explementary":{"h":"explementary","s":[{"p":"adjective","d":[{"m":"An explementary angle is one of a pair that sum to 360 degrees."}]}]},"vishesh":{"h":"Vishesh","s":[{"p":"proper noun","d":[{"m":"Vishesh is a male given name."}]}]},"sagar":{"h":"Sagar","s":[{"p":"proper noun","d":[{"m":"Sagar is a male given name."}]}]},"quail":{"h":"quail","i":"/ˈkweɪl/","a":"en-us-quail.ogg","s":[{"p":"noun","d":[{"m":"(countable) A quail is a collective name for several genera of mid-sized birds in the order."},{"m":"(uncountable) The meat from this bird eaten as food."}]}]},"speculation":{"h":"speculation","i":"/ˌspɛkjəˈleɪʃən/","a":"en-us-speculation.ogg","s":[{"p":"noun","d":[{"m":"Speculation is the ideas you have about the truth when you don't have all the important information.","e":"There has been a lot of talk and speculation about what will happen in the final game."},{"m":"(uncountable) Speculation is the process of thinking about the truth when you don't have all the important information.","e":"After a great deal of speculation, I decided that he must have done it."},{"m":"(uncountable) Speculation is risky investing with the hope of making a large profit."}]}]},"speculations":{"h":"speculations","l":"speculation","q":"noun"},"unguent":{"h":"unguent","i":"/ˈʌŋɡwənt/","a":"en-us-unguent.ogg","s":[{"p":"noun","d":[{"m":"(countable) An unguent is a medicinal cream that is applied to the skin for therapeutic purposes."}]}]},"unguents":{"h":"unguents","l":"unguent","q":"noun"},"medicinal":{"h":"medicinal","i":"/məˈdɪsənəl/","a":"LL-Q1860 (eng)-Vealhurl-medicinal.wav","s":[{"p":"adjective","d":[{"m":"If something is medicinal, it has the of medicine or is used to cure disease or relieve pain."}]}]},"therapeutic":{"h":"therapeutic","i":"/θɛrəˈpjuːtɪk/","a":"en-us-therapeutic.ogg","s":[{"p":"adjective","d":[{"m":"Therapeutic means to relate to the healing, treatment, or curing of diseases, disorders, or injuries."}]}]},"disability":{"h":"disability","i":"/dɪsəˈbɪlɪti/","a":"LL-Q1860 (eng)-Vealhurl-disability.wav","s":[{"p":"noun","d":[{"m":"(countable) A disability is condition where a person's movements or senses are limited by any physical or mental disadvantage."}]}]},"disabilities":{"h":"disabilities","l":"disability","q":"noun"},"quails":{"h":"quails","l":"quail","q":"noun"},"gunpoint":{"h":"gunpoint","i":"/ˈɡʌnpɔɪnt/","s":[{"p":"noun","d":[{"m":"If you hold someone at gunpoint, you threaten them by or aiming a firearm at them."}]}]},"prise":{"h":"prise","i":"/praɪz/","a":"en-us-prize.ogg","s":[{"p":"verb","d":[{"m":"If you prise something, you force it open with a lever."}]}]},"prises":{"h":"prises","l":"prise","q":"verb"},"prised":{"h":"prised","l":"prise","q":"verb"},"prising":{"h":"prising","l":"prise","q":"verb"},"duality":{"h":"duality","i":"/d(j)uːˈælɪti/","s":[{"p":"noun","d":[{"m":"Duality is the state or property of having two natures or aspects.","e":"Protons and electrons exhibit wave–particle duality."}]}]},"dualities":{"h":"dualities","l":"duality","q":"noun"},"vise":{"h":"vise","i":"/vaɪs/","a":"en-us-vice.ogg","s":[{"p":"noun","d":[{"m":"(countable) (US) A vise is an instrument that consists of two jaws and is closed by a screw or lever. It is used for holding work, such as filing."}]},{"p":"verb","d":[{"m":"If you vise something, you clamp it with a [[#Noun|vise]]."}]}]},"viced":{"h":"viced","l":"vice","q":"verb"},"vicing":{"h":"vicing","l":"vice","q":"verb"},"vised":{"h":"vised","l":"vise","q":"verb"},"vising":{"h":"vising","l":"vise","q":"verb"},"vises":{"h":"vises","l":"vise","q":"noun"},"filings":{"h":"filings","l":"filing","q":"noun"},"tutorial":{"h":"tutorial","i":"/tjuːˈtɔːrɪəl/","a":"LL-Q1860 (eng)-Vealhurl-tutorial.wav","s":[{"p":"noun","d":[{"m":"(countable) A tutorial is an interactive class taught by a tutor to students, individually or in small groups."},{"m":"(countable) A tutorial is a lesson prepared so that a student can learn at their own speed and time."}]}]},"tutorials":{"h":"tutorials","l":"tutorial","q":"noun"},"tumbler":{"h":"tumbler","i":"/ˈtʌmblɚ/","a":"en-us-tumbler.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tumblr is a movable obstruction in a lock that holds the bolt in place until lifted by a key."},{"m":"(countable) A tumblr is a drinking glass that has no handle or stem."}]}]},"tumblers":{"h":"tumblers","l":"tumbler","q":"noun"},"truism":{"h":"truism","i":"/ˈtruːɪz(ə)m/","s":[{"p":"noun","d":[{"m":"(countable) A truism is a statement that is obviously true and provides no new information."}]}]},"truisms":{"h":"truisms","l":"truism","q":"noun"},"traceable":{"h":"traceable","i":"/ˈtreɪsəbəl/","s":[{"p":"adjective","d":[{"m":"If something is traceable, it can be traced or tracked down.","e":"There was no traceable evidence left when the detectives arrived."}]}]},"fluke":{"h":"fluke","i":"/fluːk/","a":"en-us-fluke.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fluke is a lucky occurrence that could not be repeated.","e":"The first goal was just a fluke."},{"m":"(countable) A fluke is one side of a whale or dolphin's tail.","e":"The dolphin had an injury on the left fluke of its tail."},{"m":"(countable) A fluke is a flounder, a kind of fish."}]},{"p":"verb","d":[{"m":"If you fluke, you obtain something by pure chance rather than skill.","e":"I fluked a pass in the multiple-choice exam."}]}]},"flukes":{"h":"flukes","l":"fluke","q":"noun"},"fluked":{"h":"fluked","l":"fluke","q":"verb"},"fluking":{"h":"fluking","l":"fluke","q":"verb"},"historiography":{"h":"historiography","i":"/hɪˌstɔriˈɑɡrəfi/","s":[{"p":"noun","d":[{"m":"(uncountable) Historiography is the writing of history."},{"m":"(uncountable) Historiography is the study of how people write about history and how they did so in the past: the \"history of history\"."},{"m":"(countable) A historiography is a written study of how other people have written about some part of history."}]}]},"historiographies":{"h":"historiographies","l":"historiography","q":"noun"},"sinful":{"h":"sinful","i":"/ˈsɪnfəl/","a":"en-us-sinful.ogg","s":[{"p":"adjective","d":[{"m":"A sinful person, act, belief, etc., goes against the religious or moral rules.","e":"The pastor said that talking about others behind their back is sinful."}]}]},"awesome":{"h":"awesome","i":"/ˈɔːsəm/","a":"en-us-awesome.ogg","s":[{"p":"adjective","d":[{"m":"If something is awesome, it's very good.","e":"I love this book, it's awesome."},{"m":"(formal) If something is awesome, it causes you to feel awe or wonder.","e":"The sight of the sun coming up over the mountains was truly awesome."}]}]},"awesomer":{"h":"awesomer","l":"awesome","q":"adjective"},"awesomest":{"h":"awesomest","l":"awesome","q":"adjective"},"impasse":{"h":"impasse","i":"/ˈæmpɑːs/","a":"LL-Q1860 (eng)-Vealhurl-impasse.wav","s":[{"p":"noun","d":[{"m":"(countable) An impasse is a situation in which no progress can be made."}]}]},"impasses":{"h":"impasses","l":"impasse","q":"noun"},"deploy":{"h":"deploy","i":"/dɪˈplɔɪ/","a":"en-us-deploy.oga","s":[{"p":"verb","d":[{"m":"(transitive) If a country deploy troops, they prepare and arrange them for military action.","e":"Deploy two units of infantry along the enemy's flank,\" the general ordered."},{"m":"If you deploy something, you open it or otherwise make it ready for use.","e":"He waited tensely for his parachute to deploy."}]}]},"deploys":{"h":"deploys","l":"deploy","q":"verb"},"deploying":{"h":"deploying","l":"deploy","q":"verb"},"deployed":{"h":"deployed","l":"deploy","q":"verb"},"waiver":{"h":"waiver","i":"/ˈweɪ.və(r)/","a":"LL-Q1860 (eng)-Vealhurl-waiver.wav","s":[{"p":"noun","d":[{"m":"(countable) A waiver is the act of a right, claim, or privilege."},{"m":"A waiver is a legal document that records the waiving of a right, claim, or privilege.","e":"I had to sign a waiver when I went skydiving, agreeing not to sue even if something went wrong."}]}]},"waivers":{"h":"waivers","l":"waiver","q":"noun"},"orangish":{"h":"orangish","a":"en-uk-orangish.ogg","s":[{"p":"adjective","d":[{"m":"If something is orangish, then it is a little orange or similar to orange."}]}]},"tetradecagon":{"h":"tetradecagon","s":[{"p":"noun","d":[{"m":"(countable) A tetradecagon is a shape with fourteen sides."}]}]},"hexadecagon":{"h":"hexadecagon","s":[{"p":"noun","d":[{"m":"(countable) A hexadecagon is a shape with sixteen sides."}]}]},"enneadecagon":{"h":"enneadecagon","s":[{"p":"noun","d":[{"m":"(countable) A enneadecagon is a shape with nineteen sides."}]}]},"octadecagon":{"h":"octadecagon","s":[{"p":"noun","d":[{"m":"(countable) A octadecagon is a shape with eighteen sides."}]}]},"grit":{"h":"grit","i":"/ˈɡrɪt/","a":"en-au-grit.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Grit is very small pieces of stone.","e":"The wind blew a fine grit that got in her teeth, hair, and eyes."},{"m":"(uncountable) If you have grit, you have the strength to keep going despite many difficulties.","e":"Although we lost today, we showed real grit, courage, and a refusal to quit."},{"m":"Grits are ground corn cooked as a porridge, mostly eaten in the southern U.S.","e":"Enjoy a special Mother's Day brunch, including shrimp and grits."}]},{"p":"verb","d":[{"m":"(transitive) If you grit your teeth, you bite them together, usually as you face a difficulty.","e":"Gritting her teeth, she jumped into the icy water."},{"m":"(transitive) If you grit a road or sidewalk, you put small pieces of stone on it to make it less slippery.","e":"They've changed from salting the road in the winter, to gritting it."}]}]},"porridge":{"h":"porridge","i":"/ˈpɒrɪdʒ/","a":"en-au-porridge.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Porridge is oatmeal or other grains boiled in water or milk until they are thick and sticky and usually eaten for breakfast.","e":"He got up, ate a quick bowl of porridge, and set off."}]}]},"grits":{"h":"grits","s":[{"p":"noun","d":[{"m":"Grits are ground corn cooked as a porridge, mostly eaten in the southern U.S.","e":"Enjoy a special Mother's Day brunch, including shrimp and grits."}]}]},"gritted":{"h":"gritted","l":"grit","q":"verb"},"gritting":{"h":"gritting","l":"grit","q":"verb"},"octadecagons":{"h":"octadecagons","l":"octadecagon","q":"noun"},"enneadecagons":{"h":"enneadecagons","l":"enneadecagon","q":"noun"},"hexadecagons":{"h":"hexadecagons","l":"hexadecagon","q":"noun"},"tetradecagons":{"h":"tetradecagons","l":"tetradecagon","q":"noun"},"cashier":{"h":"cashier","i":"/kəˈʃɪə/","a":"LL-Q1860 (eng)-Vealhurl-cashier.wav","s":[{"p":"noun","d":[{"m":"(countable) A cashier is a worker who collects money and gives out change at a store or bank.","e":"My first job was as a cashier at a new grocery store in town."}]},{"p":"verb","d":[{"m":"(transitive) If an officer gets cashiered, they are forced to leave the armed forces because they have done something wrong.","e":"He was cashiered from the army for failing a drug test."}]}]},"cashiers":{"h":"cashiers","l":"cashier","q":"noun"},"cashiered":{"h"