"noun","d":[{"m":"(countable) A proclamation is an official statement that involves something important."}]}]},"proclamations":{"h":"proclamations","l":"proclamation","q":"noun"},"somali":{"h":"Somali","i":"/səˈmɑːli/","a":"LL-Q1860 (eng)-Vealhurl-Somali.wav","s":[{"p":"noun","d":[{"m":"(countable) A person from Somalia."},{"m":"The official language of Somalia."}]},{"p":"adjective","d":[{"m":"From Somalia."}]}]},"somalia":{"h":"Somalia","i":"/səˈmɑːliə/","a":"LL-Q1860 (eng)-Vealhurl-Somalia.wav","s":[{"p":"proper noun","d":[{"m":"Somalia is a country in the Horn of Africa that shares borders with Djibouti and Kenya."}]}]},"horner":{"h":"Horner","s":[{"p":"noun","d":[{"m":"(countable) A Horner is a person or thing that comes from the Horn of Africa."}]},{"p":"adjective","d":[{"m":"Something or someone that is Horner comes from the Horn of Africa.","e":"The northernmost Horner nation is Eritrea."}]}]},"arcade":{"h":"arcade","i":"/ɑrˈkeɪd/","a":"LL-Q1860 (eng)-Vealhurl-arcade.wav","s":[{"p":"noun","d":[{"m":"(countable) An arcade is a covered passage with shops on both sides."},{"m":"(countable) An arcade is a place that has coin-operated games."}]}]},"arcades":{"h":"arcades","l":"arcade","q":"noun"},"somalis":{"h":"Somalis","l":"somali","q":"noun"},"horners":{"h":"Horners","l":"horner","q":"noun"},"loadout":{"h":"loadout","i":"/ˈləʊdaʊt/","a":"LL-Q1860 (eng)-Vealhurl-loadout.wav","s":[{"p":"noun","d":[{"m":"A loadout is a set of objects to be into battle."}]}]},"loadouts":{"h":"loadouts","l":"loadout","q":"noun"},"fizzy":{"h":"fizzy","i":"/ˈfɪzi/","a":"LL-Q1860 (eng)-Vealhurl-fizzy.wav","s":[{"p":"adjective","d":[{"m":"If a drink is fizzy, it contains bubbles."}]}]},"fizzier":{"h":"fizzier","l":"fizzy","q":"adjective"},"fizziest":{"h":"fizziest","l":"fizzy","q":"adjective"},"alcove":{"h":"alcove","i":"/ˈæl.kəʊv/","a":"LL-Q1860 (eng)-Vealhurl-alcove.wav","s":[{"p":"noun","d":[{"m":"(countable) An alcove is a small recessed area in the wall of a larger room."}]}]},"alcoves":{"h":"alcoves","l":"alcove","q":"noun"},"accountability":{"h":"accountability","i":"/ə.ˌkaʊn.tə.ˈbɪl.ət.i/","a":"en-ca-accountabilability.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Accountability is the state of being open and honest about your, especially when there are problems.","e":"It's too often the case that police can avoid accountability for their actions."}]}]},"accountabilities":{"h":"accountabilities","l":"accountability","q":"noun"},"acreage":{"h":"acreage","i":"/ˈeɪk(ə)rɪd͡ʒ/","s":[{"p":"noun","d":[{"m":"(uncountable) The acerage of a property is the area in acres that it covers.","e":"We increased corn acreage by ten percent last year."},{"m":"Somebody's acerage is their large property, often a farm.","e":"This is just a small piece of the acerage that he runs with his brother."}]}]},"acreages":{"h":"acreages","l":"acreage","q":"noun"},"flux":{"h":"flux","i":"/flʌks/","a":"en-us-flux.ogg","s":[{"p":"noun","d":[{"m":"A flux is a chemical agent for cleaning metal prior to soldering or welding.","e":"It is important to use flux when soldering or oxides on the metal will prevent a good bond."},{"m":"Flux is the action or process of flowing."}]},{"p":"verb","d":[{"m":"(transitive) If you flux metal, you use [[#Noun|flux]] on it to promote melting.","e":"You have to flux the joint before soldering."}]}]},"welds":{"h":"welds","l":"weld","q":"verb"},"welded":{"h":"welded","l":"weld","q":"verb"},"welding":{"h":"welding","l":"weld","q":"verb"},"fluxes":{"h":"fluxes","l":"flux","q":"noun"},"fluxed":{"h":"fluxed","l":"flux","q":"verb"},"fluxing":{"h":"fluxing","l":"flux","q":"verb"},"humanities":{"h":"humanities","i":"/hjuˈmæn.ɪ.tiz/","a":"en-us-humanities.ogg","l":"humanity","q":"noun","s":[{"p":"noun","d":[{"m":"Humanities is the study of language, literature, the arts, and philosophy."}]}]},"solder":{"h":"solder","i":"/ˈsɒldə(r)/","a":"en-uk-solder.ogg","s":[{"p":"noun","d":[{"m":"Solder is any type of alloy that melts easily, commonly made up of tin and lead, that is used to coat, or join metal objects."}]},{"p":"verb","d":[{"m":"(transitive) If you solder something, you join items together or coat them with [[#Noun|solder]]."}]}]},"solders":{"h":"solders","l":"solder","q":"noun"},"soldered":{"h":"soldered","l":"solder","q":"verb"},"soldering":{"h":"soldering","i":"/ˈsɑdərɪŋ/","l":"solder","q":"verb"},"metronomes":{"h":"metronomes","l":"metronome","q":"noun"},"rephrase":{"h":"rephrase","i":"/riːfreɪz/","a":"en-us-rephrase.ogg","s":[{"p":"verb","d":[{"m":"If you rephrase something, you say it again in different words."}]}]},"rephrases":{"h":"rephrases","l":"rephrase","q":"verb"},"rephrased":{"h":"rephrased","l":"rephrase","q":"verb"},"rephrasing":{"h":"rephrasing","l":"rephrase","q":"verb"},"swivel":{"h":"swivel","i":"/ˈswɪvəl/","a":"en-us-swivel.ogg","s":[{"p":"noun","d":[{"m":"(mechanical) A swivel is a piece, a ring or hook, attached to another piece by a pin in a way to allow rotation at the axis."}]},{"p":"verb","d":[{"m":"(transitive) If something or someone swivels, it swings or turn as on a pin or pivot."}]}]},"swivels":{"h":"swivels","l":"swivel","q":"noun"},"swiveled":{"h":"swiveled","l":"swivel","q":"verb"},"swiveling":{"h":"swiveling","l":"swivel","q":"verb"},"swivelled":{"h":"swivelled","l":"swivel","q":"verb"},"swivelling":{"h":"swivelling","l":"swivel","q":"verb"},"swizzle":{"h":"swizzle","i":"/ˈswɪz(ə)l/","s":[{"p":"noun","d":[{"m":"A swizzle is any type of mixed alcoholic drink."}]},{"p":"verb","d":[{"m":"If you swizzle something, you stir or mix.","e":"She swizzled the milk into her coffee."}]}]},"swizzles":{"h":"swizzles","l":"swizzle","q":"noun"},"swizzled":{"h":"swizzled","l":"swizzle","q":"verb"},"swizzling":{"h":"swizzling","l":"swizzle","q":"verb"},"aggravation":{"h":"aggravation","i":"/ˈæɡ.rə.veɪ̯.ʃən/","s":[{"p":"noun","d":[{"m":"(uncountable) Aggravation is the feeling of being angry, stressed, and annoyed.","e":"The fact that the children never cleaned was a source of great aggravation for their parents."},{"m":"Aggravation is the worsening of a bad situation.","e":"An aggravation of the original injury can lead to a much longer recovery time."}]}]},"curate":{"h":"curate","i":"/ˈkjʊərət/","a":"LL-Q1860 (eng)-Vealhurl-curate (noun).wav","s":[{"p":"noun","d":[{"m":"A curate is an assistant rector or vicar."},{"m":"A curate is a parish priest."}]},{"p":"verb","d":[{"m":"(transitive) If you curate something, you act as a curator for someone or something.","e":"She curated the traveling exhibition."},{"m":"(transitive) If you curate, you work or act as a curator.","e":"Not only does he curate for the museum, he manages the office and fund-raises."}]}]},"curates":{"h":"curates","l":"curate","q":"noun"},"curated":{"h":"curated","l":"curate","q":"verb"},"curating":{"h":"curating","l":"curate","q":"verb"},"curator":{"h":"curator","i":"/kjʊəˈreɪtə(r)/","a":"LL-Q1860 (eng)-Vealhurl-curator.wav","s":[{"p":"noun","d":[{"m":"(countable) A curator is a person who manages a museum, library, archive or zoo."}]}]},"curators":{"h":"curators","l":"curator","q":"noun"},"artefact":{"h":"artefact","i":"/ˈɑːtɪfækt/","a":"LL-Q1860 (eng)-Vininn126-artefact.wav","s":[{"p":"noun","d":[{"m":"(countable) An artefact is an object that was made by a human."},{"m":"(countable) An artefact is a finding in an investigation that is not a true feature of the object, but is a result of external action, such as an experimental error."},{"m":"(countable) (archaeology) An artefact is an object, such as a tool or weapon, that is found at an archaeological excavation."}]}]},"artifact":{"h":"artifact","i":"/ˈɑːtɪfækt/","a":"LL-Q1860 (eng)-Vininn126-artefact.wav","s":[{"p":"noun","d":[{"m":"(countable) An artifact is an object that was made by a human."},{"m":"(countable) An artifact is a finding in an investigation that is not a true feature of the object but is a result of external action, such as an experimental error."},{"m":"(countable) (archaeology) An artifact is an object, such as a tool or weapon, that is found at an archaeological excavation."}]}]},"artefacts":{"h":"artefacts","l":"artefact","q":"noun"},"artifacts":{"h":"artifacts","l":"artifact","q":"noun"},"excavation":{"h":"excavation","i":"/ˌɛkskəˈveɪʃn/","a":"LL-Q1860 (eng)-Vininn126-excavation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Excavation is the act of digging something, especially an archaeological site."},{"m":"(countable) An excavation is the site that is being or has been excavated."}]}]},"excavations":{"h":"excavations","l":"excavation","q":"noun"},"dervish":{"h":"Dervish","i":"/ˈdɜː(r)vɪʃ/","s":[{"p":"noun","d":[{"m":"(countable) A Dervish was an inhabitant of the Dhulbahante Darawiish kingdom of Diiriye Guure (1896–1920) in the Khatumo region.","e":"The vast majority of Dervishes were Dhulbahante."},{"m":"(countable) A Dervish is a member of a missionary Sufi mystic and ascetic lifestyle.","e":"He was a whirling Dervish."}]}]},"jumbo":{"h":"jumbo","i":"/ˈd͡ʒʌmbəʊ/","a":"en-uk-jumbo.ogg","s":[{"p":"noun","d":[{"m":"A jumbo is something that is very big."}]},{"p":"adjective","d":[{"m":"If something is jumbo, it is very big."}]}]},"jumbos":{"h":"jumbos","l":"jumbo","q":"noun"},"pilgrimage":{"h":"pilgrimage","i":"/ˈpɪlɡrɪmɪd͡ʒ/","a":"LL-Q1860 (eng)-Vealhurl-pilgrimage.wav","s":[{"p":"noun","d":[{"m":"Pilgrimage is a journey made to a sacred place of one's religion.","e":"In the Muslim faith, the pilgrimage to Mecca is known as the Hajj."}]},{"p":"verb","d":[{"m":"If you pilgrimage, you are on a journey to a sacred place."}]}]},"pilgrimages":{"h":"pilgrimages","l":"pilgrimage","q":"noun"},"pilgrimaged":{"h":"pilgrimaged","l":"pilgrimage","q":"verb"},"pilgrimaging":{"h":"pilgrimaging","l":"pilgrimage","q":"verb"},"profane":{"h":"profane","i":"/prəˈfeɪn/","a":"LL-Q1860 (eng)-Vealhurl-profane.wav","s":[{"p":"adjective","d":[{"m":"If something is profane, it is not sacred or holy."},{"m":"If a person is profane, they treat something sacred or religious with disrespect."}]},{"p":"verb","d":[{"m":"(transitive) If you profane, you treat something sacred or religious with disrespect.","e":"One should not profane the name of God."}]}]},"profanes":{"h":"profanes","l":"profane","q":"verb"},"profaned":{"h":"profaned","l":"profane","q":"verb"},"profaning":{"h":"profaning","l":"profane","q":"verb"},"tenanted":{"h":"tenanted","l":"tenant","q":"verb"},"tenanting":{"h":"tenanting","l":"tenant","q":"verb"},"selective":{"h":"selective","i":"/səˈlɛktɪv/","a":"LL-Q1860 (eng)-Vealhurl-selective.wav","s":[{"p":"adjective","d":[{"m":"If something or someone is selective, it is related to the process of selecting something that best a criteria."}]}]},"aggregation":{"h":"aggregation","i":"/æɡrəˈɡeɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-aggregation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Aggregation is the process of bringing things together.","e":"Greater aggregation of cell phone data will create more privacy issues."},{"m":"(countable) An aggregation is a collection brought together in one place.","e":"In June, large aggregations of these fish move up river to feed on smaller fishes."}]}]},"partake":{"h":"partake","i":"/pɑrˈteɪk/","a":"en-us-partake.ogg","s":[{"p":"verb","d":[{"m":"(transitive) (formal) If you partake in something, you participate in it.","e":"Brutes partake in this faculty."},{"m":"(transitive) If you partake something, you take a share or portion it.","e":"Will you partake of some food?"}]}]},"partakes":{"h":"partakes","l":"partake","q":"verb"},"partook":{"h":"partook","l":"partake","q":"verb"},"partaken":{"h":"partaken","l":"partake","q":"verb"},"partaking":{"h":"partaking","l":"partake","q":"verb"},"faculty":{"h":"faculty","i":"/ˈfæ.kəl.ti/","a":"en-us-faculty.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) (US) Faculty are the academic staff at schools, colleges or.","e":"Across all Ontario Colleges, faculty have been on strike for two weeks."},{"m":"(countable) A faculty is a division of a university.","e":"She transferred from the Faculty of Science to the Faculty of Medicine."}]}]},"faculties":{"h":"faculties","l":"faculty","q":"noun"},"agonise":{"h":"agonise","i":"/ˈæ.ɡən.aɪz/","a":"en-agonize.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you agonise over/about a difficult decision or choice, you find making it very difficult, almost painful.","e":"I have been agonising over whether or not to say something to you."}]}]},"agonize":{"h":"agonize","i":"/ˈæ.ɡən.aɪz/","a":"en-agonize.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you agonize over/about a difficult decision or choice, you find making it very difficult, almost painful.","e":"I have been agonizing over whether or not to say something to you."}]}]},"agonising":{"h":"agonising","i":"/ˈæɡ.ə.naɪ.zɪŋ/","l":"agonise","q":"verb","s":[{"p":"adjective","d":[{"m":"An agonising choice, decision, wait, etc. is one that is very, very difficult.","e":"The wait to hear whether his wife had survived was agonising."},{"m":"An agonising death, pain, or injury is very, very painful.","e":"He died a slow, agonising death after falling the in woods and breaking his both legs."}]}]},"agonises":{"h":"agonises","l":"agonise","q":"verb"},"agonised":{"h":"agonised","l":"agonise","q":"verb"},"agonizing":{"h":"agonizing","i":"/ˈæɡ.ə.naɪ.zɪŋ/","l":"agonize","q":"verb","s":[{"p":"adjective","d":[{"m":"An agonizing choice, decision, wait, etc. is one that is very, very difficult.","e":"The wait to hear whether his wife had survived was agonizing."},{"m":"An agonizing death, pain, or injury is very, very painful.","e":"He died a slow, agonizing death after falling the in woods and breaking his both legs."}]}]},"agonizes":{"h":"agonizes","l":"agonize","q":"verb"},"agonized":{"h":"agonized","l":"agonize","q":"verb"},"amplifier":{"h":"amplifier","i":"/ˈæm.plə.faɪ.ə/","s":[{"p":"noun","d":[{"m":"(countable) An amplifier is an electronic device that increases the strength of a sound or signal.","e":"You need to plug in the amplifier to get any sound."}]}]},"amplifiers":{"h":"amplifiers","l":"amplifier","q":"noun"},"annually":{"h":"annually","i":"/ˈæn.ju.ə.li/","a":"en-us-annual.ogg","s":[{"p":"adverb","d":[{"m":"If something happens annually, it happens once a year.","e":"The meeting is held annually in Toronto."},{"m":"An amount or rate considered annually, is the sum or change over the period of a year.","e":"This change will cost the company $5–8 million annually."}]}]},"rescind":{"h":"rescind","i":"/rɪˈsɪnd/","a":"en-us-rescind.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If a law is rescinded, it is cancelled or revoked.","e":"The agency will rescind the policy because many people are dissatisfied with it."}]}]},"rescinds":{"h":"rescinds","l":"rescind","q":"verb"},"rescinded":{"h":"rescinded","l":"rescind","q":"verb"},"rescinding":{"h":"rescinding","l":"rescind","q":"verb"},"revoke":{"h":"revoke","i":"/rɪˈvəʊk/","a":"LL-Q1860 (eng)-Vealhurl-revoke.wav","s":[{"p":"verb","d":[{"m":"(transitive) If something is revoked, it is cancelled or removed officially.","e":"Your driver's license will be revoked."}]}]},"revokes":{"h":"revokes","l":"revoke","q":"verb"},"revoked":{"h":"revoked","l":"revoke","q":"verb"},"revoking":{"h":"revoking","l":"revoke","q":"verb"},"cheaply":{"h":"cheaply","i":"/ˈtʃiːpli/","a":"LL-Q1860 (eng)-Vealhurl-cheaply.wav","s":[{"p":"adverb","d":[{"m":"If you do something cheaply, it doesn't cost you a lot of money.","e":"They were able to move the goods more quickly and cheaply."}]}]},"choosy":{"h":"choosy","i":"/tʃuːzi/","a":"LL-Q1860 (eng)-Vealhurl-choosy.wav","s":[{"p":"adjective","d":[{"m":"If you are choosy, you know what you want or what is good, and you won't easily accept other options.","e":"With so many jobs available, workers can afford to by choosy."}]}]},"electorate":{"h":"electorate","i":"/ɪˈlɛktərət/","a":"LL-Q1860 (eng)-Vealhurl-electorate.wav","s":[{"p":"noun","d":[{"m":"An electorate is the people of a country who are entitled to vote in an election.","e":"The votes have been co