},"frantic":{"h":"frantic","i":"/ˈfræntɪk/","a":"en-us-frantic.ogg","s":[{"p":"adjective","d":[{"m":"If someone is frantic, they are very worried or upset, often because of fear or stress.","e":"She was frantic when she couldn't find her child in the store."},{"m":"If something is done in a frantic way, it is done quickly and with a lot of energy, often in a disorganized way.","e":"There was a frantic search for the missing keys."}]}]},"harness":{"h":"harness","i":"/ˈhɑrnɪs/","a":"en-us-harness.ogg","s":[{"p":"noun","d":[{"m":"(countable) A harness is a set of straps used to control an animal, especially a horse.","e":"The horse's harness was made of leather."},{"m":"(countable) A harness is a set of straps worn for safety, such as when climbing or working at heights.","e":"She wore a safety harness while climbing the mountain."}]},{"p":"verb","d":[{"m":"(transitive) If you harness something, you control and use it, especially energy or natural resources.","e":"They are trying to harness solar power to generate electricity."},{"m":"(transitive) If you harness an animal, you put a [[#Noun|harness]] on it.","e":"The farmer harnessed the horses to the plow."}]}]},"diagonals":{"h":"diagonals","l":"diagonal","q":"noun"},"harnesses":{"h":"harnesses","l":"harness","q":"noun"},"harnessed":{"h":"harnessed","l":"harness","q":"verb"},"harnessing":{"h":"harnessing","l":"harness","q":"verb"},"unharness":{"h":"unharness","s":[{"p":"verb","d":[{"m":"(transitive) If you unharness a horse, you remove the harness from it."}]}]},"unharnesses":{"h":"unharnesses","l":"unharness","q":"verb"},"unharnessed":{"h":"unharnessed","l":"unharness","q":"verb"},"unharnessing":{"h":"unharnessing","l":"unharness","q":"verb"},"fasciate":{"h":"fasciate","i":"/ˈfæʃi.eɪt/","a":"LL-Q1860 (eng)-Vealhurl-fasciate.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you fasciate things, you bind them together."}]}]},"fasciates":{"h":"fasciates","l":"fasciate","q":"verb"},"fasciated":{"h":"fasciated","l":"fasciate","q":"verb"},"fasciating":{"h":"fasciating","l":"fasciate","q":"verb"},"rein":{"h":"rein","i":"/reɪn/","a":"en-us-rein.ogg","s":[{"p":"noun","d":[{"m":"(countable) A rein is a long, narrow strap used to control a horse.","e":"She pulled on the reins to stop the horse."},{"m":"(countable)(usually plural) If you have the reins of government, business, a company, etc, you have control of it.","e":"The manager took the reins of the company after the previous director retired."}]},{"p":"verb","d":[{"m":"(transitive) If you rein something in, you control or limit it.","e":"He tried to rein in his spending habits."},{"m":"(transitive) If you rein in a horse, you pull on the reins to slow or stop it.","e":"She gently reined in the horse before reaching the gate."}]}]},"phenomenal":{"h":"phenomenal","i":"/fəˈnɒmɪnəl/","a":"LL-Q1860 (eng)-Vealhurl-phenomenal.wav","s":[{"p":"adjective","d":[{"m":"If something is phenomenal, it is very great or impressive.","e":"She showed phenomenal skill in the competition."},{"m":"If something is phenomenal, it relates to a phenomenon or something observable.","e":"The scientist studied the phenomenal behaviour of the particles."}]}]},"zoological":{"h":"zoological","i":"/ˌzoʊ.əˈlɒdʒ.ɪ.kəl/","a":"LL-Q1860 (eng)-Vininn126-zoological.wav","s":[{"p":"adjective","d":[{"m":"Zoological specimens, medicine, studies, etc. relate to the study of animals.","e":"He works at the city's zoological research centre."},{"m":"A zoological park, society, garden, etc. is one related to a zoo.","e":"The children visited the zoological gardens."}]}]},"reins":{"h":"reins","l":"rein","q":"noun"},"reined":{"h":"reined","l":"rein","q":"verb"},"reining":{"h":"reining","l":"rein","q":"verb"},"methane":{"h":"methane","i":"/ˈmiːθeɪn/","a":"en-uk-methane.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Methane (CH4) is a type of hydrocarbon that is found as the main part of natural gas.","e":"Methane is an alkane with 1 carbon atom."}]}]},"ethane":{"h":"ethane","i":"/ˈɛθeɪn/","a":"LL-Q1860 (eng)-Vininn126-ethane.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Ethane (C2H6) is a type of hydrocarbon that is found in natural gas.","e":"Ethane is an alkane with 2 carbon atoms."}]}]},"propane":{"h":"propane","i":"/ˈproʊpeɪn/","a":"en-us-propane.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Propane (C3H8) is a type of hydrocarbon that is found in natural gas.","e":"Propane is an alkane with 3 carbon atoms."}]}]},"butane":{"h":"butane","i":"/ˈbjuːteɪn/","a":"LL-Q1860 (eng)-Vininn126-butane.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Butane (C4H10) is a type of hydrocarbon that is found in small amounts in natural gas.","e":"Butane is an alkane with 4 carbon atoms."}]}]},"alkane":{"h":"alkane","i":"/ˈæl.keɪn/","a":"LL-Q1860 (eng)-Vealhurl-alkane.wav","s":[{"p":"noun","d":[{"m":"(countable) Alkanes are chemical compounds, made of carbon and hydrogen.","e":"methane, ethane, propane and, butane are examples of alkanes."}]}]},"alkanes":{"h":"alkanes","l":"alkane","q":"noun"},"rulings":{"h":"rulings","l":"ruling","q":"noun"},"ideate":{"h":"ideate","i":"/ˈaɪdieɪt/","a":"LL-Q1860 (eng)-Vealhurl-ideate.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If a person ideates, they think of an idea."}]}]},"ideates":{"h":"ideates","l":"ideate","q":"verb"},"ideated":{"h":"ideated","l":"ideate","q":"verb"},"ideating":{"h":"ideating","l":"ideate","q":"verb"},"bloviate":{"h":"bloviate","i":"/ˈbloʊ.viˌeɪt/","a":"en-us-bloviate.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If a person bloviates, they speak in a boastful and annoying way."}]}]},"bloviates":{"h":"bloviates","l":"bloviate","q":"verb"},"bloviated":{"h":"bloviated","l":"bloviate","q":"verb"},"bloviating":{"h":"bloviating","l":"bloviate","q":"verb"},"prate":{"h":"prate","i":"/preɪt/","a":"en-us-prate.ogg","s":[{"p":"verb","d":[{"m":"When a person prates, they talk a lot about something that has little purpose."}]}]},"prates":{"h":"prates","l":"prate","q":"verb"},"prated":{"h":"prated","l":"prate","q":"verb"},"prating":{"h":"prating","l":"prate","q":"verb"},"carnitas":{"h":"carnitas","i":"/kaɾˈnitas/","a":"LL-Q1860 (eng)-Flame, not lame-carnitas.wav","s":[{"p":"noun","d":[{"m":"Carnitas is a Mexican dish that involves braised or roasted pork strips."}]}]},"quiche":{"h":"quiche","i":"/kiːʃ/","a":"En-au-quiche.ogg","s":[{"p":"noun","d":[{"m":"A quiche is a baked dish made of eggs, milk, and other ingredients in a pastry crust.","e":"She made a cheese and spinach quiche for dinner."}]}]},"speedy":{"h":"speedy","i":"/ˈspiːdi/","a":"En-au-speedy.ogg","s":[{"p":"adjective","d":[{"m":"A speedy delivery, result, change, etc. is one that happens soon or without delay.","e":"The company promised a speedy delivery of the package."},{"m":"A speedy person, animal, vehicle, etc. is one that moves fast.","e":"He's a speedy runner and always wins races."}]}]},"lifelong":{"h":"lifelong","i":"/ˈlaɪf.lɔːŋ/","a":"LL-Q1860 (eng)-Vealhurl-lifelong.wav","s":[{"p":"adjective","d":[{"m":"A lifelong learning, dreams, and friends are those that last for a person's entire life.","e":"They have been lifelong friends."}]}]},"speedier":{"h":"speedier","l":"speedy","q":"adjective"},"speediest":{"h":"speediest","l":"speedy","q":"adjective"},"quiches":{"h":"quiches","l":"quiche","q":"noun"},"socialite":{"h":"socialite","i":"/ˈsoʊʃəˌlaɪt/","a":"LL-Q1860 (eng)-Vealhurl-socialite.wav","s":[{"p":"noun","d":[{"m":"(countable) A socialite is a woman who is active in social and entertainment"}]}]},"socialites":{"h":"socialites","l":"socialite","q":"noun"},"mortadella":{"h":"mortadella","i":"/mor.taˈdɛl.la/","s":[{"p":"noun","d":[{"m":"Mortadella is an Italian pork sausage with lumps of fat that is eaten cold."}]}]},"mortadellas":{"h":"mortadellas","l":"mortadella","q":"noun"},"mortadelle":{"h":"mortadelle","l":"mortadella","q":"noun"},"hone":{"h":"hone","i":"/hoʊn/","a":"en-us-hone.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hone is a stone that is used to sharpen the blade of a razor."}]},{"p"