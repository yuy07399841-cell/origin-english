","a":"en-us-acrocyanosis.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Acrocyanosis is a medical condition where your toes or fingers become blue. It is caused by cold temperatures or emotional stress."}]}]},"acropolis":{"h":"acropolis","i":"/əˈkrɒpəlɪs/","a":"LL-Q1860 (eng)-Vealhurl-acropolis.wav","s":[{"p":"noun","d":[{"m":"(countable) An acropolis is an old Greek building that people can enter to protect from who are attacking. Acropolises are designed to resist damage."}]}]},"acropolises":{"h":"acropolises","l":"acropolis","q":"noun"},"acropoleis":{"h":"acropoleis","l":"acropolis","q":"noun"},"actinic":{"h":"actinic","i":"/ækˈtɪn ɪk/","a":"LL-Q1860 (eng)-Vealhurl-actinic.wav","s":[{"p":"adjective","d":[{"m":"If something is actinic, it involves or is related to radiation."}]}]},"actinoid":{"h":"actinoid","i":"/ˈæktɪnɔɪd/","a":"LL-Q1860 (eng)-Vealhurl-actinoid.wav","s":[{"p":"noun","d":[{"m":"(countable) An actinoid is a chemical element with an atomic number between 89 and 103."}]}]},"actinoids":{"h":"actinoids","l":"actinoid","q":"noun"},"actinide":{"h":"actinide","i":"/ˈæktɪnaɪd/","a":"LL-Q1860 (eng)-Vealhurl-actinide.wav","s":[{"p":"noun","d":[{"m":"(countable) An actinide is a chemical element with an atomic number between 89 and 103."}]}]},"actinides":{"h":"actinides","l":"actinide","q":"noun"},"actinon":{"h":"actinon","s":[{"p":"noun","d":[{"m":"(countable) An actinon is a chemical element with an atomic number between 89 and 103."}]}]},"actinons":{"h":"actinons","l":"actinon","q":"noun"},"actuate":{"h":"actuate","i":"/ˈæktʃu.eɪt/","a":"en-us-actuate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you actuate something, you cause it to happen."},{"m":"(transitive) If something actuates something, it causes you to do something."}]}]},"actuates":{"h":"actuates","l":"actuate","q":"verb"},"actuated":{"h":"actuated","l":"actuate","q":"verb"},"actuating":{"h":"actuating","l":"actuate","q":"verb"},"actinometer":{"h":"actinometer","s":[{"p":"noun","d":[{"m":"(countable) An actinometer is a device that is used to measure how much electromagnetic radiation something has."}]}]},"actinometers":{"h":"actinometers","l":"actinometer","q":"noun"},"actinometry":{"h":"actinometry","i":"/ˌæktɪˈnɒmətri/","s":[{"p":"noun","d":[{"m":"(uncountable) Actinometry is how much something has."}]}]},"actinomycin":{"h":"actinomycin","s":[{"p":"noun","d":[{"m":"(uncountable) Actinomycin is a yellow drug used to kill dangerous bacteria in humans. It is created from bacteria in soil."}]}]},"activewear":{"h":"activewear","s":[{"p":"noun","d":[{"m":"(uncountable) Activewear is clothing that is designed to be worn while playing a sport."}]}]},"aculeate":{"h":"aculeate","s":[{"p":"adjective","d":[{"m":"If something is aculeate, it has a stinger or has something that looks like a stinger.","e":"Bees are aculeate."}]}]},"aculeated":{"h":"aculeated","s":[{"p":"adjective","d":[{"m":"If something is aculeated, it has a stinger or has something that looks like a stinger.","e":"Bees are aculeated."}]}]},"acuminate":{"h":"acuminate","i":"/əˈkjuːmɪneɪt/","a":"LL-Q1860 (eng)-Vealhurl-acuminate (verb).wav","s":[{"p":"verb","d":[{"m":"(transitive) If you acuminate something, you make it sharp.","e":"I acuminated the knife so that it would cut through fruit better."}]}]},"acuminates":{"h":"acuminates","l":"acuminate","q":"verb"},"acuminated":{"h":"acuminated","l":"acuminate","q":"verb"},"acuminating":{"h":"acuminating","l":"acuminate","q":"verb"},"acupressure":{"h":"acupressure","s":[{"p":"noun","d":[{"m":"(uncountable) Acupressure is a method of treating medical problems by using your hands to apply pressure to different areas of the human body.","e":"My doctor used acupressure to help cure my nasty rash."}]}]},"acupuncture":{"h":"acupuncture","i":"/ˈæ.kju.ˌpʌŋk.t͡ʃɝ/","a":"en-us-acupuncture.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Acupuncture is a method of treating medical problems by using needles to apply pressure to certain areas of the human body.","e":"My doctor used acupuncture to help cure my symptoms."}]}]},"acute":{"h":"acute","i":"/əˈkjuːt/","a":"en-us-acute.ogg","s":[{"p":"adjective","d":[{"m":"If an angle is acute, it is less than 90 degrees in size.","e":"I had to measure the size of the acute angle in math class. It was 35 degrees in size."}]}]},"acuter":{"h":"acuter","l":"acute","q":"adjective"},"acutest":{"h":"acutest","l":"acute","q":"adjective"},"acyclic":{"h":"acyclic","i":"/eɪˈsaɪklɪk/","s":[{"p":"adjective","d":[{"m":"If something is acyclic, it is not cyclic."}]}]},"acyclovir":{"h":"acyclovir","s":[{"p":"noun","d":[{"m":"(uncountable) Acyclovir is a drug used to treat herpes."}]}]},"aciclovir":{"h":"aciclovir","s":[{"p":"noun","d":[{"m":"(uncountable) Aciclovir is a drug used to treat herpes."}]}]},"adactylia":{"h":"adactylia","s":[{"p":"noun","d":[{"m":"(uncountable) If someone or something has adactylia, some of their fingers or toes are missing."}]}]},"adactylism":{"h":"adactylism","s":[{"p":"noun","d":[{"m":"(uncountable) If someone or something has adactylism, some of their fingers or toes are missing."}]}]},"adactyly":{"h":"adactyly","s":[{"p":"noun","d":[{"m":"(uncountable) If someone or something has adactyly, some of their fingers or toes are missing."}]}]},"adage":{"h":"adage","i":"/ˈæ.dɪd͡ʒ/","a":"LL-Q1860 (eng)-Vealhurl-adage.wav","s":[{"p":"noun","d":[{"m":"(countable) An adage is a popular saying that is meant to teach some lesson.","e":"\"Every rose has its thorn\" is an example of an adage."}]}]},"adages":{"h":"adages","l":"adage","q":"noun"},"handbasin":{"h":"handbasin","s":[{"p":"noun","d":[{"m":"(countable) A handbasin is a large bowl fixed to a wall used for washing your hands and face."}]}]},"washbowl":{"h":"washbowl","s":[{"p":"noun","d":[{"m":"(countable) A washbowl is a large bowl fixed to a wall used for washing your hands and face."}]}]},"washstand":{"h":"washstand","s":[{"p":"noun","d":[{"m":"(countable) A washstand is a large bowl fixed to a wall used for washing your hands and face."}]}]},"lavabo":{"h":"lavabo","s":[{"p":"noun","d":[{"m":"(countable) A lavabo is a large bowl fixed to a wall used for washing your hands and face."}]}]},"handbasins":{"h":"handbasins","l":"handbasin","q":"noun"},"washbowls":{"h":"washbowls","l":"washbowl","q":"noun"},"washstands":{"h":"washstands","l":"washstand","q":"noun"},"lavabos":{"h":"lavabos","l":"lavabo","q":"noun"},"nosey":{"h":"nosey","i":"/ˈnəʊziː/","a":"en-us-nosy.ogg","s":[{"p":"adjective","d":[{"m":"If you are nosey, you are curious in a negative way.","e":"He is always too interested in what I am doing. He's such a nosey boy"}]}]},"adactylous":{"h":"adactylous","s":[{"p":"adjective","d":[{"m":"If someone or something is adactylous, they don't have fingers or toes."}]}]},"landladies":{"h":"landladies","l":"landlady","q":"noun"},"hanker":{"h":"hanker","i":"/ˈhaŋkə/","a":"LL-Q1860 (eng)-Vealhurl-hanker.wav","s":[{"p":"verb","d":[{"m":"When you hanker for something, you want, desire and crave for it.","e":"I always love eating chocolates and I hanker for some right now."}]}]},"hankers":{"h":"hankers","l":"hanker","q":"verb"},"hankered":{"h":"hankered","l":"hanker","q":"verb"},"hankering":{"h":"hankering","l":"hanker","q":"verb"},"paparazzi":{"h":"paparazzi","i":"/ˌpɑpəˈrɑtsi/","a":"LL-Q1860 (eng)-Persent101-paparazzi.wav","l":"paparazzo","q":"noun"},"paparazzo":{"h":"paparazzo","i":"/ˌpɑpəˈrɑtsoʊ/","a":"LL-Q1860 (eng)-Vealhurl-paparazzo.wav","s":[{"p":"noun","d":[{"m":"(countable) A paparazzo is a photographer who take pictures of famous people, usually while they are going about normal life routines."}]}]},"discharges":{"h":"discharges","l":"discharge","q":"verb"},"discharged":{"h":"discharged","a":"En-us-discharged.ogg","l":"discharge","q":"verb"},"discharging":{"h":"discharging","l":"discharge","q":"verb"},"gorse":{"h":"gorse","s":[{"p":"noun","d":[{"m":"Gorse is an evergreen shrub with strong spines and yellow flowers, commonly found in Western Europe on dry soils not far from the sea."}]}]},"albedo":{"h":"albedo","i":"/ælˈbi.doʊ/","a":"en-us-albedo.ogg","s":[{"p":"noun","d":[{"m":"(meteorology) An albedo is a fraction of incident light or radiation reflected by a surface, that is usually expressed as a percentage."},{"m":"The albedo is the whitish inner portion of the rind of citrus fruits."}]}]},"albedos":{"h":"albedos","l":"albedo","q":"noun"},"playpen":{"h":"playpen","a":"LL-Q1860 (eng)-Vealhurl-playpen.wav","s":[{"p":"noun","d":[{"m":"A playpen is an enclosed place where a baby plays in."}]}]},"apatheism":{"h":"apatheism","i":"/æ.pə.θi.ɪzəm/","s":[{"p":"noun","d":[{"m":"Apatheism is the lack of interest in a belief or disbelief of the existence of a god."}]}]},"antithesis":{"h":"antithesis","i":"/ænˈtɪ.θə.sɪs/","a":"en-us-antithesis.ogg","s":[{"p":"noun","d":[{"m":"(countable) An antithesis is an idea that is the opposite of another idea."}]}]},"alphanumeric":{"h":"alphanumeric","i":"/ˌæl.fə.n(j)uːˈmɛ.rɪk/","s":[{"p":"adjective","d":[{"m":"An alphanumeric set consists of the numbers 0 to 9 and letters A to Z.","e":"His alphanumeric password is ABC123."}]}]},"butler":{"h":"butler","i":"/ˈbʌt.lə(r)/","a":"en-us-butler.ogg","s":[{"p":"noun","d":[{"m":"(countable) A butler is the main male servant in a large household that controls several other employees."}]}]},"wary":{"h":"wary","i":"/ˈwɛər.i/","a":"LL-Q1860 (eng)-Vealhurl-wary.wav","s":[{"p":"adjective","d":[{"m":"If you are wary of something or someone, you are cautious because you do not know much about them and you believe they may be dangerous.","e":"Walking into the dark room made him wary."}]}]},"warier":{"h":"warier","l":"wary","q":"adjective"},"wariest":{"h":"wariest","l":"wary","q":"adjective"},"sabbatical":{"h":"sabbatical","s":[{"p":"noun","d":[{"m":"A sabbatical is a paid break or rest from work for up to a year so that the employee can do other things not related to his/her job."}]}]},"sabbaticals":{"h":"sabbaticals","l":"sabbatical","q":"noun"},"layoff":{"h":"layoff","i":"/ˈleɪɒf/","a":"LL-Q1860 (eng)-Vealhurl-layoff.wav","s":[{"p":"noun","d":[{"m":"(countable) A layoff is letting employees go from their jobs in order to save money for the company (not because the employees did something wrong)."}]}]},"layoffs":{"h":"layoffs","l":"layoff","q":"noun"},"pandeism":{"h":"pandeism","i":"/pænˈdiːɪz(ə)m/","a":"en-uk-pandeism.oga","s":[{"p":"noun","d":[{"m":"(uncountable) Pandeism is the belief, by or through reason, that God became the universe (nature). In pandeism, because everything is part of God, there is no part of God left that can interact with it."}]}]},"embraces":{"h":"embraces","i":"/ɛmˈbreɪsɪz/","a":"en-us-embraces.ogg","l":"embrace","q":"verb"},"embraced":{"h":"embraced","i":"/ɪmˈbreɪst/","a":"en-us-embraced.ogg","l":"embrace","q":"verb"},"embracing":{"h":"embracing","a":"En-us-embracing.ogg","l":"embrace","q":"verb"},"sodomize":{"h":"sodomize","i":"/ˈsɒdəmaɪz/","a":"LL-Q1860 (eng)-Vealhurl-sodomise.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you sodomize someone, you do anal sex on them."}]}]},"sodomizes":{"h":"sodomizes","l":"sodomize","q":"verb"},"sodomized":{"h":"sodomized","l":"sodomize","q":"verb"},"sodomizing":{"h":"sodomizing","l":"sodomize","q":"verb"},"sodomise":{"h":"sodomise","i":"/ˈsɒdəmaɪz/","a":"LL-Q1860 (eng)-Vealhurl-sodomise.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you sodomise someone, you do anal sex on them."}]}]},"sodomises":{"h":"sodomises","l":"sodomise","q":"verb"},"sodomised":{"h":"sodomised","l":"sodomise","q":"verb"},"sodomising":{"h":"sodomising","l":"sodomise","q":"verb"},"capitalist":{"h":"capitalist","i":"/ˈkæ.pɪ.təl.ɪst/","a":"LL-Q1860 (eng)-Vealhurl-capitalist.wav","s":[{"p":"adjective","d":[{"m":"A capitalist system or country is one that supports capitalism.","e":"To what extent is the capitalist economic system behind the world's social instability?"}]},{"p":"noun","d":[{"m":"(countable) A capitalist is a person who owns significant capital and uses it to earn money.","e":"He invests as a venture capitalist in car companies that have battery-powered cars."},{"m":"(countable) A capitalist is a person who believes in capitalism."}]}]},"enculturation":{"h":"enculturation","s":[{"p":"noun","d":[{"m":"Enculturation is the process of learning about a culture by becoming immersed in it."}]}]},"flipping":{"h":"flipping","l":"flip","q":"verb","s":[{"p":"noun","d":[{"m":"Flipping is a process of buying something cheap, then selling it quickly for more money, usually real estate."}]}]},"gonoduct":{"h":"gonoduct","s":[{"p":"noun","d":[{"m":"A part of the reproductive system in certain animals. It is a tube leading from the gonad towards the sexual opening."}]}]},"gulch":{"h":"gulch","s":[{"p":"noun","d":[{"m":"A gulch is a narrow ravine, usually along the path of a stream."}]}]},"recognition":{"h":"recognition","i":"/ˌrɛkəɡˈnɪʃən/","a":"en-us-recognition.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Recognition is the act of recognizing somebody or something.","e":"The man had been dead so long, his body was beyond recognition."},{"m":"(uncountable) Recognition of something is an acceptance of it.","e":"The group cannot continue its work without international recognition."},{"m":"(uncountable) If someone receives recognition for the things that they have done, people say that those things are good or important.","e":"His writing has received both local and international recognition and awards."}]}]},"batch":{"h":"batch","i":"/bæt͡ʃ/","a":"en-us-batch.ogg","s":[{"p":"noun","d":[{"m":"A batch of things or people is a group that are dealt with at one time."},{"m":"A batch is an amount of something that is made at one time.","e":"The beer is made in small batches in Ypres, Belgium."}]}]},"batches":{"h":"batches","l":"batch","q":"noun"},"reverter":{"h":"reverter","s":[{"p":"noun","d":[{"m":"Someone or something that erases/undoes the action that came before; someone who reverts.","e":"The reverter undid the damage that had been caused earlier."}]}]},"reverters":{"h":"reverters","l":"reverter","q":"noun"},"takfiri":{"h":"Takfiri","s":[{"p":"noun","d":[{"m":"A Muslim who says that another Muslim has apostated."}]}]},"spanglish":{"h":"Spanglish","s":[{"p":"noun","d":[{"m":"The mixing of the Spanish and English languages."}]}]},"differ":{"h":"differ","i":"/ˈdɪfə/","a":"en-us-differ.ogg","s":[{"p":"verb","d":[{"m":"If things differ, they are not the same in some way.","e":"The new cars differ from the old mainly in how they look."},{"m":"If two people differ about something, they don't agree about it.","e":"I differ with him about what we should do here and there."}]}]},"photoperiodism":{"h":"photoperiodism","s":[{"p":"noun","d":[{"m":"A plant's response to the lengths of daylight and darkness each day."}]}]},"pennant":{"h":"pennant","i":"/ˈpɛnənt/","a":"en-us-pennant.ogg","s":[{"p":"noun","d":[{"m":"A flag used to show support for a particular team."},{"m":"In Major League Baseball, a pennant is used to show the National League or American League champion."}]}]},"peduncle":{"h":"peduncle","s":[{"p":"noun","d":[{"m":"A part of a plant. It keeps the sepals in place."}]}]},"opt":{"h":"opt","i":"/ɒpt/","a":"en-us-opt.ogg","s":[{"p":"verb","d":[{"m":"If you opt for something, you choose it instead of something else.","e":"With higher gas prices, more buyers are opting for smaller cars."},{"m":"If you opt out of something, you choose not to do it.","e":"You will continue to receive the email unless you opt out."}]}]},"noosphere":{"h":"noosphere","s":[{"p":"noun","d":[{"m":"Noosphere is a scientific term meaning \"mind-domain\". Noo means mind, and sphere means domain. It is mainly concerned about the mind - its consciousness and relationships with other people."}]}]},"cuteness":{"h":"cuteness","s":[{"p":"noun","d":[{"m":"Cuteness is the state of being cute."}]}]},"colorful":{"h":"colorful","i":"/ˈkʌlɚfəl/","a":"LL-Q1860 (eng)-Vininn126-colourful.wav","s":[{"p":"adjective","d":[{"m":"Something that is colorful has a lot of colors."},{"m":"If your language is colorful, it is rude.","e":"His language is very colorful."}]}]},"in-box":{"h":"in-box","i":"/ˈɪnbɒks/","a":"LL-Q1860 (eng)-Vealhurl-inbox.wav","s":[{"p":"noun","d":[{"m":"(countable) An in-box is an electronic folder that messages can go in.","e":"There is a new email in my in-box."}]}]},"email":{"h":"email","i":"/ˈiːmeɪl/","a":"en-us-e-mail.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Email is a system where people can send a message from one computer to another.","e":"I have a new email in my inbox."},{"m":"(countable) An email is a mail sent through such system."}]}]},"inbox":{"h":"inbox","i":"/ˈɪnbɒks/","a":"LL-Q1860 (eng)-Vealhurl-inbox.wav","s":[{"p":"noun","d":[{"m":"(countable) An inbox is an electronic folder that messages can go in.","e":"There is a new email in my inbox."}]}]},"e-mail":{"h":"e-mail","i":"/ˈiːmeɪl/","a":"en-us-e-mail.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) E-mail is a system where people can send a message from one computer to another/some others.","e":"I have a new e-mail in my inbox."},{"m":"(countable) An e-mail is a mail sent through such system."}]}]},"inboxes":{"h":"inboxes","l":"inbox","q":"noun"},"in-boxes":{"h":"in-boxes","l":"in-box","q":"noun"},"e-mails":{"h":"e-mails","l":"e-mail","q":"noun"},"emails":{"h":"emails","l":"email","q":"noun"},"mandatory":{"h":"mandatory","i":"/ˈmæn.də.t(ə)ri/","a":"en-us-mandatory.ogg","s":[{"p":"adjective","d":[{"m":"If something is mandatory, rules or laws say it must be done.","e":"It is mandatory for children to go to school."}]}]},"forum":{"h":"forum","i":"/ˈfɔːrəm/","a":"LL-Q1860 (eng)-Vealhurl-forum.wav","s":[{"p":"noun","d":[{"m":"(countable) A forum is a place (often on the Internet) where people can talk about things.","e":"I went on a forum and talked to people about religion."}]}]},"forums":{"h":"forums","l":"forum","q":"noun"},"poster":{"h":"poster","i":"/ˈpoʊstɚ/","a":"en-us-poster.ogg","s":[{"p":"noun","d":[{"m":"(countable) A poster is a large piece of paper with a picture or writing on it.","e":"I saw a poster advertising lemonade."},{"m":"(countable) A poster is someone who posts something.","e":"A forum poster left me a message."}]}]},"posters":{"h":"posters","l":"poster","q":"noun"},"fora":{"h":"fora","l":"forum","q":"noun"},"evolutionary":{"h":"evolutionary","i":"/ˌiːvəˈl(j)uːʃənri/","a":"en-us-evolutionary.ogg","s":[{"p":"adjective","d":[{"m":"Something that is related to evolution.","e":"Humans have a long and complicated evolutionary history."}]}]},"physically":{"h":"physically","i":"/ˈfɪzɪkli/","a":"LL-Q1860 (eng)-I learned some phrases-physically.wav","s":[{"p":"adverb","d":[{"m":"Something that is done in a physical way.","e":"He physically the weak, causing them to be injured."}]}]},"fitness":{"h":"fitness","i":"/ˈfɪtnəs/","a":"en-us-fitness.ogg","s":[{"p":"noun","d":[{"m":"Fitness is the ability of an organism to survive and reproduce.","e":"In cold places, fur can increase evolutionary fitness."},{"m":"Fitness is the condition of being physically healthy.","e":"You need to improve your fitness if you want to live for a long time."}]}]},"fitnesses":{"h":"fitnesses","l":"fitness","q":"noun"},"eighth":{"h":"eighth","i":"/eɪtθ/","a":"en-us-eighth.ogg","s":[{"p":"adjective","d":[{"m":"The eighth thing is the one that is number eight (8) in order.","e":"James Irwin was the eighth person to walk on the moon."}]},{"p":"noun","d":[{"m":"(countable) An eighth of something is one of eight equal parts of that thing.","e":"Half of one quarter is an eighth."}]}]},"eighths":{"h":"eighths","l":"eighth","q":"noun"},"fluent":{"h":"fluent","i":"/ˈfluːənt/","a":"en-us-fluent.ogg","s":[{"p":"adjective","d":[{"m":"Someone who is fluent in a language can speak it confidently and accurately.","e":"John is fluent in English, Spanish and Russian."}]}]},"confidently":{"h":"confidently","i":"/ˈkɑnfɪdəntli/","a":"en-us-confidently.ogg","s":[{"p":"adverb","d":[{"m":"When someone does something confidently, it is done in a confident way.","e":"He strolled confidently down the street."}]}]},"confident":{"h":"confident","i":"/ˈkɒn.fɪ.dənt/","a":"en-us-confident.ogg","s":[{"p":"adjective","d":[{"m":"When someone is confident, the person is certain of something.","e":"I am confident that I will win."}]}]},"milestone":{"h":"milestone","i":"/ˈmaɪlstəʊn/","a":"LL-Q1860 (eng)-Vealhurl-milestone.wav","s":[{"p":"noun","d":[{"m":"(countable) A milestone is an important step on the way to a larger goal.","e":"It was an important milestone for the project."}]}]},"milestones":{"h":"milestones","l":"milestone","q":"noun"},"anagram":{"h":"anagram","i":"/ˈæ.nə.ɡræm/","a":"en-us-anagram.ogg","s":[{"p":"noun","d":[{"m":"(countable) A word or phrase that can be made by (moving) the letters to form another word or phrase.","e":"The word \"leader\" is an anagram of \"dealer\"."}]}]},"anagrams":{"h":"anagrams","l":"anagram","q":"noun"},"rearrange":{"h":"rearrange","i":"/ˌriːəˈreɪndʒ/","a":"LL-Q1860 (eng)-Vealhurl-rearrange.wav","s":[{"p":"verb","d":[{"m":"If you rearrange something, you change the order of (or move) it.","e":"s are formed when you rearrange the letters of a word."}]}]},"rearranging":{"h":"rearranging","l":"rearrange","q":"verb"},"rearranged":{"h":"rearranged","l":"rearrange","q":"verb"},"rearranges":{"h":"rearranges","l":"rearrange","q":"verb"},"wedgie":{"h":"wedgie","i":"/ˈwɛdʒ.i/","a":"en-au-wedgie.ogg","s":[{"p":"noun","d":[{"m":"(countable) If you give someone a wedgie, you pull their underpants upwards.","e":"The bully gave me a wedgie."}]},{"p":"verb","d":[{"m":"(transitive) If you wedgie a person, you give them a [[#Noun|wedgie]]."}]}]},"wedgies":{"h":"wedgies","l":"wedgie","q":"noun"},"wedgying":{"h":"wedgying","l":"wedgie","q":"verb"},"wedgied":{"h":"wedgied","l":"wedgie","q":"verb"},"swirlie":{"h":"swirlie","s":[{"p":"noun","d":[{"m":"If you give someone a swirlie, you hold their head down a toilet and flush it.","e":"The bully gave me a swirlie."}]}]},"swirlies":{"h":"swirlies","l":"swirlie","q":"noun"},"swirly":{"h":"swirly","s":[{"p":"noun","d":[{"m":"(countable) If you give someone a swirlie, you hold their head down a toilet and flush it.","e":"The bully gave me a swirlie."}]}]},"lighten":{"h":"lighten","i":"/ˈlaɪ.tən/","a":"LL-Q1860 (eng)-Vealhurl-lighten.wav","s":[{"p":"verb","d":[{"m":"If you lighten something, you reduce its weight."},{"m":"If you lighten something, you make it less dark.","e":"She lightened the room by opening the curtains."},{"m":"If you lighten something, you make it more cheerful or less serious.","e":"She lightened the mood by making a joke."}]}]},"lightened":{"h":"lightened","l":"lighten","q":"verb"},"lightening":{"h":"lightening","l":"lighten","q":"verb"},"lightens":{"h":"lightens","l":"lighten","q":"verb"},"historic":{"h":"historic","i":"/(h)ɪˈstɒrɪk/","a":"en-us-historic.ogg","s":[{"p":"adjective","d":[{"m":"If something is historic, it is important to history.","e":"This historic event will be remembered for generations."}]}]},"quieten":{"h":"quieten","i":"/ˈkwaɪ.ə.tən/","a":"en-us-quieten.ogg","s":[{"p":"verb","d":[{"m":"If you quieten something, you make it more quiet.","e":"He told his daughter to quieten down."}]}]},"quietened":{"h":"quietened","l":"quieten","q":"verb"},"quietening":{"h":"quietening","l":"quieten","q":"verb"},"quietens":{"h":"quietens","l":"quieten","q":"verb"},"mindset":{"h":"mindset","a":"En-us-mindset.ogg","s":[{"p":"noun","d":[{"m":"A mindset is a way of thinking.","e":"You need to change your mindset and be more open to other people's ideas."}]}]},"mindsets":{"h":"mindsets","l":"mindset","q":"noun"},"bollocks":{"h":"bollocks","i":"/ˈbɒ.ləks/","a":"en-uk-bollocks.ogg","l":"bollock","q":"verb","s":[{"p":"noun","d":[{"m":"Someone's bollocks are their testicles.","e":"He was kicked in the bollocks."},{"m":"If something is bollocks, it is nonsense or untrue.","e":"That's a load of bollocks."}]}]},"flatted":{"h":"flatted","l":"flat","q":"verb"},"flatting":{"h":"flatting","a":"EN-AU c