,"d":[{"m":"(countable) (usually plural) Pharmaceuticals are a drugs or medicine prepared by a pharmacy.","e":"The animals were regularly being given pharmaceuticals in their feed."}]}]},"pharmaceuticals":{"h":"pharmaceuticals","s":[{"p":"noun","d":[{"m":"(countable) (usually plural) Pharmaceuticals are a drugs or medicine prepared by a pharmacy.","e":"The animals were being given pharmaceutical in their feed."}]}]},"counterargue":{"h":"counterargue","i":"/ˌkaʊntəˈrɑːɡjuː/","s":[{"p":"verb","d":[{"m":"If you counterargue with someone, you argue against them."}]}]},"counterargues":{"h":"counterargues","l":"counterargue","q":"verb"},"counterargued":{"h":"counterargued","l":"counterargue","q":"verb"},"counterarguing":{"h":"counterarguing","l":"counterargue","q":"verb"},"counterplot":{"h":"counterplot","i":"/ˈkaʊn.tə.plɒt/","a":"en-us-counterplot.ogg","s":[{"p":"noun","d":[{"m":"(countable) A counterplot is a plot made in opposition to another."}]},{"p":"verb","d":[{"m":"If you counterplot, you form a plot or plan in opposition to the actions of another."}]}]},"counterplots":{"h":"counterplots","l":"counterplot","q":"noun"},"counterplotted":{"h":"counterplotted","l":"counterplot","q":"verb"},"counterplotting":{"h":"counterplotting","l":"counterplot","q":"verb"},"salinity":{"h":"salinity","i":"/səˈlɪnɪti/","a":"LL-Q1860 (eng)-Vealhurl-salinity.wav","s":[{"p":"noun","d":[{"m":"The salinity of something is the concentration of salt in it."}]}]},"salinities":{"h":"salinities","l":"salinity","q":"noun"},"earache":{"h":"earache","i":"/ˈɪə̯reɪk/","a":"LL-Q1860 (eng)-Flame, not lame-earache.wav","s":[{"p":"noun","d":[{"m":"(countable) An earache is a pain in your ears."}]}]},"earaches":{"h":"earaches","l":"earache","q":"noun"},"agronomist":{"h":"agronomist","i":"/əˈɡrɒnəmɪst/","s":[{"p":"noun","d":[{"m":"(countable) An agronomist is a scientist whose specializes in agronomy."}]}]},"agronomists":{"h":"agronomists","l":"agronomist","q":"noun"},"embryology":{"h":"embryology","i":"