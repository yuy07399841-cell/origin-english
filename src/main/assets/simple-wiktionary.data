interpreter."}]}]},"creators":{"h":"creators","l":"creator","q":"noun"},"creatively":{"h":"creatively","s":[{"p":"adverb","d":[{"m":"If you do something creatively, you do it in a creative way.","e":"You built that creatively."}]}]},"achievement":{"h":"achievement","i":"/əˈtʃiːvmənt/","a":"en-us-achievement.ogg","s":[{"p":"noun","d":[{"m":"(countable) An achievement is something that is or was achieved.","e":"Winning a championship is a great achievement."}]}]},"achievements":{"h":"achievements","l":"achievement","q":"noun"},"owes":{"h":"owes","l":"owe","q":"verb"},"owed":{"h":"owed","a":"En-us-owed.ogg","l":"owe","q":"verb"},"ministries":{"h":"ministries","l":"ministry","q":"noun"},"expressed":{"h":"expressed","i":"/ɪkˈsprest/","a":"en-us-expressed.ogg","l":"express","q":"verb"},"expressing":{"h":"expressing","i":"/ɛk.ˈsprɛsɪŋ/","l":"express","q":"verb"},"undergoes":{"h":"undergoes","l":"undergo","q":"verb"},"underwent":{"h":"underwent","l":"undergo","q":"verb"},"undergone":{"h":"undergone","l":"undergo","q":"verb"},"undergoing":{"h":"undergoing","l":"undergo","q":"verb"},"disappoints":{"h":"disappoints","l":"disappoint","q":"verb"},"disappointed":{"h":"disappointed","i":"/ˌdɪsəˈpɔɪntɪd/","a":"en-us-disappointed.ogg","l":"disappoint","q":"verb"},"disappointing":{"h":"disappointing","i":"/dɪsəˈpɔɪntɪŋ/","a":"LL-Q1860 (eng)-Flame, not lame-disappointing.wav","l":"disappoint","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is disappointing, it causes disappointment."}]}]},"calculates":{"h":"calculates","l":"calculate","q":"verb"},"calculated":{"h":"calculated","i":"/ˈkælkjʊleɪtɪd/","a":"en-us-calculated.ogg","l":"calculate","q":"verb"},"calculating":{"h":"calculating","i":"/ˈkælkyəˌleɪtɪŋ/","l":"calculate","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone is calculating, they plan or scheme things and only think of themselves.","e":"The cold and calculating lawyer was willing to win the case no matter what the cost."}]}]},"admiration":{"h":"admiration","i":"/ˌæd.mɚˈeɪʃ.ən/","a":"en-us-admiration.ogg","s":[{"p":"noun","d":[{"m":"Admiration is the act of admiring.","e":"They showed much admiration."}]}]},"admirations":{"h":"admirations","l":"admiration","q":"noun"},"gathers":{"h":"gathers","l":"gather","q":"verb"},"gathered":{"h":"gathered","i":"/ˈɡæðəd/","a":"en-us-gathered.ogg","l":"gather","q":"verb"},"gathering":{"h":"gathering","i":"/ˈɡæ.ðə.rɪŋ/","a":"en-us-gathering.ogg","l":"gather","q":"verb","s":[{"p":"noun","d":[{"m":"A gathering is an assembly or meeting of a group of people."}]}]},"burros":{"h":"burros","l":"burro","q":"noun"},"uppers":{"h":"uppers","l":"upper","q":"noun"},"weakness":{"h":"weakness","i":"/ˈwiːk.nəs/","a":"en-us-weakness.ogg","s":[{"p":"noun","d":[{"m":"Weakness is the condition of being weak.","e":"She had become very ill, and her weakness kept her from going to the party."},{"m":"A weakness is a fault.","e":"I love the taste of sugar. That's my weakness."}]}]},"weaknesses":{"h":"weaknesses","l":"weakness","q":"noun"},"follower":{"h":"follower","i":"/ˈfɒləʊə(r)/","a":"LL-Q1860 (eng)-Vealhurl-follower.wav","s":[{"p":"noun","d":[{"m":"(countable) A follower is someone who follows.","e":"The band has a large number of followers."},{"m":"(countable) One who is a part of master's physical group, such as a servant or retainer."}]}]},"followers":{"h":"followers","l":"follower","q":"noun"},"unbelievable":{"h":"unbelievable","i":"/ˌʌnbəˈliːvəbl̩/","a":"en-us-unbelievable.ogg","s":[{"p":"adjective","d":[{"m":"If something is unbelievable, it cannot be believed; it is not believable.","e":"You have an unbelievable number of points!"}]}]},"blogger":{"h":"blogger","i":"/ˈblɒ.ɡə(r)/","a":"LL-Q1860 (eng)-Vealhurl-blogger.wav","s":[{"p":"noun","d":[{"m":"(countable) A blogger is a person who blogs.","e":"He is a blogger and writes about his daily life on the Internet."}]}]},"bloggers":{"h":"bloggers","l":"blogger","q":"noun"},"snowstorm":{"h":"snowstorm","i":"/ˈsnəʊstɔːm/","a":"en-us-snowstorm.ogg","s":[{"p":"noun","d":[{"m":"(countable) A snowstorm is a time when there is a lot of wind and snow in the air.","e":"There was a big snowstorm that winter."}]}]},"snowstorms":{"h":"snowstorms","l":"snowstorm","q":"noun"},"arrests":{"h":"arrests","l":"arrest","q":"verb"},"arrested":{"h":"arrested","i":"/əˈrɛstɪd/","a":"en-us-arrested.ogg","l":"arrest","q":"verb"},"arresting":{"h":"arresting","l":"arrest","q":"verb"},"toenail":{"h":"toenail","i":"/ˈtəʊˌneɪl/","a":"en-us-toenail.ogg","s":[{"p":"noun","d":[{"m":"(countable) A toenail is a nail on a toe.","e":"My toenail still hurts when I walk in those small sneakers."}]}]},"toenails":{"h":"toenails","l":"toenail","q":"noun"},"entitles":{"h":"entitles","l":"entitle","q":"verb"},"entitled":{"h":"entitled","l":"entitle","q":"verb"},"entitling":{"h":"entitling","l":"entitle","q":"verb"},"disagree":{"h":"disagree","i":"/dɪsəˈɡriː/","a":"LL-Q1860 (eng)-Vealhurl-disagree.wav","s":[{"p":"verb","d":[{"m":"If you disagree, you do not agree. When two people disagree with each other, they have different ideas. They do not believe the same things are true.","e":"I disagree with you."},{"m":"When someone disagrees with something that was said or written, the person thinks it's not true and doesn't believe it.","e":"I disagree with that."}]}]},"disagrees":{"h":"disagrees","l":"disagree","q":"verb"},"disagreed":{"h":"disagreed","l":"disagree","q":"verb"},"disagreeing":{"h":"disagreeing","l":"disagree","q":"verb"},"unanswered":{"h":"unanswered","i":"/ʌnˈɑːnsəd/","s":[{"p":"adjective","d":[{"m":"If something is unanswered, it is not answered.","e":"The call is unanswered."}]}]},"unborn":{"h":"unborn","s":[{"p":"adjective","d":[{"m":"If something or someone is unborn, it has not been born; it is yet to come.","e":"Her unborn child."},{"m":"If something or someone is unborn, it exists without having been born or without a beginning."}]}]},"nonmetal":{"h":"nonmetal","a":"LL-Q1860 (eng)-Flame, not lame-nonmetal.wav","s":[{"p":"noun","d":[{"m":"(countable) If an element is a nonmetal, it is not like a metal.","e":"is a nonmetal."}]}]},"colon":{"h":"colon","i":"/ˈkəʊ.lən/","a":"en-us-colon.ogg","s":[{"p":"noun","d":[{"m":"(countable) The colon is a part of the digestive system."},{"m":"(countable) A colon is the sign:. It is often used in a sentence to indicate the beginning of a list.","e":"Her grocery list had three items: bread, milk, and cheese."}]}]},"colons":{"h":"colons","l":"colon","q":"noun"},"nonmetals":{"h":"nonmetals","l":"nonmetal","q":"noun"},"octopuses":{"h":"octopuses","l":"octopus","q":"noun"},"octopi":{"h":"octopi","l":"octopus","q":"noun"},"carelessly":{"h":"carelessly","i":"/ˈkɛrləsli/","a":"LL-Q1860 (eng)-Vealhurl-carelessly.wav","s":[{"p":"adverb","d":[{"m":"If you do something carelessly, you do it without giving any attention or care to it.","e":"Marcia carelessly drove through a red light, almost causing an accident."}]}]},"millenniums":{"h":"millenniums","l":"millennium","q":"noun"},"millennia":{"h":"millennia","l":"millennium","q":"noun"},"graves":{"h":"graves","l":"grave","q":"noun"},"settings":{"h":"settings","i":"/ˈsɛtɪŋz/","l":"setting","q":"noun"},"inaccurate":{"h":"inaccurate","i":"/ɪnˈæ.kjʊ.rət/","a":"en-us-inaccurate.ogg","s":[{"p":"adjective","d":[{"m":"If something is inaccurate, it is mistaken or not correct; it is not accurate.","e":"The information on the website is inaccurate."}]}]},"burgles":{"h":"burgles","l":"burgle","q":"verb"},"burgled":{"h":"burgled","l":"burgle","q":"verb"},"burgling":{"h":"burgling","l":"burgle","q":"verb"},"mysteriously":{"h":"mysteriously","i":"/mɪˈstɪəri.əsli/","a":"en-us-mysteriously.ogg","s":[{"p":"adverb","d":[{"m":"If something is done mysteriously, it is done in an unexplainable or puzzling way.","e":"He vanished mysteriously."}]}]},"explainable":{"h":"explainable","s":[{"p":"adjective","d":[{"m":"If something is explainable, it can be understood or explained."}]}]},"unexplainable":{"h":"unexplainable","s":[{"p":"adjective","d":[{"m":"If something is unexplainable, it cannot be understood or explained."}]}]},"cosmoses":{"h":"cosmoses","l":"cosmos","q":"noun"},"preparing":{"h":"preparing","i":"/prɪˈpɛərɪŋ/","a":"en-us-preparing.ogg","l":"prepare","q":"verb"},"unlikelier":{"h":"unlikelier","l":"unlikely","q":"adjective"},"unlikeliest":{"h":"unlikeliest","l":"unlikely","q":"adjective"},"kneed":{"h":"kneed","i":"/niːd/","a":"en-us-knead.ogg","l":"knee","q":"verb"},"kneeing":{"h":"kneeing","l":"knee","q":"verb"},"disappointingly":{"h":"disappointingly","s":[{"p":"adverb","d":[{"m":"If something is done disappointingly, it is done in a way that will make something be not as good as expected; it will bring disappointment.","e":"He thought that he would get 3 points, but disappointingly got only 2."}]}]},"dwell":{"h":"dwell","i":"/dwel/","a":"en-us-dwell.ogg","s":[{"p":"verb","d":[{"m":"If a person dwells somewhere, they live there.","e":"I will dwell deep in the forest."},{"m":"To dwell on/upon something means to keep thinking or talking about something, especially something bad or unpleasant.","e":"He dwelled on the problem for some time."},{"m":"To dwell on/upon something means to think or talk a lot about something."}]}]},"dwells":{"h":"dwells","i":"/dwɛlz/","a":"en-us-dwells.ogg","l":"dwell","q":"verb"},"dwelled":{"h":"dwelled","i":"/'dwɛld/","a":"en-us-dwelled.ogg","l":"dwell","q":"verb"},"dwelling":{"h":"dwelling","i":"/ˈdwɛl.ɪŋ/","a":"en-us-dwelling.ogg","l":"dwell","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A dwelling is a building or place where someone lives.","e":"The old house served as a dwelling for Albert."}]}]},"grandfathered":{"h":"grandfathered","l":"grandfather","q":"verb"},"grandfathering":{"h":"grandfathering","l":"grandfather","q":"verb"},"ensuring":{"h":"ensuring","l":"ensure","q":"verb"},"ensured":{"h":"ensured","l":"ensure","q":"verb"},"ensures":{"h":"ensures","l":"ensure","q":"verb"},"narcissi":{"h":"narcissi","l":"narcissus","q":"noun"},"narcissuses":{"h":"narcissuses"