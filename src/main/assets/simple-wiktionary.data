uss is a kiss on the lips."}]},{"p":"verb","d":[{"m":"(transitive) If you buss someone, you kiss them on the lips."}]}]},"pursuances":{"h":"pursuances","l":"pursuance","q":"noun"},"theologies":{"h":"theologies","l":"theology","q":"noun"},"emphasise":{"h":"emphasise","i":"/ˈɛm.fə.saɪz/","a":"LL-Q1860 (eng)-Vininn126-emphasize.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you emphasise something, you give it particular attention or importance.","e":"Emphasise honesty in your sermon."}]}]},"emphasises":{"h":"emphasises","l":"emphasise","q":"verb"},"emphasised":{"h":"emphasised","l":"emphasise","q":"verb"},"emphasising":{"h":"emphasising","l":"emphasise","q":"verb"},"civilisation":{"h":"civilisation","i":"/ˌsɪv.ɪ.laɪˈzeɪ.ʃən/","a":"en-us-civilization.ogg","s":[{"p":"noun","d":[{"m":"(countable) A civilisation is an organised culture encompassing many, often on the scale of a nation or a people; a stage or system of political or technical development."}]}]},"civilisations":{"h":"civilisations","l":"civilisation","q":"noun"},"civilizations":{"h":"civilizations","l":"civilization","q":"noun"},"riggings":{"h":"riggings","l":"rigging","q":"noun"},"nicknamed":{"h":"nicknamed","l":"nickname","q":"verb"},"nicknaming":{"h":"nicknaming","l":"nickname","q":"verb"},"inoffensive":{"h":"inoffensive","s":[{"p":"adjective","d":[{"m":"If something is inoffensive, it is not offensive.","e":"Unlike my parents, I think farting is inoffensive."}]}]},"inopportune":{"h":"inopportune","s":[{"p":"adjective","d":[{"m":"If an event happens at an inopportune time, it happens at a time that you don't want it to."}]}]},"inodorous":{"h":"inodorous","s":[{"p":"adjective","d":[{"m":"If something is inodorous, it does not smell. It has no odor."}]}]},"slurp":{"h":"slurp","i":"/slɝp/","a":"LL-Q1860 (eng)-Vealhurl-slurp.wav","s":[{"p":"verb","d":[{"m":"When you slurp, you make a lot of noise while you drink.","e":"People got distracted when I slurped my chocolate milk."}]}]},"slurps":{"h":"slurps","l":"slurp","q":"verb"},"slurped":{"h":"slurped","l":"slurp","q":"verb"},"slurping":{"h":"slurping","l":"slurp","q":"verb"},"fib":{"h":"fib","i":"/fɪb/","s":[{"p":"verb","d":[{"m":"If you fib, you tell a small lie.","e":"He was caught fibbing."}]}]},"fibs":{"h":"fibs","l":"fib","q":"verb"},"fibbed":{"h":"fibbed","l":"fib","q":"verb"},"fibbing":{"h":"fibbing","l":"fib","q":"verb"},"beetle":{"h":"beetle","i":"/ˈbiːtəl/","a":"en-us-beetle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A beetle is a kind of insect."}]}]},"sheepdog":{"h":"sheepdog","i":"/ʃiːpˈdɒɡ/","a":"en-au-sheepdog.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sheepdog is a large kind of dog that moves flocks of sheep"}]}]},"beetles":{"h":"beetles","l":"beetle","q":"noun"},"sheepdogs":{"h":"sheepdogs","l":"sheepdog","q":"noun"},"covet":{"h":"covet","i":"/ˈkʌvɪt/","a":"LL-Q1860 (eng)-Vealhurl-covet.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you covet something, you wrongfully or unreasonably want to have something that belongs to another person.","e":"Much of the nobility coveted the king's wealth and power."},{"m":"(transitive) If you covet something, you eagerly want to get it.","e":"I think nearly every science fiction writer covets the Hugo Award, even if they wouldn't admit it."},{"m":"(intransitive) If you covet, you wrongfully or unreasonably want a thing that belongs to another person.","e":"We should not covet, but be grateful for what we already have."}]}]},"intrudable":{"h":"intrudable","s":[{"p":"adjective","d":[{"m":"When something is intrudable, it can be broken into or intruded.","e":"This is not an easily intrudable house."}]}]},"heterotrophic":{"h":"heterotrophic","s":[{"p":"adjective","d":[{"m":"Obtains nutrience from external sources due to the lack of ability to synthesize food.","e":"Humans are heterotrophic creatures."}]}]},"latifundia":{"h":"latifundia","l":"latifundium","q":"noun"},"latifundium":{"h":"latifundium","s":[{"p":"noun","d":[{"m":"A latifundium is a huge estate bought up by wealthy Roman families."}]}]},"ecologist":{"h":"ecologist","s":[{"p":"noun","d":[{"m":"(countable) An ecologist is a person who studies ecology."}]}]},"ecologists":{"h":"ecologists","l":"ecologist","q":"noun"},"burrito":{"h":"burrito","i":"/bəˈriː.təʊ/","a":"LL-Q1860 (eng)-Vealhurl-burrito.wav","s":[{"p":"noun","d":[{"m":"(countable) A burrito is a type of Mexican food that is made with meat wrapped in flour tortilla."}]}]},"critter":{"h":"critter","s":[{"p":"noun","d":[{"m":"a critter is an animal."}]}]},"ageists":{"h":"ageists","l":"ageist","q":"noun"},"demote":{"h":"demote","i":"/dɪˈməʊt/","a":"LL-Q1860 (eng)-Vealhurl-demote.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you demote someone or something, you move them to a lower level or rank, but not physically.","e":"The officer was demoted for bad behavior."}]}]},"demotes":{"h":"demotes","l":"demote","q":"verb"},"demoted":{"h":"demoted","l":"demote","q":"verb"},"demoting":{"h":"demoting","l":"demote","q":"verb"},"demotion":{"h":"demotion","s":[{"p":"noun","d":[{"m":"(countable) If you get a demotion you move down in rank or position.","e":"He received a demotion to sergeant."}]}]},"demotions":{"h":"demotions","l":"demotion","q":"noun"},"transits":{"h":"transits","l":"transit","q":"noun"},"marmalade":{"h":"marmalade","i":"/ˈmɑː.mə.leɪd/","a":"en-us-marmalade.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Marmalade is a kind of jam made with oranges.","e":"I want marmalade on my toast."}]}]},"marmalades":{"h":"marmalades","l":"marmalade","q":"noun"},"lest":{"h":"lest","i":"/lɛst/","a":"en-us-lest.ogg","s":[{"p":"preposition","d":[{"m":"(formal) If you do something lest something unpleasant happen, you do it to try to prevent the unpleasant thing from happening.","e":"She said nothing, lest anyone think she didn't agree."}]}]},"critters":{"h":"critters","l":"critter","q":"noun"},"burritos":{"h":"burritos","l":"burrito","q":"noun"},"biometrics":{"h":"biometrics","s":[{"p":"noun","d":[{"m":"Biometrics is a system that detects unique human characteristics using DNA of people."}]}]},"millionaire":{"h":"millionaire","i":"/ˌmɪl.jəˈnɛɚ/","a":"LL-Q1860 (eng)-Vealhurl-millionaire.wav","s":[{"p":"noun","d":[{"m":"(countable) A millionaire is a person who has one million dollars or more.","e":"The CEO was named as one of the youngest millionaires of the United States."}]}]},"coconut":{"h":"coconut","i":"/ˈkoʊ.kə.nʌt/","a":"en-au-coconut.ogg","s":[{"p":"noun","d":[{"m":"(countable) A coconut is a large seed that grows in a coconut palm."}]}]},"millionaires":{"h":"millionaires","l":"millionaire","q":"noun"},"billionaire":{"h":"billionaire","i":"/ˌbɪl.jəˈnɛɚ/","a":"LL-Q1860 (eng)-Vealhurl-billionaire.wav","s":[{"p":"noun","d":[{"m":"(countable) A billionaire is a person who has one billion dollars or more."}]}]},"billionaires":{"h":"billionaires","l":"billionaire","q":"noun"},"gigaton":{"h":"gigaton","s":[{"p":"noun","d":[{"m":"(countable) A gigaton is a unit that is used to determine how strong an explosion made by a bomb is."}]}]},"gigatons":{"h":"gigatons","l":"gigaton","q":"noun"},"coconuts":{"h":"coconuts","l":"coconut","q":"noun"},"quotidian":{"h":"quotidian","i":"/kwəˈtɪdɪən/","a":"en-us-quotidian.ogg","s":[{"p":"adjective","d":[{"m":"If something is quotidian, it is not special because it happens every day or is very common.","e":"What do you do outside of work, besides the quotidian tasks of life?"}]}]},"aromantic":{"h":"aromantic","i":"/ˌeɪ.rəʊˈman.tɪk/","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-aromantic.wav","s":[{"p":"adjective","d":[{"m":"When someone is aromantic, they do not have any romantic desire or attraction."}]},{"p":"noun","d":[{"m":"An aromantic is a person that does not have any romantic desire or attraction; a person with aromanticism."}]}]},"aromanticism":{"h":"aromanticism","a":"LL-Q1860 (eng)-NaomiAmethyst-aromanticism.wav","s":[{"p":"noun","d":[{"m":"Aromanticism means when you don't have any romantic attraction toward anyone."}]}]},"aromantics":{"h":"aromantics","l":"aromantic","q":"noun"},"currawong":{"h":"currawong","i":"/ˈkʌrəwɒŋ/","a":"LL-Q1860 (eng)-Vealhurl-currawong.wav","s":[{"p":"noun","d":[{"m":"(countable) A currawong is a type of bird."}]}]},"muslimophobe":{"h":"Muslimophobe","i":"/ˈmuːzlɪːməˈfəʊ.b/","s":[{"p":"noun","d":[{"m":"(countable) A Muslimophobe is a person who fears or dislikes Muslims."}]}]},"islamophobe":{"h":"Islamophobe","i":"/ɪsˈlɑːməˈfəʊ.b/","s":[{"p":"noun","d":[{"m":"(countable) An Islamophobe is a person who fears or dislikes Muslims."}]}]},"platonic":{"h":"platonic","i":"/pləˈtɒnɪk/","a":"LL-Q1860 (eng)-Vealhurl-platonic.wav","s":[{"p":"adjective","d":[{"m":"Platonic means close, intimate and affectionate, but not romantic.","e":"Me and Jessica are really close, but our relationship is just platonic. We're just really good friends."}]}]},"bearcat":{"h":"bearcat","s":[{"p":"noun","d":[{"m":"a bearcat is also known as a binturong"}]}]},"bearcats":{"h":"bearcats","l":"bearcat","q":"noun"},"muskrat":{"h":"muskrat","i":"/ˈmʌskræt/","s":[{"p":"noun","d":[{"m":"A muskrat is type of rodent."}]}]},"muskrats":{"h":"muskrats","l":"muskrat","q":"noun"},"crust":{"h":"crust","i":"/krʌst/","a":"LL-Q1860 (eng)-Vealhurl-crust.wav","s":[{"p":"noun","d":[{"m":"(countable) A crust is something that is found around the side of a pastry."}]},{"p":"verb","d":[{"m":"(transitive) If you crust something, you cover it with a [[#Noun|crust]]."}]}]},"knoxville":{"h":"Knoxville","i":"/nɒksˌvɪl/","s":[{"p":"proper noun","d":[{"m":"Knoxville is a town in United States of America. It is located in Tennessee state."}]}]},"hemp":{"h":"hemp","i":"/hɛmp/","a":"LL-Q1860 (eng)-Vealhurl-hemp.wav","s":[{"p":"noun","d":[{"m":"Hemp is a herb that cannabis is produced from."}]}]},"muskox":{"h":"muskox","s":[{"p":"noun","d":[{"m":"Muskox is a type of ox."}]}]},"negligible":{"h":"negligible","i":"/ˈnɛɡlɪdʒɪbəl/","a":"LL-Q1860 (eng)-Vealhurl-negligible.wav","s":[{"p":"adjective","d":[{"m":"If something is negligible, it is small or unimportant enough that it can be ignored.","e":"He is a bit taller than I am, but the height difference is negligible."}]}]},"composition":{"h":"composition","i":"/ˌkɒmpəˈzɪʃən/","a":"en-us-composition.ogg","s":[{"p":"noun","d":[{"m":"The parts that make up something."},{"m":"A song, especially a sophisticated one."}]}]},"inimical":{"h":"inimical","i":"/ɪˈnɪmɪkəl/","a":"en-us-inimical.ogg","s":[{"p":"adjective","d":[{"m":"If something is inimical, it works against something else; it is harmful","e":"Greasy foods are inimical to a healthy diet."}]}]},"misnomer":{"h":"misnomer","i":"/mɪsˈnəʊmə/","a":"en-us-misnomer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A misnomer is a noun which is a mistaken use of the term.","e":"GV stars are known as yellow dwarf stars. This is a misnomer, because they are actually white."}]}]},"funkiest":{"h":"funkiest","l":"funky","q":"adjective"},"incel":{"h":"incel","i":"/ˈɪnsɛl/","a":"LL-Q1860 (eng)-Vealhurl-incel.wav","s":[{"p":"noun","d":[{"m":"(countable) An incel is a person who wants to have sex or a romantic relationship but is unable to.","e":"Both male and female incels are usually lonely."}]}]},"concur":{"h":"concur","i":"/kənˈkɝ/","a":"LL-Q1860 (eng)-Mélange a trois-concur.wav","s":[{"p":"verb","d":[{"m":"If you concur with something, you agree with it.","e":"Do you concur with the details of the business plan?"}]}]},"xanthophyll":{"h":"xanthophyll","s":[{"p":"noun","d":[{"m":"Xantophylls are the typical yellow pigments of leaves."}]}]},"multinational":{"h":"multinational","s":[{"p":"adjective","d":[{"m":"If something is multinational, it affects many nations."}]}]},"allusion":{"h":"allusion","s":[{"p":"noun","d":[{"m":"An indirect reference; a hint; a reference to something which is not explicitly mentioned. Its meaning is understood by the reader or the audience."}]}]},"allusions":{"h":"allusions","l":"allusion","q":"noun"},"lite":{"h":"lite","i":"/laɪt/","a":"LL-Q1860 (eng)-Vealhurl-lite.wav","s":[{"p":"adjective","d":[{"m":"A lite version of software does not have all the functions of the full version."}]}]},"demo":{"h":"demo","i":"/ˈdɛm.əʊ/","a":"LL-Q1860 (eng)-Vealhurl-demo.wav","s":[{"p":"adjective","d":[{"m":"A demo version of software can be used for free for a limited time.","e":"I'm using a demo version of Minecraft."}]}]},"permeability":{"h":"permeability","s":[{"p":"noun","d":[{"m":"The permeability of a material is how easily gas or liquid can go through it.","e":"The low permeability of the limestone walls keeps the room dry."}]}]},"homoromantic":{"h":"homoromantic","a":"LL-Q1860 (eng)-NaomiAmethyst-homoromantic.wav","s":[{"p":"adjective","d":[{"m":"Homoromantic means when you are romantically attracted to a person of the same gender."}]},{"p":"noun","d":[{"m":"(countable) A homoromantic is a person who is romantically attracted to another person of the same gender."}]}]},"biromantic":{"h":"biromantic","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-biromantic.wav","s":[{"p":"adjective","d":[{"m":"Biromantic means when you are romantically attracted to a person of both genders."}]},{"p":"noun","d":[{"m":"(countable) A biromantic is a person who is romantically attracted to anybody of both genders."}]}]},"heteroromantic":{"h":"heteroromantic","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-heteroromantic.wav","s":[{"p":"adjective","d":[{"m":"Heteroromantic means when you are romantically attracted to a person of the opposite gender."}]}]},"adjunct":{"h":"adjunct","i":"/ˈæˌdʒəŋkt/","a":"en-us-adjunct.ogg","s":[{"p":"noun","d":[{"m":"An adjunct is something less important that is joined with something else.","e":"For her, beauty was an undoubted adjunct to her ability to move from one opportunity of employment up to another."},{"m":"(countable) An adjunct is a professor who is not in a tenure-track position.","e":"Nationwide, salaries for full-time faculty held up well, but major shifts were underway replacing regular tenure-track faculty with adjuncts or other cost-saving devices (bigger classes, more teaching hours, using technology to reach more people)."},{"m":"An adjunct is a modifier or supplement.","e":"In the sentence he arrived last week, last week functions as an adjunct."}]},{"p":"adjective","d":[{"m":"archaic: attendant upon","e":"Though that my death were adjunct to my act, By heaven, I would do it. (Shakespeare: King John III, Act 3, Line 57)"}]}]},"patsy":{"h":"patsy","s":[{"p":"noun","d":[{"m":"(countable) A patsy is a scapegoat, or someone who is blamed for something someone else actually did.","e":"Lee said he did not do anything wrong. He said that he was a patsy."}]}]},"patsies":{"h":"patsies","l":"patsy","q":"noun"},"sober":{"h":"sober","s":[{"p":"adjective","d":[{"m":"A person is called sober if they are not under the influence of alcohol, and if they have not taken any other drugs."},{"m":"in a medical context, they are called sober if they have not eaten or drunk anything for some time."}]}]},"mendacity":{"h":"mendacity","i":"/mɛnˈdæsəti/","a":"LL-Q1860 (eng)-Vealhurl-mendacity.wav","s":[{"p":"noun","d":[{"m":"Mendacity is not telling the truth.","e":"People have come to expect the mendacity of politicians."}]}]},"anthropology":{"h":"anthropology","i":"/ˌænθrəˈpɒlədʒi/","a":"en-us-anthropology.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Anthropology is the study of humans and humanity as a whole.","e":"In anthropology class, you can learn about the history of human beings."}]}]},"stimulus":{"h":"stimulus","i":"/ˈstɪm.jə.ləs/","a":"LL-Q1860 (eng)-Vealhurl-stimulus.wav","s":[{"p":"noun","d":[{"m":"A stimulus is an event that causes a system to change its output or behavior.","e":"The primary goal of the $31 billion economic stimulus package was to increase job growth."},{"m":"A stimulus is something that is noticed by the senses.","e":"The mice responded with fear to the painful stimulus."}]}]},"federation":{"h":"federation","s":[{"p":"noun","d":[{"m":"A federation is a country formed by separate states that have given certain powers to a central government while keeping control over local matters."},{"m":"A federation is an organization that is made by loosely joining together smaller organizations."},{"m":"Federation is the act of joining together separate organizations or states."}]}]},"ameliorate":{"h":"ameliorate","i":"/əˈmiːli.əreɪt/","a":"en-us-ameliorate.ogg","s":[{"p":"verb","d":[{"m":"When you ameliorate something, you make it better.","e":"The doctor said this medicine would ameliorate my headache."}]}]},"supreme":{"h":"supreme","i":"/ˌs(j)uːˈpriːm/","a":"en-us-supreme.ogg","s":[{"p":"adjective","d":[{"m":"If something is supreme, it is more powerful and important than anything else.","e":"The Constitution is the supreme law in the country. Everyone, even the President, has to obey the Constitution."},{"m":"If someone is supreme, they are more powerful than anyone else.","e":"The cat is the supreme leader in that house. She does whatever she wants and is the queen of the house."},{"m":"If something or someone is supreme, they are much better than normal.","e":"She got an award for her supreme courage during the battle."}]}]},"posterity":{"h":"posterity","i":"/pɒˈstɛrɪti/","a":"en-us-posterity.ogg","s":[{"p":"noun","d":[{"m":"Posterity means people in the future.","e":"The baseball player is remembered by posterity as one of the best players who ever lived."},{"m":"Posterity means all the people who are descendants of one person (that person's children, grandchildren, great-grandchildren, great-great-grandchildren, etc.)","e":"The people wanted a better government so they could have freedom for themselves and their posterity."}]}]},"cheery":{"h":"cheery","i":"/ˈtʃɪəri/","a":"en-us-cheery.ogg","s":[{"p":"adjective","d":[{"m":"If you are cheery, you are happy and in a good mood.","e":"The family felt cheery on Christmas morning."},{"m":"If something is cheery, it makes people feel happy.","e":"They put cheery pictures on the walls."},{"m":"If something is cheery, it shows that someone is happy.","e":"\"Good morning,\" she said in a cheery voice."}]}]},"self-evident":{"h":"self-evident","a":"en-us-self-evident.ogg","s":[{"p":"adjective","d":[{"m":"If something is self-evident, it is clearly, obviously true. People do not need any proof to know that it is true.","e":"He said he wasn't rich, but his wealth became self-evident when he offered to let me ride in his private airplane."}]}]},"deem":{"h":"deem","i":"/diːm/","a":"en-au-deem.ogg","s":[{"p":"verb","d":[{"m":"If you deem something safe, necessary, important, etc., you judge it to be that way.","e":"Pierre's boss looked at the report he wrote and deemed it useless."}]}]},"depose":{"h":"depose","i":"/dɪˈpəʊz/","a":"en-us-depose.ogg","s":[{"p":"verb","d":[{"m":"If you depose a leader or rule, you remove them from service.","e":"The old president was deposed last month."}]}]},"eugenics":{"h":"eugenics","i":"/juːˈdʒɛnɪks/","s":[{"p":"noun","d":[{"m":"(uncountable) Eugenics is a type of science or a way of thinking. It says that the human race can get better if we control who is allowed to become parents.","e":"The teacher asked her students what they thought about eugenics, and who should be allowed to have children."}]}]},"psychiatry":{"h":"psychiatry","i":"/saɪˈkaɪ.əˌtri/","a":"LL-Q1860 (eng)-Vealhurl-psychiatry.wav","s":[{"p":"noun","d":[{"m":"Psychiatry is a type of science. It studies mental illnesses, like depression and anxiety.","e":"By studying psychiatry, scientists have found new medicines that help people with depression."},{"m":"Psychiatry is a special type of medicine (health care) that treats people with mental illnesses.","e":"The doctor at the hospital decided to call the department of psychiatry for her patient. She thought psychiatry could help him with his depression."}]}]},"viable":{"h":"viable","i":"/ˈvaɪəbəl/","a":"LL-Q1860 (eng)-Vealhurl-viable.wav","s":[{"p":"adjective","d":[{"m":"When something is viable, it can be done or used.","e":"Jamie came up with a viable plan for getting all of her work done before her vacation."},{"m":"When something is viable, it can work out well. It can be successful.","e":"The two countries were determined to work out a viable peace deal to stop the war."},{"m":"When something or someone is viable, it can live or survive on its own.","e":"Usually, if a woman has been pregnant for less than 22 weeks, her fetus will not be viable if she gives birth. The fetus would not be able to survive on its own, outside the mother's body."}]}]},"bacteriology":{"h":"bacteriology","i":"/bækˌtɪər.ɪˈɒlədʒi/","a":"LL-Q1860 (eng)-Vealhurl-bacteriology.wav","s":[{"p":"noun","d":[{"m":"Bacteriology is a type of science. It studies bacteria, and how they affect humans, animals, and plants.","e":"Studying bacteriology helps scientists find out what bacteria causes some diseases. Then they were able to create vaccines for some of those diseases."}]}]},"hormone":{"h":"hormone","i":"/ˈhɔːməʊn/","a":"en-us-hormone.ogg","s":[{"p":"noun","d":[{"m":"A hormone is a chemical in the human body that causes changes in the body or the brain.","e":"When we get upset, our brains send out stress hormones. Sometimes these only make us more stressed."},{"m":"Sex hormones help children develop into adults after puberty.","e":"My 16-year-old nephew has raging hormones! All he can think about is girls!"}]}]},"deleterious":{"h":"deleterious","i":"/ˌdɛlɪˈtɪəri.əs/","a":"en-us-deleterious.ogg","s":[{"p":"adjective","d":[{"m":"When something is deleterious, it is harmful; it hurts something; it causes damage.","e":"She thought quitting school would be a good idea, but it had a deleterious effect on her future."}]}]},"anatomy":{"h":"anatomy","i":"/əˈnætəmi/","a":"en-us-anatomy.ogg","s":[{"p":"noun","d":[{"m":"Anatomy is a type of science. It the parts that make up living things, including plants, animals, and humans.","e":"He studied for his anatomy test all night, but still couldn't remember the names of the bones in the body, or where all the organs are."},{"m":"Anatomy is the inside of something. It is something that you have divided up or looked at in very little parts so you can study it, even its smallest details.","e":"After the President was fired, the reporter spent a year working on a book called \"The Anatomy of a.\" She wanted to make sure she included every detail."}]}]},"visitation":{"h":"visitation","i":"/vɪzɪˈteɪʃ(ə)n/","s":[{"p":"noun","d":[{"m":": Sometimes, parents have children who do not live with them. A judge may give a parent visitation with their children. This allows the parent to see their children on a certain day and time.","e":"After the divorce, Bobby's mother was only allowed visitation with him on Sundays."},{"m":"Visitation means to visit or go see someone.","e":"I am going to see my father in prison during visitation hours on Saturday."},{"m":"In some cultures, after a person dies, people are invited to a visitation so they can see the body before it is buried. (Also called: calling hours; viewing hours; wake)","e":"After their father died, the family held visitation hours so his friends and family could come say goodbye."}]}]},"flip":{"h":"flip","i":"/flɪp/","a":"en-us-flip.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you flip something, you turn it over, or you move it suddenly.","e":"If you flip that light switch, it will be a lot brighter in here."},{"m":"(intransitive) When something flips, it turns over, usually quickly.","e":"Her car flipped over in the accident, but she wasn't hurt badly."},{"m":"When you flip, you get very upset or angry.","e":"He said, \"If I don't pass this math test, I am going to flip.\""}]},{"p":"noun","d":[{"m":"(countable) A flip is a quick movement.","e":"With a quick flip of her wrist, she threw me the ball."},{"m":"(countable) When you do a flip, you jump up into the air and turn your body.","e":"She did a flip into the water and landed on her back."}]},{"p":"adjective","d":[{"m":"If a person is flip, they act like they are not serious.","e":"His mother asked him, \"Could you be any more flip about failing the math test? You act like you don't care about school at all.\""}]}]},"verge":{"h":"verge","i":"/vɜːd͡ʒ/","a":"en-us-verge.ogg","s":[{"p":"noun","d":[{"m":"The verge of something its edge.","e":"Ahmed was riding his bicycle on the verge of the road when a car almost hit him."},{"m":"If something is \"on the verge\" of happening, it is very close to starting. (This expression is often used when something bad or dangerous is about to happen.)","e":"The country is on the verge of being destroyed by crazy politicians."}]},{"p":"verb","d":[{"m":"(intransitive) When a thing verges on something else, the two things are on the edge of being the same.","e":"The judge told the teenager, \"Your behavior verged on a serious crime, but I will give you one more chance because I think you really just acted like a stupid teenager.\""}]}]},"protein":{"h":"protein","i":"/ˈprəʊti.ɪn/","a":"en-us-protein.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Protein is a natural substances in food such as meat, milk, and beans.","e":"Dr. Lecter told me that if I ate more protein, it would help me get bigger and stronger."},{"m":"(countable) A protein is a molecule that all cells need to live. s, animals, and humans all need proteins. Proteins are made of many of the most important things we need to live.","e":"When a person's body makes proteins that are the wrong shape, it can cause problems like Alzheimer's Disease."}]}]},"psychiatries":{"h":"psychiatries","l":"psychiatry","q":"noun"},"leer":{"h":"leer","i":"/lɪə/","a":"en-uk-leer.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) When you leer at someone, you look at them in a rude, sometimes threatening way. The word leer usually describes men looking at women in a sexual way that is not respectful.","e":"She stopped using the public pool because of the way people leered at her when she was in her swimsuit."}]},{"p":"noun","d":[{"m":"A leer is a rude, threatening, sometimes sexual stare.","e":"He had a terrifying leer that made me afraid about what he might do."}]}]},"grate":{"h":"grate","i":"/ɡreɪt/","a":"en-us-grate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you grate something, you turn it into little pieces by rubbing it against something sharp or rough.","e":"He grated an entire block of cheese for the nachos."},{"m":"(transitive) When you grate something, you rub it against something in a way that makes a loud, annoying noise.","e":"During the math test, the student grated his pencil against the side of his desk so loudly that the teacher threatened to throw the pencil out the window."},{"m":"(transitive) When a person grates, they say something in a loud, often annoying voice.","e":"\"Silence during tests!\" the teacher grated in a voice that was almost as loud as the pencil."},{"m":"(intransitive) When someone or someone grates on you, it makes you annoyed. It is hard to deal with or listen to.","e":"She means well, but she has a loud, high, perky voice that just grates on me."}]},{"p":"noun","d":[{"m":"(countable) A grate is a metal cover with bars on it. It may cover things like fireplaces or sewers.","e":"The construction workers covered the hole in the road with a grate so nobody would fall down the hole."}]}]},"heap":{"h":"heap","i":"/hiːp/","a":"en-us-heap.ogg","s":[{"p":"noun","d":[{"m":"(countable) A heap is a big pile of things, usually thrown in the pile and not in any order.","e":"When we moved into our new house, the old owners had left a heap of garbage inside for us to deal with."},{"m":"A heap is a lot of something.","e":"If that dog eats my shoes again, he will be in a heap of trouble."}]},{"p":"verb","d":[{"m":"(transitive) If you heap something, you pile it up high.","e":"is my favorite dessert. I heaped it so high on my plate that it looked like a little mountain."},{"m":"(transitive) If you heap something, you give a lot of it.","e":"The police heaped the children with praise after they would not get in a car with someone they did not know."}]}]},"leers":{"h":"leers","l":"leer","q":"verb"},"leered":{"h":"leered","l":"leer","q":"verb"},"leering":{"h":"leering","l":"leer","q":"verb"},"grates":{"h":"grates","l":"grate","q":"verb"},"grated":{"h":"grated","l":"grate","q":"verb"},"grating":{"h":"grating","l":"grate","q":"verb"},"heaps":{"h":"heaps","l":"heap","q":"noun"},"heaped":{"h":"heaped","l":"heap","q":"verb"},"heaping":{"h":"heaping","l":"heap","q":"verb"},"expedite":{"h":"expedite","i":"/ˈɛk.spəˌdaɪt/","a":"en-us-expedite.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you expedite something, you make it happen faster.","e":"We ran out of supplies at the free health clinic very quickly. The Director promised to expedite the process of getting us more supplies, but a week later we still had none."}]}]},"outweigh":{"h":"outweigh","i":"/ˌaʊtˈweɪ/","a":"LL-Q1860 (eng)-Vealhurl-outweigh.wav","s":[{"p":"verb","d":[{"m":"(transitive) If something outweighs another thing, the first is more important than the second.","e":"On my first day at my new job, my boss told me: \"Your safety outweighs everything else. If there is ever a safety problem you need to tell me right away no matter what.\""},{"m":"(transitive) If you outweigh someone, it means you are heavier than they are; you weigh more than they do.","e":"Jean always exercised and ate healthy foods, but she still outweighed her friends by 20 pounds."}]}]},"char":{"h":"char","i":"/tʃɑr/","s":[{"p":"verb","d":[{"m":"(transitive) When you char something, you burn it, usually until it is black.","e":"Joseph forgot that the steak was cooking. By the time he remembered, it was charred so badly it looked like a black brick and tasted like ashes."}]},{"p":"noun","d":[{"m":"Char is something that has been charred.","e":"After the fire, all the char on the walls was so thick you could scrape it off."},{"m":"A char is a cleaning woman.","e":"The family was so poor that she had her first job as a char when she was 13."}]}]},"chars":{"h":"chars","l":"char","q":"verb"},"charred":{"h":"charred","l":"char","q":"verb"},"charring":{"h":"charring","l":"char","q":"verb"},"expectation":{"h":"expectation","i":"/ɛkspɛkˈteɪʃən/","a":"en-us-expectation.ogg","s":[{"p":"noun","d":[{"m":"(countable) An expectation is something you think is going to happen (something you expect to happen).","e":"Zeke's mother had every expectation that he would go to university after high school. So she was surprised when he told her he was joining the military instead."},{"m":"(countable) An expectation is something that a person is supposed to do, has to do, or needs to do.","e":"After Latasha forgot to pay her Internet bill, the Internet company told her: \"Our expectation is that you will pay on time in the future.\""},{"m":"(uncountable) If you do something in expectation, you do it while waiting for something to happen (you are expecting something).","e":"Before they were married, Bill would wait by the telephone for hours every night in expectation of Monica's next call."}]}]},"hypothermia":{"h":"hypothermia","i":"/ˌhaɪpəʊˈθɜː(r)mi.ə/","a":"LL-Q1860 (eng)-Vealhurl-hypothermia.wav","s":[{"p":"noun","d":[{"m":"Hypothermia is a medical problem. You get hypothermia by getting too cold. Your bodytemperature gets too low. When your body gets cold enough, it cannot work the way it normally does.","e":"The children got lost in the woods overnight. It was cold and rainy. By the time the rescue team found them in the morning, they both had hypothermia."}]}]},"nomenclature":{"h":"nomenclature","i":"/nəʊˈmɛn.klətʃə/","a":"LL-Q1860 (eng)-Vininn126-nomenclature.wav","s":[{"p":"noun","d":[{"m":"Nomenclature is a system for naming things and putting things into categories. It is used in science, especially biology.","e":"My science teacher asked me: \"How is your Felis catus today?\" I had no idea she was using scientific nomenclature to ask me how my cat is."}]}]},"poignant":{"h":"poignant","i":"/ˈpɔɪn.jənt/","a":"en-us-poignant.ogg","s":[{"p":"adjective","d":[{"m":"If something is poignant, it gives you sadness and regret.","e":"Our walk through the graveyard was a poignant reminder of life's shortness."},{"m":"If something says something poignant, it is sharp, surprising, and accurate.","e":"His poignant remark ended the argument."}]}]},"jointly":{"h":"jointly","s":[{"p":"adverb","d":[{"m":"When two or more people do something jointly, they do it together; they cooperate on it.","e":"The President told his staff that he liked to make decisions jointly. He liked to get everybody's opinion and decide as a group what was best, instead of just making decisions on his own."},{"m":"When two things cause something jointly, both things caused it to happen.","e":"The police decided that both drivers caused the car accident jointly, because they were both driving too fast and talking on their cell phones."}]}]},"jawbreaker":{"h":"jawbreaker","s":[{"p":"noun","d":[{"m":"(countable) A jawbreaker is a type of hard candy."}]}]},"candlestick":{"h":"candlestick","s":[{"p":"noun","d":[{"m":"an object that holds a candle"}]}]},"dungeon":{"h":"dungeon","i":"/ˈdʌn.d͡ʒən/","a":"LL-Q1860 (eng)-Vealhurl-dungeon.wav","s":[{"p":"noun","d":[{"m":"(countable) A dark place where people are locked up"}]}]},"frostbite":{"h":"frostbite","s":[{"p":"noun","d":[{"m":"a sore due to extreme cold"}]}]},"handball":{"h":"handball","s":[{"p":"noun","d":[{"m":"a game played with a ball"}]}]},"crete":{"h":"Crete","s":[{"p":"proper noun","d":[{"m":"Crete is one of the Greek islands."}]}]},"scotch":{"h":"scotch","s":[{"p":"noun","d":[{"m":"Scotch is an alcoholic beverage."}]}]},"renege":{"h":"renege","i":"/rɪˈn(e)ɪɡ/","a":"en-us-renege.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you renege on a promise, you do not do what you said you would do. You break your promise.","e":"My friend promised to help me study after school, but then she reneged because she wanted to go to a party instead."}]}]},"waive":{"h":"waive","i":"/weɪv/","a":"LL-Q1860 (eng)-Vealhurl-waive.wav","s":[{"p":"verb","d":[{"m":"(transitive) When you waive one of your rights, you decide not to use it; you choose to give it up.","e":"Because A'isha knew she had done nothing wrong, she decided to waive her right to have a lawyer with her and just tell the policeman what happened."},{"m":"(transitive) If somebody waives something for you, you do not have to do something that is usually required.","e":"ing to become a citizen is expensive, but if a person can prove they cannot pay, the government will waive the fees."}]}]},"macabre":{"h":"macabre","i":"/məˈkɑːbrə/","a":"en-us-macabre.ogg","s":[{"p":"adjective","d":[{"m":"Representing death."},{"m":"with death or other frightful and shocking things."},{"m":"Frightful or shocking."}]}]},"particularly":{"h":"particularly","i":"/pəˈtɪkjəlɚli/","a":"en-us-particularly.ogg","s":[{"p":"adverb","d":[{"m":"If something is particularly interesting, useful, important, etc., it is more so than usual or more than others.","e":"Tonight's dinner was particularly good."}]}]},"adversary":{"h":"adversary","i":"/ˈæd.və.s(ə)ri/","a":"en-us-adversary.ogg","s":[{"p":"noun","d":[{"m":"(countable) If a person is your adversary, they are your enemy.","e":"The history teacher said: \"Our country's biggest adversary in the first war was our best ally in the second. We went from killing each other to fighting side by side in twenty years.\""},{"m":"(countable) If a person is your adversary, you are arguing with them or competing against them; they are your opponent.","e":"My cousin loves to play computer games with me. Even though she is only six, she is a worthy adversary. She wins all the time."}]},{"p":"adjective","d":[{"m":"When a process is adversary, it involves people who want different things, and may fight or argue over them.","e":"The lawyer was used to divorces being adversary, but the Lebowskis were the worst couple he had ever worked for. They could not agree on anything, they screamed at each other all the time, and sometimes they started hitting each other."},{"m":"When a relationship is adversary, it is unfriendly or hostile.","e":"Those two countries have a very adversary relationship. Every week it seems like they are about to go to war over something."}]}]},"joyless":{"h":"joyless","s":[{"p":"adjective","d":[{"m":"When something is joyless, it is not fun, happy, enjoyable, or joyful.","e":"The company holiday party was joyless. Everyone just stood around talking about work until the boss left so they could go home."}]}]},"reconsider":{"h":"reconsider","i":"/prəˌnʌn.siˈeɪ.ʃən/","a":"LL-Q1860 (eng)-Vininn126-reconsider.wav","s":[{"p":"verb","d":[{"m":"When you reconsider something, you think it over again; you think about changing your mind.","e":"When he realized the temperature outside was below freezing, Pierre reconsidered his plan to go for a run."}]}]},"incomparable":{"h":"incomparable","i":"/ɪŋˈkɒmp(ə)rəbəl/","a":"LL-Q1860 (eng)-Vealhurl-incomparable.wav","s":[{"p":"adjective","d":[{"m":"When two things are incomparable, they are so different that they cannot even be compared; they are not the same in any way.","e":"The art teacher said: \"This painting's beauty is incomparable. No painting in the world could ever possibly be so beautiful.\""}]}]},"pro-actively":{"h":"pro-actively","s":[{"p":"adverb","d":[{"m":"When you do something pro-actively, you do it ahead of time, because that will help prevent or solve a problem.","e":"Our school started a program that pro-actively identifies students that might need extra help. This works much better than waiting for a student to have problems learning before we try to help."}]}]},"proactively":{"h":"proactively","s":[{"p":"adverb","d":[{"m":"When you do something proactively, you do it ahead of time, because that will help prevent or solve a problem.","e":"Our school started a program that proactively identifies students that might need extra help. This works much better than waiting for a student to have problems learning before we try to help."}]}]},"coke":{"h":"coke","i":"/kəʊk/","a":"en-au-coke.ogg","s":[{"p":"noun","d":[{"m":"If you burn coal, you will have coke left over, and you can use the coke for fuel."},{"m":"Coke is a nickname for a brand of soda called Coca-Cola.","e":"I don't like sugary drinks, but my sister drinks eight cans of Coke every day."},{"m":"Coke is slang for cocaine.","e":"When they searched the car, the police officers found two kilograms of cocaine. The car's owner yelled \"That's not my coke!\""}]}]},"shakespeare":{"h":"Shakespeare","i":"/ˈʃeɪkspɪr/","a":"LL-Q1860 (eng)-Vealhurl-Shakespeare.wav","s":[{"p":"noun","d":[{"m":"William Shakespeare was an English writer and poet. He lived from 1564–1616. He is one of the most famous writers in history.","e":"The teacher said: \"I think next we will read something by Shakespeare. Maybe Romeo and Juliet or Hamlet."},{"m":"Sometimes, when people say \"Shakespeare,\" they mean \"something written by William Shakespeare.\"","e":"Every year, the school's theater group performed a play. The new theater teacher told the group: \"Next year, we will be performing Shakespeare.\""}]}]},"tuppence":{"h":"tuppence","s":[{"p":"noun","d":[{"m":"(countable) Tuppence is another way of saying \"two pence.\" If you have tuppence, you have two British pennies.","e":"The candy cost one penny each. However, when the little boy said he only had tuppence, the kind store owner let him buy four pieces of candy with his two pennies."}]}]},"twopence":{"h":"twopence","s":[{"p":"noun","d":[{"m":"(countable) If you have twopence, you have two British pennies (two pence).","e":"The kind candy store owner let the little boy buy four pieces of candy for twopence."}]}]},"numerator":{"h":"numerator","i":"/ˈnuː.mər.ˌeɪ̯.tər/","a":"LL-Q1860 (eng)-Vealhurl-numerator.wav","s":[{"p":"noun","d":[{"m":"(countable) In a fraction, the numerator is the top number. It tells you how many parts there are out of a whole.","e":"In the fraction 3/4, the numerator is 3 and the denominator is 4."}]}]},"numerators":{"h":"numerators","l":"numerator","q":"noun"},"twopences":{"h":"twopences","l":"twopence","q":"noun"},"tuppences":{"h":"tuppences","l":"tuppence","q":"noun"},"cokes":{"h":"cokes","l":"coke","q":"noun"},"feckless":{"h":"feckless","i":"/ˈfɛkləs/","a":"en-us-feckless.ogg","s":[{"p":"adjective","d":[{"m":"If you are feckless, you have little purpose or motivation; you are not effective.","e":"The untrained soldiers were feckless once fighting began."}]}]},"imbue":{"h":"imbue","i":"/ɪmˈbjuː/","a":"LL-Q1860 (eng)-Vealhurl-imbue.wav","s":[{"p":"verb","d":[{"m":"If you imbue people or things with a quality, idea, or emotion, you fill them with it.","e":"In various contexts these concepts may be imbued with various meanings."}]}]},"abiogeneses":{"h":"abiogeneses","l":"abiogenesis","q":"noun"},"commandment":{"h":"commandment","i":"/kəˈmɑːndmənt/","a":"en-us-commandment.ogg","s":[{"p":"noun","d":[{"m":"(countable) A rule or law that is commanded, often by a god.","e":"The fifth commandment in the Ten Commandments is to honor your father and mother."}]}]},"commandments":{"h":"commandments","l":"commandment","q":"noun"},"tomb":{"h":"tomb","i":"/tuːm/","a":"en-us-tomb.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tomb is a large vault for burying the dead (typically made of stone)."}]}]},"tombs":{"h":"tombs","l":"tomb","q":"noun"},"cone":{"h":"cone","i":"/kəʊn/","a":"en-us-cone.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cone is a geometric shape with a circular flat base joined to a single point at the other end."},{"m":"(countable) A cone is a fruit of a conifer."},{"m":"(countable) A cone is an ice cream cone."}]}]},"cones":{"h":"cones","l":"cone","q":"noun"},"coned":{"h":"coned","l":"cone","q":"verb"},"coning":{"h":"coning","l":"cone","q":"verb"},"fully":{"h":"fully","s":[{"p":"adverb","d":[{"m":"If you fully understand or do something, you understand or do all of it.","e":"I have not yet been able to understand this idea fully."}]}]},"fore":{"h":"fore","i":"/fɔː/","a":"en-us-fore.ogg","s":[{"p":"preposition","d":[{"m":", close to, or towards the front of a vehicle or animal.","e":"You'll find the plane's exits fore and aft."}]},{"p":"noun","d":[{"m":"(uncountable) If something comes to the fore, it becomes important or people notice it more.","e":"The problem has come to the fore again in recent months."},{"m":"The fore of a ship, an aircraft, an animal, etc. is the front.","e":"The captain went to the fore to have a better look."}]}]},"igneous":{"h":"igneous","i":"/ˈɪɡ.ni.əs/","a":"LL-Q1860 (eng)-Vealhurl-igneous.wav","s":[{"p":"adjective","d":[{"m":"Igneous rock is rock that is produced by a hot volcano."}]}]},"glossy":{"h":"glossy","i":"/ˈɡlɒsi/","a":"en-us-glossy.ogg","s":[{"p":"adjective","d":[{"m":"If something is glossy, it has a smooth and/or bright surface.","e":"a glossy magazine."},{"m":"If something is glossy, it is shiny in its appearance."}]},{"p":"noun","d":[{"m":"(countable) A glossy is a magazine with a glossy cover."}]}]},"glossier":{"h":"glossier","l":"glossy","q":"adjective"},"glossiest":{"h":"glossiest","l":"glossy","q":"adjective"},"glossies":{"h":"glossies","l":"glossy","q":"noun"},"eleventh":{"h":"eleventh","i":"/ɪˈlɛv.nθ/","a":"en-us-eleventh.ogg","s":[{"p":"adjective","d":[{"m":"The eleventh thing is the one that is number eleven (11) in order."}]}]},"highly":{"h":"highly","i":"/ˈhaɪli/","a":"en-us-highly.ogg","s":[{"p":"adverb","d":[{"m":"very","e":"The two ideas are highly connected."},{"m":"If someone is highly qualified, skilled, or educated, they have a lot of skill or knowledge.","e":"The school has many highly qualified teachers."},{"m":"If someone is highly placed, they have a lot of power."},{"m":"If you think highly of someone or something, you think they're very good.","e":"He became manager because everyone thought very highly of him."}]}]},"easily":{"h":"easily","i":"/ˈiːzɪli/","a":"en-us-easily.ogg","s":[{"p":"adverb","d":[{"m":"If you do something easily, you have no trouble doing it.","e":"They won the game easily, 6–0."},{"m":"If something could easily happen, it is likely."}]}]},"despairs":{"h":"despairs","l":"despair","q":"noun"},"kazoo":{"h":"kazoo","i":"/kə.ˈzuː/","a":"en-us-kazoo.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kazoo is an American musical instrument that you hum into to make a buzzing sound."}]}]},"kazoos":{"h":"kazoos","l":"kazoo","q":"noun"},"northwestern":{"h":"northwestern","s":[{"p":"adjective","d":[{"m":"If somebody or something is northwestern, they are between north and west."}]}]},"northwesternmost":{"h":"northwesternmost","l":"northwestern","q":"adjective"},"possibility":{"h":"possibility","i":"/ˌpɑsɪˈbɪliti/","a":"en-us-possibility.ogg","s":[{"p":"noun","d":[{"m":"If there is a possibility of something, it might happen or it might be true.","e":"There is a real possibility of war."},{"m":"The possibility of something is how possible it is.","e":"There is a strong possibility of rain today."}]}]},"obviously":{"h":"obviously","i":"/ˈɑ(b).vi(.)əs.li/","a":"en-us-obviously.ogg","s":[{"p":"adverb","d":[{"m":"If something is obviously true, then it is very easy to see that it is true.","e":"China is obviously much bigger than Japan."}]}]},"conceal":{"h":"conceal","i":"/kənˈsiːl/","a":"en-us-conceal.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you conceal something, you hide it from other people.","e":"The politician was charged for concealing that he had been involved with the company."}]}]},"conceals":{"h":"conceals","l":"conceal","q":"verb"},"concealed":{"h":"concealed","l":"conceal","q":"verb"},"concealing":{"h":"concealing","l":"conceal","q":"verb"},"percentage":{"h":"percentage","i":"/pəˈsɛntɪd͡ʒ/","a":"en-us-percentage.ogg","s":[{"p":"noun","d":[{"m":"A percentage of something is the amount as a fraction of 100.","e":"The second school has a much higher percentage of girls (62%)."}]}]},"clearly":{"h":"clearly","i":"/ˈklɪrli/","a":"en-us-clearly.ogg","s":[{"p":"adverb","d":[{"m":"If something is clearly true, then it is easy to see that it is true.","e":"The building is clearly visible from the air."}]}]},"simply":{"h":"simply","i":"/ˈsɪmpli/","a":"en-us-simply.ogg","s":[{"p":"adverb","d":[{"m":"You use simply to emphasize that something is true and thinking about it in different ways won't change that.","e":"We aren't buying a new car because we simply can't afford it."},{"m":"If you say something simply, you do it in a way that is easy to understand.","e":"The idea is complicated, but, simply stated, children can do more than you expect."}]}]},"gore":{"h":"gore","s":[{"p":"noun","d":[{"m":"(uncountable) gore is the dried blood from a wound."},{"m":"(uncountable) gore is the violence found in television, computer games and literature."}]}]},"gapes":{"h":"gapes","l":"gape","q":"verb"},"gaped":{"h":"gaped","l":"gape","q":"verb"},"gaping":{"h":"gaping","l":"gape","q":"verb"},"gape":{"h":"gape","i":"/ˈɡeɪp/","a":"LL-Q1860 (eng)-Vealhurl-gape.wav","s":[{"p":"verb","d":[{"m":"(intransitive) when you gape something, you open it wide."},{"m":"(intransitive) when you gape, you open your mouth as if you are surprised."}]},{"p":"noun","d":[{"m":"Gape is how wide somebody can open his/her mouth."}]}]},"midnights":{"h":"midnights","l":"midnight","q":"noun"},"frostier":{"h":"frostier","l":"frosty","q":"adjective"},"frostiest":{"h":"frostiest","l":"frosty","q":"adjective"},"cold-heartednesses":{"h":"cold-heartednesses","l":"cold-heartedness","q":"noun"},"intimate":{"h":"intimate","i":"/ˈɪn.tɪ.mət/","a":"en-us-intimate-noun-adj.ogg","s":[{"p":"adjective","d":[{"m":"If something is intimate, it is very personal."},{"m":"If two people are intimate, they are in a sexual relationship."}]},{"p":"noun","d":[{"m":"(countable) if somebody is your intimate, he/she is your very close friend."}]},{"p":"verb","d":[{"m":"When you intimate, you carefully make hints to someone else."}]}]},"intimates":{"h":"intimates","l":"intimate","q":"noun"},"intimating":{"h":"intimating","l":"intimate","q":"verb"},"objectivities":{"h":"objectivities","l":"objectivity","q":"noun"},"israelis":{"h":"Israelis","l":"israeli","q":"noun"},"israelites":{"h":"Israelites","l":"israelite","q":"noun"},"malevolent":{"h":"malevolent","i":"/məˈlɛvələnt/","a":"LL-Q1860 (eng)-Vealhurl-malevolent.wav","s":[{"p":"adjective","d":[{"m":"When someone is malevolent, their feelings, ideas, or actions are evil."}]}]},"misdemeanours":{"h":"misdemeanours","l":"misdemeanour","q":"noun"},"perishables":{"h":"perishables","l":"perishable","q":"noun"},"wedlease":{"h":"wedlease","i":"/wεdliːz/","s":[{"p":"noun","d":[{"m":"The life of two people who have a temporary marriage.","e":"The wedlease lasted only two months."}]},{"p":"verb","d":[{"m":"When two people wedlease, they get married temporarily."}]}]},"soberer":{"h":"soberer","l":"sober","q":"adjective"},"soberest":{"h":"soberest","l":"sober","q":"adjective"},"resurrections":{"h":"resurrections","l":"resurrection","q":"noun"},"dividend":{"h":"dividend","i":"/ˈdɪvɪˌdɛnd/","a":"en-us-dividend.ogg","s":[{"p":"noun","d":[{"m":"Dividend is the number that you divide by another number to get the result."}]}]},"dividends":{"h":"dividends","l":"dividend","q":"noun"},"clamp":{"h":"clamp","i":"/klæmp/","a":"en-us-clamp.ogg","s":[{"p":"noun","d":[{"m":"(countable) A clamp is a device that holds and fixes machine elements together."}]},{"p":"verb","d":[{"m":"If you clamp something, you fasten it in place or together with a clamp.","e":"Please use a vise to clamp the pieces of wood together."},{"m":"(transitive) If you clamp onto something, you hold it tightly.","e":"She had to clamp a hand over her mouth to stop herself from laughing."}]}]},"clamps":{"h":"clamps","i":"/klæmps/","l":"clamp","q":"noun"},"caw":{"h":"caw","i":"/kɔː/","a":"en-us-caw.ogg","s":[{"p":"noun","d":[{"m":"(countable) Caw is the crying sound of crow, raven or rook.","e":"The caw of the crow [[#Verb|perched]] near me was quite loud."}]},{"p":"verb","d":[{"m":"(intransitive) If a crow, a raven or a rook cry, they caw.","e":"The crow cawed as it flew overhead."}]}]},"caws":{"h":"caws","l":"caw","q":"noun"},"cawed":{"h":"cawed","l":"caw","q":"verb"},"cawing":{"h":"cawing","l":"caw","q":"verb"},"medal":{"h":"medal","i":"/ˈmɛdəl/","a":"en-uk-medal.ogg","s":[{"p":"noun","d":[{"m":"(countable) A medal is flat and usually round metal thing that you take as an award (if you did something brave).","e":"He got a medal from serving in the army."}]}]},"medals":{"h":"medals","l":"medal","q":"noun"},"gauge":{"h":"gauge","i":"/ˈɡeɪdʒ/","a":"en-us-gauge.ogg","s":[{"p":"noun","d":[{"m":"(countable) A gauge is a tool to scale and measure objects to display information."}]},{"p":"verb","d":[{"m":"(transitive) If you gauge something, you measure it with a [[#Noun|gauge]]."},{"m":"(transitive) If you gauge the weight or volume, you estimate it."}]}]},"farce":{"h":"farce","i":"/fɑrs/","a":"En-us-farce.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Farce is a style of humor that shows a very enlarged and unlikely-to-happen situation."}]}]},"lapse":{"h":"lapse","i":"/læps/","a":"LL-Q1860 (eng)-Vealhurl-lapse.wav","s":[{"p":"noun","d":[{"m":"(countable) A lapse is an error or a failure made because of a carelessness."}]},{"p":"verb","d":[{"m":"(intransitive) If you lapse, you make one or more mistakes because of a carelessness."},{"m":"(intransitive) If you lapse, you start to make your bad habits that you avoided before."}]}]},"lapses":{"h":"lapses","l":"lapse","q":"noun"},"lapsed":{"h":"lapsed","l":"lapse","q":"verb"},"lapsing":{"h":"lapsing","l":"lapse","q":"verb"},"unfortunately":{"h":"unfortunately","i":"/ʌnˈfɔːtjʊnətli/","a":"en-us-unfortunately.ogg","s":[{"p":"adverb","d":[{"m":"You use unfortunately to show that you feel something is not the way you wish it was.","e":"Unfortunately, we didn't win."}]}]},"mostly":{"h":"mostly","i":"/ˈməʊstli/","a":"en-us-mostly.ogg","s":[{"p":"adverb","d":[{"m":"If something is mostly true, empty, sunny, etc., it is close to 100% so.","e":"The cup was mostly empty."}]}]},"relatively":{"h":"relatively","i":"[ˈrɛl.ə.tʰɪv.li]","a":"en-US relatively.ogg","s":[{"p":"adverb","d":[{"m":"If something is relatively true, it is true in part.","e":"The apple was relatively small."}]}]},"possibly":{"h":"possibly","i":"/ˈpɑsəbli/","a":"en-us-possibly.ogg","s":[{"p":"adverb","d":[{"m":"You use possibly to say that something might be true.","e":"This is possibly the biggest tree in the city."}]}]},"totally":{"h":"totally","i":"/ˈtoʊt.əl.i/","a":"en-us-totally.ogg","s":[{"p":"adverb","d":[{"m":"If something is totally true, it is 100% true.","e":"The class today was totally different from yesterday's class."}]}]},"normally":{"h":"normally","i":"/ˈnɔː.mə.li/","a":"LL-Q1860 (eng)-Vealhurl-normally.wav","s":[{"p":"adverb","d":[{"m":"You use normally to show what usually happens or what you usually do.","e":"Normally, we eat lunch at 12:00."},{"m":"In a normal way.","e":"The car is working normally now."}]}]},"gel":{"h":"gel","i":"/ʤɛl/","a":"en-us-gel.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Gel is a slime-like material. It is semi-solid and is normally used in cosmetics (for example, a \"shaving gel or a \"hair gel\")"}]},{"p":"verb","d":[{"m":"(intransitive) When something gels, it becomes a gel."},{"m":"(transitive) If you gel something, you put [[#Noun|gel]] on it."}]}]},"largely":{"h":"largely","i":"/ˈlɑːd͡ʒ.li/","a":"en-us-largely.ogg","s":[{"p":"adverb","d":[{"m":"If something is largely ignored, unknown, thanks to something, etc., it is close to 100% so.","e":"The changes were largely based on her ideas."}]}]},"previously":{"h":"previously","i":"/ˈpriːvi.əsli/","a":"en-us-previously.ogg","s":[{"p":"adverb","d":[{"m":"If something was done previously, it was done before.","e":"We discovered a language that was previously unknown."}]}]},"decadent":{"h":"decadent","i":"/ˈdɛkədənt/","a":"LL-Q1860 (eng)-Vealhurl-decadent.wav","s":[{"p":"adjective","d":[{"m":"If someone is decadent, they are interested in pleasure and not what is right or wrong."},{"m":"If something is decadent, it is very nice, but not healthy or good for you.","e":"This chocoloate cake is very dacadent."}]}]},"seriously":{"h":"seriously","i":"/ˈsɪəri.əsli/","a":"en-us-seriously.ogg","s":[{"p":"adverb","d":[{"m":"You use seriously to show that you are not.","e":"Seriously, I talked to the president this morning."},{"m":"You use seriously to ask if something is true.","e":"\"I got up at 4:00 this morning.\" \"Seriously?\""},{"m":"If you take something seriously, you believe it.","e":"It's hard to take him seriously, when he's always laughing."}]}]},"genetics":{"h":"genetics","i":"/d͡ʒɛˈnɛ.tɪks/","a":"LL-Q1860 (eng)-Vealhurl-genetics.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Genetics is the study of how all characteristics of an organism are transmitted through genes."},{"m":"(countable) Your genetics is the genes you have."}]}]},"lattice":{"h":"lattice","i":"/ˈlætəs/","a":"en-uk-lattice.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lattice is a construction of wooden strips, commonly used in gardens as a fence."}]}]},"lattices":{"h":"lattices","l":"lattice","q":"noun"},"toxicology":{"h":"toxicology","i":"/ˌtɑksɪˈkɑləʤi/","a":"LL-Q1860 (eng)-Vealhurl-toxicology.wav","s":[{"p":"noun","d":[{"m":"Toxicology is the study of how poisons affect people's organisms."}]}]},"shareholder":{"h":"shareholder","i":"/ˈʃɛrˌhoʊldər/","a":"LL-Q1860 (eng)-Vealhurl-shareholder.wav","s":[{"p":"noun","d":[{"m":"(countable) Shareholder is the person who shares stocks of a company."}]}]},"shareholders":{"h":"shareholders","l":"shareholder","q":"noun"},"seriousness":{"h":"seriousness","i":"/ˈsɪriəsnəs/","a":"LL-Q1860 (eng)-Vealhurl-seriousness.wav","s":[{"p":"noun","d":[{"m":"The quality of being serious.","e":"His seriousness in his work is rather impressive."}]}]},"static":{"h":"static","i":"/ˈstætɪk/","a":"en-us-static.ogg","s":[{"p":"adjective","d":[{"m":"If something is static, it does not change."},{"m":"If something is static, it does not move."}]}]},"manipulate":{"h":"manipulate","i":"/məˈnɪpjəˌleɪt/","a":"en-us-manipulate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you manipulate something, you operate or control it, usually with your hands.","e":"Humans have the ability to manipulate words, ideas, and tools."}]}]},"manipulates":{"h":"manipulates","l":"manipulate","q":"verb"},"manipulated":{"h":"manipulated","l":"manipulate","q":"verb"},"manipulating":{"h":"manipulating","l":"manipulate","q":"verb"},"deign":{"h":"deign","i":"/deɪn/","a":"LL-Q1860 (eng)-Vealhurl-deign.wav","s":[{"p":"verb","d":[{"m":"If you deign to do something, you do something that you feel is beneath your worth or status.","e":"A master does not deign to apologize to his slave."}]}]},"deigns":{"h":"deigns","l":"deign","q":"verb"},"deigned":{"h":"deigned","l":"deign","q":"verb"},"deigning":{"h":"deigning","l":"deign","q":"verb"},"repertoire":{"h":"repertoire","s":[{"p":"noun","d":[{"m":"Your repertoire is all the music, dances, poems, etc. that you know and can perform.","e":"The class's repertoire of songs increased as the year went on."},{"m":"Your repertoire is all the things that you can do.","e":"The students' had a narrow repertoire of test taking strategies."}]}]},"matrix":{"h":"matrix","i":"/ˈmeɪtrɪks/","a":"en-us-matrix.ogg","s":[{"p":"noun","d":[{"m":"A matrix is the situation or conditions in which something else develops or forms.","e":"Within the diverse school matrix, it is likely that there are major differences."},{"m":"A matrix is a grid.","e":"Table 2 presents the correlation matrix among the groups and results."},{"m":"A matrix is a set of numbers in rows and columns."}]}]},"linear":{"h":"linear","s":[{"p":"adjective","d":[{"m":"A linear, model, system, relationship, etc. is one where a change in one part leads to a similar change in another part.","e":"There is a linear relationship between levels of self-confidence and levels of anxiety."},{"m":"A linear shape or design includes a lot of straight lines.","e":"Her art uses strong, linear designs."},{"m":"If something is linear, it is straight or flat, not curved.","e":"The ants didn't follow a direct or linear path."}]}]},"cognitive":{"h":"cognitive","i":"/ˈkɒɡnɪtɪv/","a":"en-us-cognitive.ogg","s":[{"p":"adjective","d":[{"m":"Cognitive skills, processes, or abilities are those related to thinking and knowing.","e":"Allowing children to play can improve the development of cognitive and social skills."}]}]},"linguistic":{"h":"linguistic","i":"/lɪŋˈɡwɪstɪk/","a":"en-us-linguistic.ogg","s":[{"p":"adjective","d":[{"m":"Linguistic skills are those related to language.","e":"People are travelling more to gain cultural experiences and build linguistic skills."}]}]},"environmental":{"h":"environmental","i":"/ənˌvaɪ.ɚnˈmɛn.təl/","a":"LL-Q1860 (eng)-Vealhurl-environmental.wav","s":[{"p":"adjective","d":[{"m":"Environmental protection, education, issues, etc. are all related to the natural world: land, air, water, and living things.","e":"The country needs help to deal with its environmental problems."},{"m":"Environmental factors, impact, effect, etc. all relate to the area around someone or something.","e":"The disease is caused by a combination of genetic and environmental factors."}]}]},"historical":{"h":"historical","i":"/hɪˈstɒrɪkəl/","a":"en-us-historical.ogg","s":[{"p":"adjective","d":[{"m":"Historical events, record, leaders, etc. all relate to things that happened in the distant past.","e":"We tried to look at the problem in its historical context, not just how it is today."}]}]},"delivery":{"h":"delivery","i":"/dɪˈlɪv(ə)ri/","a":"en-au-delivery.ogg","s":[{"p":"noun","d":[{"m":"(countable) A delivery is the act of moving good or mail from a source to somebody.","e":"The delivery of the letters was delayed by the weather."},{"m":"(countable) A delivery is the thing that is delivered.","e":"The delivery was damaged when it arrived."},{"m":"(uncountable) Delivery is the act of giving birth to a baby.","e":"The nurses moved her to the delivery room to wait for the baby's arrival."},{"m":"(uncountable) Your delivery is the way you give a speech.","e":"I liked what you had to say, but you really need to improve your delivery."}]}]},"farces":{"h":"farces","l":"farce","q":"noun"},"deliveries":{"h":"deliveries","l":"delivery","q":"noun"},"matrixes":{"h":"matrixes","l":"matrix","q":"noun"},"matrices":{"h":"matrices","l":"matrix","q":"noun"},"necessarily":{"h":"necessarily","i":"/ˈnɛsəs(ə)rɪli/","a":"en-us-necessarily.ogg","s":[{"p":"adverb","d":[{"m":"If something is not necessarily true, it may or may not be true.","e":"I know we don't have a car, but that's not necessarily a problem."},{"m":"If something necessarily happens or is true, it cannot be avoided or changed.","e":"Any war necessarily involves death."}]}]},"recommendation":{"h":"recommendation","i":"/ˌrɛkəmɛnˈdeɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-recommendation.wav","s":[{"p":"noun","d":[{"m":"(countable) A recommendation is something you tell people that they should do, buy, see because it is good.","e":"You should follow your doctor's recommendations."}]}]},"increasingly":{"h":"increasingly","i":"/ɪnˈkriːsɪŋli/","a":"LL-Q1860 (eng)-Vininn126-increasingly.wav","s":[{"p":"adverb","d":[{"m":"If something is increasingly happening or true, it is more and more so.","e":"Increasingly, people are driving electric cars."}]}]},"specifically":{"h":"specifically","i":"/spəˈsɪf.ɪk.li/","a":"en-us-specifically.ogg","s":[{"p":"adverb","d":[{"m":"You use specifically to focus attention on the particular or special reason that something is done.","e":"The software is designed specifically to address the needs of blind users."},{"m":"You use specifically to focus attention on something separately from other things of the same kind.","e":"We want this to be interesting to women, specifically 40-year old women living in cities."}]}]},"surely":{"h":"surely","i":"/ˈʃʊəli/","a":"en-us-surely.ogg","s":[{"p":"adverb","d":[{"m":"You use surely to suggest that you strongly hope or believe that what you say is correct.","e":"Surely, she won't be late this time."}]}]},"vigil":{"h":"vigil","i":"/ˈvɪdʒəl/","a":"LL-Q1860 (eng)-Vealhurl-vigil.wav","s":[{"p":"noun","d":[{"m":"A vigil is a time of watching, often because of a danger.","e":"His dog kept vigil outside the hospital for eight days while he was recovering from an accident."},{"m":"A vigil is a quiet demonstration in support of a cause.","e":"The protesters held a vigil outside the courthouse in which the trial was happening."}]}]},"keenly":{"h":"keenly","i":"/ˈkinli/","a":"En-us-keenly.ogg","s":[{"p":"adverb","d":[{"m":"If you feel or want something keenly, you feel or want it very much."},{"m":"If something is done keenly, it is done strongly."}]}]},"somehow":{"h":"somehow","i":"/ˈsʌmhaʊ/","a":"en-us-somehow.ogg","s":[{"p":"adverb","d":[{"m":"You use somehow to show that you do not know how something works.","e":"I somehow managed not to get wet, even with the rain."}]}]},"properly":{"h":"properly","i":"/ˈprɑ.pɚ.li/","a":"en-us-properly.ogg","s":[{"p":"adverb","d":[{"m":"If you do something properly, you do it in the right way.","e":"We need to make sure that police are properly trained."}]}]},"compatible":{"h":"compatible","i":"/kəmpætəbəl/","a":"LL-Q1860 (eng)-Vealhurl-compatible.wav","s":[{"p":"adjective","d":[{"m":"Things or people are compatible when they can work and communicate with each other without problems"}]}]},"ice-cream":{"h":"ice-cream","s":[{"p":"noun","d":[{"m":"Another word for ice cream"}]}]},"shouldn't":{"h":"shouldn't","i":"/ˈʃʊdn̩t/","a":"en-us-shouldn't.ogg","s":[{"p":"verb","d":[{"m":"(intransitive)","e":"I shouldn't leave my pencil lying on the floor."}]}]},"ain't":{"h":"ain't","i":"/eɪnt/","a":"en-us-ain't.ogg","s":[{"p":"verb","d":[{"m":"Another way of saying isn't, am not, or aren't.","e":"He ain't gonna go anywhere."},{"m":"Another way of saying haven't or hasn’t.","e":"I ain't seen him."}]}]},"bronze":{"h":"bronze","i":"/brɒnz/","a":"en-us-bronze.ogg","s":[{"p":"noun","d":[{"m":"Bronze is an alloy of copper and tin.","e":"The statues were made out of bronze."}]},{"p":"verb","d":[{"m":"(transitive) If you bronze your skin, you make it become a tan or bronze color."}]},{"p":"adjective","d":[{"m":"Something that is bronze is made of bronze.","e":"In the museum, I saw a bronze statue of a deer."},{"m":"Something that is bronze has the color of the alloy bronze.","e":"The bronze medal was given to the athlete who came 3rd place."}]}]},"cauliflower":{"h":"cauliflower","i":"/ˈkɒl.i.flaʊ.ə/","a":"en-au-cauliflower.ogg","s":[{"p":"noun","d":[{"m":"Cauliflower is a white broccoli-like vegetable","e":"I grow cauliflowers in my garden."}]}]},"broccoli":{"h":"broccoli","i":"/ˈbrɒ.kə.li/","a":"en-us-broccoli.ogg","s":[{"p":"noun","d":[{"m":"Broccoli is a green vegetable with many flower heads and a thick stalk.","e":"At dinner, I ate some beef and broccoli."}]}]},"swimmable":{"h":"swimmable","s":[{"p":"adjective","d":[{"m":"If a lake, river, pond, etc. is swimmable, you can swim in or across it.","e":"This is a swimmable river, lake."}]}]},"hacker":{"h":"hacker","s":[{"p":"noun","d":[{"m":"A hacker is a person who gains unauthorized access to parts of a computer program.","e":"A hacker had been changing my computer game without my permission."},{"m":"A hacker is a person who gains unauthorized access to a computer system.","e":"A group of hackers have been stealing passwords from the internet."}]}]},"closely":{"h":"closely","i":"/ˈkləʊsliː/","a":"en-us-closely.ogg","s":[{"p":"adverb","d":[{"m":"If something is closely related, linked, or involved it is strongly so.","e":"The birds on this island are closely related to those on the mainland."},{"m":"If you watch something closely, you watch it very carefully."},{"m":"If you work closely with somebody, you cooperate a lot in the work."},{"m":"If one thing follows another closely, they are close in space or time."}]}]},"editorial":{"h":"editorial","i":"/ˌɛdəˈtɔriəl/","a":"en-us-editorial.ogg","s":[{"p":"noun","d":[{"m":"(countable) An editorial is an article of a magazine or newspaper that shows the opinion of the editors.","e":"One of the editorials on the elections talked about the other candidate."}]}]},"grasp":{"h":"grasp","i":"/græsp/","a":"en-us-grasp.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you grasp something, you hold it tightly in a hand or hands.","e":"I had to grasp the ball because I was stressed."},{"m":"(transitive) If you grasp something, you understand it for the first time.","e":"She tried to explain it simply, but I just couldn't grasp it."}]}]},"supersede":{"h":"supersede","i":"/ˌsupərˈsid/","a":"en-us-supersede.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you supersede the first thing or a person with another, you substitute the first one for the second."}]}]},"inviolable":{"h":"inviolable","i":"/ɪnˈvaɪələbəl/","a":"LL-Q1860 (eng)-Vealhurl-inviolable.wav","s":[{"p":"adjective","d":[{"m":"An inviolable thing is that cannot be corrupted, broken, injured or defiled."}]}]},"editorials":{"h":"editorials","l":"editorial","q":"noun"},"iconic":{"h":"iconic","i":"/aɪˈkɒnɪk/","a":"LL-Q1860 (eng)-Vealhurl-iconic.wav","s":[{"p":"adjective","d":[{"m":"If something (a phenomenon or an event) has once become famous, it is iconic."}]}]},"vengeance":{"h":"vengeance","i":"/ˈvɛnʤəns/","a":"en-us-vengeance.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Vengeance is hurting someone else because they have hurt you."}]}]},"purification":{"h":"purification","i":"/ˌpjʊrəfəˈkeɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-purification.wav","s":[{"p":"noun","d":[{"m":"(uncountable) (religion) Purification is a religious ritual which removes to free a person from sin."}]}]},"purifications":{"h":"purifications","l":"purification","q":"noun"},"retaliate":{"h":"retaliate","i":"/rɪˈtæliˌeɪt/","a":"LL-Q1860 (eng)-Vealhurl-retaliate.wav","s":[{"p":"verb","d":[{"m":"(intransitive) To retaliate is to do something negative as an answer to someone who has hurt you."}]}]},"retaliation":{"h":"retaliation","i":"/riˌtæliˈeɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-retaliation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Retaliation is act of doing something negative as an answer to someone who has hurt you."}]}]},"histology":{"h":"histology","i":"/hɪsˈtɒlədʒi/","a":"en-us-histology.oga","s":[{"p":"noun","d":[{"m":"(uncountable) Histology is the study of how tissues and cells of a plant or an animal grow."}]}]},"histologies":{"h":"histologies","l":"histology","q":"noun"},"granny":{"h":"granny","i":"/ˈɡræni/","a":"LL-Q1860 (eng)-Vealhurl-granny.wav","s":[{"p":"noun","d":[{"m":"(informal) A granny is a grandmother."}]}]},"legitimate":{"h":"legitimate","i":"/lɪˈd͡ʒɪt.ɪ.mət/","a":"LL-Q1860 (eng)-Vealhurl-legitimate (adj).wav","s":[{"p":"adjective","d":[{"m":"Something that is legitimate is something that is correct or not fake by law."}]}]},"impetuous":{"h":"impetuous","i":"/imˈpɛtʃuəs/","a":"en-us-impetuous.ogg","s":[{"p":"adjective","d":[{"m":"When you are impetuous, you act quickly without thinking about your actions.","e":"Jeremiah made an impetuous decision."}]}]},"drearier":{"h":"drearier","l":"dreary","q":"adjective"},"dreariest":{"h":"dreariest","l":"dreary","q":"adjective"},"morale":{"h":"morale","i":"/məˈrɑːl/","a":"LL-Q1860 (eng)-Vealhurl-morale.wav","s":[{"p":"noun","d":[{"m":"Morale is the feelings of how an army prepared for the acts of war."}]}]},"morales":{"h":"morales","l":"morale","q":"noun"},"atrocity":{"h":"atrocity","i":"/əˈtrɑsəti/","a":"en-us-atrocity.ogg","s":[{"p":"noun","d":[{"m":"(countable) An atrocity is a very cruel, brutal, and sometimes criminal actions."}]}]},"atrocities":{"h":"atrocities","l":"atrocity","q":"noun"},"alumnus":{"h":"alumnus","i":"/ələmnəs/","a":"LL-Q1860 (eng)-Vealhurl-alumnus.wav","s":[{"p":"noun","d":[{"m":"(countable) Alumnus is a pupil or a student who has finished or is about to finish his/her school, college or university."}]}]},"alumna":{"h":"alumna","i":"/alumna/","a":"LL-Q1860 (eng)-Vealhurl-alumna.wav","s":[{"p":"noun","d":[{"m":"(countable) Alumna is a schoolgirl or a female student who has finished or is about to finish her school, college or university."}]}]},"ruffian":{"h":"ruffian","i":"/ruffian/","a":"LL-Q1860 (eng)-Vealhurl-ruffian.wav","s":[{"p":"noun","d":[{"m":"(countable) Ruffian is a person who does bad and mean things to people."}]}]},"ruffians":{"h":"ruffians","l":"ruffian","q":"noun"},"classmate":{"h":"classmate","i":"/ˈklæˌsmeɪt/","a":"LL-Q1860 (eng)-Vealhurl-classmate.wav","s":[{"p":"noun","d":[{"m":"(countable) Classmate is a person (a student) who in the same class as you (in a school).","e":"My classmate finished his assignment."}]}]},"classmates":{"h":"classmates","l":"classmate","q":"noun"},"endeavor":{"h":"endeavor","i":"/ɪnˈdɛvər/","a":"en-us-endeavor.ogg","s":[{"p":"noun","d":[{"m":"An endeavor is what you strongly and seriously want to do; your attempts and efforts."}]}]},"endeavors":{"h":"endeavors","l":"endeavor","q":"noun"},"joule":{"h":"joule","i":"/d͡ʒuːl/","a":"LL-Q1860 (eng)-Vealhurl-joule.wav","s":[{"p":"noun","d":[{"m":"A joule is a unit of energy. 1000 joules is the same as 1 kilojoule."}]}]},"alumni":{"h":"alumni","i":"/əˈlʌmnaɪ/","l":"alumnus","q":"noun"},"alumnae":{"h":"alumnae","l":"alumna","q":"noun"},"decisive":{"h":"decisive","i":"/dɪˈsaɪsɪv/","a":"LL-Q1860 (eng)-Vealhurl-decisive.wav","s":[{"p":"adjective","d":[{"m":"Having the power or quality of deciding a question or controversy; putting an end to contest or controversy; final; conclusive.","e":"A decisive battle is fatal for one side's war chances."},{"m":"If you are decisive, you are strong enough to quickly choose between things.","e":"The new mayor was a decisive leader."}]}]},"forfeit":{"h":"forfeit","i":"/ˈfɔrfɪt/","a":"en-us-forfeit.ogg","s":[{"p":"verb","d":[{"m":"If you forfeit a something you have, etc, you lose it because you broke a law or rule.","e":"By failing to feed them, they forfeited their right to their children."}]},{"p":"noun","d":[{"m":"(countable) Forfeit is the thing that you pay or lose because you broke a law or rule."}]}]},"forfeits":{"h":"forfeits","l":"forfeit","q":"noun"},"egregious":{"h":"egregious","i":"/ɪˈɡriː.dʒəs/","a":"en-us-egregious.ogg","s":[{"p":"adjective","d":[{"m":"If something is egregious, it is extremely bad.","e":"His egregious spending habits left him in great debt."}]}]},"kinesiology":{"h":"kinesiology","i":"/ˌkɪnɪˌsiˈɑləʤi/","a":"LL-Q1860 (eng)-Vealhurl-kinesiology.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Kinesiology is the medical science of how our body (or a body of an animal) moves mechanically."}]}]},"lurk":{"h":"lurk","i":"/lɜːk/","a":"LL-Q1860 (eng)-Vealhurl-lurk.wav","s":[{"p":"verb","d":[{"m":"(intransitive) To lurk is to hide in a secret place to wait and to do bad or crime things then."},{"m":"When you lurk, you read messages on forums and chats but you do not write any messages yourself."}]}]},"lurks":{"h":"lurks","l":"lurk","q":"verb"},"notorious":{"h":"notorious","i":"/noʊˈtɔriəs/","a":"en-us-notorious.ogg","s":[{"p":"adjective","d":[{"m":"If something is notorious, it is sadly or infamously known."}]}]},"straggler":{"h":"straggler","i":"/ˈstræglər/","a":"LL-Q1860 (eng)-Vealhurl-straggler.wav","s":[{"p":"noun","d":[{"m":"(countable) A straggler is a person or an animal that is behind the others in a moving group and not keeping up.","e":"They stopped for a few minutes to allow the stragglers to catch up."}]}]},"stragglers":{"h":"stragglers","l":"straggler","q":"noun"},"maternity":{"h":"maternity","i":"/məˈtɜrnɪti/","a":"LL-Q1860 (eng)-Vealhurl-maternity.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Maternity is a state of a woman before giving birth to a child (children)."},{"m":"(uncountable) Maternity is a relation between a mother and her child."},{"m":"(countable) A maternity ward is a place in a hospital where children are born."}]}]},"maternities":{"h":"maternities","l":"maternity","q":"noun"},"monocular":{"h":"monocular","i":"/mɒˈnɒkjʊlə/","a":"LL-Q1860 (eng)-Vealhurl-monocular.wav","s":[{"p":"adjective","d":[{"m":"Somebody who is monocular, has only one eye."},{"m":"A monocular eyesight is the ability to view with one eye."}]}]},"nestling":{"h":"nestling","i":"/ˈnɛstlɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-nestling (noun).wav","s":[{"p":"noun","d":[{"m":"(countable) Nestling is a baby bird which cannot leave its nest yet."}]}]},"nestlings":{"h":"nestlings","i":"/ˈnɛstlɪŋs/","l":"nestling","q":"noun"},"mow":{"h":"mow","i":"/moʊ/","a":"en-us-mow.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you mow a lawn, you cut grass or crops.","e":"I mowed my lawn yesterday."}]},{"p":"noun","d":[{"m":"(countable) Mow is a place in a barn for storing hay, straw and grain."}]}]},"mows":{"h":"mows","i":"/maʊz/","l":"mow","q":"verb"},"mowed":{"h":"mowed","i":"/moʊd/","l":"mow","q":"verb"},"mowing":{"h":"mowing","i":"/ˈmaʊɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-mowing.wav","l":"mow","q":"verb"},"sandthorn":{"h":"sandthorn","i":"/ˈsænd.θɔrn/","a":"LL-Q1860 (eng)-Vealhurl-sandthorn.wav","s":[{"p":"noun","d":[{"m":"Sandthorn is a plant that has dense branches, pale-green leaves and juicy orange. It belongs to the plant family."}]}]},"sandthorns":{"h":"sandthorns","l":"sandthorn","q":"noun"},"stout":{"h":"stout","i":"/staʊt/","a":"en-us-stout.ogg","s":[{"p":"adjective","d":[{"m":"If something is stout, it is big and strong."}]},{"p":"noun","d":[{"m":"(countable) A stout person is a fat person."},{"m":"A stout is a type of dark beer.","e":"The brewery was known for its chocolate stout."}]}]},"stouts":{"h":"stouts","l":"stout","q":"noun"},"stouter":{"h":"stouter","i":"/ˈstaʊtər/","a":"en-us-stouter.ogg","l":"stout","q":"adjective"},"stoutest":{"h":"stoutest","i":"/ˈstaʊtɪst/","a":"en-us-stoutest.ogg","l":"sto