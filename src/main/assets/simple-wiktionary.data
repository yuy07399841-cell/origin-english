e."}]}]},"extravagance":{"h":"extravagance","s":[{"p":"noun","d":[{"m":"If something has extravagance, that means that it is worth a lot."},{"m":"If a person has extravagance, that means that the person spends a lot."}]}]},"radioactivity":{"h":"radioactivity","i":"/ˌreɪdɪəʊakˈtɪvɪti/","a":"LL-Q1860 (eng)-Vealhurl-radioactivity.wav","s":[{"p":"noun","d":[{"m":"Radioactivity is the energy released from an unstable atom."}]}]},"debtor":{"h":"debtor","i":"/ˈdɛt.ə/","a":"LL-Q1860 (eng)-Vealhurl-debtor.wav","s":[{"p":"noun","d":[{"m":"(countable) A debtor is a person who owes money.","e":"If all my debtors would pay me back I would be rich."}]}]},"radioactivities":{"h":"radioactivities","l":"radioactivity","q":"noun"},"debtors":{"h":"debtors","l":"debtor","q":"noun"},"cravats":{"h":"cravats","l":"cravat","q":"noun"},"waistcoats":{"h":"waistcoats","l":"waistcoat","q":"noun"},"garments":{"h":"garments","a":"En-us-garments.ogg","l":"garment","q":"noun"},"valets":{"h":"valets","l":"valet","q":"noun"},"rifts":{"h":"rifts","l":"rift","q":"noun"},"extravagances":{"h":"extravagances","l":"extravagance","q":"noun"},"apprentice":{"h":"apprentice","i":"/əˈprɛntɪs/","a":"LL-Q1860 (eng)-Vealhurl-apprentice.wav","s":[{"p":"noun","d":[{"m":"(countable) An apprentice is one who learns from a mentor or organization."}]}]},"apprentices":{"h":"apprentices","l":"apprentice","q":"noun"},"hitman":{"h":"hitman","s":[{"p":"noun","d":[{"m":"A hitman is a person hired to kill or hurt a particular person.","e":"The businessman used a hitman to take care of people who owed him money."}]}]},"hitmen":{"h":"hitmen","l":"hitman","q":"noun"},"foresee":{"h":"foresee","i":"/fɔrˈsi/","a":"en-us-foresee.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If a person can foresee something, then that means the person knows that the object will come to take place before it actually does."}]}]},"foreseer":{"h":"foreseer","s":[{"p":"noun","d":[{"m":"(countable) A foreseer is a person who foresees something."}]}]},"fore