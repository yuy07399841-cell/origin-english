":{"h":"enucleated","l":"enucleate","q":"verb"},"enucleating":{"h":"enucleating","l":"enucleate","q":"verb"},"luminoled":{"h":"luminoled","l":"luminol","q":"verb"},"luminol":{"h":"luminol","i":"/ˈljuːmɪnɒl/","s":[{"p":"noun","d":[{"m":"Luminol is a chemical compound (C8H7N3O2) that exhibits a blue glow when it is mixed with certain such as blood."}]},{"p":"verb","d":[{"m":"(transitive) (criminology, law enforcement) If you luminol something, you test it with a [[#Noun|luminol]] agent so as to locate traces of blood."}]}]},"luminols":{"h":"luminols","l":"luminol","q":"verb"},"luminoling":{"h":"luminoling","l":"luminol","q":"verb"},"doomsday":{"h":"doomsday","i":"/ˈduːmz.deɪ/","a":"en-us-doomsday.ogg","s":[{"p":"noun","d":[{"m":"Doomsday is the last day of the world's existence due to great death and destruction."}]}]},"doomsdays":{"h":"doomsdays","l":"doomsday","q":"noun"},"enplane":{"h":"enplane","i":"/ɛnˈpleɪn/","s":[{"p":"verb","d":[{"m":"(intransitive) If a person enplanes, they board an airplane."}]}]},"enplaned":{"h":"enplaned","l":"enplane","q":"verb"},"enplanes":{"h":"enplanes","l":"enplane","q":"verb"},"enplaning":{"h":"enplaning","l":"enplane","q":"verb"},"guppy":{"h":"guppy","i":"/ˈɡʌpi/","a":"LL-Q1860 (eng)-Vealhurl-guppy.wav","s":[{"p":"noun","d":[{"m":"(countable) A guppy is a small live-bearing freshwater fish widely kept in aquariums. to tropical America, it has been introduced elsewhere to control mosquito larvae."}]}]},"guppies":{"h":"guppies","l":"guppy","q":"noun"},"hospitality":{"h":"hospitality","i":"/ˌhɒspɪˈtæləti/","a":"en-us-hospitality.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Hospitality is the friendly and helpful treatment of guests or visitors.","e":"They showed great hospitality by offering food and a place to stay."}]}]},"adrenaline":{"h":"adrenaline","i":"/əˈdrɛnəlɪn/","a":"LL-Q1860 (eng)-Vealhurl-adrenaline.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Adrenaline is a hormone in the body that speeds up the heart and gives more 