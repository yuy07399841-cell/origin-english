etitively."},{"m":"(intransitive) If you ramble, you go for a walk."}]}]},"preciousness":{"h":"preciousness","s":[{"p":"noun","d":[{"m":"Preciousness refers to the quality of being precious.","e":"has almost the same preciousness as ruby."}]}]},"planks":{"h":"planks","i":"/plæŋks/","a":"en-us-planks.ogg","l":"plank","q":"noun"},"puncture":{"h":"puncture","i":"/ˈpʌŋktʃə/","a":"en-us-puncture.ogg","s":[{"p":"noun","d":[{"m":"(countable) A puncture refers to a hole, cut or tear that is made due to something sharp.","e":"My tire has a puncture in it after I drove in the mountains."}]},{"p":"verb","d":[{"m":"When you puncture something, you are trying to make a hole using something sharp.","e":"I used a needle to puncture the balloons on the floor."}]}]},"punctures":{"h":"punctures","l":"puncture","q":"noun"},"punctured":{"h":"punctured","l":"puncture","q":"verb"},"puncturing":{"h":"puncturing","l":"puncture","q":"verb"},"outlining":{"h":"outlining","l":"outline","q":"verb"},"punter":{"h":"punter","i":"/ˈpʌn.tə(r)/","a":"en-au-punter.ogg","s":[{"p":"noun","d":[{"m":"(countable) A punter is a person who punts."},{"m":"(countable) A punter is a person who gambles or makes a risky investment."}]}]},"privatizations":{"h":"privatizations","l":"privatization","q":"noun"},"forenoons":{"h":"forenoons","l":"forenoon","q":"noun"},"rambles":{"h":"rambles","l":"ramble","q":"noun"},"rambled":{"h":"rambled","l":"ramble","q":"verb"},"rambling":{"h":"rambling","l":"ramble","q":"verb"},"reverends":{"h":"reverends","l":"reverend","q":"noun"},"enrages":{"h":"enrages","l":"enrage","q":"verb"},"enraging":{"h":"enraging","l":"enrage","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is enraging, it makes you feel very, very angry.","e":"It is hurtful and enraging to hear these racist songs on radio."}]}]},"provisional":{"h":"provisional","i":"/prəˈvɪʒənəl/","s":[{"p":"adjective","d":[{"m":"When something is provisional, it is something that is temporary and may change later.","e":"I ca