/","a":"en-us-inheritance.ogg","s":[{"p":"noun","d":[{"m":"(countable) An inheritance is something that is passed down to others upon the death of a person."}]}]},"inheritances":{"h":"inheritances","l":"inheritance","q":"noun"},"nobility":{"h":"nobility","i":"/noʊˈbɪlɪti/","a":"LL-Q1860 (eng)-Vealhurl-nobility.wav","s":[{"p":"noun","d":[{"m":"Nobility is a privileged social class, usually accompanied by a hereditary title."},{"m":"Nobility is the quality of being a good person, whom other people should respect and admire."}]}]},"nobilities":{"h":"nobilities","l":"nobility","q":"noun"},"privileged":{"h":"privileged","i":"/ˈprɪv(ɪ)lɪdʒd/","a":"en-us-privileged.ogg","s":[{"p":"adjective","d":[{"m":"If someone is privileged, they have special rights or advantages in something."}]}]},"plebeian":{"h":"plebeian","i":"/plɪˈbiːən/","a":"en-us-plebeian.ogg","s":[{"p":"noun","d":[{"m":"(countable) A plebeian is a commoner, now usually used to insult someone as a low, vulgar person."}]},{"p":"adjective","d":[{"m":"If something is plebeian, it is related to common people."}]}]},"plebeians":{"h":"plebeians","l":"plebeian","q":"noun"},"aristocrat":{"h":"aristocrat","i":"/ˈærɪstəˌkræt/","a":"LL-Q1860 (eng)-Vealhurl-aristocrat.wav","s":[{"p":"noun","d":[{"m":"(countable) An aristocrat is a person that is a member the aristocracy."}]}]},"aristocrats":{"h":"aristocrats","l":"aristocrat","q":"noun"},"grapple":{"h":"grapple","i":"/ˈɡræpəl/","a":"en-ca-grapple.oga","s":[{"p":"verb","d":[{"m":"(transitive) If you grapple, you engage in a close fight or struggle without weapons."}]},{"p":"noun","d":[{"m":"(countable) A grapple is a tool with hooks which is used to catch or hold onto something."}]}]},"grapples":{"h":"grapples","l":"grapple","q":"verb"},"grappled":{"h":"grappled","l":"grapple","q":"verb"},"grappling":{"h":"grappling","l":"grapple","q":"verb"},"blare":{"h":"blare","i":"/blɛə/","a":"en-us-blare.ogg","s":[{"p":"noun","d":[{"m":"(countable) A blare is a loud sound.","e":"I can hardly hear you over the blare of the radio."}]},{"p":"verb","d":[{"m":"(transitive) If you blare, you make or cause a loud sound.","e":"Police helicopters blared loudspeaker warnings about the armed man."}]}]},"blares":{"h":"blares","l":"blare","q":"noun"},"blared":{"h":"blared","l":"blare","q":"verb"},"blaring":{"h":"blaring","l":"blare","q":"verb"},"blockbuster":{"h":"blockbuster","i":"/ˈblɒkˌbʌs.tə(r)/","s":[{"p":"noun","d":[{"m":"(countable) A blockbuster is a high-explosive bomb used for the purposes of demolishing large areas, such as a city block."},{"m":"(countable) (informal) A blockbuster is a film or book that has exceptional and widespread popularity and achieves enormous sales."}]}]},"blockbusters":{"h":"blockbusters","l":"blockbuster","q":"noun"},"bounties":{"h":"bounties","l":"bounty","q":"noun"},"bounty":{"h":"bounty","i":"/ˈbaʊnti/","a":"en-uk-bounty.oga","s":[{"p":"noun","d":[{"m":"(countable) A bounty is a sum paid for killing or a person or animal."},{"m":"(uncountable)"},{"m":"(countable) An act of being generous."}]}]},"heirloom":{"h":"heirloom","i":"/ˈɛə.luːm/","a":"en-au-heirloom.ogg","s":[{"p":"noun","d":[{"m":"Heirloom is a valued possession that has been pass down through the generations."}]}]},"heirlooms":{"h":"heirlooms","l":"heirloom","q":"noun"},"patrimony":{"h":"patrimony","s":[{"p":"noun","d":[{"m":"Patrimony is a right or estate inherited from their father or from any male ancestor."}]}]},"patrimonies":{"h":"patrimonies","l":"patrimony","q":"noun"},"nobler":{"h":"nobler","l":"noble","q":"adjective"},"noblest":{"h":"noblest","l":"noble","q":"adjective"},"messier":{"h":"messier","l":"messy","q":"adjective"},"messiest":{"h":"messiest","l":"messy","q":"adjective"},"pricier":{"h":"pricier","l":"pricey","q":"adjective"},"priciest":{"h":"priciest","l":"pricey","q":"adjective"},"costly":{"h":"costly","i":"/ˈkɒst.li/","a":"en-us-costly.ogg","s":[{"p":"adjective","d":[{"m":"(formal) If something is costly, it costs a lot of money."}]}]},"costlier":{"h":"costlier","l":"costly","q":"adjective"},"costliest":{"h":"costliest","l":"costly","q":"adjective"},"newsreel":{"h":"newsreel","s":[{"p":"noun","d":[{"m":"(countable) A newsreel is a short film containing news or current affairs."}]}]},"newsreels":{"h":"newsreels","l":"newsreel","q":"noun"},"couscous":{"h":"couscous","i":"/ˈkʊs.kʊs/","a":"LL-Q1860 (eng)-Vealhurl-couscous.wav","s":[{"p":"noun","d":[{"m":"Couscous is a North African food made from crushed wheat."},{"m":"Couscous is a dish with this food served with a spicy soup or curry."}]}]},"couscouses":{"h":"couscouses","l":"couscous","q":"noun"},"voyeur":{"h":"voyeur","i":"/vwɑː.ˈjɜː/","a":"LL-Q1860 (eng)-Vealhurl-voyeur.wav","s":[{"p":"noun","d":[{"m":"A voyeur is a person who gains sexual pleasure from secretly watching other people, especially when such people are engaged in some sexual activity."}]}]},"voyeurs":{"h":"voyeurs","l":"voyeur","q":"noun"},"workhorse":{"h":"workhorse","a":"en-us-workhorse.ogg","s":[{"p":"noun","d":[{"m":"A workhorse is a horse that is used for work for something."},{"m":"(by extension) If a person or thing is a workhorse, they do a lot of work over a long period of time.","e":"Those old machines are not very glamorous, but even 20 years after their introduction, they are still the workhorses of the industry."}]}]},"workhorses":{"h":"workhorses","l":"workhorse","q":"noun"},"glamorous":{"h":"glamorous","i":"/ˈɡlamərəs/","a":"LL-Q1860 (eng)-Vealhurl-glamorous.wav","s":[{"p":"adjective","d":[{"m":"If something is glamorous, it is stylish."}]}]},"stylish":{"h":"stylish","i":"/ˈstaɪlɪʃ/","a":"LL-Q1860 (eng)-Vealhurl-stylish.wav","s":[{"p":"adjective","d":[{"m":"If a person is stylish, they have elegance or taste in manners or dress."}]}]},"banshee":{"h":"banshee","i":"/bænˈʃiː/","a":"en-us-banshee.ogg","s":[{"p":"noun","d":[{"m":"(Irish) (folklore) A banshee is a female spirit, usually taking the form of a woman whose mournful wailing warns of an impending death."}]}]},"banshees":{"h":"banshees","l":"banshee","q":"noun"},"impend":{"h":"impend","i":"/ɪmˈpɛnd/","a":"LL-Q1860 (eng)-Vealhurl-impend.wav","s":[{"p":"verb","d":[{"m":"(intransitive) To threaten to, or be about to, happen or occur, especially of something which takes some time such as a process or procedure rather than just a short event."}]}]},"impending":{"h":"impending","i":"/ɪmˈpɛndɪŋ/","l":"impend","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is impending, it is approaching or about to happen or expected to happen.","e":"I have no time right now because of an impending paper submission deadline."}]}]},"impends":{"h":"impends","l":"impend","q":"verb"},"impended":{"h":"impended","l":"impend","q":"verb"},"islet":{"h":"islet","i":"/ˈaɪ.lət/","a":"LL-Q1860 (eng)-Vealhurl-islet.wav","s":[{"p":"noun","d":[{"m":"(countable) A islet is a small island."}]}]},"islets":{"h":"islets","l":"islet","q":"noun"},"deadline":{"h":"deadline","i":"/ˈdɛdˌlaɪn/","a":"LL-Q1860 (eng)-Back ache-deadline.wav","s":[{"p":"noun","d":[{"m":"(countable) A deadline is a date on or before which something must be completed.","e":"I must make this deadline or my boss will fire me!"}]}]},"deadlines":{"h":"deadlines","l":"deadline","q":"noun"},"autopsy":{"h":"autopsy","i":"/ˈɔːtɒpsiː/","s":[{"p":"noun","d":[{"m":"An autopsy is a dissection performed on a cadaver to find the possible cause(s) of death."}]},{"p":"verb","d":[{"m":"(transitive) To perform an autopsy on."}]}]},"autopsies":{"h":"autopsies","l":"autopsy","q":"noun"},"autopsied":{"h":"autopsied","l":"autopsy","q":"verb"},"autopsying":{"h":"autopsying","l":"autopsy","q":"verb"},"cadaver":{"h":"cadaver","i":"/kəˈdæv.ə(r)/","a":"en-us-cadaver.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cadaver is a dead body; especially the corpse of a human to be dissected."}]}]},"cadavers":{"h":"cadavers","l":"cadaver","q":"noun"},"dissect":{"h":"dissect","i":"/dɪˈsɛkt/","a":"LL-Q1860 (eng)-Vealhurl-dissect.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you dissect something or someone, you cut it apart to study its anatomy or to perform an autopsy."}]}]},"dissects":{"h":"dissects","l":"dissect","q":"verb"},"dissected":{"h":"dissected","l":"dissect","q":"verb"},"dissecting":{"h":"dissecting","l":"dissect","q":"verb"},"dissection":{"h":"dissection","i":"/dɪˈsɛkʃən/","s":[{"p":"noun","d":[{"m":"Dissection is the act of cutting something apart."},{"m":"Dissection is a minute of detailed examination or analysis"}]}]},"dissections":{"h":"dissections","l":"dissection","q":"noun"},"circulation":{"h":"circulation","i":"/ˌsɜː(r).kjʊˈleɪ.ʃən/","a":"en-us-circulation.ogg","s":[{"p":"noun","d":[{"m":"Circulation is the act of moving in a circle."},{"m":"Circulation is the act of passing from place to place or person to person."},{"m":"If something is in circulation, it is being passed around within a system.","e":"The new bills will come into circulation next Friday."}]}]},"circulations":{"h":"circulations","l":"circulation","q":"noun"},"hotline":{"h":"hotline","i":"/ˈhɒtlʌɪn/","a":"en-us-hotline.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hotline is a telephone line that is always staffed and able to give immediate assistance.","e":"If you've got any problems with the product, call our hotline."}]}]},"hotlines":{"h":"hotlines","l":"hotline","q":"noun"},"voluptuous":{"h":"voluptuous","i":"/vəˈlʌp.tʃu.əs/","a":"LL-Q1860 (eng)-Vealhurl-voluptuous.wav","s":[{"p":"adjective","d":[{"m":"If a woman is voluptuous, she is sexually attractive.","e":"The low neckline of her bodice emphasized her plump, voluptuous figure."}]}]},"sexually":{"h":"sexually","i":"/ˈsɛkʃuːəli/","a":"LL-Q1860 (eng)-Vealhurl-sexually.wav","s":[{"p":"adverb","d":[{"m":"If something is done sexually, it is done in a way to seduce someone.","e":"She kissed him sexually."},{"m":"If something is transmitted sexually, it is transmitted by having sex.","e":"and are sexually transmitted diseases."}]}]},"derivative":{"h":"derivative","i":"/dɪˈrɪvətɪv/","a":"en-us-derivative.ogg","s":[{"p":"adjective","d":[{"m":"If something is derivative, it is obtained from something else."}]},{"p":"noun","d":[{"m":"(countable) A derivative is something which is based on another."},{"m":"(calculus) A derivative is the derived function of another function (the slope at a certain point on some curve f(x))","e":"The derivative of f:f(x) = x^2 is f':f'(x) = 2x."},{"m":"(calculus) The value of this function for a given value of its independent variable.","e":"The derivative of f(x) = x^2 at x = 3 is f'(3) = 2 * 3 = 6."}]}]},"derivatives":{"h":"derivatives","l":"derivative","q":"noun"},"calculi":{"h":"calculi","l":"calculus","q":"noun"},"calculuses":{"h":"calculuses","l":"calculus","q":"noun"},"indirect":{"h":"indirect","i":"/ˌɪndaɪˈrɛkt/","a":"LL-Q1860 (eng)-Vealhurl-indirect.wav","s":[{"p":"adjective","d":[{"m":"If something is indirect, it is not straight and does not follow the shortest possible way."}]}]},"indirectly":{"h":"indirectly","i":"/ˌɪndɪˈrɛktli/","a":"en-us-indirectly.ogg","s":[{"p":"adverb","d":[{"m":"If something is done indirectly, it is not done in the shortest possible way."}]}]},"longevity":{"h":"longevity","i":"/lɒŋˈdʒɛ.vɪ.ti/","a":"LL-Q1860 (eng)-Vealhurl-longevity.wav","s":[{"p":"noun","d":[{"m":"Longevity is the quality of being long lasting, especially of life","e":"Grandfather had incredible longevity, he lived to be 105 years old!"}]}]},"longevities":{"h":"longevities","l":"longevity","q":"noun"},"stagger":{"h":"stagger","i":"/ˈstæɡə/","a":"LL-Q1860 (eng)-Vealhurl-stagger.wav","s":[{"p":"noun","d":[{"m":"A stagger is an unsteady movement of the body in walking or standing as if one were about to fall."}]},{"p":"verb","d":[{"m":"If you stagger, you sway unsteadily.","e":"She began to stagger across the room."},{"m":"If you are staggered, you are astonished or deeply shocked.","e":"I was staggered to find it was 7pm."},{"m":"(transitive) # If you stagger something, you arrange it so that it does not occur at the same time as something else.","e":"The interviews for new cabin crews are staggered throughout the day."}]}]},"staggered":{"h":"staggered","a":"en-us-staggered.ogg","l":"stagger","q":"verb"},"staggering":{"h":"staggering","l":"stagger","q":"verb"},"staggers":{"h":"staggers","l":"stagger","q":"noun"},"cabin":{"h":"cabin","i":"/ˈkæbɪn/","a":"en-us-cabin.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cabin is a private room or compartment on a ship."},{"m":"(countable) A cabin is a small wooden shelter or house in a wild or remote area."},{"m":"(countable) The section of a passenger plane having the same class of service."}]},{"p":"verb","d":[{"m":"(transitive) If you cabin something, you place it in a cabin or other small space."}]}]},"cabins":{"h":"cabins","l":"cabin","q":"noun"},"cabined":{"h":"cabined","l":"cabin","q":"verb"},"cabining":{"h":"cabining","l":"cabin","q":"verb"},"compartment":{"h":"compartment","i":"/kəmˈpɑrtmənt/","a":"LL-Q1860 (eng)-Vealhurl-compartment.wav","s":[{"p":"noun","d":[{"m":"(countable) A compartment is a separate section or part of a structure or container."}]},{"p":"verb","d":[{"m":"(transitive) If you are compartmenting something, you are it into different parts or sections."}]}]},"compartments":{"h":"compartments","l":"compartment","q":"noun"},"compartmented":{"h":"compartmented","l":"compartment","q":"verb"},"compartmenting":{"h":"compartmenting","l":"compartment","q":"verb"},"flabbergast":{"h":"flabbergast","i":"/ˈflæbə(ˌ)ɡɑːst/","a":"en-us-flabbergast.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you are flabbergasted, you are amazed in a ludicrous manner.","e":"He was flabbergasted to find that his work had been done for him before he began."}]}]},"flabbergasts":{"h":"flabbergasts","l":"flabbergast","q":"verb"},"flabbergasted":{"h":"flabbergasted","i":"/ˈflæbəɡæstəd/","a":"en-us-flabbergasted.ogg","l":"flabbergast","q":"verb","s":[{"p":"adjective","d":[{"m":"If you feel flabbergasted, you feel appalled, annoyed or disgusted.","e":"He was f