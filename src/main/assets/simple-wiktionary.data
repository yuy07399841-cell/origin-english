:"verb","d":[{"m":"(transitive) To rouse, stir up or excite. To cause action to happen. To cause a reaction.","e":"He said his friends had incited him to break the window."}]}]},"hovel":{"h":"hovel","s":[{"p":"noun","d":[{"m":"A hovel is a small and congested house."}]}]},"safari":{"h":"safari","i":"/səˈfɑːr.i/","a":"LL-Q1860 (eng)-Vealhurl-safari.wav","s":[{"p":"noun","d":[{"m":"A safari is a trip taken to see or hunt animals. It is often in a remote location such as parts of Africa.","e":"We went on a three-month safari on the Serengeti Plain in Africa."}]}]},"independentize":{"h":"independentize","s":[{"p":"verb","d":[{"m":"If someone or something independentizes another thing, then they make it independent."}]}]},"header":{"h":"header","a":"en-us-header.ogg","s":[{"p":"noun","d":[{"m":"A header is the text at the very top of the page.","e":"I put my name and the page number in the header of my term paper."},{"m":"In football, a header is a goal scored by hitting the ball with one's head","e":"Peter Crouch's header against Chelsea made the highlight show last night."}]}]},"headers":{"h":"headers","l":"header","q":"noun"},"reacher":{"h":"reacher","s":[{"p":"noun","d":[{"m":"A reacher is a person who reaches for something."},{"m":"A reacher is an object or device used to reach something."}]}]},"independentizes":{"h":"independentizes","l":"independentize","q":"verb"},"independentizing":{"h":"independentizing","l":"independentize","q":"verb"},"reachers":{"h":"reachers","l":"reacher","q":"noun"},"safaris":{"h":"safaris","l":"safari","q":"noun"},"crossovers":{"h":"crossovers","l":"crossover","q":"noun"},"deceits":{"h":"deceits","l":"deceit","q":"noun"},"arrogates":{"h":"arrogates","l":"arrogate","q":"verb"},"arrogated":{"h":"arrogated","l":"arrogate","q":"verb"},"arrogating":{"h":"arrogating","l":"arrogate","q":"verb"},"cartoons":{"h":"cartoons","l":"cartoon","q":"noun"},"pause":{"h":"pause","i":"/pɔːz/","a":"en-us-pause.ogg","s":[{"p":"verb","d":[{"m":"To pause is to 