b","d":[{"m":"If something happens globally, it happens everywhere and in all situations."}]}]},"residential":{"h":"residential","i":"/ˌrɛzɪˈdɛnʃəl/","a":"LL-Q1860 (eng)-Vealhurl-residential.wav","s":[{"p":"adjective","d":[{"m":"A residential area is one where people live made up mostly of homes, rather than businesses or factories.","e":"This is a residential neighborhood with many houses."}]}]},"vogue":{"h":"vogue","i":"/voʊɡ/","a":"LL-Q1860 (eng)-Vealhurl-vogue.wav","s":[{"p":"noun","d":[{"m":"If something is in vogue, it is popular or fashionable for a certain time.","e":"This style of clothing was in vogue in Paris in the 1940s."}]},{"p":"verb","d":[{"m":"If you vogue, you dance in the vogue dance style."}]}]},"voguing":{"h":"voguing","l":"vogue","q":"verb"},"vogued":{"h":"vogued","l":"vogue","q":"verb"},"vogues":{"h":"vogues","l":"vogue","q":"noun"},"formality":{"h":"formality","i":"/fɔːrˈmælɪti/","a":"LL-Q1860 (eng)-AGuy271-formality.wav","s":[{"p":"noun","d":[{"m":"(countable) A formality is something done just to follow rules or customs, even though it may not be necessary.","e":"Signing the contract was just a formality."},{"m":"(uncountable) Formality is the quality of being formal or following strict rules or customs.","e":"There is a lot of formality in royal ceremonies."}]}]},"formalities":{"h":"formalities","l":"formality","q":"noun"},"colt":{"h":"colt","i":"/kəʊlt/","a":"en-us-colt.ogg","s":[{"p":"noun","d":[{"m":"(countable) A colt is a young male horse."},{"m":"(countable) A colt is a young crane (bird)."}]}]},"colts":{"h":"colts","l":"colt","q":"noun"},"chiefly":{"h":"chiefly","i":"/ˈtʃiːfli/","a":"en-us-chiefly.ogg","s":[{"p":"adverb","d":[{"m":"Mainly; for the most part.","e":"This area is chiefly used for farming."},{"m":"In the highest rank or most important position.","e":"We need a number of things, chiefly time."}]}]},"cadaverous":{"h":"cadaverous","s":[{"p":"adjective","d":[{"m":"If something is cadaverous, it is similar to a corpse"}]}]},