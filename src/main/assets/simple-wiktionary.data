ower":{"h":"wildflower","s":[{"p":"noun","d":[{"m":"A wildflower (or wild flower) is a flower that grows wild, meaning it was not planted by humans."}]}]},"wildflowers":{"h":"wildflowers","l":"wildflower","q":"noun"},"gang":{"h":"gang","i":"/ɡæŋ/","a":"LL-Q1860 (eng)-Vealhurl-gang.wav","s":[{"p":"noun","d":[{"m":"(countable) A gang is a group of criminals that work together. These criminals are often called gangsters."},{"m":"(countable) A gang is a group of people who spend time together. Often they are similar to each other and share interests."}]},{"p":"verb","d":[{"m":"If you gang up, you make a group, you band together, usually against a single person or cause."}]}]},"gangs":{"h":"gangs","l":"gang","q":"noun"},"gangster":{"h":"gangster","i":"/ˈgæŋstə/","a":"LL-Q1860 (eng)-Vealhurl-gangster.wav","s":[{"p":"noun","d":[{"m":"(countable) A gangster is a person who is part of a gang. Usually this is a criminal who does crime with the gang."}]}]},"gangsters":{"h":"gangsters","l":"gangster","q":"noun"},"gangbangers":{"h":"gangbangers","l":"gangbanger","q":"noun"},"polytheistic":{"h":"polytheistic","i":"/ˌpɒlɪθiːˈɪstɪk/","a":"LL-Q1860 (eng)-Vealhurl-polytheistic.wav","s":[{"p":"adjective","d":[{"m":"If you are polytheistic you believe in more than one god.","e":"Hinduism is a polytheistic religion."}]}]},"polytheism":{"h":"polytheism","i":"/pɒl.ɪˈθiː.ɪz.əm/","a":"LL-Q1860 (eng)-Vininn126-polytheism.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Polytheism is belief in more than one god.","e":"Islam is against religions believing in polytheism."}]}]},"polytheist":{"h":"polytheist","i":"/pɒlɪˈθiːɪst/","a":"LL-Q1860 (eng)-Vealhurl-polytheist.wav","s":[{"p":"noun","d":[{"m":"(countable) (religon) A polytheist is a person who believes in more than one god."}]}]},"polytheists":{"h":"polytheists","l":"polytheist","q":"noun"},"pantheism":{"h":"pantheism","i":"/pæn'θi'ĭz'əm","a":"LL-Q1860 (eng)-Vininn126-pantheism.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Pantheism is the belief that the universe (nature) is God. In pantheism everything is part of God."}]}]},"monotheism":{"h":"monotheism","i":"/ˌmɑnoʊ̯ˈθiɪzm̩/","a":"en-us-monotheism.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Monotheism is the belief in only one God.","e":"Christianity, Judaism, and Islam are based on monotheism."}]}]},"horror":{"h":"horror","i":"/ˈhɔrɚ/","a":"en-us-horror.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Horror is great fear."},{"m":"(uncountable) Horror is a kind of story or movie that scares you (causes fear)."},{"m":"(countable) A horror is something that causes fear, or that is very bad. This can also mean something very ugly."}]}]},"horrors":{"h":"horrors","i":"/ˈhɒrəz/","a":"en-us-horrors.ogg","l":"horror","q":"noun"},"fingerprint":{"h":"fingerprint","i":"/ˈfɪŋɡɚˌprɪnt/","a":"en-us-fingerprint.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fingerprint is a mark left by your finger's bumps.","e":"Every fingerprint is different."}]},{"p":"verb","d":[{"m":"If you fingerprint someone, you take their fingerprints.","e":"You have to have your fingerprints taken since you did a crime."}]}]},"keyboards":{"h":"keyboards","l":"keyboard","q":"noun"},"exam":{"h":"exam","i":"/ɪɡˈzæm/","a":"en-uk-an exam.ogg","s":[{"p":"noun","d":[{"m":"(countable) An exam is a formal test, usually important and often at the end of a course.","e":"Did you pass the English exam last week?"},{"m":"(countable) An exam is a check done by a doctor to see whether you are healthy or not.","e":"I went to the doctor for an eye exam, but she said everything was fine."}]}]},"fingerprints":{"h":"fingerprints","l":"fingerprint","q":"noun"},"powers":{"h":"powers","a":"en-us-powers.ogg","l":"power","q":"noun"},"examine":{"h":"examine","i":"/ɪɡˈzæmɪn/","a":"en-us-examine.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you examine something, you look at it carefully.","e":"In the last few years the effects of strength training have been closely examined."},{"m":"(transitive) If a doctor examines you, they look at you to see if you're healthy.","e":"After examining her arm, the doctor told her that it was not broken."},{"m":"(transitive), (formal) If you examine someone, you test them."},{"m":"(transitive), If a lawyer examines you, they ask you questions in court."}]}]},"examines":{"h":"examines","l":"examine","q":"verb"},"examined":{"h":"examined","i":"/ɪɡˈzæmɪnd/","a":"en-us-examined.ogg","l":"examine","q":"verb"},"examining":{"h":"examining","i":"/ɪɡˈzæmɪnɪŋ/","a":"en-us-examining.ogg","l":"examine","q":"verb"},"ways":{"h":"ways","i":"/weɪz/","a":"en-us-ways.ogg","l":"way","q":"noun"},"anyway":{"h":"anyway","i":"/ˈɛniweɪ/","a":"en-us-anyway.ogg","s":[{"p":"adverb","d":[{"m":"You use anyway to say something does not matter, or you do not care.","e":"We were told not to go, but went anyway."},{"m":"You use anyway to add some information to something you just said.","e":"Jesse and Anne had a big fight. That's what I heard anyway."},{"m":"You use anyway to change the topic or end a conversation.","e":"Yeah, the homework's going to be hard... anyway, did you hear about the football game?"}]}]},"highway":{"h":"highway","i":"/ˈhaɪweɪ/","a":"en-us-highway.ogg","s":[{"p":"noun","d":[{"m":"(countable) A highway is a large road for cars."}]}]},"freeway":{"h":"freeway","i":"/ˈfriː.wei/","a":"en-us-freeway.ogg","s":[{"p":"noun","d":[{"m":"(US, Australia, Canada) A freeway is a large road for cars. This is a road that does not cost money to use. Freeways usually have at least two lanes in each direction and have exits, ramps or interchanges rather than intersections."}]}]},"vascular":{"h":"vascular","s":[{"p":"adjective","d":[{"m":"Part of a living thing is vascular if it has tubes to carry blood, sap or other liquid (things like water).","e":"Cartilage is not a vascular part of the body."},{"m":"Something is vascular if it's about those kinds of tubes (veins and arteries to carry blood, veins in plants to carry sap, etc.).","e":"A vascular surgeon (doctor) treats diseases of the vascular system."}]}]},"railway":{"h":"railway","i":"/reɪlweɪ/","a":"en-us-railway.ogg","s":[{"p":"noun","d":[{"m":"A railway is road for trains."},{"m":"A railway is a company that runs trains."}]}]},"driveway":{"h":"driveway","i":"/ˈdrʌɪvweɪ/","a":"LL-Q1860 (eng)-AnotherFriendlyHuman-driveway.wav","s":[{"p":"noun","d":[{"m":"(countable) A driveway is a very short road leading to a house or garage. It is where cars are often parked at home."}]}]},"halfway":{"h":"halfway","s":[{"p":"adverb","d":[{"m":"If something is halfway done, it is partly done, or partly that way.","e":"I was halfway between happy and sad."},{"m":"If you meet somebody halfway, both of you both agree by accepting part of what the other person is suggesting or offering.","e":"Look, I can't afford $100 for it, but I can meet you halfway."}]}]},"anyhow":{"h":"anyhow","i":"/ˈɛn.iː.haʊ/","a":"en-us-anyhow.ogg","s":[{"p":"adverb","d":[{"m":"You use anyhow to say something does not matter, or you do not care.","e":"We were told not to go, but went anyhow."},{"m":"You use anyhow to add some information to something you just said.","e":"Jesse and Anne had a big fight. That's what I heard anyhow."},{"m":"You use anyhow to change the topic or end a conversation.","e":"Yeah, the homework's going to be hard... Anyhow, did you hear about the football game?"},{"m":"without being careful","e":"He grabbed his clothes and stuffed them into his bag anyhow."}]}]},"toll":{"h":"toll","i":"/təʊl/","a":"LL-Q1860 (eng)-Vealhurl-toll.wav","s":[{"p":"noun","d":[{"m":"A toll is money you must pay to use a facility.","e":"A toll house was used to collect toll (payment) to travel on a road."},{"m":"A toll is a cost, or something bad that happens because of something.","e":"My illness has taken its toll, making me too sick to work."},{"m":"A toll is the sound made by a large bell.","e":"She could hear toll of the church bell."}]},{"p":"verb","d":[{"m":"To toll is to ring a large bell slowly.","e":"He climbed the tower so he could help toll the church bell."}]}]},"tolls":{"h":"tolls","l":"toll","q":"noun"},"railroads":{"h":"railroads","l":"railroad","q":"noun"},"freeways":{"h":"freeways","l":"freeway","q":"noun"},"driveways":{"h":"driveways","l":"driveway","q":"noun"},"railways":{"h":"railways","l":"railway","q":"noun"},"highways":{"h":"highways","l":"highway","q":"noun"},"hoodoo":{"h":"hoodoo","i":"/ˈhuːduː/","a":"en-us-hoodoo.oga","s":[{"p":"noun","d":[{"m":"(uncountable) Hoodoo is an old kind of African American medicine and magic."},{"m":"A unusual rock column"}]}]},"inspire":{"h":"inspire","i":"/ɪn.ˈspaɪr/","a":"LL-Q1860 (eng)-Vealhurl-inspire.wav","s":[{"p":"verb","d":[{"m":"If something inspires you, it gives you ideas, or it makes you want to create.","e":"I'm always inspired by the beauty of nature."},{"m":"If something is inspired by God (or a god), God gave you that idea. This can also mean God gave you exact words.","e":"Christians believe the Bible was inspired by God."},{"m":"When you inspire you breath in. That is, you take air into your lungs."}]}]},"inspiration":{"h":"inspiration","i":"/ˌɪnspəˈreɪʃn/","a":"en-us-inspiration.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Inspiration is being inspired.","e":"I've been filled with inspiration lately."},{"m":"(countable) An inspiration is something that inspires you. That is, something that motivates you or that gives you ideas.","e":"You are my inspiration."},{"m":"Inspiration is when you breath in."}]}]},"inspirations":{"h":"inspirations","l":"inspiration","q":"noun"},"interview":{"h":"interview","i":"/ˌɪntəˈvjuː/","a":"en-us-interview.ogg","s":[{"p":"noun","d":[{"m":"(countable) An interview is when questions are asked formally.","e":"I was given an interview to see if I was right for the job."}]},{"p":"verb","d":[{"m":"When you interview someone, you give them an interview. That is you formally ask the person questions.","e":"I was interviewing the officials for the newspaper."}]}]},"grains":{"h":"grains","a":"En-us-grains.ogg","l":"grain","q":"noun"},"jack":{"h":"jack","i":"/dʒæk/","a":"en-us-jack.ogg","s":[{"p":"noun","d":[{"m":"(countable) A jack is a machine for lifting heavy thing. Often a jack is used to lift a car for fixing."},{"m":"(countable) A jack is a plug or connector for electronics."},{"m":"(countable) A jack is a flag used at by ships at sea."},{"m":"(uncountable) Another word for nothing."},{"m":"(countable) A jack is a playing card with a J on it."}]},{"p":"verb","d":[{"m":"(transitive) To use a [[#Noun|jack]].","e":"He jacked the car up so that he could replace the brake pads."},{"m":"(transitive) To steal.","e":"Someone jacked my car last night!"}]}]},"judgment":{"h":"judgment","i":"/ˈʤʌʤmənt/","a":"en-us-judgment.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Judgment is being able to make good choices.","e":"You will need good judgment to decide on a school."},{"m":"(countable) A judgment is a choice or decision you might make."},{"m":"(countable) A judgment is the something decided by a judge. It is an official order by a court.","e":"This judgment means you have to pay me $500 each month, for a year."}]}]},"fresh":{"h":"fresh","i":"/frɛʃ/","a":"en-us-fresh.ogg","s":[{"p":"adjective","d":[{"m":"If something is fresh it is not old, it is new or like new. Often this means not spoiled or rotten.","e":"I only eat fresh food."},{"m":"If water is fresh it does not have salt in it."},{"m":"If you are being fresh you are to forward sexually; this is a way of being rude.","e":"Don't get fresh with me, I'm not that kind of girl!"}]}]},"vent":{"h":"vent","i":"/vɛnt/","a":"en-us-vent.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vent is a hole for air to go through."}]},{"p":"verb","d":[{"m":"(transitive) If you vent a place, you move old air out and let new air in."},{"m":"(intransitive) If you vent, you let your emotions out by showing them."}]}]},"freshwater":{"h":"freshwater","s":[{"p":"adjective","d":[{"m":"If you describe a plant or animal as being freshwater, you are saying that it lives in fresh water.","e":"Do you have saltwater or freshwater fish in your fishtank?\""},{"m":"If you describe a person as being freshwater, you are saying he is does not have much skill as a seaman.","e":"\"Who's that freshwater sailor?\" \"That's Hank. He just started last week.\""}]}]},"halloween":{"h":"Halloween","i":"/ˌha.ləˈwiːn/","a":"en-us-Halloween.ogg","s":[{"p":"proper noun","d":[{"m":"Halloween is a holiday in Europe and North America that is celebrated by dressing in costumes and going door-to-door asking for candy. Halloween is celebrated each year on October 31 on the eve of All Hallow's Day."}]}]},"lost":{"h":"lost","i":"/lɒst/","a":"en-ca-lost.ogg","l":"lose","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are lost you do not know where you are. You might not know how to get home.","e":"I was lost in the woods for a week."},{"m":"If something is lost you do not know where it is.","e":"My phone is lost."},{"m":"If something is lost it is gone. It might not exist any more.","e":"All my hope is lost."},{"m":"If something is lost it has failed.","e":"Trying to reach her is a lost cause."}]}]},"brave":{"h":"brave","i":"/breɪv/","a":"en-us-brave.ogg","s":[{"p":"adjective","d":[{"m":"If you are brave, fear will not stop you.","e":"You must be very brave to run into a burning house."}]},{"p":"noun","d":[{"m":"(countable) A brave is a Native American warrior."}]},{"p":"verb","d":[{"m":"If you brave something or someone, you overcome your fear of that.","e":"He braved a jump off of the diving board."}]}]},"braver":{"h":"braver","l":"brave","q":"adjective"},"bravest":{"h":"bravest","a":"en-us-bravest.ogg","l":"brave","q":"adjective"},"losing":{"h":"losing","a":"en-us-losing.ogg","l":"lose","q":"verb"},"bravery":{"h":"bravery","i":"/ˈbreɪvəri/","a":"en-us-bravery.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Bravery is actions, or feelings that show you are not afraid.","e":"He showed great bravery in going back in to the burning building to wake his sister."}]}]},"holystone":{"h":"holystone","s":[{"p":"noun","d":[{"m":"A holystone is a piece of sandstone that is used to scrub the decks of ships with either saltwater or sand."}]}]},"holystones":{"h":"holystones","l":"holystone","q":"noun"},"junipers":{"h":"junipers","l":"juniper","q":"noun"},"destructions":{"h":"destructions","l":"destruction","q":"noun"},"absorptions":{"h":"absorptions","l":"absorption","q":"noun"},"accommodations":{"h":"accommodations","l":"accommodation","q":"noun"},"acronyms":{"h":"acronyms","l":"acronym","q":"noun"},"accumulations":{"h":"accumulations","l":"accumulation","q":"noun"},"adolescents":{"h":"adolescents","l":"adolescent","q":"noun"},"administrations":{"h":"administrations","l":"administration","q":"noun"},"oppositions":{"h":"oppositions","l":"opposition","q":"noun"},"advocates":{"h":"advocates","l":"advocate","q":"noun"},"advocated":{"h":"advocated","l":"advocate","q":"verb"},"advocating":{"h":"advocating","l":"advocate","q":"verb"},"advisers":{"h":"advisers","l":"adviser","q":"noun"},"advisors":{"h":"advisors","l":"advisor","q":"noun"},"anchorages":{"h":"anchorages","l":"anchorage","q":"noun"},"anaesthetics":{"h":"anaesthetics","l":"anaesthetic","q":"noun"},"metals":{"h":"metals","l":"metal","q":"noun"},"tongues":{"h":"tongues","l":"tongue","q":"noun"},"amplitudes":{"h":"amplitudes","l":"amplitude","q":"noun"},"altitudes":{"h":"altitudes","l":"altitude","q":"noun"},"amateurs":{"h":"amateurs","l":"amateur","q":"noun"},"aggregates":{"h":"aggregates","l":"aggregate","q":"noun"},"albinos":{"h":"albinos","l":"albino","q":"noun"},"albinoes":{"h":"albinoes","l":"albino","q":"noun"},"alcohols":{"h":"alcohols","l":"alcohol","q":"noun"},"smolts":{"h":"smolts","l":"smolt","q":"noun"},"parrs":{"h":"parrs","l":"parr","q":"noun"},"alevins":{"h":"alevins","l":"alevin","q":"noun"},"allocations":{"h":"allocations","l":"allocation","q":"noun"},"alphabets":{"h":"alphabets","i":"/ˈæl.fə.bɛts/","l":"alphabet","q":"noun"},"allotropies":{"h":"allotropies","l":"allotropy","q":"noun"},"appreciations":{"h":"appreciations","l":"appreciation","q":"noun"},"ankles":{"h":"ankles","l":"ankle","q":"noun"},"fears":{"h":"fears","a":"en-us-fears.ogg","l":"fear","q":"noun"},"fingers":{"h":"fingers","i":"/ˈfɪŋɡɚz/","a":"en-us-fingers.ogg","l":"finger","q":"noun"},"fools":{"h":"fools","i":"/fuːlz/","a":"en-us-fools.ogg","l":"fool","q":"noun"},"frames":{"h":"frames","l":"frame","q":"noun"},"graphs":{"h":"graphs","l":"graph","q":"noun"},"closes":{"h":"closes","i":"/ˈkloʊzɪz/","a":"en-us-closes.ogg","l":"close","q":"verb"},"realise":{"h":"realise","i":"/ˈri.ə.laɪz/","a":"en-us-realise.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you realise something, you become aware of it.","e":"John just realised that he had left his umbrella at home."},{"m":"(transitive) If something is realised, it is made real.","e":"My dreams of starting my own company have been realised."}]}]},"genus":{"h":"genus","i":"/ˈdʒiːnəs/","a":"en-us-genus.ogg","s":[{"p":"noun","d":[{"m":"(countable) When scientists classify living things, a genus is one group. One genus usually includes a variety of species, and a number of genera are usually grouped together in one family.","e":"Sweet William belongs to the genus Dianthus."}]}]},"homo":{"h":"homo","s":[{"p":"noun","d":[{"m":"; The genus idea of humans. This means \"modern\" people (\"homo sapiens\"), \"cavemen,\" and what some people call \"ape-men.\" This word is Latin but is also a science word in English; it is an evolutionary idea.","e":"The genus homo is very confusing, I don't understand anything about it being \"cave-men\" or \"ape-men\", it was just normal people thousands of years ago, I don't understand this or evolution at all, I mean how could we have looked and been like that?."},{"m":"; Short for homosexual."}]}]},"blizzard":{"h":"blizzard","i":"/ˈblɪ.zəd/","a":"en-us-blizzard.ogg","s":[{"p":"noun","d":[{"m":"(countable) A blizzard is when a lot of snow falls with strong winds that make it hard to see very far.","e":"I'm stuck in this blizzard of snow. I'll be a little late coming home."},{"m":"(countable) A blizzard is a lot of the same thing."}]}]},"blizzards":{"h":"blizzards","l":"blizzard","q":"noun"},"homos":{"h":"homos","l":"homo","q":"noun"},"england":{"h":"England","i":"/ˈɪŋ.glənd/","a":"en-us-England.ogg","s":[{"p":"proper noun","d":[{"m":"England is a country on the island of Britain and part of the United Kingdom.","e":"English was first spoken in England."}]}]},"saltwater":{"h":"saltwater","s":[{"p":"noun","d":[{"m":"Alternative spelling of salt water."}]}]},"occult":{"h":"occult","i":"/ˈɒk.ʌlt/","a":"en-au-occult.ogg","s":[{"p":"adjective","d":[{"m":"If something is occult it is hidden or secret—or it is about hidden or secret things."}]},{"p":"verb","d":[{"m":"If you occult something, you cover it.","e":"The Earth occults the Moon when a lunar eclipse happens."}]},{"p":"noun","d":[{"m":"(uncountable) (usually has the before it) The occult is anything to do with things that are not normal; supernatural or paranormal."}]}]},"wristband":{"h":"wristband","i":"/ˈrɪs(t)ˌbænd/","s":[{"p":"noun","d":[{"m":"A wristband is a piece of cloth, plastic or metal that you wear on your wrist.","e":"The boy wore a grey wristband on his left wrist."},{"m":"the cuff of a sleeve that wraps around the wrist"},{"m":"a band that holds a wristwatch on the wrist"}]}]},"excess":{"h":"excess","i":"/əkˈsɛs/","a":"en-us-excess.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) (singular) An excess is an extent that is too much.","e":"Cut the meat off the bone and remove any excess fat."},{"m":"(uncountable) (plural) Excesses are behaviours that are not against the law, but are still not accepted by society.","e":"After the excesses of her teens, she stopped smoking, drinking, and partying completely."},{"m":"If x is in excess of y, it is more than y.","e":"The car was traveling in excess of 150 km/h."}]}]},"excite":{"h":"excite","i":"/ɪkˈsaɪt/","a":"en-us-excite.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If something excites you, it makes you feel interested, happy, and awake.","e":"A good DJ can excite the crowd and make people dance."},{"m":"(transitive) If something excites someone, it makes them think about sex."},{"m":"(transitive) If something excites a nerve or a part of an animal or plant, it makes it more active."}]}]},"packages":{"h":"packages","l":"package","q":"noun"},"dragonflies":{"h":"dragonflies","l":"dragonfly","q":"noun"},"debts":{"h":"debts","l":"debt","q":"noun"},"females":{"h":"females","i":"/ˈfiː.meɪlz/","a":"en-us-females.ogg","l":"female","q":"noun"},"tobaccos":{"h":"tobaccos","l":"tobacco","q":"noun"},"internationals":{"h":"internationals","l":"international","q":"noun"},"engines":{"h":"engines","l":"engine","q":"noun"},"plastics":{"h":"plastics","l":"plastic","q":"noun"},"tots":{"h":"tots","l":"tot","q":"noun"},"refuse":{"h":"refuse","i":"/rɪˈfjuːz/","a":"en-us-refuse.ogg","s":[{"p":"verb","d":[{"m":"If you refuse a request or demand, you decline or reject it.","e":"I refuse to take the offer for this house."},{"m":"(transitive) If you refuse a request or demand, you do not give your permission for it; you withhold it.","e":"My request for a pay raise was refused."}]},{"p":"noun","d":[{"m":"(uncountable) Refuse is stuff that people don't need and throw away."}]}]},"stealths":{"h":"stealths","l":"stealth","q":"noun"},"geometries":{"h":"geometries","l":"geometry","q":"noun"},"minnesota":{"h":"Minnesota","i":"/ˌmɪnɨˈsoʊtə/","a":"en-us-Minnesota.ogg","s":[{"p":"proper noun","d":[{"m":"Minnesota is a state in the United States.","e":"Saint Paul is the capital of Minnesota."}]}]},"extent":{"h":"extent","i":"/ɪkˈstɛnt/","a":"en-us-extent.ogg","s":[{"p":"noun","d":[{"m":"(countable) (singular) You use \"to an extent\" to explain how true something is or how much it happens.","e":"The US and, to a lesser extent, Britain have controlled the meeting."},{"m":"(countable) (singular) The extent of something is how far it goes, how much area it covers, or how much it does.","e":"Now he could see the full extent of the island, stretching away to the south."}]}]},"items":{"h":"items","a":"en-us-items.ogg","l":"item","q":"noun"},"carcinogens":{"h":"carcinogens","l":"carcinogen","q":"noun"},"investigations":{"h":"investigations","a":"en-us-investigations.ogg","l":"investigation","q":"noun"},"examinations":{"h":"examinations","l":"examination","q":"noun"},"washers":{"h":"washers","l":"washer","q":"noun"},"extents":{"h":"extents","l":"extent","q":"noun"},"short-cut":{"h":"short-cut","i":"/'ʃɔːtkʌt/","a":"LL-Q1860 (eng)-Vealhurl-shortcut.wav","s":[{"p":"noun","d":[{"m":"(countable) A short-cut is an easier and/or faster way.","e":"We took the short-cut on the way home so we could get there faster."},{"m":"A short-cut is a symlink (symbolic file link); an icon.","e":"I created a short-cut for the program and placed it on the desktop."}]}]},"facility":{"h":"facility","i":"/fəˈsɪlɪti/","a":"en-us-facility.ogg","s":[{"p":"noun","d":[{"m":"(plural) A place's facilities are its rooms, equipment, and services.","e":"Picnic, barbecue and playground facilities are located throughout the park."},{"m":"(countable) A facility is a building for a particular purpose, such as doing sport, policing, health care, etc., often a large public building.","e":"He found that Houston neighborhoods had quality recreational facilities, a friendly environment and extra security."},{"m":"(countable) If you have a facility for something, you do it well or learn it easily.","e":"Your son has a special facility for causing problems."},{"m":"(plural) The facilities is the washroom or toilet.","e":"Excuse me, but may I used the facilities?"}]}]},"verticals":{"h":"verticals","l":"vertical","q":"noun"},"vibrators":{"h":"vibrators","l":"vibrator","q":"noun"},"ventriloquists":{"h":"ventriloquists","l":"ventriloquist","q":"noun"},"carnation":{"h":"carnation","a":"en-us-carnation.ogg","s":[{"p":"noun","d":[{"m":"(countable) A carnation is a kind of flower.","e":"He wore a red carnation on his jacket."},{"m":"(uncountable) Carnation is a shade of the color pink."}]}]},"flesh":{"h":"flesh","i":"/flɛʃ/","a":"en-us-flesh.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Flesh is the meat on an animal or in a fruit."},{"m":"(uncountable) Flesh is a person's skin."},{"m":"Flesh color is the color of a white person's skin."}]},{"p":"verb","d":[{"m":"To fatten."},{"m":"To add details.","e":"The writer had to go back and flesh out the climactic scene."},{"m":"To remove the flesh from the skin during the making of leather."}]}]},"galatians":{"h":"Galatians","l":"galatian","q":"proper noun","s":[{"p":"proper noun","d":[{"m":"Galatians is a book in the New Testament of the bible.","e":"I have read the book of Galatians many times."}]}]},"galatian":{"h":"Galatian","i":"/ɡəˈleɪ.ʃən/","a":"LL-Q1860 (eng)-Vealhurl-Galatian.wav","s":[{"p":"proper noun","d":[{"m":"(countable) A Galatian is a person from Galatia.","e":"Most people who go to my school are Galatians."}]}]},"familiar":{"h":"familiar","i":"/fʌˈmɪliɜr/","a":"en-us-familiar.ogg","s":[{"p":"adjective","d":[{"m":"If something is familiar, you already know it or about it.","e":"\"Three strikes and you're out\" is a very familiar phrase these days."},{"m":"If you are familiar with something, you already know it or about it.","e":"What does that mean? I'm not familiar with the word?"},{"m":"If you are being familiar, you are acting in a friendly way."}]},{"p":"noun","d":[{"m":"(countable) A familiar is the magical pet of a witch, often a cat."}]}]},"zeeshan":{"h":"Zeeshan","s":[{"p":"proper noun","d":[{"m":"Zeeshan is a male given name."}]}]},"undercover":{"h":"undercover","i":"/ˌʌndə(r)ˈkʌvə(r)/","a":"LL-Q1860 (eng)-Vealhurl-undercover.wav","s":[{"p":"adjective","d":[{"m":"An action or person is undercover if it is hidden or secret: the people doing it don't want other people to know about it.","e":"We're planning an undercover operation to try to catch those people."},{"m":"Something is undercover if it involves spying.","e":"We sent three undercover agents to that country to try to find out what their government plans to do."}]}]},"noob":{"h":"noob","i":"/nuːb/","a":"LL-Q1860 (eng)-Vealhurl-noob.wav","s":[{"p":"noun","d":[{"m":"(countable) A noob is a beginner or a newbie; a player of a game who has just started out; not having the experience that other players have with the game.","e":"The noobs never understand the rules of the game."}]}]},"patriarchies":{"h":"patriarchies","l":"patriarchy","q":"noun"},"promotions":{"h":"promotions","l":"promotion","q":"noun"},"shockingly":{"h":"shockingly","s":[{"p":"adverb","d":[{"m":"In a very surprising way or to a very surprising level, and not in a good way.","e":"That guy is shockingly thin."}]}]},"william":{"h":"William","i":"/wiljəm/","a":"LL-Q1860 (eng)-Vealhurl-William.wav","s":[{"p":"proper noun","d":[{"m":"{{male given name}"}]}]},"tropical":{"h":"tropical","i":"/ˈtrɒp.ɪ.kəl/","a":"en-us-tropical.ogg","s":[{"p":"adjective","d":[{"m":"About a hot part of the world, near the equator, between 23 degrees north and 23 degrees south.","e":"I want to go somewhere tropical on my vacation."}]}]},"fancy":{"h":"fancy","i":"/ˈfæn.si/","a":"en-us-fancy.ogg","s":[{"p":"adjective","d":[{"m":"If something is fancy, it nicer than usual, often with decorations and bright colours.","e":"That's a very fancy dress you're wearing."},{"m":"A fancy restaurant, party, etc. is fashionable and expensive.","e":"She's going to a fancy party and the rest of us aren't welcome."},{"m":"Fancy movements are difficult but done with a lot of skill.","e":"He got around the other players with some very fancy footwork."},{"m":"Fancy apples, tuna, etc. are the best kind of that food.","e":"Cherries from Canada can be marked either \"CANADA FANCY\", \"CANADA CHOICE\" or \"CANADA STANDARD\""}]},{"p":"verb","d":[{"m":"(transitive) If you fancy something, you like or want it.","e":"No thanks. I don't really fancy coffee."},{"m":"(transitive) If you fancy someone, you like them in a sexual way.","e":"She's very nice, but I don't really fancy her, if you get my meaning."},{"m":"(transitive) If you fancy yourself something, you think you are that (but maybe other people don't agree).","e":"He fancies himself a great football player."},{"m":"(transitive) If you fancy something up, you make it more fancy."},{"m":"You say \"Fancy that!\" or fancy something, to show that you're surprised about it or think it unlikely.","e":"Fancy her getting the job!"}]},{"p":"noun","d":[{"m":"(countable) A fancy is a like or a wish."},{"m":"(countable) A fancy is an idea or a dream."},{"m":"(uncountable) Fancy is imagination."}]}]},"occupations":{"h":"occupations","l":"occupation","q":"noun"},"guests":{"h":"guests","i":"/ɡɛsts/","a":"en-us-guests.ogg","l":"guest","q":"noun"},"noobs":{"h":"noobs","l":"noob","q":"noun"},"newbs":{"h":"newbs","l":"newb","q":"noun"},"newbie":{"h":"newbie","i":"/ˈnjuːbi/","s":[{"p":"noun","d":[{"m":"(countable) A newbie is someone who is new to something; a newcomer."},{"m":"(countable) (Internet slang) A newbie is a new player or user; an inexperienced person; lacking the experience of the other people."}]}]},"newbies":{"h":"newbies","l":"newbie","q":"noun"},"factories":{"h":"factories","a":"en-us-factories.ogg","l":"factory","q":"noun"},"fees":{"h":"fees","a":"en-us-fees.ogg","l":"fee","q":"noun"},"fractions":{"h":"fractions","l":"fraction","q":"noun"},"generations":{"h":"generations","a":"en-us-generations.ogg","l":"generation","q":"noun"},"heavens":{"h":"heavens","a":"en-us-heavens.ogg","l":"heaven","q":"noun","s":[{"p":"noun","d":[{"m":"(usually plural) The sky."}]},{"p":"interjection","d":[{"m":"You use heavens to show that you are surprised about something.","e":"Good heavens! What's wrong with you?"}]}]},"ills":{"h":"ills","l":"ill","q":"noun"},"implications":{"h":"implications","l":"implication","q":"noun"},"initials":{"h":"initials","l":"initial","q":"noun"},"initiatives":{"h":"initiatives","l":"initiative","q":"noun"},"institutions":{"h":"institutions","a":"en-us-institutions.ogg","l":"institution","q":"noun"},"interpretations":{"h":"interpretations","l":"interpretation","q":"noun"},"islands":{"h":"islands","l":"island","q":"noun"},"joints":{"h":"joints","l":"joint","q":"noun"},"nondescript":{"h":"nondescript","i":"/nɑndəsˈkrɪpt/","a":"en-us-nondescript.ogg","s":[{"p":"adjective","d":[{"m":"If something is nondescript, it does not have anything special or unique about it that you can use to recognize it.","e":"He drives a nondescript white car."}]}]},"fashion":{"h":"fashion","i":"/ˈfæʃən/","a":"en-us-fashion.ogg","s":[{"p":"noun","d":[{"m":"A fashion is a style, often clothing, that is popular at a particular time and place.","e":"The fashion was for men to have long hair."},{"m":"(countable) A fashion is a way or manner.","e":"It's a good idea to pay what you owe in a timely fashion."},{"m":"(uncountable) The fashion business is the business of designing and making clothes.","e":"Lagerfeld is the current designer for the Chanel fashion house."}]},{"p":"verb","d":[{"m":"(transitive) If you fashion something, you design and make it, usually by hand.","e":"He makes beautiful art fashioned from simple things he gets from the garbage."}]}]},"fuchsia":{"h":"fuchsia","i":"/ˈfjuːʃə/","a":"en-us-fuchsia.ogg","s":[{"p":"noun","d":[{"m":"(countable) Fuchsia is a plant with red, pink or purple flowers.","e":"My fuchsias get reddish or faint fuchsia in color."},{"m":"(uncountable) Fuchsia is a light purple color.","e":"My fuchsias get reddish or faint fuchsia in color."}]}]},"sicko":{"h":"sicko","s":[{"p":"noun","d":[{"m":"(countable) A sicko is a person who is mentally ill (crazy)."},{"m":"(countable) A sicko is a very bad person.","e":"He's a real sicko to rape children."},{"m":"(countable) (Australia) A sicko is when you pretend to be sick to keep from working."}]}]},"sickness":{"h":"sickness","i":"/ˈsɪknɪs/","a":"en-us-sickness.ogg","s":[{"p":"noun","d":[{"m":"Sickness is being sick."}]}]},"postage":{"h":"postage","i":"/ˈpəʊstɪʤ/","a":"LL-Q1860 (eng)-Vealhurl-postage.wav","s":[{"p":"noun","d":[{"m":"Postage is money that is paid to have a letter or package delivered to someone.","e":"Mary paid 50 cents for postage."}]}]},"sicken":{"h":"sicken","i":"/ˈsɪkən/","a":"LL-Q1860 (eng)-Vealhurl-sicken.wav","s":[{"p":"verb","d":[{"m":"(transitive) If something sickens you, it makes you sick; this often means making your stomach sick, so that you might vomit.","e":"The infection will sicken him until amputation is needed."},{"m":"(transitive) If something sickens you, it is very bad and you hate it.","e":"It sickens me when people don't wash their hands after they use the toilet."},{"m":"(intransitive) If you sicken you become sick, or you become more sick.","e":"He will sicken if he doesn't get medicine soon."}]}]},"sickening":{"h":"sickening","i":"/ˈsɪk(ə)nɪŋ/","a":"en-au-sickening.ogg","l":"sicken","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is sickening is makes you feel sick. Usually this mean it makes your stomach sick so that you might vomit."}]}]},"vomit":{"h":"vomit","i":"/ˈvɒmət/","a":"en-us-vomit.ogg","s":[{"p":"noun","d":[{"m":"Vomit is stuff from your stomach that might come out your mouth if you are sick."}]},{"p":"verb","d":[{"m":"If you vomit, anything in your stomach comes out of your mouth; you puke.","e":"He vomited after dinner because he ate too much."}]}]},"puke":{"h":"puke","i":"/pjuːk/","a":"en-us-puke.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Puke is vomit."}]},{"p":"verb","d":[{"m":"If you puke, you vomit or bring up stuff from your stomach.","e":"He puked as a result of his sickness."}]}]},"lewd":{"h":"lewd","i":"/ljuːd/","a":"en-uk-lewd.ogg","s":[{"p":"adjective","d":[{"m":"vulgar or obscene"},{"m":"Lustful or lascivious","e":"The girl shows lewd images."}]}]},"ravine":{"h":"ravine","i":"/rəˈviːn/","a":"en-us-ravine.ogg","s":[{"p":"noun","d":[{"m":"(countable) A ravine is a very small valley.","e":"There is a gorge in Alicante named \"Ravine of sheeps\"."}]}]},"sick-o":{"h":"sick-o","s":[{"p":"noun","d":[{"m":"(countable) A sick-o is a person who is mentally ill; crazy.","e":"Michael Moore directed a movie \"Sicko\" about the health system of the United States."},{"m":"(countable) A sick-o is a very bad person.","e":"He's a real sicko to rape children."}]}]},"crazy":{"h":"crazy","i":"/ˈkreɪzi/","a":"en-us-crazy.ogg","s":[{"p":"adjective","d":[{"m":"If someone is crazy, they do not think or act normally. A crazy person might do very strange thing or believe things that everyone knows are not true.","e":"I knew he was crazy when he said he was Jesus Christ."},{"m":"If someone is crazy, they are fun, because no one can guess what they might do next.","e":"I love her because she is so wild and crazy."},{"m":"To be crazy about someone or something means to like someone or something very much.","e":"I'm crazy about basketball."},{"m":"If something is crazy, it is very strange, not what a person would expect.","e":"The weather has been crazy, with snow in summer and hot day in winter."}]},{"p":"noun","d":[{"m":"A crazy is person who is crazy (see above). Usually this is for a person who is insane."}]}]},"latin":{"h":"Latin","i":"/ˈlætɪn/","a":"en-us-Latin.ogg","s":[{"p":"proper noun","d":[{"m":"A language that people used in ancient Rome.","e":"I don't know how to speak Latin."}]},{"p":"adjective","d":[{"m":"In the language of ancient Rome.","e":"\"Equus\" is Latin for \"horse.\""},{"m":"From South America or Central America. Also, a person whose ancestors come from Spain.","e":"This is a Latin neighborhood, everyone here is from Mexico."},{"m":"Typical of people from South America or Central America.","e":"I love Latin food and Latin music."}]}]},"insane":{"h":"insane","i":"/ɪnˈseɪn/","a":"LL-Q1860 (eng)-Vealhurl-insane.wav","s":[{"p":"adjective","d":[{"m":"(can be offensive) If you are insane you can not think well because of mental illness.","e":"He was sent to a mental hospital because he was insane."},{"m":"An insane idea is very strange, like something a crazy person might think of.","e":"That has got to be the most insane thing I have ever heard."},{"m":"If something is insane it does not make sense. It is strange in a bad way.","e":"The price of gas these days is insane."}]}]},"sane":{"h":"sane","i":"/seɪn/","a":"LL-Q1860 (eng)-Vealhurl-sane.wav","s":[{"p":"adjective","d":[{"m":"If you are sane, you think and feel in a normal way. You do not have mental illness."},{"m":"If something is sane, it is organized and normal; it makes sense."}]}]},"evict":{"h":"evict","s":[{"p":"verb","d":[{"m":"If you evict someone, you take their home from them.","e":"The council evicted the man because he didn't pay his rent."}]}]},"fellow":{"h":"fellow","i":"/ˈfɛləʊ/","a":"en-us-fellow.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fellow is a friend; a partner; a companion.","e":"I have been traveling with my fellow adventurers."},{"m":"(countable) A fellow is someone who is of the same rank or power as someone else."},{"m":"(countable) A fellow is a person; an individual.","e":"Look at that fellow over there."}]},{"p":"adjective","d":[{"m":"Being of the same kind or group."}]}]},"fox":{"h":"fox","i":"/fɒks/","a":"en-us-fox.ogg","s":[{"p":"noun","d":[{"m":"A small wild animal that is like a dog."},{"m":"A pretty woman."},{"m":"A smart person who can trick other people."}]},{"p":"verb","d":[{"m":"(transitive) If you fox someone, you trick them; you fool them."},{"m":"(transitive) If something foxes you, it confuses or baffles you.","e":"This Sudoku puzzle foxes me."}]}]},"odds":{"h":"odds","i":"/ɑdz/","a":"LL-Q1860 (eng)-Wodencafe-odds.wav","s":[{"p":"noun","d":[{"m":"(uncountable), In statistics, the odds are the chance something will happen divided by the chance it will not happen:","e":"What are the odds of winning in this game?"},{"m":"(uncountable), The odds of something happening are the chances it will happen.","e":"I don't like the odds here."}]}]},"keen":{"h":"keen","i":"/kiːn/","a":"en-us-keen.ogg","s":[{"p":"adjective","d":[{"m":"If you are keen on something you like that thing."},{"m":"If something is keen it is very good."}]},{"p":"noun","d":[{"m":"(Ireland or Scotland) An Irish cry of sadness for a dead person."}]},{"p":"verb","d":[{"m":"(Ireland or Scotland) To cry for a dead person."}]}]},"ride":{"h":"ride","i":"/raɪd/","a":"en-us-ride.ogg","s":[{"p":"verb","d":[{"m":"If you ride something, you sit on it while it moves.","e":"I can ride a horse, but I cannot ride a motorcycle."},{"m":"If you ride someone, you have sex with them."}]},{"p":"noun","d":[{"m":"(countable) A ride is a journey you take by riding.","e":"It was a long ride from Canada to Mexico."},{"m":"(countable) (informal) A ride is a vehicle like a car, motorcycle or bicycle.","e":"That is a nice ride you are driving."},{"m":"(countable) A ride is a machine that you ride on for fun.","e":"Roller-coasters and merry-go-rounds are my favorite rides at the park."},{"m":"A lift given to someone in another person's vehicle.","e":"Can you give me a ride?"},{"m":"A ride is an act of sexual intercourse."}]}]},"wrap":{"h":"wrap","i":"/ræp/","a":"LL-Q1860 (eng)-Vealhurl-wrap.wav","s":[{"p":"verb","d":[{"m":"If you wrap something you cover it with something like paper or cloth. This might be done by winding the paper or cloth over it.","e":"I wrapped the gifts in paper."},{"m":"If you wrap something up you finish it.","e":"We need to wrap up this meeting and get back to work."}]},{"p":"noun","d":[{"m":"A piece of clothing that you can wrap around your body to keep warm."},{"m":"Something you wrap things in; a wrapper.","e":"I bought some giftwrap from the gift."},{"m":"A food wrapped in soft bread.","e":"I had a chicken wrap for lunch."},{"m":"You can say, \"That's a wrap!\" to say you have finished something."}]}]},"wipe":{"h":"wipe","i":"/waɪp/","a":"en-us-wipe.ogg","s":[{"p":"verb","d":[{"m":"If you wipe something, you rub it to take something off of it. Often you wipe off water or dirt.","e":"I wiped my glasses with my shirt."},{"m":"If you wipe a computer disk, you erase everything from it.","e":"I accidentally wiped my hard drive and lost all my documents."}]},{"p":"noun","d":[{"m":"A wipe is a piece of cloth that you wipe with.","e":"We need more wipes to clean the baby's bottom."},{"m":"A wipe is one movement that is part of wiping.","e":"Just give it a quick wipe to clean it."}]}]},"reset":{"h":"reset","i":"/riːˈsɛt/","a":"LL-Q1860 (eng)-Vealhurl-reset1.wav","l":"reset","q":"verb","s":[{"p":"verb","d":[{"m":"If you reset something you change it back to the way it started. You set it to the beginning again.","e":"The timer doesn't work right and I have to reset it every day; it's a pain."}]}]},"trio":{"h":"trio","s":[{"p":"noun","d":[{"m":"A trio is three people or three things who are together or who are the same as each other in some way.","e":"They played music as a trio, playing flute, violin and cello."}]}]},"friends":{"h":"friends","i":"/frɛndz/","a":"en-us-friends.ogg","l":"friend","q":"noun"},"gangbangs":{"h":"gangbangs","l":"gangbang","q":"noun"},"indexes":{"h":"indexes","l":"index","q":"noun"},"indices":{"h":"indices","i":"/ˈɪndɪsiːz/","a":"en-us-indices.ogg","l":"index","q":"noun"},"queers":{"h":"queers","l":"queer","q":"noun"},"straights":{"h":"straights","l":"straight","q":"noun"},"contented":{"h":"contented","i":"/kənˈtɛntɪd/","a":"LL-Q1860 (eng)-Flame, not lame-contented.wav","l":"content","q":"verb","s":[{"p":"adjective","d":[{"m":"If a person is contented, they are satisfied."}]}]},"contenting":{"h":"contenting","l":"content","q":"verb"},"wires":{"h":"wires","i":"/waɪəz/","a":"en-us-wires.ogg","l":"wire","q":"noun"},"wired":{"h":"wired","i":"/waɪəd/","a":"en-us-wired.ogg","l":"wire","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are wired, you are excited or hyper.","e":"I can't drink coffee in the evenings because it makes me really wired and then I can't sleep."}]}]},"wiring":{"h":"wiring","i":"/ˈwʌɪərɪŋ/","l":"wire","q":"verb","s":[{"p":"noun","d":[{"m":"Wiring is a system of electric wires."},{"m":"Wiring is when you put in wiring."}]}]},"cures":{"h":"cures","l":"cure","q":"verb"},"cured":{"h":"cured","i":"/kjʊrd/","a":"en-us-cured.ogg","l":"cure","q":"verb"},"curing":{"h":"curing","l":"cure","q":"verb"},"tasks":{"h":"tasks","l":"task","q":"noun"},"tasked":{"h":"tasked","l":"task","q":"verb"},"tasking":{"h":"tasking","l":"task","q":"verb"},"pasts":{"h":"pasts","l":"past","q":"noun"},"spends":{"h":"spends","l":"spend","q":"verb"},"wirings":{"h":"wirings","l":"wiring","q":"noun"},"spending":{"h":"spending","l":"spend","q":"verb"},"takeoffs":{"h":"takeoffs","l":"takeoff","q":"noun"},"excludes":{"h":"excludes","l":"exclude","q":"verb"},"excluded":{"h":"excluded","i":"/ɪksˈkluːdɪd/","a":"LL-Q1860 (eng)-Sapaa-excluded.wav","l":"exclude","q":"verb"},"prevents":{"h":"prevents","l":"prevent","q":"verb"},"prevented":{"h":"prevented","a":"en-us-prevented.ogg","l":"prevent","q":"verb"},"preventing":{"h":"preventing","l":"prevent","q":"verb"},"nominates":{"h":"nominates","l":"nominate","q":"verb"},"nominating":{"h":"nominating","l":"nominate","q":"verb"},"nominated":{"h":"nominated","l":"nominate","q":"verb"},"indexed":{"h":"indexed","l":"index","q":"verb"},"indexing":{"h":"indexing","l":"index","q":"verb"},"confesses":{"h":"confesses","l":"confess","q":"verb"},"confessed":{"h":"confessed","i":"/kənˈfɛst/","a":"en-us-confessed.ogg","l":"confess","q":"verb"},"confessing":{"h":"confessing","l":"confess","q":"verb"},"allocates":{"h":"allocates","l":"allocate","q":"verb"},"allocated":{"h":"allocated","l":"allocate","q":"verb"},"allocating":{"h":"allocating","l":"allocate","q":"verb"},"alarmed":{"h":"alarmed","i":"/əˈlɑrmd/","a":"en-us-alarmed.ogg","l":"alarm","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are alarmed, you are surprised or upset.","