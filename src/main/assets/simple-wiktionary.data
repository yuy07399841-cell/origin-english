":"noun"},"wrecked":{"h":"wrecked","l":"wreck","q":"verb"},"wrecking":{"h":"wrecking","l":"wreck","q":"verb"},"wools":{"h":"wools","l":"wool","q":"noun"},"wilder":{"h":"wilder","l":"wild","q":"adjective"},"wildest":{"h":"wildest","l":"wild","q":"adjective"},"widows":{"h":"widows","l":"widow","q":"noun"},"wickeder":{"h":"wickeder","l":"wicked","q":"adjective"},"wickedest":{"h":"wickedest","l":"wicked","q":"adjective"},"whistled":{"h":"whistled","l":"whistle","q":"verb"},"whistling":{"h":"whistling","l":"whistle","q":"verb"},"whiskies":{"h":"whiskies","l":"whiskey","q":"noun"},"whipped":{"h":"whipped","i":"/ʍɪpt/","a":"en-au-whipped.ogg","l":"whip","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are whipped, you a very tired."},{"m":"If you are whipped, your wife or girlfriend controls you."}]}]},"whipping":{"h":"whipping","i":"/ˈwɪpɪŋ/","a":"LL-Q1860 (eng)-Persent101-whipping.wav","l":"whip","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A whipping is the punishment of being whipped."},{"m":"(uncountable) Whipping is a cooking technique where air is incorporated into cream."}]}]},"weapons":{"h":"weapons","i":"/ˈwɛpənz/","a":"en-us-weapons.ogg","l":"weapon","q":"noun"},"uniforms":{"h":"uniforms","l":"uniform","q":"noun"},"twists":{"h":"twists","l":"twist","q":"verb"},"twisted":{"h":"twisted","a":"en-us-twisted.ogg","l":"twist","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are twisted, you act in a strange way that makes people uncomfortable.","e":"You killed a puppy?! How sick and twisted are you?!!"},{"m":"Using alcohol and marijuana at the same time; drunk and high."}]}]},"twisting":{"h":"twisting","a":"en-us-twisting.ogg","l":"twist","q":"verb"},"twins":{"h":"twins","l":"twin","q":"noun"},"tubes":{"h":"tubes","i":"/tuːbz/","a":"en-us-tubes.ogg","l":"tube","q":"noun"},"tubed":{"h":"tubed","l":"tube","q":"verb"},"tubing":{"h":"tubing","l":"tube","q":"verb"},"trucked":{"h":"trucked","l":"truck","q":"verb"},"trucking":{"h":"trucking","l":"truck","q":"verb"}