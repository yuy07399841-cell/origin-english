","q":"noun"},"pelagic":{"h":"pelagic","i":"/pəˈlæd͡ʒɪk/","a":"LL-Q1860 (eng)-Vealhurl-pelagic.wav","s":[{"p":"adjective","d":[{"m":"If something is pelagic, it lives in the open sea rather than in coastal or inland waters.","e":"is a type of pelagic fish."}]}]},"armskote":{"h":"armskote","i":"/ˈɑːmskoʊt/","a":"LL-Q1860 (eng)-Hypnoticreflection-armskote.wav","s":[{"p":"noun","d":[{"m":"(countable) (Singapore) An armskote is a storage room where firearms and magazines are kept."}]}]},"armskotes":{"h":"armskotes","l":"armskote","q":"noun"},"gentry":{"h":"gentry","i":"/ˈd͡ʒɛntri/","a":"en-us-gentry.ogg","s":[{"p":"noun","d":[{"m":"Gentry are people of good social position."}]}]},"gentries":{"h":"gentries","l":"gentry","q":"noun"},"orlando":{"h":"Orlando","i":"/ɔrˈlæn.doʊ/","a":"LL-Q1860 (eng)-Vealhurl-Orlando.wav","s":[{"p":"proper noun","d":[{"m":"Orlando is a city in Florida, United States."}]}]},"miami":{"h":"Miami","i":"/maɪˈæmi/","a":"LL-Q1860 (eng)-Vealhurl-Miami.wav","s":[{"p":"proper noun","d":[{"m":"Miami is a city in Florida, United States."}]}]},"karelia":{"h":"Karelia","s":[{"p":"proper noun","d":[{"m":"Karelia is a historical region in Europe."},{"m":"Karelia is an autonomous republic in Russia; the capital city is Petrozavodsk."}]}]},"refax":{"h":"refax","s":[{"p":"verb","d":[{"m":"If you refax something, you fax it again."}]}]},"refaxes":{"h":"refaxes","l":"refax","q":"verb"},"refaxed":{"h":"refaxed","l":"refax","q":"verb"},"refaxing":{"h":"refaxing","l":"refax","q":"verb"},"refeed":{"h":"refeed","s":[{"p":"verb","d":[{"m":"If you refeed something, you feed it again."}]}]},"refeeds":{"h":"refeeds","l":"refeed","q":"verb"},"refeeded":{"h":"refeeded","l":"refeed","q":"verb"},"refeeding":{"h":"refeeding","l":"refeed","q":"verb"},"blurry":{"h":"blurry","i":"/ˈblɜːri/","a":"LL-Q1860 (eng)-Vealhurl-blurry.wav","s":[{"p":"adjective","d":[{"m":"If an image is blurry, it is not clear and it is difficult to see it."}]}]},"muzzy":{"h":"muzzy","i":"/ˈmʌzi/","a":"en-