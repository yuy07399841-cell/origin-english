ace where things are stowed."},{"m":"Stowage is the things that are stowed."},{"m":"Stowage is the amount of room for things."}]}]},"stowages":{"h":"stowages","l":"stowage","q":"noun"},"quilted":{"h":"quilted","l":"quilt","q":"verb"},"quilting":{"h":"quilting","l":"quilt","q":"verb"},"transpose":{"h":"transpose","i":"/trænzˈpoʊz/","a":"en-us-transpose-verb.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you transpose two or more things, you reverse or change their order."}]}]},"transposes":{"h":"transposes","l":"transpose","q":"verb"},"transposed":{"h":"transposed","l":"transpose","q":"verb"},"transposing":{"h":"transposing","l":"transpose","q":"verb"},"violences":{"h":"violences","l":"violence","q":"noun"},"workload":{"h":"workload","i":"/ˈwɜrkˌloʊd/","s":[{"p":"noun","d":[{"m":"(uncountable) Your workload is the amount of work you have to do.","e":"Her workload increased after her coworker left."}]}]},"ponytail":{"h":"ponytail","i":"/ˈpoʊniˌteɪl/","s":[{"p":"noun","d":[{"m":"(countable) A ponytail is a hairstyle where long hair is tied together at the back of the head."}]}]},"scrunchie":{"h":"scrunchie","i":"/ˈskrʌnt͡ʃi/","a":"LL-Q1860 (eng)-Vealhurl-scrunchie.wav","s":[{"p":"noun","d":[{"m":"(countable) A scrunchie is an elastic piece of fabric you can use to make a ponytail"}]}]},"scrunchies":{"h":"scrunchies","l":"scrunchy","q":"noun"},"ponytails":{"h":"ponytails","l":"ponytail","q":"noun"},"workloads":{"h":"workloads","l":"workload","q":"noun"},"scrunchy":{"h":"scrunchy","i":"/ˈskrʌnt͡ʃi/","a":"LL-Q1860 (eng)-Vealhurl-scrunchie.wav","s":[{"p":"noun","d":[{"m":"(countable) A scrunchy is an elastic piece of fabric you can use to make a ponytail"}]},{"p":"adjective","d":[{"m":"(informal) If something is scrunchy, it has been scrunched up.."}]}]},"scrunchier":{"h":"scrunchier","l":"scrunchy","q":"adjective"},"scrunchiest":{"h":"scrunchiest","l":"scrunchy","q":"adjective"},"apt":{"h":"apt","i":"/æpt/","a":"en-us-apt.ogg","s":[{"p":"adjective","d":[{"m":"If someone is apt, they have a natural ability to do something or learn something easily.","e":"She is an apt student who picks up new concepts quickly."},{"m":"If something is apt, it is suitable or appropriate in the circumstances.","e":"That comment was particularly apt given the situation."},{"m":"When someone is likely to do something, they are described as being apt to do it.","e":"He is apt to forget his keys if he's in a hurry."}]}]},"scrunch":{"h":"scrunch","i":"/skrʌnt͡ʃ/","a":"LL-Q1860 (eng)-Vealhurl-scrunch.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you scrunch something, you crumple and squeeze it to make it more compact."}]}]},"scrunches":{"h":"scrunches","l":"scrunch","q":"verb"},"scrunched":{"h":"scrunched","l":"scrunch","q":"verb"},"scrunching":{"h":"scrunching","l":"scrunch","q":"verb"},"editorialize":{"h":"editorialize","s":[{"p":"verb","d":[{"m":"If you editorialize, you express your opinion instead of when you should be reporting the facts only."}]}]},"editorializes":{"h":"editorializes","l":"editorialize","q":"verb"},"editorialized":{"h":"editorialized","l":"editorialize","q":"verb"},"editorialise":{"h":"editorialise","s":[{"p":"verb","d":[{"m":"If you editorialise, you express your opinion instead of when you should be reporting the facts only."}]}]},"editorializing":{"h":"editorializing","l":"editorialize","q":"verb"},"editorialises":{"h":"editorialises","l":"editorialise","q":"verb"},"editorialised":{"h":"editorialised","l":"editorialise","q":"verb"},"editorialising":{"h":"editorialising","l":"editorialise","q":"verb"},"quibble":{"h":"quibble","i":"/ˈkwɪb.əl/","a":"en-au-quibble.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you quibble about small, unimportant things, you argue or complain about them.","e":"She always quibbles over minor details."}]},{"p":"noun","d":[{"m":"(countable) A quibble is a minor objection or criticism about a about small, unimportant matter.","e":"There was a quibble over how the bill had been paid."}]}]},"insolvent":{"h":"insolvent","i":"/(ˌ)ɪnˈsɒlv(ə)nt/","a":"LL-Q1860 (eng)-Vealhurl-insolvent.wav","s":[{"p":"adjective","d":[{"m":"If someone is insolvent, they cannot pay their debts.","e":"Many become insolvent due to mismanagement."}]}]},"mismanagement":{"h":"mismanagement","i":"/(ˌ)mɪsˈmanᵻdʒm(ə)nt/","a":"LL-Q1860 (eng)-Qwertygiy-mismanagement.wav","s":[{"p":"noun","d":[{"m":"Mismanagement is the act of controlling or organising something such as a business badly.","e":"The executive director resigned amid accusations of mismanagement."}]}]},"quibbles":{"h":"quibbles","l":"quibble","q":"verb"},"quibbled":{"h":"quibbled","l":"quibble","q":"verb"},"quibbling":{"h":"quibbling","l":"quibble","q":"verb"},"mismanagements":{"h":"mismanagements","l":"mismanagement","q":"noun"},"munificence":{"h":"munificence","i":"/mjuːˈnɪfɪsəns/","a":"LL-Q1860 (eng)-Vealhurl-munificence.wav","s":[{"p":"noun","d":[{"m":"Munificence is the quality of being generous."}]}]},"multicoloured":{"h":"multicoloured","s":[{"p":"adjective","d":[{"m":"If something is multicoloured, it has a lot of colours."}]}]},"mufti":{"h":"mufti","i":"/ˈmʌfti/","a":"en-au-mufti.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mufti is a Muslim who is an expert on law and the Qur'an"},{"m":"(uncountable) If someone, especially in the military, dresses in mufti, they wear regular clothes and not their uniform."}]}]},"muftis":{"h":"muftis","l":"mufti","q":"noun"},"multicolored":{"h":"multicolored","s":[{"p":"adjective","d":[{"m":"If something is multicolored, it has a lot of colors."}]}]},"facet":{"h":"facet","i":"/ˈfæsɪt/","a":"en-us-facet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A facet is one side or aspect of something, especially something with many sides.","e":"One facet of the problem is finding enough money."},{"m":"(countable) A facet is one of the flat surfaces on a gem.","e":"The diamond has many facets."}]},{"p":"verb","d":[{"m":"If you facet a gem, you cut flat surfaces on it.","e":"The jeweler faceted the stone carefully."}]}]},"facets":{"h":"facets","l":"facet","q":"noun"},"facetted":{"h":"facetted","l":"facet","q":"verb"},"facetting":{"h":"facetting","l":"facet","q":"verb"},"knack":{"h":"knack","i":"/næk/","a":"en-us-knack.ogg","s":[{"p":"noun","d":[{"m":"(singular) If you have a knack for doing something, you have a special skill or ability to do it easily.","e":"He has a knack for fixing computers."},{"m":"(countable) A knack is a trick or a clever way of doing something.","e":"The door sticks, but there's a knack to opening it."}]}]},"knacks":{"h":"knacks","l":"knack","q":"noun"},"elementary":{"h":"elementary","i":"/ˌɛlɪˈmɛntəri/","a":"LL-Q1860 (eng)-Vealhurl-elementary.wav","s":[{"p":"adjective","d":[{"m":"If something is elementary, it is basic and easy to understand.","e":"The math problems are elementary for students in the first grade."},{"m":"An elementary school, is where children start their education.","e":"Students go to elementary school before they go to secondary school."}]}]},"resonance":{"h":"resonance","i":"/ˈrɛzənəns/","a":"LL-Q1860 (eng)-Vealhurl-resonance.wav","s":[{"p":"noun","d":[{"m":"(uncountable) In music, resonance is the rich, clear sound made by instruments or voices.","e":"The guitar's body gives it a strong resonance."},{"m":"(uncountable) Resonance is the experience of an idea, feeling, or situation feeling deeply meaningful.","e":"Her speech had great emotional resonance with the audience."},{"m":"(uncountable) Resonance, is the quality of space like a hall, church, or cave that makes speech or music in it sound deep and full.","e":"The room had great resonance because of the wood floors."},{"m":"(uncountable) Resonance is sound that is produced or increased in one object when sound waves hit it.","e":"The resonance frequency of the wine glass is 440&nbsp;Hz."},{"m":"(uncountable) In chemistry, resonance refers to the way some molecules can be represented by more than one structure at the same time.","e":"The resonance of the molecule helps explain its stability."},{"m":"(uncountable) In music, resonance is the rich, clear sound made by instruments or voices.","e":"The guitar's body gives it a strong resonance."},{"m":"(uncountable) In electronics, resonance occurs when a circuit can easily transfer energy at a certain frequency.","e":"The circuit is designed to have resonance at this frequency."}]}]},"resonances":{"h":"resonances","l":"resonance","q":"noun"},"biennial":{"h":"biennial","i":"/baɪˈɛn.i.əl/","a":"en-us-biennial.ogg","s":[{"p":"adjective","d":[{"m":"If something is biennial, it happens every two years."}]}]},"disposition":{"h":"disposition","i":"/ˌdɪspəˈzɪʃən/","a":"en-us-disposition.ogg","s":[{"p":"noun","d":[{"m":"(countable) Your disposition is your usual way of acting or feeling.","e":"She has a cheerful disposition."},{"m":"(countable) The disposition of objects is the way they are arranged or placed.","e":"The disposition of the furniture made the room look more spacious."},{"m":"(countable) A disposition is the legal process of transferring property or money.","e":"The disposition of the estate was handled by a lawyer."}]}]},"dispositions":{"h":"dispositions","l":"disposition","q":"noun"},"havoc":{"h":"havoc","s":[{"p":"noun","d":[{"m":"If someone or something wreaks or plays havoc they cause a lot of damage."}]},{"p":"verb","d":[{"m":"If someone havocs they cause a lot of damage."}]}]},"headlamp":{"h":"headlamp","s":[{"p":"noun","d":[{"m":"(countable) A headlamp is a bright light at the front of a car, motorbike or bicycle."},{"m":"(countable) A headlamp is a bright light that you wear on your head."}]}]},"castaway":{"h":"castaway","s":[{"p":"noun","d":[{"m":"(countable) A castaway is someone who has survived a shipwreck and is not able to contact other people to get help."}]}]},"castaways":{"h":"castaways","l":"castaway","q":"noun"},"headlamps":{"h":"headlamps","l":"headlamp","q":"noun"},"havocked":{"h":"havocked","l":"havoc","q":"verb"},"havocking":{"h":"havocking","l":"havoc","q":"verb"},"havocs":{"h":"havocs","l":"havoc","q":"verb"},"injustice":{"h":"injustice","i":"/ɪnˈdʒʌstɪs/","a":"LL-Q1860 (eng)-Vealhurl-injustice.wav","s":[{"p":"noun","d":[{"m":"(countable) An injustice is an unfair act or situation.","e":"Slavery is one of the worst injustices in history."}]}]},"injustices":{"h":"injustices","l":"injustice","q":"noun"},"savage":{"h":"savage","i":"/ˈsævɪdʒ/","a":"en-us-savage.ogg","s":[{"p":"adjective","d":[{"m":"Savage actions are very violent and cruel.","e":"The soldiers' savage attack caused fear among the people."},{"m":"A savage wind, attack, animal, etc is very wild and uncontrolled.","e":"A savage wind knocked over the trees."},{"m":"If you call a tribe or other group of people savage, you believe they lack civilization.","e":"The Christian church planned to bring civilization to the savage peoples of the Americas."}]},{"p":"noun","d":[{"m":"(countable) If you call a person a savage, you believe they lack civilization and are violent or animal-like.","e":"We were attacked in our homes as we slept by the savages."}]},{"p":"verb","d":[{"m":"(transitive) If a person or animal savages someone, they attack them violently.","e":"The dog savaged the intruder, causing severe injuries."},{"m":"(transitive) If you savage someone, you criticize them strongly.","e":"The journalist savaged the politician's performance in the debate."}]}]},"savaged":{"h":"savaged","l":"savage","q":"verb"},"savages":{"h":"savages","l":"savage","q":"noun"},"savaging":{"h":"savaging","l":"savage","q":"verb"},"crest":{"h":"crest","i":"/krɛst/","a":"LL-Q1860 (eng)-Vealhurl-crest.wav","s":[{"p":"noun","d":[{"m":"(countable) The crest of a hill or wave is its top part.","e":"We stood on the crest of the mountain."},{"m":"(countable) A crest is a special symbol used by a family, group, or organization.","e":"The family crest was on the walls of the castle."},{"m":"(countable) A bird or animal's crest is the feathers or fur on the top of its head.","e":"The cockatoo raised its crest when it saw danger."}]},{"p":"verb","d":[{"m":"(transitive) If you crest a hill or wave, you come over the top of it.","e":"After cresting the hill, we and had a fantastic view of the countryside."},{"m":"(intransitive) A river or other rising water crests when it reaches its highest point before going down.","e":"The river crested an hour after the heavy rainstorm."}]}]},"crests":{"h":"crests","l":"crest","q":"noun"},"crested":{"h":"crested","l":"crest","q":"verb"},"cresting":{"h":"cresting","l":"crest","q":"verb"},"detonator":{"h":"detonator","i":"/ˈdɛt.ə.neɪ.tə(r)/","a":"LL-Q1860 (eng)-Vealhurl-detonator.wav","s":[{"p":"noun","d":[{"m":"(countable) A detonator is a device that blows up a bomb."}]}]},"detonators":{"h":"detonators","l":"detonator","q":"noun"},"lordship":{"h":"lordship","i":"/ˈlɔːd.ʃɪp/","a":"LL-Q1860 (eng)-Vealhurl-lordship.wav","s":[{"p":"noun","d":[{"m":"A lordship is the heritable position of being a lord.","e":"He was given the castle and lordship of Kidwelly."},{"m":"(countable) A lordship is a title or form of address used to refer to someone with the rank of a lord, often preceded by a genitive.","e":"His lordship's decisions were final."}]}]},"heritable":{"h":"heritable","i":"/ˈhɛrɪtəbəl/","s":[{"p":"adjective","d":[{"m":"Heritable traits or characteristics can be passed from parents to their children.","e":"Eye colour is a heritable trait."},{"m":"Heritable property or titles can be inherited by family members.","e":"The heritable estate was passed down to the next generation."}]}]},"lordships":{"h":"lordships","l":"lordship","q":"noun"},"greatness":{"h":"greatness","i":"/ˈɡreɪtnəs/","a":"en-us-greatness.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Greatness is the quality of being very important, powerful, or skillful.","e":"Many people admired her for her greatness on the soccer field."},{"m":"(uncountable) Greatness is the state of being very large or grand.","e":"The greatness of the mountains took their breath away."}]}]},"borrower":{"h":"borrower","i":"/ˈbɔrəʊə/","s":[{"p":"noun","d":[{"m":"(countable) A borrower is someone who borrows."}]}]},"borrowers":{"h":"borrowers","l":"borrower","q":"noun"},"stopper":{"h":"stopper","i":"/ˈstɒp.ə/","a":"en-au-stopper.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stopper is someone or something that stops things."}]}]},"processor":{"h":"processor","i":"/ˈprəʊˌsɛsə(r)/","a":"LL-Q1860 (eng)-Vininn126-processor.wav","s":[{"p":"noun","d":[{"m":"(countable) A processor is someone or something that processes things."}]}]},"processors":{"h":"processors","l":"processor","q":"noun"},"stoppers":{"h":"stoppers","l":"stopper","q":"noun"},"underachiever":{"h":"underachiever","s":[{"p":"noun","d":[{"m":"(countable) An underachiever is a person who performs less well than what is expected of them."}]}]},"underachievers":{"h":"underachievers","l":"underachiever","q":"noun"},"overachieve":{"h":"overachieve","i":"/ˈəʊ.və(r)əˈt͡ʃiːv/","s":[{"p":"verb","d":[{"m":"If a person underachieves, they achieve more than what is expected of them."}]}]},"underachieve":{"h":"underachieve","i":"/ˌʌndə(r)əˈt͡ʃiːv/","s":[{"p":"verb","d":[{"m":"If a person underachieves, they achieve less than what is expected of them."}]}]},"overachieves":{"h":"overachieves","l":"overachieve","q":"verb"},"overachieved":{"h":"overachieved","l":"overachieve","q":"verb"},"overachieving":{"h":"overachieving","l":"overachieve","q":"verb"},"underachieves":{"h":"underachieves","l":"underachieve","q":"verb"},"underachieved":{"h":"underachieved","l":"underachieve","q":"verb"},"underachieving":{"h":"underachieving","l":"underachieve","q":"verb"},"clinical":{"h":"clinical","i":"/ˈklɪnɪkəl/","a":"LL-Q1860 (eng)-Vealhurl-clinical.wav","s":[{"p":"adjective","d":[{"m":"Clinical work or practice is related to the observation and treatment of patients.","e":"She is doing her clinical training at the hospital."},{"m":"Clinical trials or studies are used to test medical treatments in patients.","e":"The new drug is now in clinical trials."},{"m":"A clinical description or method is a very detailed and objective one, without emotion.","e":"His report was written in a clinical tone, focusing only on the facts."}]}]},"emergence":{"h":"emergence","i":"/ɪˈmɜːrdʒəns/","a":"LL-Q1860 (eng)-JutishMale-emergence.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Emergence is the process of coming into view or becoming important.","e":"The emergence of new technologies has changed the way we live."},{"m":"(uncountable) Emergence is the act of appearing, coming out, or becoming known, often suddenly.","e":"The emergence of the butterfly from its cocoon is a delicate process."},{"m":"(uncountable) Emergence is when complex properties or behaviours arise from simple parts interacting together.","e":"The emergence of life is studied as a complex interaction of chemistry and physics."}]}]},"emergences":{"h":"emergences","l":"emergence","q":"noun"},"ateliers":{"h":"ateliers","l":"atelier","q":"noun"},"arcane":{"h":"arcane","i":"/ɑrˈkeɪn/","a":"en-us-arcane.ogg","s":[{"p":"adjective","d":[{"m":"If something is arcane very few people know it or can understand it."}]}]},"all-night":{"h":"all-night","i":"/ˌɔlˈnaɪt/","a":"LL-Q1860 (eng)-Persent101-all-night.wav","s":[{"p":"adjective","d":[{"m":"An all-night party, drive, game, etc. is one that continues until the morning."},{"m":"An all-night diner, grocery, gas station, etc. is one that is open all night."}]}]},"aseptic":{"h":"aseptic","i":"/əˈsɛptɪk/","a":"LL-Q1860 (eng)-Vininn126-aseptic.wav","s":[{"p":"adjective","d":[{"m":"Aseptic packaging, conditions, rooms, etc. are free of microbes.","e":"The material was preserved in aseptic conditions."},{"m":"Aseptic techniques are ways of doing things that avoid introducing microbes.","e":"An aseptic injection technique was used to avoid infection."},{"m":"An aseptic situation, conversation, essay, etc. is impersonal and lacking emotion."}]}]},"abc":{"h":"ABC","i":"/eɪ biː ˈsiː/","a":"en-us-ABC.ogg","s":[{"p":"noun","d":[{"m":"(countable) The ABC are the letters of the alphabet"},{"m":"The ABC of something is the most basic thing you have to know about it"},{"m":"ABC can mean \"American Born Chinese\""}]}]},"abcs":{"h":"ABCs","l":"abc","q":"noun"},"apse":{"h":"apse","i":"/æps/","a":"LL-Q1860 (eng)-Vealhurl-apse.wav","s":[{"p":"noun","d":[{"m":"(countable) An apse is a round construction at the east end of a church"}]}]},"apses":{"h":"apses","l":"apse","q":"noun"},"rechristen":{"h":"rechristen","s":[{"p":"verb","d":[{"m":"(transitive) If you rechristen something, you christen or baptize it again."},{"m":"(transitive) If you rechristen something, you rename it."}]}]},"rechristens":{"h":"rechristens","l":"rechristen","q":"verb"},"rechristened":{"h":"rechristened","l":"rechristen","q":"verb"},"rechristening":{"h":"rechristening","l":"rechristen","q":"verb"},"christened":{"h":"christened","l":"christen","q":"verb"},"christens":{"h":"christens","l":"christen","q":"verb"},"christening":{"h":"christening","l":"christen","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A child's christening is a religious ceremony where it is given a name and welcomed into the Christian Church.","e":"The family gathered for the baby's christening at the church."},{"m":"(countable) A christening is a ceremony to name and launch a new ship or other important item.","e":"The christening of the new ship was attended by many people."}]}]},"kiosk":{"h":"kiosk","i":"/ˈkiːˌɒsk/","a":"en-us-kiosk.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kiosk is a small enclosed structure that is used as a booth to sell newspapers, cigarettes, etc."},{"m":"(countable) A kiosk is an unattended stand for the automatic of items."}]}]},"kiosks":{"h":"kiosks","l":"kiosk","q":"noun"},"avail":{"h":"avail","i":"/əˈveɪl/","a":"en-us-avail.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you avail yourself of something, you make use of it.","e":"She availed herself of the opportunity to learn a new skill."},{"m":"(intransitive) If something avails, it is useful or helpful.","e":"All their efforts did not avail against the storm."}]},{"p":"noun","d":[{"m":"(uncountable) If an action is to no avail, it doesn't help you achieve your goal.","e":"He tried to persuade her, but to no avail."}]}]},"avails":{"h":"avails","l":"avail","q":"verb"},"availing":{"h":"availing","l":"avail","q":"verb"},"availed":{"h":"availed","l":"avail","q":"verb"},"blindness":{"h":"blindness","i":"/ˈblaɪndnɪs/","a":"en-us-blindness.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Blindness is the condition of being unable to see.","e":"As his blindness progressed, he had to rely more on his other senses."},{"m":"(uncountable) Blindness is a lack of awareness or understanding.","e":"His blindness to the problem caused many issues."}]}]},"blindnesses":{"h":"blindnesses","l":"blindness","q":"noun"},"doubly":{"h":"doubly","i":"/ˈdʌbli/","a":"LL-Q1860 (eng)-Vealhurl-doubly.wav","s":[{"p":"adverb","d":[{"m":"If you are doubly responsible, careful, proud, etc., you are like that in two ways or for two reasons.","e":"She felt doubly responsible for the project because she was both the leader and the main designer."},{"m":"If you are doubly affected by something, you experience it with twice the usual strength of feeling.","e":"After the mistake, he felt doubly stressed because it caused problems at work and at home."}]}]},"legacy":{"h":"legacy","i":"/ˈlɛɡəsi/","a":"en-us-legacy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A legacy is something that is passed down from the past, often from an earlier generation.","e":"Her grandfather's legacy included both family traditions and a large estate."},{"m":"(countable) A legacy is the lasting impact or influence of someone or something.","e":"The scientist's greatest legacy is the discovery that changed the field of medicine."}]}]},"legacies":{"h":"legacies","l":"legacy","q":"noun"},"nostalgic":{"h":"nostalgic","i":"/nɒˈstældʒɪk/","a":"LL-Q1860 (eng)-Back ache-nostalgic.wav","s":[{"p":"adjective","d":[{"m":"If you feel nostalgic, you are remembering something from the past and wishing you could experience it again.","e":"Listening to old songs makes me feel nostalgic for my childhood."},{"m":"If something is nostalgic, it brings back memories of the past.","e":"The film had a nostalgic feel, reminding viewers of the 1980s."}]}]},"pitmaster":{"h":"pitmaster","s":[{"p":"noun","d":[{"m":"(countable) A pitmaster is someone who operates a barbecue pit and is skilled at barbecuing."}]}]},"pitmasters":{"h":"pitmasters","l":"pitmaster","q":"noun"},"manifestation":{"h":"manifestation","i":"/ˌmænɪfɛˈsteɪʃən/","a":"en-us-manifestation.ogg","s":[{"p":"noun","d":[{"m":"(countable) A manifestation is a sign that something like an idea, feeling, or situation exists.","e":"Her smile was a clear manifestation of her happiness."},{"m":"(countable) A manifestation is the act of something appearing or showing itself.","e":"The sudden storm was seen as a manifestation of nature's power."}]}]},"manifestations":{"h":"manifestations","l":"manifestation","q":"noun"},"opus":{"h":"opus","i":"/ˈoʊpəs/","a":"LL-Q1860 (eng)-Vealhurl-opus.wav","s":[{"p":"noun","d":[{"m":"(countable) An opus is a large and important work of art, especially a piece of music or literature.","e":"Beethoven's final symphony is considered his greatest opus."},{"m":"(countable) In music, an opus is a numbered composition to show the order in which the works were created.","e":"Chopin’s Opus 35 includes the famous Funeral March."}]}]},"opuses":{"h":"opuses","l":"opus","q":"noun"},"squalor":{"h":"squalor","i":"/ˈskwɒlə(r)/","a":"LL-Q1860 (eng)-Mélange a trois-squalor.wav","s":[{"p":"noun","d":[{"m":"(countable) Squalor is a lot of dirt or deterioration because of poverty or lack of care"}]}]},"squalors":{"h":"squalors","l":"squalor","q":"noun"},"amen":{"h":"amen","i":"/(ˌ)ɑːˈmɛn/","a":"LL-Q1860 (eng)-Vealhurl-amen.wav","s":[{"p":"interjection","d":[{"m":"You say amen at the end of a prayer to show agreement or express hope.","e":"We thank you for this food, God, amen."},{"m":"You say amen to show strong agreement with something.","e":"When she said we should help the poor, everyone said amen."}]}]},"flask":{"h":"flask","i":"/flɑːsk/","a":"en-us-flask.ogg","s":[{"p":"noun","d":[{"m":"(countable) A flask is a small, flat container used for carrying liquids, especially alcohol, in a pocket.","e":"He took a sip of whiskey from the silver flask in his coat."},{"m":"(countable) A flask is a container used in laboratories to hold, heat, or mix liquids.","e":"The scientist poured the solution into the flask to start the experiment."}]}]},"flasks":{"h":"flasks","l":"flask","q":"noun"},"keystone":{"h":"keystone","i":"/ˈkiːstoʊn/","s":[{"p":"noun","d":[{"m":"(countable) A keystone is the most important part of something, on which everything else depends.","e":"Trust is the keystone of any strong relationship."},{"m":"A keystone part is the most important or foundational part of a system or plan.","e":"Education is the keystone policy of the new government."},{"m":"(countable) A keystone is the central stone at the top of an arch that holds the other stones in place.","e":"The old bridge's arch was held up by a single keystone."}]}]},"keystones":{"h":"keystones","l":"keystone","q":"noun"},"limestone":{"h":"limestone","i":"/ˈlaɪmˌstoʊn/","a":"LL-Q1860 (eng)-Vealhurl-limestone.wav","s":[{"p":"noun","d":[{"m":"Limestone is a white or light grey rock that is used as a building material and in the making of cement."}]}]},"limestones":{"h":"limestones","l":"limestone","q":"noun"},"europa":{"h":"Europa","i":"/jʊˈroʊpə/","a":"en-Europa.ogg","s":[{"p":"proper noun","d":[{"m":"A moon orbiting Jupiter. It can have life."}]}]},"cooperation":{"h":"cooperation","i":"/kəʊˌɒp.ərˈeɪ.ʃən/","a":"LL-Q1860 (eng)-Berrely-cooperation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Cooperation is the act of working together to achieve a shared goal.","e":"The project suc