]}]},"grebes":{"h":"grebes","l":"grebe","q":"noun"},"cowgirls":{"h":"cowgirls","l":"cowgirl","q":"noun"},"goslings":{"h":"goslings","l":"gosling","q":"noun"},"leukemias":{"h":"leukemias","l":"leukemia","q":"noun"},"brimstone":{"h":"brimstone","s":[{"p":"adjective","d":[{"m":"If something or someone is brimstone, they are made up of or they look like brimstone; about or related to Hell."}]},{"p":"noun","d":[{"m":"Brimstone is sulphur."},{"m":"Brimstone is the sulphur of Hell."}]}]},"brimstones":{"h":"brimstones","l":"brimstone","q":"noun"},"amber":{"h":"amber","i":"/ˈam.bə/","a":"en-us-amber.ogg","s":[{"p":"noun","d":[{"m":"Amber is a color between yellow and brown."},{"m":"Amber is a fossil resin often used for jewellery."},{"m":"(uncountable) Amber is the middle light on traffic lights.","e":"The traffic lights are red, amber or green."}]},{"p":"adjective","d":[{"m":"If something is amber, it is the color amber."}]}]},"ambers":{"h":"ambers","l":"amber","q":"noun"},"beeswax":{"h":"beeswax","i":"/ˈbizwæks/","a":"en-us-beeswax.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Beeswax is a wax made by bees for their honeycombs.","e":"That bee is making beeswax."},{"m":"(uncountable) Beeswax is your personal business.","e":"This is none of your beeswax!"}]}]},"bump":{"h":"bump","i":"/bʌmp/","a":"en-au-bump.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bump is a small impact between two things.","e":"I felt a slight bump as the plane touched the landing strip."},{"m":"(countable) A bump is a sound that might be made when two things hit each other.","e":"I looked up when I heard the bump of a car as it drove into another one parked outside my house."},{"m":"(countable) A bump is a small lump or swelling on something that is smooth.","e":"Try to drive round the big bump in the road."},{"m":"(countable) A bump is a small lump or swelling on the skin or anywhere else on your body.","e":"I rubbed the small bump on my nose, and wondered if it was going to get any bigger."}]},{"p":"verb","d":[{"m":"(intransitive) If something bumps, it knocks gently against something else, usually making a small noise.","e":"I could hear the open door bumping in the breeze."},{"m":"(transitive) If you bump something, you knock it slightly.","e":"He bumped the chair as he walked past, so I put it back in place again."}]}]},"disobedient":{"h":"disobedient","i":"/dɪs.əˈbiː.dɪənt/","a":"LL-Q1860 (eng)-Vininn126-disobedient.wav","s":[{"p":"adjective","d":[{"m":"If someone is disobedient, they don't obey.","e":"The mother was angry at her disobedient child."}]}]},"bumps":{"h":"bumps","l":"bump","q":"verb"},"bumped":{"h":"bumped","l":"bump","q":"verb"},"bumping":{"h":"bumping","l":"bump","q":"verb"},"hairdresser":{"h":"hairdresser","i":"/heədrɛsə/","s":[{"p":"noun","d":[{"m":"(countable) A hairdresser is a person who cuts and styles the hair of other people."}]}]},"hairdressers":{"h":"hairdressers","l":"hairdresser","q":"noun"},"coprolite":{"h":"coprolite","i":"/ˈkɒprə(ʊ)lʌɪt/","s":[{"p":"noun","d":[{"m":"Coprolite is dung that has become a fossil over time."}]}]},"coprolites":{"h":"coprolites","l":"coprolite","q":"noun"},"accurately":{"h":"accurately","i":"/ˈæk.jə.rɪt.li/","a":"LL-Q1860 (eng)-Vealhurl-accurately.wav","s":[{"p":"adverb","d":[{"m":"If something is done accurately, it is done correctly or with accuracy; it is not wrong.","e":"The scientists accurately predicted the results of the experiment."}]}]},"adjustable":{"h":"adjustable","i":"/əˈd͡ʒʌstˈə.bl̩/","a":"LL-Q1860 (eng)-Vininn126-adjustable.wav","s":[{"p":"adjective","d":[{"m":"If something is adjustable, then it can be changed or moved.","e":"The length of this shower curtain rod is adjustable."}]}]},"disadvantage":{"h":"disadvantage","i":"/ˌdɪsədˈvɑːntɪdʒ/","a":"LL-Q1860 (eng)-Vealhurl-disadvantage.wav","s":[{"p":"noun","d":[{"m":"(countable) A disadvantage is something that is a handicap or a weakness.","e":"The hockey team had a disadvantage against its opponents because its goalie was not good."}]}]},"disadvantages":{"h":"disadvantages","l":"disadvantage","q":"noun"},"advisable":{"h":"advisable","i":"/ədˈvʌɪzəbl/","a":"LL-Q1860 (eng)-Vealhurl-advisable.wav","s":[{"p":"adjective","d":[{"m":"If something is advisable, then it is wise to do it, or it should be done."}]}]},"sicknesses":{"h":"sicknesses","l":"sickness","q":"noun"},"illness":{"h":"illness","i":"/ˈɪlˌnɛs/","a":"en-uk-illness.ogg","s":[{"p":"noun","d":[{"m":"An illness is a sickness or a disease."},{"m":"Illness is bad health.","e":"He died after a long illness."}]}]},"illnesses":{"h":"illnesses","l":"illness","q":"noun"},"sting":{"h":"sting","i":"/ˈstɪŋ/","a":"en-us-sting.ogg","s":[{"p":"noun","d":[{"m":"A sting is a pointed item at the rear of an insect, for defence.","e":"That wasp has a sting!"},{"m":"A sting can also mean a bite by an insect.","e":"I got a sting on my arm."},{"m":"(by extension) A sting is a bump on the skin, the result of being stung.","e":"I will show you where I was stung."},{"m":"(law enforcement) A sting is a police operation where they pretend to be criminals in order to catch a criminal."}]},{"p":"verb","d":[{"m":"To sting means to inject venom with a stinger.","e":"That bee stung me."},{"m":"(by extension) to sting means to hurt or bite.","e":"I banged my hand: it really stung."},{"m":"To swindle or con. (metaphor)","e":"I got stung for a lot of money."}]}]},"stings":{"h":"stings","l":"sting","q":"noun"},"stinging":{"h":"stinging","l":"sting","q":"verb"},"replica":{"h":"replica","i":"/ˈrɛplɪkə/","a":"LL-Q1860 (eng)-Vealhurl-replica.wav","s":[{"p":"noun","d":[{"m":"(countable) A replica is a close copy of something, usually of a famous or expensive item.","e":"I have a replica of an ancient coin."},{"m":"(countable) A replica is a scale model."}]}]},"replicas":{"h":"replicas","l":"replica","q":"noun"},"reducer":{"h":"reducer","s":[{"p":"noun","d":[{"m":"(countable) A reducer is something that reduces something else."}]}]},"reducers":{"h":"reducers","l":"reducer","q":"noun"},"restructure":{"h":"restructure","i":"/riːˈstrʌktʃə(r)/","a":"LL-Q1860 (eng)-Vealhurl-restructure.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you restructure something, you change the structure of it; you change the organization of it."}]}]},"restructures":{"h":"restructures","l":"restructure","q":"verb"},"restructured":{"h":"restructured","l":"restructure","q":"verb"},"restructuring":{"h":"restructuring","l":"restructure","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A restructuring is the changing of structure; it is a reorganization."}]}]},"restructurings":{"h":"restructurings","l":"restructuring","q":"noun"},"dribble":{"h":"dribble","i":"/ˈdrɪ.bəl/","a":"en-us-dribble.ogg","s":[{"p":"verb","d":[{"m":"If you dribble, you let saliva drip from your mouth; you drool."},{"m":"If something dribbles, it falls in drop or an uneven flow; it trickles."},{"m":"If you dribble a football/soccer ball, you run with it while controlling it with your feet."},{"m":"If you dribble a basketball, you bounce it up and down with one hand."}]}]},"rental":{"h":"rental","i":"/ˈrɛntəl/","s":[{"p":"noun","d":[{"m":"A rental is something that is rented.","e":"We moved into a rental unit when we lived in Europe."},{"m":"(uncountable) Rental is the money paid for rent.","e":"Parking spaces were set at an annual rental of $300."},{"m":"# (uncountable) Rental is the act of renting something.","e":"You need ID to do the rental."}]}]},"candy":{"h":"candy","i":"/ˈkændi/","a":"en-us-candy.ogg","s":[{"p":"noun","d":[{"m":"Candy is a sweet-tasting food.","e":"There is a bowl of candy on the table."}]},{"p":"verb","d":[{"m":"To candy a food is to cover it in or cook it in a sugary syrup.","e":"Will you help me candy these apples?"}]}]},"dribbles":{"h":"dribbles","l":"dribble","q":"verb"},"dribbled":{"h":"dribbled","l":"dribble","q":"verb"},"dribbling":{"h":"dribbling","l":"dribble","q":"verb"},"candies":{"h":"candies","l":"candy","q":"noun"},"louse":{"h":"louse","i":"/laʊs/","a":"LL-Q1860 (eng)-Back ache-louse.wav","s":[{"p":"noun","d":[{"m":"(countable) A louse is a small bug that lives in a person's hair.","e":"Fleas live on dogs and can jump, but lice can only crawl, not jump."}]}]},"hinge":{"h":"hinge","i":"/ˈhɪndʒ/","a":"en-us-hinge.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hinge is a small metal thing that holds a door to the wall and bends to let the door move.","e":"The door hinges made a squeaking noise as it opened."}]},{"p":"verb","d":[{"m":"If something hinges on something, it depends on it.","e":"My decision hinges on the results of the survey."},{"m":"If you hinge something, it means you put a hinge on it.","e":"The lid of the jewelry box was hinged with leather strips."}]}]},"nomad":{"h":"nomad","i":"/ˈnəʊmæd/","a":"LL-Q1860 (eng)-Vealhurl-nomad.wav","s":[{"p":"noun","d":[{"m":"(countable) A nomad is a person who moves from place to place and does not have a set home."},{"m":"(countable) A nomad is a wanderer."}]}]},"yo-yo":{"h":"yo-yo","i":"/ˈjəʊ.jəʊ/","a":"en-us-yo-yo.ogg","s":[{"p":"noun","d":[{"m":"(countable) A yo-yo is a toy that spins and goes up and down, hanging from a string.","e":"Let's go play with my yo-yo."}]}]},"tinfoil":{"h":"tinfoil","s":[{"p":"noun","d":[{"m":"(uncountable) Tinfoil is a piece of tin which is flat and thin like paper. Sometimes people say \"tinfoil\" when they really mean \"aluminium foil\", which is made of a different metal, aluminium, instead of tin."}]}]},"orgasm":{"h":"orgasm","i":"/ˈɔː.ɡæz.əm/","a":"LL-Q1860 (eng)-Vealhurl-orgasm.wav","s":[{"p":"noun","d":[{"m":"An orgasm is a strong pleasurable feeling that happens at the climax or peak of a sexual experience. Men usually ejaculate when they have an orgasm.","e":"Many women can have multiple orgasms during sex."}]},{"p":"verb","d":[{"m":"To have an orgasm.","e":"Sex was not very satisfying with my ex-boyfriend because he usually orgasmed after just a few minutes."}]}]},"yo-yos":{"h":"yo-yos","l":"yo-yo","q":"noun"},"nomads":{"h":"nomads","l":"nomad","q":"noun"},"lice":{"h":"lice","i":"/laɪs/","a":"LL-Q1860 (eng)-Vealhurl-lice.wav","l":"louse","q":"noun"},"hinges":{"h":"hinges","l":"hinge","q":"noun"},"hinged":{"h":"hinged","l":"hinge","q":"verb"},"hinging":{"h":"hinging","l":"hinge","q":"verb"},"catalysis":{"h":"catalysis","i":"/kəˈtæləsɪs/","s":[{"p":"noun","d":[{"m":"(countable) Catalysis is the process where a catalyst speeds a chemical reaction. The catalyst itself does undergo any change itself."}]}]},"entry":{"h":"entry","i":"/ˈɛntri/","a":"en-us-entry.ogg","s":[{"p":"noun","d":[{"m":"(countable) An entry is a way into a building.","e":"There is an entry in."},{"m":"(uncountable) An entry is also permission to enter something.","e":"An adult is needed for entry here."},{"m":"(countable) An entry is also information, like in an encyclopedia or dictionary.","e":"You are reading the entry for the word entry on the Simple English Wiktionary."},{"m":"(countable) An entry is also something entered in.","e":"We have submitted the entry for the contest."}]}]},"entries":{"h":"entries","l":"entry","q":"noun"},"catalyses":{"h":"catalyses","i":"/kəˈtæləˌsiz/","a":"LL-Q1860 (eng)-Vealhurl-catalyses (noun).wav","l":"catalysis","q":"noun"},"politeness":{"h":"politeness","i":"/pəˈlaɪtnəs/","a":"en-us-politeness.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Politeness is how polite you are to someone else.","e":"I expect a high level of politeness from people I do not know well."}]}]},"stang":{"h":"stang","l":"sting","q":"verb"},"stung":{"h":"stung","i":"/stʌŋ/","a":"En-us-stung.ogg","l":"sting","q":"verb"},"rentals":{"h":"rentals","l":"rental","q":"noun"},"orgasms":{"h":"orgasms","l":"orgasm","q":"noun"},"buzz":{"h":"buzz","i":"/bʌz/","a":"en-us-buzz.ogg","s":[{"p":"noun","d":[{"m":"(countable) A buzz is the sound of buzzing.","e":"I heard a buzz from the door."},{"m":"(countable) A buzz is the mixed sound of many people talking at the same time.","e":"I heard a buzz of conversation coming from the hall."}]},{"p":"verb","d":[{"m":"(intransitive) If something buzzes, it makes a sound like a bee flying.","e":"When the oven timer buzzes, you know the cake is ready."}]}]},"buzzes":{"h":"buzzes","l":"buzz","q":"noun"},"buzzed":{"h":"buzzed","l":"buzz","q":"verb"},"buzzing":{"h":"buzzing","l":"buzz","q":"verb","s":[{"p":"noun","d":[{"m":"Buzzing is a sound that is made by anything that buzzes.","e":"There is a buzzing coming from the radio. I think it will stop working soon."}]}]},"buzzer":{"h":"buzzer","i":"/ˈbʌzər/","s":[{"p":"noun","d":[{"m":"(countable) A buzzer is a machine that makes a buzzing sound when used.","e":"Press the buzzer if you need a person to help you."}]}]},"buzzers":{"h":"buzzers","l":"buzzer","q":"noun"},"kung-fu":{"h":"kung-fu","s":[{"p":"noun","d":[{"m":"(uncountable)"}]}]},"booth":{"h":"booth","i":"/buːð/","a":"LL-Q1860 (eng)-Vealhurl-booth.wav","s":[{"p":"noun","d":[{"m":"(countable) A small stall to sell items."},{"m":"(countable) An enclosure just big enough to hold one standing person.","e":"The man had to use the bathroom booth."}]}]},"booths":{"h":"booths","l":"booth","q":"noun"},"bust":{"h":"bust","i":"/ˈbʌst/","a":"en-us-bust.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bust sculpture of a person's head and shoulders","e":"The bust will break and shatter if it falls onto the floor."},{"m":"(uncountable) A woman's bust is her breasts.","e":"I like this shirt a lot, but it doesn't fit really well in the bust."}]},{"p":"verb","d":[{"m":"To bust is to burst or break something.","e":"My car is all busted up."}]}]},"busts":{"h":"busts","l":"bust","q":"noun"},"busted":{"h":"busted","i":"/ˈbʌstət/","a":"en-au-busted.ogg","l":"bust","q":"verb"},"busting":{"h":"busting","l":"bust","q":"verb"},"bypass":{"h":"bypass","i":"/ˈbaɪpæs/","a":"LL-Q1860 (eng)-Vealhurl-bypass.wav","s":[{"p":"noun","d":[{"m":"(countable) A bypass is a way to get around something, often used in medicine.","e":"He will need a heart bypass to survive."}]},{"p":"verb","d":[{"m":"To bypass is to go around an object in order to avoid it.","e":"The road was closed so we needed to bypass it with a side street."}]}]},"bypasses":{"h":"bypasses","l":"bypass","q":"noun"},"bypassed":{"h":"bypassed","l":"bypass","q":"verb"},"bypassing":{"h":"bypassing","l":"bypass","q":"verb"},"daft":{"h":"daft","i":"/dɑːft/","a":"en-au-daft.ogg","s":[{"p":"adjective","d":[{"m":"Something that is daft is silly or stupid.","e":"Poking holes in our boat was a daft idea."}]}]},"dafter":{"h":"dafter","l":"daft","q":"adjective"},"daftest":{"h":"daftest","l":"daft","q":"adjective"},"damp":{"h":"damp","i":"/dæmp/","a":"en-us-damp.ogg","s":[{"p":"adjective","d":[{"m":"If something is damp it is somewhat wet.","e":"The grass was damp with dew this morning."}]},{"p":"verb","d":[{"m":"(transitive) If you damp something, you make it moderately wet."},{"m":"(transitive) If you damp something, you suppress vibrations (mechanical) or oscillations (electrical) by converting such energy to other forms of energy."}]}]},"damper":{"h":"damper","i":"/ˈdæmpɚ/","a":"EN-AU ck1 damper.ogg","l":"damp","q":"adjective","s":[{"p":"noun","d":[{"m":"made from flour, water, milk and salt, but without yeast."}]}]},"dampest":{"h":"dampest","l":"damp","q":"adjective"},"dude":{"h":"dude","i":"/duːd/","a":"en-us-dude.ogg","s":[{"p":"noun","d":[{"m":"(countable) A dude is a male person."}]}]},"saltine":{"h":"saltine","s":[{"p":"noun","d":[{"m":"A saltine is a kind of cracker."}]}]},"dudes":{"h":"dudes","l":"dude","q":"noun"},"saltines":{"h":"saltines","l":"saltine","q":"noun"},"cotyliform":{"h":"cotyliform","s":[{"p":"adjective","d":[{"m":"If a plant is cotyliform, it has the form of a cup (cotyle)"}]}]},"gasiform":{"h":"gasiform","s":[{"p":"adjective","d":[{"m":"If something is gasiform, it is made up of gas; it is gaseous."}]}]},"gaseous":{"h":"gaseous","i":"/ˈɡæʃəs/","a":"LL-Q1860 (eng)-Vealhurl-gaseous.wav","s":[{"p":"adjective","d":[{"m":"If something is gaseous, it is related to or made up of a gas."},{"m":"If a liquid is gaseous, it has a lot of bubbles in it; it is gassy.","e":"My soda is too gaseous to drink."}]}]},"gaseousness":{"h":"gaseousness","s":[{"p":"noun","d":[{"m":"(uncountable) Gaseousness is the state of being gaseous."}]}]},"refreshment":{"h":"refreshment","i":"/rɪˈfreʃ.mənt/","a":"LL-Q1860 (eng)-Vininn126-refreshment.wav","s":[{"p":"noun","d":[{"m":"(countable) A refreshment is a small snack or new drink that does not have alcohol in it.","e":"What kind of refreshments should we have available at our party?"},{"m":"(uncountable) Refreshment is a way for someone to get back energy or strength that they have lost in the past."}]}]},"refreshments":{"h":"refreshments","l":"refreshment","q":"noun"},"consideration":{"h":"consideration","i":"/kənˌsɪdəˈreɪʃən/","a":"en-us-consideration.ogg","s":[{"p":"noun","d":[{"m":"Consideration is the process of thinking carefully about something.","e":"After much consideration, I think I will retire."},{"m":"Consideration can also be a thoughtful and caring attitude towards others.","e":"Show some consideration and stop waking up your little brother with all that noise."}]}]},"considerations":{"h":"considerations","a":"en-us-considerations.ogg","l":"consideration","q":"noun"},"gaseously":{"h":"gaseously","s":[{"p":"adverb","d":[{"m":"If something is done gaseously, it is done in a gaseous manner."}]}]},"xenon":{"h":"xenon","i":"/ˈziːnɒn/","a":"en-us-xenon.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Xenon is an element with atomic number 54.","e":"Xenon is rare and expensive to extract from the Earth's atmosphere."}]}]},"balloon":{"h":"balloon","i":"/bəˈluːn/","a":"en-us-balloon.ogg","s":[{"p":"noun","d":[{"m":"(countable) A balloon is a light round ball filled with air that floats; often a child's toy.","e":"My balloon floated away into the sky."}]},{"p":"verb","d":[{"m":"(intransitive) If something balloons, that means it grows very fast.","e":"The price of oil has ballooned."}]}]},"balloons":{"h":"balloons","l":"balloon","q":"noun"},"ballooned":{"h":"ballooned","l":"balloon","q":"verb"},"ballooning":{"h":"ballooning","l":"balloon","q":"verb"},"radon":{"h":"radon","i":"/ˈreɪdɒn/","a":"LL-Q1860 (eng)-Vealhurl-radon.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Radon is a radioactive element with atomic number 86.","e":"Radon is a tasteless, colorless and odorless gas."}]}]},"osmium":{"h":"osmium","i":"/ˈɒz.mi.əm/","a":"LL-Q1860 (eng)-Vealhurl-osmium.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Osmium is a metal and element with the atomic number 76 and the symbol Os.","e":"Osmium is twice as dense as lead."}]}]},"buzzings":{"h":"buzzings","l":"buzzing","q":"noun"},"arbitrarily":{"h":"arbitrarily","i":"/ˈɑː.bɪ.trə.riliː/","a":"en-us-arbitrarily.ogg","s":[{"p":"adverb","d":[{"m":"To do something arbitrarily is to do something randomly, or without.","e":"Without thinking he arbitrarily chose the number zero."}]}]},"bunch":{"h":"bunch","i":"/bʌntʃ/","a":"en-us-bunch.ogg","s":[{"p":"noun","d":[{"m":"If you have a bunch of something, you have many of them.","e":"We had to try a bunch of times before we could start the car."},{"m":"A bunch can also mean a group or cluster.","e":"Grapes come in bunches."}]},{"p":"verb","d":[{"m":"(transitive) To bunch things is to gather or collect them into a group.","e":"Help me bunch these flowers together so I can make a bouquet."}]}]},"bunched":{"h":"bunched","l":"bunch","q":"verb"},"bunching":{"h":"bunching","l":"bunch","q":"verb"},"bunches":{"h":"bunches","l":"bunch","q":"noun"},"formulate":{"h":"formulate","i":"/ˈfɔː(r)mjʊleɪt/","a":"LL-Q1860 (eng)-Vininn126-formulate.wav","s":[{"p":"verb","d":[{"m":"To formulate is to create something.","e":"This shampoo has been formulated specially for people with lice."},{"m":"To formulate is also to express a problem in math.","e":"I am formulating a formula to solve this word problem."}]}]},"heroin":{"h":"heroin","i":"/ˈhɛroʊ.ɪn/","a":"en-us-heroin.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Heroin is very strong and addictive narcotic drug; it is made from opium.","e":"The man injected heroin into his arm and immediately began to feel better."}]}]},"formulating":{"h":"formulating","l":"formulate","q":"verb"},"formulates":{"h":"formulates","l":"formulate","q":"verb"},"formulated":{"h":"formulated","l":"formulate","q":"verb"},"attic":{"h":"attic","i":"/ˈætɪk/","a":"LL-Q1860 (eng)-Vealhurl-attic.wav","s":[{"p":"noun","d":[{"m":"(countable) An attic is the space just below the roof of a house. It may be used to store items or is sometimes big enough to live in.","e":"I have a bunch of old clothes and toys stored in the attic that I would like to get rid of."}]}]},"muffin":{"h":"muffin","i":"/ˈmʌfɪn/","a":"en-us-muffin.ogg","s":[{"p":"noun","d":[{"m":"(countable) A muffin is like a small cake that has some kind of fruit, nut, chocolate or other kind of flavoring baked in it.","e":"I do not like cake so I probably won't like muffins."},{"m":"(countable) (UK) A muffin is a round, flat bread that is usually cut in half horizontally, toasted and covered with some kind of spread; an English muffin."}]}]},"attics":{"h":"attics","l":"attic","q":"noun"},"muffins":{"h":"muffins","l":"muffin","q":"noun"},"deed":{"h":"deed","i":"/diːd/","a":"en-us-deed.ogg","s":[{"p":"noun","d":[{"m":"(countable) A deed is an action that is done; sometimes it is brave and important","e":"The man had done a good deed by saving that child."},{"m":"(countable) In legal work, a deed is an agreement or contract; often on paper","e":"Don't forget to sign the deed or else it won't be valid."}]}]},"deeds":{"h":"deeds","a":"en-us-deeds.ogg","l":"deed","q":"noun"},"deduct":{"h":"deduct","i":"/dɪˈdʌkt/","a":"LL-Q1860 (eng)-Vealhurl-deduct.wav","s":[{"p":"verb","d":[{"m":"To deduct is to take one thing away from another; to make smaller; often dealing with money.","e":"I would have a lot more money if it wasn't deducted by taxes and bills."}]}]},"deducts":{"h":"deducts","l":"deduct","q":"verb"},"deducted":{"h":"deducted","l":"deduct","q":"verb"},"deducting":{"h":"deducting","l":"deduct","q":"verb"},"dash":{"h":"dash","i":"/dæʃ/","a":"en-us-dash.ogg","s":[{"p":"noun","d":[{"m":"On a computer keyboard, a dash is a horizontal bar that looks like \"-\" or \"—\".","e":"There are many different types of dashes that you can type on a keyboard."},{"m":"A dash can mean a short run.","e":"I got last place in the 100-meter dash because I tripped on a rock."},{"m":"A dash is sometimes short for a dashboard.","e":"Someone dropped a brick through the car's windshield and onto the dash."},{"m":"A dash is a very small amount in cooking.","e":"Put a dash of salt in the soup."}]},{"p":"verb","d":[{"m":"(intransitive) To dash is to run fast for a short distance","e":"When he heard there was ice cream he dashed off towards it."},{"m":"(transitive) If your hopes, dreams, or expectations were ruined, disappointed, or destroyed, they were dashed.","e":"Her hopes for a beautiful wedding day were dashed when dark clouds gathered in the sky."},{"m":"(transitive) To dash can be to sprinkle or spray.","e":"She dashed her soup with too much pepper."}]}]},"dashes":{"h":"dashes","l":"dash","q":"noun"},"dashed":{"h":"dashed","l":"dash","q":"verb"},"dashing":{"h":"dashing","l":"dash","q":"verb"},"dashboard":{"h":"dashboard","i":"/ˈdæʃˌbɔː(r)d/","a":"LL-Q1860 (eng)-Vealhurl-dashboard.wav","s":[{"p":"noun","d":[{"m":"An item to protect a driver from debris, mud and water.","e":"All cars have a dashboard."},{"m":"A panel telling someone about the car and warnings.","e":"The dashboard says I have very little gas, although I have plenty of gas."}]}]},"dashboards":{"h":"dashboards","l":"dashboard","q":"noun"},"breed":{"h":"breed","i":"/briːd/","a":"en-us-breed.ogg","s":[{"p":"noun","d":[{"m":"(countable) A breed can be a type of animal or plant; a species or race.","e":"This breed of dog likes to bark more than most."}]},{"p":"verb","d":[{"m":"To breed is to mate and produce offspring (children).","e":"If a donkey breeds with a horse, then the offspring will be a mix between the two: a mule."},{"m":"When something breeds, it is created or resulted in.","e":"Icy roads breed car crashes."}]}]},"breeds":{"h":"breeds","i":"/briːdz/","l":"breed","q":"noun"},"breeded":{"h":"breeded","l":"breed","q":"verb"},"breeding":{"h":"breeding","i":"/ˈbriːdɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-breeding.wav","l":"breed","q":"verb"},"dubai":{"h":"Dubai","i":"/duːˈbaɪ/","a":"LL-Q1860 (eng)-Vealhurl-Dubai.wav","s":[{"p":"proper noun","d":[{"m":"Dubai is a city and one of the seven emirates (states) of the United Arab Emirates.","e":"Dubai became a wealthy place because of the oil industry."}]}]},"kuwait":{"h":"Kuwait","i":"/kjuːˈweɪt/","a":"en-us-Kuwait.ogg","s":[{"p":"proper noun","d":[{"m":"Kuwait is a country in West Asia. Its capital is Kuwait City.","e":"Kuwait can be reached by the sea because it borders the Persian Gulf."}]}]},"mafia":{"h":"Mafia","i":"/ˈmɑfi.ə/","a":"LL-Q1860 (eng)-Vealhurl-mafia.wav","s":[{"p":"proper noun","d":[{"m":"The Mafia is an organized group of criminals.","e":"The Mafia forced me to work for them for no pay."}]}]},"mitt":{"h":"Mitt","s":[{"p":"proper noun","d":[{"m":"Mitt is a given name for a man.","e":"The boy who helped us was named Mitt."}]}]},"junkyard":{"h":"junkyard","s":[{"p":"noun","d":[{"m":"A junkyard is a place where trash and waste are stored.","e":"We went to the junkyard to through away our garbage."},{"m":"A junkyard can also be a business that sells used scrap metal and other items.","e":"The junkyard is a good place to find an old car part."}]}]},"junkyards":{"h":"junkyards","l":"junkyard","q":"noun"},"stab":{"h":"stab","i":"/stæb/","a":"en-us-stab.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stab is an act of thrusting or poking with an object to cause harm to someone.","e":"He made a stab at me; he tried to kill me."}]},{"p":"verb","d":[{"m":"(transitive) To stab someone is to harm them by or.","e":"He stabbed the man in the back with a knife."}]}]},"stabs":{"h":"stabs","a":"en-us-stabs.ogg","l":"stab","q":"noun"},"stabbed":{"h":"stabbed","i":"/stæbd/","a":"en-us-stabbed.ogg","l":"stab","q":"verb"},"stabbing":{"h":"stabbing","a":"en-us-stabbing.ogg","l":"stab","q":"verb"},"derby":{"h":"derby","i":"/ˈdɑː(r).bi/","a":"LL-Q1860 (eng)-Vealhurl-derby.wav","s":[{"p":"noun","d":[{"m":"(countable) A derby is a race, often with horses, around a track.","e":"Before the derby, people make bets on which horse will win."}]}]},"derbies":{"h":"derbies","l":"derby","q":"noun"},"canteen":{"h":"canteen","i":"/ˈkæntɪin/","a":"LL-Q1860 (eng)-Vealhurl-canteen.wav","s":[{"p":"noun","d":[{"m":"(countable) A canteen is a bottle for staring water or other fluids.","e":"There was a hole in my canteen so now I am out of water."},{"m":"(countable) A canteen is a restaurant or cafeteria for students or soldiers.","e":"Let's go grab a bite to eat at the canteen."}]}]},"canteens":{"h":"canteens","l":"canteen","q":"noun"},"mars":{"h":"Mars","i":"/ˈmɑːz/","a":"en-us-mars.ogg","s":[{"p":"proper noun","d":[{"m":"Mars is known as the in our solar system.","e":"Mars is the fourth planet from the Sun."},{"m":"In Roman mythology, Mars is the god of war. He is known as Ares in Greek mythology."}]}]},"mar":{"h":"mar","i":"/mɑː(r)/","a":"LL-Q1860 (eng)-Vealhurl-mar.wav","s":[{"p":"verb","d":[{"m":"If something is marred, it is spoiled, hurt, or damaged.","e":"Smashing a hammer onto a car will mar it."}]}]},"marred":{"h":"marred","l":"mar","q":"verb"},"marring":{"h":"marring","l":"mar","q":"verb"},"hop":{"h":"hop","i":"/hɒp/","a":"en-au-hop.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hop is a small jump.","e":"Make a hop over the fence and a skip over the brook."}]},{"p":"verb","d":[{"m":"(intransitive) If you hop, that means you make a small jump; often on one foot.","e":"It's good exercise to hop on one foot."},{"m":"(transitive) To hop is to suddenly get on a bus, boat, train, or plane.","e":"I hopped on a train just in time."}]}]},"hops":{"h":"hops","l":"hop","q":"noun"},"hopped":{"h":"hopped","l":"hop","q":"verb"},"hopping":{"h":"hopping","a":"En-us-hopping.ogg","l":"hop","q":"verb"},"manually":{"h":"manually","i":"/ˈmæn.j(ʊ)əli/","a":"LL-Q1860 (eng)-Vealhurl-manually.wav","s":[{"p":"adverb","d":[{"m":"To do something manually is to do something by hand.","e":"He needed to buy some tools because he wanted to put the bike together manually."}]}]},"uranus":{"h":"Uranus","i":"/ˈjʊrənəs/","a":"en-us-Uranus.ogg","s":[{"p":"proper noun","d":[{"m":"Uranus is the seventh planet from the Sun in the Solar System.","e":"The rings of Uranus are tilted."},{"m":"In Greek mythology, Uranus is the god of the sky."}]}]},"neptune":{"h":"Neptune","i":"/ˈnɛptjuːn/","a":"en-us-Neptune.ogg","s":[{"p":"proper noun","d":[{"m":"Neptune is the eighth and farthest planet from the Sun in the Solar System.","e":"You will need a telescope to see Neptune because it is too far away."},{"m":"In Roman mythology, Neptune is the god of the sea."}]}]},"venus":{"h":"Venus","i":"/ˈvē-nəs/","a":"en-us-Venus.ogg","s":[{"p":"proper noun","d":[{"m":"Venus is the planet that is second closest to the Sun in the Solar System.","e":"Venus is a hot planet because it is very close to the Sun."},{"m":"Venus is the goddess of love and beauty."}]}]},"pluto":{"h":"Pluto","i":"/ˈpluːtəʊ/","a":"en-us-Pluto.ogg","s":[{"p":"proper noun","d":[{"m":"Pluto is the second largest dwarf planet and the largest Kuiper belt object in the Solar System."}]}]},"blast":{"h":"blast","i":"/blɑːst/","a":"LL-Q1860 (eng)-Vealhurl-blast.wav","s":[{"p":"noun","d":[{"m":"(countable) A blast is when something blows up or explodes.","e":"The blast shook the building."}]},{"p":"verb","d":[{"m":"(intransitive) To blast is to make a loud noise.","e":"His car radio blasted music. The whole neighborhood could hear it."},{"m":"(transitive) To blast can also be to explode or to blow a hole through something.","e":"Blast a hole through that wall so we can escape the prison."}]}]},"clap":{"h":"clap","i":"/klæp/","a":"en-us-ncalif-theclap.ogg","s":[{"p":"noun","d":[{"m":"(countable) A clap is the act of hitting the palms of your hands together to make a noise.","e":"She made a clap with her hands to get the man's attention."},{"m":"(countable) A clap can be any load sound made by two things hitting each other.","e":"There was a loud clap when she closed the book."}]},{"p":"verb","d":[{"m":"To clap is to make a noise by hitting the palms of your hands together.","e":"The crowd clapped when the baseball team won the game."}]}]},"claps":{"h":"claps","l":"clap","q":"noun"},"clapped":{"h":"clapped","l":"clap","q":"verb"},"clapping":{"h":"clapping","l":"clap","q":"verb"},"korean":{"h":"Korean","i":"/kəˈrɪən/","a":"en-us-Korean.ogg","s":[{"p":"adjective","d":[{"m":"If something is Korean, it is from or related to Korea (South Korea, North Korea, or both).","e":"Tayo the Little Bus is a great Korean cartoon."}]},{"p":"proper noun","d":[{"m":"(countable) A Korean is a person from Korea (South Korea or North Korea).","e":"The class had five Koreans, two Japanese, a Brazilian, and people from a number of other countries."},{"m":"(uncountable) Korean is the main language of South Korea and North Korea.","e":"The tourist could only speak in Korean so they had to employ someone to interpret English."}]}]},"blasts":{"h":"blasts","l":"blast","q":"verb"},"blasted":{"h":"blasted","i":"/ˈblɑː.stɪd/","a":"en-us-blasted.ogg","l":"blast","q":"verb"},"blasting":{"h":"blasting","l":"blast","q":"verb"},"koreans":{"h":"Koreans","l":"korean","q":"proper noun"},"glue":{"h":"glue","i":"/ɡluː/","a":"en-us-glue.ogg","s":[{"p":"noun","d":[{"m":"Glue is a liquid that pastes items together.","e":"Can I have some glue to stick my pictures to the paper?"}]},{"p":"verb","d":[{"m":"To glue means to paste something together.","e":"Your statue broke but I glued it back together."}]}]},"gluing":{"h":"gluing","l":"glue","q":"verb"},"glues":{"h":"glues","l":"glue","q":"verb"},"glued":{"h":"glued","l":"glue","q":"verb"},"vat":{"h":"vat","i":"/væt/","a":"en-us-vat.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vat is a very large tub or bowl.","e":"Sometimes a vat is used to make wine and other drinks."}]}]},"vats":{"h":"vats","l":"vat","q":"noun"},"mentor":{"h":"mentor","i":"/ˈmɛn.tɔː/","a":"LL-Q1860 (eng)-Vealhurl-mentor.wav","s":[{"p":"noun","d":[{"m":"(countable) A mentor is a wise and trusted guide and adviser.","e":"Some students use a mentor to help them through their first year of college."}]},{"p":"verb","d":[{"m":"To mentor is to guide someone, like a teacher.","e":"You have never fished before? I will mentor you on how to do it."}]}]},"perch":{"h":"perch","i":"/pɜːtʃ/","a":"en-us-perch.ogg","s":[{"p":"noun","d":[{"m":"(countable) A perch is a type of freshwater fish.","e":"Look at that perch jumping out of the water."}]},{"p":"verb","d":[{"m":"To perch on something is to rest or stand on it.","e":"The bird perched on the tree for hours."}]}]},"miniature":{"h":"miniature","i":"/ˈmɪnɪt͡ʃə/","a":"LL-Q1860 (eng)-Vealhurl-miniature.wav","s":[{"p":"adjective","d":[{"m":"When something is miniature, it is very small.","e":"This small toy is a miniature dump truck."}]}]},"perches":{"h":"perches","l":"perch","q":"noun"},"perched":{"h":"perched","l":"perch","q":"verb"},"perching":{"h":"perching","l":"perch","q":"verb"},"mentors":{"h":"mentors","l":"mentor","q":"noun"},"mentored":{"h":"mentored","l":"mentor","q":"verb"},"mentoring":{"h":"mentoring","l":"mentor","q":"verb"},"verbal":{"h":"verbal","i":"/ˈvɜr.bəl/","a":"en-us-verbal.ogg","s":[{"p":"adjective","d":[{"m":"Something that is verbal is something that has to do with words.","e":"He did not just nod his head that he wanted to leave, he told me so in a verbal way."}]}]},"grudge":{"h":"grudge","a":"En-us-grudge.ogg","s":[{"p":"noun","d":[{"m":"(countable) A grudge is a feeling of ill will or hatred that doesn't go away.","e":"He stole my bike last year. I still have a grudge against him."}]},{"p":"verb","d":[{"m":"(transitive) If you grudge something you are unwilling to give or allow it.","e":"We were poor, so my mom grudged every piece of food I ate."}]}]},"grudges":{"h":"grudges","l":"grudge","q":"noun"},"grudged":{"h":"grudged","l":"grudge","q":"verb"},"grudging":{"h":"grudging","l":"grudge","q":"verb"},"urge":{"h":"urge","i":"/ɜːd͡ʒ/","a":"en-us-urge.ogg","s":[{"p":"noun","d":[{"m":"(countable) An urge is a want to do something.","e":"After watching the basketball game, he had an urge to play too."}]},{"p":"verb","d":[{"m":"(transitive) To urge something is to press or push it forward.","e":"He urged me to go play basketball with him."}]}]},"urges":{"h":"urges","l":"urge","q":"noun"},"urged":{"h":"urged","a":"En-us-urged.ogg","l":"urge","q":"verb"},"urging":{"h":"urging","a":"En-us-urging.ogg","l":"urge","q":"verb"},"cable":{"h":"cable","i":"/keɪbl/","a":"en-us-cable.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cable is a strong wire or rope that is often made out of metal.","e":"A strong cable held the two trees together."},{"m":"(countable) A cable can also be a cord that allows information to pass through.","e":"My internet wasn't working because a cable was unplugged."},{"m":"(uncountable) Sometimes cable is short for cable television.","e":"Do you have cable or satellite television?"}]},{"p":"verb","d":[{"m":"To cable something, you use strong wires to attach two things together.","e":"Cable the boats together so that they don't float away."}]}]},"cables":{"h":"cables","l":"cable","q":"noun"},"cabled":{"h":"cabled","l":"cable","q":"verb"},"cabling":{"h":"cabling","l":"cable","q":"verb"},"dormitory":{"h":"dormitory","i":"/ˈdɔrmɪˌtɔri/","a":"LL-Q1860 (eng)-Vealhurl-dormitory.wav","s":[{"p":"noun","d":[{"m":"(countable) A dormitory is a building where students or soldiers often live.","e":"I lived in a dormitory when I first went to college."},{"m":"(countable) A dormitory can also be a room that contains beds and is mostly used for sleeping.","e":"Let's get back to the dormitory and get some rest."}]}]},"dormitories":{"h":"dormitories","l":"dormitory","q":"noun"},"dorm":{"h":"dorm","i":"/dɔːm/","a":"LL-Q1860 (eng)-Vealhurl-dorm.wav","s":[{"p":"noun","d":[{"m":"(countable) A dorm is short for a dormitory, a place where students and soldiers often live and sleep.","e":"I lived in a dorm during my first year of college."}]}]},"dorms":{"h":"dorms","l":"dorm","q":"noun"},"canal":{"h":"canal","i":"/kəˈnæl/","a":"en-uk-canal.ogg","s":[{"p":"noun","d":[{"m":"A canal is a waterway (similar to a river) that is made by humans so that boats can travel it.","e":"Before the canal was made there was no way to travel between the two lakes."}]},{"p":"verb","d":[{"m":"To canal is to build a man-made waterway.","e":"Let's canal through this mountain so we can connect the lakes by water."}]}]},"canaling":{"h":"canaling","l":"canal","q":"verb"},"canaled":{"h":"canaled","l":"canal","q":"verb"},"canals":{"h":"canals","a":"en-us-canals.ogg","l":"canal","q":"noun"},"canalled":{"h":"canalled","l":"canal","q":"verb"},"canalling":{"h":"canalling","l":"canal","q":"verb"},"carol":{"h":"carol","i":"/ˈkærəl/","a":"en-au-carol.ogg","s":[{"p":"noun","d":[{"m":"(countable) A carol is a song of happiness and joy.","e":"Let's go door to door and sing Christmas carols."}]},{"p":"verb","d":[{"m":"To carol is to sing in a joyful or happy way.","e":"Let's go and carol all of the people at the nursing home."}]}]},"carols":{"h":"carols","l":"carol","q":"noun"},"carolled":{"h":"carolled","l":"carol","q":"verb"},"carolling":{"h":"carolling","l":"carol","q":"verb"},"caroled":{"h":"caroled","l":"carol","q":"verb"},"caroling":{"h":"caroling","l":"carol","q":"verb"},"distinguish":{"h":"distinguish","i":"/dɪˈstɪŋ.ɡwɪʃ/","a":"en-us-distinguish.ogg","s":[{"p":"verb","d":[{"m":"When you distinguish something, you are trying to make it easy to sort the item out.","e":"I can't distinguish Jan from Jane because their names are so alike."}]}]},"distinguishes":{"h":"distinguishes","l":"distinguish","q":"verb"},"distinguished":{"h":"distinguished","i":"/dɪsˈtɪŋɡwɪʃt/","a":"en-us-distinguished.ogg","l":"distinguish","q":"verb","s":[{"p":"adjective","d":[{"m":"Distinguished means superior to others in importance or rank.","e":"Professor Charm is the most distinguished teacher I know."}]}]},"distinguishing":{"h":"distinguishing","l":"distinguish","q":"verb"},"cassette":{"h":"cassette","a":"LL-Q1860 (eng)-Vealhurl-cassette.wav","s":[{"p":"noun","d":[{"m":"A cassette is a small flat case that holds the tape that records sounds and pictures.","e":"The cassette was broken. None of the movie we filmed was recorded."},{"m":"(photography) In a camera, the cassette is the lightproof container that holds the film.","e":"If you open up the cassette in the daylight you will ruin the film."}]}]},"cassettes":{"h":"cassettes","l":"cassette","q":"noun"},"castle":{"h":"castle","i":"/ˈkɑːs(ə)l/","a":"en-us-castle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A castle is a large, strong building used to protect the people inside.","e":"In the Middle Ages, castles were used to protect the king and queen."},{"m":"(countable) In chess, the castle is another name for the rook."}]},{"p":"verb","d":[{"m":"(intransitive) In chess, to castle is to take a turn that involves both the rook and the king moving at once.","e":"I was going to win if he hadn't decided to castle."}]}]},"castles":{"h":"castles","l":"castle","q":"noun"},"castled":{"h":"castled","l":"castle","q":"verb"},"castling":{"h":"castling","l":"castle","q":"verb"},"casual":{"h":"casual","i":"/ˈkaʒuəl/","a":"EN-AU ck1 casual.ogg","s":[{"p":"adjective","d":[{"m":"Something that is casual is relaxed and not formal. It's the way we act when we're with friends and family.","e":"Wear casual clothes to this party."},{"m":"If something happens in a casual way it means it happens by chance.","e":"There were only casual meetings – nothing that was planned."}]}]},"ballroom":{"h":"ballroom","i":"/ˈbɔːlruːm/","a":"LL-Q1860 (eng)-Vealhurl-ballroom.wav","s":[{"p":"noun","d":[{"m":"(countable) A ballroom is a large room used for dancing.","e":"The people went to the ballroom and waited for the dancing to begin."},{"m":"A ballroom dance is a type of dance done in pairs.","e":"The ballroom dances included a waltz and a Foxtrot."}]}]},"waltz":{"h":"waltz","i":"/wɔːlts/","a":"LL-Q1860 (eng)-Vealhurl-waltz.wav","s":[{"p":"noun","d":[{"m":"A waltz is a dance in 3/4 time.","e":"The last dance at the party was the waltz."},{"m":"A waltz is music in 3/4 time written for this dance."}]},{"p":"verb","d":[{"m":"If you waltz with someone, you dance [[#Noun|waltz]] with them."},{"m":"If you waltz, you move briskly in an inappropriate casual manner."}]}]},"foxtrot":{"h":"foxtrot","i":"/ˈfɒkstrɒt/","a":"LL-Q1860 (eng)-Vealhurl-foxtrot.wav","s":[{"p":"noun","d":[{"m":"The Foxtrot is a ballroom dance.","e":"He learned the Foxtrot rhythm of \"slow, slow, quick, quick\"."}]}]},"lamb":{"h":"lamb","i":"/læm/","a":"En-us-lamb.ogg","s":[{"p":"noun","d":[{"m":"A lamb is a baby sheep.","e":"The small lamb was standing in the field."},{"m":"Lamb is also the meat from a baby sheep.","e":"She ate roast lamb with potatoes."}]}]},"swan":{"h":"swan","i":"/swɒn/","a":"en-us-swan.ogg","s":[{"p":"noun","d":[{"m":"(countable) A swan is a waterbird with a long neck. They are usually white, but in Australia they are black.","e":"The swan used its long neck to find food on the bottom of the lake"}]}]},"photo":{"h":"photo","i":"/ˈfəʊ.təʊ/","a":"en-uk-photo.ogg","s":[{"p":"noun","d":[{"m":"(countable) A photo is a picture created by a camera digitally or on film.","e":"I took a photo of that beautiful old building."}]},{"p":"verb","d":[{"m":"(transitive) To photo something is to take a picture of it.","e":"Photo me in front of the lake so we can remember it forever"}]}]},"photos":{"h":"photos","l":"photo","q":"noun"},"ballrooms":{"h":"ballrooms","l":"ballroom","q":"noun"},"waltzes":{"h":"waltzes","l":"waltz","q":"noun"},"foxtrots":{"h":"foxtrots","l":"foxtrot","q":"noun"},"lambs":{"h":"lambs","l":"lamb","q":"noun"},"swans":{"h":"swans","l":"swan","q":"noun"},"photoed":{"h":"photoed","l":"photo","q":"verb"},"photoing":{"h":"photoing","l":"photo","q":"verb"},"rugby":{"h":"rugby","i":"/ˈrʌɡbi/","a":"en-us-rugby.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Rugby is a football game played with an oval shaped ball. Players can hold or kick the ball.","e":"He was picked to play rugby in the school team."}]}]},"tennis":{"h":"tennis","s":[{"p":"noun","d":[{"m":"Tennis is a sport where players use a racquet to hit a ball over a net. It can be played by two or four people.","e":"The four girls spent the afternoon playing tennis."}]}]},"underwear":{"h":"underwear","i":"/ˈʌndɚwɛr/","a":"en-us-underwear.ogg","s":[{"p":"noun","d":[{"m":"Underwear is a piece of clothing that you wear under your clothes next to your skin.","e":"I got out of the shower, dried myself, and put on some underwear."}]}]},"helicopter":{"h":"helicopter","i":"/ˈheliˌkɔptə(r)/","a":"en-au-helicopter.ogg","s":[{"p":"noun","d":[{"m":"(countable) A helicopter is a type of aircraft. It does not have wings, but has two or more long blades which rotate. It is able to move in any direction, forward or back, up or down, or stay in one place.","e":"The helicopter flew over the sea and was able to land on the ship."}]}]},"helicopters":{"h":"helicopters","l":"helicopter","q":"noun"},"casualty":{"h":"casualty","i":"/ˈkaʒ(ʊ)əlti/","a":"en-us-casualty.ogg","s":[{"p":"noun","d":[{"m":"(countable) A casualty is a person who has been hurt, even killed, in an accident, or an act of violence.","e":"The only casualty in the bus crash was an old man who broke his arm."},{"m":"(uncountable) The casualty department of a hospital is where people who have been hurt are first taken for medical treatment.","e":"Casualty was crowded with injured people after the accident."}]}]},"casualties":{"h":"casualties","l":"casualty","q":"noun"},"mug":{"h":"mug","i":"/mʌɡ/","a":"en-us-mug.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mug is a large cup for hot drinks, with a handle but not used with a saucer.","e":"He drank his hot coffee from an old mug."},{"m":"A mug can also be a person's face.","e":"He had an ugly mug."},{"m":"A person who can be tricked easily can be called a mug.","e":"The teacher was a mug – he believed my excuse."}]},{"p":"verb","d":[{"m":"(transitive) To mug someone is to rob them, to steal from them.","e":"He hid in a doorway and planned to mug the next person who walked past."}]}]},"mugs":{"h":"mugs","l":"mug","q":"noun"},"mugged":{"h":"mugged","l":"mug","q":"verb"},"mugging":{"h":"mugging","l":"mug","q":"verb"},"gut":{"h":"gut","i":"/ɡʌt/","a":"en-us-inlandnorth-gut.ogg","s":[{"p":"noun","d":[{"m":"A person's gut is their belly.","e":"That man has a large belly. He has a beer gut."}]},{"p":"verb","d":[{"m":"If you gut something, you remove its internal organs.","e":"My grandpa can gut fish in less than a minute."},{"m":"If you gut something, you remove the important parts.","e":"Congress gutted the bill."}]}]},"cliff":{"h":"cliff","i":"/klɪf/","a":"en-us-cliff.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cliff is a vertical (straight up and down) rock face.","e":"Don't go too close to the cliff or you will fall off."}]}]},"guts":{"h":"guts","i":"/ɡʌts/","a":"LL-Q1860 (eng)-Back ache-guts.wav","l":"gut","q":"noun","s":[{"p":"noun","d":[{"m":"The contents of the abdomen or belly; entrails.","e":"Johnny was cut in the stomach and his guts were hanging out."},{"m":".","e":"It took a lot of guts to tell the evil dictator what she thought of his unfair policies."}]}]},"cliffs":{"h":"cliffs","l":"cliff","q":"noun"},"catalogue":{"h":"catalogue","i":"/ˈkæt.ə.lɒɡ/","a":"en-us-catalogue.ogg","s":[{"p":"noun","d":[{"m":"(countable) A catalogue is a list of items.","e":"Look through the catalogue to find the book you're looking for."}]},{"p":"verb","d":[{"m":"To catalogue is to organize items in a list, often in alphabetical order.","e":"Catalogue these books so we can easily find them."}]}]},"catalogues":{"h":"catalogues","l":"catalogue","q":"noun"},"catalogued":{"h":"catalogued","l":"catalogue","q":"verb"},"cataloguing":{"h":"cataloguing","l":"catalogue","q":"verb"},"catalog":{"h":"catalog","i":"/ˈkæt.ə.lɒɡ/","a":"en-us-catalogue.ogg","s":[{"p":"noun","d":[{"m":"(countable) A catalog is a list of items.","e":"Look through the catalog to find the book you're looking for."}]},{"p":"verb","d":[{"m":"To catalog is to organize items in a list, often in alphabetical order.","e":"Catalog these books so we can easily find them."}]}]},"catalogs":{"h":"catalogs","l":"catalog","q":"noun"},"cataloged":{"h":"cataloged","l":"catalog","q":"verb"},"cataloging":{"h":"cataloging","l":"catalog","q":"verb"},"protagonist":{"h":"protagonist","i":"/prəˈtæɡ.ə.nɪst/","a":"en-us-protagonist.ogg","s":[{"p":"noun","d":[{"m":"(countable) In a literary work or drama, the protagonist is the main character.","e":"I was rooting for the protagonist of the book."},{"m":"(countable) A protagonist is a leading person in a contest; a major performer.","e":"The event was canceled because the protagonist couldn't come."},{"m":"(countable) A protagonist can be someone who recommends a cause or course of action.","e":"There were no protagonists at the meeting so nothing got done."}]}]},"protagonists":{"h":"protagonists","l":"protagonist","q":"noun"},"hobby":{"h":"hobby","i":"/ˈhɒ.bi/","a":"LL-Q1860 (eng)-I learned some phrases-hobby.wav","s":[{"p":"noun","d":[{"m":"(countable) A hobby is an activity that a person likes to do with their extra time.","e":"When I'm not at work, my hobby is to work on my car."},{"m":"(countable) A hobby can also be a bird with long wings.","e":"We saw a hobby fly by."}]}]},"hobbies":{"h":"hobbies","l":"hobby","q":"noun"},"simile":{"h":"simile","i":"/ˈsɪməli/","a":"en-us-simile.ogg","s":[{"p":"noun","d":[{"m":"(countable) A simile is a figure of speech (a way of saying things) that connects two very different things (usually formed with the words like or as).","e":"Here is an example simile: you eat like a pig."}]}]},"managements":{"h":"managements","l":"management","q":"noun"},"similia":{"h":"similia","l":"simile","q":"noun"},"similes":{"h":"similes","l":"simile","q":"noun"},"gallery":{"h":"gallery","i":"/ˈɡæləri/","a":"LL-Q1860 (eng)-Vealhurl-gallery.wav","s":[{"p":"noun","d":[{"m":"A gallery is a place where art is displayed.","e":"Let's go to the gallery to check out the new paintings."},{"m":"A gallery can also be a place that buys and sells artwork.","e":"The artist made money be selling his drawings to the gallery."},{"m":"In a theater or auditorium, the gallery is the highest seating area.","e":"It was difficult to see the actor's faces because we were sitting in the gallery."}]}]},"galleries":{"h":"galleries","a":"En-us-galleries.ogg","l":"gallery","q":"noun"},"taco":{"h":"taco","i":"/ˈtɑkoʊ/","a":"en-ca-taco.oga","s":[{"p":"noun","d":[{"m":"(countable) A taco is a type of food that is made with a folded shell, meat, and lettuce.","e":"I'm hungry and I have a feeling for Mexican food. I feel like I could eat ten tacos."}]}]},"tacos":{"h":"tacos","l":"taco","q":"noun"},"matt":{"h":"matt","i":"/mæt/","a":"en-us-mat.ogg","s":[{"p":"noun","d":[{"m":"A matt finish on paint or photographs is dull, not shiny."}]}]},"cater":{"h":"cater","i":"/ˈkeɪtər/","a":"en-us-cater.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To cater is to bring or make food for an event.","e":"We need to get a company to cater our party this weekend."},{"m":"(transitive) To cater to someone is to serve them and provide for their needs.","e":"The servant catered to the king."}]}]},"caters":{"h":"caters","l":"cater","q":"verb"},"catered":{"h":"catered","l":"cater","q":"verb"},"catering":{"h":"catering","i":"/ˈkeɪt(ə)rɪŋ/","l":"cater","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) A catering is the business of providing food and related services at an event."}]}]},"catholic":{"h":"Catholic","i":"/ˈkæθ(ə)lɪk/","a":"en-us-Catholic.ogg","s":[{"p":"proper noun","d":[{"m":"(countable) A Catholic is a member of the Catholic Church.","e":"The priest is a Catholic."}]},{"p":"adjective","d":[{"m":"If something is Catholic it means it is related to a religion that follows Christianity.","e":"Is there a nearby Catholic church?"}]}]},"catholics":{"h":"Catholics","l":"catholic","q":"proper noun"},"oasis":{"h":"oasis","i":"/əʊˈeɪsɪs/","a":"en-us-oasis.ogg","s":[{"p":"noun","d":[{"m":"A spring in a desert, where there is water and plant growth around the water.","e":"The oasis saved the lost travelers from dying of thirst."},{"m":"A quiet place apart from noise or bustle around the place.","e":"The park was an oasis in the middle of the busy city."}]}]},"oases":{"h":"oases","l":"oasis","q":"noun"},"birdie":{"h":"birdie","i":"/ˈbɝdi/","a":"en-au-birdie.ogg","s":[{"p":"noun","d":[{"m":"A birdie is another name for a bird.","e":"Look in the sky! A birdie!"},{"m":"In golf, if you get a birdie that means you hit the ball into the hole in one less shot than expected (one under par).","e":"I took three shots on a four par. I got a birdie."},{"m":"In badminton, the birdie is the type of feathered ball that is used. It is also called a shuttlecock.","e":"He hit the birdie into the net."}]},{"p":"verb","d":[{"m":"(transitive) If you birdie a golf hole, you score one under par on it.","e":"I birdied the last hole with 4 strokes on a par 5."}]}]},"birdies":{"h":"birdies","l":"birdie","q":"noun"},"omnipotence":{"h":"omnipotence","a":"En-us-omnipotence.ogg","s":[{"p":"noun","d":[{"m":"Omnipotence is the ability to do anything, or to have unlimited power."}]}]},"unlimited":{"h":"unlimited","i":"/ʌnˈlɪmɪtɪd/","a":"en-us-unlimited.ogg","s":[{"p":"adjective","d":[{"m":"When something is unlimited, it has no limit.","e":"The seemingly unlimited number of people got out of the mall."}]}]},"bacterium":{"h":"bacterium","i":"/bækˈtɪər.ɪəm/","a":"en-us-bacterium.ogg","s":[{"p":"noun","d":[{"m":"(countable) Bacterium are organisms (living things) that have one cell.","e":"He looked at the bacterium through the microscope."}]}]},"organism":{"h":"organism","i":"/ˈɔː.ɡən.ɪ.zəm/","a":"en-us-organism.ogg","s":[{"p":"noun","d":[{"m":"(countable) An organism is any living thing, such as an animal, a plant, or a bacterium.","e":"The Earth is full of many different kinds of organisms."}]}]},"organisms":{"h":"organisms","l":"organism","q":"noun"},"pledge":{"h":"pledge","i":"/pledʒ/","a":"en-us-pledge.ogg","s":[{"p":"noun","d":[{"m":"(countable) If you made a pledge that means you made promise that you will do something.","e":"I made a pledge that I would go with him, so I can't back out now."}]},{"p":"verb","d":[{"m":"(transitive) To make a pledge is to make a serious promise or commitment to someone.","e":"I pledged that I would follow him, no matter where he went."}]}]},"pledges":{"h":"pledges","l":"pledge","q":"noun"},"pledged":{"h":"pledged","i":"/plɛdʒd/","l":"pledge","q":"verb"},"pledging":{"h":"pledging","i":"/ˈplɛdʒɪŋ/","l":"pledge","q":"verb"},"chamber":{"h":"chamber","i":"/ˈtʃeɪmbə(r)/","a":"en-us-chamber.ogg","s":[{"p":"noun","d":[{"m":"(countable) A chamber is a room that is often used for sleeping.","e":"He went to his chamber to get some rest."},{"m":"(countable) A chamber is a legislative body in a government.","e":"The House of Representatives is the only chamber in the legislature of New Zealand."},{"m":"(countable) A chamber can be any enclosed space that holds something, such as where the bullets are stored in a gun.","e":"The chamber was empty so the gun did not fire."}]},{"p":"verb","d":[{"m":"(transitive) To chamber something is to put it in a room or an enclosed space.","e":"The angry girl chambered herself in her room."}]}]},"chambers":{"h":"chambers","l":"chamber","q":"noun"},"chambered":{"h":"chambered","l":"chamber","q":"verb"},"chambering":{"h":"chambering","l":"chamber","q":"verb"},"rodent":{"h":"rodent","i":"/ˈrəʊdənt/","a":"LL-Q1860 (eng)-Vealhurl-rodent.wav","s":[{"p":"noun","d":[{"m":"(countable) A rodent is a small mammal with large front teeth that are used for chewing.","e":"We had to call an exterminator because we had so many unwanted rodents in the basement."}]}]},"rodents":{"h":"rodents","l":"rodent","q":"noun"},"champion":{"h":"champion","i":"/ˈtʃæmpiən/","a":"en-us-champion.ogg","s":[{"p":"noun","d":[{"m":"(countable) A champion is someone who has been a winner in a contest.","e":"I was the race and so now I am this year's champion."}]},{"p":"adjective","d":[{"m":"Something that is champion is the best for its kind.","e":"He is a champion bike racer."}]},{"p":"verb","d":[{"m":"(transitive) To champion something is to promote it or be a winner of it.","e":"He had championed the sport."}]}]},"champions":{"h":"champions","l":"champion","q":"noun"},"championed":{"h":"championed","l":"champion","q":"verb"},"championing":{"h":"championing","l":"champion","q":"verb"},"immanent":{"h":"immanent","i":"/ˈɪmənənt/","a":"en-us-immanent.ogg","s":[{"p":"adjective","d":[{"m":"To be immanent is to be naturally part of something; to be within it.","e":"Holy people make God immanent in them."},{"m":"If something is immanent, it can also mean it is something that is taking place only inside one's mind.","e":"He had an immanent feeling that this was the right thing to do."}]}]},"charm":{"h":"charm","i":"/t͡ʃɑrm/","a":"en-us-charm.ogg","s":[{"p":"noun","d":[{"m":"(countable) A charm is an object that people think has a magical power.","e":"His old pencil was a charm for him. He always used it on tests."},{"m":"(uncountable) If someone has charm, that means that they can easily make people like them.","e":"Everyone liked her for her charm."},{"m":"(countable) A trinket usually worn on a bracelet.","e":"He gave her a charm for her charm bracelet."},{"m":"(countable) A group or flock of finches."}]},{"p":"verb","d":[{"m":"To charm someone is to amaze them or win them over.","e":"He charmed her with talk of all the money he had."},{"m":"To charm something or someone means to use magic upon it.","e":"The witch tried to charm the princess with an old spell."}]}]},"charms":{"h":"charms","i":"/t͡ʃɑrmz/","a":"en-us-charms.ogg","l":"charm","q":"noun"},"charmed":{"h":"charmed","i":"/tʃɑːmd/","a":"en-us-charmed.ogg","l":"charm","q":"verb"},"charming":{"h":"charming","i":"/ˈtʃɑː(r).mɪŋ/","a":"en-us-charming.ogg","l":"charm","q":"verb","s":[{"p":"adjective","d":[{"m":"If a person is charming, they are very pleasant or charismatic"}]}]},"himalayas":{"h":"Himalayas","s":[{"p":"proper noun","d":[{"m":"The Himalayas are a group of mountains from India to China."}]}]},"distributor":{"h":"distributor","i":"/dɪˈstrɪbjʊtə/","a":"LL-Q1860 (eng)-Vininn126-distributor.wav","s":[{"p":"noun","d":[{"m":"(countable) A distributor is one who divides things into smaller groups and sends them places; someone who distributes.","e":"Grocery stores buy their goods from food distributors."}]}]},"distributors":{"h":"distributors","l":"distributor","q":"noun"},"disperse":{"h":"disperse","i":"/dɪˈspɜːs/","a":"LL-Q1860 (eng)-Mélange a trois-disperse.wav","s":[{"p":"verb","d":[{"m":"If a group disperses, it breaks up into individual pieces or items and spreads out.","e":"The police fired their guns to disperse the crowd."}]}]},"pulp":{"h":"pulp","i":"/pʌlp/","a":"en-au-pulp.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) The pulp is the part of a fruit that is soft and edible."},{"m":"(uncountable) Pulp can be any soft, thick, wet mass."},{"m":"(uncountable) Wood pulp is wood fibres that are shredded, crushed and mixed with water."},{"m":"By extension, popular literature printed on rough paper: pulp fiction."}]}]},"pulps":{"h":"pulps","l":"pulp","q":"noun"},"disperses":{"h":"disperses","l":"disperse","q":"verb"},"dispersed":{"h":"dispersed","a":"En-us-dispersed.ogg","l":"disperse","q":"verb"},"dispersing":{"h":"dispersing","l":"disperse","q":"verb"},"extravagant":{"h":"extravagant","s":[{"p":"adjective","d":[{"m":"Using more of something than is needed, especially money, is to be extravagant.","e":"Don't be extravagant with money."}]}]},"fang":{"h":"fang","i":"/fæŋ/","a":"LL-Q1860 (eng)-Vealhurl-fang.wav","s":[{"p":"noun","d":[{"m":"(countable) A fang is a long, pointy tooth of an animal.","e":"The dog bit me with his fangs."}]}]},"inhabitant":{"h":"inhabitant","i":"/ɪnˈhæ.bɪ.tənt/","a":"en-us-inhabitant.ogg","s":[{"p":"noun","d":[{"m":"(countable) An inhabitant of a place is a person or animal living in that place.","e":"The baby will be a new inhabitant of our house"}]}]},"intricate":{"h":"intricate","i":"/ˈɪn.trɪ.kət/","a":"en-us-intricate.ogg","s":[{"p":"adjective","d":[{"m":"and detailed","e":"It took a very long time to finish the intricate pattern."}]}]},"howl":{"h":"howl","i":"/haʊl/","a":"en-us-howl.ogg","s":[{"p":"verb","d":[{"m":"To howl is to make a long, loud wailing noise.","e":"We heard the wolf howl from far away."}]},{"p":"noun","d":[{"m":"A howl is a long, loud wailing noise.","e":"The howl of the wind echoed through the trees."}]}]},"firefly":{"h":"firefly","i":"/ˈfaɪ.əˌflaɪ/","a":"LL-Q1860 (eng)-Vealhurl-firefly.wav","s":[{"p":"noun","d":[{"m":"(countable) A firefly is an insect that has a glowing light on its back.","e":"The firefly's light shined into the bedroom from the jar."}]}]},"inhabitants":{"h":"inhabitants","a":"En-us-inhabitants.ogg","l":"inhabitant","q":"noun"},"fangs":{"h":"fangs","l":"fang","q":"noun"},"amicable":{"h":"amicable","i":"/ˈæmɪkəbl/","a":"en-us-amicable.ogg","s":[{"p":"adjective","d":[{"m":"If someone is amicable they are friendly and nice.","e":"The man was amicable when he smiled."}]}]},"boyhood":{"h":"boyhood","s":[{"p":"noun","d":[{"m":"Boyhood is the time a boy is in his childhood or youth.","e":"He was still in boyhood when he broke the window."}]}]},"boyhoods":{"h":"boyhoods","l":"boyhood","q":"noun"},"catwalk":{"h":"catwalk","i":"/ˈkatwɔːk/","a":"LL-Q