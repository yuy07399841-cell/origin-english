":"noun","d":[{"m":"(countable) Probe is a medical instrument which is used to explore organs, wounds and."}]},{"p":"verb","d":[{"m":"If you probe into something, you investigate it to uncover information.","e":"If you probe further, you may discover different reasons."},{"m":"(transitive) If you probe something, you insert a [[#Noun|probe]] into it."}]}]},"probes":{"h":"probes","i":"/proʊbz/","l":"probe","q":"noun"},"deceptions":{"h":"deceptions","i":"/dɪˈsɛpʃənz/","l":"deception","q":"noun"},"deception":{"h":"deception","i":"/dɪˈsɛpʃən/","a":"en-us-deception.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Deception is an act, appearance or statement which gives someone false information (is misleading).","e":"was covered up with large-scale deception."}]}]},"flips":{"h":"flips","l":"flip","q":"verb"},"flipped":{"h":"flipped","l":"flip","q":"verb"},"forfeited":{"h":"forfeited","l":"forfeit","q":"verb"},"forfeiting":{"h":"forfeiting","l":"forfeit","q":"verb"},"impede":{"h":"impede","i":"/ɪmpid/","a":"en-us-impede.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To impede is to make some task, progress or action not to happen or difficult to happen.","e":"The incompetent construction worker is impeding the progress of the construction project."}]}]},"impedes":{"h":"impedes","i":"/ɪmpidz/","l":"impede","q":"verb"},"impeded":{"h":"impeded","i":"/ɪmpidəd/","l":"impede","q":"verb"},"bowel":{"h":"bowel","i":"/ˈbaʊ.əl/","a":"LL-Q1860 (eng)-Vealhurl-bowel.wav","s":[{"p":"noun","d":[{"m":"The bowel is an internal organ which helps an organism digest food."}]}]},"bowels":{"h":"bowels","i":"/bawəlz/","a":"en-us-bowels.ogg","l":"bowel","q":"noun","s":[{"p":"noun","d":[{"m":"(plural) Bowels are the innermost parts of something."}]}]},"retaliates":{"h":"retaliates","l":"retaliate","q":"verb"},"retaliated":{"h":"retaliated","l":"retaliate","q":"verb"},"compositions":{"h":"compositions","l":"composition","q":"noun"},"palindrome":{"h":"palindrome","i":"/ˈpælɪndrəʊm/","a":"en-us-palindrome.ogg","s":[{"p":"noun","d":[{"m":"A palindrome is a word or phrase spelled the same way backwards as forwards.","e":"The words level and noon are palindromes."}]}]},"palindromes":{"h":"palindromes","l":"palindrome","q":"noun"},"pastures":{"h":"pastures","l":"pasture","q":"noun"},"rungs":{"h":"rungs","l":"rung","q":"noun"},"shampoo":{"h":"shampoo","i":"/ʃæmˈpu/","a":"en-us-shampoo.ogg","s":[{"p":"noun","d":[{"m":"Shampoo is liquid soap used for washing hair.","e":"My favorite shampoo was on sale for half price at the store, so I bought a few bottles."}]},{"p":"verb","d":[{"m":"If you shampoo your hair, you wash it with soap.","e":"In the shower, I shampoo my hair before washing my body."}]}]},"shampoos":{"h":"shampoos","l":"shampoo","q":"noun"},"rigor":{"h":"rigor","i":"/rɪɡɚ/","a":"en-us-rigor.ogg","s":[{"p":"noun","d":[{"m":"Rigor is strict care and completeness in making sure something is correct.","e":"The army demands a lot of rigor in training new recruits."},{"m":"(usually plural) The rigors of something are its difficult parts or its problems.","e":"She did not enjoy the rigors of giving birth."}]}]},"rigors":{"h":"rigors","l":"rigor","q":"noun"},"thicken":{"h":"thicken","i":"/'θɪkən/","a":"en-us-thicken.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you thicken an object or shape, you make it wider.","e":"You should thicken the lines to make them easier to see."},{"m":"(transitive) If you thicken a liquid, you make it thicker.","e":"Put flour in the gravy to thicken it."},{"m":"(intransitive) If something thickens, it becomes wider or thicker.","e":"After stirring the soup for several minutes, it started to thicken."}]}]},"thickens":{"h":"thickens","l":"thicken","q":"verb"},"thickened":{"h":"thickened","l":"thicken","q":"verb"},"thickening":{"h":"thickening","l":"thicken","q":"verb"},"producer":{"h":"producer","i":"/prəˈdjuːsə/","a":"en-au-producer.ogg","s":[{"p":"noun","d":[{"m":"(countable) Producer is one who participates in of goods and services for 