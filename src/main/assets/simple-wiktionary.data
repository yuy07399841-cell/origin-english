{"h":"emblematic","i":"/ˌɛmbləˈmatɪk/","a":"LL-Q1860 (eng)-Vealhurl-emblematic.wav","s":[{"p":"adjective","d":[{"m":"If something is emblematic, it serves as an emblem or symbol for something else."}]}]},"atlas":{"h":"atlas","i":"/ˈætləs/","a":"LL-Q1860 (eng)-Vealhurl-atlas.wav","s":[{"p":"noun","d":[{"m":"A joint collection of maps.","e":"Many students of Geography will use an atlas at least once."},{"m":"A bound collection of tables, illustrations etc. on any given subject."}]}]},"stepfather":{"h":"stepfather","s":[{"p":"noun","d":[{"m":"(countable) A person's stepfather is a woman who is to their biological mother but is not their biological father."}]}]},"constraints":{"h":"constraints","l":"constraint","q":"noun"},"lenient":{"h":"lenient","i":"/ˈliːniənt/","s":[{"p":"adjective","d":[{"m":"If you are lenient, you give light punishments or ask for only a low level of results","e":"He's not in jail because a lenient judge allowed him to get out."}]}]},"dose":{"h":"dose","i":"/dəʊs/","a":"en-us-dose.ogg","s":[{"p":"noun","d":[{"m":"(countable) A dose is a measured amount of medicine that is taken at one time.","e":"Eat a dose of one spoonful of this cough medicine after every meal."}]},{"p":"verb","d":[{"m":"(transitive) If a doctor doses a patient, they administer a [[#Noun|dose]] to them."}]}]},"doses":{"h":"doses","l":"dose","q":"noun"},"starve":{"h":"starve","i":"/stɑːv/","a":"en-us-starve.ogg","s":[{"p":"verb","d":[{"m":"When you starve, you die from not having enough food.","e":"Many people starved in this earthquake as there was not enough food available."},{"m":"(intransitive) When you are starving, you are very hungry.","e":"I didn't eat my breakfast and now I'm starving."}]}]},"starves":{"h":"starves","l":"starve","q":"verb"},"starved":{"h":"starved","l":"starve","q":"verb"},"starving":{"h":"starving","a":"En-us-starving.ogg","l":"starve","q":"verb"},"talent":{"h":"talent","i":"/ˈtælənt/","a":"en-us-talent.ogg","s":[{"p":"noun","d":[{"m":"If you have a talent in doing something, you have the skill and ability to do that task.","e":"He has got the talent in music, but his family is too poor to provide him with the proper education."}]}]},"talents":{"h":"talents","a":"En-us-talents.ogg","l":"talent","q":"noun"},"tissue":{"h":"tissue","i":"/ˈtɪs.juː/","a":"en-uk-tissue.ogg","s":[{"p":"noun","d":[{"m":"A piece of tissue is a sheet of paper that can absorb very well.","e":"He used the tissue I gave him to blow his nose."},{"m":"(uncountable) Tissue is a group of cells that work together to do a job.","e":"The human body is made up of many tissues, one example being muscle tissue."}]}]},"tissues":{"h":"tissues","l":"tissue","q":"noun"},"purse":{"h":"purse","i":"/pɜːs/","a":"en-us-purse.ogg","s":[{"p":"noun","d":[{"m":"(countable) A purse is a small bag that is used to carry money.","e":"That lady is carrying a yellow purse in her hand."}]},{"p":"verb","d":[{"m":"(transitive) If you purse your lips, you press them in and together so that they protrude."}]}]},"purses":{"h":"purses","l":"purse","q":"noun"},"excel":{"h":"excel","i":"/ɪkˈsɛl/","a":"LL-Q1860 (eng)-Vealhurl-excel.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If you excel at something, you do it very well.","e":"I excel at long-distance running."}]}]},"excels":{"h":"excels","l":"excel","q":"verb"},"excelled":{"h":"excelled","l":"excel","q":"verb"},"excelling":{"h":"excelling","l":"excel","q":"verb"},"stroll":{"h":"stroll","i":"/strəʊl/","a":"en-us-stroll.ogg","s":[{"p":"verb","d":[{"m":"When you stroll, you walk slowly, usually when you are enjoying the environment around you.","e":"I strolled with my wife around the park, enjoying the beauty of nature."}]}]},"strolls":{"h":"strolls","a":"En-us-strolls.ogg","l":"stroll","q":"verb"},"strolled":{"h":"strolled","l":"stroll","q":"verb"},"strolling":{"h":"strolling","a":"En-us-strolling.ogg","l":"stroll","q":"verb"},"soliloquy":{"h":"soliloquy","i":"/səˈlɪləkwi/","a":"en-us-soliloquy.ogg","s":[{"p":"noun","d":[{"m":