-marine.ogg","s":[{"p":"adjective","d":[{"m":"If something is marine, it is of the sea or it relates to the sea.","e":"Marine biology is the study of animals that live in the sea."}]},{"p":"noun","d":[{"m":"(countable) A marine is someone who is a member of the marine corps.","e":"This man is a marine."}]}]},"marines":{"h":"marines","l":"marine","q":"noun"},"hippopotamuses":{"h":"hippopotamuses","l":"hippopotamus","q":"noun"},"hippopotami":{"h":"hippopotami","l":"hippopotamus","q":"noun"},"pre":{"h":"pre","s":[{"p":"preposition","d":[{"m":"before","e":"The photo was taken pre my hair becoming gray."}]}]},"massacres":{"h":"massacres","l":"massacre","q":"noun"},"massacred":{"h":"massacred","l":"massacre","q":"verb"},"massacring":{"h":"massacring","l":"massacre","q":"verb"},"umpteen":{"h":"umpteen","i":"/ˈʌmp.tiːn/","a":"LL-Q1860 (eng)-Vealhurl-umpteen.wav","s":[{"p":"determiner","d":[{"m":"Umpteen is a large number of something; more than some.","e":"What have you been doing for the last umpteen days?"}]}]},"chimney":{"h":"chimney","i":"/tʃɪmni:/","a":"en-us-chimney.ogg","s":[{"p":"noun","d":[{"m":"(countable) A chimney is a column that is built into a fireplace and onto a house to let off the pollution and smoke made by a fire in the fireplace; a flue."},{"m":"(countable) A chimney is a small opening in a rock face.","e":"Smoke curled out from the chimney."}]}]},"chimneys":{"h":"chimneys","l":"chimney","q":"noun"},"column":{"h":"column","i":"/ˈkɒləm/","a":"en-us-column.ogg","s":[{"p":"noun","d":[{"m":"(countable) A column is a support that is standing up and is built to support something, usually on a building.","e":"The White House was built with several columns on the front side of the building to help support the building and prevent it from falling down."},{"m":"(countable) A column is a line of items in a table that goes from top to bottom.","e":"The title of the second column in the table is \"Population in 2009\"."},{"m":"(countable) A column is a body of troops that are strung out along a road."},{"m":"(countable) A column is a body of text in a newspaper that goes from top to bottom."}]}]},"columnar":{"h":"columnar","i":"/kəˈlʌmnə(r)/","a":"LL-Q1860 (eng)-Vealhurl-columnar.wav","s":[{"p":"adjective","d":[{"m":"If something is columnar, it is shaped like a column."},{"m":"If something is columnar, it is built like a column."}]}]},"columns":{"h":"columns","a":"en-us-columns.ogg","l":"column","q":"noun"},"fireplace":{"h":"fireplace","i":"/ˈfaɪəpleɪs/","a":"en-us-fireplace.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fireplace is a place in the hearth, found at the bottom of the chimney where a fire can be started.","e":"The fire in the fireplace was burning brightly now."}]}]},"fireplaces":{"h":"fireplaces","l":"fireplace","q":"noun"},"superpower":{"h":"superpower","i":"/ˌsupɚˈpaʊə/","a":"LL-Q1860 (eng)-Flame, not lame-superpower.wav","s":[{"p":"noun","d":[{"m":"(countable) A superpower is a very strong country.","e":"The United States and the Soviet Union were the superpowers of the last century."},{"m":"(countable) A superpower is something a superhero can do that a real person could not do.","e":"His superpowers included being able to fly and the through lightning."}]}]},"kinda":{"h":"kinda","i":"/ˈkaɪndə/","a":"en-us-kinda.ogg","s":[{"p":"adverb","d":[{"m":"Just a little bit.","e":"I'm kinda tired, but I can keep working."},{"m":"Mostly true, but not completely true. What was said is not exact.","e":"Well, it's kinda a cat -- well, it's a lion cub."},{"m":"You can say kinda to make what you say softer, or to apologize.","e":"I'm sorry, but I kinda wrecked your car."}]}]},"demonize":{"h":"demonize","i":"/ˈdiːmənaɪz/","a":"en-us-demonize.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you demonize something, you make it seem very bad or evil."},{"m":"(transitive) If you demonize something, you turn something into a demon."}]}]},"demoness":{"h":"demoness","s":[{"p":"noun","d":[{"m":"(countable) A demoness is a female demon."}]}]},"superpowers":{"h":"superpowers","l":"superpower","q":"noun"},"demonizes":{"h":"demonizes","l":"demonize","q":"verb"},"demonized":{"h":"demonized","l":"demonize","q":"verb"},"demonizing":{"h":"demonizing","l":"demonize","q":"verb"},"demonesses":{"h":"demonesses","l":"demoness","q":"noun"},"talus":{"h":"talus","i":"/'teɪləs/","s":[{"p":"noun","d":[{"m":"(countable) A talus is the bone of the ankle."}]}]},"backside":{"h":"backside","i":"/ˈbækˌsaɪd/","a":"en-us-backside.ogg","s":[{"p":"noun","d":[{"m":"(countable) Something's backside is the side that is opposite of the front."},{"m":"(countable) Someone's backside is their buttocks or butt.","e":"The child was spanked in the backside for misbehaving."}]}]},"backsides":{"h":"backsides","a":"en-us-backsides.ogg","l":"backside","q":"noun"},"judgement":{"h":"judgement","i":"/ˈʤʌʤmənt/","a":"en-us-judgment.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Judgement is being able to make good choices.","e":"You will need good judgement to decide on a school."},{"m":"(countable) A judgement is a choice or decision you might make."},{"m":"(countable) A judgement is the something decided by a judge. It is an official order by a court.","e":"This judgement means you have to pay me $500 each month, for a year."}]}]},"judgemental":{"h":"judgemental","i":"/dʒʌdʒˈmɛnt(ə)l/","a":"en-us-judgemental.ogg","s":[{"p":"adjective","d":[{"m":"If you are judgemental, you judge people quickly and often.","e":"I know what I did was wrong, but you don't have to be so judgemental about it."}]}]},"judgmental":{"h":"judgmental","i":"/dʒʌdʒˈmɛnt(ə)l/","a":"en-us-judgemental.ogg","s":[{"p":"adjective","d":[{"m":"If you are judgmental, you judge people quickly and often.","e":"I know what I did was wrong, but you don't have to be so judgmental about it."}]}]},"cap":{"h":"cap","i":"/kæp/","a":"en-us-cap.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cap is a small hat.","e":"He was wearing blue jeans and a ball cap."},{"m":"(countable) A cap is a cover that closes the end of something, such as a bottle or pipe.","e":"First we need to remove the cap, then we can drain the fluid from the tank."},{"m":"(countable) A cap is a limit.","e":"The government should place a cap on spending for next year."},{"m":"(countable) A cap is small piece of explosive that is used to set off larger explosives."},{"m":"(countable); A cap is the top part of a mushroom."},{"m":"(countable) A cap is a crown for covering a tooth."},{"m":"(countable) A cap is the summit (top) of a mountain."},{"m":"(countable) A cap is a small amount of gunpowder that is used to set off a toy gun."},{"m":"(countable) If you \"pop a cap\" on someone, you shoot them with a gun.","e":"You best watch out or I'll bust a cap in your ass."},{"m":"A cap is an international appearance of a player in a team."}]},{"p":"verb","d":[{"m":"(transitive) If you cap something, you put a cap on it.","e":"We need to cap that pipe before turning the water back on."},{"m":"(transitive) If you cap something, you set an upper limit on it."},{"m":"(transitive) If something caps something, it fits on it and is a cap for it."},{"m":"; (transitive) If you cap someone, you shoot that person."},{"m":"(transitive) If you cap something, you lie over or on top of something."},{"m":"(transitive) If you cap something, you surpass or outdo something."},{"m":"If you cap, you lie."}]}]},"elbow":{"h":"elbow","i":"/ˈɛlbəʊ/","a":"en-us-elbow.ogg","s":[{"p":"noun","d":[{"m":"(countable) Your elbow is the place in the middle of your arm that bends.","e":"I hurt my elbow playing tennis."},{"m":"(countable) An elbow is a 90° turn in a pipe, river, road, etc.","e":"I need another elbow piece to get this pipe round the corner."}]},{"p":"verb","d":[{"m":"(transitive) If you elbow somebody, you hit them with your elbow.","e":"My mom elbowed me to be quiet."}]}]},"mom":{"h":"mom","i":"/mɒm/","a":"en-us-mom.ogg","s":[{"p":"noun","d":[{"m":"(countable) A short word for mother."}]}]},"mum":{"h":"mum","i":"/mʌm/","a":"en-us-mum.ogg","s":[{"p":"noun","d":[{"m":"(countable) A short word for mother."},{"m":"(countable) A mum is kind of flower."}]}]},"mommy":{"h":"mommy","i":"/ˈmɑ.mi/","a":"en-us-mommy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A word for mother used mostly by young children."}]}]},"nowadays":{"h":"nowadays","i":"/ˈnaʊ.ə.deɪz/","a":"en-us-nowadays.ogg","s":[{"p":"adverb","d":[{"m":"and recently; in this time.","e":"Back then we walked everywhere, but nowadays everyone drives a car."}]}]},"believable":{"h":"believable","i":"/bɪˈliːvəbl̩/","a":"LL-Q1860 (eng)-Vealhurl-believable.wav","s":[{"p":"adjective","d":[{"m":"If something is believable it is easy to believe.","e":"I find his story believable, but I don't know if its true."}]}]},"lover":{"h":"lover","i":"/ˈlʌvɚ/","a":"en-us-lover.ogg","s":[{"p":"noun","d":[{"m":"(countable) If two people are lovers they have sex with each other.","e":"I heard she was his lover."},{"m":"(countable) A lover of someone or something is someone who loves (like very much) that person or thing.","e":"I'm a real pizza lover, and could eat pizza all day."}]}]},"jeans":{"h":"jeans","i":"/d͡ʒiːnz/","a":"LL-Q1860 (eng)-Vealhurl-jeans.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Jeans are pants made from denim."}]}]},"kindly":{"h":"kindly","i":"/ˈkaɪndli/","a":"en-us-kindly.ogg","s":[{"p":"adjective","d":[{"m":"If your are kindly you often show kindness, usually for older people.","e":"She was a kindly old lady."}]}]},"northeast":{"h":"northeast","s":[{"p":"noun","d":[{"m":"Northeasth is the direction between north and east."},{"m":"The northeast is a place is the part that is to the north and east.","e":"The weather not unusual for a winter night in the Northeast."}]},{"p":"preposition","d":[{"m":"In the direction northeast; to the northeast.","e":"It is about twenty miles northeast of San Francisco."}]}]},"nope":{"h":"nope","i":"/noʊp/","a":"en-au-nope.ogg","s":[{"p":"adverb","d":[{"m":"Another word for no.","e":"\"Do you want something to eat?\" \"Nope, just coffee.\""}]}]},"ye":{"h":"ye","i":"/jiː/","a":"en-us-ye.ogg","s":[{"p":"pronoun","d":[{"m":"; An old word for you, but not for one person (plural)","e":"Hear ye the news."}]},{"p":"determiner","d":[{"m":"An old misspelling for the, used especially on pubs' signs or names to make them look old","e":"Ye Olde Alcohol Taverne"}]}]},"pants":{"h":"pants","i":"/pænts/","a":"en-us-pants.ogg","s":[{"p":"noun","d":[{"m":"Pants are a type of cloths worn on the legs. A pair of pants has a covering for each leg.","e":"Pants were traditionally worn by men, but now women wear them too."}]},{"p":"verb","d":[{"m":"If you pants a person, you pull their [[#Noun|pants]] down."}]}]},"denim":{"h":"denim","i":"/ˈdɛnɪm/","a":"LL-Q1860 (eng)-I learned some phrases-denim.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Denim is a tough cloth made from cotton, and often used to make jeans and jackets.","e":"My trousers were made out of denim."}]}]},"cannot":{"h":"cannot","i":"/ˈkænɒt/","a":"en-us-cannot.ogg","s":[{"p":"verb","d":[{"m":"If you cannot do something, you are not able to do that thing."},{"m":"If you cannot do something, you are not allowed to do that thing."}]}]},"dinosaur":{"h":"dinosaur","i":"/ˈdaɪnəsɔː(r)/","a":"LL-Q1860 (eng)-Vealhurl-dinosaur.wav","s":[{"p":"noun","d":[{"m":"(countable) Dinosaurs are reptiles that were extinct (all died) millions of years ago.","e":"Most dinosaurs were large."},{"m":"(countable) A dinosaur is something that is very old, and may not be useful any more; something obsolete.","e":"I wish I had a new computer, instead of this dinosaur from the 1990s."}]}]},"deepen":{"h":"deepen","i":"/ˈdiːpən/","a":"LL-Q1860 (eng)-Vealhurl-deepen.wav","s":[{"p":"verb","d":[{"m":"If you deepen something, you make it deeper.","e":"We need to deepen this well if we are to get any water from it."}]}]},"gotta":{"h":"gotta","i":"/ˈɡɑtə/","a":"en-us-gotta.ogg","s":[{"p":"verb","d":[{"m":"have got to or got to","e":"I'm sorry, but I'm in a hurry and I gotta go."}]}]},"recipe":{"h":"recipe","i":"/ˈrɛsəpi/","a":"En-us-recipe.ogg","s":[{"p":"noun","d":[{"m":"(countable) A recipe is a set of instructions and a list of things (called ingredients) you need to make an item of food.","e":"I have a great recipe for cookies right here."},{"m":"(countable) A recipe is a plan or way for things to come together to get a certain result.","e":"The storm, the darkness, and the crowds were a perfect recipe for disaster."}]}]},"yep":{"h":"yep","s":[{"p":"adverb","d":[{"m":"Another way to say yes."}]}]},"windy":{"h":"windy","i":"/ˈwɪndi/","a":"en-au-windy.ogg","s":[{"p":"adjective","d":[{"m":"If it is windy the wind is blowing."}]}]},"sexual":{"h":"sexual","i":"/ˈsɛkʃəl/","a":"en-us-sexual.ogg","s":[{"p":"adjective","d":[{"m":"If something is sexual it has to do with sex.","e":"Your sexual comments are not welcome."}]}]},"thee":{"h":"thee","i":"/ðiː/","a":"en-us-thee.ogg","s":[{"p":"pronoun","d":[{"m":"Another word for you.","e":"I see thee, but dost thou see me. (Meaning, \"I see you, but do you see me.\")"}]}]},"voter":{"h":"voter","i":"/ˈvəʊtə(r)/","a":"LL-Q1860 (eng)-Vealhurl-voter.wav","s":[{"p":"noun","d":[{"m":"(countable) A voter is someone who votes."},{"m":"(countable) A voter is someone who is allowed to vote."}]}]},"childless":{"h":"childless","i":"/ˈtʃʌɪldləs/","a":"LL-Q1860 (eng)-Vealhurl-childless.wav","s":[{"p":"adjective","d":[{"m":"If someone is childless, he or she does not have any children."}]}]},"harden":{"h":"harden","i":"/ˈhɑrdn̩/","a":"LL-Q1860 (eng)-Vealhurl-harden.wav","s":[{"p":"verb","d":[{"m":"If you harden something, then you make it hard, stiff, or make it more resistant.","e":"Let the harden before eating."}]}]},"hardened":{"h":"hardened","i":"/ˈhɑrdn̩d/","l":"harden","q":"verb"},"hardening":{"h":"hardening","l":"harden","q":"verb"},"hardens":{"h":"hardens","l":"harden","q":"verb"},"thoughtful":{"h":"thoughtful","i":"/ˈθɔːtfʊl/","a":"en-us-thoughtful.ogg","s":[{"p":"adjective","d":[{"m":"If someone is thoughtful, then he or she likes to think, or, is kind and caring towards others."}]}]},"labourer":{"h":"labourer","i":"/ˈleɪ.bɚ.ɚ/","a":"LL-Q1860 (eng)-Vealhurl-laborer.wav","s":[{"p":"noun","d":[{"m":"(countable) A labourer is a person who works or labours."}]}]},"laborer":{"h":"laborer","i":"/ˈleɪ.bɚ.ɚ/","a":"LL-Q1860 (eng)-Vealhurl-laborer.wav","s":[{"p":"noun","d":[{"m":"(countable) A laborer is a person who works or labors.","e":"The laborer is very young."}]}]},"laborers":{"h":"laborers","a":"En-us-laborers.ogg","l":"laborer","q":"noun"},"labourers":{"h":"labourers","a":"En-us-labourers.ogg","l":"labourer","q":"noun"},"driver":{"h":"driver","i":"/ˈdraɪvə/","a":"en-us-driver.ogg","s":[{"p":"noun","d":[{"m":"(countable) A driver is a person who drives.","e":"That man is a driver of cars."},{"m":"(countable) A driver is a kind of golf club.","e":"The golfer used his driver to hit the ball."},{"m":"(countable) A driver is a computer program for an application and hardware, made for the device it controls.","e":"The driver is used for the printer."}]}]},"drivers":{"h":"drivers","a":"En-us-drivers.ogg","l":"driver","q":"noun"},"hen":{"h":"hen","i":"/hɛn/","a":"en-us-hen.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hen is a female bird.","e":"That bird is a hen."},{"m":"(countable) A hen is a female chicken, usually one kept for its eggs.","e":"Our pet hen laid eggs."},{"m":"(countable) A hen is a woman."}]}]},"hens":{"h":"hens","l":"hen","q":"noun"},"plurals":{"h":"plurals","l":"plural","q":"noun"},"vest":{"h":"vest","i":"/vɛst/","a":"en-us-vest.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vest is a piece of clothing that covers the chest; a vest is like a shirt with no sleeves.","e":"Our suits came complete with vests."}]},{"p":"verb","d":[{"m":"If you vest a person, you give them authority or power."}]}]},"vests":{"h":"vests","l":"vest","q":"noun"},"jog":{"h":"jog","i":"/d͡ʒɒɡ/","a":"en-us-jog.ogg","s":[{"p":"verb","d":[{"m":"If you jog you run slowly.","e":"Many people jog for exercise."},{"m":"If something jogs your memory, it helps you remember.","e":"I needed to read my notes to jog my memory before the test."}]}]},"southeast":{"h":"southeast","s":[{"p":"noun","d":[{"m":"(uncountable) Southeast is a direction between south and east."},{"m":"(uncountable) The southeast is a place is the part that is to the south and east.","e":"There were storm all across the southeast."}]},{"p":"preposition","d":[{"m":"In the direction southeast; to the southeast.","e":"It is about twenty miles southeast of Dayton."}]}]},"widen":{"h":"widen","i":"/ˈwaɪdən/","a":"LL-Q1860 (eng)-Vealhurl-widen.wav","s":[{"p":"verb","d":[{"m":"If you widen something, you make it wider.","e":"They need to widen this road, to make room for more traffic."}]}]},"knowingly":{"h":"knowingly","s":[{"p":"adverb","d":[{"m":"If you do something knowingly, you know you are doing it.","e":"It was not an accident -- he knowingly installed a virus in our computer."},{"m":"If you act knowingly, you show that you know something.","e":"He looked at me knowingly, and I knew he was not fooled."}]}]},"lately":{"h":"lately","i":"/ˈleɪt.li/","a":"en-us-lately.ogg","s":[{"p":"adverb","d":[{"m":"If something has happened lately, it happened not long ago. This usually for something that might happen more than once.","e":"Have you seen her lately? I haven't seen her in weeks."}]}]},"reality":{"h":"reality","i":"/riˈælɪti/","a":"en-us-reality.ogg","s":[{"p":"noun","d":[{"m":"(countable) Reality is what actually is. Reality is what is real.","e":"I'm sure you'd like to get everything you want for free, but that isn't reality."},{"m":"(countable) If some kinds of psychology and philosophy reality is whatever you experience; what seems real to you.","e":"The therapist insists I shouldn't think my reality is the same as hers."},{"m":"(countable) If you get a dose of reality you learn the truth and what things are like for most people.","e":"He needs a dose of reality to get him out of his naive ways."}]}]},"wallet":{"h":"wallet","i":"/ˈwɒlɪt/","a":"en-au-wallet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A wallet is a small case for holding money. It is made to fit in a pocket.","e":"I put my wallet back in my pocket after paying for our meal."}]}]},"wallets":{"h":"wallets","l":"wallet","q":"noun"},"realities":{"h":"realities","a":"en-us-realities.ogg","l":"reality","q":"noun"},"currently":{"h":"currently","i":"/ˈkʌrəntli/","a":"en-us-currently.ogg","s":[{"p":"adverb","d":[{"m":"If something is happening currently it is happening at this time.","e":"They are currently trying call home."}]}]},"elsewhere":{"h":"elsewhere","i":"/ˌɛlsˈʍɛːə/","a":"En-us-elsewhere.ogg","s":[{"p":"preposition","d":[{"m":"In another place. If something is elsewhere it is somewhere else; it is not here.","e":"The party is elsewhere, so why don't we go to it."}]}]},"quickness":{"h":"quickness","i":"/ˈkwɪknəs/","a":"LL-Q1860 (eng)-Vininn126-quickness.wav","s":[{"p":"noun","d":[{"m":"(uncountable) If you have quickness you are quick; you can move fast.","e":"I was amazed by his quickness."}]}]},"hopeless":{"h":"hopeless","i":"/həʊplɛs/","a":"en-us-hopeless.ogg","s":[{"p":"adjective","d":[{"m":"If you are hopeless, you do not have hope. You do not expect anything good to happen.","e":"When I lost my job I became completely hopeless."},{"m":"If a situation (way things are) is hopeless, there is little chance that something good might happen. The situation can't be made better.","e":"The sinking ship was hopeless, there was no way to repair it."},{"m":"If you are hopeless, there is no chance you will change or learn.","e":"Oh, you're hopeless! You keep expecting someone perfect to come through that door, but it will never happen."}]}]},"backbone":{"h":"backbone","i":"/ˈbækˌbəʊn/","a":"en-us-backbone.ogg","s":[{"p":"noun","d":[{"m":"(countable) The backbone is the bones in a person's or animal's back."},{"m":"If you have backbone, you do not back down easily. You stand up for yourself.","e":"If you had any backbone you wouldn't let people tell you what to do all the time."},{"m":"(countable) The backbone of something is what holds it together or makes it strong.","e":"Customer service is the backbone of our business."}]}]},"anymore":{"h":"anymore","i":"/ˌɛn.iˈmɔː/","a":"en-us-anymore.ogg","s":[{"p":"adverb","d":[{"m":"If something does not happen anymore, it happened in the past, but has stopped happening.","e":"I liked that place when I was young, but I don't go there anymore."}]}]},"shine":{"h":"shine","i":"/ʃaɪn/","a":"en-us-shine.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If something shines, light comes from it, or it reflects light.","e":"I love the way the stars shine."},{"m":"(intransitive) If you shine, you do well."},{"m":"(intransitive) If you shine, other people can see the good things about you."},{"m":"(transitive) If you shine a light, you put the light on something.","e":"Would you shine that flashlight over here."},{"m":"(transitive) If you shine a light on a fact, you cause people to know the truth; you show people what they did not know.","e":"Would you shine that flashlight over hear."},{"m":"(transitive) If you shine something, you make it shiny; you polish it so that it reflects light.","e":"I was just shining my shoes."}]},{"p":"noun","d":[{"m":"Shine is the light from a reflection, or from a source of light.","e":"I couldn't see because the shine from the water was in my eyes."},{"m":"Something's shine is its good, or its goodness.","e":"The idea lost its shine when we realize could never work."},{"m":"A shine is when someone shines your shoes.","e":"Boy, won't you give me a shine."},{"m":"; (uncountable) Shine is a short way to say moonshine (illegal whiskey).","e":"I got so drunk on that shine they gave me."},{"m":"A shine is a liking; it is when you like someone or something.","e":"He took a real shine to her."}]}]},"unity":{"h":"unity","i":"/ˈjunɪti/","a":"en-us-unity.ogg","s":[{"p":"noun","d":[{"m":"Unity is being one, or acting together as one.","e":"Our strength lies in our unity."},{"m":"In some types of mathematics the unity is another name for one."}]}]},"yearling":{"h":"yearling","s":[{"p":"noun","d":[{"m":"(countable) A yearling is an animal that is one year old. This animal is most often a deer or a horse."}]}]},"reporter":{"h":"reporter","i":"/riːˈpɔːtə/","a":"en-us-reporter.ogg","s":[{"p":"noun","d":[{"m":"(countable) A reporter is a person whose job is to learn and tell the news.","e":"I think the reporter on \"Chanel 8 Evening News\" is very good looking."}]}]},"questioner":{"h":"questioner","s":[{"p":"noun","d":[{"m":"(countable) A questioner is someone who asks questions.","e":"My questioners asked about things I didn't want to tell; then they got mad."}]}]},"questionnaire":{"h":"questionnaire","i":"/ˌk(w)estʃəˈnɛə/","a":"LL-Q1860 (eng)-Vealhurl-questionnaire.wav","s":[{"p":"noun","d":[{"m":"(countable) A questionnaire is a group of questions that go together, and are asked together.","e":"The researchers were giving questionnaire to anyone who would take it."}]}]},"proposal":{"h":"proposal","i":"/prəˈpəʊzəl/","a":"en-us-propose.ogg","s":[{"p":"noun","d":[{"m":"(countable) A proposal is something that someone suggests doing.","e":"That was an interesting proposal."},{"m":"(countable) A proposal is when you ask someone to marry you.","e":"She finally accepted my proposal last night."},{"m":"(countable) A proposal is a formal plan to do research, that a school other agency may have to agree to let you do.","e":"My thesis proposal was finally accepts."}]}]},"victorian":{"h":"Victorian","i":"/vɪkˈtɔːriən/","a":"LL-Q1860 (eng)-Vealhurl-Victorian.wav","s":[{"p":"adjective","d":[{"m":"From the time when Victoria I was queen of England (1837–1901)."},{"m":"If something is Victorian, it is like something from the time of Queen Victoria I.","e":"She was wearing a long, Victorian dress."}]},{"p":"noun","d":[{"m":"A Victorian is a type of house built in late 1800's, or made to look like it was.","e":"I wish I could afford to live in a Victorian."},{"m":"(countable) A Victorian is a person from the Victorian era (late 1800's).","e":"The Victorians followed codes of conduct that seems very strict today."}]}]},"reviewed":{"h":"reviewed","l":"review","q":"verb"},"reviewing":{"h":"reviewing","l":"review","q":"verb"},"politician":{"h":"politician","i":"/ˈpɒl.ɪ.tɪʃ.ən/","a":"en-us-politician.ogg","s":[{"p":"noun","d":[{"m":"(countable) A politician is a person who is involved in politics, especially those in elected offices."},{"m":"(countable) A politician is a person who considers an elected position a career."},{"m":"(countable) A politician is a person who is active in politics."}]}]},"politicians":{"h":"politicians","a":"en-us-politicians.ogg","l":"politician","q":"noun"},"questionnaires":{"h":"questionnaires","l":"questionnaire","q":"noun"},"questioners":{"h":"questioners","l":"questioner","q":"noun"},"ore":{"h":"ore","i":"/ɔː/","a":"en-us-ore.ogg","s":[{"p":"noun","d":[{"m":"(countable) Ore is stone that has a mineral in it, often a metal. The ore must be processed to get the metal or mineral out.","e":"This train carries iron ore from the mine to the steel mill."}]}]},"arrest":{"h":"arrest","i":"/əˈrɛst/","a":"en-us-arrest.ogg","s":[{"p":"verb","d":[{"m":"If you are arrested you are caught by the police."},{"m":"If something arrests something else, it stops it.","e":"His development was arrested by the disease."},{"m":"If something arrests it stops.","e":"We called the ambulance after his heart arrested this morning."}]},{"p":"noun","d":[{"m":"An arrest is when the police catch someone.","e":"They made several arrests last night."},{"m":"An arrest is someone caught by the police.","e":"Hey, that punk was my arrest, don't you try to take credit."},{"m":"An arrest is stopping, most often used for the heart.","e":"He went into cardiac arrest (his heart stopped) at 8:37 this morning."}]}]},"profession":{"h":"profession","i":"/prəˈfɛʃən/","a":"en-us-profession.ogg","s":[{"p":"noun","d":[{"m":"(countable) A profession is a job that needs special skills, such as a doctor.","e":"Teaching is often considered a noble profession."}]}]},"engineer":{"h":"engineer","i":"/ˌɛnd͡ʒɪˈnɪr/","a":"en-us-engineer.ogg","s":[{"p":"noun","d":[{"m":"(countable) An engineer is someone who is paid to solve technical problems, or to help invent things."},{"m":"(countable) An engineer is someone who drives a train."}]},{"p":"verb","d":[{"m":"(transitive) If you engineer something, you design or construct something.","e":"The man will engineer a new kind of car."},{"m":"(transitive) If you engineer something, you make or alter something by genetic engineering."},{"m":"(transitive) If you enginner something, you plan or achieve a goal with guile."}]}]},"association":{"h":"association","i":"/əˌsəʊʃiˈeɪʃən/","a":"en-us-association.ogg","s":[{"p":"noun","d":[{"m":"(countable) An association is a way that two things are similar, belong together, or are connected or related.","e":"I don't see any association between what happened to you and what happened to me."},{"m":"(countable) An association is a group of people who have a common goal or interest.","e":"The NBA stands for the \"National Basketball Association.\""},{"m":"(uncountable) Association is the when you associate (spend time with certain people).","e":"I'm afraid your association with those wild people will get you in trouble."}]}]},"associations":{"h":"associations","i":"/əˌsoʊʃiˈeɪʃənz/","a":"en-us-associations.ogg","l":"association","q":"noun"},"friendship":{"h":"friendship","i":"/ˈfrɛndʃɪp/","a":"en-us-friendship.ogg","s":[{"p":"noun","d":[{"m":"Friendship is being friends with someone.","e":"Our friendship began in childhood."}]}]},"friendships":{"h":"friendships","l":"friendship","q":"noun"},"fortunate":{"h":"fortunate","i":"/ˈfɔːt͡ʃənɪt/","a":"en-us-fortunate.ogg","s":[{"p":"adjective","d":[{"m":"If you are fortunate good things have happened to you, or you have good things.","e":"You are very fortunate to have such good friends."},{"m":"If something fortunate happens, it is a good thing.","e":"Winning that prize was a very fortunate event for me."}]}]},"mill":{"h":"mill","i":"/mɪl/","a":"en-us-mill.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mill is a place where things are processed with machines."},{"m":"(countable) A mill is a small machine for grinding.","e":"We have a hand held pepper mill at home."}]},{"p":"verb","d":[{"m":"(transitive) If you mill grain, you grind it at a mill.","e":"You must dry and mill the corn before you can make bread with it."}]}]},"mills":{"h":"mills","i":"/mɪlz/","a":"en-us-mills.ogg","l":"mill","q":"noun"},"cattle":{"h":"cattle","i":"/ˈkæt(ə)l/","a":"en-us-cattle.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Cattle are a group of cows or bulls, whether they are male or female.","e":"The cattle are grazing (eating grass) in the field."}]}]},"engineers":{"h":"engineers","a":"En-us-engineers.ogg","l":"engineer","q":"noun"},"engineered":{"h":"engineered","a":"en-us-engineered.ogg","l":"engineer","q":"verb"},"judgements":{"h":"judgements","l":"judgement","q":"noun"},"caps":{"h":"caps","i":"/kæps/","a":"en-us-caps.ogg","l":"cap","q":"noun"},"capped":{"h":"capped","i":"/kæpt/","a":"en-us-capped.ogg","l":"cap","q":"verb"},"capping":{"h":"capping","i":"/ˈkapɪŋ/","a":"en-us-capping.ogg","l":"cap","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A capping is rock that lies over a mineral deposit."}]}]},"cappings":{"h":"cappings","a":"en-us-cappings.ogg","l":"capping","q":"noun"},"labeled":{"h":"labeled","l":"label","q":"verb"},"labeling":{"h":"labeling","l":"label","q":"verb"},"lunar":{"h":"lunar","i":"/ˈl(j)uːnə/","a":"en-us-lunar.ogg","s":[{"p":"adjective","d":[{"m":"If something is lunar, it is of or it relates to the Moon."},{"m":"If something is lunar, it is crescent-shaped; it is lunate."}]}]},"polyglotism":{"h":"polyglotism","s":[{"p":"noun","d":[{"m":"(uncountable) Polyglotism is the ability to use more than one language."}]}]},"polyglotisms":{"h":"polyglotisms","l":"polyglotism","q":"noun"},"abnormal":{"h":"abnormal","i":"/æbˈnɔrməl/","a":"en-us-abnormal.ogg","s":[{"p":"adjective","d":[{"m":"An abnormal thing, or situation, is one that is strange, or not typical.","e":"The weather is abnormal in Europe when it is hot in winter."},{"m":"When something is abnormal, it often means that it is bigger than [[normal].","e":"The company made abnormal profits this year."}]}]},"abrupt":{"h":"abrupt","i":"/ə.brʌpt/","a":"en-us-abrupt.ogg","s":[{"p":"adjective","d":[{"m":"An abrupt action is one that is sudden, or not expected.","e":"There was an abrupt change in the weather, and it started raining before we could get home."},{"m":"An abrupt landscape is one with sudden steep changes.","e":"We came to a halt because we could not pass the abrupt cliffs."}]}]},"qualia":{"h":"qualia","l":"quale","q":"noun"},"archon":{"h":"archon","i":"/'ɑ:kən/","a":"en-us-archon.ogg","s":[{"p":"noun","d":[{"m":"(countable) An archon is a ruler, head of state, or other kind of leader."},{"m":"(countable) An archon is a head magistrate or leader of ancient Athens."},{"m":"(gnosticism) (countable) An archon is a mystical being that serves the Demiurge."}]}]},"archons":{"h":"archons","a":"en-us-archons.ogg","l":"archon","q":"noun"},"smiles":{"h":"smiles","l":"smile","q":"verb"},"smiled":{"h":"smiled","i":"/smaɪld/","a":"en-us-smiled.ogg","l":"smile","q":"verb"},"smiling":{"h":"smiling","i":"/ˈsmaɪlɪŋ/","a":"en-us-smiling.ogg","l":"smile","q":"verb"},"quale":{"h":"quale","s":[{"p":"noun","d":[{"m":"(countable) A quale is a property that is thought of separately from whatever has that property."}]}]},"cowboy":{"h":"cowboy","i":"/ˈkaʊˌbɔɪ/","a":"en-au-cowboy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cowboy is a person who rides horses.","e":"The cowboy got on his horse."}]}]},"cowboys":{"h":"cowboys","l":"cowboy","q":"noun"},"blackbird":{"h":"blackbird","i":"/ˈblakbəːd/","a":"en-us-blackbird.ogg","s":[{"p":"noun","d":[{"m":"(countable) A blackbird is a dark-coloured bird."}]}]},"lockdown":{"h":"lockdown","i":"/ˈlɒkˌdaʊn/","a":"LL-Q1860 (eng)-Vealhurl-lockdown.wav","s":[{"p":"noun","d":[{"m":"(countable) A lockdown is when people must stay in a room (or their prison cell) for safety after a disturbance or threat.","e":"The prisoners were placed in lockdown after the fight."}]}]},"lockdowns":{"h":"lockdowns","l":"lockdown","q":"noun"},"alters":{"h":"alters","l":"alter","q":"verb"},"altered":{"h":"altered","i":"/ˈɔːl.təd/","a":"en-us-altered.ogg","l":"alter","q":"verb"},"altering":{"h":"altering","l":"alter","q":"verb"},"handwriting":{"h":"handwriting","i":"/ˈhændraɪtɪŋ/","a":"LL-Q1860 (eng)-Persent101-handwriting.wav","l":"handwrite","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) Handwriting is writing created by hand instead of computer."}]}]},"handwritings":{"h":"handwritings","l":"handwriting","q":"noun"},"lilliputian":{"h":"lilliputian","i":"/ˌlɪlɪˈpjuʃən/","a":"en-us-lilliputian.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lilliputian is something or someone that is very small.","e":"He is a lilliputian when he stands next to Joe because Joe is much taller than him."}]},{"p":"adjective","d":[{"m":"Something that is lilliputian is very small."}]}]},"lilliputians":{"h":"lilliputians","l":"lilliputian","q":"noun"},"oxidize":{"h":"oxidize","i":"/ˈɒksɪdaɪz/","a":"LL-Q1860 (eng)-Vealhurl-oxidize.wav","s":[{"p":"verb","d":[{"m":"; (transitive) If you oxidize something, you mix it with oxygen or make it into an oxide."},{"m":"If you oxidize something, you increase the valence of a chemical element by removing electrons from it."},{"m":"If you oxidize something, you cover it with an oxide."}]}]},"oxidise":{"h":"oxidise","i":"/ˈɒksɪdaɪz/","a":"LL-Q1860 (eng)-Vealhurl-oxidize.wav","s":[{"p":"verb","d":[{"m":"; (transitive) If you oxidise something, you mix it with oxygen or make it into an oxide."},{"m":"If you oxidise something, you increase the valence of a chemical element by removing electrons from it."},{"m":"If you oxidise something, you cover it with an oxide."}]}]},"oxidises":{"h":"oxidises","l":"oxidise","q":"verb"},"oxidised":{"h":"oxidised","l":"oxidise","q":"verb"},"oxidising":{"h":"oxidising","l":"oxidise","q":"verb"},"oxidizes":{"h":"oxidizes","l":"oxidize","q":"verb"},"oxidized":{"h":"oxidized","l":"oxidize","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is oxidized, it has reacted with oxygen."}]}]},"oxidizing":{"h":"oxidizing","l":"oxidize","q":"verb"},"unoxidized":{"h":"unoxidized","s":[{"p":"adjective","d":[{"m":"If something is unoxidized, it is not oxidized."}]}]},"petit":{"h":"petit","s":[{"p":"adjective","d":[{"m":"If something is petit, it is small or minor."}]}]},"realm":{"h":"realm","i":"/rɛlm/","a":"en-us-realm.ogg","s":[{"p":"noun","d":[{"m":"(countable) A realm is a kingdom, country or state which is ruled by a king or queen."},{"m":"(countable) A realm is the area of a certain abstraction."},{"m":"(countable) A realm is an abstract sphere of influence, either real or made up."}]}]},"realms":{"h":"realms","a":"en-us-realms.ogg","l":"realm","q":"noun"},"abstractness":{"h":"abstractness","i":"/æbˈstræk.nəs/","a":"LL-Q1860 (eng)-Vealhurl-abstractness.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Abstractness is the state or quality of being abstract.","e":"The painting had a sense of abstractness to it."}]}]},"joiners":{"h":"joiners","l":"joiner","q":"noun"},"michigan":{"h":"Michigan","i":"/ˈmɪ.ʃə.gən/","a":"en-us-Michigan.ogg","s":[{"p":"proper noun","d":[{"m":"Michigan is one of the 50 states of the United States of America.","e":"Michigan is called the 'Great Lakes State' because it is surrounded by lakes."}]}]},"bondage":{"h":"bondage","i":"/ˈbɑn.dɪd͡ʒ/","a":"en-us-bondage.ogg","s":[{"p":"noun","d":[{"m":"(uncountable)."},{"m":"(uncountable) A lack of freedom."},{"m":"(uncountable) The act of tying people up for sexual pleasure."}]}]},"iraq":{"h":"Iraq","i":"/ɪˈrɑːk/","a":"en-us-Iraq.ogg","s":[{"p":"proper noun","d":[{"m":"Iraq is a country in the Middle East."}]}]},"surname":{"h":"surname","i":"/ˈsɜː(r)neɪm/","a":"en-uk-surname.ogg","s":[{"p":"noun","d":[{"m":"(countable) A surname is a family name, sometimes called a last name.","e":"John Smith's surname is \"Smith\"."}]}]},"wallow":{"h":"wallow","s":[{"p":"verb","d":[{"m":"When you wallow in something, you rejoice and indulge in it to an unreasonable extent.","e":"Pigs like to wallow in the mud."},{"m":"When you wallow in an emotion, you fixate on it even if it causes false beliefs or harm.","e":"Tim Callow stated to Paul Bustion 'Ok, fine, wallow in your ignorance and believe Stalin supported Chiang'."}]}]},"wager":{"h":"wager","a":"En-us-wager.ogg","s":[{"p":"verb","d":[{"m":"If you wager, you make a bet (gamble).","e":"I can wager that Australians will win cricket world cup this time as well."}]},{"p":"noun","d":[{"m":"If you wager you make a bet; you gamble something.","e":"I made a big wager, but I won."}]}]},"corroborate":{"h":"corroborate","i":"/kəˈrɒbəreɪ̯t/","a":"en-us-corroborate.ogg","s":[{"p":"verb","d":[{"m":"If you corroborate a story or idea, you confirm, support or provide evidence for it.","e":"Who could corroborate existence of a supernatural god?"}]}]},"lethal":{"h":"lethal","i":"/liːθəl/","a":"LL-Q1860 (eng)-Vealhurl-lethal.wav","s":[{"p":"adjective","d":[{"m":"If something is lethal, it can kill a person or thing.","e":"Cobra's poison is lethal."},{"m":"If something was lethal, it killed a person or thing.","e":"The bite was lethal in only a few hours."}]}]},"idiosyncrasy":{"h":"idiosyncrasy","i":"/ˌɪd.i.əʊˈsɪŋ.krə.si/","a":"en-au-idiosyncrasy.ogg","s":[{"p":"noun","d":[{"m":"(countable) An idiosyncrasy is behavior that is characteristic of someone in particular."},{"m":"(countable) An idiosyncrasy is a behavior or language that is particular to a certain group or person."}]}]},"idiosyncrasies":{"h":"idiosyncrasies","l":"idiosyncrasy","q":"noun"},"corroborates":{"h":"corroborates","a":"En-us-corroborates.ogg","l":"corroborate","q":"verb"},"corroborated":{"h":"corroborated","l":"corroborate","q":"verb"},"corroborating":{"h":"corroborating","l":"corroborate","q":"verb"},"wagers":{"h":"wagers","l":"wager","q":"verb"},"wagered":{"h":"wagered","l":"wager","q":"verb"},"wagering":{"h":"wagering","l":"wager","q":"verb"},"wallows":{"h":"wallows","l":"wallow","q":"verb"},"wallowed":{"h":"wallowed","l":"wallow","q":"verb"},"wallowing":{"h":"wallowing","l":"wallow","q":"verb"},"panther":{"h":"panther","i":"/ˈpænθɚ/","a":"LL-Q1860 (eng)-Vealhurl-panther.wav","s":[{"p":"noun","d":[{"m":"(countable) A panther is large, wild cat; this most often means an leopard or a mountain lion.","e":"I enjoyed seeing the panthers at the zoo."},{"m":"(countable) A member of the genus Panthera (lions, tigers, leopards, and jaguars) may be called a panther."},{"m":"(countable) Panther can mean a member of the (an African American activist group)."}]}]},"puma":{"h":"puma","i":"/puːmə/","a":"en-au-puma.ogg","s":[{"p":"noun","d":[{"m":"(countable) A puma is a type of large cat that lives in North and South America.","e":"There are many pumas in South America, but they have become rare in North America."}]}]},"pumas":{"h":"pumas","l":"puma","q":"noun"},"leopard":{"h":"leopard","i":"/ˈlɛpəd/","a":"en-us-leopard.ogg","s":[{"p":"noun","d":[{"m":"(countable) A leopard is a type of large cat that has spots and lives in Africa and parts of Asia.","e":"People have sometimes hunted leopards for their beautiful skins."},{"m":"One of several other types of cat, such as a snow leopard or clouded leopard."}]}]},"jaguar":{"h":"jaguar","i":"/ˈdʒæɡjuːə/","a":"en-us-jaguar.ogg","s":[{"p":"noun","d":[{"m":"(countable) A jaguar is a large, spotted cat that lives in South America.","e":"The jaguar has the strongest bite of any cat, and likes to swim."},{"m":"(countable) A jaguar is a kind of luxury car."}]}]},"cheetah":{"h":"cheetah","i":"/ˈtʃiːtə/","a":"LL-Q1860 (eng)-Vealhurl-cheetah.wav","s":[{"p":"noun","d":[{"m":"(countable) A cheetah is a type of large cat that lives in Africa and parts of Asia.","e":"A cheetah can run faster than any other animal."}]}]},"cheetahs":{"h":"cheetahs","l":"cheetah","q":"noun"},"jaguars":{"h":"jaguars","l":"jaguar","q":"noun"},"leopards":{"h":"leopards","l":"leopard","q":"noun"},"panthers":{"h":"panthers","l":"panther","q":"noun"},"hamburger":{"h":"hamburger","i":"/ˈhæmbɜ:gə/","a":"LL-Q1860 (eng)-Vealhurl-hamburger.wav","s":[{"p":"noun","d":[{"m":"(countable) A hamburger is a sandwich made from meat in small pieces that are fried together.","e":"I'd like to have a hamburger and some fries."},{"m":"(countable) The cooked meat (patty) that is put into a hamburger.","e":"I'll be grilling hamburgers at the party."},{"m":"(uncountable) The ground (cut up) meat used to make hamburgers; ground meat.","e":"Would you get a pound of hamburger while you're at the store?"}]}]},"proposals":{"h":"proposals","l":"proposal","q":"noun"},"unities":{"h":"unities","l":"unity"},"shiny":{"h":"shiny","i":"/'ʃaɪni/","a":"en-us-shiny.ogg","s":[{"p":"adjective","d":[{"m":"If something is shiny it reflects light, or a makes light.","e":"The polished silver was very shiny."}]}]},"shines":{"h":"shines","l":"shine","q":"verb"},"shone":{"h":"shone","i":"/ʃɒn/","a":"en-ca-shone.ogg","l":"shine","q":"verb"},"shined":{"h":"shined","i":"/ʃaɪnd/","a":"LL-Q1860 (eng)-Vealhurl-shined.wav","l":"shine","q":"verb"},"shining":{"h":"shining","i":"/ˈʃaɪnɪŋ/","a":"en-us-shining.ogg","l":"shine","q":"verb"},"reflection":{"h":"reflection","i":"/rɪˈflɛkʃ(ə)n/","a":"en-us-reflection.ogg","s":[{"p":"noun","d":[{"m":"(countable) A reflection is an image made by reflected light, such as what you see in a mirror.","e":"The baby tried to touch his reflection in the water."},{"m":"(uncountable) Reflection is remembering.","e":"After his loss he spent a lot of time in reflection."}]}]},"dinosaurs":{"h":"dinosaurs","l":"dinosaur","q":"noun"},"recipes":{"h":"recipes","i":"/ˈrɛsəpiz/","l":"recipe","q":"noun"},"yearlings":{"h":"yearlings","l":"yearling","q":"noun"},"jean":{"h":"jean","i":"/dʒiːn/","a":"en-uk-jean.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Jean is another name for denim.","e":"Check out my new jean jacket."}]}]},"gene":{"h":"gene","i":"/dʒiːn/","a":"en-us-gene.ogg","s":[{"p":"noun","d":[{"m":"(countable) A gene is a chemical instruction in a person, animal, plant, or other living thing, telling how to make a protein. The genes are found in the nucleus (middle part) of cells, and tell how to make the organism (living thing).","e":"I have a blue-eye gene."}]}]},"genie":{"h":"genie","i":"/dʒiːni:/","a":"en-us-genie.ogg","s":[{"p":"noun","d":[{"m":"(countable) A genie is a type of magical person found in Arabic stories, and talked about in the Koran.","e":"There are many stories about genies in \"The 1001 Arabian Nights\"."}]}]},"hamburgers":{"h":"hamburgers","l":"hamburger","q":"noun"},"petite":{"h":"petite","i":"/pəˈtiːt/","a":"LL-Q1860 (eng)-Vealhurl-petite.wav","s":[{"p":"adjective","d":[{"m":"; if you are petite you are short and thin.","e":"My aunt is very petite, only about four-and-a-half feet tall."}]}]},"petty":{"h":"petty","i":"/ˈpɛti/","a":"en-us-petty.ogg","s":[{"p":"adjective","d":[{"m":"If something is petty it is small or not important.","e":"That is only a petty crime."},{"m":"If someone is petty they are bothered by petty things.","e":"Why must you be so petty all the time."}]}]},"reflections":{"h":"reflections","l":"reflection","q":"noun"},"genies":{"h":"genies","l":"genie","q":"noun"},"genes":{"h":"genes","l":"gene","q":"noun"},"reporters":{"h":"reporters","l":"reporter","q":"noun"},"voters":{"h":"voters","i":"/ˈvoʊtɚs/","l":"voter","q":"noun"},"chili":{"h":"chili","i":"/ˈt͡ʃɪli/","a":"en-uk-chilly.ogg","s":[{"p":"noun","d":[{"m":"(countable) A chili is a type of hot pepper, which may be eaten or used to make food spicy.","e":"I used to grow chilies in a flowerpot in my window."},{"m":"(uncountable) Chili is a type of food which is often made from ground (cut up) meat, beans, and hot peppers.","e":"The chili she made was delicious."}]}]},"chilly":{"h":"chilly","i":"/ˈtʃɪli/","a":"en-uk-chilly.ogg","s":[{"p":"adjective","d":[{"m":"If it is chilly it is a little bit cold, but not very cold.","e":"I wore a jacket because it was chilly outside."}]}]},"chilli":{"h":"chilli","i":"/ˈtʃɪl.iː/","a":"LL-Q1860 (eng)-Vealhurl-chilli.wav","s":[{"p":"noun","d":[{"m":"(countable) A chilli is a type of hot pepper, which may be eaten or used to make food spicy.","e":"I used to grow chillies in a flower pot in my window."},{"m":"(uncountable) Chilli is a type of food which is often made from ground (cut up) meat, beans, and hot peppers.","e":"The chilli she made was delicious."}]}]},"chillis":{"h":"chillis","l":"chilli","q":"noun"},"chillies":{"h":"chillies","l":"chilli","q":"noun"},"chiles":{"h":"chiles","l":"chile","q":"noun"},"chillun":{"h":"chillun","l":"chile","q":"noun"},"chillier":{"h":"chillier","l":"chilly","q":"adjective"},"chilliest":{"h":"chilliest","l":"chilly","q":"adjective"},"pettier":{"h":"pettier","l":"petty","q":"adjective"},"pettiest":{"h":"pettiest","l":"petty","q":"adjective"},"shinier":{"h":"shinier","l":"shiny","q":"adjective"},"shiniest":{"h":"shiniest","l":"shiny","q":"adjective"},"counterpart":{"h":"counterpart","i":"/ˈkaʊntəˌpɑːt/","a":"en-us-counterpart.ogg","s":[{"p":"noun","d":[{"m":"(countable) A counterpart is either of two parts that fit together, or complement one another."},{"m":"(countable) A counterpart is a duplicate of a legal document."}]}]},"counterparts":{"h":"counterparts","l":"counterpart","q":"noun"},"chilies":{"h":"chilies","l":"chili","q":"noun"},"abstinence":{"h":"abstinence","i":"/'æbstιnəns/","a":"en-us-abstinence.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Abstinence is when someone is abstaining from something or when someone does not take part in something. It's usually used to refer to not drinking alcohol or not having sex.","e":"Abstinence stops you from getting drunk."}]}]},"vaster":{"h":"vaster","l":"vast","q":"adjective"},"vastest":{"h":"vastest","l":"vast","q":"adjective"},"acceptance":{"h":"acceptance","i":"/əkˈsɛp.təns/","a":"en-us-acceptance.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Acceptance is when someone agrees with something or accepts something.","e":"The acceptance of this man in his new role is big."}]}]},"acceptances":{"h":"acceptances","l":"acceptance","q":"noun"},"corneous":{"h":"corneous","i":"/ˈkɔːnɪəs/","s":[{"p":"adjective","d":[{"m":"If something is corneous, it contains or looks like a horn."}]}]},"meteor":{"h":"meteor","i":"/ˈmitiɚ/","a":"en-us-meteor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A meteor is a flash of light in the night sky that happens when matter from space enters Earths' atmosphere."}]}]},"meteors":{"h":"meteors","l":"meteor","q":"noun"},"meteoroid":{"h":"meteoroid","i":"/ˈmiːtɪərɔɪd/","a":"en-us-meteoroid.ogg","s":[{"p":"noun","d":[{"m":"; (countable) A meteoroid is a small piece of debris in a solar system that makes a meteor when it comes into contact with the atmosphere.","e":"When the meteoroid came into contact with Earth's atmosphere, it made a meteor."}]}]},"meteoroids":{"h":"meteoroids","l":"meteoroid","q":"noun"},"bidet":{"h":"bidet","i":"[bɨˈdeɪ]","a":"en-us-bidet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bidet is a small ceramic object which looks like a toilet. It is used for cleaning the genitalia and other parts of the body","e":"We had a bidet fitted in our new bathroom."}]}]},"wanker":{"h":"wanker","i":"/ˈwæŋkə(r)/","a":"en-uk-wanker2.ogg","s":[{"p":"noun","d":[{"m":"(countable) A wanker is a person who wanks."},{"m":"(countable) A wanker is an idiot, stupid, or an annoying person.","e":"I thought he was a complete wanker."},{"m":"(countable) A wanker is a person who shows off too much (is too proud)."}]}]},"wankers":{"h":"wankers","l":"wanker","q":"noun"},"bidets":{"h":"bidets","l":"bidet","q":"noun"},"fags":{"h":"fags","l":"fag","q":"noun"},"hennas":{"h":"hennas","l":"henna","q":"noun"},"paperwork":{"h":"paperwork","i":"/ˈpeɪ.pɚˌwɝk/","a":"LL-Q1860 (eng)-Vealhurl-paperwork.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Paperwork is a task or number of tasks that involves a lot of the same written work.","e":"The police officer had to fill out paperwork for the accident that happened earlier."}]}]},"atmosphere":{"h":"atmosphere","i":"/ˈæt.məsˌfɛə(r)/","a":"en-us-atmosphere.ogg","s":[{"p":"noun","d":[{"m":"; (countable) An atmosphere is a layer of gasses that surrounds a planet."},{"m":"(uncountable) The atmosphere is the air in a certain place."},{"m":"(uncountable) The atmosphere of a place is the mood or feeling of that place."},{"m":"(countable) An atmosphere is a unit of measurement for pressure."}]}]},"atmospheres":{"h":"atmospheres","l":"atmosphere","q":"noun"},"bathes":{"h":"bathes","l":"bath","q":"verb"},"modest":{"h":"modest","i":"/ˈmɑdəst/","a":"en-us-modest.ogg","s":[{"p":"adjective","d":[{"m":"If you are modest, you do not show too much pride for what you've done, what you have, or what you can do","e":"Look at that painting... You are an amazing artist!"},{"m":"If something is modest, it is very simple; not being showy or highly decorated"},{"m":"If something is modest, it is limited or moderate in amount","e":"She supported her two children on the modest salary of a secretary."}]}]},"googles":{"h":"googles","l":"google","q":"verb"},"googled":{"h":"googled","l":"google","q":"verb"},"googling":{"h":"googling","l":"google","q":"verb"},"germination":{"h":"germination","s":[{"p":"noun","d":[{"m":"(uncountable) Germination refers to the start of growth of a plant spore or seed.","e":"Germination of spores happen as soon as temperature is right, and there is water."}]}]},"germinations":{"h":"germinations","l":"germination","q":"noun"},"germinate":{"h":"germinate","i":"/ˈdʒəːmɪneɪt/","a":"LL-Q1860 (eng)-Vealhurl-germinate.wav","s":[{"p":"verb","d":[{"m":"To sprout, grow, produce buds, or put forth shoots."},{"m":"To cause ideas to develop."}]}]},"germinates":{"h":"germinates","l":"germinate","q":"verb"},"germinated":{"h":"germinated","l":"germinate","q":"verb"},"germinating":{"h":"germinating","l":"germinate","q":"verb"},"disciplinary":{"h":"disciplinary","i":"/dɪsɪˈplɪnəri/","a":"en-us-disciplinary.ogg","s":[{"p":"adjective","d":[{"m":"If something is disciplinary, it is connected to discipline.","e":"When the manager took stock home, he attended a disciplinary meeting."},{"m":"If something is disciplinary, it is for imposing discipline.","e":"The school said that they would take disciplinary action against any students who took part in the protest march."}]}]},"discipline":{"h":"discipline","i":"/ˈdɪ.sə.plɪn/","a":"en-us-discipline.ogg","s":[{"p":"noun","d":[{"m":"A disciplined attitude is a controlled behaviour; self-control."},{"m":"Discipline is a method to force people to obey someone (or a group of people like a government)."},{"m":"Discipline is an academic subject-matter. It is a specific part of knowledge or learning."}]},{"p":"verb","d":[{"m":"(transitive) If someone is disciplined, they are train a person by using instruction and practice."},{"m":"(transitive) If a person disciplines someone, they teach a person to obey authority."},{"m":"(transitive) If someone is disciplined, they are punished or gotten control of (or to get control back)."},{"m":"(transitive) To impose order on a person."}]}]},"disciplines":{"h":"disciplines","l":"discipline","q":"noun"},"disciplining":{"h":"disciplining","l":"discipline","q":"verb"},"disciplined":{"h":"disciplined","l":"discipline","q":"verb"},"acidly":{"h":"acidly","s":[{"p":"adverb","d":[{"m":"If something is done acidly, it is done in a sour or tart manner."}]}]},"temperate":{"h":"temperate","i":"/ˈtɛmpərət/","a":"en-us-temperate.ogg","s":[{"p":"adjective","d":[{"m":"If something is temperate, then it is in the middle; it is moderate or not excessive; the temperate was not too hot, but not too cold."},{"m":"If something is temperate, it is not violent; it is cool.","e":"The whole of Europe lies in the temperate region."}]}]},"alien":{"h":"alien","i":"/ˈeɪ.li.ən/","a":"en-us-alien.ogg","s":[{"p":"noun","d":[{"m":"(countable) An alien is a person, animal, plant or thing that is not part of the group you look at."},{"m":"(countable) An alien is a person who lives in a foreign country."},{"m":"(countable) An alien is a living thing that is not from earth.","e":"Nobody has ever seen an alien."}]},{"p":"adjective","d":[{"m":"If something is alien, it is strange or unfamiliar to you."}]}]},"aliens":{"h":"aliens","l":"alien","q":"noun"},"remnant":{"h":"remnant","i":"/ˈrɛmnənt/","a":"LL-Q1860 (eng)-Vealhurl-remnant.wav","s":[{"p":"noun","d":[{"m":"(countable) A remnant is the small part of something that is left after the rest is removed. Something left over.","e":"Today's rain is a remnant of the storm yesterday."}]}]},"remnants":{"h":"remnants","l":"remnant","q":"noun"},"supercalifragilisticexpialidocious":{"h":"supercalifragilisticexpialidocious","i":"/ˌsupɚˌkælɪ̈ˌfræd͡ʒɪ̈ˌlɪstɪkˌɛkspiˌælɪ̈ˈdoʊʃəs/","a":"Supercalifragilisticexpialidocious.ogg","s":[{"p":"adjective","d":[{"m":"Something that is very great or wonderful."}]}]},"luna":{"h":"Luna","i":"/ˈlunə/","s":[{"p":"proper noun","d":[{"m":"Luna is the name of Earth's moon."},{"m":"Luna is the Roman name for the Greek goddess of the moon, Selene."}]}]},"gaia":{"h":"Gaia","s":[{"p":"proper noun","d":[{"m":"Gaia is the mother of all things in Greek mythology."}]}]},"click":{"h":"click","i":"/'klɪk/","a":"en-uk-click.ogg","s":[{"p":"noun","d":[{"m":"(countable) Click is the act of operating a switch so that it clicks."}]},{"p":"verb","d":[{"m":"(transitive) If you click on something, you use a computer mouse and push a button.","e":"The computer wants me to click this button."},{"m":"(transitive) If you click on a website, you visit that website.","e":"Click simple.wiktionary.org to visit the main page of the Simple English Wiktionary."}]}]},"clicks":{"h":"clicks","l":"click","q":"noun"},"clicked":{"h":"clicked","l":"click","q":"verb"},"clicking":{"h":"clicking","l":"click","q":"verb"},"cement":{"h":"cement","i":"/səˈmɛnt/","a":"en-us-cement.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Cement is a material which is used to build a building.","e":"The cement is not yet dry."}]},{"p":"verb","d":[{"m":"To join things together, with or as if with [[#Noun|cement]]","e":"The fence posts were cemented into the ground."},{"m":"Make sure that something happens.","e":"Since his father was a friend of his employer, the man cemented his position in the company."}]}]},"cements":{"h":"cements","l":"cement","q":"noun"},"cancer":{"h":"cancer","i":"/ˈkæːnsə/","a":"en-us-cancer.ogg","s":[{"p":"noun","d":[{"m":"Cancer is a disease where cells grow to a tumor.","e":"Smoking is the main cause of lung cancer."}]}]},"cancers":{"h":"cancers","l":"cancer","q":"noun"},"paganisms":{"h":"paganisms","l":"paganism","q":"noun"},"immigrations":{"h":"immigrations","l":"immigration","q":"noun"},"cemented":{"h":"cemented","l":"cement","q":"verb"},"cementing":{"h":"cementing","l":"cement","q":"verb"},"pacific":{"h":"Pacific","s":[{"p":"proper noun","d":[{"m":"The Pacific is a name for the Pacific Ocean."}]}]},"napalms":{"h":"napalms","l":"napalm","q":"verb"},"napalmed":{"h":"napalmed","l":"napalm","q":"verb"},"napalming":{"h":"napalming","l":"napalm","q":"verb"},"nationalizations":{"h":"nationalizations","l":"nationalization","q":"noun"},"resign":{"h":"resign","i":"/ˌrəˈzaɪn/","a":"LL-Q1860 (eng)-Vealhurl-resign (verb).wav","s":[{"p":"verb","d":[{"m":"If someone resigns from a job, they quit it.","e":"He resigned his job when his fellow workers were attacked."},{"m":"If you resign something, you sign it again."}]}]},"resigns":{"h":"resigns","l":"resign","q":"verb"},"resigned":{"h":"resigned","l":"resign","q":"verb"},"resigning":{"h":"resigning","l":"resign","q":"verb"},"marker":{"h":"marker","i":"/ˈmɑː(r)kə(r)/","a":"en-au-marker.ogg","s":[{"p":"noun","d":[{"m":"(countable) A marker is used to mark a spot."},{"m":"(countable) A marker is something or someone that marks."},{"m":"(countable) A marker is a felt-tipped pen."},{"m":"(countable) A marker is a note about how much money is owed."},{"m":"(countable) A marker is a debt owed to someone that is not money, especially favors.","e":"We may not be able to do this alone. Maybe it’s time to call in some of our markers."},{"m":"(countable) (paintball) A marker is a device that shoots paintballs.","e":"He used his marker to shoot him with a red paintball."}]},{"p":"verb","d":[{"m":"If something is markered, it is written or marked on it using a [[#Noun|marker]]."}]}]},"markers":{"h":"markers","l":"marker","q":"noun"},"markered":{"h":"markered","l":"marker","q":"verb"},"markering":{"h":"markering","l":"marker","q":"verb"},"lowercase":{"h":"lowercase","i":"/ˈləʊ.ə(r)ˌkeɪs/","a":"LL-Q1860 (eng)-Vealhurl-lowercase.wav","s":[{"p":"adjective","d":[{"m":"Something that is spelled in lower case.","e":"The word \"dad\" is written in lowercase."}]}]},"museum":{"h":"museum","i":"/mjuːˈziːəm/","a":"en-us-museum.ogg","s":[{"p":"noun","d":[{"m":"(countable) A museum is a building where pictures, sculptures and other arts are shown.","e":"There are several museums in Paris."}]}]},"museums":{"h":"museums","l":"museum","q":"noun"},"mucus":{"h":"mucus","i":"/mjuːkəs/","a":"LL-Q1860 (eng)-Vealhurl-mucous.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Mucus is a secrete that is produced in the mucous membranes.","e":"The man threw out a lot of mucus when he sneezed."}]}]},"trap":{"h":"trap","i":"/træp/","a":"en-us-trap.ogg","s":[{"p":"noun","d":[{"m":"A trap is a machine or other device made to catch and sometimes kill animals.","e":"He uses traps to deal with his mice problem."},{"m":"A trap is a trick made to catch someone more generally.","e":"She fell into the trap of misspelling \"misspelling.\""},{"m":"A trap is the cover over a hole or opening; a trapdoor.","e":"Close the trap before someone falls"},{"m":"A trap is any device used to hold and suddenly let go of an object.","e":"They shot out of the school gates like greyhounds out of the trap."},{"m":"A trap is a device in a pipe set up to hold and seal liquids and stops gases and lets liquids flow."},{"m":"A trap is a place in a water pipe or pump where air gathers."},{"m":"A trap is a light two-wheeled carriage with springs.","e":"Have James prepare the trap – I wish to visit the parson."},{"m":"A trap is a kind of ladder."},{"m":"A trap is a person's mouth.","e":"Keep your trap shut."},{"m":"A trap is a transvestite, or a man who dresses as a woman, who goes with a man pretend to be a woman.","e":"I saw your brother asking a trap out last night at the bar."},{"m":"A trap is exception made by the processor."},{"m":"(Australia) A mining license inspector during the Australian gold rush."},{"m":"Trap is dark colored rock."},{"m":"(uncountable) Trap is a type of music."}]},{"p":"verb","d":[{"m":"(transitive) To trap something is to catch in a trap."},{"m":"(transitive) To trap something is to ensnare it."},{"m":"(transitive) To trap is to provide something with a trap."},{"m":"(intransitive) To trap id to set traps for game; to make a business of trapping game."},{"m":"(intransitive) To trap is to leave suddenly or flee."},{"m":"(intransitive) To trap is to capture something such as a mistake so someone can fix it."}]}]},"traps":{"h":"traps","l":"trap","q":"noun"},"trapped":{"h":"trapped","l":"trap","q":"verb"},"trapping":{"h":"trapping","l":"trap","q":"verb"},"hyphenation":{"h":"hyphenation","i":"/ˌhaɪfəˈneɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-hyphenation.wav","s":[{"p":"noun","d":[{"m":"Hyphenation is the inclusion of hyphens; it mainly refers to their correct use.","e":"Print the article without hyphenation if you are not sure where to put them."}]}]},"hyphenations":{"h":"hyphenations","l":"hyphenation","q":"noun"},"acidic":{"h":"acidic","i":"/əˈsɪdɪk/","a":"LL-Q1860 (eng)-Vealhurl-acidic.wav","s":[{"p":"adjective","d":[{"m":"Something that is acidic has a pH level less than 7, is sour, and makes basic solutions more neutral."},{"m":"(mineralogy) Something that is acidic has a high percentage of silica."},{"m":"Something that is acidic is of or related to acid or has the characteristics of an acid.","e":"Lemon juice is an acidic solution"}]}]},"nod":{"h":"nod","i":"/nɒd/","a":"en-us-nod.ogg","s":[{"p":"verb","d":[{"m":"If you nod, then you move your head up and down to say that you agree with something.","e":"I asked him if he wanted an ice cream, and he nodded in agreement."}]},{"p":"noun","d":[{"m":"(countable) A nod is when someone moves their head up and down to agree with something or say \"yes\"."}]}]},"nods":{"h":"nods","l":"nod","q":"verb"},"nodded":{"h":"nodded","i":"/ˈnɒdɪd/","a":"en-us-nodded.ogg","l":"nod","q":"verb"},"nodding":{"h":"nodding","l":"nod","q":"verb"},"monthly":{"h":"monthly","i":"/ˈmʌnθli/","a":"en-us-monthly.ogg","s":[{"p":"adverb","d":[{"m":"If something is monthly, then it happens or comes once in a month.","e":"This magazine is monthly."}]},{"p":"noun","d":[{"m":"(countable) A monthly is a magazine that is published every month."}]}]},"monthlies":{"h":"monthlies","l":"monthly","q":"noun"},"grove":{"h":"grove","i":"/ɡrəʊv/","a":"en-us-grove.ogg","s":[{"p":"noun","d":[{"m":"(countable) A grove is a small group of trees.","e":"The bird landed in a tree in the orange grove."}]}]},"groves":{"h":"groves","l":"grove","q":"noun"},"maneuver":{"h":"maneuver","i":"/məˈnuːvɚ/","a":"en-us-maneuver.ogg","s":[{"p":"noun","d":[{"m":"A maneuver is a planned action with a series of stages. It gets to a goal not directly, but by steps. If in a contest, it may involve deception, with the purpose hidden as long as possible. A maneuver may be simple or extremely complex.","e":"This was the maneuver: to bring his opponent into the net, and follow with a lob or a passing shot."},{"m":"A skilfull or subtle plan.","e":"His plan was a clever maneuver."}]},{"p":"verb","d":[{"m":"(transitive) If something is maneuverd, it is moved somewhere else, generally with difficulty.","e":"She maneuverd her car into the parking space."},{"m":"(transitive) If someone maneuvers a person, they manipulate, plot, guide, steer or manage them purposefully.","e":"She maneuverd him into a position where he had to do what she wanted."},{"m":"(intransitive) To do the action cleverly.","e":"She is manoeuvring."}]}]},"maneuvers":{"h":"maneuvers","l":"maneuver","q":"verb"},"maneuvered":{"h":"maneuvered","l":"maneuver","q":"verb"},"maneuvering":{"h":"maneuvering","l":"maneuver","q":"verb"},"manoeuvre":{"h":"manoeuvre","i":"/məˈnuːvɚ/","a":"en-us-maneuver.ogg","s":[{"p":"noun","d":[{"m":"A manoeuvre is a planned action with a series of stages. It gets to a goal not directly, but by steps. If in a contest, it may involve deception, with the purpose hidden as long as possible. A manoeuvre may be simple or extremely complex.","e":"This was the manoeuvre: to bring his opponent into the net, and follow with a lob or a passing shot."},{"m":"A skilfull or subtle plan.","e":"His plan was a clever manoeuvre."}]},{"p":"verb","d":[{"m":"(transitive) If something is manoeuvred, it is moved somewhere else, generally with difficulty.","e":"She manoeuvred her car into the parking space."},{"m":"(transitive) If someone manoeuvres a person, they manipulate, plot, guide, steer or manage them purposefully.","e":"She manoeuvred him into a position where he had to do what she wanted."},{"m":"(intransitive) To do the action cleverly.","e":"She is manoeuvring."}]}]},"manoeuvres":{"h":"manoeuvres","l":"manoeuvre","q":"noun"},"manoeuvred":{"h":"manoeuvred","l":"manoeuvre","q":"verb"},"manoeuvring":{"h":"manoeuvring","l":"manoeuvre","q":"verb"},"depresses":{"h":"depresses","l":"depress","q":"verb"},"numbering":{"h":"numbering","l":"number","q":"verb"},"skeptics":{"h":"skeptics","l":"skeptic","q":"noun"},"crazed":{"h":"crazed","i":"/kreɪzd/","a":"en-us-crazed.ogg","s":[{"p":"adjective","d":[{"m":"If someone is crazed, they have gone out of their mind, or are crazy.","e":"The man was crazed from drinking too much alcohol."}]}]},"honesties":{"h":"honesties","l":"honesty","q":"noun"},"bluebird":{"h":"bluebird","i":"/ˈbluˌbɝd/","a":"LL-Q1860 (eng)-Vealhurl-bluebird.wav","s":[{"p":"noun","d":[{"m":"(countable) A bluebird is any North American bird in the genus Salia. Bluebirds have red and blue feathers."}]}]},"t-shirt":{"h":"T-shirt","i":"/ˈtiːʃɜːt/","a":"LL-Q1860 (eng)-Persent101-T-shirt.wav","s":[{"p":"noun","d":[{"m":"(countable) A T-shirt is a light shirt made of cotton and short sleeves and can have a picture or logo."}]}]},"t-shirts":{"h":"t-shirts","l":"t-shirt","q":"noun"},"bluebirds":{"h":"bluebirds","l":"bluebird","q":"noun"},"utah":{"h":"Utah","i":"/ˈju.tɑ/","a":"en-us-Utah.ogg","s":[{"p":"proper noun","d":[{"m":"Utah is a state in the United States.","e":"Salt Lake City is the capital of Utah."}]}]},"maine":{"h":"Maine","i":"/meɪn/","a":"en-us-Maine.ogg","s":[{"p":"proper noun","d":[{"m":"Maine is a state in the United States.","e":"Augusta is the capital of Maine."},{"m":"A province in northwest France."}]}]},"tan":{"h":"tan","i":"/tæn/","a":"LL-Q1860 (eng)-Vealhurl-tan.wav","s":[{"p":"noun","d":[{"m":"Tan is one of the colors people can see."},{"m":"A darkening of the skin from being in the sun.","e":"She still has a tan from her visit to Mexico."}]},{"p":"adjective","d":[{"m":"To be tan in color."}]},{"p":"verb","d":[{"m":"To turn an animal's skin into leather."},{"m":"To lie in the sun to darken your skin."},{"m":"To use a tanning bed to darken your skin."}]}]},"tans":{"h":"tans","l":"tan","q":"noun"},"tanner":{"h":"tanner","l":"tan","q":"adjective"},"tannest":{"h":"tannest","l":"tan","q":"adjective"},"wikinews":{"h":"Wikinews","a":"en-us-Wikinews.ogg","s":[{"p":"proper noun","d":[{"m":"(Wikimedia Foundation) Wikinews was a news wiki website that is part of the Wikimedia project."}]}]},"imminent":{"h":"imminent","i":"/ˈɪmɪnənt/","a":"en-uk-imminent.ogg","s":[{"p":"adjective","d":[{"m":"If something is imminent, it is probably going to happen soon.","e":"Because of all the rain, flooding is imminent."}]}]},"mugger":{"h":"mugger","i":"/ˈmʌɡɚ/","a":"LL-Q1860 (eng)-Vealhurl-mugger.wav","s":[{"p":"noun","d":[{"m":"(countable) A mugger is a person who attacks another person on the street and steals their money.","e":"The mugger knocked me down, took my bag and ran away."},{"m":"(countable) A type of crocodile."}]}]},"obliges":{"h":"obliges","l":"oblige","q":"verb"},"obliged":{"h":"obliged","a":"en-us-obliged.ogg","l":"oblige","q":"verb","s":[{"p":"adjective","d":[{"m":"To feel obligated to do something for someone, possibly because they have done a favor for you."}]}]},"obliging":{"h":"obliging","l":"oblige","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone is obliging, they are ready to do a favor."}]}]},"muggers":{"h":"muggers","l":"mugger","q":"noun"},"levity":{"h":"levity","s":[{"p":"noun","d":[{"m":"(uncountable) Levity is a feeling of not being serious, of being fun or funny."}]}]},"tricolor":{"h":"tricolor","s":[{"p":"adjective","d":[{"m":"If something is tricolor, it has three colors."}]},{"p":"noun","d":[{"m":"A tricolor is a banner or flag with three colored stripes."}]}]},"plows":{"h":"plows","l":"plow","q":"noun"},"plowed":{"h":"plowed","l":"plow","q":"verb"},"plowing":{"h":"plowing","l":"plow","q":"verb"},"reproduction":{"h":"reproduction","i":"/ˌriːprəˈdʌkʃən/","a":"en-us-reproduction.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Reproduction is the act of making a new living thing, such as a baby."},{"m":"(uncountable) Reproduction is the act of making a copy of something."},{"m":"(countable) A reproduction is a copy of something; a duplicate."}]}]},"tricolors":{"h":"tricolors","l":"tricolor","q":"noun"},"sawed":{"h":"sawed","l":"saw","q":"verb"},"sawn":{"h":"sawn","l":"saw","q":"verb"},"sawing":{"h":"sawing","l":"saw","q":"verb"},"italian":{"h":"Italian","i":"/ɪ.ˈtæl.jən/","a":"en-us-Italian.ogg","s":[{"p":"proper noun","d":[{"m":"Italian is a Romance language.","e":"John is studying Italian in school."}]},{"p":"noun","d":[{"m":"(countable) An Italian is a person from Italy."}]},{"p":"adjective","d":[{"m":"Something that is related to Italy.","e":"Our family has taken many trips to the Italian countryside."},{"m":"Something that is related to the Italian people."},{"m":"Something that is related to the Italian language.","e":"The Italian word \"ciao\" is a greeting known around the world."}]}]},"romance":{"h":"Romance","i":"/rəʊˈmæns/","a":"en-us-romance.ogg","s":[{"p":"adjective","d":[{"m":"Romance languages are languages that come from Latin.","e":"Italian, French, and Spanish are just a few Romance languages."}]},{"p":"proper noun","d":[{"m":"(uncountable) The group of languages that come from Latin."}]}]},"judoka":{"h":"judoka","i":"/d͡ʒuːˈdəʊkə/","a":"LL-Q1860 (eng)-Vealhurl-judoka.wav","s":[{"p":"noun","d":[{"m":"(countable) A judoka is someone who practices judo."}]}]},"judokas":{"h":"judokas","l":"judoka","q":"noun"},"reproductions":{"h":"reproductions","l":"reproduction","q":"noun"},"sicilian":{"h":"Sicilian","i":"/sɪ.ˈsɪl.jən/","a":"en-us-Sicilian.ogg","s":[{"p":"proper noun","d":[{"m":"Sicilian is a Romance language."}]},{"p":"noun","d":[{"m":"(countable) A Sicilian is a person from Sicily."}]},{"p":"adjective","d":[{"m":"Something that is related to Sicily."},{"m":"Something that is related to the Sicilian people."},{"m":"Something that is related to the Sicilian language."}]}]},"sicily":{"h":"Sicily","i":"/ˈsɪs.ə.li/","s":[{"p":"proper noun","d":[{"m":"Sicily is the biggest island in the Mediterranean Sea and one of the 20 regions of Italy."}]}]},"sicilians":{"h":"Sicilians","l":"sicilian","q":"noun"},"italians":{"h":"Italians","l":"italian","q":"noun"},"neapolitan":{"h":"Neapolitan","i":"/ni.ə.ˈpɒl.ɪ.tən/","a":"LL-Q1860 (eng)-Vealhurl-Neapolitan.wav","s":[{"p":"proper noun","d":[{"m":"Neapolitan is a Romance language."}]},{"p":"noun","d":[{"m":"(countable) A Neapolitan is a person from Naples, Italy."}]},{"p":"adjective","d":[{"m":"Something that is related to Naples, Italy."},{"m":"Something that is related to the people of Naples."},{"m":"Something that is related to the Neapolitan language."},{"m":"Neapolitan ice cream is made by putting chocolate, vanilla, and strawberry flavored ice cream next to each other."}]}]},"hub":{"h":"hub","i":"/hʌb/","a":"en-us-hub.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hub is the middle part of a wheel."},{"m":"(countable) A hub is a place where a large amount of traffic meets or passes through.","e":"London's Heathrow Airport is a big air traffic hub in Europe."},{"m":"(countable) A hub is a simple networking device that sends all of the data (packets) that it gets to all of the other devices that are connected to it.","e":"Mark bought a cheap hub to connect his home computers together."}]}]},"broom":{"h":"broom","i":"/bruːm/","a":"en-us-broom.ogg","s":[{"p":"noun","d":[{"m":"(countable) A broom is a cleaning tool made of bristles used for sweeping."}]},{"p":"verb","d":[{"m":"(transitive) If you broom something, it means that you use a [[#Noun|broom]] (or something like a broom) to sweep it.","e":"The young boy broomed the dirt off of the front stairs."}]}]},"surfing":{"h":"surfing","i":"/ˈsɝfɪŋ/","l":"surf","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) Surfing is a sport of riding water on a surfboard."}]}]},"disorganized":{"h":"disorganized","i":"/dɪˌsorɡəˌnaɪˈzeɪʃən/","a":"en-us-disorganized.ogg","l":"disorganize","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone is disorganized, they are not capable of being organised."},{"m":"If a place is disorganized, it is messy."}]}]},"civilized":{"h":"civilized","i":"/ˈsɪv.ɪ.laɪzd/","a":"en-us-civilised.ogg","l":"civilize","q":"verb","s":[{"p":"adjective","d":[{"m":"If a society or culture is civilized, it is advanced and very developed."},{"m":"If you are civilized, you have strong morals or are intellectually advanced."},{"m":"If you are civilized, you have good manners and are refined."}]}]},"jupiter":{"h":"Jupiter","i":"/ˈdʒuː.pɪ.tər/","a":"en-us-Jupiter.ogg","s":[{"p":"proper noun","d":[{"m":"Jupiter is the fifth planet from the sun in the Solar System.","e":"The biggest planet in the Solar System is Jupiter."},{"m":"In Roman mythology, Jupiter is the king of the gods. He is known as Zeus in Greek mythology."}]}]},"florida":{"h":"Florida","i":"/ˈflɒrɪdə/","a":"en-us-Florida.ogg","s":[{"p":"proper noun","d":[{"m":"Florida is a state in the south east of the United States of America.","e":"Tallahassee is the capital of Florida."}]}]},"fusion":{"h":"fusion","i":"/ˈfjuː.ʒən/","a":"LL-Q1860 (eng)-Back ache-Fusion.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Fusion is when two or more things come together as one."},{"m":"(uncountable), In physics, nuclear fusion is when the nuclei of two or more atoms come together to make one new, nucleus.","e":"Fusion reactions make a lot of energy."}]}]},"raisin":{"h":"raisin","i":"/ˈreɪ.zɪn/","a":"en-us-raisin.ogg","s":[{"p":"noun","d":[{"m":"(countable) A raisin is a dried grape.","e":"Raisins are a type of fruit."}]}]},"tutor":{"h":"tutor","i":"/ˈtjuːtə(r)/","a":"en-us-tutor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tutor is a person who teaches another person or a small group of people."}]},{"p":"verb","d":[{"m":"(transitive) If you tutor a person or a small group, you teach them."}]}]},"tutors":{"h":"tutors","l":"tutor","q":"noun"},"tutored":{"h":"tutored","l":"tutor","q":"verb"},"tutoring":{"h":"tutoring","l":"tutor","q":"verb"},"raisins":{"h":"raisins","l":"raisin","q":"noun"},"dim":{"h":"dim","i":"/dɪm/","a":"en-us-dim.ogg","s":[{"p":"adjective","d":[{"m":"If a thing is dim, it is not bright.","e":"It is hard to see in a room where the lights are dim."},{"m":"If a person is dim, they are not very smart."}]},{"p":"verb","d":[{"m":"(transitive) If you dim something, you make it darker.","e":"Before a movie starts, it is normal to dim the lights in the movie theater."},{"m":"(intransitive) If something dims, it gets darker.","e":"As time went by the fire dimmed."}]}]},"halt":{"h":"halt","i":"/hɔːlt/","a":"LL-Q1860 (eng)-I learned some phrases-halt.wav","s":[{"p":"verb","d":[{"m":"(transitive) When someone halts something, they make it stop.","e":"The contract negotiations halted operations for at least a week."},{"m":"(intransitive) When something halts, it stops.","e":"I spilled my drink when the train suddenly halted."}]}]},"pichilemu":{"h":"Pichilemu","s":[{"p":"proper noun","d":[{"m":"Pichilemu is a city in Chile.","e":"There was an earthquake in Pichilemu."}]}]},"halts":{"h":"halts","i":"/hɑlts/","a":"en-us-halts.ogg","l":"halt","q":"verb"},"halted":{"h":"halted","i":"/ˈhɔːltɪd/","a":"en-us-halted.ogg","l":"halt","q":"verb"},"halting":{"h":"halting","l":"halt","q":"verb"},"dimmer":{"h":"dimmer","l":"dim","q":"adjective"},"dimmest":{"h":"dimmest","l":"dim","q":"adjective"},"dims":{"h":"dims","l":"dim","q":"verb"},"dimmed":{"h":"dimmed","l":"dim","q":"verb"},"dimming":{"h":"dimming","l":"dim","q":"verb"},"dialogs":{"h":"dialogs","l":"dialog","q":"noun"},"butt":{"h":"butt","i":"/bʌt/","a":"en-us-butt.ogg","s":[{"p":"noun","d":[{"m":"(countable) Your butt is your bottom, your bum, the part of your body that you sit on.","e":"The exercise works your legs, butt, and back."},{"m":"(countable) When someone says, get your butt over/back/out of here, they mean move yourself.","e":"Get your butt over here. = come here"},{"m":"If someone or something is a pain in the butt, they are unpleasant or annoying.","e":"Stop that! You're such a pain in the butt."},{"m":"(countable) If you work/run/study/play your butt off, you do so very hard.","e":"We played our butts off in the game today, and we still lost."},{"m":"(countable) The butt of something is its end.","e":"He threw his cigarette butt on the ground."},{"m":"(countable) If you're the butt of a joke, people are laughing at you because the joke makes you seem foolish or bad.","e":"He hated being the butt of other people's jokes."},{"m":"(countable) (British) A butt is a large container for liquids.","e":"The rain flowed into the butt."}]},{"p":"verb","d":[{"m":"(transitive) If animals butt something, they hit it with their head or horns.","e":"The two goats butted each other and one fell over."},{"m":"(intransitive) If you butt up against something, you reach it or come into conflict with it; often used when something stops progress.","e":"The car butted up against the gate and could not go further."},{"m":"(intransitive) If two people butt heads, they disagree or argue strongly.","e":"The managers butted heads about the new schedule."},{"m":"(transitive) If you butt two things (for example, pipes or boards), you join their ends together so they meet directly.","e":"They butted the two metal pipes together before welding the joint."},{"m":"(intransitive) If you butt in, you interrupt a conversation or activity by speaking or acting when you should not.","e":"Please don't butt in while I'm talking."},{"m":"(intransitive) If you tell someone to butt out, you tell them not to interfere; to leave a matter alone.","e":"This is between them — you should butt out."}]}]},"buttock":{"h":"buttock","i":"/ˈbʌt.ək/","a":"En-us-buttock.ogg","s":[{"p":"noun","d":[{"m":"(usually plural) A buttock is one half of a person's backside or butt; people have a left buttock and a right buttock."}]}]},"buttocks":{"h":"buttocks","i":"/ˈbʌɾəks/","l":"buttock","q":"noun"},"sustain":{"h":"sustain","i":"/səˈsteɪn/","a":"en-us-sustain.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If something is sustained, it is maintained.","e":"I tried to sustain the energy level of the party by playing some rock music."},{"m":"(transitive) To provide for or nourish (something)."},{"m":"(transitive) If something sustains (an injury etc.), it experiences or suffers (from an injury etc.).","e":"The soldier sustained multiple shots and carried on to kill the enemy troops."}]}]},"sustains":{"h":"sustains","l":"sustain","q":"verb"},"sustained":{"h":"sustained","l":"sustain","q":"verb"},"sustaining":{"h":"sustaining","l":"sustain","q":"verb"},"zeshan":{"h":"Zeshan","s":[{"p":"proper noun","d":[{"m":"Zeshan is a male given name."}]}]},"sophomore":{"h":"sophomore","i":"/ˈsɒfəmɔə/","a":"en-us-sophomore.oga","s":[{"p":"noun","d":[{"m":"(countable) A student in his or her second year in a college or university, or the second year in a four-year high school.","e":"George is currently a sophomore at Yale University."}]},{"p":"adjective","d":[{"m":"(US) The second thing in a series, especially an artist's second album or the second of four years in high school or college.","e":"The band's sophomore album was much better than their debut album and gave them much more success."}]}]},"sophomores":{"h":"sophomores","l":"sophomore","q":"noun"},"marveled":{"h":"marveled","l":"marvel","q":"verb"},"marvelled":{"h":"marvelled","l":"marvel","q":"verb"},"marveling":{"h":"marveling","l":"marvel","q":"verb"},"marvelling":{"h":"marvelling","l":"marvel","q":"verb"},"lemon":{"h":"lemon","i":"/ˈlɛmən/","a":"en-uk-lemon.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lemon is a yellow citrus fruit that has a sour taste."},{"m":"(uncountable) A bright shade of yellow associated with lemon fruits.","e":"(flesh)"}]}]},"lime":{"h":"lime","i":"/laɪm/","a":"LL-Q1860 (eng)-Vealhurl-lime.wav","s":[{"p":"noun","d":[{"m":"(countable) A lime is a green citrus fruit that has a sour taste, like a lemon but usually smaller."},{"m":"(uncountable) Lime is a material containing calcium oxide or calcium hydroxide."},{"m":"(uncountable) The Limes was a defensive wall marking the northern borders of the Roman Empire."},{"m":"(uncountable) Lime is a color that people can see","e":"Lime is a color mixed by yellow and green."}]}]},"liberty":{"h":"liberty","i":"/ˈlɪbəti/","a":"en-us-liberty.ogg","s":[{"p":"noun","d":[{"m":"Liberty is the state of being free from someone else's control, not a slave or a prisoner.","e":"John isn't in prison anymore; he has regained his liberty."},{"m":"If someone has a lot of liberty, then they are free to do what they want.","e":"The chief editor gives Jane the liberty to write what she wants in her magazine column."}]}]},"diamond":{"h":"diamond","i":"/ˈdaɪ(ə)mənd/","a":"en-us-diamond.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Diamond is a very hard mineral made from carbon that is shiny like glass.","e":"The blades of cutting tools like saws and knives are sometimes coated in diamond."},{"m":"(countable) A diamond is a precious gemstone made from the mineral diamond.","e":"The diamond is the birthstone of April."},{"m":"(countable), In geometry, a diamond (◆) is a rhombus that is a square tilted at a 45-degree angle."},{"m":"(plural) In card games, the diamonds are one of the four playing card suits.","e":"The diamonds and the hearts are the two red-colored suits."},{"m":"(countable) In cards games, a diamond is a card of the diamond suit.","e":"I have three diamonds in my hand."}]}]},"limes":{"h":"limes","l":"lime","q":"noun"},"liberties":{"h":"liberties","a":"En-us-liberties.ogg","l":"liberty","q":"noun"},"diamonds":{"h":"diamonds","i":"/ˈdaɪ(ə)məndz/","a":"en-us-diamonds.ogg","l":"diamond","q":"noun"},"rhombus":{"h":"rhombus","i":"/ˈrɒmbəs/","a":"en-au-rhombus.ogg","s":[{"p":"noun","d":[{"m":"(countable) A rhombus is a shape that has two pairs of parallel sides that have the same length.","e":"All rhombuses are parallelograms, and all squares are rhombuses."}]}]},"fragile":{"h":"fragile","i":"/ˈfrædʒaɪl/","a":"en-us-fragile.ogg","s":[{"p":"adjective","d":[{"m":"If something is fragile then it is delicate and it will break easily."}]}]},"funeral":{"h":"funeral","i":"/ˈfjuːnərəl/","a":"en-us-funeral.ogg","s":[{"p":"noun","d":[{"m":"(countable) A funeral is a ceremony that honors someone who has died.","e":"Everyone's preparing to go to Mary's funeral on Saturday at her family's church."}]}]},"sorting":{"h":"sorting","l":"sort","q":"verb"},"sorted":{"h":"sorted","l":"sort","q":"verb"},"sorts":{"h":"sorts","a":"En-us-sorts.ogg","l":"sort","q":"verb"},"funerals":{"h":"funerals","i":"/ˈfjuː.nər.əlz/","l":"funeral","q":"noun"},"rhombuses":{"h":"rhombuses","l":"rhombus","q":"noun"},"rhombi":{"h":"rhombi","l":"rhombus","q":"noun"},"lemons":{"h":"lemons","i":"/ˈlɛmənz/","l":"lemon","q":"noun"},"pollution":{"h":"pollution","i":"/pəˈl(j)uːʃən/","a":"en-uk-pollution.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Pollution is when bad or harmful things are put into the environment.","e":"Nobody visits the river any more because of all the pollution."},{"m":"(uncountable) Pollution is the state of being polluted."}]}]},"grandpa":{"h":"grandpa","s":[{"p":"noun","d":[{"m":"(informal) A grandpa is a short name for a grandfather (the father of your father or mother)."}]}]},"grandpas":{"h":"grandpas","l":"grandpa","q":"noun"},"rival":{"h":"rival","i":"/ˈraɪvəl/","a":"en-us-rival.ogg","s":[{"p":"noun","d":[{"m":"(countable) Your rival is someone who is or fighting with you for the same thing; a competitor.","e":"Chris is my biggest rival in the 400 m race."},{"m":"Someone or something with similar quality or distinction as another; an equal.","e":"As a mountain climber, he has no rival in Switzerland."}]},{"p":"verb","d":[{"m":"(transitive) To oppose or compete with."},{"m":"To equal or surpass another."}]}]},"reversible":{"h":"reversible","i":"/rɪˈvɜːsəbl/","s":[{"p":"adjective","d":[{"m":"If something is reversible, you can reverse it."},{"m":"(clothing) If a piece of clothing is reversible, you can wear it inside out."},{"m":"If a chemical reaction is reversible, it can go in either direction."},{"m":"If something is reversible, it can return to how it once was."},{"m":"(thermodynamics) If something is reversible, it can return how it once was without using free energy or increasing entropy."}]}]},"mooned":{"h":"mooned","l":"moon","q":"verb"},"mooning":{"h":"mooning","l":"moon","q":"verb"},"feedback":{"h":"feedback","s":[{"p":"noun","d":[{"m":"(uncountable) A reaction or opinion of something.","e":"I'd really like some feedback on my poem."},{"m":"(uncountable) The high-pitched noise that you can hear when there's a loop between a microphone and a speaker."}]}]},"anomaly":{"h":"anomaly","i":"/əˈnɒməlɪ/","a":"en-us-anomaly.ogg","s":[{"p":"noun","d":[{"m":"(countable) A situation or thing that is not normal."}]}]},"anomalies":{"h":"anomalies","l":"anomaly","q":"noun"},"rivals":{"h":"rivals","l":"rival","q":"noun"},"rivaled":{"h":"rivaled","l":"rival","q":"verb"},"rivaling":{"h":"rivaling","l":"rival","q":"verb"},"rivalled":{"h":"rivalled","l":"rival","q":"verb"},"rivalling":{"h":"rivalling","l":"rival","q":"verb"},"brooms":{"h":"brooms","l":"broom","q":"noun"},"broomed":{"h":"broomed","l":"broom","q":"verb"},"brooming":{"h":"brooming","l":"broom","q":"verb"},"ordains":{"h":"ordains","l":"ordain","q":"verb"},"ordained":{"h":"ordained","l":"ordain","q":"verb"},"ordaining":{"h":"ordaining","l":"ordain","q":"verb"},"irreversible":{"h":"irreversible","i":"/ˌɪr.ɪˈvɜː.sə.bəl/","a":"LL-Q1860 (eng)-Vealhurl-irreversible.wav","s":[{"p":"adjective","d":[{"m":"If something is irreversible, you cannot reverse it."},{"m":"If something is irreversible, it cannot return to how it once was."},{"m":"(thermodynamics) If something is irreversible, it cannot return how it once was without using or entropy."}]}]},"linguolabial":{"h":"linguolabial","a":"En-us-linguolabial.ogg","s":[{"p":"adjective","d":[{"m":"In phonetics, a linguolabial sound is made by touching the upper lip with the tongue.","e":"Linguolabial sounds are very rare."}]}]},"phonetics":{"h":"phonetics","i":"/fəˈnɛtɪks/","a":"LL-Q1860 (eng)-Vealhurl-phonetics.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Phonetics is the study of the sounds of human speech or (movements, in the case of sign language)."}]}]},"pharmacy":{"h":"pharmacy","i":"/ˈfɑrməsi/","a":"en-uk-pharmacy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pharmacy is a place someone can get prescription medicine.","e":"On the way home I need to pick up my medicine at the pharmacy."},{"m":"(uncountable) Pharmacy is the study of chemicals and substances that are used as medicine."},{"m":"(uncountable) Pharmacy is the work that a pharmacist does."}]}]},"pharmacies":{"h":"pharmacies","i":"/ˈfɑrməsiz/","l":"pharmacy","q":"noun"},"ignored":{"h":"ignored","i":"/ɪɡˈnɔrd/","l":"ignore","q":"verb"},"phonology":{"h":"phonology","i":"/fəˈnɒl.ə.d͡ʒi/","a":"LL-Q1860 (eng)-Vealhurl-phonology.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Phonology is the study of the way that sounds (phones) carry meanings in languages (as phonemes).","e":"Phonetics studies the sounds of human languages, and phonology studies the meanings that those sounds have."},{"m":"(countable) The phonology of a language is the set of sounds that have meaning in that language; the set of sounds that can be used to make words."}]}]},"ignores":{"h":"ignores","l":"ignore","q":"verb"},"ignoring":{"h":"ignoring","l":"ignore","q":"verb"},"regulated":{"h":"regulated","l":"regulate","q":"verb"},"stockings":{"h":"stockings","a":"En-us-stockings.ogg","l":"stocking","q":"noun"},"unregulated":{"h":"unregulated","s":[{"p":"adjective","d":[{"m":"Not regulated","e":"\"It is not regulation that is an evil, but unsuitable regulation; unregulated trade is not necessarily in a sound condition, and regulated trade is not restricted trade unless it is ill-regulated trade.\" -- William Cunningham in The Growth of English Industry and Commerce, p. 265 (1896)"}]}]},"regulates":{"h":"regulates","l":"regulate","q":"verb"},"regulating":{"h":"regulating","a":"En-us-regulating.ogg","l":"regulate","q":"verb"},"reigned":{"h":"reigned","l":"reign","q":"verb"},"reigning":{"h":"reigning","l":"reign","q":"verb"},"inflect":{"h":"inflect","i":"/ɪnˈflɛkt/","a":"en-us-inflect.ogg","s":[{"p":"verb","d":[{"m":"To inflect means to change a word to change its meaning or tense.","e":"The verb \"worked\" is \"work\" after being inflected."}]}]},"inflection":{"h":"inflection","i":"/ɪnˈflɛkʃən/","a":"en-us-inflection.ogg","s":[{"p":"noun","d":[{"m":"Inflection is the of a verb, noun, adjective or adverb to change its meaning or tense.","e":"When learning a language, inflection is often taught separately."}]}]},"seemed":{"h":"seemed","a":"En-us-seemed.ogg","l":"seem","q":"verb"},"others":{"h":"others","i":"/ˈʌðəz/","a":"en-us-others.ogg","l":"other","q":"noun"},"says":{"h":"says","i":"/sɛz/","a":"LL-Q1860 (eng)-Back ache-says.wav","l":"say","q":"verb"},"saying":{"h":"saying","i":"/ˈseɪ.ɪŋ/","a":"en-us-saying.ogg","l":"say","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A saying is a short sentence or paragraph that offers advice."}]}]},"certainly":{"h":"certainly","i":"/ˈsɝtn̩li/","a":"en-us-certainly.ogg","s":[{"p":"adverb","d":[{"m":"Without doubt, bound to occur."},{"m":"(of propositions) Used to agree with something, yes.","e":"Would you like to come with me? – Certainly."}]}]},"silence":{"h":"silence","i":"/saɪləns/","a":"en-us-silence.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Silence is when no noise is heard.","e":"The silence was strange, not even a bird could be heard."},{"m":"(countable) A silence is a time when there is no noise.","e":"We had one minute of silence to remember the people who had died in the war."}]},{"p":"verb","d":[{"m":"If you silence something, you stop it from making noise."},{"m":"If you silence someone, you stop them from talking."}]}]},"presence":{"h":"presence","i":"/ˈprɛzəns/","a":"en-us-presence.ogg","s":[{"p":"noun","d":[{"m":"An instance of being around – being near, in sight."}]}]},"appearance":{"h":"appearance","i":"/əˈpɪərəns/","a":"en-us-appearance.ogg","s":[{"p":"noun","d":[{"m":"The act of appearing."},{"m":"Outward or visible aspect of a person or thing. It is a physical property of matter, meaning that a change in chemical composition does not necessarily cause a change in appearance."},{"m":"The event of coming into sight. When you first see something, the thing is said to have appeared. Inversely, when the thing goes out of sight, the thing is said to have disappeared, dis- being a Latin root meaning 'not'."}]}]},"silent":{"h":"silent","i":"/ˈsaɪlənt/","a":"en-us-silent.ogg","s":[{"p":"adjective","d":[{"m":"If something is silent, there is no sound. It is unheard.","e":"The candidates were silent during the exam."}]}]},"exclaimed":{"h":"exclaimed","i":"/ɛkskleɪmd/","a":"en-us-exclaimed.ogg","l":"exclaim","q":"verb"},"exclaim":{"h":"exclaim","i":"/ɛkˈskleɪm/","a":"LL-Q1860 (eng)-Vealhurl-exclaim.wav","s":[{"p":"verb","d":[{"m":"If you exclaim something, you say it loudly and enthusiastically."}]}]},"exclaims":{"h":"exclaims","l":"exclaim","q":"verb"},"generally":{"h":"generally","i":"/ʤɛnrəliː/","a":"en-us-generally.ogg","s":[{"p":"adverb","d":[{"m":", of common occurrence."},{"m":"In general, without regard to other details which may affect the scenario.","e":"Generally, men find it easier to lose weight than women."}]}]},"experimental":{"h":"experimental","i":"/ɨkspɛrəˈmɛntəl/","s":[{"p":"adjective","d":[{"m":"Of an experiment. Which may contain errors. Not tested thoroughly."}]}]},"afghan":{"h":"Afghan","i":"/ˈæfˌgæn/","a":"LL-Q1860 (eng)-Vealhurl-Afghan.wav","s":[{"p":"noun","d":[{"m":"(countable) An Afghan is a person or thing that comes from or lives in Afghanistan."}]},{"p":"adjective","d":[{"m":"Something or someone that is Afghan comes from or is related to Afghanistan."}]}]},"inflects":{"h":"inflects","l":"inflect","q":"verb"},"inflected":{"h":"inflected","a":"en-us-inflected.ogg","l":"inflect","q":"verb"},"inflecting":{"h":"inflecting","l":"inflect","q":"verb"},"inflections":{"h":"inflections","l":"inflection","q":"noun"},"seems":{"h":"seems","a":"En-us-seems.ogg","l":"seem","q":"verb"},"seeming":{"h":"seeming","l":"seem","q":"verb"},"presences":{"h":"presences","l":"presence","q":"noun"},"appearances":{"h":"appearances","a":"en-us-appearances.ogg","l":"appearance","q":"noun"},"landlocked":{"h":"landlocked","i":"/ˈlændlɑkt/","s":[{"p":"adjective","d":[{"m":"A piece of land is landlocked if it does not touch a large body of water, such as a sea or ocean."}]}]},"undocumented":{"h":"undocumented","s":[{"p":"adjective","d":[{"m":"If something is undocumented, it does not have the documents to support a claim."},{"m":"If something is undocumented, it does not have official documentation required to enter, live or work in a country."}]}]},"regularize":{"h":"regularize","i":"/ˈrɛɡjəlɚaɪz/","a":"LL-Q1860 (eng)-Vealhurl-regularize.wav","s":[{"p":"verb","d":[{"m":"(transitive) To make regular.","e":"The regularization of spelling was an important step in the advancement of literary society."},{"m":"(transitive) If you regularize something, you control it by defining it.","e":"The industry has fought the state's attempts to regularize its products."},{"m":"(transitive) If x regularizes y, x causes y to function in a particular way.","e":"You turn this to regulate the water flow."}]}]},"ascribe":{"h":"ascribe","i":"/əˈskraɪb/","a":"en-au-ascribe.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To attribute a cause or characteristic to someone or something.","e":"We may ascribe the failure to the leader, but it is also explained by bad luck."},{"m":"(transitive) To attribute a book, painting or any work of art or literature to a specific writer or painter or creator.","e":"It is arguable as to whether we can truly ascribe this play to Shakespeare."}]}]},"alphabetically":{"h":"alphabetically","s":[{"p":"adverb","d":[{"m":"In order of the alphabet.","e":"Sorting alphabetically means every name beginning with 'A' will come before words beginning with 'B'."}]}]},"silences":{"h":"silences","l":"silence","q":"noun"},"silenced":{"h":"silenced","a":"En-us-silenced.ogg","l":"silence","q":"verb"},"silencing":{"h":"silencing","l":"silence","q":"verb"},"hoop":{"h":"hoop","i":"/huːp/","a":"EN-AU ck1 hoop.ogg","s":[{"p":"noun","d":[{"m":"A hoop is a circular or ring-like object."}]}]},"blackbirds":{"h":"blackbirds","l":"blackbird","q":"noun"},"earthen":{"h":"earthen","i":"/ˈərθən/","a":"LL-Q1860 (eng)-Vealhurl-earthen.wav","s":[{"p":"adjective","d":[{"m":"If something is earthen, it is made of earth or mud.","e":"The earthen walls of the house were very thick."},{"m":"If something is earthen, it is made of clay (usually said of pottery).","e":"The earthen dishes were easily chipped or broken."},{"m":"If something is earthen, it is the color of earth, soil or dirt.","e":"The walls of the buildings in Timbuktu are the same earthen color as the sand and soil of central Mali."}]}]},"venerate":{"h":"venerate","i":"/ˈvɛnəreɪt/","a":"en-us-venerate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To treat with great respect and deference.","e":"They wanted to venerate the spirit of the great man."},{"m":"(transitive) To revere or hold in high value, esteem, awe.","e":"He came to venerate the memory of the significant or holy event."}]}]},"venerates":{"h":"venerates","l":"venerate","q":"verb"},"venerated":{"h":"venerated","l":"venerate","q":"verb"},"venerating":{"h":"venerating","l":"venerate","q":"verb"},"contacts":{"h":"contacts","l":"contact","q":"noun"},"contacted":{"h":"contacted","l":"contact","q":"verb"},"contacting":{"h":"contacting","l":"contact","q":"verb"},"elite":{"h":"elite","i":"/ɪˈliːt/","a":"LL-Q1860 (eng)-Vealhurl-elite.wav","s":[{"p":"adjective","d":[{"m":"If something is elite, it is special or exclusive."}]},{"p":"noun","d":[{"m":"The elite is the best part of a group.","e":"Only the elite can enter this school."},{"m":"(uncountable) Elite is the size of letter in typewriting (12 per inch)."}]}]},"elites":{"h":"elites","l":"elite","q":"noun"},"eloquence":{"h":"eloquence","i":"/'ɛləkwəns/","a":"En-us-eloquence.ogg","s":[{"p":"noun","d":[{"m":"Eloquence is the quality of using language well and effectively.","e":"His speech was full of grace and eloquence."}]}]},"alley":{"h":"alley","i":"/ˈæ.li/","a":"en-us-alley.ogg","s":[{"p":"noun","d":[{"m":"(countable) An alley is a small street that is located behind buildings.","e":"I found a dollar while walking in the alley."},{"m":"(countable) An alley is a place where people go bowling.","e":"I went to the bowling alley last night."}]}]},"eloquences":{"h":"eloquences","l":"eloquence","q":"noun"},"alleys":{"h":"alleys","l":"alley","q":"noun"},"hoops":{"h":"hoops","i":"/huːps/","a":"LL-Q1860 (eng)-Vealhurl-hoops.wav","l":"hoop","q":"noun"},"settlement":{"h":"settlement","i":"/ˈset.l.mənt/","a":"en-us-settlement.ogg","s":[{"p":"noun","d":[{"m":"A settlement is a small, new colony; a new place for people to live."},{"m":"A settlement is a decision made to fix and end a legal argument between two people."},{"m":"Settlement is when people are settling someplace, that is moving to it"},{"m":"Settlement is what happens when a building falls into the ground very very slowly."}]}]},"adventure":{"h":"adventure","i":"/ædˈv̥ɛntʃɚ/","a":"en-ca-adventure.ogg","s":[{"p":"noun","d":[{"m":"(countable) If you have an adventure you have a trip with a lot of excitement, hazards, or dangers.","e":"went on an adventure."},{"m":"An adventure may be any event where risks are encountered."}]},{"p":"verb","d":[{"m":"To adventure is to go on an adventure; quest; trip."}]}]},"affection":{"h":"affection","i":"/ʌ.fɛk.ʃən/","a":"en-us-affection.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Affection is the state of being affected."},{"m":"(countable) An affection is a condition, state, or quality of something.","e":"Your weight is an affection of your body."},{"m":"(uncountable) If someone has affection for something or someone else, they love it; they like doing it; they are attached to it.","e":"I have affection for her."},{"m":"(countable) An affection is a disease or malady of the body."}]}]},"adventures":{"h":"adventures","i":"/ədˈvɛnt͡ʃɚz/","a":"en-us-adventures.ogg","l":"adventure","q":"noun"},"adventured":{"h":"adventured","l":"adventure","q":"verb"},"adventuring":{"h":"adventuring","l":"adventure","q":"verb"},"affections":{"h":"affections","i":"/əˈfɛkʃənz/","a":"en-us-affections.ogg","l":"affection","q":"noun"},"alert":{"h":"alert","i":"/əˈlɜːt/","a":"en-us-alert.ogg","s":[{"p":"adjective","d":[{"m":"To be alert is to be awake; attentive"}]},{"p":"noun","d":[{"m":"An alarm."},{"m":"A notification; something that is observed."}]},{"p":"verb","d":[{"m":"To alert is to bring notice to; warn."}]}]},"alerts":{"h":"alerts","l":"alert","q":"noun"},"alerted":{"h":"alerted","l":"alert","q":"verb"},"alerting":{"h":"alerting","l":"alert","q":"verb"},"amuse":{"h":"amuse","i":"/əˈmjuːz/","a":"LL-Q1860 (eng)-Vealhurl-amuse.wav","s":[{"p":"verb","d":[{"m":"To amuse is to cause laughter and enjoyment; to be funny."}]}]},"amuses":{"h":"amuses","l":"amuse","q":"verb"},"amused":{"h":"amused","i":"/əˈmjuːzd/","a":"en-us-amused.ogg","l":"amuse","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are amused, you are entertained.","e":"The children played a game while their amused parents watched."}]}]},"laughter":{"h":"laughter","i":"/ˈlɑːftə/","a":"en-us-laughter.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) The sound of laughing.","e":"Laughter filled the classroom when the teacher accidently spilled her coffee."}]}]},"appal":{"h":"appal","i":"/əˈpɔːl/","a":"LL-Q1860 (eng)-Mélange a trois-appall.wav","s":[{"p":"verb","d":[{"m":"(transitive) To depress or discourage with fear; to make upset.","e":"The mess in the house would appall him."}]}]},"appall":{"h":"appall","i":"/əˈpɔːl/","a":"LL-Q1860 (eng)-Mélange a trois-appall.wav","s":[{"p":"verb","d":[{"m":"(transitive) To depress or discourage with fear; to make upset.","e":"The mess in the house would appall him."}]}]},"appalls":{"h":"appalls","l":"appall","q":"verb"},"appalled":{"h":"appalled","l":"appall","q":"verb"},"appalling":{"h":"appalling","l":"appall","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is appalling, it's very bad."}]}]},"appliance":{"h":"appliance","i":"/əˈplaɪəns/","a":"en-us-appliance.ogg","s":[{"p":"noun","d":[{"m":"The act of applying; application."},{"m":"(countable) A useful object made for a specific purpose. Appliances are often powered by electricity or by a small motor, used in homes and in offices."},{"m":"(countable) An attachment or part of some tool; equipment attachment."}]}]},"appliances":{"h":"appliances","l":"appliance","q":"noun"},"arrear":{"h":"arrear","i":"/əˈrɪə/","s":[{"p":"noun","d":[{"m":"An arrear is work to be done; an obligation.","e":"I have a large arrear of letters to write."}]}]},"arrears":{"h":"arrears","l":"arrear","q":"noun"},"articulate":{"h":"articulate","i":"/ɑːˈtɪkjʊlət/","a":"en-us-articulate-adj.ogg","s":[{"p":"adjective","d":[{"m":"in a clear way; effective speaking.","e":"She is an articulate person."},{"m":"Able to bend or hinge.","e":"The robot arm was articulate in two directions."}]},{"p":"verb","d":[{"m":"To articlulate is to make clear."},{"m":"If you articulate, that means you speak clearly or effectively.","e":"If he would just articulate, I might be able to understand him."}]}]},"articulates":{"h":"articulates","l":"articulate","q":"verb"},"articulated":{"h":"articulated","l":"articulate","q":"verb","s":[{"p":"adjective","d":[{"m":"To be articulated is to be made with small joints or details."},{"m":"If something is articulated, it has 2 (or more) parts that are connected together by a flexible joint."}]}]},"articulating":{"h":"articulating","l":"articulate","q":"verb"},"ashame":{"h":"ashame","i":"/əˈʃeɪm/","a":"LL-Q1860 (eng)-Vealhurl-ashame.wav","s":[{"p":"verb","d":[{"m":"(transitive), If you ashame someone, you make that person feel shame or guilt."}]}]},"ashamed":{"h":"ashamed","i":"/əˈʃeɪmd/","a":"en-us-ashamed.ogg","l":"ashame","q":"verb","s":[{"p":"adjective","d":[{"m":"Feeling shame or guilt.","e":"You should be ashamed of yourself for hitting your sister."}]}]},"ashaming":{"h":"ashaming","l":"ashame","q":"verb"},"astonish":{"h":"astonish","i":"/əˈstɒnɪʃ/","a":"en-us-astonish.ogg","s":[{"p":"verb","d":[{"m":"If something or someone astonishes you, they surprise you deeply.","e":"The change astonished me."}]}]},"astonished":{"h":"astonished","i":"/æ- -d/","a":"en-us-astonished.ogg","s":[{"p":"adjective","d":[{"m":"If you are astonished, you are surprised or amazed.","e":"I was astonished to find myself at work on time."}]}]},"shack":{"h":"shack","i":"/ʃæk/","a":"LL-Q1860 (eng)-Vealhurl-shack.wav","s":[{"p":"noun","d":[{"m":"(countable) A shack is a small shelter; a hut or cabin.","e":"He used to live in a shack."}]}]},"avenue":{"h":"avenue","i":"/ˈæv.əˌnju/","a":"en-us-avenue.ogg","s":[{"p":"noun","d":[{"m":"(countable) An avenue is a wide street, often bordered by trees.","e":"They used to live at 123 Derbyshire Avenue."},{"m":"An avenue can be a way or opening for entrance into a place."}]}]},"avenues":{"h":"avenues","l":"avenue","q":"noun"},"authorise":{"h":"authorise","i":"/ˈɔθəraɪz/","a":"en-us-authorize.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To authorise someone is to give them power or permission.","e":"I will need to authorise you before you step through that gate."},{"m":"(transitive) To authorise can be to allow something to be done."}]}]},"authorised":{"h":"authorised","l":"authorise","q":"verb"},"authorises":{"h":"authorises","l":"authorise","q":"verb"},"authorize":{"h":"authorize","i":"/ˈɔθəraɪz/","a":"en-us-authorize.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To authorize someone is to give them power or permission.","e":"I will need to authorize you before you step through that gate."},{"m":"(transitive) To authorize can be to allow something to be done."}]}]},"authorizes":{"h":"authorizes","l":"authorize","q":"verb"},"authorized":{"h":"authorized","l":"authorize","q":"verb"},"authorizing":{"h":"authorizing","l":"authorize","q":"verb"},"badge":{"h":"badge","i":"/bædʒ/","a":"LL-Q1860 (eng)-Vealhurl-badge.wav","s":[{"p":"noun","d":[{"m":"(countable) A badge can be any token, sign, or emblem, that is worn on a person's clothing.","e":"Check out my new badge, I got it for tying a new knot."},{"m":"(countable) A badge can be a small card that tells information or the person who is wearing it.","e":"Write your name on your badge for the first day of school."}]},{"p":"verb","d":[{"m":"(transitive) To badge is to mark with a badge; reward.","e":"The army will badge you for your efforts."}]}]},"badges":{"h":"badges","l":"badge","q":"noun"},"badged":{"h":"badged","l":"badge","q":"verb"},"badging":{"h":"badging","l":"badge","q":"verb"},"bare":{"h":"bare","i":"/beə(r)/","a":"en-us-bare.ogg","s":[{"p":"adjective","d":[{"m":"If something is bare, it is just enough to get by.","e":"He survived with just the bare necessities."},{"m":"Being bare is being without cover; being naked; without decoration.","e":"I didn't expect to see his bare backside."}]},{"p":"verb","d":[{"m":"(transitive) To bare is to uncover or show."}]}]},"barer":{"h":"barer","i":"/ˈbɛərə/","l":"bare","q":"adjective"},"barest":{"h":"barest","a":"en-us-barest.ogg","l":"bare","q":"adjective"},"bares":{"h":"bares","i":"/bɛrz/","a":"en-us-bears.ogg","l":"bare","q":"verb"},"bared":{"h":"bared","l":"bare","q":"verb"},"baring":{"h":"baring","l":"bare","q":"verb"},"bargain":{"h":"bargain","i":"/ˈbɑːɡən/","a":"en-us-bargain.ogg","s":[{"p":"noun","d":[{"m":"If you make a bargain with someone, that means you agreed with them to make an exchange or trade.","e":"He gave me his sandwich and I gave him my apple; it was a bargain."},{"m":"If you buy something that is a bargain, that means it is a good deal; cheap.","e":"This house cost me $1. What a bargain!"}]},{"p":"verb","d":[{"m":"(intransitive) To bargain is to make a deal.","e":"We had to bargain for three hours to make an agreement."},{"m":"(transitive) To bargain is to barter; to trade."}]}]},"bargains":{"h":"bargains","l":"bargain","q":"noun"},"bargained":{"h":"bargained","l":"bargain","q":"verb"},"bargaining":{"h":"bargaining","l":"bargain","q":"verb"},"barn":{"h":"barn","i":"/bɑrn/","a":"LL-Q1860 (eng)-Vealhurl-barn.wav","s":[{"p":"noun","d":[{"m":"(countable) A barn is a building found on a farm where animals live (such as cows and chickens).","e":"If it wasn't for the barn, all of the animals would have been out in the rain."}]}]},"barns":{"h":"barns","l":"barn","q":"noun"},"shacks":{"h":"shacks","l":"shack","q":"noun"},"exclaiming":{"h":"exclaiming","a":"en-us-exclaiming.ogg","l":"exclaim","q":"verb"},"afghans":{"h":"Afghans","l":"afghan","q":"noun"},"settlements":{"h":"settlements","a":"en-us-settlements.ogg","l":"settlement","q":"noun"},"bash":{"h":"bash","i":"/bæʃ/","a":"en-au-bash.ogg","s":[{"p":"noun","d":[{"m":"If you are going to a bash, you are going to a large party.","e":"We are going to have a bash!"},{"m":"A bash is an attack.","e":"The guys went out to bash a few gays."}]},{"p":"verb","d":[{"m":"To bash someone is to attack them, often with fists; to strike hard.","e":"Gay bashing is deplorable."},{"m":"If someone bashes your idea, that means they don't like it.","e":"My plan was subject to much bashing by the press."},{"m":"To bash is to run into; to collide; to smash.","e":"I was bashed against the wall, and it hurt."}]}]},"bashing":{"h":"bashing","l":"bash","q":"verb"},"bashed":{"h":"bashed","l":"bash","q":"verb"},"bashes":{"h":"bashes","l":"bash","q":"noun"},"bingo":{"h":"bingo","i":"/ˈbɪŋ.ɡəʊ/","a":"en-us-bingo.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Bingo is a game of luck, where players try to fill in squares on a grid in order to get five in-a-row.","e":"Let's play bingo."},{"m":"(countable) A win in a game of bingo.","e":"Bingo! I have five in-a-row!"}]}]},"bingos":{"h":"bingos","l":"bingo","q":"noun"},"blimey":{"h":"blimey","i":"/ˈblaɪmi/","s":[{"p":"interjection","d":[{"m":"(British) If someone says \"blimey\", they might by angry, surprised, or excited.","e":"Blimey! I didn't see that!"}]}]},"bog":{"h":"bog","i":"/bɒɡ/","a":"en-uk-bog.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bog is large wet area with many plants.","e":"The frog jumped away into the bog."}]},{"p":"verb","d":[{"m":"(intransitive) (informal) To become bogged is to become slowed down or stuck.","e":"Too many people on the bus made it bog down and then stop."},{"m":"(transitive) (British) (informal) To bog something is to make a mess of it.","e":"Why did you have to bog this whole thing up!?"}]}]},"bogging":{"h":"bogging","l":"bog","q":"verb"},"bogged":{"h":"bogged","l":"bog","q":"verb"},"bogs":{"h":"bogs","a":"en-au-the bogs.ogg","l":"bog","q":"noun"},"chew":{"h":"chew","i":"/tʃuː/","a":"en-us-chew.ogg","s":[{"p":"verb","d":[{"m":"If you chew something, you cut it up with your teeth.","e":"Make sure to chew thoroughly, and don't talk with your mouth full!"}]}]},"bold":{"h":"bold","i":"/bəʊld/","a":"en-us-bold.ogg","s":[{"p":"adjective","d":[{"m":"If someone is bold, that means they are brave and willing to take risks.","e":"It takes a bold man to walk on hot coals."},{"m":"Bold text is writing that is made with thicker lines.","e":"The first letter in the line above is in bold text."}]},{"p":"verb","d":[{"m":"To bold text is to make words that are written with thicker lines.","e":"On your report, bold your name so it's easier to see."}]}]},"bolder":{"h":"bolder","i":"/ˈbəʊldə/","a":"en-us-boulder.ogg","l":"bold","q":"adjective"},"boldest":{"h":"boldest","l":"bold","q":"adjective"},"bolds":{"h":"bolds","l":"bold","q":"verb"},"bolded":{"h":"bolded","l":"bold","q":"verb"},"bolding":{"h":"bolding","l":"bold","q":"verb"},"boo":{"h":"boo","i":"/buː/","a":"en-au-boo.ogg","s":[{"p":"interjection","d":[{"m":"Boo is a word that is sometimes shouted to scare a person.","e":"He jumped up from behind the box and yelled \"boo!\" I was frightened."},{"m":"If someone in an audience says \"boo\", that means that they do not like the show.","e":"Boo, get off the stage."}]},{"p":"noun","d":[{"m":"A loud and sometimes frightening yell or shout."}]},{"p":"verb","d":[{"m":"To boo someone is to shout or yell at them.","e":"When it was my turn to sing a song, the crowd booed at me."}]}]},"booed":{"h":"booed","l":"boo","q":"verb"},"boos":{"h":"boos","l":"boo","q":"noun"},"booing":{"h":"booing","l":"boo","q":"verb"},"boom":{"h":"boom","i":"/buːm/","a":"en-au-boom.ogg","s":[{"p":"noun","d":[{"m":"A boom is the sound that is made from an explosion.","e":"The boom of that volcano hurt my ears."},{"m":"A boom can also be any movable pole; in sailing, it is a pole that comes from the bottom of a sail."}]},{"p":"verb","d":[{"m":"To boom is to make a loud sound."}]}]},"booms":{"h":"booms","i":"/buːmz/","l":"boom","q":"noun"},"boomed":{"h":"boomed","i":"/buːmd/","l":"boom","q":"verb"},"booming":{"h":"booming","i":"/ˈbuːmɪŋ/","l":"boom","q":"verb","s":[{"p":"adjective","d":[{"m":"If a business or economy is booming, it is a period of prosperity, or rapid economic growth.","e":"The power of China's booming economy continues to stun the world."},{"m":"If a person's voice is booming, it is loud and resonant.","e":"He was asked to be emcee at the function as he has a booming voice."}]}]},"boost":{"h":"boost","i":"/buːst/","a":"en-au-boost.ogg","s":[{"p":"noun","d":[{"m":"(countable) (singular) A boost is a push from behind","e":"My friend gave me a boost to push me over the fence."}]},{"p":"verb","d":[{"m":"(transitive) To boost is to lift or push from behind.","e":"He boosted me up."}]}]},"boosts":{"h":"boosts","l":"boost","q":"noun"},"boosted":{"h":"boosted","l":"boost","q":"verb"},"boosting":{"h":"boosting","l":"boost","q":"verb"},"bounce":{"h":"bounce","i":"/baʊns/","a":"en-us-bounce.ogg","s":[{"p":"verb","d":[{"m":"To bounce is to change the direction of motion after hitting an object.","e":"The tennis ball bounced off the wall."},{"m":"To bounce is to make something move quickly up and down, or down and up.","e":"He bounced the child on his knee."},{"m":"To bounce a check, is to be refused by a bank."}]},{"p":"noun","d":[{"m":"A bounce is a change of direction of motion, often after hitting an object.","e":"The poor bird made a big bounce off my car when we hit each other."},{"m":"A bounce can also mean movement that is up and down, up and down (repeated)."}]}]},"bounces":{"h":"bounces","l":"bounce","q":"verb"},"bounced":{"h":"bounced","l":"bounce","q":"verb"},"bouncing":{"h":"bouncing","i":"/ˈbaʊnsɪŋ/","l":"bounce","q":"verb"},"inflammatory":{"h":"inflammatory","s":[{"p":"adjective","d":[{"m":"Something that makes people angry.","e":"Sam posted an inflammatory comment in the talk page."}]}]},"cactus":{"h":"cactus","i":"/ˈkæktʊs/","a":"en-us-cactus.ogg","s":[{"p":"noun","d":[{"m":"(countable) A type of plant that has spines instead of leaves and grows in dry places."}]}]},"cacti":{"h":"cacti","l":"cactus","q":"noun"},"cactuses":{"h":"cactuses","l":"cactus","q":"noun"},"barracks":{"h":"barracks","i":"/ˈbærəks/","a":"en-us-barracks.ogg","l":"barrack","q":"noun"},"barracked":{"h":"barracked","l":"barrack","q":"verb"},"barracking":{"h":"barracking","l":"barrack","q":"verb"},"deposition":{"h":"deposition","i":"/dɛpəˈzɪʃən/","s":[{"p":"noun","d":[{"m":"A deposition is when someone is removed from their office or position.","e":"Mary II of England was very sad at her father's deposition."},{"m":"A process of giving sworn (promised) proof."},{"m":"Proof given under an oath."}]}]},"virus":{"h":"virus","i":"/ˈvaɪrəs/","a":"en-us-virus.ogg","s":[{"p":"noun","d":[{"m":"(countable) A virus is a very small thing that can make people sick by getting into a living cell to copy itself."},{"m":"(countable) A computer virus is software that attacks your computer."}]}]},"affixed":{"h":"affixed","l":"affix","q":"verb"},"affixing":{"h":"affixing","l":"affix","q":"verb"},"streets":{"h":"streets","i":"/striːts/","a":"en-us-streets.ogg","l":"street","q":"noun"},"roads":{"h":"roads","i":"/roʊdz/","a":"en-us-roads.ogg","l":"road","q":"noun"},"hinder":{"h":"hinder","i":"/ˈhɪndə/","a":"en-us-hinder.ogg","s":[{"p":"verb","d":[{"m":"If you hinder something, then you delay it or make it slower to happen.","e":"My airplane flight was hindered because of rain."}]}]},"hinders":{"h":"hinders","l":"hinder","q":"verb"},"hindered":{"h":"hindered","a":"En-us-hindered.ogg","l":"hinder","q":"verb"},"hindering":{"h":"hindering","l":"hinder","q":"verb"},"juxtaposition":{"h":"juxtaposition","i":"/ˌdʒʌk.stə.pəˈzɪʃ.ən/","a":"en-us-juxtaposition.ogg","s":[{"p":"noun","d":[{"m":"A state of two things being close together or side by side.","e":"The two rooms were in juxtaposition."}]}]},"juxtapose":{"h":"juxtapose","i":"/ˈd͡ʒʌkstəpəʊz/","a":"en-us-juxtapose.ogg","s":[{"p":"verb","d":[{"m":"To put (things) side by side."},{"m":"To put (a thing) beside another."}]}]},"construct":{"h":"construct","i":"/ˈkɒnstrʌkt/","a":"en-us-construct-noun.ogg","s":[{"p":"noun","d":[{"m":"Something made from parts.","e":"That artwork is a construct of wires and tubes."},{"m":"A concept or model.","e":"The construct of the world being flat was changed due to Copernicus' telescope."}]},{"p":"verb","d":[{"m":"(transitive) To make, build, or form (something) by putting the parts together.","e":"We constructed the radio from parts."},{"m":"(transitive) Similarly, to build (a sentence or an argument) by arranging words or ideas.","e":"A sentence may be constructed with a subject, verb and object."},{"m":"(transitive); To draw a figure by following a method.","e":"Construct a circle that touches each point of the given triangle."}]}]},"lucrative":{"h":"lucrative","i":"/ˈlukrətɪv/","s":[{"p":"adjective","d":[{"m":"If something is lucrative, you can make money doing it.","e":"Jackie runs a very lucrative catering business out of her home."}]}]},"monopoly":{"h":"monopoly","i":"/məˈnɒpəˌli/","a":"en-us-monopoly.ogg","s":[{"p":"noun","d":[{"m":"(countable) A monopoly is a situation where one company owns all or almost all of the market for a product or service; they have little or no business competition."}]}]},"photography":{"h":"photography","i":"/fəˈtɒɡrəfi/","a":"en-us-photography.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Photography is the art of taking photographs."}]}]},"worthy":{"h":"worthy","i":"/ˈwɜːði/","a":"en-us-worthy.ogg","s":[{"p":"adjective","d":[{"m":"If something is worthy, it has value or worth."}]}]},"spa":{"h":"spa","s":[{"p":"noun","d":[{"m":"A spa is a mineral or hot spring."},{"m":"A spa is a very nice resort hotel."},{"m":"A spa is a health or fitness center where a person can exercise or get a massage."},{"m":"A spa is a hot tub."}]}]},"juxtapositions":{"h":"juxtapositions","l":"juxtaposition","q":"noun"},"juxtaposes":{"h":"juxtaposes","l":"juxtapose","q":"verb"},"juxtaposed":{"h":"juxtaposed","a":"en-us-juxtaposed.ogg","l":"juxtapose","q":"verb"},"juxtaposing":{"h":"juxtaposing","l":"juxtapose","q":"verb"},"constructs":{"h":"constructs","a":"en-us-constructs-noun.ogg","l":"construct","q":"noun"},"constructed":{"h":"constructed","i":"/kənˈstrʌktəd/","a":"En-us-constructed.ogg","l":"construct","q":"verb"},"constructing":{"h":"constructing","l":"construct","q":"verb"},"monopolies":{"h":"monopolies","l":"monopoly","q":"noun"},"spas":{"h":"spas","l":"spa","q":"noun"},"viruses":{"h":"viruses","l":"virus","q":"noun"},"chews":{"h":"chews","i":"/tʃuːz/","a":"en-us-choose.ogg","l":"chew","q":"verb"},"chewed":{"h":"chewed","l":"chew","q":"verb"},"chewing":{"h":"chewing","l":"chew","q":"verb"},"depositions":{"h":"depositions","l":"deposition","q":"noun"},"ascribes":{"h":"ascribes","l":"ascribe","q":"verb"},"ascribed":{"h":"ascribed","l":"ascribe","q":"verb"},"ascribing":{"h":"ascribing","l":"ascribe","q":"verb"},"regularizes":{"h":"regularizes","l":"regularize","q":"verb"},"regularized":{"h":"regularized","l":"regularize","q":"verb"},"regularizing":{"h":"regularizing","l":"regularize","q":"verb"},"rapid":{"h":"rapid","i":"/ˈræpɪd/","a":"en-us-rapid.ogg","s":[{"p":"adjective","d":[{"m":"If an action or idea is rapid, it happens quickly."}]},{"p":"noun","d":[{"m":"(usually plural) A fast part of a river or stream."}]}]},"rapids":{"h":"rapids","l":"rapid","q":"noun"},"rapider":{"h":"rapider","l":"rapid","q":"adjective"},"rapidest":{"h":"rapidest","l":"rapid","q":"adjective"},"visibility":{"h":"visibility","i":"/ˌvɪz.əˈbɪl.ɪ.ti/","a":"LL-Q1860 (eng)-Vealhurl-visibility.wav","s":[{"p":"noun","d":[{"m":"(uncountable) The visibility of something is the state of the thing being visible."},{"m":"(countable) Visibility is how well a particular thing can be seen.","e":"The visibility from that angle was good"}]}]},"visibilities":{"h":"visibilities","l":"visibility","q":"noun"},"peopled":{"h":"peopled","l":"people","q":"verb"},"peopling":{"h":"peopling","l":"people","q":"verb"},"berate":{"h":"berate","i":"/bɪˈreɪt/","a":"LL-Q1860 (eng)-Vealhurl-berate.wav","s":[{"p":"verb","d":[{"m":"If you berate someone, you angrily tell them that they did something wrong; you scold them.","e":"Mary angrily berated the dog when it peed on the floor."}]}]},"berates":{"h":"berates","l":"berate","q":"verb"},"berated":{"h":"berated","l":"berate","q":"verb"},"berating":{"h":"berating","l":"berate","q":"verb"},"cheat":{"h":"cheat","i":"/tʃiːt/","a":"en-us-cheat.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) To break the rules for your own gain.","e":"Don't play cards with her, she cheats."},{"m":"(intransitive) To have a relationship with someone not one's spouse or partner or someone who is married to someone else.","e":"He is cheating on his wife with his secretary."},{"m":"(transitive) To avoid something that seemed likely.","e":"To cheat death."}]},{"p":"noun","d":[{"m":"Someone who cheats (informal: cheater)."},{"m":"A card game where the goal is to have no cards remaining in a hand, often by telling lies."},{"m":"A hidden means of gaining an unfair advantage in a computer game, often by entering a cheat code."}]}]},"cheats":{"h":"cheats","l":"cheat","q":"verb"},"cheated":{"h":"cheated","l":"cheat","q":"verb"},"cheating":{"h":"cheating","i":"/ˈtʃiːtɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-cheating.wav","l":"cheat","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) A way of cheating or tricking someone."}]}]},"wanna":{"h":"wanna","i":"/ˈwɑ.nə/","a":"en-us-wanna.ogg","s":[{"p":"verb","d":[{"m":"Short for want to.","e":"I wanna go home now!"},{"m":"Short for want a.","e":"I wanna puppy!"}]}]},"gonna":{"h":"gonna","i":"/ˈgɒnə/","a":"en-us-gonna.ogg","s":[{"p":"verb","d":[{"m":"Short for going to.","e":"I'm gonna go home."}]}]},"whiskey":{"h":"whiskey","i":"/ˈwɪski/","a":"LL-Q1860 (eng)-عُثمان (Middle river exports)-whiskey.wav","s":[{"p":"noun","d":[{"m":"An alcoholic liquor made from fermented grain."},{"m":"A drink of whiskey.","e":"We shared a bottle of whiskey."},{"m":"Used by the for the letter W when spelling on the radio."}]}]},"op":{"h":"op","s":[{"p":"verb","d":[{"m":"To make someone an operator.","e":"He was popular on the Internet channel and someone would op him as soon as he entered."}]},{"p":"noun","d":[{"m":"\"Original Post\" or \"Original Poster\"."},{"m":"Short for operation. Often used in the military.","e":"The op did not go as they had planned and many solders died."}]}]},"midland":{"h":"midland","s":[{"p":"noun","d":[{"m":"The region of a country not near the borders; the interior.","e":"The fish is not as good midland."}]},{"p":"adjective","d":[{"m":"Resembling or relating to the interior region of a country."}]}]},"ham":{"h":"ham","i":"/ˈhæm/","a":"en-us-ham.ogg","s":[{"p":"noun","d":[{"m":"(countable) A ham is the thigh and buttock of any animal used for meat."},{"m":"(uncountable) The ham of a pig is the dried thigh used as food."},{"m":"A person's or animal's ham is the back of the thigh."},{"m":"In theater, an actor who over acts is called a ham. A ham has a showy or crazy style."},{"m":"A ham can be a person whose hobby is amateur radio."},{"m":"The back of the knee joint is the ham."}]}]},"tasty":{"h":"tasty","i":"/ˈteɪsti/","a":"en-us-tasty.ogg","s":[{"p":"adjective","d":[{"m":"When something is tasty, it has a good flavor and is delicious.","e":"You could make this tasty meal for breakfast."},{"m":"Having or showing good taste; tasteful.","e":"These items will make an attractive and tasty display."},{"m":"Appealing; when applied to persons, sexually appealing."}]}]},"mock":{"h":"mock","i":"/mɒk/","a":"en-us-mock.ogg","s":[{"p":"noun","d":[{"m":"A fake copy of something, usually meaning lesser quality.","e":"He was selling mock designer watches."},{"m":"The act of mocking."},{"m":"A practice exam to help prepare students for an important exam.","e":"He got a B on his History mock, but got an A on the exam."}]},{"p":"verb","d":[{"m":"To copy someone's actions in a bad way."},{"m":"To make fun of someone by mimicking or taunting."}]},{"p":"adjective","d":[{"m":", not genuine; fake","e":"mock turtle soup"}]}]},"fake":{"h":"fake","i":"/feɪ̯k/","a":"en-us-fake.ogg","s":[{"p":"adjective","d":[{"m":"Something which is fake is not real, false, or fraudulent.","e":"Which fur coat looks fake?"}]},{"p":"noun","d":[{"m":"(countable) A fake is a trick; a swindle."},{"m":"(countable) A fake is something that is not genuine, or is presented as real that is not real.","e":"That bill is a fake."},{"m":"(countable) A fake is a move meant to deceive (trick) an opposing player."},{"m":"(countable) A fake is one of the circles or windings of a cable, as it lies in a coil; a single turn or coil."}]},{"p":"verb","d":[{"m":"(intransitive) If you fake, you cheat, swindle, steal, or rob."},{"m":"(transitive) If you fake something, you manipulate it fraudulently, so as to make it appear better or other than it is."},{"m":"To make a counterfeit, to counterfeit, to forge."},{"m":"(transitive) If you fake something, you make a false display of it; you affect, feign, or simulate it."},{"m":"If you fake, you coil a rope or a wire, by winding alternately in opposite directions, in layers usually of zigzag or figure of eight form, to stop it from becoming twisted."}]}]},"frontier":{"h":"frontier","i":"/ˈfrʌntɪə/","a":"en-us-frontier.ogg","s":[{"p":"noun","d":[{"m":"The frontier is part of a country that is next to another country."},{"m":"A frontier is an area where few or no people live.","e":"Many settlers were killed on the frontier during colonial days in America."}]}]},"mob":{"h":"mob","i":"/mɒb/","a":"en-us-mob.ogg","s":[{"p":"noun","d":[{"m":"A large, angry group of people."},{"m":"A large group of livestock."},{"m":"The Mafia or a similar group of criminals."},{"m":"A type of video game character."}]},{"p":"verb","d":[{"m":"To crowd around someone or something."}]}]},"frontiers":{"h":"frontiers","a":"En-us-frontiers.ogg","l":"frontier","q":"noun"},"unpopular":{"h":"unpopular","i":"/ʌnˈpɒpyələr/","s":[{"p":"adjective","d":[{"m":"Not popular, not having popularity."}]}]},"fakes":{"h":"fakes","l":"fake","q":"noun"},"faked":{"h":"faked","l":"fake","q":"verb"},"faking":{"h":"faking","l":"fake","q":"verb"},"pwns":{"h":"pwns","l":"pwn","q":"verb"},"pwned":{"h":"pwned","l":"pwn","q":"verb"},"pwning":{"h":"pwning","l":"pwn","q":"verb"},"candle":{"h":"candle","i":"/ˈkændəl/","a":"en-us-candle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A piece of wax with a wick inside that you burn to get light."},{"m":"(countable) A unit of how light strength, now replaced by the SI unit candela."},{"m":"(countable) (forestry) a fast growing, light colored, shoot on a pine tree in the spring."}]},{"p":"verb","d":[{"m":"To watch the growth of something growing inside an egg, using a bright light source."},{"m":"To dry pottery before the firing cycle, setting the kiln at 200° Celsius until all water is removed from the greenware."}]}]},"jewellery":{"h":"jewellery","i":"/ˈʤuː.əl.ri/","a":"LL-Q1860 (eng)-Vealhurl-jewellery.wav","s":[{"p":"noun","d":[{"m":"(usually uncountable) Things that you wear such as rings, necklaces, brooches and bracelets, made of metals and sometimes with valuable gemstones."}]}]},"jolly":{"h":"jolly","i":"/ˈdʒɒli/","a":"en-au-jolly.ogg","s":[{"p":"adjective","d":[{"m":"Full of fun; playful, funny.","e":"He is very jolly, always laughing."}]},{"p":"noun","d":[{"m":"(British) A pleasure trip or excursion."},{"m":"(British) The joker in a deck of cards."},{"m":"A wild card."}]},{"p":"adverb","d":[{"m":"(British), extremely."}]},{"p":"verb","d":[{"m":"(transitive) To amuse or divert."}]}]},"junior":{"h":"junior","i":"/ˈdʒuːnɪə/","a":"LL-Q1860 (eng)-Vealhurl-junior.wav","s":[{"p":"adjective","d":[{"m":"er."},{"m":"The third academic year in a high school or university.","e":"I'm hoping that my junior year will be better than my sophomore year."},{"m":"In some cases, used to show less experience, not age.","e":"He is the Junior Senator from that state."}]},{"p":"noun","d":[{"m":"(countable) A younger person.","e":"Steve is four years his brother's junior."},{"m":"(countable) A third-year student at a high school or university.","e":"I'm a junior, but a lot of my friends are seniors."},{"m":"(countable) A name ending used after a son's name when his father has the same name. It is often shortened to Jr.","e":"Which President Bush do you mean, junior or senior?"}]}]},"ease":{"h":"ease","i":"/iːz/","a":"en-us-ease.ogg","s":[{"p":"noun","d":[{"m":"The state of being comfortable or relaxed.","e":"She enjoyed the ease of living in a house where the servants did all the work."},{"m":"from pain, worry, etc.","e":"His mind was at ease when he took the test. He knew he had studied well."},{"m":"Free from effort, difficulty or hardship.","e":"He passed all the exams with ease."},{"m":"Doing something without much effort.","e":"He played the piano with ease."},{"m":"To be free from money problems.","e":"After winning the lottery, she lived a life of ease."},{"m":", rest and leisure.","e":"We took our ease on the patio."}]},{"p":"verb","d":[{"m":"(transitive) To free or lessen (something) from pain, worry, agitation, etc.","e":"He eased his conscience telling her what he had done wrong."},{"m":"(transitive) To loosen or relax the tension on (something).","e":"We eased the rope, then lowered the sail."},{"m":"(transitive) To reduce the difficulty of (something).","e":"We had to ease the entry requirements."},{"m":"(transitive) To move (something) slowly and carefully.","e":"He eased the car into the parking space."}]}]},"eastern":{"h":"eastern","i":"/ˈiːstə(r)n/","a":"en-us-eastern.ogg","s":[{"p":"adjective","d":[{"m":"Of, facing, situated in, or related to the east.","e":"Washington, D.C. is on the eastern side of United States."},{"m":"(of a wind) ing from the east; easterly."},{"m":"(loosely) Asia."}]}]},"eldest":{"h":"eldest","i":"/ˈɛldɪst/","a":"LL-Q1860 (eng)-Vealhurl-eldest.wav","l":"old","q":"adjective"},"embassy":{"h":"embassy","i":"/ˈɛmbəsi/","a":"en-us-embassy.ogg","s":[{"p":"noun","d":[{"m":"The official office and living area of one country in another country. Such as an ambassador.","e":"The American embassy to France is located in Paris."},{"m":"The function or job of an ambassador."}]}]},"eve":{"h":"eve","i":"/iːv/","a":"en-us-eve.ogg","s":[{"p":"noun","d":[{"m":"The day or night before, usually used for holidays.","e":"My parents always let me open one gift on Christmas Eve."},{"m":".","e":"One the eve of our wedding anniversary, I give my wife a red rose."}]}]},"escort":{"h":"escort","i":"/ˈɛs.kɔrt/","a":"en-us-escort.ogg","s":[{"p":"noun","d":[{"m":"(countable) A group of people (often with guns) who protect a famous person; a guard."},{"m":"(countable) Someone's date; a person who goes with you in a social gathering.","e":"I was her escort for the evening."},{"m":"(countable) An escort is a sex worker who makes appointments with their clients and does not work in a brothel."}]},{"p":"verb","d":[{"m":"To guard and protect someone or something.","e":"The police escorted the President."},{"m":"To escort is to go with somebody."}]}]},"escorts":{"h":"escorts","l":"escort","q":"noun"},"escorted":{"h":"escorted","l":"escort","q":"verb"},"escorting":{"h":"escorting","l":"escort","q":"verb"},"enthusiasm":{"h":"enthusiasm","i":"/ɛnˈθjuːzɪæzəm/","a":"en-us-enthusiasm.ogg","s":[{"p":"noun","d":[{"m":"Having a strong feeling of interest.","e":"John showed a lot of enthusiasm when he started his new job."}]}]},"essay":{"h":"essay","i":"/ˈɛˌseɪ/","a":"en-us-essay.ogg","s":[{"p":"noun","d":[{"m":"Writing that looks at an issue or subject.","e":"Each student had to write an essay on his favorite author."}]},{"p":"verb","d":[{"m":"(transitive) To try."},{"m":"(intransitive) To move forth, as into battle."}]}]},"expose":{"h":"expose","i":"/ɪkˈspəʊz/","a":"en-us-expose.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If x is exposed to y, x sees, is touched by, or is influenced by y.","e":"She got sick when she was exposed to the virus."},{"m":"(photography) To put light on photographic film, which either ruins it or takes a picture.","e":"Has this film been exposed?"}]}]},"era":{"h":"era","i":"/ˈiə(r).ə/","a":"En-us-era.ogg","s":[{"p":"noun","d":[{"m":"A time period, generally more than one year. Often used to show a time when something important was happening.","e":"The Elizabethan era is when Queen Elizabeth was the Queen of England."},{"m":"A geological series of rocks laid down over several hundred million years.","e":"Dinosaurs lived during the Mesozoic era."}]}]},"enthusiastic":{"h":"enthusiastic","i":"/ɛnθuziˈæstɪk/","a":"en-us-enthusiastic.ogg","s":[{"p":"adjective","d":[{"m":"Enthusiastic means having or showing intense enjoyment, interest, or approval.","e":"Jane was the most enthusiastic about shopping."}]}]},"exhaust":{"h":"exhaust","i":"/ɪgˈzɔst/","a":"en-us-exhaust.ogg","s":[{"p":"verb","d":[{"m":"To use up completely.","e":"So many people came to dinner that we had exhausted the supply of silverware. I had to use my fingers."},{"m":"To empty by using.","e":"The well was exhausted."},{"m":"To wear out; use up one's strength, patience, or resources.","e":"You look exhausted, have you had any sleep?"},{"m":"To completely develop or discuss some topic or idea.","e":"We exhausted our money saving topic, there was nothing else to talk about on it."}]},{"p":"noun","d":[{"m":"The part of an engine or motor where burned gases or steam comes out."},{"m":"A pipe or vent used to take bad air out of a room or closed space."}]}]},"fir":{"h":"fir","i":"/fɜː(r)/","a":"en-uk-fir.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kind of tree that keeps its leaves all year.","e":"My Christmas tree is a fir tree."}]}]},"flu":{"h":"flu","i":"/fluː/","a":"en-us-flu.ogg","s":[{"p":"noun","d":[{"m":"Short for influenza.","e":"Sally must have the flu, she has been coughing and sneezing all day."},{"m":"(informal)."}]}]},"isolation":{"h":"isolation","i":"/ˌaɪsəˈleɪʃən/","a":"LL-Q1860 (eng)-Berrely-isolation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) When something is isolated, not together with others, apart, alone, or separated.","e":"Some people in Tibet live in isolation because of the large mountain ranges."},{"m":"When a country chooses not to trade or relate with other countries.","e":"The isolation of North Korea is a common topic in politics."}]}]},"racism":{"h":"racism","i":"/ˈreɪsɪzm̩/","a":"en-us-racism.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Racism is the belief that all people of one race are different from all people of another race."},{"m":"(uncountable) Racism is the belief that one race is better than all others."},{"m":"(uncountable) Racism is the act of treating someone differently because of race."}]}]},"prosperity":{"h":"prosperity","i":"/ˈprɒs.pɛ.rɪt.iː/","a":"en-us-prosperity.ogg","s":[{"p":"noun","d":[{"m":"Prosperity refers to the state when someone has a lot of money or good fortune."}]}]},"populist":{"h":"populist","i":"/ˈpɒp.jʊ.lɪst/","s":[{"p":"noun","d":[{"m":"(countable) A person who wants more democracy."},{"m":"(countable) A politician who wants to create programs just because they are popular."},{"m":"(countable) A person who likes populism."}]}]},"legend":{"h":"legend","i":"/ˈlɛʤ.ənd/","a":"en-us-legend.ogg","s":[{"p":"noun","d":[{"m":"(countable) A legend is a story that has been passed down through the years, with no certain starting point, that is part of the history of a place."},{"m":"(countable) A legend is a small bit of truth that has been made to look better than it actually is."},{"m":"(countable) A legend is a person who has done an amazing accomplishment."},{"m":"(countable) A legend is a key to the symbols drawn on a map."}]}]},"tranquility":{"h":"tranquility","a":"en-us-tranquillity.ogg","s":[{"p":"noun","d":[{"m":"The state of being tranquil."},{"m":"The absence of disturbance; peacefulness."},{"m":"The absence of stress; serenity."},{"m":"The quality of calmness."}]}]},"frost":{"h":"frost","i":"/frɒst/","a":"en-us-frost.ogg","s":[{"p":"noun","d":[{"m":"Frost is a cover of thin ice on things. Some of these are tree branches, plants, leaves, wires, poles, cars, rooftops, or windows. Frost is like dew, only frozen. Frost can be light or heavy.","e":"The car windows were heavy with frost."}]},{"p":"verb","d":[{"m":"To get covered with frost.","e":"The refrigerator frosted the glasses."},{"m":"To cover a cake with icing/frosting to looking like frost.","e":"Lilly frosted the birthday cake."},{"m":"To anger or annoy.","e":"I think the boss's decision frosted him a bit."}]}]},"populists":{"h":"populists","l":"populist","q":"noun"},"flus":{"h":"flus","l":"flu","q":"noun"},"creaks":{"h":"creaks","i":"/kriːks/","l":"creak","q":"noun"},"creaked":{"h":"creaked","i":"/kriːkt/","l":"creak","q":"verb"},"creaking":{"h":"creaking","i":"/ˈkriːkɪŋ/","l":"creak","q":"verb"},"atmospheric":{"h":"atmospheric","i":"/ˌætməsˈfɛrɪk/","a":"LL-Q1860 (eng)-Vealhurl-atmospheric.wav","s":[{"p":"adjective","d":[{"m":"If something is atmospheric, it relates to, is made by, or comes from the atmosphere in some way."},{"m":"If something is atmospheric, it has a particular emotional or aesthetic quality to it."}]}]},"atmospherical":{"h":"atmospherical","s":[{"p":"adjective","d":[{"m":"If something is atmospherical, it relates to, is made by, or comes from the atmosphere in some way."},{"m":"If something is atmospherical, it has a particular emotional or aesthetic quality to it."}]}]},"legends":{"h":"legends","l":"legend","q":"noun"},"frosts":{"h":"frosts","l":"frost","q":"noun"},"myths":{"h":"myths","l":"myth","q":"noun"},"frosted":{"h":"frosted","l":"frost","q":"verb"},"frosting":{"h":"frosting","i":"/ˈfrɒst.ɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-frosting.wav","l":"frost","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) Frosting is a sugary cream that is put on the top and sides of a cake.","e":"Do you like chocolate or vanilla frosting on your birthday cake?"}]}]},"frostings":{"h":"frostings","l":"frosting","q":"noun"},"whiskeys":{"h":"whiskeys","l":"whiskey","q":"noun"},"ops":{"h":"ops","l":"op","q":"verb"},"opped":{"h":"opped","l":"op","q":"verb"},"opping":{"h":"opping","l":"op","q":"verb"},"midlands":{"h":"midlands","l":"midland","q":"noun"},"hams":{"h":"hams","l":"ham","q":"noun"},"fiddle":{"h":"fiddle","i":"/ˈfɪ.dl̩/","a":"en-us-fiddle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fiddle is a violin when played in a style not like the classical violin.","e":"When I play it like this, it's a fiddle; when I play it like that, it's a violin."}]},{"p":"verb","d":[{"m":"To play without working.","e":"You're fiddling your life away."},{"m":"To fiddle with something is trying to make something work by adjusting it.","e":"I needed to fiddle with my computer's speakers to get them to work."},{"m":"To play traditional songs on a violin in a style not like classical music."}]}]},"fax":{"h":"fax","i":"/fæks/","a":"en-us-fax.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fax is a document that is sent from one fax machine to another, which is then printed out by the receiving fax machine.","e":"Did you get the fax I sent you this morning?"},{"m":"(countable) A fax is a machine that sends a letter or document through a telephone line; a fax machine."}]},{"p":"verb","d":[{"m":"To send a document via a fax machine.","e":"Please fax the bill and I will pay it."}]}]},"faxes":{"h":"faxes","l":"fax","q":"noun"},"faxed":{"h":"faxed","l":"fax","q":"verb"},"faxing":{"h":"faxing","l":"fax","q":"verb"},"fiddles":{"h":"fiddles","l":"fiddle","q":"noun"},"fiddled":{"h":"fiddled","l":"fiddle","q":"verb"},"conservatives":{"h":"conservatives","l":"conservative","q":"noun"},"flap":{"h":"flap","i":"/flæp/","a":"en-us-flap.ogg","s":[{"p":"noun","d":[{"m":"(countable) A flap is something that is long and loose that moves, often covering something."},{"m":"(countable) A flap is when people get excited and talk about something that happened.","e":"The comment caused quite a flap in the newspapers."},{"m":"(countable) Flap is the movement of anything long and loose, or the sound made from it.","e":"He opened the door with a flap."},{"m":"(countable) A flap is the part of the airplane wing that moves.","e":"The pilot put the flaps up so the plan would go up."}]},{"p":"verb","d":[{"m":"(transitive) If you flap something, you move something long back and forward."},{"m":"(intransitive) If you flap, you move loosely back and forward.","e":"The bird flapped its wings."}]}]},"flaps":{"h":"flaps","l":"flap","q":"noun"},"flapped":{"h":"flapped","l":"flap","q":"verb"},"flapping":{"h":"flapping","l":"flap","q":"verb"},"pulse":{"h":"pulse","i":"/pʌls/","a":"en-us-pulse.ogg","s":[{"p":"noun","d":[{"m":"(countable)A pulse is a rhythmic, soft beating of the, for example, as felt in the wrists","e":"He checked her pulse and discovered that her heart was racing."},{"m":"Each beat of the arteries or heart."},{"m":"Feeling of life or emotion"},{"m":"Beating, especially of music"}]},{"p":"verb","d":[{"m":"To beat or throb."}]}]},"proprietary":{"h":"proprietary","i":"/prəˈpraɪ.ə.tə.ri/","a":"en-us-proprietary.ogg","s":[{"p":"adjective","d":[{"m":"If something is proprietary, it is of or relating to property or ownership, as proprietary rights."},{"m":"If something is proprietary, it is of or relating to the quality of being an owner, as the proprietary class."},{"m":"If something is proprietary, it is manufactured exclusively by the owner of, as with a patent or trade secret.","e":"The profitability of the company is based on its many proprietary products."},{"m":"If something is proprietary, it is privately owned, as a proprietary lake."},{"m":"(of a person) If someone is proprietary, that person is possessive, jealous, or territorial."}]}]},"tastier":{"h":"tastier","l":"tasty","q":"adjective"},"tastiest":{"h":"tastiest","l":"tasty","q":"adjective"},"mocks":{"h":"mocks","l":"mock","q":"noun"},"mocked":{"h":"mocked","l":"mock","q":"verb"},"mocking":{"h":"mocking","i":"/ˈmɑkɪŋ/","a":"en-us-mocking.ogg","l":"mock","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is mocking, it makes fun of someone in a cruel way"}]}]},"faker":{"h":"faker","i":"/ˈfeɪkɚ/","a":"LL-Q1860 (eng)-Vealhurl-faker.wav","l":"fake","q":"adjective","s":[{"p":"noun","d":[{"m":"(countable) Someone who fakes something."},{"m":"(countable) An imposter or impersonator."}]}]},"fakers":{"h":"fakers","l":"faker","q":"noun"},"fakest":{"h":"fakest","l":"fake","q":"adjective"},"mobs":{"h":"mobs","l":"mob","q":"noun"},"mobbed":{"h":"mobbed","l":"mob","q":"verb"},"mobbing":{"h":"mobbing","l":"mob","q":"verb"},"leukocytosis":{"h":"leukocytosis","s":[{"p":"noun","d":[{"m":"Leukocytosis is a condition where you have too many white blood cells."}]}]},"durations":{"h":"durations","l":"duration","q":"noun"},"juniors":{"h":"juniors","l":"junior","q":"noun"},"readings":{"h":"readings","l":"reading","q":"noun"},"kingdoms":{"h":"kingdoms","a":"en-us-kingdoms.ogg","l":"kingdom","q":"noun"},"candles":{"h":"candles","i":"/ˈkændl̩z/","l":"candle","q":"noun"},"candled":{"h":"candled","l":"candle","q":"verb"},"candling":{"h":"candling","l":"candle","q":"verb"},"fuss":{"h":"fuss","i":"/fʌs/","a":"en-us-fuss.ogg","s":[{"p":"noun","d":[{"m":"Too much activity, worry, bother, or talk about something.","e":"They made a big fuss about the wedding plans."},{"m":"A complaint or noise.","e":"If you make enough of a fuss about the problem, maybe they'll fix it for you."},{"m":"A show of affection or about liking something.","e":"They made a great fuss over the new baby."}]},{"p":"verb","d":[{"m":"(intransitive) To be very worried or excited about something, often too much.","e":"His grandmother will never quit fussing over his cigarette smoking."},{"m":"(intransitive) To fiddle; to move about, or adjust; to worry something","e":"Quit fussing with your hair. It looks fine."}]}]},"fusses":{"h":"fusses","l":"fuss","q":"noun"},"fussed":{"h":"fussed","l":"fuss","q":"verb"},"fussing":{"h":"fussing","l":"fuss","q":"verb"},"consents":{"h":"consents","l":"consent","q":"noun"},"consented":{"h":"consented","l":"consent","q":"verb"},"consenting":{"h":"consenting","l":"consent","q":"verb"},"displays":{"h":"displays","a":"en-us-displays.ogg","l":"display","q":"noun"},"displayed":{"h":"displayed","a":"en-us-displayed.ogg","l":"display","q":"verb"},"displaying":{"h":"displaying","a":"en-us-displaying.ogg","l":"display","q":"verb"},"brand":{"h":"brand","i":"/brand/","a":"en-us-brand.ogg","s":[{"p":"noun","d":[{"m":"A brand is a red-hot piece of wood in a fire.","e":"Don't touch that brand!"},{"m":"A brand can be a symbol that means you own something.","e":"What cereal brand do you like?"},{"m":"A brand is a specific type of something."}]},{"p":"verb","d":[{"m":"If you brand someone, you make a mark or a symbol on them by burning them.","e":"Go out and brand all of our cows."},{"m":"To brand is to label (often someone)."}]}]},"branded":{"h":"branded","l":"brand","q":"verb"},"branding":{"h":"branding","i":"/ˈbrandɪŋ/","l":"brand","q":"verb","s":[{"p":"noun","d":[{"m":"Branding is the action of marking with a branding iron."},{"m":"Branding is the promotion of a product or company."}]}]},"brands":{"h":"brands","l":"brand","q":"noun"},"jollier":{"h":"jollier","l":"jolly","q":"adjective"},"jolliest":{"h":"jolliest","l":"jolly","q":"adjective"},"jollies":{"h":"jollies","l":"jolly","q":"noun"},"jollied":{"h":"jollied","l":"jolly","q":"verb"},"jollying":{"h":"jollying","l":"jolly","q":"verb"},"stampede":{"h":"stampede","i":"/stæmˈpiːd/","a":"en-us-stampede.ogg","s":[{"p":"noun","d":[{"m":"A stampede is when a group of people or animals runs away in a panic.","e":"Buffalo stampedes were very dangerous and deadly situations."}]},{"p":"verb","d":[{"m":"To run away in a panic.","e":"People stampeded from the burning theater."}]}]},"eases":{"h":"eases","l":"ease","q":"verb"},"eased":{"h":"eased","l":"ease","q":"verb"},"easing":{"h":"easing","l":"ease","q":"verb"},"embassies":{"h":"embassies","l":"embassy","q":"noun"},"leukemia":{"h":"leukemia","i":"/luˈkimiə/","a":"LL-Q1860 (eng)-Vealhurl-leukemia.wav","s":[{"p":"noun","d":[{"m":", (uncountable) Leukemia is a cancer of the blood or bone marrow where you have too many blood cells (usually white blood cells)."},{"m":", (countable) A leukemia is any certain kind or type of cancer that affects the tissue that makes blood."}]}]},"osteosarcoma":{"h":"osteosarcoma","s":[{"p":"noun","d":[{"m":"(uncountable) Osteosarcoma is a kind of bone cancer."}]}]},"attendance":{"h":"attendance","i":"/əˈten.dənts/","a":"LL-Q1860 (eng)-Vealhurl-attendance.wav","s":[{"p":"noun","d":[{"m":"If you are attending something, you are in attendance for that event.","e":"Attendance at the meeting is required."},{"m":"Attendance is the total number of people at an event.","e":"The total attendance for the soccer game was 70,564 people."},{"m":"The total number of times that someone has attended something is their attendance.","e":"John's attendance record for work was not good."}]}]},"forecast":{"h":"forecast","i":"/ˈfɔrkæst/","a":"en-us-forecast.ogg","s":[{"p":"verb","d":[{"m":"To forecast is to make an educated guess about the future.","e":"His forecast of how much money the company would make this month was much higher than the actual amount."}]},{"p":"noun","d":[{"m":"A forecast is a guess of something in the future."},{"m":"A forecast is a prediction of the weather.","e":"What's the forecast for tomorrow?"}]}]},"forecasts":{"h":"forecasts","l":"forecast","q":"verb"},"forecasted":{"h":"forecasted","l":"forecast","q":"verb"},"forecasting":{"h":"forecasting","l":"forecast","q":"verb"},"folder":{"h":"folder","i":"/ˈfəʊldə(r)/","a":"en-us-folder.ogg","s":[{"p":"noun","d":[{"m":"(countable) A folder holds papers, usually with an writing on the top to show what is inside it.","e":"I keep all my schoolwork in a yellow folder."},{"m":"(countable) A container on a computer which files and other folders may be saved. The files and subfolders in a folder are often about the same thing.","e":"I save my writing in the folder called \"My Documents\""},{"m":"Someone or something that folds things."}]}]},"folders":{"h":"folders","l":"folder","q":"noun"},"attendances":{"h":"attendances","l":"attendance","q":"noun"},"eves":{"h":"eves","i":"/iːvz/","l":"eve","q":"noun"},"municipality":{"h":"municipality","i":"/ˈmjʊu.nɪs.ɪ.pæl.It.ɪi/","a":"LL-Q1860 (eng)-Vealhurl-municipality.wav","s":[{"p":"noun","d":[{"m":"(countable) A district with a government that usually encloses no other governed districts; a borough, city, town, or village."}]}]},"leukopenia":{"h":"leukopenia","s":[{"p":"noun","d":[{"m":"Leukopenia is an abnormal decrease in the number of white blood cells in the blood."}]}]},"municipalities":{"h":"municipalities","l":"municipality","q":"noun"},"leukopenias":{"h":"leukopenias","l":"leukopenia","q":"noun"},"enthusiasms":{"h":"enthusiasms","l":"enthusiasm","q":"noun"},"exposes":{"h":"exposes","l":"expose","q":"verb"},"exposed":{"h":"exposed","l":"expose","q":"verb"},"exposing":{"h":"exposing","l":"expose","q":"verb"},"essays":{"h":"essays","a":"en-us-essays.ogg","l":"essay","q":"noun"},"essayed":{"h":"essayed","l":"essay","q":"verb"},"essaying":{"h":"essaying","l":"essay","q":"verb"},"eras":{"h":"eras","l":"era","q":"noun"},"exhausts":{"h":"exhausts","l":"exhaust","q":"verb"},"exhausting":{"h":"exhausting","l":"exhaust","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is exhausting, it is requires a lot of energy to do it.","e":"This task is exhausting!"}]}]},"exhausted":{"h":"exhausted","i":"/ɪɡˈzɔstɪd/","a":"en-us-exhausted.ogg","l":"exhaust","q":"verb","s":[{"p":"adjective","d":[{"m":"; very tired; in a state of exhaustion.","e":"The exhausted man fell asleep immediately."}]}]},"firs":{"h":"firs","a":"en-us-furs.ogg","l":"fir","q":"noun"},"fiddling":{"h":"fiddling","l":"fiddle","q":"verb"},"pulses":{"h":"pulses","l":"pulse","q":"noun"},"pulsed":{"h":"pulsed","l":"pulse","q":"verb"},"pulsing":{"h":"pulsing","l":"pulse","q":"verb"},"leukocytoses":{"h":"leukocytoses","l":"leukocytosis","q":"noun"},"stampedes":{"h":"stampedes","l":"stampede","q":"noun"},"stampeded":{"h":"stampeded","l":"stampede","q":"verb"},"stampeding":{"h":"stampeding","l":"stampede","q":"verb"},"flautist":{"h":"flautist","i":"/flaʊtɪst/","s":[{"p":"noun","d":[{"m":"(countable) A flautist is someone who plays the flute.","e":"The flautist played beautifully in the concert."}]}]},"violinist":{"h":"violinist","i":"/vaɪəlɪˈnɪst/","a":"LL-Q1860 (eng)-Vealhurl-violinist.wav","s":[{"p":"noun","d":[{"m":"(countable) A violinist is someone who plays the violin.","e":"The violinist played a duet with the cellist."}]}]},"germ":{"h":"germ","i":"/d͡ʒɜːm/","a":"en-us-germ.ogg","s":[{"p":"noun","d":[{"m":"(countable) A germ is a very small organism that makes other organisms sick, a virus, bacteria, or fungus."},{"m":"(countable) A germ is a part of an organism that can develop into a new one."}]}]},"ownership":{"h":"ownership","a":"en-us-ownership.ogg","s":[{"p":"noun","d":[{"m":"Ownership is the condition of being an owner."}]}]},"scab":{"h":"scab","i":"/skæb/","a":"en-us-scab.ogg","s":[{"p":"noun","d":[{"m":"(countable) A scab is made from dried blood and plasma, and forms over a wound.","e":"The boy kept picking at his scab until the wound began to bleed."},{"m":"(countable) A scab is a person who works during a strike.","e":"The workers shouted abuse at the scabs who went into the factory."}]}]},"fringe":{"h":"fringe","i":"/frɪndʒ/","a":"en-us-fringe.ogg","s":[{"p":"adjective","d":[{"m":"Something that is a fringe, is outside what is commonly accepted or outside the mainstream"}]},{"p":"noun","d":[{"m":"(countable) A edge or border used to make something fancy.","e":"The flag has a yellow fringe."},{"m":"A part on the outside."},{"m":"Those members of a political party, or any social group, holding uncommon ideas or views."},{"m":"The edge of a town or city."},{"m":"That part of the hair that hangs down over the eyes (US bangs)."},{"m":"A light or dark band formed by the diffraction of light.","e":"Interference fringe."}]},{"p":"verb","d":[{"m":"(transitive) To decorate with fringe."},{"m":"(transitive) To serve as a fringe."}]}]},"esteem":{"h":"esteem","i":"[ɛsˈtiːm]","a":"en-us-esteem.ogg","s":[{"p":"noun","d":[{"m":"A good opinion of someone or a view of high importance and respect for them.","e":"He was an author who was held in high esteem."}]},{"p":"verb","d":[{"m":"(formal) to view someone or something as important, and respectable.","e":"Esteemed by all, Sharon was a good leader."}]}]},"gossip":{"h":"gossip","i":"/ˈɡɒs.ɪp/","a":"en-us-gossip.ogg","s":[{"p":"noun","d":[{"m":"Gossip is information that people pass around about other people's lives, often including things that are unkind or untrue.","e":"She spends a lot of time catching up with the newest gossip."},{"m":"A gossip is a person who passes around a lot of this kind of information.","e":"Bob is a real gossip."}]},{"p":"verb","d":[{"m":"To talk about other people's lives, including things that are unkind or untrue.","e":"The girls were gossiping about their teachers."}]}]},"guardian":{"h":"guardian","i":"/ˈɡɑr.di.ən/","a":"en-us-guardian.ogg","s":[{"p":"noun","d":[{"m":"A guardian is the person who is responsible by law for looking after a child, especially if it is not their parents.","e":"His grandmother was his legal guardian."},{"m":"(countable) A guardian is a person who guards or protects something."}]}]},"fringes":{"h":"fringes","l":"fringe","q":"noun"},"fringed":{"h":"fringed","l":"fringe","q":"verb"},"fringing":{"h":"fringing","l":"fringe","q":"verb"},"unofficial":{"h":"unofficial","s":[{"p":"adjective","d":[{"m":"Something that is unofficial is not approved by some authority.","e":"The voting results are unofficial because they have not been approved by the committee yet."}]}]},"reputation":{"h":"reputation","i":"/ˌrepjʊˈteɪʃən/","a":"en-us-reputation.ogg","s":[{"p":"noun","d":[{"m":"(countable) Reputation is what people think about someone or something because of things that happened in the past.","e":"The restaurant had a bad reputation for its slow service."}]}]},"inequality":{"h":"inequality","i":"/ˌɪnɪˈkwɐləti/","s":[{"p":"noun","d":[{"m":"Inequality is when one group has more (power, money, things) than another and it is unfair.","e":"The inequality in education opportunities across Asia was appalling."}]}]},"homesick":{"h":"homesick","s":[{"p":"adjective","d":[{"m":"When you are homesick, you feel sad because you are far away from your home or country and you miss it.","e":"She was homesick because she found it hard to settle into her new school."}]}]},"reconstruction":{"h":"reconstruction","i":"/rɛkənˈstrʌkʃən/","a":"LL-Q1860 (eng)-Vininn126-reconstruction.wav","s":[{"p":"noun","d":[{"m":"The reconstruction of something is the act of rebuilding something.","e":"The Globe Theatre in London is a reconstruction of the original."}]}]},"burgle":{"h":"burgle","i":"/ˈbɜːɡəl/","a":"EN-AU ck1 burgle.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you burgle a home, you enter it and steal things from it.","e":"The two men on bikes burgled that house."}]}]},"weed":{"h":"weed","i":"/wiːd/","a":"en-us-weed.ogg","l":"wee","q":"verb","s":[{"p":"noun","d":[{"m":"A weed is an unwanted plant."},{"m":"Weed is marijuana."}]}]},"congratulate":{"h":"congratulate","i":"/kənˈɡræ.t͡ʃʊˌleɪt/","a":"en-uk-congratulate.ogg","s":[{"p":"verb","d":[{"m":"To congratulate somebody is to tell them that they did a good job."}]}]},"fascinate":{"h":"fascinate","i":"/ˈfæsɪneɪt/","a":"LL-Q1860 (eng)-Vealhurl-fascinate.wav","s":[{"p":"verb","d":[{"m":"Fascinate means a person or thing that interests someone very much."}]}]},"parade":{"h":"parade","i":"/pəˈreɪd/","a":"en-us-parade.ogg","s":[{"p":"noun","d":[{"m":"(countable) A parade is an event which involves moving from one place to another. Sometimes marching is a part of the event.","e":"We saw the band playing in the parade."}]},{"p":"verb","d":[{"m":"(intransitive) To parade is to march."}]}]},"veganism":{"h":"veganism","s":[{"p":"noun","d":[{"m":"Veganism is the belief that animals should not be eaten or used."}]}]},"vegetarianism":{"h":"vegetarianism","i":"/vɛd͡ʒɪˈtɛri.ənɪzəm/","a":"LL-Q1860 (eng)-Vealhurl-vegetarianism.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Vegetarianism is the practice of not eating meat."},{"m":"Vegetarianism is the viewpoint that eating meat is wrong."}]}]},"distraction":{"h":"distraction","i":"/dɪsˈtrækʃən/","a":"en-us-distraction.ogg","s":[{"p":"noun","d":[{"m":"(countable) A distraction is something that makes you pay attention to something different than what you were paying attention to before.","e":"s are a distraction to your school work. You must stop thinking about them whenever you do your school work or else you will fail at school."}]}]},"abnormally":{"h":"abnormally","i":"/æbˈnɔr.mə.li/","a":"LL-Q1860 (eng)-Vealhurl-abnormally.wav","s":[{"p":"adverb","d":[{"m":"When something is done abnormally, it is done in a way that is not normal; it is done in an abnormal way."}]}]},"approximation":{"h":"approximation","i":"/əˌprɒksɪˈmeɪʃn/","s":[{"p":"noun","d":[{"m":"An approximation is an educated guess."}]}]},"weeds":{"h":"weeds","a":"En-us-weeds.ogg","l":"weed","q":"noun"},"recreation":{"h":"recreation","i":"/rɛkriˈeɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-recreation (fun).wav","s":[{"p":"noun","d":[{"m":"Recreation is any activity that amuses or is fun.","e":"The doctor recommended three hours of outdoor recreation."},{"m":"(countable) The recreation of something is when it is created again.","e":"The recreation of the event sparked controversy."}]}]},"bathe":{"h":"bathe","i":"/beɪð/","a":"en-us-bathe.ogg","s":[{"p":"verb","d":[{"m":"When you bathe, you clean yourself with water.","e":"I bathe at least two times a day to keep myself clean and refreshed."}]}]},"breathe":{"h":"breathe","i":"/briːð/","a":"en-us-breathe.ogg","s":[{"p":"verb","d":[{"m":"If you breathe, you inhale and exhale air."}]}]},"inhale":{"h":"inhale","i":"/ɪnˈheɪl/","a":"en-us-inhale.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you inhale, you pull air in through your mouth."}]}]},"breathes":{"h":"breathes","l":"breathe","q":"verb"},"breathed":{"h":"breathed","l":"breathe","q":"verb"},"breathing":{"h":"breathing","i":"/ˈbriːðɪŋ/","a":"LL-Q1860 (eng)-Persent101-breathing.wav","l":"breathe","q":"verb"},"inhales":{"h":"inhales","l":"inhale","q":"verb"},"inhaled":{"h":"inhaled","l":"inhale","q":"verb"},"inhaling":{"h":"inhaling","l":"inhale","q":"verb"},"curious":{"h":"curious","i":"/ˈkjʊə.ri.əs/","a":"en-us-curious.ogg","s":[{"p":"adjective","d":[{"m":"If someone is curious, they ask a lot of questions and want to know new things."},{"m":"If someone or something is curious, he/she/it is strange or unusual."}]}]},"curiouser":{"h":"curiouser","l":"curious","q":"adjective"},"junk":{"h":"junk","i":"/d͡ʒʌŋk/","a":"en-au-junk.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Junk is things that nobody wants or needs."},{"m":