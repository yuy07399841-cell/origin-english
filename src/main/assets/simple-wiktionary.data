id","i":"/fɚˈbɪd/","a":"en-us-forbid.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you forbid someone from doing something, you do not allow them to do it; you disallow it.","e":"The teacher forbids you from eating or drinking during the class."}]}]},"forbids":{"h":"forbids","l":"forbid","q":"verb"},"forbade":{"h":"forbade","i":"/ˌforˈbæd/","a":"en-us-forbade.ogg","l":"forbid","q":"verb"},"forbidding":{"h":"forbidding","i":"/fɚˈbɪdɪŋ/","l":"forbid","q":"verb","s":[{"p":"adjective","d":[{"m":"If something looks forbidding, it looks threatening; it looks menacing."},{"m":"If someone is forbidding, they are very unpleasant; they are very disagreeable."}]}]},"advantageous":{"h":"advantageous","i":"/ˌædvənˈteɪd͡ʒəs/","a":"LL-Q1860 (eng)-Vealhurl-advantageous.wav","s":[{"p":"adjective","d":[{"m":"If something is advantageous, it gives an advantage to something or someone; it is profitable; it is useful.","e":"The cliff was an advantageous spot for the army to use to spy on their enemies."}]}]},"disadvantageous":{"h":"disadvantageous","i":"/dɪsˌædvənˈteɪdʒəs/","s":[{"p":"adjective","d":[{"m":"If something is disadvantageous, it is making something more difficult.","e":"Not getting enough sleep before the big test can be very disadvantageous."}]}]},"advantageousness":{"h":"advantageousness","s":[{"p":"noun","d":[{"m":"(uncountable) Advantageousness is the state of being advantageous."}]}]},"criminality":{"h":"criminality","i":"/krɪməˈnælɪti/","s":[{"p":"noun","d":[{"m":"(uncountable) Criminality is the state of being criminal.","e":"If things do not change, we will descend into an unending darkness of corruption, criminality, murder, and reprisal."}]}]},"molder":{"h":"molder","s":[{"p":"noun","d":[{"m":"(countable) A molder is a person who makes molds."},{"m":"(countable) A molder is a tool for making molds."},{"m":"(countable) A molder is a machine used to make molding."}]}]},"molders":{"h":"molders","l":"molder","q":"noun"},"mold":{"h":"mold","i":"/məʊld/","a":"en-us-mould.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you mold something, you make it in a mold."},{"m":"(transitive) If you mold something, you shape it into a particular form or shape.","e":"The molten metal was molded into a sword."},{"m":"(transitive) If you mold something, you guide the growth or development of someone.","e":"A teacher molds their students into educated adults."},{"m":"(transitive) If you mold something, you decorate it with moldings.","e":"The interior of the house was molded today."}]}]},"molds":{"h":"molds","l":"mold","q":"noun"},"molded":{"h":"molded","l":"mold","q":"verb"},"molding":{"h":"molding","i":"/ˈməʊl.dɪŋ/","l":"mold","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) Molding is the process of making something in a mold; it is the work that a molder does."},{"m":"(countable) A molding is a narrow curved surface used for decoration."}]}]},"moldings":{"h":"moldings","l":"molding","q":"noun"},"mould":{"h":"mould","i":"/məʊld/","a":"en-us-mould.ogg","s":[{"p":"noun","d":[{"m":"(countable)"}]},{"p":"verb","d":[{"m":"(transitive)"}]}]},"moulds":{"h":"moulds","l":"mould","q":"noun"},"moulded":{"h":"moulded","l":"mould","q":"verb"},"moulding":{"h":"moulding","l":"mould","q":"verb","s":[{"p":"noun","d":[{"m":"(countable)"}]}]},"mouldings":{"h":"mouldings","l":"moulding","q":"noun"},"periphery":{"h":"periphery","i":"/pəˈrɪfəri/","a":"en-us-periphery.ogg","s":[{"p":"noun","d":[{"m":"(countable) A periphery is an outside boundary or surface of something.","e":"The suburbs are a city's periphery."}]}]},"peripheries":{"h":"peripheries","l":"periphery","q":"noun"},"moldy":{"h":"moldy","i":"/ˈmoʊldi/","a":"en-us-moldy.ogg","s":[{"p":"adjective","d":[{"m":"If something is moldy, it is covered in mold.","e":"The bread was moldy after it was left out overnight."},{"m":"If something is moldy, it is stale or musty."}]}]},"moldier":{"h":"moldier","l":"moldy","q":"adjective"},"moldiest":{"h":"moldiest","l":"moldy","q":"adjective"},"skyline":{"h":"skyli