"h":"glistening","l":"glisten","q":"verb"},"yiddishisms":{"h":"Yiddishisms","l":"yiddishism","q":"noun"},"championship":{"h":"championship","i":"/ˈtʃæmpi.ənʃɪp/","a":"LL-Q1860 (eng)-Vealhurl-championship.wav","s":[{"p":"noun","d":[{"m":"(countable) A championship is a contest to decide which person or team is best at the sport.","e":"Gene Tunney won the world heavyweight boxing championship from Jack Dempsey."}]}]},"championships":{"h":"championships","l":"championship","q":"noun"},"discourage":{"h":"discourage","i":"/dɪsˈkʌrɪd͡ʒ/","a":"en-us-discourage.ogg","s":[{"p":"verb","d":[{"m":"If someone discourages you, they are you not to do something.","e":"The government's plan is to discourage the people from owning cars."}]}]},"infringement":{"h":"infringement","i":"/ɪnˈfrɪnd͡ʒmənt/","a":"en-us-infringement.ogg","s":[{"p":"noun","d":[{"m":"An infringement means the breaking of rules and laws."}]}]},"advertisers":{"h":"advertisers","l":"advertiser","q":"noun","s":[{"p":"noun","d":[{"m":"Advertisers are people or companies that tell the public about a product or a service, usually on TV, the Internet, newspapers, etc., usually to sell them their product."}]}]},"blower":{"h":"blower","i":"/ˈbləʊ.ə/","a":"en-au-blower.ogg","s":[{"p":"noun","d":[{"m":"(countable) A blower is machine that moves air quickly to dry or heat something."}]}]},"blowers":{"h":"blowers","l":"blower","q":"noun","s":[{"p":"noun","d":[{"m":"Blowers are machines that move air quickly to dry or heat something."}]}]},"boyish":{"h":"boyish","i":"/ˈbɔɪ.ɪʃ/","a":"LL-Q1860 (eng)-Vealhurl-boyish.wav","s":[{"p":"adjective","d":[{"m":"Someone who is boyish is like a boy or young man in a good way."}]}]},"catcher":{"h":"catcher","i":"/ˈkætʃ.ə(r)/","a":"en-us-catcher.ogg","s":[{"p":"noun","d":[{"m":"(countable) A catcher is a person or thing that catches something."}]}]},"incumbency":{"h":"incumbency","i":"/ɪŋˈkʌmbənsi/","a":"LL-Q1860 (eng)-Vealhurl-incumbency.wav","s":[{"p":"noun","d":[{"m":"Incumbency is the position or quality of being incumbent."},{"m":"Incumbency is the length of time a person holds a position of authority.","e":"There was a vote against the senator because people wanted a change after his long incumbency."},{"m":"Incumbency is a duty or obligation that a society can expect of people."}]}]},"incumbencies":{"h":"incumbencies","l":"incumbency","q":"noun"},"non-fiction":{"h":"non-fiction","s":[{"p":"noun","d":[{"m":"Non-fiction is a book or magazine that is factual and true, not stories.","e":"I borrowed non-fiction books from the library to help me write my science essay."}]}]},"throng":{"h":"throng","i":"/θrɒŋ/","a":"en-us-throng.ogg","s":[{"p":"noun","d":[{"m":"(countable) A throng is a lot of people, crowded or closely together."},{"m":"(countable) A throng is a group of lots of things."}]},{"p":"verb","d":[{"m":"If a crowd throngs a place, it means that a lot of people are going to or are at the place."}]}]},"throngs":{"h":"throngs","l":"throng","q":"noun"},"literally":{"h":"literally","a":"en-us-literally.ogg","s":[{"p":"adverb","d":[{"m":"If something happens literally, it happens exactly as it was said.","e":"When I found out that the company would hire me, I literally jumped for joy. In fact, I hit my head on the ceiling."}]}]},"cower":{"h":"cower","i":"/ˈkaʊə/","a":"LL-Q1860 (eng)-Vealhurl-cower.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If you cower, you show fear by moving your body down and away from what scares you.","e":"The cats cower when the dog walks by."}]}]},"cowers":{"h":"cowers","l":"cower","q":"verb"},"cowered":{"h":"cowered","l":"cower","q":"verb"},"cowering":{"h":"cowering","l":"cower","q":"verb"},"kenya":{"h":"Kenya","i":"/ˈkɛnjə/","a":"Kenya pronunciation.ogg","s":[{"p":"proper noun","d":[{"m":"Kenya is a country in Eastern Africa. Its official name is the Republic of Kenya."}]}]},"outstanding":{"h":"outstanding","a":"En-us-outstanding.ogg","s":[{"p":"adjective","d":[{"m":"If something is outstanding, it stands out from the others, usually in a good way.","e":"Out of all the zoos I have been to, this one is outstanding!"},{"m":"Something very good can be called outstanding.","e":"The speaker gave an outstanding presentation, and everyone stood to applaud him."},{"m":"If a problem is outstanding, it has not been fixed yet.","e":"The outstanding issue between Jane and Kim made the party awkward."},{"m":"If a debt had not been paid, it is outstanding.","e":"He still owes me money from an outstanding debt from three years ago."}]}]},"carefully":{"h":"carefully","i":"/ˈkɛːfəli/","a":"en-us-carefully.ogg","s":[{"p":"adjective","d":[{"m":"When something is done carefully, it is done with caution.","e":"Timmy, take that vase out in our room carefully."}]}]},"gaze":{"h":"gaze","i":"/ɡeɪz/","a":"en-us-gaze.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) When someone gazes at someone, they stare at that person for a long time.","e":"Why does Anthony keep gazing at me?"},{"m":"(transitive) When someone is staring at something absent – minded.","e":"Sorry, I couldn't hear you. I was gazing at my water bottle."}]}]},"uneasy":{"h":"uneasy","i":"/ʌnˈiːzi/","a":"LL-Q1860 (eng)-Vealhurl-uneasy.wav","s":[{"p":"adjective","d":[{"m":"When something is uneasy, it causes discomfort and makes you feel anxious about it.","e":"As a girl, I feel very uneasy when I walk back home late at night."},{"m":"Something that is rather difficult to do.","e":"Daniel is so stubborn, working with him will be uneasy."}]}]},"unkind":{"h":"unkind","a":"en-us-unkind.oga","s":[{"p":"adjective","d":[{"m":"When someone is unkind, that person is being rude, vulgar and even cruel.","e":"Why did Carl throw pizza at my face? The guy is so unkind."}]}]},"pork":{"h":"pork","i":"/pɔːk/","a":"en-us-pork.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Pork is meat or flesh from a pig.","e":"I had a pork sandwich for lunch today."}]}]},"porks":{"h":"porks","l":"pork","q":"noun"},"disobey":{"h":"disobey","a":"en-us-disobey.ogg","s":[{"p":"verb","d":[{"m":"When someone disobeys someone, it means they do not listen to someone.","e":"Every human should not disobey their parents."}]}]},"ghettos":{"h":"ghettos","l":"ghetto","q":"noun"},"hungary":{"h":"Hungary","i":"/ˈhʌŋ.ɡər.i/","a":"en-us-Hungary.ogg","s":[{"p":"proper noun","d":[{"m":"Hungary is a landlocked country in Central Europe."}]}]},"disobeys":{"h":"disobeys","l":"disobey","q":"verb"},"disobeyed":{"h":"disobeyed","l":"disobey","q":"verb"},"disobeying":{"h":"disobeying","l":"disobey","q":"verb"},"scatter":{"h":"scatter","i":"/ˈskætə/","a":"en-us-scatter.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To scatter means to go in different directions; separate.","e":"I must scatter around the park to find my doll!"}]}]},"scatters":{"h":"scatters","l":"scatter","q":"verb"},"scattering":{"h":"scattering","i":"/ˈskætərɪŋ/","l":"scatter","q":"verb"},"mouseover":{"h":"mouseover","a":"En-uk-mouseover.ogg","s":[{"p":"noun","d":[{"m":"A mouseover is when the cursor of a mouse is hovered (or moved) over a certain point on the screen.","e":"The computer will make a noise on the mouseover."}]}]},"mouseovers":{"h":"mouseovers","l":"mouseover","q":"noun"},"cereal":{"h":"cereal","a":"en-us-cereal.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cereal is a grass whose seeds we use as food, like wheat and oats."}]}]},"cereals":{"h":"cereals","l":"cereal","q":"noun"},"gazes":{"h":"gazes","i":"/ɡeɪ.zɨz/","l":"gaze","q":"verb"},"gazed":{"h":"gazed","i":"/ɡeɪzd/","a":"en-us-gazed.ogg","l":"gaze","q":"verb"},"gazing":{"h":"gazing","i":"/ˈɡeɪzɪŋ/","a":"en-us-gazing.ogg","l":"gaze","q":"verb"},"uneasier":{"h":"uneasier","l":"uneasy","q":"adjective"},"uneasiest":{"h":"uneasiest","l":"uneasy","q":"adjective"},"elaborate":{"h":"elaborate","a":"en-us-elaborate.ogg","s":[{"p":"adjective","d":[{"m":"When something is supposed to be elaborated, it is needed to be expanded or add details to.","e":"Just saying the cat is tall does not show enough details about the cat, please elaborate about it."}]}]},"destination":{"h":"destination","i":"/dɛstɪˈneɪʃən/","a":"en-us-destination.ogg","s":[{"p":"noun","d":[{"m":"(countable) A destination is the place where a person or thing will go.","e":"The package's destination was across the country."}]}]},"destinations":{"h":"destinations","l":"destination","q":"noun"},"doom":{"h":"doom","a":"en-us-doom.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Doom is death, destruction, or tragedy."},{"m":"(countable) Someone's doom is their tragic or horrible ending, such as their death.","e":"The hiker fell to his doom after he lost his grip."}]}]},"dooms":{"h":"dooms","l":"doom","q":"noun"},"arise":{"h":"arise","i":"/əˈraɪz/","a":"en-us-arise.ogg","s":[{"p":"verb","d":[{"m":"When something arises, it comes up from sitting, lying, or kneeling.","e":"He arose from his chair after a 7 hour slumber."}]}]},"arises":{"h":"arises","i":"/əˈraɪzɪz/","a":"en-us-arises.ogg","l":"arise","q":"verb"},"eucalyptus":{"h":"eucalyptus","i":"/ˌjuːkəˈlɪptəs/","a":"LL-Q1860 (eng)-Vininn126-eucalyptus.wav","s":[{"p":"noun","d":[{"m":"Eucalyptuses are trees growing mainly in Australia (where they are a very typical form of tree), though they are planted in many warm areas throughout the world."},{"m":"A greenish colour, like that of a eucalyptus leaf."}]}]},"romances":{"h":"romances","a":"En-us-romances.ogg","l":"romance","q":"noun"},"arose":{"h":"arose","i":"/əˈroʊz/","a":"en-us-arose.ogg","l":"arise","q":"verb"},"arisen":{"h":"arisen","i":"/əˈrɪzən/","a":"en-us-arisen.ogg","l":"arise","q":"verb"},"arising":{"h":"arising","i":"/əˈraɪzɪŋ/","a":"en-us-arising.ogg","l":"arise","q":"verb"},"pigheaded":{"h":"pigheaded","s":[{"p":"adjective","d":[{"m":"When someone is pigheaded, they are stubborn and do not listen to the instructions of other people.","e":"Timothy, don't be pigheaded and hop in the car so we can go shopping!"}]}]},"bail":{"h":"bail","i":"[ˈbeɪ̯(ə)ɫ]","a":"en-us-bale.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bail is an amount of money paid for the release of someone who has been arrested with the promise that he/she will appear in court for a trial.","e":"My friend had a fight with a stranger on the streets and I had to pay a bail of $12,000 for him."},{"m":"(countable) A bail is a bucket or a scoop used for removing water out of a boat.","e":"We are in trouble if the boat leaks, because we forgot to bring the bail."}]},{"p":"verb","d":[{"m":"To bail someone is to use money to get an arrested person out of prison.","e":"Sorry, I have to go and bail my father. He got arrested for his reckless driving after drinking a few bottles of beer."}]}]},"bails":{"h":"bails","i":"/beɪlz/","a":"en-us-bales.ogg","l":"bail","q":"noun"},"ripe":{"h":"ripe","i":"/raɪp/","a":"en-us-ripe.ogg","s":[{"p":"adjective","d":[{"m":"When something is ripe, it is fully grown or developed.","e":"The Bananas are ripe, so they are ready to eat."}]}]},"eucalyptuses":{"h":"eucalyptuses","l":"eucalyptus","q":"noun"},"eucalypti":{"h":"eucalypti","l":"eucalyptus","q":"noun"},"bailed":{"h":"bailed","i":"/beɪld/","l":"bail","q":"verb"},"bailing":{"h":"bailing","i":"/ˈbeɪlɪŋ/","l":"bail","q":"verb"},"riper":{"h":"riper","l":"ripe","q":"adjective"},"ripest":{"h":"ripest","l":"ripe","q":"adjective"},"unkinder":{"h":"unkinder","l":"unkind","q":"adjective"},"unkindest":{"h":"unkindest","l":"unkind","q":"adjective"},"eucalypt":{"h":"eucalypt","i":"/ˈjuːkəˌlɪpt/","a":"LL-Q1860 (eng)-Vealhurl-eucalypt.wav","s":[{"p":"noun","d":[{"m":"(countable) An eucalypt is a type of tree in the eucalyptus family of trees."}]}]},"coppice":{"h":"coppice","i":"/ˈkɒpɪs/","s":[{"p":"noun","d":[{"m":"A coppice forms when a tree is cut down and smaller stems grow all around the cut trunk(s)."}]}]},"eucalypts":{"h":"eucalypts","i":"/ˈjuːkəˌlɪpts/","l":"eucalypt","q":"noun"},"coppices":{"h":"coppices","i":"/ˈkɒpɪsɪz/","l":"coppice","q":"noun"},"blatant":{"h":"blatant","i":"/ˈbleɪtənt/","a":"en-us-blatant.ogg","s":[{"p":"adjective","d":[{"m":"When something is blatant, it means that it is very obvious.","e":"Not putting uncooked meat in the freezer is a blatant health code violation!"}]}]},"pariah":{"h":"pariah","a":"en-us-pariah.ogg","s":[{"p":"noun","d":[{"m":"A pariah is someone who is rejected from society."},{"m":"Someone who is an outcast or in exile."}]}]},"toad":{"h":"toad","s":[{"p":"noun","d":[{"m":"A toad is a type of amphibian. Toads look like frogs, and they belong to the same animal group. All toads are frogs, but not all frogs are toads."}]}]},"toads":{"h":"toads","l":"toad","q":"noun"},"pariahs":{"h":"pariahs","l":"pariah","q":"noun"},"developer":{"h":"developer","i":"/dɪˈvɛləpə(r)/","a":"LL-Q1860 (eng)-Vealhurl-developer.wav","s":[{"p":"noun","d":[{"m":"(countable) (real estate) A developer is someone or a company that develops a piece of land and creates buildings on it."},{"m":"(countable) A software developer is someone who programs and writes software."}]}]},"developers":{"h":"developers","l":"developer","q":"noun"},"adulteries":{"h":"adulteries","l":"adultery","q":"noun"},"appeasements":{"h":"appeasements","l":"appeasement","q":"noun"},"disposables":{"h":"disposables","l":"disposable","q":"noun"},"harsher":{"h":"harsher","l":"harsh","q":"adjective"},"harshest":{"h":"harshest","l":"harsh","q":"adjective"},"infringements":{"h":"infringements","l":"infringement","q":"noun"},"infringe":{"h":"infringe","s":[{"p":"verb","d":[{"m":"(transitive) To infringe a rule or a law means to break that rule or law."}]}]},"infringes":{"h":"infringes","l":"infringe","q":"verb"},"infringed":{"h":"infringed","l":"infringe","q":"verb"},"infringing":{"h":"infringing","l":"infringe","q":"verb"},"remunerations":{"h":"remunerations","l":"remuneration","q":"noun"},"unpacks":{"h":"unpacks","l":"unpack","q":"verb"},"unpacked":{"h":"unpacked","l":"unpack","q":"verb"},"unpacking":{"h":"unpacking","l":"unpack","q":"verb"},"assimilates":{"h":"assimilates","l":"assimilate","q":"verb"},"assimilated":{"h":"assimilated","l":"assimilate","q":"verb"},"assimilating":{"h":"assimilating","l":"assimilate","q":"verb"},"manchineel":{"h":"manchineel","i":"/ˌmæntʃɪˈniːl/","s":[{"p":"noun","d":[{"m":"A manchineel tree is a small American tropical tree that is extremely poisonous."}]}]},"manchineels":{"h":"manchineels","l":"manchineel","q":"noun"},"winner":{"h":"winner","i":"/ˈwɪnə/","a":"LL-Q1860 (eng)-Vealhurl-winner.wav","s":[{"p":"noun","d":[{"m":"(countable) A winner is someone that has won a competition, or often wins.","e":"Terry is considered the winner since he came in first in the 100 meters race event."}]}]},"winners":{"h":"winners","l":"winner","q":"noun"},"flyer":{"h":"flyer","i":"/ˈflaɪə(r)/","a":"LL-Q1860 (eng)-Vealhurl-flyer.wav","s":[{"p":"noun","d":[{"m":"(countable) A flyer is a leaflet or a piece of paper that is given to people on the streets as a form of.","e":"As I waited for my exam results, I took up a temporary job of flyers."},{"m":"(countable) A flyer is someone that pilots or an airplane."},{"m":"(countable) A machine that flies."}]}]},"flyers":{"h":"flyers","l":"flyer","q":"noun"},"loser":{"h":"loser","i":"/luzɚ/","a":"LL-Q1860 (eng)-Vealhurl-loser.wav","s":[{"p":"noun","d":[{"m":"(countable) A loser is someone that did not win a competition. In sports, a loser would be one that did not come in first place."},{"m":"Someone that is very often failing or being unsuccessful in life.","e":"He is such a loser!"}]}]},"losers":{"h":"losers","l":"loser","q":"noun"},"culpability":{"h":"culpability","i":"/ˌkʌlpəˈbɪləti/","a":"LL-Q1860 (eng)-Vealhurl-culpability.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Culpability is the state of being responsible for something negative, such as a crime.","e":"Oliver Twist was found guilty of theft, but the real culpability was Fagin's."}]}]},"hitch":{"h":"hitch","i":"/hɪtʃ/","a":"en-us-hitch.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hitch is a device that connects a trailer or wagon to the thing pulling it."}]},{"p":"verb","d":[{"m":"(transitive) If you hitch something, you pull it with a jerk.","e":"John hitched up his shorts and ran."},{"m":"(transitive) If you hitch something to something else, you attach or fasten them together.","e":"He hitched a wagon to his truck."},{"m":"(informal) If you get hitched, you get married."}]}]},"craze":{"h":"craze","i":"/kreɪz/","a":"en-us-craze.ogg","s":[{"p":"noun","d":[{"m":"A craze is a temporary passion or infatuation for a new amusement, pursuit, or fashion.","e":"The Twist was a dance craze of the early 1960s."}]}]},"hitches":{"h":"hitches","l":"hitch","q":"noun"},"crazes":{"h":"crazes","l":"craze","q":"noun"},"unhealthier":{"h":"unhealthier","l":"unhealthy","q":"adjective"},"unhealthiest":{"h":"unhealthiest","l":"unhealthy","q":"adjective"},"singaporeans":{"h":"Singaporeans","l":"singaporean","q":"noun"},"precept":{"h":"precept","i":"/ˈpriːsɛpt/","a":"LL-Q1860 (eng)-Vealhurl-precept.wav","s":[{"p":"noun","d":[{"m":"A precept is a rule of conduct or action; instruction or direction for a given course or action."},{"m":"A written command to demand for a payment."}]}]},"huddersfield":{"h":"Huddersfield","i":"/ˈhʌdə(r)zfiːld/","a":"en-uk-Huddersfield.ogg","s":[{"p":"proper noun","d":[{"m":"Huddersfield is a city in Northern England."}]}]},"precepts":{"h":"precepts","l":"precept","q":"noun"},"streamlines":{"h":"streamlines","l":"streamline","q":"verb"},"streamlined":{"h":"streamlined","l":"streamline","q":"verb"},"streamlining":{"h":"streamlining","l":"streamline","q":"verb"},"swollen":{"h":"swollen","i":"/ˈswəʊlən/","a":"LL-Q1860 (eng)-Back ache-swollen.wav","l":"swell","q":"verb"},"slashes":{"h":"slashes","l":"slash","q":"noun"},"slashed":{"h":"slashed","l":"slash","q":"verb"},"slashing":{"h":"slashing","l":"slash","q":"verb"},"b-movies":{"h":"B-movies","l":"b-movie","q":"noun"},"famed":{"h":"famed","l":"fame","q":"verb","s":[{"p":"adjective","d":[{"m":"When something or someone is famed, that object or person has fame and is famous.","e":"This shop is famed for its delicious bread."}]}]},"faming":{"h":"faming","l":"fame","q":"verb"},"tariff":{"h":"tariff","i":"/ˈtærɪf/","a":"LL-Q1860 (eng)-Vealhurl-tariff.wav","s":[{"p":"noun","d":[{"m":"(countable) A tariff is a tax charged on the imports or exports of a country."},{"m":"Many countries added tariffs to foreign goods during the Great Depression for protectionism of their own goods."}]}]},"abdicate":{"h":"abdicate","i":"/ˈæb.dɪˌkeɪt/","a":"en-us-abdicate.ogg","s":[{"p":"verb","d":[{"m":"When a ruler abdicates, he formally gives up his power and reign over a country.","e":"After the war, the king was forced to abdicate."}]}]},"tariffs":{"h":"tariffs","l":"tariff","q":"noun"},"abdicates":{"h":"abdicates","l":"abdicate","q":"verb"},"abdicated":{"h":"abdicated","l":"abdicate","q":"verb"},"abdicating":{"h":"abdicating","l":"abdicate","q":"verb"},"obsess":{"h":"obsess","i":"/əbˈsɛs/","a":"LL-Q1860 (eng)-Vealhurl-obsess.wav","s":[{"p":"verb","d":[{"m":"(transitive) To obsess on/about/over someone or something means having an intense and compulsive interest in or worry about someone or something; to fixate on someone or something."}]}]},"bruise":{"h":"bruise","i":"/bruːz/","a":"en-us-bruise.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bruise is a purplish mark on the skin due to the blood leaking from blood vessels under the surface of the skin, usually due to impact against the area.","e":"I accidentally knocked my head against the wall, and got a bruise on the forehead."}]},{"p":"verb","d":[{"m":"(transitive) When you bruise someone, you hit him with something that causes him to get a [[#Noun|bruise]]."}]}]},"bruises":{"h":"bruises","l":"bruise","q":"noun"},"bruised":{"h":"bruised","i":"/bruːzd/","a":"LL-Q1860 (eng)-Vealhurl-bruised.wav","l":"bruise","q":"verb"},"bruising":{"h":"bruising","i":"/ˈbruːzɪŋ/","a":"en-au-bruising.ogg","l":"bruise","q":"verb","s":[{"p":"noun","d":[{"m":"(countable) A bruising is a violent physical attack on a person."},{"m":"(countable) Bruisings are the [[#Noun|bruises]] on a someone's skin."}]}]},"dismiss":{"h":"dismiss","i":"/dɪsˈmɪs/","a":"en-us-dismiss.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you dismiss someone from a company, you fire and end the employment of the person, causing the person to become unemployed.","e":"He was found to be giving the secrets of the company to other companies and was immediately dismissed."},{"m":"(transitive) When you dismiss someone, you order the person to leave.","e":"The parade commander stepped forward to ask the President for permission to dismiss the parade."},{"m":"(transitive) To dismiss something is to refuse or reject it.","e":"The court dismissed his appeal for a second trial."},{"m":"(transitive) When someone is dismissed, that person is given a red card and is sent off the pitch.","e":"He punched a player from the opponent team, and was immediately dismissed by the referee."}]}]},"dismisses":{"h":"dismisses","l":"dismiss","q":"verb"},"dismissed":{"h":"dismissed","l":"dismiss","q":"verb"},"dismissing":{"h":"dismissing","l":"dismiss","q":"verb"},"disrupt":{"h":"disrupt","i":"/dɪsˈrʌpt/","a":"en-us-disrupt.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you disrupt something, you interrupt it, causing it to be paused or even stopped.","e":"The strike disrupted the normal livelihood of the people working here."}]}]},"disrupts":{"h":"disrupts","l":"disrupt","q":"verb"},"disrupted":{"h":"disrupted","l":"disrupt","q":"verb"},"disrupting":{"h":"disrupting","l":"disrupt","q":"verb"},"obsesses":{"h":"obsesses","l":"obsess","q":"verb"},"obsessed":{"h":"obsessed","i":"/əbˈsɛst/","a":"LL-Q1860 (eng)-AnotherFriendlyHuman-obsessed.wav","l":"obsess","q":"verb","s":[{"p":"adjective","d":[{"m":"To be obsessed with someone or something means to be highly and compulsive interested in or worried about someone or something; to be fixated on someone or something.","e":"Charlie, this video game is so enjoyable that I have became obsessed with it!"}]}]},"obsessing":{"h":"obsessing","l":"obsess","q":"verb"},"donor":{"h":"donor","i":"/ˈdoʊnɚ/","a":"en-us-donor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A donor is a person who gives money, food, toys, blood, body parts, etc. to help other people in need. Giving something is called a donation.","e":"I was given a badge by the Red Cross to recognize me as a blood donor."}]}]},"donors":{"h":"donors","l":"donor","q":"noun"},"arborist":{"h":"arborist","s":[{"p":"noun","d":[{"m":"(countable) An arborist is a person that studies trees.","e":"The city hired an arborist to look at the forest."}]}]},"foreshock":{"h":"foreshock","s":[{"p":"noun","d":[{"m":"A foreshock is an small earthquake or tremor that happens before a bigger earthquake and is related to it."}]}]},"foreshocks":{"h":"foreshocks","l":"foreshock","q":"noun"},"arborists":{"h":"arborists","l":"arborist","q":"noun"},"gyre":{"h":"gyre","i":"/dʒaɪ.ə/","a":"LL-Q1860 (eng)-Vealhurl-gyre.wav","s":[{"p":"noun","d":[{"m":"A gyre is a spiral or whirl."}]},{"p":"verb","d":[{"m":"If A gyres around B, A moves in a circular motion around B."}]}]},"serialize":{"h":"serialize","i":"/ˈsɪriəlaɪz/","s":[{"p":"verb","d":[{"m":"If you serialize a story or film, you publish it in parts."}]}]},"assert":{"h":"assert","i":"/əˈsɜːt/","a":"en-us-assert.ogg","s":[{"p":"verb","d":[{"m":"When you asserts something, you say it with confidence.","e":"He asserted that he was innocent."}]}]},"asserts":{"h":"asserts","l":"assert","q":"verb"},"asserted":{"h":"asserted","i":"/əˈsɜːtɪd/","a":"en-us-asserted.ogg","l":"assert","q":"verb"},"asserting":{"h":"asserting","l":"assert","q":"verb"},"serializes":{"h":"serializes","l":"serialize","q":"verb"},"serialized":{"h":"serialized","l":"serialize","q":"verb"},"serializing":{"h":"serializing","l":"serialize","q":"verb"},"tardigrade":{"h":"tardigrade","a":"LL-Q1860 (eng)-Vealhurl-tardigrade.wav","s":[{"p":"noun","d":[{"m":"(countable) A tardigrade is a very small animal (some so small that you can't see them without a tool) that has eight legs and lives in the water or in wet places.","e":"Our class tried to see a tardigrade with a magnifying glass, but we couldn't find any."}]}]},"kindhearted":{"h":"kindhearted","s":[{"p":"adjective","d":[{"m":"When someone is kind-hearted, that person is sympathetic and loving."},{"m":"Someone that is kind, considerate and generous."}]}]},"considerate":{"h":"considerate","i":"/kənˈsɪdərət/","a":"LL-Q1860 (eng)-Vealhurl-considerate.wav","s":[{"p":"adjective","d":[{"m":"If someone is considerate, then he or she is kind, caring and thoughtful."}]}]},"unkindly":{"h":"unkindly","s":[{"p":"adverb","d":[{"m":"When someone does something unkindly, the person does it in a mean, inconsiderate, heartless and cold-hearted manner."}]}]},"cold-heartedly":{"h":"cold-heartedly","s":[{"p":"adverb","d":[{"m":"When someone behaves cold-heartedly, it is in a cold-hearted, cruel or hostile manner."}]}]},"twig":{"h":"twig","i":"/twɪɡ/","a":"en-us-twig.ogg","s":[{"p":"noun","d":[{"m":"A twig is a small, thin branch of a tree.","e":"The Native Americans used twigs to build their houses."}]}]},"twigs":{"h":"twigs","a":"En-us-twigs.ogg","l":"twig","q":"noun"},"unjust":{"h":"unjust","a":"En-us-unjust.ogg","s":[{"p":"adjective","d":[{"m":"If something is unjust, it is not just or not fair.","e":"The king's law is unjust."}]}]},"aaron":{"h":"Aaron","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-Aaron.wav","s":[{"p":"proper noun","d":[{"m":"(Bible) Aaron was the brother of Moses and the first high priest of Israel."},{"m":"Aaron is a male given name."}]}]},"aback":{"h":"aback","i":"/əˈbæk/","a":"en-us-aback.ogg","s":[{"p":"adverb","d":[{"m":"Aback can mean toward the back or backward."},{"m":"When someone is taken aback, he is surprised.","e":"He was taken aback by her angry words."}]}]},"abbot":{"h":"abbot","i":"/ˈæb.ət/","a":"en-us-abbot.ogg","s":[{"p":"noun","d":[{"m":"(countable) An abbot is a man who is the leader of an abbey of monks or monastery."}]}]}