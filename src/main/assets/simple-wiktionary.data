itive) If you spotlight something, you illuminate it with a spotlight."},{"m":"(transitive) To draw attention to.","e":"On the news, they spotlighted the issue of drug use."},{"m":"(transitive) (hunting) Spotlighting is a technique for hunting at night. One person holds a flashlight and illuminates an animal, then another person shoots it."}]}]},"spotlights":{"h":"spotlights","l":"spotlight","q":"noun"},"spotlighted":{"h":"spotlighted","l":"spotlight","q":"verb"},"spotlighting":{"h":"spotlighting","l":"spotlight","q":"verb"},"unfamous":{"h":"unfamous","s":[{"p":"adjective","d":[{"m":"Not famous; not well-known about; obscure."}]}]},"little-known":{"h":"little-known","s":[{"p":"adjective","d":[{"m":"Something that is little-known is known to few people. Most people don't know about it."}]}]},"urbanize":{"h":"urbanize","s":[{"p":"verb","d":[{"m":"(transitive) If you urbanize something, you make it more urban."}]}]},"urbanizes":{"h":"urbanizes","l":"urbanize","q":"verb"},"urbanized":{"h":"urbanized","l":"urbanize","q":"verb"},"urbanizing":{"h":"urbanizing","l":"urbanize","q":"verb"},"verifiable":{"h":"verifiable","i":"/vɛr.ɪˈfaɪ.ə.bəl/","a":"en-us-verifiable.ogg","s":[{"p":"adjective","d":[{"m":"If something is verifiable, it's possible to tell if it's true or false."}]}]},"unverifiable":{"h":"unverifiable","s":[{"p":"adjective","d":[{"m":"If something is unverifiable, it's not possible to tell if it's true or false. It could be true, it could be false, but there's no way to know for sure which it is."}]}]},"unwrinkled":{"h":"unwrinkled","l":"unwrinkle","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is unwrinkled, it doesn't have any wrinkles in it.","e":"Your face looks so unwrinkled!"}]}]},"unwrinkles":{"h":"unwrinkles","l":"unwrinkle","q":"verb"},"unwrinkling":{"h":"unwrinkling","l":"unwrinkle","q":"verb"},"unwrinkle":{"h":"unwrinkle","s":[{"p":"verb","d":[{"m":"If you unwrinkle something, you remove any wrinkles from it."}]}]},"webbed":{"h":"webbed","i":"