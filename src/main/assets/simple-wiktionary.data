},"leggings":{"h":"leggings","l":"legging","q":"noun"},"sandals":{"h":"sandals","l":"sandal","q":"noun"},"outcasts":{"h":"outcasts","l":"outcast","q":"noun"},"outcasted":{"h":"outcasted","l":"outcast","q":"verb"},"outcasting":{"h":"outcasting","l":"outcast","q":"verb"},"conscientious":{"h":"conscientious","a":"en-us-conscientious.ogg","s":[{"p":"adjective","d":[{"m":"When someone is conscientious, the person is considered to be very careful in the work that he/she does. The person wants to do the work well."}]}]},"classify":{"h":"classify","i":"/ˈklæsɪfaɪ/","a":"LL-Q1860 (eng)-Vealhurl-classify.wav","s":[{"p":"verb","d":[{"m":"When you classify something, you sort it into different classes or.","e":"This murder case was classified as an accidental murder."},{"m":"When someone classifies something, they declare it to be a secret, especially for a government secret.","e":"The government decided to classify the information about the locations of nuclear weapon production."}]}]},"classifies":{"h":"classifies","l":"classify","q":"verb"},"classifying":{"h":"classifying","l":"classify","q":"verb"},"classified":{"h":"classified","i":"/ˈklasɪfʌɪd/","l":"classify","q":"verb","s":[{"p":"adjective","d":[{"m":"When something is classified, it is a secret of the government. It is considered to be illegal for people to know without permission.","e":"Whether or not the government is spying on us is something that I cannot say, it is classified."}]},{"p":"noun","d":[{"m":"A classified is a type of advertisement in newspapers and magazines that is sorted into different classes or.","e":"He ran a classified to recruit a new chef for his restaurant."}]}]},"classifieds":{"h":"classifieds","l":"classified","q":"noun"},"perishes":{"h":"perishes","l":"perish","q":"verb"},"perished":{"h":"perished","l":"perish","q":"verb"},"perishing":{"h":"perishing","l":"perish","q":"verb"},"reformations":{"h":"reformations","l":"reformation","q":"noun"},"communists":{"h":"communists","l":"communist","q":