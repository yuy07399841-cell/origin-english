wded":{"h":"crowded","i":"/ˈkraʊdɪd/","a":"en-us-crowded.ogg","l":"crowd","q":"verb","s":[{"p":"adjective","d":[{"m":"If a place is crowded, there are too many people there.","e":"The room was getting too crowded, so I went outside."}]}]},"crowding":{"h":"crowding","l":"crowd","q":"verb"},"cabinets":{"h":"cabinets","l":"cabinet","q":"noun"},"calculators":{"h":"calculators","l":"calculator","q":"noun"},"competitions":{"h":"competitions","l":"competition","q":"noun"},"clerks":{"h":"clerks","i":"/klærks/","l":"clerk","q":"noun"},"chests":{"h":"chests","l":"chest","q":"noun"},"cheeses":{"h":"cheeses","l":"cheese","q":"noun"},"dummies":{"h":"dummies","l":"dummy","q":"noun"},"donations":{"h":"donations","a":"en-us-donations.ogg","l":"donation","q":"noun"},"disposals":{"h":"disposals","l":"disposal","q":"noun"},"drag":{"h":"drag","i":"/dræɡ/","a":"en-us-drag.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you drag something, you pull it, usually with difficulty.","e":"She heard the noise of a chair being dragged to the window."},{"m":"(transitive) If you drag your feet, you move or do something slowly.","e":"Six months later, when nothing had happened, they complained that the city was still dragging its feet."},{"m":"(transitive) If you drag somebody somewhere, you take them there but they don't want to go.","e":"Dad sent me to drag you back home."},{"m":"(transitive) If you drag yourself somewhere, you go there with difficulty, often because you're tired or sick.","e":"I dragged myself out of bed and made a cup of coffee."},{"m":"(transitive) If you drag something on a computer screen, you move it from one place to another using a pointer."},{"m":"(transitive) If something drags you down, it makes you feel unhappy."}]},{"p":"noun","d":[{"m":"(uncountable) If something is a drag, it's not fun and you don't want to do it.","e":"Christmas was a real drag this year, since I was living alone."},{"m":"(uncountable) If someone is a drag, they don't enjoy fun activities or they stop you from having fun.","e":"He's such a drag to be with, studying all the time."},{"m":"(countable) If you take a drag from a cigarette, you close your mouth and inhale through it.","e":"I took the final drag from my final cigarette, and put it out, for good."},{"m":"(uncountable) Drag is the resistance of a fluid to something moving that is moving through it."}]}]},"declarations":{"h":"declarations","l":"declaration","q":"noun"},"defences":{"h":"defences","l":"defence","q":"noun"},"defenses":{"h":"defenses","l":"defense","q":"noun"},"populations":{"h":"populations","l":"population","q":"noun"},"tonnes":{"h":"tonnes","l":"tonne","q":"noun"},"relatives":{"h":"relatives","a":"en-us-relatives.ogg","l":"relative","q":"noun"},"backgrounds":{"h":"backgrounds","l":"background","q":"noun"},"eighties":{"h":"eighties","l":"eighty","q":"noun","s":[{"p":"noun","d":[{"m":"The years of the decade 1980s."}]}]},"contributors":{"h":"contributors","l":"contributor","q":"noun"},"simulations":{"h":"simulations","l":"simulation","q":"noun"},"suggestions":{"h":"suggestions","l":"suggestion","q":"noun"},"contributions":{"h":"contributions","a":"en-us-contributions.ogg","l":"contribution","q":"noun"},"definitions":{"h":"definitions","l":"definition","q":"noun"},"depressions":{"h":"depressions","l":"depression","q":"noun"},"deputies":{"h":"deputies","a":"en-us-deputies.ogg","l":"deputy","q":"noun"},"desks":{"h":"desks","l":"desk","q":"noun"},"destroyers":{"h":"destroyers","l":"destroyer","q":"noun"},"disasters":{"h":"disasters","l":"disaster","q":"noun"},"discoveries":{"h":"discoveries","i":"/dɪsˈkʌvəriz/","a":"en-us-discoveries.ogg","l":"discovery","q":"noun"},"contradictions":{"h":"contradictions","l":"contradiction","q":"noun"},"passengers":{"h":"passengers","l":"passenger","q":"noun"},"envelopes":{"h":"envelopes","l":"envelope","q":"noun"},"fourteens":{"h":"fourteens","l":"fourteen","q":"noun"},"oceans":{"h":"oceans","l":"ocean","q":"noun"},"baloci":{"h":"Baloci","s":[{"p":"proper noun","d":[{"m":"Baloci is another way of spelling Balochi."}]}]},"baluci":{"h":"Baluci","s":[{"p":"proper noun","d":[{"m":"Baluci is another way of spelling Balochi."}]}]},"bosnia":{"h":"Bosnia","i":"/ˈbɒz.ni.ə/","a":"en-us-Bosnia.ogg","s":[{"p":"proper noun","d":[{"m":"The northern 75% of the country of Bosnia and Herzegovina."},{"m":"A short form of Bosnia and Herzegovina, sometimes used when talking about the whole country."}]}]},"bosnia-hercegovina":{"h":"Bosnia-Hercegovina","s":[{"p":"proper noun","d":[{"m":"Bosnia-Hercegovina is another way of spelling Bosnia and Herzegovina."}]}]},"kashmiri":{"h":"Kashmiri","s":[{"p":"proper noun","d":[{"m":"A person from Kashmir or of Kashmiri descent."},{"m":"The language spoken in Kashmir."}]}]},"srinagar":{"h":"Srinagar","s":[{"p":"proper noun","d":[{"m":"The traditional capital of Jammu and Kashmir."}]}]},"disturbances":{"h":"disturbances","l":"disturbance","q":"noun"},"indus":{"h":"Indus","s":[{"p":"proper noun","d":[{"m":"The Indus is a large river in south-central Asia, starting in Tibet and then through Kashmir and Pakistan into the Arabian Sea."}]}]},"ladakh":{"h":"Ladakh","s":[{"p":"proper noun","d":[{"m":"Ladakh is a region in the disputed territory of Jammu and Kashmir and Gilgit Baltistan (Pakistan)."}]}]},"incomes":{"h":"incomes","l":"income","q":"noun"},"markhor":{"h":"markhor","i":"/ˈmɑːkɔː/","s":[{"p":"noun","d":[{"m":"(countable) A large wild goat-antelope, found in the western Himalayas."}]}]},"markhors":{"h":"markhors","l":"markhor","q":"noun"},"circumstances":{"h":"circumstances","i":"/ˈsɝkəmstænsɪz/","a":"en-us-circumstances.ogg","l":"circumstance","q":"noun"},"attitudes":{"h":"attitudes","l":"attitude","q":"noun"},"drama":{"h":"drama","i":"/ˈdrɑːmə/","a":"en-us-drama.ogg","s":[{"p":"noun","d":[{"m":"(countable) A drama is a serious story for TV, stage, radio, etc.","e":"The courtroom drama stars Melissa Gilbert as a young lawyer."},{"m":"(uncountable) Drama is the art of theatre and the study of that art.","e":"Canadians watch PBS for the best in British TV, both drama and comedy."},{"m":"Drama is excitement, and exciting events, both good and bad.","e":"Americans gathered around televisions to watch the drama unfolding on Capitol Hill."}]}]},"audiences":{"h":"audiences","l":"audience","q":"noun"},"brochures":{"h":"brochures","l":"brochure","q":"noun"},"corporates":{"h":"corporates","l":"corporate","q":"noun"},"corporations":{"h":"corporations","l":"corporation","q":"noun"},"editions":{"h":"editions","a":"en-us-editions.ogg","l":"edition","q":"noun"},"elements":{"h":"elements","a":"en-us-elements.ogg","l":"element","q":"noun","s":[{"p":"noun","d":[{"m":"The elements can be the weather outside, such as wind and rain."}]}]},"careers":{"h":"careers","l":"career","q":"noun"},"volcano":{"h":"volcano","i":"/vɒlˈkeɪnəʊ/","a":"en-us-volcano.ogg","s":[{"p":"noun","d":[{"m":"(countable) A volcano is a mountain that has a magma chamber inside of it that erupts from time to time with lava and other gases."}]}]},"volcanos":{"h":"volcanos","l":"volcano","q":"noun"},"volcanoes":{"h":"volcanoes","l":"volcano","q":"noun"},"sika":{"h":"sika","i":"/ˈsiːkə/","a":"LL-Q1860 (eng)-Vealhurl-sika.wav","s":[{"p":"noun","d":[{"m":"(countable) A sika is a kind of deer that can be found in the forests of Eastern Asia."}]}]},"sikas":{"h":"sikas","l":"sika","q":"noun"},"bedrooms":{"h":"bedrooms","l":"bedroom","q":"noun"},"distances":{"h":"distances","a":"En-us-distances.ogg","l":"distance","q":"noun"},"distanced":{"h":"distanced","l":"distance","q":"verb"},"distancing":{"h":"distancing","i":"/ˈdɪstənsɪŋ/","a":"en-us-distancing.ogg","l":"distance","q":"verb"},"statuses":{"h":"statuses","l":"status","q":"noun"},"wars":{"h":"wars","a":"en-us-wars.ogg","l":"war","q":"noun"},"warred":{"h":"warred","l":"war","q":"verb"},"warring":{"h":"warring","l":"war","q":"verb"},"eights":{"h":"eights","l":"eight","q":"noun"},"fairs":{"h":"fairs","l":"fair","q":"noun"},"honours":{"h":"honours","i":"/ˈɑn.ɚz/","a":"en-us-honours.ogg","l":"honour","q":"noun"},"honoured":{"h":"honoured","i":"/ˈɑnɚd/","a":"en-us-honoured.ogg","l":"honour","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone or something becomes honoured, it becomes respected."}]}]},"honouring":{"h":"honouring","l":"honour","q":"verb"},"honoring":{"h":"honoring","l":"honor","q":"verb"},"honors":{"h":"honors","i":"/ˈɑn.ɚz/","a":"en-us-honors.ogg","l":"honor","q":"noun"},"honored":{"h":"honored","i":"/ˈɑnɚd/","a":"en-us-honoured.ogg","l":"honor","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone or something becomes honored, it becomes respected."}]}]},"grants":{"h":"grants","l":"grant","q":"noun"},"granting":{"h":"granting","l":"grant","q":"verb"},"revenues":{"h":"revenues","l":"revenue","q":"noun"},"submerges":{"h":"submerges","l":"submerge","q":"verb"},"submerging":{"h":"submerging","l":"submerge","q":"verb"},"substances":{"h":"substances","a":"en-us-substances.ogg","l":"substance","q":"noun"},"societies":{"h":"societies","a":"en-us-societies.ogg","l":"society","q":"noun"},"mayhems":{"h":"mayhems","l":"mayhem","q":"noun"},"publications":{"h":"publications","l":"publication","q":"noun"},"evolutions":{"h":"evolutions","l":"evolution","q":"noun"},"eyelashes":{"h":"eyelashes","l":"eyelash","q":"noun"},"chairmen":{"h":"chairmen","l":"chairman","q":"noun"},"furnitures":{"h":"furnitures","l":"furniture","q":"noun"},"comparatives":{"h":"comparatives","l":"comparative","q":"noun"},"applications":{"h":"applications","l":"application","q":"noun"},"tendencies":{"h":"tendencies","l":"tendency","q":"noun"},"phenomena":{"h":"phenomena","i":"/fɪˈnɒmənə/","a":"en-us-phenomena.ogg","l":"phenomenon","q":"noun"},"partisans":{"h":"partisans","l":"partisan","q":"noun"},"surprises":{"h":"surprises","l":"surprise","q":"noun"},"surprising":{"h":"surprising","i":"/səˈpraɪzɪŋ/","a":"en-us-surprising.ogg","l":"surprise","q":"verb"},"dream":{"h":"dream","i":"/driːm/","a":"en-us-dream.ogg","s":[{"p":"noun","d":[{"m":"(countable) Dreams are the images and things you see when you are sleeping.","e":"In my dream I had forgotten the baby in a drawer."},{"m":"(countable) A dream is something you wish for or hope will happen.","e":"The company is succeeding beyond anyone's wildest dreams."}]},{"p":"verb","d":[{"m":"(intransitive) If you dream about something, you wish for it.","e":"She dreamed of becoming a concert pianist."}]}]},"sequels":{"h":"sequels","l":"sequel","q":"noun"},"sidewalks":{"h":"sidewalks","l":"sidewalk","q":"noun"},"postmen":{"h":"postmen","l":"postman","q":"noun"},"postmarks":{"h":"postmarks","l":"postmark","q":"noun"},"postmarked":{"h":"postmarked","l":"postmark","q":"verb"},"postmarking":{"h":"postmarking","l":"postmark","q":"verb"},"pincushions":{"h":"pincushions","l":"pincushion","q":"noun"},"cups":{"h":"cups","l":"cup","q":"noun"},"harmonies":{"h":"harmonies","l":"harmony","q":"noun"},"vitamins":{"h":"vitamins","l":"vitamin","q":"noun"},"postmasters":{"h":"postmasters","l":"postmaster","q":"noun"},"sentences":{"h":"sentences","l":"sentence","q":"noun"},"selections":{"h":"selections","l":"selection","q":"noun"},"techniques":{"h":"techniques","l":"technique","q":"noun"},"theatres":{"h":"theatres","l":"theatre","q":"noun"},"winters":{"h":"winters","l":"winter","q":"noun"},"youths":{"h":"youths","l":"youth","q":"noun"},"gadgets":{"h":"gadgets","l":"gadget","q":"noun"},"manuals":{"h":"manuals","l":"manual","q":"noun"},"beauties":{"h":"beauties","l":"beauty","q":"noun"},"boxers":{"h":"boxers","l":"boxer","q":"noun","s":[{"p":"noun","d":[{"m":"(informal) Boxers are a kind of underwear."}]}]},"doors":{"h":"doors","i":"/dɔːz/","a":"en-us-doors.ogg","l":"door","q":"noun"},"spouses":{"h":"spouses","l":"spouse","q":"noun"},"cunts":{"h":"cunts","l":"cunt","q":"noun"},"considers":{"h":"considers","l":"consider","q":"verb"},"considered":{"h":"considered","i":"/kənˈsɪdɚd/","a":"en-us-considered.ogg","l":"consider","q":"verb"},"registries":{"h":"registries","l":"registry","q":"noun"},"explanations":{"h":"explanations","l":"explanation","q":"noun"},"bud":{"h":"bud","i":"/bʌd/","a":"en-us-bud.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bud is a small part of a plant which opens up and becomes a leaf or a flower.","e":"It's spring! The buds on the trees are opening!"}]},{"p":"verb","d":[{"m":"To grow buds.","e":"The trees are finally starting to bud."},{"m":"To reproduce by splitting off buds.","e":"Yeast reproduces by budding."}]}]},"consultations":{"h":"consultations","l":"consultation","q":"noun"},"relationships":{"h":"relationships","l":"relationship","q":"noun"},"relations":{"h":"relations","i":"/rɪˈleɪʃənz/","a":"en-us-relations.ogg","l":"relation","q":"noun"},"governors":{"h":"governors","l":"governor","q":"noun"},"hosts":{"h":"hosts","a":"en-us-hosts.ogg","l":"host","q":"noun"},"dump":{"h":"dump","i":"/dʌmp/","a":"EN-AU ck1 dump.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you dump something, you get rid of it.","e":"For years the military dumped nuclear waste into local rivers and lakes."},{"m":"If you dump something, you put it down carelessly.","e":"She dumped her stuff onto the table."},{"m":"(transitive) If you dump someone, you stop them.","e":"My girlfriend dumped me last night."},{"m":"(transitive) If you dump something, you sell it below cost, often in another country.","e":"The Americans have accused Canada of dumping its softwood on the US market."},{"m":"(transitive) If you dump data, you save it from a large computer to a storage device."}]},{"p":"noun","d":[{"m":"(countable) A dump is a large area for garbage.","e":"2,000 tons of waste arrive in San Francisco's garbage dump every day."},{"m":"(countable) A dump is the act of emptying something quickly.","e":"They turned off the cement mixer and prepared for the dump."},{"m":"(countable) A dump is a place where weapons are kept.","e":"The army found a weapons dump near the border."},{"m":"(countable) A dump is a building or apartment that is dirty and not nice to be in.","e":"Let's get out of here. This place is a dump."},{"m":"(countable) A dump is the act of saving data from a large computer to a storage device."},{"m":"(countable) If you take a dump, you push waste out of your anus.","e":"I've gotta go to the toilet and take a dump."}]}]},"elder":{"h":"elder","i":"/ˈɛldə/","a":"en-us-elder.ogg","s":[{"p":"adjective","d":[{"m":"An elder person is one who is older, usually over 65 years of age, and often used to show respect.","e":"The white-haired Mandela looked like an elder statesman in his suit and tie."},{"m":"The elder of two people is the one who is older.","e":"I saw her at a meeting where I had gone with my elder brother."}]},{"p":"noun","d":[{"m":"(countable) Your elder is somebody who is older than you."},{"m":"(countable) An elder is an older respected person, often a leader.","e":"My father is an elder in the local church."},{"m":"(countable) An elder is a small tree usually with white flowers and black."}]}]},"emergency":{"h":"emergency","i":"/i.'mɚ.dʒən.si/","a":"en-us-emergency.ogg","s":[{"p":"noun","d":[{"m":"(countable) An emergency is a serious situation that needs to be dealt with very quickly.","e":"She called 911 to report the emergency to police."},{"m":"(uncountable) Emergency is the department in a hospital that takes people with immediate medial needs."}]}]},"dew":{"h":"dew","i":"/djuː/","a":"en-us-dew.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Dew is small amounts of water that come onto the ground and onto other things in the morning.","e":"The spider web was very beautiful when it was covered with drops of dew."}]}]},"sigh":{"h":"sigh","i":"/saɪ/","a":"en-us-sigh.ogg","s":[{"p":"verb","d":[{"m":"When someone sighs, they take a big breath and breathe out in a relaxed way because they feel relieved or disappointed.","e":"She wasn't happy about what happened, but she sighed and accepted it."}]},{"p":"noun","d":[{"m":"(countable) A sigh is when someone [[#Noun|sighs]].","e":"When the car didn't hit him, she breathed a sigh of relief."}]}]},"log":{"h":"log","i":"/lɒɡ/","a":"en-us-log.ogg","s":[{"p":"noun","d":[{"m":"(countable) A log is a piece of wood that is long and round that has been cut off a tree.","e":"We need another log to make a nice big fire."},{"m":"(countable) A log is a place where people or computer programs write things when they happen, and they write the date (and maybe the time) every time they write something.","e":"We need to keep a log of everyone going into and out of this building."},{"m":"(countable) In mathematics, a log is a logarithm."}]},{"p":"verb","d":[{"m":"When people log a forest, they cut down the trees to make logs.","e":"There was a forest here, but it was logged a few years ago."},{"m":"When someone logs something, they write it in a log book.","e":"Make sure you log that so we'll remember what time it happened."}]}]},"towel":{"h":"towel","i":"/taʊl/","a":"en-us-towel.ogg","s":[{"p":"noun","d":[{"m":"A towel is a large, soft piece of cloth that people use for drying themselves after they have a bath, or for drying dishes after they are washed.","e":"I want to have a shower, but there are no clean towels!"}]}]},"cemeteries":{"h":"cemeteries","l":"cemetery","q":"noun"},"pollutants":{"h":"pollutants","l":"pollutant","q":"noun"},"undergrounds":{"h":"undergrounds","l":"underground","q":"noun"},"eighteens":{"h":"eighteens","l":"eighteen","q":"noun"},"readers":{"h":"readers","a":"en-us-readers.ogg","l":"reader","q":"noun"},"emergencies":{"h":"emergencies","i":"/iˈmɜː(r).dʒən.siːz/","l":"emergency","q":"noun"},"papayas":{"h":"papayas","l":"papaya","q":"noun"},"engage":{"h":"engage","i":"/ɪn'geɪʤ/","a":"en-us-engage.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you engage in an activity, you do it.","e":"My broken foot left me with few athletic activities that I could engage in."},{"m":"(transitive) If you engage somebody, you get and keep their attention.","e":"Teachers are always thinking of ways to engage students."},{"m":"(transitive) (formal) If you engage somebody, you hire them."},{"m":"If you engage a part of a machine, you make it contact another part so that they both move.","e":"He reaches up and throws a red-handled lever to engage the black iron gears."},{"m":"If an army engages an enemy, they start fighting."}]}]},"engaged":{"h":"engaged","i":"/ɪnˈɡeɪdʒd/","a":"en-us-engaged.ogg","l":"engage","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are engaged in something, you are interested in it.","e":"Americans are very engaged in this year's elections."},{"m":"If you are engaged in something, you do it.","e":"He has recently become actively engaged in trying to find a cure for the disease."},{"m":"If two people are engaged, they have promised to marry each other.","e":"They've been dating for two years but just became engaged last week."},{"m":"If the telephone is engaged, it is being used.","e":"I tried calling, but their line is engaged."}]}]},"undermined":{"h":"undermined","l":"undermine","q":"verb"},"undermine":{"h":"undermine","i":"/ʌndəˈmaɪn/","a":"en-us-undermine.ogg","s":[{"p":"verb","d":[{"m":"Someone or something undermines something when they make it difficult for it to happen.","e":"When you yell at people, it undermines our attempt to get these people to be friendly with each other."},{"m":"Someone or something undermines something when they dig under it, maybe making it fall.","e":"When it rained, the fast-moving part of the river came too close to the house and undermined one of its walls."}]}]},"fence":{"h":"fence","i":"/fɛns/","a":"en-us-fence.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fence is like a thin wall that is not part of a building. It stops people or animals from going from one outdoors place to another. It may have many big holes that you can see through, but not big enough for people to walk through.","e":"We put up a tall fence around the yard so that the dog couldn't get out."},{"m":"(countable) A fence is a person who buys things from people who stole the things, and then sells the things again to other people.","e":"I don't think anyone will steal this, because they wouldn't get much money for it. They'd have to sell it to a fence."}]},{"p":"verb","d":[{"m":"(transitive) When someone fences a piece of land, they put up a fence around it.","e":"This field has been fenced for years, because they used to keep cows here."},{"m":"(intransitive) When someone fences, they fight with swords as a sport.","e":"I can hear the sound of the swords hitting each other, from people fencing in the gym."},{"m":"(transitive) When someone fences something, they sell it to a fence.","e":"We can't give you back what we stole. We fenced it."}]}]},"sword":{"h":"sword","i":"/sɔːd/","a":"en-us-sword.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sword is a weapon made of metal which is long, thin and sharp, like a very long knife.","e":"Before there were guns, people used to use swords to fight and kill each other."}]}]},"gate":{"h":"gate","i":"/ɡeɪt/","a":"en-us-gate.ogg","s":[{"p":"noun","d":[{"m":"(countable) A gate is like a door in a fence. It opens to let people go through the fence.","e":"Please open the gate for me; my hands are full."},{"m":"(countable) In computers and logic, a gate is something that gives a simple yes-or-no answer from two (or one, or more than two) yes-or-no things coming into it.","e":"We need one more \"and\"-gate here so that it will give the finished answer."}]}]},"gates":{"h":"gates","a":"En-us-gates.ogg","l":"gate","q":"noun"},"swords":{"h":"swords","i":"/sɔrdz/","a":"en-us-swords.ogg","l":"sword","q":"noun"},"fences":{"h":"fences","l":"fence","q":"noun"},"fenced":{"h":"fenced","l":"fence","q":"verb"},"fencing":{"h":"fencing","i":"/ˈfɛnsɪŋ/","l":"fence","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) Fencing is a sport where people fight with swords.","e":"Fencing is an Olympic sport dating back to the 18th century."}]}]},"erode":{"h":"erode","i":"/ɪˈrəʊd/","a":"LL-Q1860 (eng)-Vealhurl-erode.wav","s":[{"p":"verb","d":[{"m":"Wind or water erode something, when they slowly make part of it go away.","e":"The river is slowly eroding its bank (edge of the river). In a few years we'll have to move our house farther away."}]}]},"natives":{"h":"natives","i":"/ˈneɪtɪvz/","a":"en-us-natives.ogg","l":"native","q":"noun"},"royal":{"h":"royal","i":"/ˈrɔɪəl/","a":"en-us-royal.ogg","s":[{"p":"adjective","d":[{"m":"To be royal means that someone is of a monarch or their family."}]},{"p":"noun","d":[{"m":"(countable) A royal is someone of noble birth or a member of a royal family."}]}]},"royals":{"h":"royals","l":"royal","q":"noun"},"sunshine":{"h":"sunshine","i":"/ˈsʌnʃaɪn/","a":"en-us-sunshine.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Sunshine is the light, rays, or warmth of the Sun.","e":"We got ourselves warm in the sunshine."},{"m":"(uncountable) If you are in sunshine, you are in a place where the sunlight is shining.","e":"We moved our picnic out of the shade and into the sunshine."},{"m":"(uncountable) Sunshine is when something or someone is happy or joyous.","e":"Having her here added sunshine to my day."}]}]},"sunbeam":{"h":"sunbeam","s":[{"p":"noun","d":[{"m":"(countable) A sunbeam is a small and powerful beam of light from the Sun.","e":"The sunbeam ahead lit up the path."}]}]},"sunbeams":{"h":"sunbeams","l":"sunbeam","q":"noun"},"locals":{"h":"locals","l":"local","q":"noun"},"landslips":{"h":"landslips","l":"landslip","q":"noun"},"softer":{"h":"softer","l":"soft","q":"adjective"},"softest":{"h":"softest","l":"soft","q":"adjective"},"temperatures":{"h":"temperatures","l":"temperature","q":"noun"},"poland":{"h":"Poland","i":"/ˈpəʊ.lənd/","a":"en-us-Poland.ogg","s":[{"p":"proper noun","d":[{"m":"Poland is a country in Central Europe."}]}]},"dramas":{"h":"dramas","l":"drama","q":"noun"},"insults":{"h":"insults","l":"insult","q":"noun"},"activities":{"h":"activities","i":"/ækˈtɪv.ɪ.tiːz/","a":"en-us-activities.ogg","l":"activity","q":"noun"},"walking":{"h":"w