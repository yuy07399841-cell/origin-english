es":{"h":"demystifies","l":"demystify","q":"verb"},"demystified":{"h":"demystified","l":"demystify","q":"verb"},"demystifying":{"h":"demystifying","l":"demystify","q":"verb"},"undersleep":{"h":"undersleep","i":"/ˈʌndəˌsliːp/","a":"LL-Q1860 (eng)-Flame, not lame-undersleep.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If you undersleep, you sleep too little."}]}]},"undersleeps":{"h":"undersleeps","l":"undersleep","q":"verb"},"underslept":{"h":"underslept","l":"undersleep","q":"verb"},"undersleeping":{"h":"undersleeping","l":"undersleep","q":"verb"},"overblacken":{"h":"overblacken","s":[{"p":"verb","d":[{"m":"(transitive) If you overblacken something, you blacken it excessively."}]}]},"overblackens":{"h":"overblackens","l":"overblacken","q":"verb"},"overblackened":{"h":"overblackened","l":"overblacken","q":"verb"},"overblackening":{"h":"overblackening","l":"overblacken","q":"verb"},"overadorn":{"h":"overadorn","s":[{"p":"verb","d":[{"m":"(transitive) If you overadorn something, you adorn it excessively."}]}]},"overadorns":{"h":"overadorns","l":"overadorn","q":"verb"},"overadorned":{"h":"overadorned","l":"overadorn","q":"verb"},"overadorning":{"h":"overadorning","l":"overadorn","q":"verb"},"overage":{"h":"overage","i":"/ˈəʊvərˈeɪd͡ʒ/","a":"LL-Q1860 (eng)-Vealhurl-overage1.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you overage something, you have it in the process for too long."}]}]},"overages":{"h":"overages","l":"overage","q":"verb"},"overaged":{"h":"overaged","l":"overage","q":"verb"},"overaging":{"h":"overaging","l":"overage","q":"verb"},"overcaffeinate":{"h":"overcaffeinate","s":[{"p":"verb","d":[{"m":"(transitive) If you overcaffeinate something, you caffeinate it excessively."}]}]},"overcaffeinates":{"h":"overcaffeinates","l":"overcaffeinate","q":"verb"},"overcaffeinated":{"h":"overcaffeinated","l":"overcaffeinate","q":"verb","s":[{"p":"adjective","d":[{"m":"An overcaffeinated person is someone who has ingested too much caffeine."}]}]},"overcaffeinating":{"h":"overcaffeinating","l":"overcaffeinate","q":"verb"},"overbutter":{"h":"overbutter","s":[{"p":"verb","d":[{"m":"(transitive) If you overbutter something, you butter it excessively."}]}]},"overbutters":{"h":"overbutters","l":"overbutter","q":"verb"},"overbuttered":{"h":"overbuttered","l":"overbutter","q":"verb"},"overbuttering":{"h":"overbuttering","l":"overbutter","q":"verb"},"starchiness":{"h":"starchiness","s":[{"p":"noun","d":[{"m":"The starchiness of something is how starchy it is."}]}]},"parisian":{"h":"Parisian","i":"/pəˈrɪʒ.ən/","a":"LL-Q1860 (eng)-Vealhurl-Parisian.wav","s":[{"p":"noun","d":[{"m":"(countable) A Parisian is a person from Paris."}]},{"p":"adjective","d":[{"m":"Something that is Parisian comes from Paris."}]}]},"parisians":{"h":"Parisians","l":"parisian","q":"noun"},"crotchet":{"h":"crotchet","s":[{"p":"noun","d":[{"m":"A crotchet is the British term for a quarter note in American English. It has a filled-in note head with a stem and is typically worth one beat in 4/4 time."}]}]},"minim":{"h":"minim","s":[{"p":"noun","d":[{"m":"A minim is a musical note worth two beats in common time (4/4). In American English, it is called a half note."},{"m":"A minim is a very small unit of liquid volume that was used in pharmacy. It is approximately 0.06 milliliters."}]}]},"semibreve":{"h":"semibreve","s":[{"p":"noun","d":[{"m":"A musical note with a time value equal to two minims (half notes), commonly called a whole note in American English. It is written as a hollow oval without a stem, and in 4/4 time it lasts for four beats."}]}]},"breve":{"h":"breve","s":[{"p":"noun","d":[{"m":"A breve is a musical note value that is twice the length of a semibreve (whole note)."}]}]},"longa":{"h":"longa","s":[{"p":"noun","d":[{"m":"A longa is a very long musical note value used mainly in early music notation, especially in medieval and Renaissance music."}]}]},"maxima":{"h":"maxima","s":[{"p":"noun","d":[{"m":"A maxima is the largest and longest note value in the system of early musical notation."},{"m":"It is equal to two longae (or, in some historical systems, a different number depending on the notation practice being used)."}]}]},"cakewalk":{"h":"cakewalk","s":[{"p":"noun","d":[{"m":"A traditional African American dance and social competition that originated in the 19th century."},{"m":"Couples would perform a stylized walk or dance, and the best performers could win a cake as a prize."}]},{"p":"verb","d":[{"m":"To move through or accomplish something with very little effort; to proceed easily."}]}]},"antenna":{"h":"antenna","s":[{"p":"noun","d":[{"m":"A thin, movable sensory organ on the head of insects and some other animals. It helps them detect touch, smell, movement, and their surroundings."},{"m":"A device that receives or transmits signals for television, radio, or communication systems."}]}]},"cod":{"h":"cod","s":[{"p":"noun","d":[{"m":"A large marine fish that is commonly eaten as food. It has white, flaky flesh and lives in cold ocean waters."}]}]},"flea":{"h":"flea","s":[{"p":"noun","d":[{"m":"A small, wingless insect that lives on animals and sometimes humans, feeding on blood. Fleas can jump very far compared with their size and often cause itching."}]}]},"alga":{"h":"alga","s":[{"p":"noun","d":[{"m":"A simple, plant-like organism that usually lives in water and makes its own food through photosynthesis. Algae can be found in oceans, lakes, rivers, and even damp places."}]}]},"cuz":{"h":"cuz","i":"/bɪˈkɒz/","a":"en-us-cuz.ogg","s":[{"p":"preposition","d":[{"m":"You use because to show the other reason for something.","e":"I bought the book because I wanted to read it."}]}]}}}