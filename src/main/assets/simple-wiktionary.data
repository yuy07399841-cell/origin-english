anglehold","q":"noun"},"worldly":{"h":"worldly","i":"/ˈwɜː(r)ldli/","a":"En-us-worldly.ogg","s":[{"p":"adjective","d":[{"m":"If someone is wordly, then he is physical, human and relates more to the planet"},{"m":"A wordly person is interested about secular rather than sacred matters."}]}]},"chauffeur":{"h":"chauffeur","i":"/ʃɒˈfɜː/","a":"en-us-chauffeur.ogg","s":[{"p":"noun","d":[{"m":"(countable) A chauffeur is a person who is hired to drive a car or other vehicle."}]},{"p":"verb","d":[{"m":"(transitive) If you chauffeur someone, you transport them in a motor vehicle."}]}]},"chauffeurs":{"h":"chauffeurs","l":"chauffeur","q":"noun"},"amazes":{"h":"amazes","i":"/əˈmeɪzɪz/","l":"amaze","q":"verb"},"amazed":{"h":"amazed","i":"/əˈmeɪzd/","l":"amaze","q":"verb"},"vandal":{"h":"vandal","i":"/ˈvændəl/","a":"en-us-vandal.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vandal is a person who wants to destroy or damage other people's work.","e":"My whole work was destroyed by a vandal in only a few minutes."}]},{"p":"adjective","d":[{"m":"If someone is vandal, they are destructive without care.","e":"The vandal boy has a bad reputation."}]}]},"vandals":{"h":"vandals","l":"vandal","q":"noun"},"impression":{"h":"impression","i":"/ɪmˈprɛʃən/","a":"en-us-impression.ogg","s":[{"p":"noun","d":[{"m":"The impression is the effect something has on a person.","e":"It is always important to make a good first impression."}]}]},"impressions":{"h":"impressions","a":"en-us-impressions.ogg","l":"impression","q":"noun"},"query":{"h":"query","i":"/ˈkwɪə.ri/","a":"LL-Q1860 (eng)-Vealhurl-query.wav","s":[{"p":"noun","d":[{"m":"(countable) A query is a question."}]},{"p":"verb","d":[{"m":"If you query someone, then you ask them."}]}]},"queries":{"h":"queries","l":"query","q":"noun"},"queried":{"h":"queried","l":"query","q":"verb"},"querying":{"h":"querying","l":"query","q":"verb"},"frank":{"h":"frank","i":"/fræŋk/","a":"en-us-frank.ogg","s":[{"p":"noun","d":[{"m":"(countable) A frank is a notice on an envelope where a stamp usually is."},{"m":"(countable) A frank is a hot dog or sausage."},{"m":"(countable) A frank is a grey heron."}]},{"p":"verb","d":[{"m":"If you frank an envelope, you put a frank on it."}]},{"p":"adjective","d":[{"m":"If you are frank with someone, you are honest to the point of being blunt."}]}]},"franks":{"h":"Franks","l":"frank","q":"noun","s":[{"p":"proper noun","d":[{"m":"The Franks were a Germanic people who lived in what is now France, the Low Countries, and Germany.","e":"The Franks are an ancient people."}]}]},"franked":{"h":"franked","l":"frank","q":"verb"},"franking":{"h":"franking","l":"frank","q":"verb"},"runner-up":{"h":"runner-up","i":"/ˌrʌn.əˈrʌp/","s":[{"p":"noun","d":[{"m":"(countable) A runner-up is a person who takes second place in a competition.","e":"John Doe came in first place and the runner-up was Jane Doe."}]}]},"runner-ups":{"h":"runner-ups","l":"runner-up","q":"noun"},"leaders":{"h":"leaders","a":"En-us-leaders.ogg","l":"leader","q":"noun"},"sighs":{"h":"sighs","l":"sigh","q":"verb"},"sighed":{"h":"sighed","i":"/saɪd/","a":"en-us-sighed.ogg","l":"sigh","q":"verb"},"sighing":{"h":"sighing","l":"sigh","q":"verb"},"troubles":{"h":"troubles","a":"En-us-troubles.ogg","l":"trouble","q":"noun"},"troubling":{"h":"troubling","l":"trouble","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is troubling, it makes you feel worried or upset."}]}]},"benched":{"h":"benched","l":"bench","q":"verb"},"benching":{"h":"benching","l":"bench","q":"verb"},"sturdiest":{"h":"sturdiest","l":"sturdy","q":"adjective"},"streak":{"h":"streak","i":"/striːk/","a":"en-us-streak.ogg","s":[{"p":"noun","d":[{"m":"A line left from smearing something or from motion.","e":"When I cleaned the window I left streaks behind."},{"m":"A unbroken series of events.","e":"I have had a streak of good luck!"},{"m":"The color of the powder of a mineral."},{"m":"A certain type of moth (see )."},{"m":"A tendency or trait of something, but not the most major one.","e":"She's a good dog but she does have a streak of stubbornness."}]},{"p":"verb","d":[{"m":"If something streaks across or through an area, it moves very quickly.","e":"The cheetah streaked after the."},{"m":"If something is streaked it has streaks on it.","e":"If you clean a window in direct sunlight, it will streak."},{"m":"If you streak, you run naked in public.","e":"It was a good game until some guy streaked across the field."}]}]},"streaks":{"h":"streaks","l":"streak","q":"noun"},"streaked":{"h":"streaked","l":"streak","q":"verb"},"streaking":{"h":"streaking","l":"streak","q":"verb"},"welfares":{"h":"welfares","l":"welfare","q":"noun"},"hip":{"h":"hip","i":"/hɪp/","a":"en-us-hip.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hip is the part of the pelvis that sticks out the farthest. It is part of the lower torso.","e":"My aunt broke her hip when she fell last autumn. She couldn't walk for a month."},{"m":"(countable) A hip of a rose is its fruit.","e":"She took rosehips for the Vitamin C."}]},{"p":"adjective","d":[{"m":"If someone is hip, he or she knows how to act right and dress right.","e":"Jenna is hip. She always wears the latest fashion and she is fun to be around."}]}]},"hipper":{"h":"hipper","i":"/ˈhɪpɚ/","l":"hip","q":"adjective"},"hippest":{"h":"hippest","l":"hip","q":"adjective"},"hips":{"h":"hips","l":"hip","q":"noun"},"franker":{"h":"franker","l":"frank","q":"adjective","s":[{"p":"noun","d":[{"m":"(countable) A franker is someone who franks."}]}]},"frankers":{"h":"frankers","l":"franker","q":"noun"},"frankest":{"h":"frankest","l":"frank","q":"adjective"},"inactive":{"h":"inactive","i":"/ɪnˈæktɪv/","a":"LL-Q1860 (eng)-I learned some phrases-inactive.wav","s":[{"p":"adjective","d":[{"m":"If something is inactive, it is turned off, not working, or dormant.","e":"The volcano has not erupted since 1901 and is considered inactive."},{"m":"Not active, lazy or idle."},{"m":"If someone is inactive, they are no longer on duty or in the service."}]}]},"barrier":{"h":"barrier","i":"/ˈbæri.ə(r)/","a":"en-us-barrier.ogg","s":[{"p":"noun","d":[{"m":"(countable) A barrier is something that stops passage; it does not allow anything to get through it.","e":"The barrier across the road stopped traffic from getting past it."},{"m":"(countable) A barrier is an obstacle; it is something to prevents progress.","e":"The bug in the code was a barrier to us completing the project on time."},{"m":"(countable) A barrier is a boundary or limit.","e":"The wall surrounding the jail was a barrier to all those who want to get out."}]}]},"barriers":{"h":"barriers","a":"en-us-barriers.ogg","l":"barrier","q":"noun"},"sturdiness":{"h":"sturdiness","s":[{"p":"noun","d":[{"m":"(uncountable) Sturdiness is the state or quality of being sturdy."}]}]},"idiom":{"h":"idiom","i":"/ˈɪd.i.əm/","a":"en-uk-idiom.ogg","s":[{"p":"noun","d":[{"m":"(countable) An idiom is a phrase that is not literal.","e":"\"\" is an idiom for wishing a person good luck."},{"m":"(countable) An idiom is a way of expressing oneself or manner of speaking."}]}]},"idioms":{"h":"idioms","l":"idiom","q":"noun"},"humps":{"h":"humps","l":"hump","q":"noun"},"humped":{"h":"humped","l":"hump","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is humped, it has a hump(s).","e":"The camel is humped."}]}]},"humping":{"h":"humping","l":"hump","q":"verb"},"sums":{"h":"sums","i":"/sʌmz/","l":"sum","q":"noun"},"summed":{"h":"summed","l":"sum","q":"verb"},"summing":{"h":"summing","l":"sum","q":"verb"},"inaction":{"h":"inaction","s":[{"p":"noun","d":[{"m":"(countable) An inaction is a want of activity or action; it is a rest."}]}]},"inactions":{"h":"inactions","l":"inaction","q":"noun"},"airings":{"h":"airings","l":"airing","q":"noun"},"englishman":{"h":"Englishman","i":"/ˈɪŋ.lɪʃ.mən/","a":"LL-Q1860 (eng)-Vealhurl-Englishman.wav","s":[{"p":"noun","d":[{"m":"(countable) An Englishman is a native or inhabitant of England.","e":"The event marked the first time an Englishman had been killed in war since the Korean War."}]}]},"englishwoman":{"h":"Englishwoman","s":[{"p":"noun","d":[{"m":"(countable) An Englishwoman is a female person who is a native of England."}]}]},"englishwomen":{"h":"Englishwomen","l":"englishwoman","q":"noun"},"corridor":{"h":"corridor","i":"/ˈkɒrɪˌdɔː(r)/","a":"en-us-corridor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A corridor is a narrow hall with rooms that branch off of it.","e":"The corridor in the hospital has many rooms leading off of it."},{"m":"(countable) A corridor is a piece of land that is set aside only for use to travel between two places."},{"m":"(countable) A corridor is airspace that is set aside only for use of aircraft travelling."}]}]},"corridors":{"h":"corridors","l":"corridor","q":"noun"},"airspace":{"h":"airspace","s":[{"p":"noun","d":[{"m":"(countable) An airspace is a special part of the atmosphere that is often under the jurisdiction of the land below it."},{"m":"(countable) An airspace is a part of the sky that is set aside for use by aircraft.","e":"The airplane had instructions to only fly in the airspace above the state of Kentucky."}]}]},"airspaces":{"h":"airspaces","l":"airspace","q":"noun"},"starquake":{"h":"starquake","s":[{"p":"noun","d":[{"m":"(countable) A starquake is an earthquake that happens on the surface of a star, which is usually collapsed."}]}]},"starquakes":{"h":"starquakes","l":"starquake","q":"noun"},"seaquake":{"h":"seaquake","s":[{"p":"noun","d":[{"m":"(countable) A seaquake is an earthquake whose epicenter is under the surface of the sea.","e":"The devastating seaquake caused the tsunami that hit Sri Lanka a few years back."}]}]},"seaquakes":{"h":"seaquakes","l":"seaquake","q":"noun"},"moonquake":{"h":"moonquake","a":"En-us-moonquake.ogg","s":[{"p":"noun","d":[{"m":"(countable) A moonquake is an earthquake that happens on the surface of the moon.","e":"The moonquake caused a deep rift to appear in one of the Moon's craters."}]}]},"moonquakes":{"h":"moonquakes","l":"moon