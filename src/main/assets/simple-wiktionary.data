","q":"noun"},"fault":{"h":"fault","i":"/fɔːlt/","a":"en-us-fault.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) If something is your fault, you did something wrong or didn't do something right.","e":"It doesn't matter whose fault it is, let's work together to make it right."},{"m":"(countable) A fault is a problem or a mistake.","e":"We found a few faults in the plan, but we'll fix them later."},{"m":"(countable) A fault in your character is something about you that is not nice or good.","e":"The other girls thought that her only fault was that she was really stupid."},{"m":"(countable) A fault is a long crack in the earth.","e":"The earthquake occurred near the San Andreas fault."},{"m":"(countable) In sports like tennis or volleyball, a fault is hitting the ball in the wrong way, or to or from the wrong place."}]},{"p":"verb","d":[{"m":"(transitive) If you fault somebody for something bad, you say they did something wrong or didn't do something right.","e":"You can't fault him for not knowing about the change."}]}]},"gripped":{"h":"gripped","a":"en-us-gripped.ogg","l":"grip","q":"verb"},"grips":{"h":"grips","l":"grip","q":"verb"},"gripping":{"h":"gripping","l":"grip","q":"verb"},"explodes":{"h":"explodes","l":"explode","q":"verb"},"exploding":{"h":"exploding","l":"explode","q":"verb"},"gravest":{"h":"gravest","l":"grave","q":"adjective"},"squeakier":{"h":"squeakier","l":"squeaky","q":"adjective"},"squeakiest":{"h":"squeakiest","l":"squeaky","q":"adjective"},"regulars":{"h":"regulars","l":"regular","q":"noun"},"elders":{"h":"elders","a":"en-us-elders.ogg","l":"elder","q":"noun"},"worming":{"h":"worming","l":"worm","q":"verb"},"wormed":{"h":"wormed","l":"worm","q":"verb"},"wizards":{"h":"wizards","l":"wizard","q":"noun"},"charted":{"h":"charted","l":"chart","q":"verb"},"charting":{"h":"charting","l":"chart","q":"verb"},"kings":{"h":"kings","i":"/kɪŋz/","a":"en-us-kings.ogg","l":"king","q":"noun"},"girls":{"h":"girls","i":"/ɡɝlz/","a":"en-us-girls.ogg","l":"girl","q":"noun"},"farmers":{"h":"farmers","l":"farmer","q":"noun"},"firefighters":{"h":"firefighters","l":"firefighter","q":"noun"},"chairpeople":{"h":"chairpeople","l":"chairperson","q":"noun"},"diagramed":{"h":"diagramed","l":"diagram","q":"verb"},"diagraming":{"h":"diagraming","l":"diagram","q":"verb"},"diagrammed":{"h":"diagrammed","l":"diagram","q":"verb"},"diagramming":{"h":"diagramming","l":"diagram","q":"verb"},"furnace":{"h":"furnace","i":"/ˈfɜːnɪs/","a":"en-us-furnace.ogg","s":[{"p":"noun","d":[{"m":"(countable) A furnace is a machine that is used to heat a building."},{"m":"(countable) A furnace is a place that is very hot."}]}]},"furnaces":{"h":"furnaces","l":"furnace","q":"noun"},"muslims":{"h":"Muslims","l":"muslim","q":"proper noun"},"atheists":{"h":"atheists","l":"atheist","q":"noun"},"authors":{"h":"authors","i":"/ˈɔː.θəz/","a":"en-us-authors.ogg","l":"author","q":"noun"},"authored":{"h":"authored","l":"author","q":"verb"},"authoring":{"h":"authoring","l":"author","q":"verb"},"butchers":{"h":"butchers","l":"butcher","q":"noun"},"bassists":{"h":"bassists","l":"bassist","q":"noun"},"brothers":{"h":"brothers","i":"/ˈbrʌðə(r)z/","a":"en-us-brothers.ogg","l":"brother","q":"noun"},"fathers":{"h":"fathers","a":"en-us-fathers.ogg","l":"father","q":"noun"},"fathered":{"h":"fathered","l":"father","q":"verb"},"folk":{"h":"folk","i":"/fəʊk/","a":"en-us-folk.ogg","s":[{"p":"noun","d":[{"m":"Folk are people.","e":"Often, doctors have difficulty explaining things to ordinary folk like me."},{"m":"Your folks are your parents.","e":"I'm not sure if I can get the car. I'll have to ask my folks."},{"m":"(usually before another noun) Folk music, dance, art, etc., is traditional and belongs to the ordinary people.","e":"I remember reading about him in a collection of folk tales."}]}]},"folks":{"h":"folks","a":"en-us-folks.ogg","l":"folk","q":"noun","s":[{"p":"noun","d":[{"m":"Folks are people in general."}]}]},"firemen":{"h":"firemen","l":"fireman","q":"noun"},"siblings":{"h":"siblings","l":"sibling","q":"noun"},"dogging":{"h":"dogging","l":"dog","q":"verb"},"originals":{"h":"originals","l":"original","q":"noun"},"fortnight":{"h":"fortnight","i":"/ˈfɔːt.naɪt/","a":"en-us-fortnight.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fortnight is 14 days; two weeks.","e":"Her mother will be staying for a fortnight over Christmas."}]}]},"galatia":{"h":"Galatia","s":[{"p":"proper noun","d":[{"m":"A region of ancient Asia Minor in what is now the country of Turkey."}]}]},"turkey":{"h":"Turkey","i":"/ˈtɜːk.ɪ/","a":"en-us-turkey.ogg","s":[{"p":"proper noun","d":[{"m":"Turkey is a country in western Asia and eastern Europe. Its full name is Republic of Turkey."}]}]},"turkeys":{"h":"turkeys","l":"turkey","q":"noun"},"admire":{"h":"admire","i":"/ədˈmaɪə/","a":"en-us-admire.ogg","s":[{"p":"verb","d":[{"m":"If you admire something, you like it very much.","e":"He admired the painting on the wall."}]}]},"rob":{"h":"rob","i":"/rɔb/","a":"en-us-rob.ogg","s":[{"p":"verb","d":[{"m":"If you rob something or someone, you steal from them.","e":"He went to rob the bank."}]}]},"robbery":{"h":"robbery","i":"/ˈrɒbəri/","a":"en-us-robbery.ogg","s":[{"p":"noun","d":[{"m":"To take money or property without permission, sometimes with violence.","e":"The police were called because there had been a bank robbery."}]}]},"probability":{"h":"probability","i":"/prɒbəˈbɪlɪti/","a":"en-us-probability.ogg","s":[{"p":"noun","d":[{"m":"(countable) The chance something will happen.","e":"The probability of rolling a six is one in six, 1/6."},{"m":"(uncountable), The study of chance.","e":"I took a class in probability and statistics."}]}]},"probabilities":{"h":"probabilities","l":"probability","q":"noun"},"admirable":{"h":"admirable","i":"/ˈæd.mɚ.ʌˌbl/","a":"en-us-admirable.ogg","s":[{"p":"adjective","d":[{"m":"If you are admirable, people will like you, or what you do.","e":"She said his quick thinking was admirable."}]}]},"admirer":{"h":"admirer","i":"/ədˈmaɪ.rə/","a":"en-us-admirer.ogg","s":[{"p":"noun","d":[{"m":"(countable) You are an admirer if you really like something or someone.","e":"He was an admirer of music by Ravindra."}]}]},"securer":{"h":"securer","l":"secure","q":"adjective"},"securest":{"h":"securest","l":"secure","q":"adjective"},"performances":{"h":"performances","l":"performance","q":"noun"},"productions":{"h":"productions","a":"en-us-productions.ogg","l":"production","q":"noun"},"zionism":{"h":"Zionism","s":[{"p":"proper noun","d":[{"m":"Zionism is the belief that there should be a Jewish country, especially support for the current Jewish state in Israel."},{"m":"Zionism is a religion that is practiced by people in parts of Africa and is most popular in Eswatini. It is a mix of Protestantism and Animism."}]}]},"zionists":{"h":"Zionists","l":"zionist","q":"noun"},"robber":{"h":"robber","i":"/ˈrɒ.bə(r)/","a":"LL-Q1860 (eng)-Vealhurl-robber.wav","s":[{"p":"noun","d":[{"m":"(countable) A robber is a person who takes money or property without permission, sometimes using violence. A thief; a person who steals.","e":"The bank robber took all the money from the bank."}]}]},"abbey":{"h":"abbey","i":"/ˈæb.i/","a":"en-us-abbey.ogg","s":[{"p":"noun","d":[{"m":"(countable) An abbey is a building where monks or nuns live, or used to live.","e":"After working in the fields, the monks went back to the abbey."},{"m":"(countable) An abbey is a church which was once part of an abbey.","e":"Westminster Abbey is a famous church in England."}]}]},"frighten":{"h":"frighten","i":"/ˈfraɪtn̩/","a":"en-us-frighten.ogg","s":[{"p":"verb","d":[{"m":"(transitive) Frighten means a person or thing that makes someone feel afraid; to cause someone to have a fear.","e":"You are shouting at me and frightening your daughters."}]}]},"robbers":{"h":"robbers","l":"robber","q":"noun"},"replacing":{"h":"replacing","l":"replace","q":"verb"},"sandstone":{"h":"sandstone","i":"/ˈsændˌstəʊn/","a":"LL-Q1860 (eng)-Vealhurl-sandstone.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Sandstone is a kind of rock that is made when sand is compacted together and glued into place with clay."}]}]},"specifying":{"h":"specifying","l":"specify","q":"verb"},"victories":{"h":"victories","i":"/ˈvɪkt(ə)riz/","l":"victory","q":"noun"},"pukes":{"h":"pukes","l":"puke","q":"verb"},"puked":{"h":"puked","l":"puke","q":"verb"},"puking":{"h":"puking","l":"puke","q":"verb"},"tiny":{"h":"tiny","i":"/taɪniː/","a":"en-us-tiny.ogg","s":[{"p":"adjective","d":[{"m":"Something that is tiny is very small.","e":"A single grain of sand is tiny."}]}]},"tick":{"h":"tick","i":"/tɪk/","a":"en-us-tick.ogg","s":[{"p":"noun","d":[{"m":"A tick is a mark, used to show that something is right.","e":"The teacher put a tick on the correct answer."},{"m":"A tick is a small bug.","e":"The dog was scratching because it had a tick in its ear."},{"m":"A tick is a clicking noise that keeps going.","e":"It was very quiet, and the only sound she could hear was the tick of the old clock."},{"m":"A tick is small line used to show a measure or a count."}]},{"p":"verb","d":[{"m":"If something ticks, it is making clicking noises.","e":"The clocked ticked on as I waited."}]}]},"scorpion":{"h":"scorpion","i":"/ˈskɔː.pi.ən/","a":"LL-Q1860 (eng)-Vealhurl-scorpion.wav","s":[{"p":"noun","d":[{"m":"(countable) A scorpion is a small animal with eight legs, pinchers, and a tail that stings."}]}]},"arachnid":{"h":"arachnid","i":"/ərækinɪd/","a":"en-us-arachnid.ogg","s":[{"p":"noun","d":[{"m":"(countable) An arachnid is a type of small animal with eight legs.","e":"s, scorpions, ticks, and mites are arachnids."}]}]},"arachnids":{"h":"arachnids","l":"arachnid","q":"noun"},"ticks":{"h":"ticks","l":"tick","q":"noun"},"grandchildren":{"h":"grandchildren","l":"grandchild","q":"noun"},"mothers":{"h":"mothers","l":"mother","q":"noun"},"nephews":{"h":"nephews","l":"nephew","q":"noun"},"uncles":{"h":"uncles","l":"uncle","q":"noun"},"nieces":{"h":"nieces","l":"niece","q":"noun"},"stepchildren":{"h":"stepchildren","l":"stepchild","q":"noun"},"sons":{"h":"sons","a":"en-us-sons.ogg","l":"son","q":"noun"},"asians":{"h":"Asians","l":"asian","q":"noun"},"greeks":{"h":"Greeks","l":"greek","q":"noun"},"tinier":{"h":"tinier","l":"tiny","q":"adjective"},"tiniest":{"h":"tiniest","l":"tiny","q":"adjective"},"militaries":{"h":"militaries","l":"military","q":"noun"},"busier":{"h":"busier","l":"busy","q":"adjective"},"busiest":{"h":"busiest","l":"busy","q":"adjective"},"busies":{"h":"busies","l":"busy","q":"verb"},"busied":{"h":"busied","l":"busy","q":"verb"},"busying":{"h":"busying","l":"busy","q":"verb"},"necessaries":{"h":"necessaries","l":"necessary","q":"noun"},"glyphs":{"h":"glyphs","l":"glyph","q":"noun"},"hairier":{"h":"hairier","l":"hairy","q":"adjective"},"hairiest":{"h":"hairiest","l":"hairy","q":"adjective"},"months":{"h":"months","i":"/mʌnθ/","a":"en-us-months.ogg","l":"month","q":"noun"},"decades":{"h":"decades","l":"decade","q":"noun"},"plainer":{"h":"plainer","l":"plain","q":"adjective"},"plainest":{"h":"plainest","l":"plain","q":"adjective"},"honeys":{"h":"honeys","l":"honey","q":"noun"},"kennels":{"h":"kennels","l":"kennel","q":"noun"},"eagles":{"h":"eagles","l":"eagle","q":"noun"},"paintballs":{"h":"paintballs","l":"paintball","q":"noun"},"paintballed":{"h":"paintballed","l":"paintball","q":"verb"},"coins":{"h":"coins","l":"coin","q":"noun"},"paintballing":{"h":"paintballing","l":"paintball","q":"verb"},"presidents":{"h":"presidents","l":"president","q":"noun"},"guitars":{"h":"guitars","l":"guitar","q":"noun"},"coining":{"h":"coining","i":"/ˈkɔɪnɪŋ/","l":"coin","q":"verb"},"organs":{"h":"organs","l":"organ","q":"noun"},"players":{"h":"players","i":"/ˈpleɪɚz/","l":"player","q":"noun"},"demagogues":{"h":"demagogues","l":"demagogue","q":"noun"},"demagogued":{"h":"demagogued","l":"demagogue","q":"verb"},"demagoguing":{"h":"demagoguing","l":"demagogue","q":"verb"},"guitar":{"h":"guitar","i":"/ɡɪˈtɑː/","a":"en-uk-guitar.ogg","s":[{"p":"noun","d":[{"m":"(countable) A guitar is a stringed musical instrument, usually with six strings, but sometimes more. It is used to play many kinds of music, including classical, rock, jazz, and bluegrass.","e":"John played the Edvard Grieg song \"Morning Mood\" on his guitar."}]}]},"likes":{"h":"likes","i":"/laɪks/","l":"like","q":"verb"},"stepson":{"h":"stepson","i":"/ˈstɛpsʌn/","a":"en-us-stepson.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stepson is the son of a person's husband or wife. A stepson is a male child from an earlier marriage.","e":"When I married my wife I got two stepsons."}]}]},"stepdaughter":{"h":"stepdaughter","i":"/ˈstepˌdɑː.t̬ɚ/","a":"LL-Q1860 (eng)-Vininn126-stepdaughter.wav","s":[{"p":"noun","d":[{"m":"(countable) A stepdaughter is the daughter of a person's husband or wife. A stepdaughter is a female child from an earlier marriage.","e":"When I married my wife I got two stepdaughters."}]}]},"deliberate":{"h":"deliberate","i":"/dɪˈlɪbərət/","a":"en-us-deliberate-adj.ogg","s":[{"p":"adjective","d":[{"m":"Deliberate means done intentionally; on purpose, not by accident.","e":"She walked up to her brother and gave him a deliberate kick."}]},{"p":"verb","d":[{"m":"If you deliberate something, you think about it carefully.","e":"The jury deliberated about the innocence of the person on trial."}]}]},"carp":{"h":"carp","i":"/ˈkɑːp/","a":"en-us-carp.ogg","l":"carp","q":"noun","s":[{"p":"noun","d":[{"m":"(uncountable) A carp is a type of fish.","e":"A goldfish is a small carp."}]},{"p":"verb","d":[{"m":"To complain about a fault; to harp on."}]}]},"dwarves":{"h":"dwarves","l":"dwarf","q":"noun"},"dwarfs":{"h":"dwarfs","l":"dwarf","q":"noun"},"stepsons":{"h":"stepsons","l":"stepson","q":"noun"},"stepdaughters":{"h":"stepdaughters","l":"stepdaughter","q":"noun"},"numbers":{"h":"Numbers","s":[{"p":"proper noun","d":[{"m":"' is the fourth book in the Old Testament of the bible."}]}]},"variables":{"h":"variables","l":"variable","q":"noun"},"numbered":{"h":"numbered","i":"/ˈnʌmbɚd/","a":"en-us-numbered.ogg","l":"number","q":"verb"},"fridays":{"h":"Fridays","l":"friday","q":"noun","s":[{"p":"adverb","d":[{"m":"(US) Every Friday."}]}]},"united":{"h":"united","i":"/juːˈnaɪtɪd/","a":"en-us-united.ogg","l":"unite","q":"verb","s":[{"p":"adjective","d":[{"m":"I some things (two or more) are united they are together. These act as one thing. This is often used for people of groups of people.","e":"We are united in our goals."}]}]},"john":{"h":"john","i":"/ˈd͡ʒɑn/","a":"en-us-john.ogg","s":[{"p":"noun","d":[{"m":"(countable) A john is a toilet."},{"m":"(countable) A john is a prostitute’s client."}]}]},"toilet":{"h":"toilet","i":"/ˈtɔɪ.lət/","a":"en-uk-toilet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A toilet is something you may put human waste (feces and urine) into.","e":"Excuse me, I need to use the toilet."},{"m":"(countable) A toilet is a bathroom.","e":"Where is the toilet?"}]}]},"popular":{"h":"popular","i":"/ˈpɑpjulɝ/","a":"en-us-popular.ogg","s":[{"p":"adjective","d":[{"m":"If something is popular many people like, love, or enjoy it.","e":"Beth is one of the popular girls in my class."}]}]},"japan":{"h":"Japan","i":"/ˌdʒəˈpæn/","a":"en-us-Japan.ogg","s":[{"p":"proper noun","d":[{"m":"Japan is an island country in East Asia.","e":"Tokyo is the capital of Japan."}]}]},"zest":{"h":"zest","i":"/zɛst/","a":"en-us-zest.ogg","s":[{"p":"noun","d":[{"m":"(uncountable), If you have zest, you are full of excitement or enthusiasm; you are full of life."},{"m":"(uncountable), If food has zest, it has a lot of flavor. It might be spicy.","e":"The hot peppers add zest to the soup."},{"m":"(uncountable), If music has zest, it is fast and lively.","e":"Play it with more zest this time."},{"m":"(cooking) The outer skin of a citrus fruit, used as a flavouring."}]},{"p":"verb","d":[{"m":"(cooking) If you zest something, you take the zest off of the fruit."}]}]},"agency":{"h":"agency","i":"/ˈeː.ʤən.si/","a":"en-us-agency.ogg","s":[{"p":"noun","d":[{"m":"(countable) An agency is a group of people called agents working together, or a place where agents work."},{"m":"(uncountable) Agency is the ability to do something."}]}]},"pad":{"h":"pad","i":"/pæd/","a":"en-au-pad.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pad is a material that is packed together, usually to be between two other things."},{"m":"(countable) (US) A pad is a bed."},{"m":"(countable) A pad is the place you live; it is your home."},{"m":"(countable) A pad is a low pitched musical sound that fills in the music. This is often in electronica or blues."},{"m":"(countable) (US) A pad is a leaf of the water lily."}]}]},"agencies":{"h":"agencies","l":"agency","q":"noun"},"toilets":{"h":"toilets","l":"toilet","q":"noun"},"wiener":{"h":"wiener","i":"/ˈwiːnə(r)/","a":"LL-Q1860 (eng)-Simplificationalizer-wiener.wav","s":[{"p":"noun","d":[{"m":"(US) (countable) A wiener is a hot dog.","e":"Can you please pass me that wiener?"},{"m":"(UK) (countable) A wiener is a frankfurter.","e":"In New York I bought a wiener for 5 dollars."},{"m":"(US);; (countable) A wiener is a penis.","e":"He showed me his wiener, even though I didn't want him to."}]}]},"golden":{"h":"golden","i":"/ˈɡəʊl.dən/","a":"en-us-golden.ogg","s":[{"p":"adjective","d":[{"m":"If something is golden it is made from gold."},{"m":"If something is golden it is the same color as gold:"},{"m":"If something is golden it is very good.","e":"It was a golden age, when everything seemed beautiful."},{"m":"Your golden years are when you are old and retired from work.","e":"I use to watch a show about old ladies. It was called \"The Golden Girls.\""},{"m":"The golden anniversary is the 50th anniversary.","e":"Her grandparents were celebrating the golden anniversary of their wedding."}]},{"p":"noun","d":[{"m":"Golden is a color between yellow and brown."}]}]},"ad":{"h":"ad","i":"/æd/","a":"en-us-ad.ogg","s":[{"p":"noun","d":[{"m":"(countable) A short way of saying advertisement.","e":"I saw an ad in the newspaper for a job at the factory."}]}]},"mount":{"h":"mount","i":"/maʊnt/","a":"en-us-mount.ogg","s":[{"p":"verb","d":[{"m":"If you mount something you get on to it.","e":"They mounted their horses and rode off."},{"m":"If you mount something you attach it to something else.","e":"I need someone to mount this diamond on a ring."},{"m":"to put a theatrical work on the stage","e":"The show was mounted in Montreal and New York."}]},{"p":"noun","d":[{"m":"(countable) Mount is another word for mountain. This may be shortened to \"Mt.\" to name a mountain.","e":"Jesus gave us the Sermon on the Mount."},{"m":"(countable) A mount is an animal you ride, often a horse.","e":"The policemen sat on his mount watching the park."}]}]},"remain":{"h":"remain","i":"/rɪˈmeɪn/","a":"en-us-remain.ogg","s":[{"p":"verb","d":[{"m":"If something remains it stays. It does not go away.","e":"I'll remain here as wait for you."},{"m":"If something remains it does not change.","e":"She remains is pretty as ever."}]},{"p":"noun","d":[{"m":"(usually plural) The remains of something are parts of something gone that are still here. This is often used for what is left of dead person whose body was damaged or decayed."}]}]},"descendant":{"h":"descendant","i":"/dɪˈsɛndənt/","a":"en-us-descendant.ogg","s":[{"p":"noun","d":[{"m":"(countable) A descendant is something or someone that comes after something or someone (ancestor).","e":"Dogs are descendants of early wolves."}]}]},"pure":{"h":"pure","i":"/ˈpjʊə/","a":"en-us-pure.ogg","s":[{"p":"adjective","d":[{"m":"If something is pure, it is not dirty or covered by anything that makes it unclean."}]}]},"twice":{"h":"twice","i":"/twaɪs/","a":"en-us-twice.ogg","s":[{"p":"determiner","d":[{"m":"If something is done twice, it is done two times.","e":"I have been to the shop twice today."},{"m":"Two times: double.","e":"He was working twice as fast as I was."}]}]},"prince":{"h":"prince","i":"/prɪns/","a":"en-us-prince.ogg","s":[{"p":"noun","d":[{"m":"(countable) A prince is the son of the king and queen in a country, and brother of the princess. The prince can also be the husband of a princess.","e":"Our great-great-great-great-grandfather is a prince."},{"m":"(countable) A prince is a man of high nobility but not of the royalty."}]}]},"princess":{"h":"princess","i":"/prɪnˈsɛs/","a":"en-us-princess.ogg","s":[{"p":"noun","d":[{"m":"(countable) A princess is the daughter of the king and queen of a country, and sister of the prince. The princess can also be the wife of a prince.","e":"The soldier is going to marry the princess."}]}]},"warn":{"h":"warn","i":"/wɔːn/","a":"en-us-worn.ogg","s":[{"p":"verb","d":[{"m":"If you warn someone about something, is to make them aware of a danger approaching.","e":"I warn you, lions are dangerous."},{"m":"If you warn someone can also be to make them aware that something they do is not accepted.","e":"It is not allowed to steal, I warn you."},{"m":"If you warn someone, you give a warning."}]}]},"gentleman":{"h":"gentleman","i":"/ˈʤɛntlmən/","a":"en-us-gentleman.ogg","s":[{"p":"noun","d":[{"m":"A gentleman is a man that treats other nicely, or a man of higher class."},{"m":"To call someone a gentleman is also a polite way to talk to someone.","e":"Please come with me, gentlemen."}]}]},"anything":{"h":"anything","i":"/ˈɛn.i.θɪŋ/","a":"en-us-anything.ogg","s":[{"p":"determiner","d":[{"m":"Any one of all things. You use this when there is no limit to what might be meant. You might be able to change \"anything\" to any other word.","e":"I'll do anything you want."}]}]},"anyone":{"h":"anyone","i":"/ˈɛn.iː.wɒn/","a":"en-us-anyone.ogg","s":[{"p":"determiner","d":[{"m":"Any person. You use this word when there is no limit to who might be meant. You might be able to change anyone to any person's name.","e":"Help! Can anyone hear me?"}]}]},"norwegian":{"h":"Norwegian","i":"/nɔːˈwiː.dʒən/","a":"en-us-Norwegian.ogg","s":[{"p":"proper noun","d":[{"m":"Norwegian is a language spoken by around 5 million people, mainly in Norway.","e":"I can not understand a word Norwegian, but I think it is a very nice language."}]},{"p":"adjective","d":[{"m":"If something is Norwegian, it is about Norway or the people living there.","e":"I think Norwegian food is good."}]},{"p":"noun","d":[{"m":"(countable) If someone is a Norwegian, he or she is from Norway.","e":"I am a Norwegian."}]}]},"mainly":{"h":"mainly","i":"/ˈmeɪnli/","a":"LL-Q1860 (eng)-Vealhurl-mainly.wav","s":[{"p":"adverb","d":[{"m":"For the most part; almost totally.","e":"In England, they speak mainly English."}]}]},"vowels":{"h":"vowels","l":"vowel","q":"noun"},"parakeet":{"h":"parakeet","i":"/ˈparəkiːt/","a":"LL-Q1860 (eng)-Vealhurl-parakeet.wav","s":[{"p":"noun","d":[{"m":"(countable) A parakeet is a tropical bird often kept as a pet. It is a small parrot.","e":"My pet parakeets name is Polly."}]}]},"budgie":{"h":"budgie","i":"/ˈbʌd͡ʒi/","a":"LL-Q1860 (eng)-Vealhurl-budgie.wav","s":[{"p":"noun","d":[{"m":"(countable) A budgie is a type of bird from Australia and often kept as a pet; a budgerigar.","e":"Budgies are kept in cages by people."}]}]},"parakeets":{"h":"parakeets","l":"parakeet","q":"noun"},"budgies":{"h":"budgies","l":"budgie","q":"noun"},"parrot":{"h":"parrot","i":"/ˈpærət/","a":"en-us-parrot.ogg","s":[{"p":"noun","d":[{"m":"(countable) A parrot is a type of tropical bird sometimes kept as a pet.","e":"Movie pirates always seem to have parrots."}]},{"p":"verb","d":[{"m":"If you parrot someone, you say exactly what that person says.","e":"I want you to parrot back what I just said, so I know you heard me right."}]}]},"headwords":{"h":"headwords","l":"headword","q":"noun"},"incompetent":{"h":"incompetent","i":"/ɪŋˈkɒmpətənt/","a":"LL-Q1860 (eng)-Vealhurl-incompetent.wav","s":[{"p":"adjective","d":[{"m":"If you are incompetent you are not good at what you are doing. You might not know how to do it. You might not be able to do it.","e":"He is an incompetent driver, and cannot keep a car on the road."},{"m":"If you are incompetent you are stupid or crazy.","e":"The incompetent fools ruined my whole day."},{"m":"In some countries if you are incompetent the law says you are not able to decide things. This means you are not allowed to do some things but do not do need to do other things. This is often because the incompetent person is insane (crazy).","e":"He was found incompetent to stand trial."}]}]},"competent":{"h":"competent","i":"/ˈkɒmpətənt/","a":"en-us-competent.ogg","s":[{"p":"adjective","d":[{"m":"If you are competent at something you can do it. You are good at doing it."},{"m":"In some countries, if you are competent the law says you are not insane (crazy). This means you can decide things, and may be allowed to do somethings that crazy people are not allowed to do."}]}]},"heal":{"h":"heal","i":"/hiːl/","a":"en-us-heal.ogg","s":[{"p":"verb","d":[{"m":"If a wound (injury) heals it goes away."},{"m":"If you heal your wounds or diseases leave you. Your body repairs itself, so you get better."},{"m":"If you heal another person or animal you repair their body. You make wounds or diseases leave them."}]}]},"healer":{"h":"healer","i":"/ˈhiːlə(r)/","a":"LL-Q1860 (eng)-Vininn126-healer.wav","s":[{"p":"noun","d":[{"m":"(countable) A healer is someone who helps other people get well from disease or injury.","e":"I saw a local healer when I got sick on my trip."}]}]},"professor":{"h":"professor","i":"/prəˈfɛsə/","a":"en-us-professor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A professor is a teacher at a college or university.","e":"Dr. Erickson and Dr. Karrow are my favorite professors."}]}]},"learner":{"h":"learner","i":"/ˈlɜrnər/","a":"LL-Q1860 (eng)-I learned some phrases-learner.wav","s":[{"p":"noun","d":[{"m":"(countable) A learner is someone that is learning.","e":"A good teacher learns from the students too, so everybody in the class is a learner."}]}]},"lamp":{"h":"lamp","i":"/læmp/","a":"en-us-lamp.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lamp is something that makes light (either from electricity or by burning fuel).","e":"It's getting dark so I'll switch on the lamp to read by."}]}]},"fuel":{"h":"fuel","i":"/ˈfjuːəl̩/","a":"en-uk-fuel.ogg","s":[{"p":"noun","d":[{"m":"Something use to make energy.","e":"My car uses gasoline for fuel to make it go. My body uses food for fuel, it's what makes me go."}]},{"p":"verb","d":[{"m":"When you fuel something, you add on to it.","e":"His words fuelled my anger."}]}]},"locker":{"h":"locker","i":"/ˈlɒk.ə(r)/","a":"LL-Q1860 (eng)-Vealhurl-locker.wav","s":[{"p":"noun","d":[{"m":"(countable) A locker is a cabinet to keep things in, usually with a lock.","e":"I put my jacket in my locker when I get to work."}]}]},"instep":{"h":"instep","i":"/ˈinˌstɛp/","a":"LL-Q1860 (eng)-Vealhurl-instep.wav","s":[{"p":"noun","d":[{"m":"An instep is the middle of the foot, between the toes and the ankle.","e":"He stepped on my shoe right where the laces are, but I was wearing them so he hurt my instep."}]}]},"hoof":{"h":"hoof","i":"/hʊf/","a":"en-us-hoof.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hoof is a foot of an animal with hard feet.","e":"The horseshoes are nailed to the horse's hoofs."}]},{"p":"verb","d":[{"m":"If you hoof, you walk.","e":"My car is broken so we'll have to hoof it. We'll only be walking 3 blocks."}]}]},"anchor":{"h":"anchor","i":"/ˈæŋkə/","a":"en-us-anchor.ogg","s":[{"p":"noun","d":[{"m":"(countable) An anchor is a large heavy weight, attached to a boat by a rope and dropped to the bottom of the water, to hold the boat in place."}]},{"p":"verb","d":[{"m":"If you anchor something, you hold it in place with an anchor.","e":"We'll anchor the boat tonight so we don't go anywhere while we sleep."}]}]},"injure":{"h":"injure","i":"/ˈɪndʒɚ/","a":"en-us-injure.ogg","s":[{"p":"verb","d":[{"m":"Injure means to hurt someone or an animal; causing harm to a person or an animal."}]}]},"lake":{"h":"lake","i":"/leɪk/","a":"en-us-lake.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lake is a place with a lot of deep water. A lake not always have salt in it.","e":"We went swimming in the lake."}]}]},"pond":{"h":"pond","i":"/pɒnd/","a":"en-us-pond.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pond is a small body of water."}]}]},"wade":{"h":"wade","i":"/weɪd/","a":"en-us-wade.ogg","s":[{"p":"verb","d":[{"m":"If you wade, you walk in water.","e":"I waded into the water just a little ways so that I could feel the temperature of the water."}]}]},"alligator":{"h":"alligator","i":"/ˈælɪgeɪtə/","a":"en-us-alligator.ogg","s":[{"p":"noun","d":[{"m":"(countable) An alligator is a large reptile that lives on land and in water."}]}]},"crocodile":{"h":"crocodile","i":"/ˈkrɒkədaɪl/","a":"LL-Q1860 (eng)-Vealhurl-crocodile.wav","s":[{"p":"noun","d":[{"m":"(countable) A crocodile is a big reptile that lives mostly in water."}]}]},"anywhere":{"h":"anywhere","i":"/ˈɛn.iː.weɘ(r)/","a":"en-us-anywhere.ogg","s":[{"p":"determiner","d":[{"m":"(in, at or to) any place","e":"I don't have anywhere to go."}]}]},"arc":{"h":"arc","i":"/ɑːk/","a":"en-us-arc.ogg","s":[{"p":"noun","d":[{"m":"(countable) An arc is part of a circle."},{"m":"(countable) An arc is that is jumping from one place to another. This is very bright and looks like lightning."}]},{"p":"verb","d":[{"m":"(intransitive) If something arcs, it makes an electrical curve."},{"m":"(intransitive) If something arcs, it goes along a curved path."}]}]},"weiner":{"h":"weiner","s":[{"p":"noun","d":[{"m":"A common misspelling of wiener."}]}]},"alligators":{"h":"alligators","i":"/ˈæ.lɪ.ɡeɪ.təz/","l":"alligator","q":"noun"},"crocodiles":{"h":"crocodiles","l":"crocodile","q":"noun"},"healers":{"h":"healers","l":"healer","q":"noun"},"lockers":{"h":"lockers","l":"locker","q":"noun"},"semantics":{"h":"semantics","i":"/sɪˈmæntɪks/","a":"LL-Q1860 (eng)-Vealhurl-semantics.wav","s":[{"p":"noun","d":[{"m":"Semantics is the study of how languages (ways people talk) show meaning.","e":"We were studying the difference of semantics for both words and sentence between cultures."},{"m":"If an argument is based on semantics it is based on different meanings of words, not different ideas. Or, someone might use different meanings to be difficult.","e":"I've heard you talking about it, and it sound like its all semantics to me."}]}]},"semantic":{"h":"semantic","i":"/sɪˈmæntɪk/","a":"en-au-semantic.ogg","s":[{"p":"adjective","d":[{"m":"If something is semantic it is based on semantics. It is about meaning in language.","e":"Were his errors semantic, like calling a horse a deer or a saddle? Or were they based on the sound of the word?"}]}]},"conjugation":{"h":"conjugation","i":"/ˌkɒnd͡ʒəˈɡeɪʃən/","a":"en-us-conjugation.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Conjugation is how a word changes based on several things. In English and European languages this word is usually a verb. It might change because of what time is talked about, who is talked about, or what part of the sentence the word is in.","e":"I find German conjugation hard to remember."},{"m":"(countable) A conjugation is the ways a word changes.","e":"The conjugations of \"to do\" are \"does,\" \"did,\" and \"doing.\""}]}]},"conjugate":{"h":"conjugate","i":"/ˈkɒndʒəɡeɪt/","a":"LL-Q1860 (eng)-Vealhurl-conjugate.wav","s":[{"p":"verb","d":[{"m":"If you conjugate a word, you change it because of time, person, or place in a sentence.","e":"If you don't conjugate right, people may still understand you but they will think you talk funny."}]}]},"practical":{"h":"practical","i":"/ˈpræktɪkəl/","a":"en-us-practical.ogg","s":[{"p":"adjective","d":[{"m":"If something is practical, it works and is not more difficult that it should be. It makes sense and is good for real life."},{"m":"If something is practical, it comes from actually doing something, not from theory."},{"m":"If you are practical, you do practical things and think in a practical way."}]}]},"pragmatics":{"h":"pragmatics","s":[{"p":"noun","d":[{"m":"Pragmatics is the study of how language is used in real life. It is about practical language use.","e":"Examples of English pragmatics included saying, \"Could I have a cookie?\" or \"Those cookies look good,\" to mean \"Give me a cookie.\""}]}]},"spread":{"h":"spread","i":"/'sprɛd/","a":"en-us-spread.ogg","l":"spread","q":"verb","s":[{"p":"verb","d":[{"m":"If you spread something, you make it cover a larger area.","e":"I spread butter on my bread."},{"m":"If something spreads, the area it covers gets larger.","e":"The spilled water spread over the table."},{"m":"If you spread two or more things, you move them away from each other.","e":"She spread her arms as wide as she could."}]},{"p":"noun","d":[{"m":"(countable) A spread is something you put on food. and mayonnaise are spreads."},{"m":"(countable) A spread is a piece of cloth you put over furniture. For one, a \"bed spread\"."},{"m":"(countable) A spread is a large amount of something spread in front of you. This is most often food of many types."},{"m":"(countable) A spread is a large plot of land used for farming or ranching."}]}]},"spreads":{"h":"spreads","a":"en-us-spreads.ogg","l":"spread","q":"verb"},"spreading":{"h":"spreading","l":"spread","q":"verb"},"republic":{"h":"republic","i":"/rɪˈpʌb.lɪk/","a":"en-us-republic.ogg","s":[{"p":"noun","d":[{"m":"A republic is a country that has leaders elected that are by the people.","e":"Many have pointed out that the United States is a republic, not a pure democracy."}]}]},"align":{"h":"align","i":"/əˈlaɪn/","a":"LL-Q1860 (eng)-Vealhurl-align.wav","s":[{"p":"verb","d":[{"m":"If you align some things, you make them point the same direction."},{"m":"If you align with another person or group, you are on the same side; you become allies.","e":"Japan decided to align itself with Germany in World War II."}]}]},"album":{"h":"album","i":"/ˈælbəm/","a":"LL-Q1860 (eng)-Vealhurl-album.wav","s":[{"p":"noun","d":[{"m":"(countable) An album is a record, tape, or CD, with many songs on it.","e":"He loved the Beatles, and had bought all their albums."},{"m":"(countable) An album is a book for keeping photographs.","e":"She loved to look through the family photo album and see her childhood pictures."},{"m":"(countable) An album is a book for keeping collectable things like stamps or coins.","e":"He put his new coin straight into the album to keep it safe."}]}]},"roman":{"h":"Roman","i":"/ˈrəʊm.ən/","a":"en-us-Roman.ogg","s":[{"p":"proper noun","d":[{"m":"(countable) A person from Rome or the Roman Empire."}]},{"p":"adjective","d":[{"m":"From the city of Rome."},{"m":"From the Roman Empire."},{"m":"Similar to something from Rome or the Roman Empire."}]}]},"composer":{"h":"composer","i":"/kəmˈpoʊzər/","a":"en-us-composer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A composer is a person who writes music."}]}]},"singer":{"h":"singer","i":"/ˈsɪŋə/","a":"en-us-singer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A singer is someone who sings.","e":"She is a very good singer."}]}]},"york":{"h":"York","i":"/jɔ:k/","a":"en-uk-York.ogg","s":[{"p":"proper noun","d":[{"m":"York is a city in England."}]}]},"empire":{"h":"empire","i":"/ˈɛmpaɪə/","a":"en-us-empire.ogg","s":[{"p":"noun","d":[{"m":"(countable) An empire is a large country that has taken control of many other countries."},{"m":"(countable) An empire is a country led by an emperor or empress."},{"m":"(countable) An empire is a large amount of property and power that a person might have.","e":"No mater how rich he got, he kept trying to build his empire bigger."}]}]},"japanese":{"h":"Japanese","i":"/ˌʤæpəˈniːz/","a":"en-us-Japanese.ogg","s":[{"p":"adjective","d":[{"m":"If something is Japanese, it comes from Japan.","e":"I had a Japanese car once."},{"m":"If something is Japanese, it is typical of Japan.","e":"I like Japanese food."}]},{"p":"proper noun","d":[{"m":"Japanese is the language that is spoken in Japan."}]}]},"pope":{"h":"pope","i":"/pəʊp/","a":"en-us-pope.ogg","s":[{"p":"noun","d":[{"m":"(often capitalized) The pope is the leader of the Roman Catholic Church."}]}]},"named":{"h":"named","i":"/neɪmd/","a":"LL-Q1860 (eng)-Back ache-named.wav","l":"name","q":"verb","s":[{"p":"verb","d":[{"m":"What you are named is what people call you."}]}]},"names":{"h":"names","a":"en-us-names.ogg","l":"name","q":"noun"},"naming":{"h":"naming","l":"name","q":"verb"},"emperor":{"h":"emperor","i":"/ˈɛmpərə/","a":"en-us-emperor.ogg","s":[{"p":"noun","d":[{"m":"(countable) An emperor is the male leader or monarch of an empire.","e":"The coronation of the Japanese emperor happened this year."}]}]},"empress":{"h":"empress","i":"/ˈɛmprəs/","a":"en-us-empress.ogg","s":[{"p":"noun","d":[{"m":"(countable) An empress is the female leader or monarch of an empire."},{"m":"(countable) An empress is the wife of an emperor."}]}]},"dictator":{"h":"dictator","i":"/dɪkˈteɪtə(r)/","a":"en-us-dictator.ogg","s":[{"p":"noun","d":[{"m":"(countable) A leader of a country who has total control over everything.","e":"Hitler was a terrible dictator."},{"m":"(countable) Someone who dictates (tell others what to write or what to do).","e":"It would take a very good secretary to follow such a bad dictator."}]}]},"chinese":{"h":"Chinese","i":"/tʃaɪˈniːz/","a":"en-us-Chinese.ogg","s":[{"p":"adjective","d":[{"m":"If something is Chinese, it comes from China.","e":"Many Chinese goods are sold in the U.S."},{"m":"If something is Chinese, it is typical of China.","e":"I like Chinese food."}]},{"p":"noun","d":[{"m":"(countable) A person from China or of Chinese descent."}]},{"p":"proper noun","d":[{"m":"Chinese is any of the languages (ways people talk) in China.","e":"Mandarin, Hokkien, and Cantonese are forms of Chinese."}]}]},"trail":{"h":"trail","i":"/treɪl/","a":"en-us-trail.ogg","s":[{"p":"noun","d":[{"m":"(countable) A trail is a way to get to a place, usually made of dirt and used by hikers or horse riders.","e":"That trail leads into the woods."},{"m":"(countable) A trail is a path that is followed by a hunter."}]},{"p":"verb","d":[{"m":"(transitive) If you trail someone, you follow that person.","e":"If you don't know the way you can trail me when I go."},{"m":"(transitive) If you trail something, you drag it or drop it behind you."},{"m":"(transitive) If you leave a trail of something, you leave material behind as you move.","e":"The snail left a trail of slime."}]}]},"audit":{"h":"audit","i":"/ˈɔː.dɪt/","a":"en-us-audit.ogg","s":[{"p":"noun","d":[{"m":"(countable) An audit is an when something is examined by an independent person or group."}]},{"p":"verb","d":[{"m":"If you audit something you examine it, and it is not yours."}]}]},"dirt":{"h":"dirt","i":"/dɜːt/","a":"en-us-dirt.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Dirt is what the ground (land) is made of."},{"m":"(countable) A dirt is a spot that is dirty on clothes and makes it look ugly."}]}]},"dictate":{"h":"dictate","i":"/ˈdɪkˌteɪt/","a":"LL-Q1860 (eng)-Vealhurl-dictate.wav","s":[{"p":"verb","d":[{"m":"If you dictate a document (something written), you say the words so another person can write or type them.","e":"I dictated the letter to my secretary."},{"m":"If X dictates Y, X requires Y, or X causes Y.","e":"Circumstances dictate that we must be ready to fight."}]}]},"dictation":{"h":"dictation","i":"/dɪkˈteɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-dictation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) The act of; telling someone else what to write or type.","e":"Can you take dictation?"},{"m":"(uncountable) The words you tell someone to write or type.","e":"You need to slow down so I can take your dictation?"}]}]},"biology":{"h":"biology","i":"/baɪˈɒl.ə.d͡ʒɪ/","a":"en-us-biology.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Biology is a type of science that studies living things like plants and animals.","e":"It is required for students to study biology."},{"m":"(countable) The biology of an animal, plant, or other living thing is how its body works.","e":"The biology of cats is different from that of dogs in several ways."}]}]},"botany":{"h":"botany","i":"/ˈbɒtənɪ/","a":"en-us-botany.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Botany is the science of learning about plants.","e":"My mother studied botany in college."}]}]},"visions":{"h":"visions","l":"vision","q":"noun"},"dictators":{"h":"dictators","l":"dictator","q":"noun"},"empresses":{"h":"empresses","l":"empress","q":"noun"},"hoofs":{"h":"hoofs","l":"hoof","q":"noun"},"hooves":{"h":"hooves","a":"en-us-hooves.ogg","l":"hoof","q":"noun"},"hoofed":{"h":"hoofed","l":"hoof","q":"verb"},"hoofing":{"h":"hoofing","l":"hoof","q":"verb"},"dirtier":{"h":"dirtier","l":"dirty","q":"adjective"},"dirtiest":{"h":"dirtiest","l":"dirty","q":"adjective"},"conjugations":{"h":"conjugations","l":"conjugation","q":"noun"},"nicotine":{"h":"nicotine","i":"/ˈnɪkətiːn/","a":"LL-Q1860 (eng)-Vealhurl-nicotine.wav","s":[{"p":"noun","d":[{"m":"Nicotine is a chemical in tobacco that might make you want to smoke.","e":"I needed to smoke because I was addicted to nicotine."}]}]},"rot":{"h":"rot","i":"[rɑt]","a":"en-us-rot.ogg","s":[{"p":"verb","d":[{"m":"If something rots it spoils. Rotting is how something turns into dirt (soil) because of bacteria and fungus.","e":"We threw out the fruit that rots."}]},{"p":"noun","d":[{"m":"(uncountable), Rot is material is decaying (rotting) and has decayed (rotted) a lot already.","e":"The log was full of rot so it broke easily."},{"m":"(uncountable), Rot is the act of decaying (rotting).","e":"We put our food in the freezer to avoid rot."}]}]},"spoil":{"h":"spoil","i":"/spɔɪl/","a":"en-us-spoil.ogg","s":[{"p":"verb","d":[{"m":"If something spoils it becomes no good. This is often due to rotting.","e":"If found my lunch was spoiled."},{"m":"If you spoil something, you ruin it, you make it no good.","e":"I think I spoiled my presentation by forgetting my data."},{"m":"If you spoil your child, you overpamper them and harm the character of them."}]}]},"decay":{"h":"decay","i":"/dɪˈkeɪ/","a":"LL-Q1860 (eng)-Vealhurl-decay.wav","s":[{"p":"verb","d":[{"m":"If something decays it rots.","e":"The body decayed."},{"m":"If something decays it gets weaker and is destroyed slowly.","e":"Their empire decayed because the leaders were fools."},{"m":"If something decays it fades away."}]},{"p":"noun","d":[{"m":"(uncountable) Decay is the act of decaying.","e":"Nothing could stop the decay at the time."},{"m":"(uncountable) Decay is material (stuff) that is decaying or has decayed.","e":"My teeth were full of decay."}]}]},"decompose":{"h":"decompose","i":"/ˌdiːkəmˈpəʊz/","a":"LL-Q1860 (eng)-Vealhurl-decompose.wav","s":[{"p":"verb","d":[{"m":"If something decomposes it changes back into what it was made from. The things it was made from separate from each other. This things are most often chemicals."},{"m":"If you decompose something you separate the things it was made from. You change it back into those things.","e":"Water can be decomposed into hydrogen and oxygen."},{"m":"If something decomposes it rots."}]}]},"decomposition":{"h":"decomposition","i":"/diːˌkɒmpəˈzɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-decomposition.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Decomposition is the act of."}]}]},"interact":{"h":"interact","i":"/ɪn.tɜː(r).ækt/","a":"LL-Q1860 (eng)-Vealhurl-interact.wav","s":[{"p":"verb","d":[{"m":"If you interact with someone or something, you communicate or work with someone or something else."}]},{"p":"noun","d":[{"m":"A short act or piece between others, as in a play; an interlude."}]}]},"actions":{"h":"actions","i":"/ˈæk.ʃənz/","a":"en-us-actions.ogg","l":"action","q":"noun"},"yellower":{"h":"yellower","l":"yellow","q":"adjective"},"yellowest":{"h":"yellowest","l":"yellow","q":"adjective"},"denser":{"h":"denser","l":"dense","q":"adjective"},"densest":{"h":"densest","l":"dense","q":"adjective"},"ash":{"h":"ash","i":"/æʃ/","a":"en-us-ash.ogg","s":[{"p":"noun","d":[{"m":"Ashes are what is left of something after it has burned (been destroyed by fire).","e":"The was nothing left of the wood but ashes."},{"m":"(uncountable) Ash is a light gray color. The color of wood ashes.","e":"My sister loved to wear ash-gray cloths."},{"m":"(countable) An ash is a type of tree.","e":"I had an ash growing in my yard."},{"m":"The letter Æ (capital) / æ (lower case). This letter is not used often in modern English. It is found in Old English and some other languages, and is an IPA symbol."}]}]},"ashes":{"h":"ashes","i":"/ˈæʃ.ɪz/","a":"en-us-ashes.ogg","l":"ash","q":"noun"},"rawer":{"h":"rawer","l":"raw","q":"adjective"},"rawest":{"h":"rawest","l":"raw","q":"adjective"},"spoils":{"h":"spoils","i":"/spɔɪlz/","a":"en-us-spoils.ogg","l":"spoil","q":"verb","s":[{"p":"noun","d":[{"m":"The spoils of something (such as a war) are what winners take from losers."}]}]},"councils":{"h":"councils","a":"en-us-councils.ogg","l":"council","q":"noun"},"acceleration":{"h":"acceleration","i":"/ək.sɛl.əˈreɪ.ʃən/","a":"en-us-acceleration.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Acceleration is a change in speed.","e":"As the plane took off, the acceleration pressed her into her seat."},{"m":"(countable) Acceleration is by how much a speed or velocity goes up."},{"m":"for velocity, has formula a=\\lim_{\\Delta x \\to 0}\\frac{\\Delta v}{\\Delta t}."}]}]},"accelerations":{"h":"accelerations","l":"acceleration","q":"noun"},"stallion":{"h":"stallion","i":"/ˈstæli.ən/","a":"en-us-stallion.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stallion is a male horse that is not castrated.","e":"We are mating our stallion with our mare."}]}]},"stallions":{"h":"stallions","l":"stallion","q":"noun"},"familiarise":{"h":"familiarise","i":"/fəˈmɪliəraɪ̯z/","a":"LL-Q1860 (eng)-Vealhurl-familiarize.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you familiarise, you make yourself or someone else familiar with something.","e":"You need to familiarise yourself with the rules so you won't have to look them up later."}]}]},"familiarises":{"h":"familiarises","l":"familiarise","q":"verb"},"familiarised":{"h":"familiarised","l":"familiarise","q":"verb"},"familiarising":{"h":"familiarising","l":"familiarise","q":"verb"},"blackboard":{"h":"blackboard","i":"/ˈblækbɔrd/","a":"en-us-blackboard.ogg","s":[{"p":"noun","d":[{"m":"(countable) A blackboard is a large, flat piece of slate, typically hung in a classroom and written on with erasable chalk.","e":"The teacher wrote the day's lesson on the blackboard."}]}]},"opera":{"h":"opera","i":"/ˈɒp.ər.ə/","a":"en-us-opera.ogg","s":[{"p":"noun","d":[{"m":"(countable) An opera is a story told by actors singing instead of speaking, along with an orchestra.","e":"The couple dressed up to go hear their favorite opera at the theatre."}]}]},"measures":{"h":"measures","a":"en-us-measures.ogg","l":"measure","q":"verb"},"measured":{"h":"measured","i":"/ˈmɛʒɚd/","a":"LL-Q1860 (eng)-Vealhurl-measured.wav","l":"measure","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is measured, it has been determined by measurement.","e":"He ran over a measured mile."},{"m":"Something that is measured is deliberate but restrained.","e":"He argued in measured tones."},{"m":"(of poetry etc) written in meter; metrical."}]}]},"measuring":{"h":"measuring","l":"measure","q":"verb"},"hermaphrodites":{"h":"hermaphrodites","l":"hermaphrodite","q":"noun"},"stickier":{"h":"stickier","l":"sticky","q":"adjective"},"stickiest":{"h":"stickiest","l":"sticky","q":"adjective"},"returns":{"h":"returns","i":"/rɪˈtɜːnz/","a":"en-us-returns.ogg","l":"return","q":"verb","s":[{"p":"noun","d":[{"m":"The returns on an investment are the profits earned from it.","e":"This year's returns are the highest ever."},{"m":"Returns are items that customers bring or send back because they are unwanted, broke, or don't fit.","e":"Our returns policy allows for returns within 30 days of purchase."},{"m":"If you wish someone many happy returns, you wish them a happy birthday and a long life.","e":"She wished him many happy returns on his 50th birthday."}]}]},"returned":{"h":"returned","i":"/rɪˈtɜːnd/","a":"en-us-returned.ogg","l":"return","q":"verb"},"returning":{"h":"returning","i":"/rɪˈtɜːnɪŋ/","a":"en-us-returning.ogg","l":"return","q":"verb"},"presumes":{"h":"presumes","l":"presume","q":"verb"},"presuming":{"h":"presuming","l":"presume","q":"verb"},"hundreds":{"h":"hundreds","a":"en-us-hundreds.ogg","l":"hundred","q":"noun","s":[{"p":"noun","d":[{"m":"(informal) \"Hundreds\" is used to refer to lots of something.","e":"There's hundreds of cool stuff I can do!"}]}]},"flatter":{"h":"flatter","i":"/ˈflætɚ/","a":"en-us-flatter.ogg","l":"flat","q":"adjective","s":[{"p":"verb","d":[{"m":"To compliment someone, sometimes insincerely and sometimes to win favour."},{"m":"To enhance someone's vanity by giving them praise."},{"m":"To portray something in a nice way."}]}]},"flattest":{"h":"flattest","l":"flat","q":"adjective"},"flattering":{"h":"flattering","i":"/ˈflætərɪŋ/","a":"en-us-flattering.ogg","l":"flatter","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is flattering, it makes you look good; attractive.","e":"The dress really did not look very flattering on her figure."}]}]},"flatters":{"h":"flatters","l":"flatter","q":"verb"},"flattered":{"h":"flattered","a":"en-us-flattered.ogg","l":"flatter","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are flattered, a comment or action has made you feel good about yourself.","e":"I'm flattered that you called to offer me a job so soon, but I would be more flattered if it were a job in management instead of production."}]}]},"doctored":{"h":"doctored","a":"en-us-doctored.ogg","l":"doctor","q":"verb"},"doctoring":{"h":"doctoring","l":"doctor","q":"verb"},"layers":{"h":"layers","i":"/ˈleɪ.əz/","a":"en-us-layers.ogg","l":"layer","q":"noun"},"layered":{"h":"layered","l":"layer","q":"verb"},"layering":{"h":"layering","l":"layer","q":"verb"},"boxes":{"h":"boxes","i":"/ˈbɑksɪz/","a":"en-us-boxes.ogg","l":"box","q":"noun"},"boxed":{"h":"boxed","i":"/bɒkst/","l":"box","q":"verb"},"floored":{"h":"floored","l":"floor","q":"verb"},"flooring":{"h":"flooring","i":"/ˈflɔːrɪŋ/","a":"LL-Q1860 (eng)-Wodencafe-flooring.wav","l":"floor","q":"verb","s":[{"p":"noun","d":[{"m":"Flooring is any material that is used to make floors."}]}]},"jumps":{"h":"jumps","l":"jump","q":"verb"},"jumping":{"h":"jumping","l":"jump","q":"verb"},"belted":{"h":"belted","l":"belt","q":"verb"},"belting":{"h":"belting","l":"belt","q":"verb"},"demonstrates":{"h":"demonstrates","l":"demonstrate","q":"verb"},"demonstrated":{"h":"demonstrated","l":"demonstrate","q":"verb"},"demonstrating":{"h":"demonstrating","l":"demonstrate","q":"verb"},"canada":{"h":"Canada","i":"/ˈkænədə/","a":"en-ca-Canada.ogg","s":[{"p":"proper noun","d":[{"m":"Canada is a country in North America. Canada is north of the United States.","e":"There are 10 provinces and 3 in Canada."}]}]},"blackboards":{"h":"blackboards","l":"blackboard","q":"noun"},"gelding":{"h":"gelding","i":"/ˈɡɛldɪŋ/","a":"LL-Q1860 (eng)-Persent101-gelding.wav","s":[{"p":"noun","d":[{"m":"(countable) A gelding is a castrated male horse.","e":"Our gelding is much easier to ride than our stallion."}]}]},"geldings":{"h":"geldings","l":"gelding","q":"noun"},"mare":{"h":"mare","i":"/mɛː/","a":"en-us-mare.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mare is a female horse.","e":"We are mating our stallion with our mare."}]}]},"mares":{"h":"mares","l":"mare","q":"noun"},"foal":{"h":"foal","i":"/fəʊl/","a":"en-us-foal.ogg","s":[{"p":"noun","d":[{"m":"(countable) A foal is a baby horse.","e":"Our mare had a foal last year."}]}]},"foals":{"h":"foals","l":"foal","q":"noun"},"terminals":{"h":"terminals","l":"terminal","q":"noun"},"megaton":{"h":"megaton","i":"/ˈmɛgəˌtʌn/","s":[{"p":"noun","d":[{"m":"(countable) A megaton is a unit that is used to determine how strong an explosion made by a bomb is. The unit is based upon how many million tons of TNT it would take to make a similar explosion."}]}]},"fuchsias":{"h":"fuchsias","l":"fuchsia","q":"noun"},"adders":{"h":"adders","l":"adder","q":"noun"},"prostitution":{"h":"prostitution","i":"/ˌprɒstɪˈtʃuːʃn/","a":"en-us-prostitution.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) When people use money to buy sex.","e":"She was arrested for prostitution."}]}]},"prostitute":{"h":"prostitute","i":"/ˈprɒstɪtjuːt/","a":"en-us-prostitute.ogg","s":[{"p":"noun","d":[{"m":"(countable) A prostitute is someone who has sex with people for money."}]},{"p":"verb","d":[{"m":"If you prostitute (yourself), you take money to have sex with people.","e":"I'm not desperate enough to prostitute myself yet."},{"m":"If you prostitute another person, you force them to have sex with other people for money.","e":"He was arrested for prostituting his own daughter."}]}]},"prostitutes":{"h":"prostitutes","l":"prostitute","q":"noun"},"theft":{"h":"theft","i":"/θɛft/","a":"LL-Q1860 (eng)-Vealhurl-theft.wav","s":[{"p":"noun","d":[{"m":"A theft is when someone steals something.","e":"We were the victims of a theft last year."}]}]},"rape":{"h":"rape","i":"/reɪp/","a":"en-au-rape.ogg","s":[{"p":"noun","d":[{"m":"Rape is when someone has sex with a person who does not want to have sex.","e":"6 years ago my ex-boyfriend raped me, and I had to call the police."},{"m":"Rape is when a man has sexual intercourse with a woman against her will."}]},{"p":"verb","d":[{"m":"If a person rapes someone, he or she makes the other person have involuntary sex with him or her."}]}]},"megatons":{"h":"megatons","l":"megaton","q":"noun"},"thief":{"h":"thief","i":"/θiːf/","a":"en-us-thief.ogg","s":[{"p":"noun","d":[{"m":"(countable) A thief is a person who steals."}]}]},"thieves":{"h":"thieves","i":"/θiːvz/","a":"en-us-thieves.ogg","l":"thief","q":"noun"},"misdemeanor":{"h":"misdemeanor","i":"/ˌmɪsdɪˈmiːnə(r)/","a":"LL-Q1860 (eng)-Vealhurl-misdemeanor.wav","s":[{"p":"noun","d":[{"m":"(countable) A misdemeanor is a crime that is not serious.","e":"Back in Michigan he pleaded guilty to a misdemeanor assault charge in a domestic violence case and was given probation."}]}]},"felony":{"h":"felony","i":"/ˈfɛ.lə.ni/","a":"LL-Q1860 (eng)-Vealhurl-felony.wav","s":[{"p":"noun","d":[{"m":"(countable) A felony is a serious crime; this is something a person can be put in prison for.","e":"Somethings that might be called felonies are robbery, rape, murder, treason, threats, spousal abuse, child abuse, or sexually molesting a child."}]}]},"felon":{"h":"felon","i":"/ˈfɛlən/","a":"LL-Q1860 (eng)-Vealhurl-felon.wav","s":[{"p":"noun","d":[{"m":"(countable) A felon is a person who has committed a felony or been convicted of a felony."}]}]},"thieve":{"h":"thieve","i":"/θiːv/","a":"LL-Q1860 (eng)-Vealhurl-thieve.wav","s":[{"p":"verb","d":[{"m":"(intransitive) If you thieve, you rob something; you make a theft."}]}]},"protector":{"h":"protector","i":"/prəˈtɛktɚ/","a":"en-us-protector.ogg","s":[{"p":"noun","d":[{"m":"(countable) A protector is someone that protects or guards something. This can be either because of a job, or as their own decision."},{"m":"(countable) A protector is a device that is made to protect something."},{"m":"(countable) A protector is someone who stops interference."}]}]},"protectors":{"h":"protectors","l":"protector","q":"noun"},"dynamite":{"h":"dynamite","i":"/ˈdaɪnəmaɪt/","a":"en-au-dynamite.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) A type of explosive; dynamite is nitroglycerin mixed in special clay (dirt).","e":"They used dynamite to blast the rock from the mountain."},{"m":"(by extension) If something is dynamite is it is very exciting or dangerous."}]},{"p":"verb","d":[{"m":"To blow up something using dynamite.","e":"That building was dynamited last week and as soon as the rubble is cleared they are going to begin rebuilding."}]}]},"explosive":{"h":"explosive","i":"/ɪkˈspləʊsɪv/","a":"en-au-explosive.ogg","s":[{"p":"noun","d":[{"m":"An explosive is a material that explodes and is used to make explosions."}]},{"p":"adjective","d":[{"m":"If something is explosive, it can explode easily."},{"m":"If something is explosive, it is become dangerous or bad easily."},{"m":"If something is explosive, it is very exciting."}]}]},"explosion":{"h":"explosion","i":"/ɪkˈspləʊ.ʒən/","a":"en-us-explosion.ogg","s":[{"p":"noun","d":[{"m":"(countable) An explosion is when something explodes.","e":"The explosion destroyed the building."}]}]},"clay":{"h":"clay","i":"/kleɪ/","a":"en-us-clay.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Clay is a type of mud or dirt that can be made into bricks and pots."}]}]},"mud":{"h":"mud","i":"/mʌd/","a":"en-us-mud.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Mud is dirt (soil) with water in it.","e":"I slipped and fell in the mud."}]}]},"nitroglycerin":{"h":"nitroglycerin","s":[{"p":"noun","d":[{"m":"(uncountable) Nitroglycerin is a type of explosive that is made by mixing nitric acid and glycerol."},{"m":"(uncountable) Nitroglycerin is a medicine used by people with heart disease."}]}]},"axis":{"h":"axis","i":"/æxɪs/","a":"en-us-axis.ogg","s":[{"p":"noun","d":[{"m":"An axis is the imaginary line that an object spins around. This is the middle of the circle of the turn, and at a right angle to it.","e":"The Earth rotates once a day on its axis."},{"m":"The second cervical vertebra of the spine."}]}]},"chemistry":{"h":"chemistry","i":"/ˈkɛm.ɪ.stri/","a":"en-us-chemistry.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Chemistry is the science that studies matter (material).","e":"We studied acids in chemistry."},{"m":"(uncountable) Chemistry is when someone likes, or is attracted to someone else, but does not know why.","e":"We had perfect chemistry since we first met."},{"m":"(countable) Something's chemistry is how it works in a chemical way.","e":"My body chemistry may be different from yours."}]}]},"crying":{"h":"crying","i":"/kraɪ̯.ɪŋ/","a":"en-us-crying.ogg","l":"cry","q":"verb"},"chemistries":{"h":"chemistries","l":"chemistry","q":"noun"},"clays":{"h":"clays","l":"clay","q":"noun"},"explosions":{"h":"explosions","l":"explosion","q":"noun"},"portrait":{"h":"portrait","i":"/ˈpɔːtrɪt/","a":"en-us-portrait.ogg","s":[{"p":"noun","d":[{"m":"(countable) A portrait is a painting or picture of a person's head and shoulders.","e":"The portrait of the former queen sold for several million dollars."},{"m":"(printing) If you print something in the portrait setting, whatever is printed will have a shorter width and a larger height."}]}]},"pi":{"h":"pi","i":"/paɪ/","a":"en-us-pie.ogg","s":[{"p":"noun","d":[{"m":"Pi is a Greek letter written \"π\"."},{"m":"Pi is a number that is found by dividing the circumference of a circle by its diameter. Pi is constant, it is always the same (close to 3.14159, also accurate approx as \\tfrac{355}{113}, or rough approx as \\tfrac{22}{7}). It is usually written as \"π\"","e":"The distance around a circle is twice the radius times pi; C = 2πr."}]}]},"radian":{"h":"radian","i":"/ˈreɪdiən/","a":"LL-Q1860 (eng)-Vealhurl-radian.wav","s":[{"p":"noun","d":[{"m":"(countable) We sometimes measure an angle using radians. All the way around a circle is 2π radians."}]}]},"axes":{"h":"axes","i":"/ˈæk.sɪz/","l":"axe","q":"verb"},"axe":{"h":"axe","i":"/æks/","a":"en-us-axe.ogg","s":[{"p":"noun","d":[{"m":"(countable) An axe is a tool made from a short blade on a long handle. Axes are often used to cut wood."}]},{"p":"verb","d":[{"m":"(transitive) If you axe something, you chop it with an axe."},{"m":"(transitive) If you axe something, you end or reduce it in a sudden or mean way.","e":"The government announced its plans to axe public spending."},{"m":"(transitive) If you axe someone, you fire a person from their job.","e":"He got axed in the last round of firings."}]}]},"hulls":{"h":"hulls","l":"hull","q":"noun"},"hulled":{"h":"hulled","l":"hull","q":"verb"},"hulling":{"h":"hulling","l":"hull","q":"verb"},"camped":{"h":"camped","i":"/kæmpt/","l":"camp","q":"verb"},"camping":{"h":"camping","i":"/ˈkæmpɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-camping.wav","l":"camp","q":"verb","s":[{"p":"noun","d":[{"m":"(uncountable) Camping is the recreational activity of temporarily living in a tent.","e":"Camping is a favorite summer activity."}]}]},"tent":{"h":"tent","i":"/tent/","a":"en-us-tent.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tent is similar to a house or building that is made of cloth or skins.","e":"We slept in a tent all week."}]},{"p":"verb","d":[{"m":"(intransitive) (informal) If you tent, you camp in a tent."}]}]},"tents":{"h":"tents","i":"/tɛnts/","a":"en-us-tents.ogg","l":"tent","q":"noun"},"web-site":{"h":"web-site","i":"/ˈwɛbˌsaɪt/","a":"LL-Q1860 (eng)-Vealhurl-website.wav","s":[{"p":"noun","d":[{"m":"(countable) A web-site is a place on the World Wide Web; if there are many pages to a web-site, they have the same URL and are usually part of the same server.","e":"My favorite web-sites are ebay.com, espn.com, and facebook.com."}]}]},"crawl":{"h":"crawl","i":"/krɔ:l/","a":"en-us-crawl.ogg","s":[{"p":"verb","d":[{"m":"The way an animal or baby might walk. If something crawls, it walks on four or more legs. For a person, this means using the hands and arms like legs.","e":"I crawled through the tunnel."},{"m":"If something crawls, it moves slowly.","e":"Yesterday seemed so long, like time was crawling."},{"m":"If your skin crawls. you feel bugs are crawling over your body. This is often a way of saying you are afraid or disturbed.","e":"Just hearing about that makes my skin crawl."},{"m":"If a place is crawling with something, that thing covers that place.","e":"The club was crawling with people I'd like to meet."}]},{"p":"noun","d":[{"m":"A crawl is when something crawls on more than two legs.","e":"If was a long crawl though the bushes."},{"m":"If something is moving at a crawl, it is going slowly.","e":"We were making progress, but only at a crawl."},{"m":"The crawl is a way of swimming.","e":"The first stroke we learned in swimming class was the crawl."}]}]},"imaginary":{"h":"imaginary","i":"/ɪˈmædʒɪn(ə)ri/","a":"en-us-imaginary.ogg","s":[{"p":"adjective","d":[{"m":"If something is imaginary, it is not real. It is only exists in a person's mind.","e":"Characters in films and television are imaginary people."},{"m":"If a number is imaginary, it is the square root of a negative number. Imaginary one is written as i."}]}]},"exit":{"h":"exit","i":"/ˈɛgzɪt/","a":"en-us-exit.ogg","s":[{"p":"verb","d":[{"m":"If you exit you leave, you go to another place.","e":"Please wait until the lights are on to exit the theater."}]},{"p":"noun","d":[{"m":"An exit is a way out of a room or building. This usually means a door that people are expected to leave through.","e":"Excuse me. Do you know where the exit is?"},{"m":"An exit is a small road that takes you off a highway. This is often used for a way off the interstate roads in the United States.","e":"The store is just off exit 245."},{"m":"An exit is the act of leaving a place.","e":"He made a grand exit, bowing deeply before leaving the stage."}]}]},"bye":{"h":"bye","i":"/baɪ/","a":"en-us-bye.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bye is a position given to a player in a tournament when the match the player is supposed to play has no opposers playing against the player that gives them a free win."}]},{"p":"interjection","d":[{"m":"Short for goodbye; you say bye when you leave a person or people."}]}]},"goodbyes":{"h":"goodbyes","l":"goodbye","q":"noun"},"migrations":{"h":"migrations","l":"migration","q":"noun"},"politer":{"h":"politer","l":"polite","q":"adjective"},"politest":{"h":"politest","l":"polite","q":"adjective"},"hire":{"h":"hire","i":"/haɪə/","a":"en-us-hire.ogg","s":[{"p":"verb","d":[{"m":"If someone hires you, they agree to give you a job and pay you money.","e":"I was hired at Food City several years ago."}]},{"p":"noun","d":[{"m":"(countable) A person who has been hired.","e":"We pair up each of our new hires with one of our original hires."}]}]},"hiss":{"h":"hiss","i":"/hɪs/","a":"en-us-hiss.ogg","s":[{"p":"noun","d":[{"m":"A hiss is a sound often made by snakes or leaking air.","e":"You can tell the cat is angry by its hissing."}]},{"p":"verb","d":[{"m":"If something hisses, it makes a hissing sound.","e":"The air hissed as it left the tire."}]}]},"geology":{"h":"geology","i":"/d͡ʒiˈɑl.ə.dʒi/","a":"en-us-geology.ogg","s":[{"p":"noun","d":[{"m":"Geology is the science that studies the earth. In geology you might learn about how mountains are made or how continents move. This is sometimes used for similar things on other planets.","e":"Geology is not required for most students."}]}]},"geography":{"h":"geography","i":"/dʒɪˈɒgrəfi/","a":"en-us-geography.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Geography is how a place is on a map. It is about where things like rivers, mountains,, and are.","e":"I know the geography of the area because I once lived there."},{"m":"(uncountable) The study of maps and places.","e":"Our geography was pretty easy."}]}]},"good-looking":{"h":"good-looking","s":[{"p":"adjective","d":[{"m":"If someone or something is good-looking, it is looks attractive.","e":"That was a good-looking car you had."}]}]},"goldfish":{"h":"goldfish","i":"/ˈɡoʊldfɪʃ/","a":"en-us-goldfish.ogg","l":"goldfish","q":"noun","s":[{"p":"noun","d":[{"m":"(countable) A goldfish is a type of small fish that is orange, or orange and white.","e":"My pet goldfish died soon after I got it."}]}]},"gardener":{"h":"gardener","i":"/ˈɡɑrd.n̩.ɚ/","a":"en-us-gardener.ogg","s":[{"p":"noun","d":[{"m":"(countable) A gardener is a person who works in a garden to care for plants. This could also be someone who takes care of a yard that has many plants.","e":"The gardener planted several trees, watered the flowers, and trimmed the bushes."}]}]},"glacier":{"h":"glacier","i":"/ˈglæsiə/","a":"en-us-glacier.ogg","s":[{"p":"noun","d":[{"m":"(countable) A glacier is similar to a mountain or river made of ice."}]}]},"sailor":{"h":"sailor","i":"/ˈseɪlɚ/","a":"en-us-sailor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sailor is a person who works on a ship."}]}]},"volt":{"h":"volt","i":"/vɒlt/","a":"LL-Q1860 (eng)-Vealhurl-volt.wav","s":[{"p":"noun","d":[{"m":"(countable) A volt is the unit used to measure electric potential and electromotive force (voltage).","e":"This needs a 9 volt battery to work."}]}]},"voltage":{"h":"voltage","i":"/voʊltɪdʒ/","a":"LL-Q1860 (eng)-Vealhurl-voltage.wav","s":[{"p":"noun","d":[{"m":"; Voltage is an amount of electromotive force; a number of volts."}]}]},"afterthought":{"h":"afterthought","i":"/ˈæft.ɚ.θɔt/","a":"en-us-afterthought.ogg","s":[{"p":"noun","d":[{"m":"(countable) An afterthought is something that is thought about after an act; it was not thought of originally.","e":"She packed her sandals only as an afterthought, but she was glad she did."}]}]},"seaman":{"h":"seaman","i":"/ˈsiːmən/","a":"en-us-seaman.ogg","s":[{"p":"noun","d":[{"m":"(countable) A seaman is someone who works at sea, or on a boat.","e":"The seaman sailed from coast to coast."},{"m":"(countable) A seaman is the lowest rank in the United States navy."}]}]},"beds":{"h":"beds","i":"/bɛdz/","a":"en-us-beds.ogg","l":"bed","q":"noun"},"bedded":{"h":"bedded","l":"bed","q":"verb"},"dialogues":{"h":"dialogues","i":"/ˈdaɪælɒgz/","a":"LL-Q1860 (eng)-Vealhurl-dialogues.wav","l":"dialogue","q":"noun"},"equestrian":{"h":"equestrian","i":"/ɪˈkwɛstrɪən/","a":"LL-Q1860 (eng)-Vealhurl-equestrian.wav","s":[{"p":"adjective","d":[{"m":"Related to horseback riding or horseback riders.","e":"She will compete in a horse show to test her equestrian skills."},{"m":"Riding on the back of a horse.","e":"The equestrian soldiers rode down the hill into the battle."},{"m":"Showing a person sitting on the back of a horse.","e":"Children like to play among the metal legs of the equestrian statue in the park."}]},{"p":"noun","d":[{"m":"(countable) Someone who rides a horse.","e":"The equestrian brushed his horse before the race."}]}]},"capillary":{"h":"capillary","i":"/kəˈpɪləri/","a":"en-us-capillary.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tiny tube in the body that blood travels through. It connects the end of an artery to the beginning of a vein.","e":"Blood cells have to go through each tiny capillary one by one."}]},{"p":"adjective","d":[{"m":"Looking like a strand of hair.","e":"The capillary cracks in the old plate of glass made me think that it would break if I touched it."},{"m":"Having to do with a capillary.","e":"The body's capillary system must reach every cell."}]}]},"boycott":{"h":"boycott","i":"/ˈbɔɪkɒt/","a":"LL-Q1860 (eng)-Vealhurl-boycott.wav","s":[{"p":"verb","d":[{"m":"If you boycott something, then you stop using a product or buying from a store on purpose. People mainly boycott as a form of protest.","e":"When the newspapers reported that a major clothing company had used child labor, many people boycotted the company."}]},{"p":"noun","d":[{"m":"A boycott is when people stop using a product or stop buying from a store on purpose. Boycotting is a form of protest to prove a point and avoid buying things from companies that have done wrong.","e":"The boycott against fruit grown in foreign countries lasted two months."}]}]},"manganese":{"h":"manganese","i":"/ˈmæŋɡəniz/","a":"LL-Q1860 (eng)-Vealhurl-manganese.wav","s":[{"p":"noun","d":[{"m":"(uncountable)Manganese is a hard, fragile, gray metal that is an element on the periodic table with an atomic number of 25 and the symbol Mn. It is added to steel to make it stronger."}]}]},"harvestman":{"h":"harvestman","s":[{"p":"noun","d":[{"m":"A person who works in the fields to bring in the ripe crops.","e":"When the corn was ripe, the farmer hired extra harvestmen to help bring in the crop."},{"m":"An arachnid from the order Opiliones that has very long, thin legs."}]}]},"simplify":{"h":"simplify","i":"/ˈsɪmplɪfaɪ/","a":"LL-Q1860 (eng)-Vealhurl-simplify.wav","s":[{"p":"verb","d":[{"m":"If you simplify something, you make it easier; you make it less complex."}]}]},"blond":{"h":"blond","i":"/blɒnd/","a":"LL-Q1860 (eng)-Vealhurl-blond.wav","s":[{"p":"noun","d":[{"m":"(countable) A blond is a person with blond colored hair."},{"m":"(uncountable) Blond is a pale golden brown color."}]},{"p":"adjective","d":[{"m":"If something is blond, it is pale golden brown in color.","e":"He had blond hair."}]}]},"blonde":{"h":"blonde","i":"/blɒnd/","a":"LL-Q1860 (eng)-Vealhurl-blond.wav","s":[{"p":"noun","d":[{"m":"(countable) A blonde is someone who has fair (light colored) skin and hair and is usually a woman."},{"m":"(uncountable) Blonde is a light yellowish brown color."}]},{"p":"adjective","d":[{"m":"If hair is blonde, it is a color lighter than brown and not red. It may be yellow, golden, or almost white."},{"m":"If you are blonde, you have blonde hair."},{"m":"Blonde has been used to name other things the are a lighter color than usual.","e":"We made blonde brownies yesterday."},{"m":"A light color between yellow and brown."}]}]},"hero":{"h":"hero","i":"/hɪroʊ/","a":"en-us-hero.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hero is a person who is very brave and does great things. The hero may be real or not real, and often defeats dangerous of the people.","e":"The hero Hercules was said to have killed the nine head snake called \"hydra.\""},{"m":"(countable) Your hero is a person you greatly admire. This may also be someone you want to be similar to.","e":"Leonardo DaVinci used to be my hero."},{"m":"(countable) Your hero is someone who saves or defends you.","e":"\"Oh, my hero!\" she said to her rescuer."},{"m":"(countable) A hero is the main character in a story or film (movie).","e":"A female hero is a heroine."},{"m":"(countable), Short for hero sandwich."},{"m":"(countable) A good person with special powers; a superhero."}]}]},"blondie":{"h":"blondie","i":"/ˈblɑndi/","s":[{"p":"noun","d":[{"m":"A nickname for a blond person, usually this is a blond woman or girl.","e":"My name is Jenny, but most people just call me Blondie."},{"m":"Another word for blond brownie."}]}]},"nickname":{"h":"nickname","i":"/nɪk neɪm/","a":"LL-Q1860 (eng)-Vealhurl-nickname.wav","s":[{"p":"noun","d":[{"m":"(countable) A nickname is something people call you that is not your real name. This is often something your friends call you for fun, or that you call yourself.","e":"My name is James, but my friends call my Ferret -- that's my nickname."}]},{"p":"verb","d":[{"m":"If you nickname something, you give it a nickname.","e":"My boyfriend Charles is nicknamed Frosty because he loves winter."}]}]},"heroine":{"h":"heroine","i":"/ˈhɛroʊɪn/","a":"en-us-heroine.ogg","s":[{"p":"noun","d":[{"m":"(countable) A female hero."}]}]},"heroic":{"h":"heroic","i":"/hɪˈroʊ.ɪk/","a":"en-us-heroic.ogg","s":[{"p":"adjective","d":[{"m":"If something you do is heroic is like something a hero would do; it is very brave or difficult to do.","e":"To win while wounded was truly heroic."},{"m":"If you are heroic you are a hero or like a hero; you do heroic things.","e":"The soldiers who fought in World War II were heroic men."},{"m":"If story or poem is heroic, it is about a hero or heroes doing great things.","e":"\"Beowulf\" is the best known heroic epic of early British literature."},{"m":"(anthropology) If a society is heroic it is at a stage where stories of great heroes are common and wars are won by single heroic warriors. This is often a society with tribes or technology is bronze age or iron age.","e":"Comparisons have been made between the heroic societies of ancient Greece and modern heroic societies such as the Zulu."},{"m":"A heroic age is a time when great heroes were said to have lived. This is often early in history.","e":"Homer's heroic age was hundreds of years before Homer live, around 1000 B.C.E."}]}]},"heroism":{"h":"heroism","i":"/ˈhɛrəʊɪzəm/","a":"en-us-heroism.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Heroism is the act of doing something heroic.","e":"They showed true heroism by risking their lives to save us."},{"m":"(uncountable) Heroism is the quality of being heroic; if you have heroism you are a hero (or are similar to a hero).","e":"The heroism of firemen, who run into burning buildings for people they don't know, is inspiring."}]}]},"superhero":{"h":"superhero","i":"/s(j)upə(r)hɪroʊ/","a":"LL-Q1860 (eng)-Flame, not lame-superhero.wav","s":[{"p":"noun","d":[{"m":"(countable) (fiction) A superhero is a good person who has special powers and does heroic things.","e":"There have been many movies about superheroes in recent years."}]}]},"sandwich":{"h":"sandwich","i":"/ˈsæn(d)wɪd͡ʒ/","a":"en-us-sandwich.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sandwich is meat or other food between two pieces of bread."}]},{"p":"verb","d":[{"m":"To put one thing between two other things."}]}]},"sub":{"h":"sub","i":"/sʌb/","a":"en-us-sub.ogg","s":[{"p":"noun","d":[{"m":"(informal) Short for submarine."},{"m":"(informal) Short for submarine sandwich."},{"m":"(informal) Short for substitute."},{"m":"(informal), (UK) Short for subscription."},{"m":", (BDSM sex) Short for submissive."}]},{"p":"verb","d":[{"m":"(US), (informal) To substitute for.","e":"I subbed for an injured player during last night's game."},{"m":"(US), (informal) To work as a substitute teacher, especially in primary and secondary education.","e":"Now that I've retired from my full-time teaching job, I'll do some subbing from time to time to keep busy and earn a little extra money."},{"m":"(UK), (informal), (football) To replace (a player) with a substitute.","e":"He never really made a contribution to the match, so it was no surprise when he was subbed at half time."}]}]},"basement":{"h":"basement","i":"/beɪsmənt","a":"en-us-basement.ogg","s":[{"p":"noun","d":[{"m":"(countable) A basement is part of a house or building that is under the ground.","e":"After work I like to come home and relax in my basement."}]}]},"super":{"h":"super","i":"/ˈsupɚ/","a":"en-ca-super.ogg","s":[{"p":"adjective","d":[{"m":"If something is super it is better than average, better than usual."}]},{"p":"noun","d":[{"m":"(informal) of a building.","e":"We asked the super to fix our window last week but he still hasn't done it."},{"m":"Short for supervisor; a manager or boss.","e":"We were just talking to the super about the problem."}]},{"p":"interjection","d":[{"m":"You say super! if you are very happy or excited about something.","e":"You got the prize, super!"}]}]},"comic":{"h":"comic","i":"/ˈkɒmɪk/","a":"en-us-comic.ogg","s":[{"p":"noun","d":[{"m":"(countable) A comic is a person whose job is telling jokes or trying to be funny."},{"m":"(countable) Short for comic strip or comic book."}]}]},"villain":{"h":"villain","i":"/ˈvɪl.ən/","a":"en-us-villain.ogg","s":[{"p":"noun","d":[{"m":"(countable) A villain is a very bad person, often a criminal."},{"m":"(countable) A villain is the enemy of the main character in a story."}]}]},"builder":{"h":"builder","i":"/ˈbɪl.də/","a":"LL-Q1860 (eng)-Vealhurl-builder.wav","s":[{"p":"noun","d":[{"m":"(countable) A builder is a person who builds things. This is most often a person who makes houses or buildings."}]}]},"burner":{"h":"burner","i":"/ˈbɜːnə/","a":"en-au-burner.ogg","s":[{"p":"noun","d":[{"m":"(countable) A burner is something that fire comes from. A burner uses fuel (such as propane) and is often found on old stoves."},{"m":"(countable) A burner is the thing on a stove that makes heat, even if it is electric.","e":"Take the kettle off the burner please."}]}]},"bark":{"h":"bark","i":"/bɑrk/","a":"en-us-bark.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) The outside part of a tree; the skin of the tree.","e":"I made the tea from sassafras bark."},{"m":"(countable) A loud sound made by a dog or seal.","e":"I heard a bark and turned to see the dog."}]},{"p":"verb","d":[{"m":"When an animal barks it makes a loud, sharp sound.","e":"I couldn't sleep because the dog was barking all night!"},{"m":"To bark is to speak in a sharp way.","e":"He barked out orders, one after another."}]}]},"beard":{"h":"beard","i":"/bɪəd/","a":"en-us-beard.ogg","s":[{"p":"noun","d":[{"m":"(countable) A beard is hair that grows on a man's face.","e":"After living in the woods for three months, Tom had grown a big, bushy beard"},{"m":"(countable) Hair on the face of some animals, such as a goat's beard."},{"m":"A woman who goes on a date with a gay male so that others will think that he is heterosexual."}]}]},"blackberry":{"h":"blackberry","i":"/ˈblækbəri/","a":"en-us-blackberry.ogg","s":[{"p":"noun","d":[{"m":"(countable) A blackberry is a type of black fruit that grows on vines that have thorns.","e":"The blackberries have a great taste."}]}]},"thorn":{"h":"thorn","a":"en-uk-thorn.ogg","s":[{"p":"noun","d":[{"m":"(countable) A thorn is a sharp thing on part of a plant."},{"m":"(uncountable) A letter used in Old English and some other languages, but not used in English today. Thorn is written as \"Þ.\""}]}]},"vine":{"h":"vine","i":"/vaɪn/","a":"en-us-vine.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vine is a long, thin plant. Vines might grow along the ground, or up things such as walls or trees."},{"m":"If something is \"of the vine\" it is made from grapes."}]}]},"grape":{"h":"grape","i":"/ɡreɪp/","a":"en-us-grape.ogg","s":[{"p":"noun","d":[{"m":"(countable) A grape is a type of fruit that grows on a vine and is often used to make wine."},{"m":"(uncountable) A dark purplish-red colour, the colour of grapes."}]}]},"alcoholic":{"h":"alcoholic","i":"/ˌælkəˈhɒlɪk/","a":"en-us-alcoholic.ogg","s":[{"p":"adjective","d":[{"m":"If something is alcoholic, it contains alcohol.","e":"This wine is very alcoholic."}]},{"p":"noun","d":[{"m":"(countable) An alcoholic is a person who drinks too much alcohol and cannot keep from drinking alcohol; someone who is addicted to alcohol.","e":"The alcoholic was caught driving dangerously on the road several times."}]}]},"comedian":{"h":"comedian","i":"/kəˈmiːdiən/","a":"LL-Q1860 (eng)-Vealhurl-comedian.wav","s":[{"p":"noun","d":[{"m":"(countable) A comedian is someone who makes people laugh by telling funny stories."}]}]},"comical":{"h":"comical","i":"/ˈkɒmɪkəl/","a":"en-us-comical.ogg","s":[{"p":"adjective","d":[{"m":"If something is comical it is funny, it makes you laugh."}]}]},"superior":{"h":"superior","i":"/suːˈpɪəri.ə(r)/","a":"en-us-superior.ogg","s":[{"p":"adjective","d":[{"m":"If x is superior to y, x is better than y."},{"m":"If x is superior to y, x is above y in the body. (This might not be true if the person or animal is not standing.)"}]},{"p":"noun","d":[{"m":"(countable) A person of higher rank or quality.","e":"\"Always listen to your superiors.\""},{"m":"The senior person in a monastic community."}]}]},"antihero":{"h":"antihero","i":"/ˈæn.tɪˌhɪə.rəʊ/","a":"en-us-antihero.ogg","s":[{"p":"noun","d":[{"m":"(countable) An antihero is a bad person who is the principal (main) character in a story. A bad or evil hero."}]}]},"anti":{"h":"anti","i":"/ˈæn.ti/","a":"LL-Q1860 (eng)-Flame, not lame-anti.wav","s":[{"p":"preposition","d":[{"m":".","e":"I'm anti the idea of moving the couch there. I think that's a horrible place for it."}]}]},"psycho":{"h":"psycho","i":"/ˈsaɪ̯.kəʊ̯/","a":"en-au-psycho.ogg","s":[{"p":"adjective","d":[{"m":"Short for psychotic; not able to tell what is real or not.","e":"He is totally psycho and thinks he is Jesus."}]},{"p":"noun","d":[{"m":"Short for psychotic."},{"m":"(countable) A psycho is a person who acts in a strange and often dangerous way.","e":"That psycho has been stalking me all year. I'm afraid he might do something to me any time."}]}]},"psychotic":{"h":"psychotic","i":"/ˈsɑɪˌkɑtɪk/","s":[{"p":"adjective","d":[{"m":"Having psychosis. If you are psychotic you do not know what is real and what is imaginary because of mental illness."}]}]},"psychosis":{"h":"psychosis","i":"/saɪˈkəʊsɪs/","a":"LL-Q1860 (eng)-Vealhurl-psychosis.wav","s":[{"p":"noun","d":[{"m":"Psychosis is mental illness that causes imaginary things to seem real. These imaginary things could be delusions (false ideas) or hallucinations (things you might see or hear that are not real).","e":"His psychosis led him think I had stolen his stomach and hidden it."}]}]},"psychoses":{"h":"psychoses","i":"/ˈsɑɪˌkosiz/","l":"psychosis","q":"noun"},"auntie":{"h":"auntie","i":"/ˈæn.ti/","a":"LL-Q1860 (eng)-Vealhurl-auntie.wav","s":[{"p":"noun","d":[{"m":"(countable) A fun word for aunt, most often used by children or when talking to children.","e":"Go see auntie Janice."}]}]},"ante":{"h":"ante","i":"/ˈæn.ti/","a":"en-us-ante.ogg","s":[{"p":"noun","d":[{"m":"An ante is something you agree to risk before you know what will happen.","e":"The dealer asked the gamblers, \"What's the ante.\""}]},{"p":"preposition","d":[{"m":"before"}]},{"p":"verb","d":[{"m":"To pay the ante in poker."},{"m":"To make an investment in money, effort, or time before knowing one's chances."}]}]},"grief":{"h":"grief","i":"/griːf/","a":"en-us-grief.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Grief is great sadness.","e":"After she died the grief almost killed me."},{"m":"(uncountable) If someone gives you grief that person causes problems for you or annoys you."}]}]},"duster":{"h":"duster","i":"/ˈdʌstɚ/","a":"LL-Q1860 (eng)-Vealhurl-duster.wav","s":[{"p":"noun","d":[{"m":"(countable) A duster is something that removes dust, usually a cloth."},{"m":"(countable) A duster is a person who dusts something.","e":"The homeowner became the duster when she starting dusting."},{"m":"(countable) A duster is a baseball pitch intentional to hit a batter."}]}]},"dusters":{"h":"dusters","l":"duster","q":"noun"},"uses":{"h":"uses","l":"use","q":"verb"},"script":{"h":"script","i":"/skrɪpt/","a":"en-us-script.ogg","s":[{"p":"noun","d":[{"m":"Written characters (letters).","e":"Russian language uses Greek script fonts."},{"m":"(countable) The written text of a movie.","e":"The script was developed by a famous screenwriter."},{"m":"(US) A way of in which all of the letters in the same word are connected; cursive."},{"m":"Short for prescription."}]}]},"rhotic":{"h":"rhotic","i":"/ˈrəʊtɪk/","s":[{"p":"adjective","d":[{"m":"If a sound in a word is rhotic, it has the sound the letter r makes in most American, Canadian, and Irish ways of talking."},{"m":"If a dialect (form of a language) or accent is rhotic, it uses this sound after a vowel: often used in dividing English accents into the rhotic and the non-rhotic. (Note that all accents of English pronounce the rhotic sound if \"r\" or \"rh\" is immediately followed by a vowel – which means it is always pronounced at the start of a word.)"}]}]},"non-rhotic":{"h":"non-rhotic","s":[{"p":"adjective","d":[{"m":"If a dialect (form of a language) or accent is non-rhotic, it only pronounces the rhotic sound for the letter R when it is before a vowel (more precisely, the rhotic sound is pronounced if \"r\" or \"rh\" is immediately followed by a vowel – which also means it is always pronounced at the start of a word). Most British accents in England and Wales are non-rhotic (with the notable exception of West-Country accents), as are all Australian accents and most accents of Massachusetts, New Hampshire, Rhode Island and Maine in New England, United States."}]}]},"dialect":{"h":"dialect","i":"/ˈdɑɪ.ə.ˌlɛkt/","a":"en-us-dialect.ogg","s":[{"p":"noun","d":[{"m":"(countable) A dialect is a version of a language. People who speak different dialects might sound different or word meanings might be a little different. People speaking different dialects talk similar enough that they can understand each other. (If people cannot understand each other, they speak different languages, not different dialects.)","e":"The dialect of the southern United States is quite different from that of the North."}]}]},"frogs":{"h":"frogs","l":"frog","q":"noun"},"sites":{"h":"sites","l":"site","q":"noun"},"sited":{"h":"sited","l":"site","q":"verb"},"siting":{"h":"siting","l":"site","q":"verb"},"sneezes":{"h":"sneezes","l":"sneeze","q":"noun"},"sneezed":{"h":"sneezed","l":"sneeze","q":"verb"},"polyglot":{"h":"polyglot","i":"/ˈpɒliːɡlɒt/","a":"LL-Q1860 (eng)-Vealhurl-polyglot.wav","s":[{"p":"noun","d":[{"m":"(countable) A polyglot is a person who knows or can talk in many different languages."},{"m":"(countable) A polyglot is something that is made up out of more than one language."}]}]},"polyglots":{"h":"polyglots","l":"polyglot","q":"noun"},"gradual":{"h":"gradual","i":"/ˈɡrædʒuəl/","a":"en-us-gradual.ogg","s":[{"p":"adjective","d":[{"m":"Something that is done in steps or in small degrees, something that happens slowly.","e":"The slope of the hill was very gradual."}]}]},"badly":{"h":"badly","i":"/ˈbæd.li/","a":"en-us-badly.ogg","s":[{"p":"adverb","d":[{"m":"In a bad way."}]},{"p":"adjective","d":[{"m":"(Northern England), ill or not healthy."}]}]},"foolishly":{"h":"foolishly","i":"/ˈfuːlɪʃli/","s":[{"p":"adverb","d":[{"m":"In a foolish way."}]}]},"janitor":{"h":"janitor","i":"/ˈdʒænɪtə/","a":"LL-Q1860 (eng)-Vealhurl-janitor.wav","s":[{"p":"noun","d":[{"m":"(countable) A janitor is a person who is responsible for cleaning a building."}]}]},"janitors":{"h":"janitors","l":"janitor","q":"noun"},"diskette":{"h":"diskette","a":"en-us-diskette.ogg","s":[{"p":"noun","d":[{"m":"A diskette is a small disk that is used to store information."}]}]},"diskettes":{"h":"diskettes","l":"diskette","q":"noun"},"mood":{"h":"mood","i":"/muːd/","a":"en-us-mood.ogg","s":[{"p":"noun","d":[{"m":"An emotion or a state of mind."}]}]},"moods":{"h":"moods","l":"mood","q":"noun"},"hyperpolyglot":{"h":"hyperpolyglot","i":"/ˈhaɪpɚ/pɒliːglɒt/","s":[{"p":"noun","d":[{"m":"(countable) A hyperpolyglot is a person who can speak or talk in very many different languages."}]}]},"hyperpolyglots":{"h":"hyperpolyglots","l":"hyperpolyglot","q":"noun"},"sauces":{"h":"sauces","l":"sauce","q":"noun"},"height":{"h":"height","i":"/haɪt/","a":"en-us-height.ogg","s":[{"p":"noun","d":[{"m":"The distance of something from the bottom of it to the top; how tall something is."},{"m":"The highest part of something."}]}]},"heights":{"h":"heights","i":"/haɪts/","a":"en-us-heights.ogg","l":"height","q":"noun"},"conventions":{"h":"conventions","l":"convention","q":"noun"},"customs":{"h":"customs","i":"/ˈkʌstəmz/","a":"en-us-customs.ogg","l":"custom","q":"noun","s":[{"p":"noun","d":[{"m":"The taxes on things brought into or taken out of a country.","e":"We had to pay customs of £200 on all the wine we brought back from France."},{"m":"The government department that collects the taxes on things brought into a country.","e":"We got pulled over by customs on our way back from France – we only had 200 bottles of wine – it was so unfair."}]}]},"irregular":{"h":"irregular","i":"/ɪˈrɛgjəlɚ/","a":"LL-Q1860 (eng)-Vealhurl-irregular.wav","s":[{"p":"adjective","d":[{"m":"Something that is not standard or regular."}]}]},"enemies":{"h":"enemies","a":"en-us-enemies.ogg","l":"enemy","q":"noun"},"mexico":{"h":"Mexico","i":"/ˈmɛk.sɪ.kəʊ/","a":"LL-Q1860 (eng)-Soundguys-Mexico.wav","s":[{"p":"proper noun","d":[{"m":"Mexico is a country in North America. It is south of the USA."}]}]},"airline":{"h":"airline","s":[{"p":"noun","d":[{"m":"(countable) An airline is a company that carries people and goods by means of airplanes."}]}]},"airlines":{"h":"airlines","l":"airline","q":"noun"},"days":{"h":"days","i":"/ˈdeɪz/","a":"en-us-days.ogg","l":"day","q":"noun"},"founded":{"h":"founded","i":"/ˈfaʊndɪd/","a":"en-us-founded.ogg","l":"found","q":"verb"},"tower":{"h":"tower","i":"/ˈtaʊə/","a":"en-us-tower.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tower is a tall building or structure."},{"m":"(countable) A tower is a person who tows thing."}]},{"p":"verb","d":[{"m":"To tower is to be much taller than something.","e":"The basketball players towered over their fans."}]}]},"towers":{"h":"towers","l":"tower","q":"noun"},"blackberries":{"h":"blackberries","l":"blackberry","q":"noun"},"austria":{"h":"Austria","i":"/ˈɒs.tri.ə/","a":"en-us-Austria.ogg","s":[{"p":"proper noun","d":[{"m":"Austria is a country in Europe."}]}]},"withdrawn":{"h":"withdrawn","i":"/wɪðˈdrɔːn/","a":"en-us-withdrawn.ogg","l":"withdraw","q":"verb","s":[{"p":"adjective","d":[{"m":"People who are withdrawn keeps to themselves and do not seek out or even welcome contact with others.","e":"After his parents died, he just became completely withdrawn."}]}]},"withdrawing":{"h":"withdrawing","l":"withdraw","q":"verb"},"whips":{"h":"whips","l":"whip","q":"noun"},"catalysts":{"h":"catalysts","l":"catalyst","q":"noun"},"accesses":{"h":"accesses","l":"access","q":"noun"},"accessing":{"h":"accessing","l":"access","q":"verb"},"inaccessible":{"h":"inaccessible","i":"/ˌɪnəkˈsɛsɪbl̩/","a":"en-us-inaccessible.ogg","s":[{"p":"adjective","d":[{"m":"If something is inaccessible, it can’t be reached or accessed."}]}]},"adopted":{"h":"adopted","i":"/əˈdɑptɪd/","a":"en-us-adopted.ogg","l":"adopt","q":"verb"},"unafraid":{"h":"unafraid","i":"/ʌnəˈfreɪd/","s":[{"p":"adjective","d":[{"m":"If you are unafraid of something, then you do not fear or are not afraid of it.","e":"She's unafraid of hard work."}]}]},"baker":{"h":"baker","i":"/ˈbeɪ.kə(r)/","a":"en-us-baker.ogg","s":[{"p":"noun","d":[{"m":"(countable) A baker is a person who bakes food."}]}]},"bakers":{"h":"bakers","l":"baker","q":"noun"},"bakery":{"h":"bakery","i":"/ˈbeɪ.kə.ri/","a":"en-us-bakery.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bakery is a place where bread and similar kinds of food are baked and sold."}]}]},"bakeries":{"h":"bakeries","l":"bakery","q":"noun"},"bathrooms":{"h":"bathrooms","l":"bathroom","q":"noun"},"batteries":{"h":"batteries","l":"battery","q":"noun"},"beans":{"h":"beans","l":"bean","q":"noun"},"bells":{"h":"bells","i":"/bɛlz/","a":"en-us-bells.ogg","l":"bell","q":"noun"},"bones":{"h":"bones","i":"/bəʊnz/","a":"en-us-bones.ogg","l":"bone","q":"noun"},"brains":{"h":"brains","i":"/breɪnz/","a":"en-us-brains.ogg","l":"brain","q":"noun","s":[{"p":"noun","d":[{"m":", knowledge."}]}]},"branches":{"h":"branches","i":"/ˈbrænt͡ʃɪz/","a":"en-us-branches.ogg","l":"branch","q":"noun"},"breakfasts":{"h":"breakfasts","l":"breakfast","q":"noun"},"bricks":{"h":"bricks","i":"/brɪks/","a":"en-us-bricks.ogg","l":"brick","q":"noun"},"capitals":{"h":"capitals","l":"capital","q":"noun"},"cells":{"h":"cells","l":"cell","q":"noun"},"chuck":{"h":"chuck","i":"/tʃʌk/","a":"en-au-chuck.ogg","s":[{"p":"verb","d":[{"m":"(informal) If you chuck something, you throw it.","e":"Ouch! Why'd you throw the ball so hard? You didn't have to chuck it at me!"},{"m":"(informal) If you chuck something, you throw it away.","e":"The fruit has gone bad, I'm going to chuck it."}]},{"p":"noun","d":[{"m":"Meat from the shoulder of a cow or other animal."}]}]},"circles":{"h":"circles","i":"/ˈsɝkl̩z/","a":"en-us-circles.ogg","l":"circle","q":"noun"},"clouds":{"h":"clouds","i":"/klaʊdz/","a":"en-us-clouds.ogg","l":"cloud","q":"noun"},"clues":{"h":"clues","l":"clue","q":"noun"},"coasts":{"h":"coasts","l":"coast","q":"noun"},"voices":{"h":"voices","i":"/ˈvɔɪsɪz/","a":"en-us-voices.ogg","l":"voice","q":"noun"},"western":{"h":"western","i":"/ˈwɛstɚn/","a":"en-us-western.ogg","s":[{"p":"adjective","d":[{"m":"A western place is in or from the west of the place.","e":"Alberta is in Western Canada."},{"m":"A western idea or practice comes from Europe and/or North America.","e":"It's hard to explain fully why Western culture has been so successful."}]},{"p":"noun","d":[{"m":"(countable) A movie set in the historic American West."}]}]},"wheels":{"h":"wheels","l":"wheel","q":"noun"},"hyena":{"h":"hyena","i":"/haɪˈiːnə/","a":"en-us-hyena.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hyena is an animal that looks like a dog. It lives in Africa and Asia."}]}]},"hyenas":{"h":"hyenas","l":"hyena","q":"noun"},"thermometer":{"h":"thermometer","i":"/θɚˈmɑmɪtɚ/","a":"en-us-thermometer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A thermometer is an instrument that is used to find the temperature of something."}]}]},"thermometers":{"h":"thermometers","l":"thermometer","q":"noun"},"salad":{"h":"salad","i":"/ˈsæləd/","a":"en-us-salad.ogg","s":[{"p":"noun","d":[{"m":"(countable) A salad is a food that is made of uncooked vegetables. It is often served with a dressing or vinegar."}]}]},"salads":{"h":"salads","l":"salad","q":"noun"},"string":{"h":"string","i":"/strɪŋ/","a":"en-us-string.ogg","s":[{"p":"noun","d":[{"m":"(countable) A string is a long, thin and flexible cord that is used for tying."},{"m":"(countable) A string is something that is long and can be bent.","e":"There are 4 strings on a violin."},{"m":"(countable) A string is a group of things positioned or stuck together in a line.","e":"My dog tried to grab one sausage with his mouth, but he took the whole string of sausages."},{"m":"(countable) A string is a set of events that happen one after the other.","e":"She remembered her past string of successes and felt happy."},{"m":"(countable), A string is a group of letters, numbers, punctuation marks, etc. (characters) that is stored in a computer's memory. The characters can repeat and they are placed together in some order."},{"m":"(countable), A string is a musical instrument that makes sounds from strings."},{"m":"(countable), A string is an infinitely thin object that is 10-35 meters long. A part of physics called string theory claims that strings are subatomic particles (they are the smallest bits of atoms) and physical states affect the way they move repeatedly (they vibrate)."},{"m":"(uncountable), String is marijuana."},{"m":"(countable), In billiards and other similar cue sports, a string is one of the imaginary lines that divide a table. Each string joins two diamonds (points) that are marked in two opposite rails (edges) of the table. Strings may or may not be marked in the table.","e":"The long string connects the two diamonds at the center of the two short rails, so it divides the table in two."},{"m":"(countable), A string is some thin part of a plant that looks like a thread (a plant fiber)."},{"m":"(countable), A string is a cord in a body of an animal, like a nerve or tendon."},{"m":"See strings."}]},{"p":"verb","d":[{"m":"(transitive) To string something is to put it on a [[#Noun|string]] or line.","e":"The beads can be strung to make a necklace."},{"m":"(transitive) To string something is to put strings on it.","e":"I help my father string tennis rackets so he can sell them."},{"m":"(transitive) To string something is to tie or hang it.","e":"They strung many small bells in the trees."},{"m":"(intransitive) To string is to form into a string, like when a substance stretches or when a group of people form a line."},{"m":"(intransitive), In billiards and other similar cue sports, when two players string, they each shoot a ball to the opposite end of the table. The balls then hit the opposite edge (or \"rail\") and go back to the starting one. The player with the ball that is the nearest to the starting rail makes the first move in the game."}]}]},"strings":{"h":"strings","i":"/strɪŋz/","l":"string","q":"noun","s":[{"p":"noun","d":[{"m":"; As a group, the s in an orchestra."},{"m":"s or limitations.","e":"It looks like a good offer, but there are strings attached."}]}]},"intervals":{"h":"intervals","a":"en-us-intervals.ogg","l":"interval","q":"noun"},"frequencies":{"h":"frequencies","l":"frequency","q":"noun"},"teas":{"h":"teas","i":"/tiːz/","l":"tea","q":"noun"},"speeches":{"h":"speeches","i":"/ˈspiːt͡ʃɪz/","a":"en-us-speeches.ogg","l":"speech","q":"noun"},"graces":{"h":"graces","a":"en-us-graces.ogg","l":"grace","q":"noun"},"flames":{"h":"flames","a":"en-us-flames.ogg","l":"flame","q":"noun"},"insteps":{"h":"insteps","l":"instep","q":"noun"},"geologies":{"h":"geologies","l":"geology","q":"noun"},"guides":{"h":"guides","l":"guide","q":"noun"},"banks":{"h":"banks","i":"/bæŋks/","a":"en-us-banks.ogg","l":"bank","q":"noun"},"trips":{"h":"trips","l":"trip","q":"noun","s":[{"p":"noun","d":[{"m":"Three of a kind in poker."}]}]},"rushes":{"h":"rushes","l":"rush","q":"noun"},"mediums":{"h":"mediums","l":"medium","q":"noun"},"composers":{"h":"composers","l":"composer","q":"noun"},"jewelers":{"h":"jewelers","l":"jeweler","q":"noun"},"labours":{"h":"labours","l":"labour","q":"noun"},"rewards":{"h":"rewards","l":"reward","q":"noun"},"buds":{"h":"buds","l":"bud","q":"noun"},"fans":{"h":"fans","l":"fan","q":"noun"},"autumns":{"h":"autumns","l":"autumn","q":"noun"},"stealing":{"h":"stealing","a":"en-us-stealing.ogg","l":"steal","q":"verb"},"serpents":{"h":"serpents","l":"serpent","q":"noun"},"phases":{"h":"phases","l":"phase","q":"noun"},"trends":{"h":"trends","l":"trend","q":"noun"},"loudspeakers":{"h":"loudspeakers","l":"loudspeaker","q":"noun"},"beast":{"h":"beast","i":"/biːst/","a":"en-us-beast.ogg","s":[{"p":"noun","d":[{"m":"A beast is a large animal.","e":"It isn't fit for man nor beast out there."},{"m":"A beast is a monster.","e":"There was a terrible beast in the movie."},{"m":"If something is a beast it is very difficult or unpleasant.","e":"Yes, this language is a beast."},{"m":"If something is a beast it is very big or powerful.","e":"The truck he drove was huge, a real beast."},{"m":"If a person is a beast, they are wild, violent or uncivilized.","e":"How dare you touch me like that! You beast!"}]},{"p":"verb","d":[{"m":"(British military) If someone beasts they make others do hard exercises, either as training or as punishment."}]}]},"beasts":{"h":"beasts","i":"/biːsts/","a":"en-us-beasts.ogg","l":"beast","q":"noun"},"bestial":{"h":"bestial","i":"/ˈbɛsʧəl/","s":[{"p":"adjective","d":[{"m":"If something is bestial, it is similar to an beast (or might be a beast).","e":"In the game Heretic, players shoot undead warriors and bestial horrors."},{"m":"If something is bestial, it is typical of a beast.","e":"I'm tired of your bestial behavior. You need to start acting like a human being!"}]}]},"bestiality":{"h":"bestiality","i":"/ˈbɛsʧəlˌlɪtɪ/","s":[{"p":"noun","d":[{"m":"(uncountable) The quality of being bestial. This most often means behaving (acting) like a wild animal."},{"m":"The act of having sex with an animal."}]}]},"funnies":{"h":"funnies","l":"funny","q":"noun","s":[{"p":"noun","d":[{"m":"The funnies are the comic strips in a newspaper."}]}]},"barrel":{"h":"barrel","i":"/bɛrəl/","a":"en-us-barrel.ogg","s":[{"p":"noun","d":[{"m":"(countable) A barrel is a tall and round container."},{"m":"(countable) A barrel is the amount of something that is in a full barrel, or that would fit in the barrel. For example, a barrel of water or a barrel of beer."},{"m":"(countable) The barrel of a gun is the part the bullet goes through."},{"m":"(countable) The barrel of a clarinet is the part you connect the mouth piece."},{"m":"(countable) The barrel of a horse or pony is its ribs."},{"m":"(countable) A barrel is a solid metal tube that may be part of some machines."}]},{"p":"verb","d":[{"m":"(intransitive) If you barrel, you move very quickly."}]}]},"bankrupt":{"h":"bankrupt","i":"/ˈbæŋ.krəpt/","a":"LL-Q1860 (eng)-Vealhurl-bankrupt.wav","s":[{"p":"adjective","d":[{"m":"If you are bankrupt you have declared bankruptcy (protection by law from debt you cannot pay).","e":"I don't have to pay now because I am bankrupt."},{"m":"If you are bankrupt you have no money.","e":"I have been bankrupt all summer."},{"m":"If you are bankrupt of something, you do not have that thing. For example, someone who is \"morally bankrupt\" has no morals.","e":"We can't survive if our country becomes morally bankrupt."}]},{"p":"verb","d":[{"m":"(transitive) If you bankrupt someone, you make them [[#Adjective|bankrupt]]."}]}]},"gap":{"h":"gap","i":"/ɡæp/","a":"en-us-gap.ogg","s":[{"p":"noun","d":[{"m":"(countable) A gap is a difference in the level of two groups.","e":"The money is to help bridge the gap between rich schools and poor schools."},{"m":"(countable) A gap is a small space or a short time between two things.","e":"Watch the gap between the platform and the train."},{"m":"(countable) A gap is missing space, time, information, etc.","e":"We don't know exactly what happened, but the new information will help us fill in some gaps in the story."}]}]},"gaps":{"h":"gaps","i":"/ɡæps/","l":"gap","q":"noun"},"barrels":{"h":"barrels","a":"en-us-barrels.ogg","l":"barrel","q":"noun"},"fonts":{"h":"fonts","l":"font","q":"noun"},"font":{"h":"font","i":"/fɒnt/","a":"LL-Q1860 (eng)-Vealhurl-font.wav","s":[{"p":"noun","d":[{"m":"(countable) A set of signs that have the same typeface (e.g., Helvetica), style (e.g., italic), and weight (e.g., bold).","e":"s of different fonts:"}]}]},"garage":{"h":"garage","i":"/ɡəˈrɒʒ/","a":"en-us-garage.ogg","s":[{"p":"noun","d":[{"m":"(countable) A garage is building that you keep cars in.","e":"They lived in a large country house with a two-car garage."},{"m":"(countable) A garage is a shop that repairs cars.","e":"The guy at the garage said it would take three days to fix the car."}]}]},"garages":{"h":"garages","l":"garage","q":"noun"},"dialects":{"h":"dialects","i":"/ˈdaɪ.əˌlɛkts/","l":"dialect","q":"noun"},"gather":{"h":"gather","i":"/ˈɡæðɚ/","a":"en-us-gather.ogg","s":[{"p":"verb","d":[{"m":"If people or things gather, they come together.","e":"A crowd of several hundred gathered outside the police station."},{"m":"If you gather something, you've heard or read it, or you have reason to believe it, but you don't know.","e":"This trip was a kept secret, I gather, until yesterday."},{"m":"(transitive) If something gathers speed, it continues to get faster.","e":"The train pulled ahead, gathering speed as it moved away."},{"m":"(transitive) If something is gathering dust, it is not being used.","e":"Remember that wheelchair? It was gathering dust in the garage."}]}]},"gear":{"h":"gear","i":"/ɡɪə(r)/","a":"en-au-gear.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Gear is clothing and other equipment, especially in sports.","e":"Hurry up and get your gear on. The game's about to start."},{"m":"(countable) Gears are wheels that turn and drive other wheels at different speeds.","e":"One of the gears from the motor had got stuck and wouldn't turn."},{"m":"(countable); (singular often used without a determiner) A gear in a machine, especially a car or bicycle, is a particular combinations of gears.","e":"He put the car into gear and drove off."},{"m":"(countable); (singular often used without a determiner) A gear is a speed or level that you do something at.","e":"Everyone was working at high gear to finish before the deadline."}]}]},"delegated":{"h":"delegated","l":"delegate","q":"verb"},"delegating":{"h":"delegating","l":"delegate","q":"verb"},"learned":{"h":"learned","i":"/lɜːnd/","a":"en-us-learned.ogg","l":"learn","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are learned, then you are highly educated."}]}]},"calculation":{"h":"calculation","i":"/kælkjuˈleɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-calculation.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Calculation is the act of."},{"m":"(countable) A calculation is the answer you get after calculating.","e":"Your calculation is wrong."}]}]},"calculations":{"h":"calculations","a":"en-us-calculations.ogg","l":"calculation","q":"noun"},"eyes":{"h":"eyes","i":"/aɪz/","a":"en-us-eyes.ogg","l":"eye","q":"noun"},"pretends":{"h":"pretends","l":"pretend","q":"verb"},"pretended":{"h":"pretended","a":"en-us-pretended.ogg","l":"pretend","q":"verb"},"glad":{"h":"glad","i":"/ɡlæd/","a":"en-us-glad.ogg","s":[{"p":"adjective","d":[{"m":"If you are glad about something, you are happy about it.","e":"I'm glad to hear you're feeling better."},{"m":"If you are glad to do something, you will do it happily.","e":"\"Can you get this door for me?\" \"Sure, I'd be glad to.\""}]}]},"dreams":{"h":"dreams","i":"/driːmz/","a":"en-us-dreams.ogg","l":"dream","q":"noun"},"strawberry":{"h":"strawberry","i":"/ˈstrɔːb(ə)ri/","a":"en-us-strawberry.ogg","s":[{"p":"noun","d":[{"m":"(countable) A strawberry is a red, triangle-shaped fruit."},{"m":"(countable) A strawberry is a small plant that grows close to the ground and makes these."},{"m":"(uncountable) Strawberry is a type of red similar to the color of this fruit."}]}]},"pits":{"h":"pits","l":"pit","q":"noun"},"peach":{"h":"peach","i":"/piːʧ/","a":"en-us-peach.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sweet fruit.","e":"You need to take the pit out of that peach."},{"m":"(uncountable) A peach is a light yellowish pink color that is similar to a peach."}]}]},"peaches":{"h":"peaches","l":"peach","q":"noun"},"hatchbacks":{"h":"hatchbacks","l":"hatchback","q":"noun"},"strawberries":{"h":"strawberries","l":"strawberry","q":"noun"},"truck":{"h":"truck","i":"/trʌk/","a":"en-us-truck.ogg","s":[{"p":"noun","d":[{"m":"(countable) A truck is a vehicle that is often used to carry or pull big loads."}]},{"p":"verb","d":[{"m":"If you truck something, you send it somewhere on a truck"},{"m":"If you are trucking you are driving a truck. This usually means driving a big truck for a long way, and as a job."},{"m":"If you are trucking you are going somewhere and are moving fast."}]}]},"firetruck":{"h":"firetruck","s":[{"p":"noun","d":[{"m":"(countable) A firetruck is a truck that firemen use to help put out fires.","e":"The firetruck went quickly through the streets."}]}]},"grab":{"h":"grab","i":"/ɡræb/","a":"en-us-grab.ogg","s":[{"p":"verb","d":[{"m":"If you grab something, you quickly reach out and take it in your hand.","e":"A strong hand grabbed her arm and pulled her backward."},{"m":"(transitive) If something grabs the headlines, it suddenly becomes a major news story.","e":"Scientists at the school grabbed headlines last week with their discovery of a new kind of fat."}]},{"p":"noun","d":[{"m":"(countable) If you make a grab for something, you try to get it.","e":"I made a grab for his hand and the knife flew out the door."}]}]},"burners":{"h":"burners","l":"burner","q":"noun"},"stoves":{"h":"stoves","l":"stove","q":"noun"},"stove":{"h":"stove","i":"/stəʊv/","a":"en-us-stove.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stove is a machine that is used to heat a room."},{"m":"(countable) A stove is a machine you can cook food on."}]}]},"comedians":{"h":"comedians","l":"comedian","q":"noun"},"homework":{"h":"homework","i":"/ˈhəʊmˌwɜːk/","a":"LL-Q1860 (eng)-Vealhurl-homework.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Homework is practice or study that you are supposed to do outside class.","e":"Here is a fun and simple activity to do as a classroom or homework assignment."},{"m":"If you do homework on/about a topic, you find information about it.","e":"We didn't do enough homework before buying the car, and it was a big mistake."}]}]},"milder":{"h":"milder","l":"mild","q":"adjective"},"mildest":{"h":"mildest","l":"mild","q":"adjective"},"superlatives":{"h":"superlatives","l":"superlative","q":"noun"},"trucks":{"h":"trucks","l":"truck","q":"noun"},"almond":{"h":"almond","i":"/ˈɑːmənd/","a":"en-us-almond.ogg","s":[{"p":"noun","d":[{"m":"(countable) An almond is the nut which comes from the almond tree."},{"m":"(uncountable) The colour of the kernel of an almond without its shell."},{"m":"(uncountable) The color of an almond still covered by its skin, a shade of brown."}]}]},"almonds":{"h":"almonds","l":"almond","q":"noun"},"horrible":{"h":"horrible","i":"/ˈhɔrɪbl/","a":"en-us-horrible.ogg","s":[{"p":"adjective","d":[{"m":"If something is horrible, it is very bad.","e":"The killing of this woman was a horrible, horrible crime."}]}]},"radicals":{"h":"radicals","l":"radical","q":"noun"},"tours":{"h":"tours","l":"tour","q":"noun"},"toured":{"h":"toured","l":"tour","q":"verb"},"touring":{"h":"touring","l":"tour","q":"verb"},"going":{"h":"going","i":"/ˈgəʊɪŋ/","a":"en-us-going.ogg","l":"go","q":"verb","s":[{"p":"noun","d":[{"m":"The condition of the ground for walking or driving.","e":"The going was very difficult over the ice."},{"m":"Conditions for advancing or progressing in any way.","e":"The going is often difficult for an immigrant in a new country."}]},{"p":"preposition","d":[{"m":"If something is going on a time, an age, or a period of time, it is almost that time.","e":"Look, it's going on supper-time, so let's set this aside for now."},{"m":"When going is followed by forward (or ahead), it means from now on.","e":"Going forward, we will send monthly reports."},{"m":"When going is followed by back, it means in the past.","e":"Going back 20 years, there was a lot more pollution."}]}]},"raven":{"h":"raven","i":"/ˈreɪvən/","a":"en-us-raven.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kind of large black bird which is part of the genus."},{"m":"(uncountable) Raven is a glossy black color."}]},{"p":"adjective","d":[{"m":"The black colour of the raven."}]},{"p":"verb","d":[{"m":"Raven is when a person or people party wildly."}]}]},"ravens":{"h":"ravens","l":"raven","q":"noun"},"panic":{"h":"panic","i":"/ˈpanɪk/","a":"en-us-panic.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Panic is a very strong and overwhelming fear which dominates thinking.","e":"When he yelled \"fire!\" a panic went through the crowd and suddenly people were yelling and pushing to get out."}]},{"p":"verb","d":[{"m":"To feel strong, overwhelming fear.","e":"I'm panicking about the test tomorrow. It's half of our final grade and I haven't even started studying yet."}]}]},"ideal":{"h":"ideal","i":"/aɪˈdɪəl/","a":"en-us-ideal.ogg","s":[{"p":"adjective","d":[{"m":"If something is ideal, it is as good as you can imagine.","e":"You can lose weight safely, and maintain your ideal weight forever."},{"m":"If something is ideal, it is perfect or flawless; it does not have anything wrong with it."}]},{"p":"noun","d":[{"m":"(countable) An ideal is a perfect example of something.","e":"When he looked at her, he saw the feminine ideal."}]}]},"ignorant":{"h":"ignorant","i":"/ˈɪɡnərənt/","a":"en-us-ignorant.ogg","s":[{"p":"adjective","d":[{"m":"If you are ignorant, you don't know many things that you should know.","e":"They always made her feel like some kind of ignorant fool."},{"m":"If you are ignorant of something, you don't know about it.","e":"The doctors kept her ignorant of the true nature of her disease."},{"m":"If an idea, a book, a comment, etc. is ignorant, it is rude or incorrect because it ignores the facts.","e":"Did you really think his ignorant comments were so funny?"}]}]},"solids":{"h":"solids","l":"solid","q":"noun"},"flowered":{"h":"flowered","l":"flower","q":"verb"},"flowering":{"h":"flowering","l":"flower","q":"verb"},"ideals":{"h":"ideals","a":"En-us-ideals.ogg","l":"ideal","q":"noun","s":[{"p":"noun","d":[{"m":"Your ideals are the basic ideas that you think are good and true.","e":"This country is built on the ideals of freedom, and hard work."}]}]},"immediate":{"h":"immediate","i":"/ɪˈmi.di.ət/","a":"en-us-immediate.ogg","s":[{"p":"adjective","d":[{"m":"If something is immediate, it happens right away, without waiting.","e":"They are asking for an immediate withdrawal of American forces from Iraq."},{"m":"An immediate danger, problem, etc. is one that exists and needs attention now.","e":"I did not harm anyone, put anyone in immediate danger."},{"m":"If something is immediate, it is close or near.","e":"At this age, babies begin to notice things in their immediate environment."}]}]},"spoons":{"h":"spoons","i":"/spuːnz/","a":"LL-Q1860 (eng)-Vealhurl-spoons.wav","l":"spoon","q":"noun","s":[{"p":"noun","d":[{"m":"Spoons is a card game played by children."}]}]},"internet":{"h":"internet","i":"/ˈɪntəˌnɛt/","a":"en-us-internet.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) The Internet, the largest worldwide internet.","e":"Wireless Internet connection is available throughout the hotel."},{"m":"(countable) An internet is any set of computer networks; an intranet."}]}]},"prescription":{"h":"prescription","i":"/prəˈskrɪpʃən/","a":"en-us-prescription.ogg","s":[{"p":"noun","d":[{"m":"A written order, as by a physician, to tell which medicine to take and how many doses of it is needed.","e":"I got a prescription from my ear doctor for my medicine."}]}]},"prescriptions":{"h":"prescriptions","l":"prescription","q":"noun"},"implicate":{"h":"implicate","i":"/ˈɪmplɪkeɪt/","a":"LL-Q1860 (eng)-Vealhurl-implicate.wav","s":[{"p":"verb","d":[{"m":"If x is implicated in y, x is connected to y and may be its cause.","e":"He's been implicated in the loss of the money."}]}]},"impress":{"h":"impress","i":"/ɪmˈprɛs/","a":"en-us-impress-v.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you impress someone, you make them think good things about you.","e":"I'm really impressed by him, particularly his speaking style."},{"m":"(transitive) If you impress something on someone, you stress how important it is.","e":"The problems impressed upon me the wisdom of getting expert advice before starting any project."},{"m":"(transitive) If you impress some marks into something, you make the marks by pushing on it.","e":"Scientists found objects that make interesting marks when impressed into the surface of the wet earth."}]}]},"incredible":{"h":"incredible","i":"/ɪŋˈkrɛdəbəl/","a":"LL-Q1860 (eng)-Vealhurl-incredible.wav","s":[{"p":"adjective","d":[{"m":"If something is incredible, it's very good, often better than you can believe.","e":"We're here at the new store, and it's an incredible thing. Incredible. I'm so excited about it."},{"m":"If something is incredible, it's very big, important, or serious.","e":"When I broke my leg, it was incredible, incredible pain."}]}]},"yam":{"h":"yam","i":"/jæm/","a":"en-us-yam.ogg","s":[{"p":"noun","d":[{"m":"(countable) A yam is a sweet potato."},{"m":"(countable) A yam is a tropical climbing plant with roots that people eat.","e":"Fry the potato or yam pieces until they are crisp and light brown."}]}]},"yams":{"h":"yams","i":"/jæmz/","l":"yam","q":"noun"},"influence":{"h":"influence","i":"/ˈɪn.flu.əns/","a":"en-us-influence.ogg","s":[{"p":"noun","d":[{"m":"An influence is a force that causes something to happen or for someone to do something.","e":"has been quite an influence on."},{"m":"An influence is also power to affect or change someone or something by means of position or power.","e":"Sometimes, I feel like my parents have so much control that everything and everyone in the world is under their influence!"}]},{"p":"verb","d":[{"m":"If you influence something, you are forcing something to happen or for someone to do something.","e":"Doesn't this calm music just influence you to frolic in a meadow?"},{"m":"If you influence something, you can also be changing or swaying it.","e":"Vote-stacking can heavily influence an election."}]}]},"influences":{"h":"influences","i":"/ˈɪn.flu.ənsəz/","a":"en-us-influences.ogg","l":"influence","q":"noun"},"influenced":{"h":"influenced","i":"/ˈɪn.flu.ənst/","l":"influence","q":"verb"},"nails":{"h":"nails","a":"en-us-nails.ogg","l":"nail","q":"noun"},"assemblies":{"h":"assemblies","i":"/əˈsɛmbl̩ɪz/","a":"en-us-assemblies.ogg","l":"assembly","q":"noun"},"collars":{"h":"collars","l":"collar","q":"noun"},"beefs":{"h":"beefs","l":"beef","q":"noun"},"asides":{"h":"asides","l":"aside","q":"noun"},"radios":{"h":"radios","l":"radio","q":"noun"},"scenarios":{"h":"scenarios","i":"/sɛˈnɑːriəʊz/","l":"scenario","q":"noun"},"monkeys":{"h":"monkeys","i":"/ˈmʌŋkiz/","a":"LL-Q1860 (eng)-Persent101-monkeys.wav","l":"monkey","q":"noun"},"tenses":{"h":"tenses","l":"tense","q":"noun"},"potentials":{"h":"potentials","l":"potential","q":"noun"},"skirts":{"h":"skirts","a":"en-us-skirts.ogg","l":"skirt","q":"noun"},"arcs":{"h":"arcs","l":"arc","q":"noun"},"centimetres":{"h":"centimetres","l":"centimetre","q":"noun"},"organisations":{"h":"organisations","l":"organisation","q":"noun"},"empires":{"h":"empires","l":"empire","q":"noun"},"monitors":{"h":"monitors","l":"monitor","q":"noun"},"characters":{"h":"characters","i":"/ˈkɛrəktɚz/","a":"en-us-characters.ogg","l":"character","q":"noun"},"short-cuts":{"h":"short-cuts","l":"short-cut","q":"noun"},"lakes":{"h":"lakes","a":"en-us-lakes.ogg","l":"lake","q":"noun"},"bulbs":{"h":"bulbs","l":"bulb","q":"noun"},"inputs":{"h":"inputs","l":"input","q":"noun"},"regrets":{"h":"regrets","l":"regret","q":"noun"},"counterfeiters":{"h":"counterfeiters","l":"counterfeiter","q":"noun"},"situations":{"h":"situations","l":"situation","q":"noun"},"counters":{"h":"counters","l":"counter","q":"noun"},"independence":{"h":"independence","i":"/ɪndəpɛndɛns/","a":"en-us-independence.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) If you have independence, you are alone or relying on yourself.","e":"The American soldiers bravely fought against the British to earn their independence."},{"m":"(uncountable) A company with independence is a company that is related to no other company.","e":"The record company's independence meant that the band was currently unable to become famous."}]}]},"wolves":{"h":"wolves","a":"en-us-wolves.ogg","l":"wolf","q":"noun"},"daughters-in-law":{"h":"daughters-in-law","l":"daughter-in-law","q":"noun"},"offsets":{"h":"offsets","l":"offset","q":"noun"},"mangoes":{"h":"mangoes","l":"mango","q":"noun"},"carriages":{"h":"carriages","l":"carriage","q":"noun"},"spokes":{"h":"spokes","l":"spoke","q":"noun"},"hyphen":{"h":"hyphen","i":"/ˈhaɪ.fən/","a":"en-us-hyphen.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hyphen is the sign \"-\", typically used to join two related words to form a compound noun, or to show that a word has been split at the end of a line."}]}]},"dandelion":{"h":"dandelion","i":"/ˈdæn.dɪˌlaɪ.ən/","a":"en-uk-dandelion.ogg","s":[{"p":"noun","d":[{"m":"(countable) A plant with a yellow flower head that turns fuzzy and white when it is ready to seed."},{"m":"(uncountable) Dandelion is a yellow color that resembles the flower."}]}]},"initiate":{"h":"initiate","i":"/ɪˈnɪʃ.ɪ.eɪt/","a":"LL-Q1860 (eng)-Vealhurl-initiate.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you initiate something, you begin it, but other people join in or continue it.","e":"The U.S. military initiated a criminal investigation into the killings in March 2006."},{"m":"(transitive) If you initiate someone into something, you give them their first experience with it.","e":"Many of the teens had been initiated into using drugs through their friends."},{"m":"(transitive) If you initiate someone into a club or group, you bring them into the group, often with some ceremony.","e":"Last year, more than 150,000 adults were initiated into the Catholic Church in the United States."}]},{"p":"noun","d":[{"m":"(countable) A new member of a group."},{"m":"(countable) A person who has been through an initiation."}]}]},"levels":{"h":"levels","l":"level","q":"noun"},"dandelions":{"h":"dandelions","l":"dandelion","q":"noun"},"inspect":{"h":"inspect","i":"/ɪnˈspɛkt/","a":"en-us-inspect.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you inspect something, you look at it carefully to find problems.","e":"Drivers should inspect their tires regularly."}]}]},"clitoris":{"h":"clitoris","i":"/ˈklɪtərɪs/","a":"LL-Q1860 (eng)-Vealhurl-clitoris.wav","s":[{"p":"noun","d":[{"m":"(countable) The clitoris is part of a female's sexual organs in mammals, ostriches, and some other species, and is very sensitive to touch.","e":"The spotted hyena uses the clitoris for urination in addition to as a sex organ."}]}]},"demolish":{"h":"demolish","i":"/dəˈmɒl.ɪʃ/","a":"en-us-demolish.ogg","s":[{"p":"verb","d":[{"m":"To destroy; to destruct","e":"They demolished the old house and put up four townhouses."}]}]},"intend":{"h":"intend","i":"/ɪnˈtɛnd/","a":"en-us-intend.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you intend something, you have it in your mind as your plan, goal, wish, etc.","e":"Do you stay online longer than originally intended?"}]}]},"intent":{"h":"intent","i":"/ɪnˈtɛnt/","a":"LL-Q1860 (eng)-Vealhurl-intent.wav","s":[{"p":"noun","d":[{"m":"Your intent is what you have in your mind as you plan, goal, wish, etc.","e":"My original intent was to return it to her, but I was unable to do so."}]},{"p":"adjective","d":[{"m":"If you are intent on something, you have a strong plan to have or do it, and you won't let other things stop you easily.","e":"They were so intent on fishing, they didn't notice their boat was floating away."}]}]},"resorts":{"h":"resorts","l":"resort","q":"noun"},"interpret":{"h":"interpret","i":"/ɪnˈtɜːprɪt/","a":"En-us-interpret.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you interpret something, you understand a particular meaning in it, and may explain that meaning to others.","e":"Children's behaviour can often be difficult to interpret."},{"m":"If you interpret, you translate in real time as people are talking.","e":"In the hospital, I interpreted for the American doctor and the nurses who didn't speak Spanish."}]}]},"parameters":{"h":"parameters","l":"parameter","q":"noun"},"banyans":{"h":"banyans","l":"banyan","q":"noun"},"benefits":{"h":"benefits","l":"benefit","q":"noun","s":[{"p":"noun","d":[{"m":"Benefits are extra things given to employees besides money, like health insurance or vacation time.","e":"Workers are receiving better wages and benefits now."},{"m":"Benefits are help or support given by the government, like money or medical care, especially to people who need it because of age, lack of job, or health issues.","e":"They want big new government benefits like universal healthcare and free college."}]}]},"evils":{"h":"evils","l":"evil","q":"noun"},"mops":{"h":"mops","l":"mop","q":"noun"},"investigate":{"h":"investigate","i":"/ɪn'ves.tɪ.geɪt/","a":"en-us-investigate.ogg","s":[{"p":"verb","d":[{"m":"If you investigate a problem, you get information about it and you think carefully about the information, usually to find an answer.","e":"We won't know what happened until it is more thoroughly investigated."}]}]},"irish":{"h":"Irish","i":"/ˈaɪrɪʃ/","a":"en-us-Irish.ogg","s":[{"p":"proper noun","d":[{"m":"(uncountable) Irish is the native language of Ireland, now only spoken by a minority of Ireland's people, it is part of the Gaelic language family, which is part of the broader Celtic language family.","e":"English was the language used at school in Dublin, even for those who spoke only Irish."}]},{"p":"adjective","d":[{"m":"If something or someone is Irish, it is from or related to Ireland.","e":"Now the place is an Irish pub called O'Neill's."},{"m":"The Irish are the people of Ireland.","e":"The Welsh were fighting the English and the Scots were fighting the English and of course the Irish were fighting the English."}]}]},"flights":{"h":"flights","a":"en-us-flights.ogg","l":"flight","q":"noun"},"dresses":{"h":"dresses","i":"/ˈdrɛsɪz/","a":"en-us-dresses.ogg","l":"dress","q":"noun"},"microphones":{"h":"microphones","l":"microphone","q":"noun"},"screens":{"h":"screens","l":"screen","q":"noun"},"gears":{"h":"gears","l":"gear","q":"noun"},"fatherlands":{"h":"fatherlands","l":"fatherland","q":"noun"},"sulfurs":{"h":"sulfurs","l":"sulfur","q":"noun"},"colds":{"h":"colds","l":"cold","q":"noun"},"stories":{"h":"stories","a":"en-us-stories.ogg","l":"story","q":"noun"},"handles":{"h":"handles","l":"handle","q":"noun"},"towels":{"h":"towels","l":"towel","q":"noun"},"ifs":{"h":"ifs","i":"/ɪfs/","a":"LL-Q1860 (eng)-Vealhurl-ifs.wav","l":"if","q":"noun"},"strips":{"h":"strips","a":"en-us-strips.ogg","l":"strip","q":"noun"},"zests":{"h":"zests","l":"zest","q":"noun"},"cheeks":{"h":"cheeks","i":"/t͡ʃiːks/","a":"en-us-cheeks.ogg","l":"cheek","q":"noun"},"beards":{"h":"beards","l":"beard","q":"noun"},"poses":{"h":"poses","l":"pose","q":"noun"},"croatia":{"h":"Croatia","i":"/ˌkrəʊˈeɪ.ʃə/","a":"en-us-Croatia.ogg","s":[{"p":"proper noun","d":[{"m":"Croatia is a country that is in the middle of Europe."}]}]},"lexicons":{"h":"lexicons","l":"lexicon","q":"noun"},"soils":{"h":"soils","l":"soil","q":"noun"},"unlikely":{"h":"unlikely","i":"/ʌnˈlaɪkli/","a":"en-us-unlikely.ogg","s":[{"p":"adjective","d":[{"m":"If something is unlikely, then it probably will not happen.","e":"It's unlikely that it will rain today."}]}]},"chases":{"h":"chases","l":"chase","q":"noun"},"afterthoughts":{"h":"afterthoughts","l":"afterthought","q":"noun"},"gardens":{"h":"gardens","a":"en-us-gardens.ogg","l":"garden","q":"noun"},"scalps":{"h":"scalps","l":"scalp","q":"noun"},"cheers":{"h":"cheers","i":"/tʃɪəz/","a":"en-uk-cheers.ogg","l":"cheer","q":"noun","s":[{"p":"interjection","d":[{"m":"A common toast.","e":"To good health! Cheers!"},{"m":"(UK); (informal).","e":"\"I'm off to class, see ya later.\" \"Cheers!\""},{"m":"(UK); (informal).","e":"\"Let me buy you a drink.\" \"Really? Cheers!\""}]}]},"educations":{"h":"educations","l":"education","q":"noun"},"toothy":{"h":"toothy","i":"/ˈtuː.θi/","a":"LL-Q1860 (eng)-Vealhurl-toothy.wav","s":[{"p":"adjective","d":[{"m":"Having teeth that stand out or attract attention; showing a lot of teeth.","e":"She gave me a toothy grin."}]}]},"tourist":{"h":"tourist","i":"/ˈtʊərɪst/","a":"LL-Q1860 (eng)-Vealhurl-tourist.wav","s":[{"p":"noun","d":[{"m":"(countable) A tourist is a person who travels for pleasure, not for business.","e":"There are many tourists looking at the church."}]}]},"tourists":{"h":"tourists","l":"tourist","q":"noun"},"toy":{"h":"toy","i":"/tɔɪ/","a":"en-us-toy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A toy is something that you can play with."},{"m":"(countable) A toy is something that isn't very important or doesn't have much value."}]},{"p":"verb","d":[{"m":"If you toy with something, you play with it or make fun of it."},{"m":"To toy with something is to consider it.","e":"I have been toying with the idea of starting my own business."}]}]},"toys":{"h":"toys","i":"/tɔɪz/","a":"en-us-toys.ogg","l":"toy","q":"noun"},"slips":{"h":"slips","l":"slip","q":"noun"},"harvests":{"h":"harvests","l":"harvest","q":"noun"},"meats":{"h":"meats","l":"meat","q":"noun"},"shows":{"h":"shows","i":"/ʃəʊz/","a":"en-us-shows.ogg","l":"show","q":"noun"},"jugs":{"h":"jugs","i":"/dʒʌɡz/","a":"en-au-jugs.ogg","l":"jug","q":"noun"},"locks":{"h":"locks","i":"/lɒks/","a":"LL-Q1860 (eng)-Persent101-locks.wav","l":"lock","q":"noun"},"babe