:[{"m":"(countable) A prerequisite is something you need to get something else.","e":"This college has many prerequisites."}]}]},"circuit":{"h":"circuit","i":"/ˈsɜː.kɪt/","a":"en-us-circuit.ogg","s":[{"p":"noun","d":[{"m":"(countable) A circuit is a loop that normally starts and finishes in the same place.","e":"They ran a circuit around the park."},{"m":"(countable) A circuit is a closed route where electricity flows.","e":"The electric circuit can hold 20 amperes."}]}]},"circuits":{"h":"circuits","l":"circuit","q":"noun"},"prerequisites":{"h":"prerequisites","l":"prerequisite","q":"noun"},"naive":{"h":"naive","i":"/naɪˈiv/","a":"en-us-naive.ogg","s":[{"p":"adjective","d":[{"m":"If someone is naive, they do not have experience.","e":"Because of his rash decisions, everyone said he was a naive person."}]}]},"prompt":{"h":"prompt","i":"/prɒmpt/","a":"LL-Q1860 (eng)-Vealhurl-prompt.wav","s":[{"p":"adjective","d":[{"m":"If something or someone is prompt, then they are very quick.","e":"He was very prompt at getting a new job."},{"m":"If someone is prompt, then they do things on time."}]},{"p":"verb","d":[{"m":"If someone prompts, they lead or help someone to do something.","e":"I prompted him when he could not answer the question."}]},{"p":"noun","d":[{"m":"(countable) In the classroom, a prompt is the direction paragraph that tells you what to do. Usually, the prompt is the instructions that lead or help you to write an assignment.","e":"Reread the writing prompt if you are confused about what to write."}]}]},"prompts":{"h":"prompts","l":"prompt","q":"verb"},"prompted":{"h":"prompted","l":"prompt","q":"verb"},"prompting":{"h":"prompting","l":"prompt","q":"verb"},"hockey":{"h":"hockey","i":"/ˈhɒki/","a":"en-us-hockey.ogg","s":[{"p":"noun","d":[{"m":"In North America, hockey means ice hockey which is a game on ice in which two teams of six players skate and try to score by shooting a puck into the opposing team's net, using their sticks."},{"m":"In Europe, hockey means 