":"LL-Q1860 (eng)-Vealhurl-puffin.wav","s":[{"p":"noun","d":[{"m":"(countable) A puffin is a type of bird."}]}]},"betray":{"h":"betray","i":"/bəˈtreɪ/","a":"en-us-betray.ogg","s":[{"p":"verb","d":[{"m":"If you betray someone, you cause great harm to someone who considered you a friend or ally.","e":"We were betrayed when he defected to the enemy."}]}]},"translocation":{"h":"translocation","s":[{"p":"noun","d":[{"m":"The change of location and movement of something to some place else."}]}]},"translocations":{"h":"translocations","l":"translocation","q":"noun"},"comrade":{"h":"comrade","i":"/ˈkɒmreɪd/","a":"LL-Q1860 (eng)-Vealhurl-comrade.wav","s":[{"p":"noun","d":[{"m":"(countable) A comrade is a friend; a companion."},{"m":"(countable) A comrade is a friend during a battle.","e":"The three musketeers are comrades in adventure."},{"m":"(countable) (Communism) A comrade is a fellow communist."}]}]},"betrays":{"h":"betrays","l":"betray","q":"verb"},"betrayed":{"h":"betrayed","i":"/bɪˈtreɪd/","a":"en-us-betrayed.ogg","l":"betray","q":"verb"},"betraying":{"h":"betraying","l":"betray","q":"verb"},"comrades":{"h":"comrades","i":"/ˈkɒmreɪdz/","a":"en-us-comrades.ogg","l":"comrade","q":"noun"},"initiators":{"h":"initiators","l":"initiator","q":"noun"},"puffins":{"h":"puffins","l":"puffin","q":"noun"},"fluvial":{"h":"fluvial","s":[{"p":"adjective","d":[{"m":"When something is fluvial, it is connected in some way to a river or a few rivers.","e":"When rocks are described as fluvial, it means they were laid down in or near a river."}]}]},"observers":{"h":"observers","l":"observer","q":"noun"},"annexes":{"h":"annexes","l":"annex","q":"verb"},"annexed":{"h":"annexed","l":"annex","q":"verb"},"annexing":{"h":"annexing","l":"annex","q":"verb"},"artifices":{"h":"artifices","l":"artifice","q":"noun"},"storylines":{"h":"storylines","l":"storyline","q":"noun"},"separation":{"h":"separation","i":"/sɛpəˈreɪʃən/","a":"en-us-separation.ogg","s":[{"p":"noun","d":[{"m":"Separation is the time when two things are apart and separated."}]}]},"separations":{"h":"separations","l":"separation","q":"noun"},"niralee":{"h":"Niralee","s":[{"p":"proper noun","d":[{"m":"Niralee is a female given name."}]}]},"manor":{"h":"manor","i":"/ˈmænə/","a":"en-au-manor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A large amount of land owned by a nobleman or wealthy person"},{"m":"(countable) A large house owned by a nobleman or wealthy person"}]}]},"manors":{"h":"manors","l":"manor","q":"noun"},"moaner":{"h":"moaner","s":[{"p":"noun","d":[{"m":"(countable) A moaner is someone or something that moans."}]}]},"moaners":{"h":"moaners","l":"moaner","q":"noun"},"blinders":{"h":"blinders","l":"blinder","q":"noun"},"datedly":{"h":"datedly","s":[{"p":"adverb","d":[{"m":"In a dated way.","e":"He used the term datedly."}]}]},"stereotype":{"h":"stereotype","i":"/ˈstɛ.ri.əˌtaɪp/","a":"LL-Q1860 (eng)-Vealhurl-stereotype.wav","s":[{"p":"noun","d":[{"m":"To think of something or someone in one particular way, usually in a negative way.","e":"To say that all Chinese eat rice is a stereotype, because not all of them do."}]}]},"glorify":{"h":"glorify","i":"/ˈɡlɔrɪfaɪ/","a":"LL-Q1860 (eng)-Vealhurl-glorify.wav","s":[{"p":"verb","d":[{"m":"(transitive) To exalt, or give glory or praise to something or someone.","e":"Fans glorify their favorite divas."},{"m":"(transitive) To make something or someone appear to be more glorious than it or he is.","e":"Little Rastus' momma glorified his third place win in the kindergarten spelling bee."},{"m":"(transitive) To worship or extol.","e":"News reporters glorify events barely worth notice."}]}]},"presentation":{"h":"presentation","i":"/ˌprɛzənˈteɪʃən/","a":"LL-Q1860 (eng)-Back ache-presentation.wav","s":[{"p":"noun","d":[{"m":"(countable) To show or speak in public about something, usually done in a formal way.","e":"The professor gave a presentation to a group of doctors on the benefits of universal healthcare."},{"m":"(countable) An award or reward given out, usually at a ceremony or meeting.","e":"The Oscars Ceremony is a presentation of golden statues to the best people in the film industry."}]}]},"jargon":{"h":"jargon","i":"/ˈdʒɑr.ɡən/","a":"en-us-jargon.ogg","s":[{"p":"noun","d":[{"m":"Words found within a language that may be used quite commonly by a specific group of people.","e":"Doctors use many medical jargons that the rest of the population do not always understand."}]}]},"gigantic":{"h":"gigantic","i":"/dʒaɪˈɡæntɪk/","a":"LL-Q1860 (eng)-Vealhurl-gigantic.wav","s":[{"p":"adjective","d":[{"m":"Something that, when it is described, is even bigger than the word \"large\". Something that is very, very large.","e":"When it comes to canyon formations, the Grand Canyon is gigantic."}]}]},"beckon":{"h":"beckon","i":"/ˈbɛkən/","a":"LL-Q1860 (eng)-Vealhurl-beckon.wav","s":[{"p":"verb","d":[{"m":"To wave and/or to nod to anyone with a plan or intention to encourage the person come closer.","e":"The saleswoman beckoned to the man who might buy what she wanted to sell."}]}]},"douchebag":{"h":"douchebag","s":[{"p":"noun","d":[{"m":"A small syringe having detachable nozzles for fluid injections"},{"m":"An arrogant or annoying person. Commonly, used as an insult. Also called douche."}]}]},"soundtrack":{"h":"soundtrack","s":[{"p":"noun","d":[{"m":"(countable) A soundtrack is the sound (especially the music) from a movie.","e":"The movie's soundtrack was composed by."},{"m":"(countable) A soundtrack is the recording of a movie's music for sale."}]}]},"pogrom":{"h":"pogrom","i":"/ˈpɒɡrəm/","a":"en-us-pogrom.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pogrom is a violent riot, usually against ethnic or religious groups."}]}]},"stereotypes":{"h":"stereotypes","l":"stereotype","q":"noun"},"glorifies":{"h":"glorifies","l":"glorify","q":"verb"},"glorified":{"h":"glorified","a":"en-us-glorified.ogg","l":"glorify","q":"verb"},"glorifying":{"h":"glorifying","l":"glorify","q":"verb"},"presentations":{"h":"presentations","l":"presentation","q":"noun"},"jargons":{"h":"jargons","l":"jargon","q":"noun"},"strive":{"h":"strive","i":"/ˈstraɪv/","a":"en-us-strive.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If you strive, you struggle or try something very hard.","e":"India had strived for independence."}]}]},"bunker":{"h":"bunker","i":"/ˈbʌŋkɚ/","a":"en-au-bunker.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bunker is a shelter that is sometimes underground. It can be used to protect people during an attack.","e":"The army forced us into the bunker as the warplanes flew overhead."}]}]},"bunkers":{"h":"bunkers","l":"bunker","q":"noun"},"strives":{"h":"strives","l":"strive","q":"verb"},"strived":{"h":"strived","i":"/ˈstraɪvd/","a":"LL-Q1860 (eng)-Vealhurl-strived.wav","l":"strive","q":"verb"},"striving":{"h":"striving","i":"/ˈstraɪvɪŋ/","a":"en-us-striving.ogg","l":"strive","q":"verb"},"strove":{"h":"strove","i":"/ˈstrɔʊv/","a":"LL-Q1860 (eng)-Vealhurl-strove.wav","l":"strive","q":"verb"},"striven":{"h":"striven","i":"/ˈstrɪvən/","l":"strive","q":"verb"},"tryst":{"h":"tryst","a":"en-us-tryst.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tryst is a prearranged meeting between lovers to meet at a specific place and time.","e":"The two arranged a tryst while their spouses were out of town."}]},{"p":"verb","d":[{"m":"(intransitive) To agree to meet at a place.","e":"The lovers will tryst in a place far from town."},{"m":"(transitive) To arrange or appoint (a meeting time etc.)."},{"m":"(intransitive) To meet at an agreed place and time.","e":"The two trysted in a dark place far out of town."}]}]},"pederasty":{"h":"pederasty","i":"/ˈpɛd.ɛrəs.ti/","s":[{"p":"noun","d":[{"m":"(uncountable) Pederasty is the erotic love, sexually expressed or chaste, between a man and an adolescent boy; male version of korephilia."},{"m":"(uncountable) Pederasty is anal intercourse in general, usually between a man and an adolescent boy."}]}]},"pederastic":{"h":"pederastic","s":[{"p":"adjective","d":[{"m":"Relating to a man's erotic love for adolescent boys (male version of korephilia)."},{"m":"In a manner which suggests pederasty (male korephilia)."}]}]},"pedophile":{"h":"pedophile","i":"/ˈpi.dəˌfaɪl/","a":"en-uk-paedophile.ogg","s":[{"p":"noun","d":[{"m":"(countable) In general use, a pedophile is an adult who is sexually attracted to or commits sexual acts against a minor."}]}]},"pedophilic":{"h":"pedophilic","s":[{"p":"adjective","d":[{"m":"Of, relating, or pertaining to pedophilia."}]}]},"pedophilia":{"h":"pedophilia","i":"/piːdəˈfɪlɪə/","s":[{"p":"noun","d":[{"m":"In general use, pedophilia is an adult's sexual act against or sexual attraction to a child.","e":"Pedophilia causes problems in children who are victims of it."}]}]},"colonnade":{"h":"colonnade","s":[{"p":"noun","d":[{"m":"A colonnade is a series of columns at regular intervals."}]}]},"beckons":{"h":"beckons","l":"beckon","q":"verb"},"beckoned":{"h":"beckoned","i":"/ˈbɛkənd/","a":"en-us-beckoned.ogg","l":"beckon","q":"verb"},"beckoning":{"h":"beckoning","l":"beckon","q":"verb"},"douchebags":{"h":"douchebags","l":"douchebag","q":"noun"},"soundtracks":{"h":"soundtracks","l":"soundtrack","q":"noun"},"pogroms":{"h":"pogroms","l":"pogrom","q":"noun"},"trysts":{"h":"trysts","l":"tryst","q":"noun"},"trysted":{"h":"trysted","l":"tryst","q":"verb"},"trysting":{"h":"trysting","l":"tryst","q":"verb"},"pedophiles":{"h":"pedophiles","l":"pedophile","q":"noun"},"pedophilias":{"h":"pedophilias","l":"pedophilia","q":"noun"},"colonnades":{"h":"colonnades","l":"colonnade","q":"noun"},"bun":{"h":"bun","a":"en-au-bun.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bun is a small bread roll.","e":"I got a bun from the nearby bakery shop."},{"m":"(countable) A bun is a small, round cake.","e":"The bun is very sweet."},{"m":"(countable) A bun is a style of hair done when you tie it with a knot at the back of your head."}]},{"p":"verb","d":[{"m":"(transitive) If you bun your hair, you form it into a [[#Noun|bun]]."}]}]},"buns":{"h":"buns","l":"bun","q":"noun","s":[{"p":"noun","d":[{"m":"(childish) The buttocks."}]}]},"bubble":{"h":"bubble","a":"en-us-bubble.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bubble is a volume of air trapped in a liquid and can float in the air.","e":"The girl made a really big soap bubble."}]},{"p":"verb","d":[{"m":"(intransitive) If something bubbles, it makes bubbles or begins to turn into a bubble.","e":"Wait until the water bubbles before turning off the stove."},{"m":"(intransitive) If something bubbles, it begins forming or is created.","e":"bubbled inside of him."}]}]},"bubbles":{"h":"bubbles","l":"bubble","q":"noun"},"facsimile":{"h":"facsimile","i":"/fækˈsɪm.ɪ.li/","s":[{"p":"noun","d":[{"m":"(countable) A facsimile is an exact copy.","e":"A facsimile of the design was sent to me."}]}]},"facsimiles":{"h":"facsimiles","l":"facsimile","q":"noun"},"featherfoot":{"h":"featherfoot","s":[{"p":"noun","d":[{"m":"(Australian) An Aboriginal sorcerer, an evil spirit."}]}]},"featherfoots":{"h":"featherfoots","l":"featherfoot","q":"noun"},"sorcerer":{"h":"sorcerer","i":"/ˈsɔːsərə(r)/","s":[{"p":"noun","d":[{"m":"(countable) In fiction or mythology, a sorcerer is a person who uses magical powers."}]}]},"sorcerers":{"h":"sorcerers","l":"sorcerer","q":"noun"},"scarf":{"h":"scarf","i":"/skɑːf/","a":"en-au-scarf.ogg","s":[{"p":"noun","d":[{"m":"(countable) A scarf is a long item of clothing to wrap around the neck.","e":"Wear a scarf, it is cold outside."}]}]},"scarves":{"h":"scarves","l":"scarf","q":"noun"},"scarfs":{"h":"scarfs","l":"scarf","q":"noun"},"daydream":{"h":"daydream","i":"/ˈdeɪdriːm/","s":[{"p":"noun","d":[{"m":"(countable) A daydream is a dream you have in the daytime. Sometimes they happen when you are napping, and sometimes they happen when you are awake.","e":"My daydream was about changing Wikipedia."}]},{"p":"verb","d":[{"m":"When you daydream, you have a [[#Noun|daydream]].","e":"Professor Sampson caught Carly daydreaming about Justin Bieber in class."}]}]},"heck":{"h":"heck","i":"/hɛk/","a":"LL-Q1860 (eng)-Vealhurl-heck.wav","s":[{"p":"interjection","d":[{"m":"Heck is a word used instead of the swear word \"hell\".","e":"\"Do you want to go ATV riding at Dead Man's Bluff?\" \"I don't know...Oh, what the heck! Let's do it!\""}]}]},"daydreams":{"h":"daydreams","l":"daydream","q":"noun"},"daydreamed":{"h":"daydreamed","l":"daydream","q":"verb"},"daydreaming":{"h":"daydreaming","l":"daydream","q":"verb"},"napped":{"h":"napped","l":"nap","q":"verb"},"napping":{"h":"napping","l":"nap","q":"verb"},"daytime":{"h":"daytime","i":"/ˈdeɪtaɪm/","a":"LL-Q1860 (eng)-Vealhurl-daytime.wav","s":[{"p":"noun","d":[{"m":"Period from sunrise to sunset."}]}]},"charisma":{"h":"charisma","i":"/kəˈrɪzmə/","a":"LL-Q1860 (eng)-Vininn126-charisma.wav","s":[{"p":"noun","d":[{"m":"Charisma is the special ability to lead."},{"m":"A person who is excitable, and motivating."},{"m":"Bright disposition, colorful speaker expressive and very likeable, charming.","e":"The young man had charisma, women loved him and men wanted to be him."}]}]},"charismas":{"h":"charismas","l":"charisma","q":"noun"},"epigram":{"h":"epigram","i":"/ˈɛpɪɡræm/","a":"en-us-epigram.ogg","s":[{"p":"noun","d":[{"m":"(countable) An epigram is a short (often two-line) poem which makes a point.","e":"Little strokes"},{"m":"(countable) An epigram is a short, witty saying.","e":"The good ended happily, and the bad unhappily. That is what 'fiction' means. (Oscar Wilde in The Importance of Being Earnest)"}]}]},"epigrams":{"h":"epigrams","l":"epigram","q":"noun"},"camouflage":{"h":"camouflage","i":"/ˈkæ.mə.ˌflɑːʒ/","a":"LL-Q1860 (eng)-Vealhurl-camouflage.wav","s":[{"p":"verb","d":[{"m":"When you camouflage something, you disguise it with paint or a cover so that it cannot be easily seen.","e":"The man camouflaged himself with a green, black and brown jacket, so no-one saw him in the forest."}]}]},"symbiosis":{"h":"symbiosis","s":[{"p":"noun","d":[{"m":"A symbiosis is a relationship between two organism where they both benefit."}]}]},"camouflages":{"h":"camouflages","l":"camouflage","q":"verb"},"camouflaged":{"h":"camouflaged","i":"/ˈkæm.ə.flɑːʒd/","a":"en-us-camouflaged.ogg","l":"camouflage","q":"verb"},"camouflaging":{"h":"camouflaging","l":"camouflage","q":"verb"},"symbioses":{"h":"symbioses","l":"symbiosis","q":"noun"},"overtime":{"h":"overtime","i":"/ˈəʊ.və.taɪm/","a":"LL-Q1860 (eng)-Vealhurl-overtime.wav","s":[{"p":"noun","d":[{"m":"An overtime is an extra period of time that is played when two teams end regulation (the normal number of periods) tied.","e":"With Boston and Miami tied at 86, we're going into overtime!"},{"m":"In business, overtime is the time a person is paid to work that is beyond what they normally work.","e":"The boss paid Jerry overtime to work a night shift at the warehouse"}]}]},"overtimes":{"h":"overtimes","l":"overtime","q":"noun"},"spear":{"h":"spear","i":"/spɪə̯(r)/","a":"en-us-spear.ogg","s":[{"p":"noun","d":[{"m":"(countable) A spear is a long stick that is sharp at one or both ends and is used as a weapon.","e":"Everyone in the Spartan Army carried a spear into battle"},{"m":"(countable) A spear is a piece of asparagus or other vegetables that looks like a spear.","e":"At the fancy restaurant, I had a steak with a side of asparagus spears"}]},{"p":"verb","d":[{"m":"To spear is to stab someone or something with a spear.","e":"The Cree used to spear fish."}]}]},"spears":{"h":"spears","i":"/spɪə̯(r)z/","a":"en-us-spears.ogg","l":"spear","q":"noun"},"speared":{"h":"speared","l":"spear","q":"verb"},"spearing":{"h":"spearing","l":"spear","q":"verb"},"asparagus":{"h":"asparagus","i":"/əˈspær.ə.ɡəs/","a":"en-us-asparagus.ogg","s":[{"p":"noun","d":[{"m":"(countable) The shoots of the plant Asparagus officinalis eaten as a vegetable."},{"m":"(uncountable) Asparagus is a green color that is like an asparagus."}]}]},"asparaguses":{"h":"asparaguses","l":"asparagus","q":"noun"},"carrots":{"h":"carrots","l":"carrot","q":"noun"},"theoretical":{"h":"theoretical","i":"/ˌθiəˈrɛtɪkl/","a":"en-us-theoretical.ogg","s":[{"p":"adjective","d":[{"m":"Theoretical is about theory rather than its practical application.","e":"Entanglement is important but difficult to study, both in terms of a theoretical understanding and doing experiments."}]}]},"daytimes":{"h":"daytimes","l":"daytime","q":"noun"},"crayfish":{"h":"crayfish","i":"/ˈkreɪˌfɪʃ/","a":"en-us-crayfish.ogg","s":[{"p":"noun","d":[{"m":"A crayfish is a smaller version of the lobster found in warm waters."}]}]},"crayfishes":{"h":"crayfishes","l":"crayfish","q":"noun"},"dunce":{"h":"dunce","s":[{"p":"noun","d":[{"m":"(countable) A dunce is someone who is not that smart."}]}]},"dunces":{"h":"dunces","l":"dunce","q":"noun"},"slough":{"h":"slough","i":"/slʌf/","a":"en-us-slough2.ogg","s":[{"p":"noun","d":[{"m":"(countable) A slough is the skin shed by a snake."},{"m":"(countable) A slough is a dead skin on a sore or ulcer"},{"m":"(countable) A slough is a swamp or shallow lake"}]},{"p":"verb","d":[{"m":"(transitive) If something sloughs its skin, it sheds it.","e":"The snake sloughed its skin."}]}]},"sloughed":{"h":"sloughed","l":"slough","q":"verb"},"sloughing":{"h":"sloughing","l":"slough","q":"verb"},"sloughs":{"h":"sloughs","l":"slough","q":"noun"},"godly":{"h":"godly","i":"/ˈɡɑdli/","a":"en-us-godly.ogg","s":[{"p":"adjective","d":[{"m":"Godly describes something or someone who is like God.","e":"Jesus walked on water in a godly occurrence."},{"m":"Something is godly when it is gloriously good.","e":"The meal tastes godly."}]}]},"godlier":{"h":"godlier","l":"godly","q":"adjective"},"godliest":{"h":"godliest","l":"godly","q":"adjective"},"suffocate":{"h":"suffocate","a":"LL-Q1860 (eng)-Vealhurl-suffocate.wav","s":[{"p":"verb","d":[{"m":"(intransitive) To suffocate is the action of dying from lack of air.","e":"The fish suffocated for lack of oxygen."}]}]},"suffocates":{"h":"suffocates","l":"suffocate","q":"verb"},"suffocated":{"h":"suffocated","l":"suffocate","q":"verb"},"suffocating":{"h":"suffocating","l":"suffocate","q":"verb"},"curb":{"h":"curb","a":"LL-Q1860 (eng)-Vealhurl-curb.wav","s":[{"p":"noun","d":[{"m":"(countable) A curb is a stone or concrete edging between a sidewalk and a road.","e":"I stubbed my toe on the curb when crossing the street."}]},{"p":"verb","d":[{"m":"(transitive) To curb means to check or restrain or control.","e":"His parents tried to curb his late hours."},{"m":"To rein in."},{"m":"To furnish with a curb."},{"m":"To force to \"bite the curb\" (hit the pavement curb); see curb stomp."},{"m":"To damage vehicle wheels or tires by running into or over a pavement curb."}]}]},"curbs":{"h":"curbs","l":"curb","q":"noun"},"curbed":{"h":"curbed","l":"curb","q":"verb"},"curbing":{"h":"curbing","l":"curb","q":"verb"},"preside":{"h":"preside","i":"/prɪˈzʌɪd/","a":"LL-Q1860 (eng)-Vealhurl-preside.wav","s":[{"p":"verb","d":[{"m":"(intransitive) Preside means to sit as an authority over, to control or to rule.","e":"John Smith will preside over the meeting."}]}]},"presides":{"h":"presides","l":"preside","q":"verb"},"presided":{"h":"presided","l":"preside","q":"verb"},"presiding":{"h":"presiding","l":"preside","q":"verb"},"layout":{"h":"layout","i":"/ˈleɪaʊt/","a":"LL-Q1860 (eng)-Vealhurl-layout.wav","s":[{"p":"noun","d":[{"m":"(countable) A layout is the way items are arranged.","e":"The layout of this page is cluttered."}]}]},"layouts":{"h":"layouts","l":"layout","q":"noun"},"gospel":{"h":"gospel","i":"/ˈgɒsp(ə)l/","a":"LL-Q1860 (eng)-Vealhurl-gospel.wav","s":[{"p":"noun","d":[{"m":"(countable) A gospel is a part or text of the New Testament that tells the life of Jesus","e":"Today's topic in the church was John's gospel."},{"m":"(countable) A gospel is a message which will probably have a positive effect."},{"m":"(uncountable) Gospel is a kind of music.","e":"In church, the choir sang a gospel."}]}]},"gospels":{"h":"gospels","l":"gospel","q":"noun"},"finale":{"h":"finale","i":"/fɪˈnɑː.li/","a"