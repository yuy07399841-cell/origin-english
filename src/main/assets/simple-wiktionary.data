int.ogg","s":[{"p":"noun","d":[{"m":"A peppermint hybrid herb of the mint family."},{"m":"(countable) A confection containing extract of peppermint."}]}]},"peppermints":{"h":"peppermints","l":"peppermint","q":"noun"},"hybrid":{"h":"hybrid","i":"/ˈhaɪ.brɪd/","a":"en-us-hybrid.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hybrid is an offspring of two different organisms of different species or varieties.","e":"A mule is a hybrid of a donkey and a horse."},{"m":"(countable) A hybrid is a something that is made by two different elements. A mixture."}]}]},"hybrids":{"h":"hybrids","l":"hybrid","q":"noun"},"musketeer":{"h":"musketeer","s":[{"p":"noun","d":[{"m":"A musketeer is a foot soldier who is armed with a musket."},{"m":"In 17th- and 18th-century France, a member of the royal household bodyguard."}]}]},"musketeers":{"h":"musketeers","l":"musketeer","q":"noun"},"musket":{"h":"musket","i":"/ˈmʌskət/","a":"LL-Q1860 (eng)-Vealhurl-musket.wav","s":[{"p":"noun","d":[{"m":"(countable) A musket is a kind of firearm with a long barrel, typically smooth-bored and fired from the shoulder."}]}]},"muskets":{"h":"muskets","l":"musket","q":"noun"},"bayonet":{"h":"bayonet","i":"/ˈbeɪə(ʊ)nɨt/","a":"LL-Q1860 (eng)-Vealhurl-bayonet.wav","s":[{"p":"noun","d":[{"m":"(countable) A bayonet is a blade that can be installed to the muzzle of a rifle and used to stab an opponent in close-combat fighting."}]},{"p":"verb","d":[{"m":"(transitive) If you bayonet someone, you stab with a [[#Noun|bayonet]]."}]}]},"bayonets":{"h":"bayonets","l":"bayonet","q":"noun"},"bayonetted":{"h":"bayonetted","l":"bayonet","q":"verb"},"bayoneted":{"h":"bayoneted","l":"bayonet","q":"verb"},"bayonetting":{"h":"bayonetting","l":"bayonet","q":"verb"},"bayoneting":{"h":"bayoneting","l":"bayonet","q":"verb"},"militia":{"h":"militia","i":"/məˈlɪʃə/","a":"en-us-militia.ogg","s":[{"p":"noun","d":[{"m":"(countable) A militia is a civilian army that can be called upon in time of need."},{"m":"(countable) A militia is a pr