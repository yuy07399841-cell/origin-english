omach and intestines"},{"m":"To read and then think about"}]}]},"digests":{"h":"digests","l":"digest","q":"noun"},"digested":{"h":"digested","l":"digest","q":"verb"},"digesting":{"h":"digesting","l":"digest","q":"verb"},"spruce":{"h":"spruce","i":"/spruːs/","a":"en-us-spruce.ogg","s":[{"p":"noun","d":[{"m":"(countable) A spruce is a kind of evergreen tree.","e":"That spruce is very tall."}]}]},"coyote":{"h":"coyote","i":"/kəˈjoʊti/","a":"en-us-coyote.ogg","s":[{"p":"noun","d":[{"m":"(countable) A coyote is an animal in the wolf family.","e":"The coyote ran across the field."}]}]},"spruces":{"h":"spruces","l":"spruce","q":"noun"},"elk":{"h":"elk","i":"/ɛlk/","a":"en-us-elk.ogg","s":[{"p":"noun","d":[{"m":"(countable) An elk is a kind of large deer with antlers","e":"The elk walked into the forest"}]}]},"keg":{"h":"keg","s":[{"p":"noun","d":[{"m":"A keg is a kind of barrel.","e":"The keg has beer in it."}]}]},"immunize":{"h":"immunize","s":[{"p":"verb","d":[{"m":"To immunize is to give a person a vaccine to protect him/her against an illness.","e":"These shots will immunize me against the flu."}]}]},"imperative":{"h":"imperative","i":"/ɪmˈpɛr.ə.tɪv/","a":"LL-Q1860 (eng)-Vealhurl-imperative.wav","s":[{"p":"noun","d":[{"m":"An imperative is the mood of a verb that is a command.","e":"\"Come here\" is an imperative."}]},{"p":"adjective","d":[{"m":"If something is imperative, it is very important."}]}]},"inadequate":{"h":"inadequate","i":"/ɪnˈædəkwɪt/","a":"LL-Q1860 (eng)-Vealhurl-inadequate.wav","s":[{"p":"adjective","d":[{"m":"If something is inadequate, there is not enough of it. Something that is inadequate is lacking.","e":"We have an inadequate amount of food to last us three days."}]}]},"distortion":{"h":"distortion","s":[{"p":"noun","d":[{"m":"A distortion is a change to the original (or normal) shape (or characteristic) of something. It can apply to objects, images, sounds, or information.","e":"He told her the story, but it was a distortion of the truth."}]}]},"sunflower":{"h":"sunflower","i":"/ˈsʌn.ˌflaʊ.ɚ/","a":"LL-Q1860 (eng)-Vealhurl-sunflower.wav","s":[{"p":"noun","d":[{"m":"(countable) A sunflower is a large yellow flower that sprouts every year."},{"m":"(uncountable) Sunflower is a bright yellow colour, like those of the petals of the flower."}]}]},"sedge":{"h":"sedge","s":[{"p":"noun","d":[{"m":"A sedge is a grass-like plant such as papyrus."}]}]},"sedges":{"h":"sedges","l":"sedge","q":"noun"},"sunflowers":{"h":"sunflowers","l":"sunflower","q":"noun"},"distortions":{"h":"distortions","l":"distortion","q":"noun"},"immunizes":{"h":"immunizes","l":"immunize","q":"verb"},"immunized":{"h":"immunized","l":"immunize","q":"verb"},"immunizing":{"h":"immunizing","l":"immunize","q":"verb"},"imperatives":{"h":"imperatives","l":"imperative","q":"noun"},"kegs":{"h":"kegs","l":"keg","q":"noun"},"coyotes":{"h":"coyotes","l":"coyote","q":"noun"},"jumble":{"h":"jumble","i":"/dʒʌmbəl/","a":"en-us-jumble.ogg","s":[{"p":"noun","d":[{"m":"(countable) A jumble is a group of things that are all mixed up."}]},{"p":"verb","d":[{"m":"To jumble something is to mix it up.","e":"The puzzle pieces have been jumbled."}]}]},"webisode":{"h":"webisode","s":[{"p":"noun","d":[{"m":"(countable) A webisode is an episode of a show that can be watched over the internet instead of on the TV."}]}]},"webisodes":{"h":"webisodes","l":"webisode","q":"noun"},"wobblier":{"h":"wobblier","l":"wobbly","q":"adjective"},"wobbliest":{"h":"wobbliest","l":"wobbly","q":"adjective"},"kin":{"h":"kin","i":"/kɪn/","a":"en-us-kin.ogg","s":[{"p":"noun","d":[{"m":"Your kin are the people in your family."}]}]},"kidnap":{"h":"kidnap","i":"/ˈkɪdnæp/","a":"LL-Q1860 (eng)-Vealhurl-kidnap.wav","s":[{"p":"verb","d":[{"m":"When you kidnap someone, you take the person away, usually to demand for money as a ransom."}]},{"p":"noun","d":[{"m":"A kidnap refers to the act of taking someone away, to [[#Verb|kidnap]] someone."}]}]},"kerb":{"h":"kerb","i":"/kɝb/","a":"en-au-kerb.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kerb is a stone edging to a pavement or sidewalk."}]}]},"banter":{"h":"banter","i":"/ˈbæntə/","a":"en-us-banter.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) An exchange of playful remarks."}]},{"p":"verb","d":[{"m":"To talk in a playful or way.","e":"We were bantering for hours."}]}]},"bantered":{"h":"bantered","l":"banter","q":"verb"},"bantering":{"h":"bantering","l":"banter","q":"verb"},"banters":{"h":"banters","l":"banter","q":"verb"},"laden":{"h":"laden","s":[{"p":"adjective","d":[{"m":"When something is laden, it has a heavy weight."},{"m":"Words that are laden carry something heavy in its meaning.","e":"That philosopher's words were laden with wise words."}]}]},"ladle":{"h":"ladle","s":[{"p":"noun","d":[{"m":"A ladle is a large, long-handled spoon"}]}]},"landlady":{"h":"landlady","i":"/ˈlændˌleɪ.di/","a":"LL-Q1860 (eng)-Vealhurl-landlady.wav","s":[{"p":"noun","d":[{"m":"(countable) A landlady is a woman who rents out land or a building."}]}]},"ladles":{"h":"ladles","l":"ladle","q":"noun"},"squash":{"h":"squash","i":"/skwɒʃ/","a":"en-us-squash.ogg","s":[{"p":"verb","d":[{"m":"To squash is to press something into a smaller space, or to put weight onto it.","e":"He sat on the balloon and squashed it."}]},{"p":"noun","d":[{"m":"(uncountable) Squash is a fast game played indoors with a small ball and a racquet.","e":"He was a great squash player."},{"m":"(countable) A squash is a type of plant that has edible fruits."}]}]},"catamount":{"h":"catamount","s":[{"p":"noun","d":[{"m":"a catamount is a wildcat with a short tail","e":"the catamount paced back and forth"}]}]},"porous":{"h":"porous","i":"/ˈpɔːrəs/","a":"en-au-porous.ogg","s":[{"p":"adjective","d":[{"m":"A porous object is one with a lot of holes or spaces in it that allows liquids and gases to pass through.","e":"Some kinds of rock are so porous that water goes right through it."},{"m":"A law that is filled with loopholes.","e":"Drugs easily enter the country because of its porous borders."}]}]},"portray":{"h":"portray","i":"/pɔrˈtreɪ/","a":"LL-Q1860 (eng)-Vealhurl-portray.wav","s":[{"p":"verb","d":[{"m":"When you portray something, you create a picture of it by painting or drawing.","e":"The artist portrayed the bustling life of the city very uniquely in his latest artwork."},{"m":"When you portray something, you are trying to describe and explain it in words so that you can convey it to other people.","e":"The witness was at the police station and trying to portray what he saw during the accident."},{"m":"When someone portrays a character, the person is acting as the character.","e":"He managed to portray Shakespeare in a very interesting way and the audience really liked it."},{"m":"When you portray something, you decorate it with pictures."}]}]},"asbestos":{"h":"asbestos","i":"/ˈæs.bɛs.tɒs/","s":[{"p":"noun","d":[{"m":"(uncountable) Asbestos is a mineral which is found naturally in all parts of the world. It is fibrous, heat resistant and non-flammable. The small fibres can cause cancer when in the lungs."}]}]},"heterosexual":{"h":"heterosexual","i":"/ˌhɛtərəˈsɛkʃuəl/","a":"LL-Q1860 (eng)-Vealhurl-heterosexual.wav","s":[{"p":"adjective","d":[{"m":"Someone who is heterosexual is attracted to people of the opposite sex. That means a heterosexual man is attracted to women, and a heterosexual woman is attracted to men."}]},{"p":"noun","d":[{"m":"someone who is heterosexual","e":"John is definitely a heterosexual, despite the nasty rumors."}]}]},"colony":{"h":"colony","i":"/ˈkɒ.lə.ni/","a":"en-us-colony.ogg","s":[{"p":"noun","d":[{"m":"(countable) A colony is a place that is settled by people from another place.","e":"The Amana Colonies in Iowa were settled by people from New York and Germany"},{"m":"(countable) A colony is a group of organisms of same or different species living together in close association.","e":"An ant colony is a large group of ants that live together"}]}]},"colonies":{"h":"colonies","a":"en-us-colonies.ogg","l":"colony","q":"noun"},"plumber":{"h":"plumber","i":"/ˈplʌmə/","a":"LL-Q1860 (eng)-Vealhurl-plumber.wav","s":[{"p":"noun","d":[{"m":"(countable) A plumber is someone who installs and fixes pipes and drains to carry water, sewage and gas.","e":"We had to call a plumber because the bathroom sink was leaking."}]}]},"bromine":{"h":"bromine","i":"/ˈbrəʊmiːn, -mɪn, -maɪn/","a":"LL-Q1860 (eng)-Vealhurl-bromine.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Bromine is an chemical element that has atomic number 35 and symbol Br. It is one of the halogens"},{"m":"(countable) A bromine is a bromine atom in a molecule."}]}]},"plumbers":{"h":"plumbers","l":"plumber","q":"noun"},"bromines":{"h":"bromines","l":"bromine","q":"noun"},"malleable":{"h":"malleable","a":"En-us-malleable.ogg","s":[{"p":"adjective","d":[{"m":"When something is malleable, it can be easily made into thin sheets and can be made into other shapes easily."},{"m":"Something that can be easily changed."}]}]},"majestic":{"h":"majestic","i":"/məˈdʒɛstɪk/","a":"en-us-majestic.ogg","s":[{"p":"adjective","d":[{"m":"When something is majestic, it is very beautiful and royal."}]}]},"majesty":{"h":"majesty","i":"/ˈmædʒ.əs.ti/","a":"en-us-majesty.ogg","s":[{"p":"noun","d":[{"m":"royal power, a title given to a king or queen, His -, Her –, Your -"}]}]},"nag":{"h":"nag","i":"/ˈnæɡ/","a":"LL-Q1860 (eng)-Vealhurl-nag.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you nag someone, you keep complaining to him because he does not do something."}]}]},"nanny":{"h":"nanny","i":"/ˈnæni/","s":[{"p":"noun","d":[{"m":"A nanny is a woman who looks after a child in its own home."}]}]},"nap":{"h":"nap","i":"/nap/","a":"LL-Q1860 (eng)-Vealhurl-knap.wav","s":[{"p":"noun","d":[{"m":"(countable) A nap is a short sleep, usually in the daytime.","e":"Jennifer picked up her son from preschool and put him in bed for his nap."},{"m":"(countable) A nap is a soft or fuzzy surface, generally on fabric."}]},{"p":"verb","d":[{"m":"When you nap, you sleep for a short period of time, especially during the day.","e":"I was having a severe headache and went to nap for a while."}]}]},"nappy":{"h":"nappy","i":"/ˈnæpi/","a":"en-us-nappy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A nappy is a diaper, baby's napkin for between their legs."}]},{"p":"adjective","d":[{"m":"Nappy hair is tightly curled."}]}]},"naval":{"h":"naval","i":"/ˈneɪvəl/","a":"en-us-naval.ogg","s":[{"p":"adjective","d":[{"m":"If something is naval, it is about a navy or navies.","e":"There is a naval station not far from here."}]}]},"nags":{"h":"nags","l":"nag","q":"verb"},"nagged":{"h":"nagged","l":"nag","q":"verb"},"nagging":{"h":"nagging","l":"nag","q":"verb"},"naps":{"h":"naps","a":"en-au-naps.ogg","l":"nap","q":"noun"},"nannies":{"h":"nannies","l":"nanny","q":"noun"},"majesties":{"h":"majesties","l":"majesty","q":"noun"},"cross-purpose":{"h":"cross-purpose","a":"en-au-cross-purpose.ogg","s":[{"p":"noun","d":[{"m":"A contrary purpose or a conflict in purpose or understanding, especially an unintentional one.","e":"We are working at cross-purposes here, if you're trying to reduce the count and I'm trying to increase it."}]}]},"mismatch":{"h":"mismatch","i":"/ˌmɪsˈmætʃ/","a":"LL-Q1860 (eng)-Vealhurl-mismatch.wav","s":[{"p":"verb","d":[{"m":"If you mismatch something, you match it with an unsuitable thing."}]},{"p":"noun","d":[{"m":"(countable) A mismatch is something that does not match with another thing; something not similar or not appropriate"}]}]},"studio":{"h":"studio","i":"/ˈstjuːdiəʊ/","a":"en-us-studio.ogg","s":[{"p":"noun","d":[{"m":"A studio is a place where an artist makes art"},{"m":"A studio is a place where art or music is taught"},{"m":"A studio is a place where radio or television shows, records or films are made."},{"m":"A studio is a small apartment"}]}]},"studios":{"h":"studios","l":"studio","q":"noun"},"oar":{"h":"oar","i":"/ɔr/","a":"en-us-oar.ogg","s":[{"p":"noun","d":[{"m":"(countable) An oar is a pole with a flat blade, used to row a boat.","e":"He pulled hard on the oar to make the boat go faster."}]}]},"oath":{"h":"oath","i":"/ˈəʊθ/","a":"en-us-oath.ogg","s":[{"p":"noun","d":[{"m":"(countable) An oath is a very serious promise."},{"m":"(countable) An oath is a swear word or curse."}]}]},"obey":{"h":"obey","i":"/oʊˈbeɪ/","a":"en-us-obey.ogg","s":[{"p":"verb","d":[{"m":"Obey is to do what a person tells you to do.","e":"Soldiers in the army must obey their officers."}]}]},"obedient":{"h":"obedient","i":"/əˈbiːdɪənt/","a":"en-us-obedient.ogg","s":[{"p":"adjective","d":[{"m":"An obedient person someone who is willing to do what others tells them to do."}]}]},"obligation":{"h":"obligation","i":"/ɑb.ləˈɡeɪ.ʃən/","a":"en-us-obligation.ogg","s":[{"p":"noun","d":[{"m":"An obligation is a duty, something you must do."}]}]},"oblong":{"h":"oblong","s":[{"p":"noun","d":[{"m":"(countable) An oblong is a rectangle (a polygon with four straight sides and 4 right angles) which is not a square (the length and height are different).","e":"The ancient Greeks used oblong shaped stones for their mosaic floors."}]}]},"obstacle":{"h":"obstacle","i":"/ˈɒbstəkl̩/","a":"en-us-obstacle.ogg","s":[{"p":"noun","d":[{"m":"(countable) An obstacle is something that blocks your way."}]}]},"obstinate":{"h":"obstinate","i":"/ˈɒb.stɪ.nət/","a":"en-us-obstinate.ogg","s":[{"p":"adjective","d":[{"m":"strongly refusing to change your opinion"}]}]},"obstruct":{"h":"obstruct","i":"/əbˈstrʌkt/","a":"LL-Q1860 (eng)-Vealhurl-obstruct.wav","s":[{"p":"verb","d":[{"m":"If something obstructs your way, it blocks your path from point A to point B."}]}]},"obstructs":{"h":"obstructs","l":"obstruct","q":"verb"},"obstructed":{"h":"obstructed","l":"obstruct","q":"verb"},"obstructing":{"h":"obstructing","l":"obstruct","q":"verb"},"obstacles":{"h":"obstacles","a":"En-us-obstacles.ogg","l":"obstacle","q":"noun"},"oblongs":{"h":"oblongs","l":"oblong","q":"noun"},"obligations":{"h":"obligations","l":"obligation","q":"noun"},"oars":{"h":"oars","a":"En-us-oars.ogg","l":"oar","q":"noun"},"oaths":{"h":"oaths","l":"oath","q":"noun"},"obeys":{"h":"obeys","l":"obey","q":"verb"},"obeyed":{"h":"obeyed","i":"/oʊˈbeɪd/","a":"en-us-obeyed.ogg","l":"obey","q":"verb"},"obeying":{"h":"obeying","l":"obey","q":"verb"},"pant":{"h":"pant","i":"/pænt/","a":"en-us-pant.ogg","s":[{"p":"verb","d":[{"m":"If a person pants, they breathe shortly and quickly, when running, climbing, etc."}]}]},"paralyse":{"h":"paralyse","i":"/ˈparəlʌɪz/","a":"LL-Q1860 (eng)-Vealhurl-paralyze.wav","s":[{"p":"verb","d":[{"m":"If you paralyse someone, you make a person (or a part of their body) not able to move wholly or partly."}]}]},"paralysis":{"h":"paralysis","i":"/pəˈræləsəs/","a":"LL-Q1860 (eng)-Vealhurl-paralysis.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Paralysis is the inability to move.","e":"The injuries were only millimetres from causing paralysis and death."}]}]},"participant":{"h":"participant","i":"/pɑːˈtɪsɪpənt/","a":"LL-Q1860 (eng)-Vealhurl-participant.wav","s":[{"p":"noun","d":[{"m":"(countable) A participant is a person who takes part in something.","e":"The athlete was a participant at the."}]}]},"participants":{"h":"participants","l":"participant","q":"noun"},"paralyses":{"h":"paralyses","l":"paralyse","q":"verb"},"paralysed":{"h":"paralysed","l":"paralyse","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone is paralysed, they are unable to move.","e":"The paralysed man was unable to walk again."}]}]},"paralysing":{"h":"paralysing","l":"paralyse","q":"verb"},"paralyze":{"h":"paralyze","i":"/ˈparəlʌɪz/","a":"LL-Q1860 (eng)-Vealhurl-paralyze.wav","s":[{"p":"verb","d":[{"m":"If you paralyze someone, you make a person (or a part of their body) not able to move wholly or partly."}]}]},"paralyzes":{"h":"paralyzes","l":"paralyze","q":"verb"},"paralyzed":{"h":"paralyzed","l":"paralyze","q":"verb","s":[{"p":"adjective","d":[{"m":"If someone is paralyzed, they are unable to move.","e":"The paralyzed man was unable to walk again."}]}]},"paralyzing":{"h":"paralyzing","l":"paralyze","q":"verb"},"beverage":{"h":"beverage","i":"/ˈbevərɪdʒ/","a":"en-us-beverage.ogg","s":[{"p":"noun","d":[{"m":"(countable) A beverage is a liquid, such as milk, juice or coffee, that can be drank.","e":"You can get water and other cold beverages from the vending machine."}]}]},"beverages":{"h":"beverages","l":"beverage","q":"noun"},"voyage":{"h":"voyage","i":"/ˈvɔɪ.ɪdʒ/","a":"en-us-voyage.ogg","s":[{"p":"noun","d":[{"m":"(countable) A voyage is a trip involving significant travel; a long trip."}]}]},"quake":{"h":"quake","i":"/kweɪk/","a":"en-us-quake.ogg","s":[{"p":"noun","d":[{"m":"(countable) A quake refers to an earthquake, the shaking of the ground."},{"m":"(countable) A quake is a shaking of something, usually a building."}]},{"p":"verb","d":[{"m":"(intransitive) When something quakes, it trembles and shakes.","e":"Be careful! The ground was quaking a little bit just now."},{"m":"When you quake, you shake with fear."}]}]},"quarrel":{"h":"quarrel","i":"/ˈkwɒr(ə)l/","a":"en-uk-quarrel.oga","s":[{"p":"noun","d":[{"m":"(countable) A quarrel is an argument or disagreement."}]},{"p":"verb","d":[{"m":"(intransitive) If you quarrel, you have an argument or disagreement."}]}]},"quarry":{"h":"quarry","a":"En-us-quarry.ogg","s":[{"p":"noun","d":[{"m":"(countable) A quarry is a place from which stones or sand are dug out; a place where people mine."}]}]},"quay":{"h":"quay","i":"/kiː/","a":"en-us-quay.ogg","s":[{"p":"noun","d":[{"m":"(countable) A big flat stone or metal platform beside the sea or a river where ship can be tied up."}]}]},"quench":{"h":"quench","i":"/kwɛnt͡ʃ/","a":"LL-Q1860 (eng)-Vealhurl-quench.wav","s":[{"p":"verb","d":[{"m":"When you quench yourself, you drink water to satisfy your thirst.","e":"I need some water to quench my thirst"}]}]},"quiver":{"h":"quiver","i":"[kʍɪvə(r)]","a":"en-us-quiver.ogg","s":[{"p":"noun","d":[{"m":"(countable) A quiver is a container for arrows.","e":"Robin Hood was never without his bow and quiver."}]},{"p":"verb","d":[{"m":"If you quiver, you shake slightly and rapidly","e":"The sudden wind made him quiver with cold."}]}]},"quarrels":{"h":"quarrels","l":"quarrel","q":"noun"},"quarreled":{"h":"quarreled","l":"quarrel","q":"verb"},"quarrelled":{"h":"quarrelled","l":"quarrel","q":"verb"},"quarreling":{"h":"quarreling","l":"quarrel","q":"verb"},"quarrelling":{"h":"quarrelling","l":"quarrel","q":"verb"},"quivers":{"h":"quivers","l":"quiver","q":"verb"},"quivered":{"h":"quivered","l":"quiver","q":"verb"},"quivering":{"h":"quivering","l":"quiver","q":"verb"},"quarries":{"h":"quarries","l":"quarry","q":"noun"},"quenches":{"h":"quenches","l":"quench","q":"verb"},"quenched":{"h":"quenched","l":"quench","q":"verb"},"quenching":{"h":"quenching","i":"/ˈkwɛntʃ.ɪŋ/","l":"quench","q":"verb"},"quays":{"h":"quays","l":"quay","q":"noun"},"bookseller":{"h":"bookseller","i":"/ˈbʊksɛlɚ/","a":"LL-Q1860 (eng)-Vealhurl-bookseller.wav","s":[{"p":"noun","d":[{"m":"(countable) A bookseller is someone who sells books.","e":"George wants to become a bookseller as he has a passion for books."}]}]},"booksellers":{"h":"booksellers","l":"bookseller","q":"noun"},"bookkeeper":{"h":"bookkeeper","s":[{"p":"noun","d":[{"m":"A bookkeeper is someone responsible for keeping records, documents, and other things."}]}]},"bookkeepers":{"h":"bookkeepers","l":"bookkeeper","q":"noun"},"bookkeeping":{"h":"bookkeeping","i":"/ˈbʊkˌkiːpɪŋ/","a":"en-us-bookkeeping.oga","s":[{"p":"noun","d":[{"m":"The act of keeping books or records of information on transactions."}]}]},"prank":{"h":"prank","i":"/præŋk/","a":"en-au-prank.ogg","s":[{"p":"noun","d":[{"m":"(countable) A prank is an act to trick or confuse someone; a mean act."}]},{"p":"verb","d":[{"m":"(transitive) To trick, to joke someone.","e":"Bobby likes to prank me by hiding my keys."}]}]},"pranks":{"h":"pranks","l":"prank","q":"noun","s":[{"p":"verb","d":[{"m":"The third-person singular form of prank.","e":"He pranks me all the time!"}]}]},"pranked":{"h":"pranked","l":"prank","q":"verb"},"pranking":{"h":"pranking","l":"prank","q":"verb"},"banker":{"h":"banker","i":"/ˈbæŋkə(r)/","a":"EN-AU ck1 banker.ogg","s":[{"p":"noun","d":[{"m":"(countable) A banker is someone who works at a bank and helps in managing the money and finances of people.","e":"My Aunt is a banker."},{"m":"(countable) A banker is a person who manages the bank in a house."},{"m":"(countable) A banker is a machine that is used at the back of the train to help it climb a slope."}]}]},"bankers":{"h":"bankers","l":"banker","q":"noun"},"racial":{"h":"racial","i":"/ˈreɪʃəl/","a":"LL-Q1860 (eng)-Wodencafe-racial.wav","s":[{"p":"adjective","d":[{"m":"If something is racial, it is related to the skin color (race) of people"}]}]},"radar":{"h":"radar","i":"/ˈreɪdɑː(r)/","a":"en-us-radar.ogg","s":[{"p":"noun","d":[{"m":"The way for finding the position and speed of aircraft and ships."}]}]},"radiator":{"h":"radiator","i":"/ˈreɪ.diˌeɪ.tɚ/","a":"en-us-radiator.ogg","s":[{"p":"noun","d":[{"m":"(countable) A metal device made to heat a room.","e":"It's cold in here, turn the radiator on!"},{"m":"(countable) A part of a cars engine made to cool it."}]}]},"raft":{"h":"raft","i":"/rɑːft/","a":"en-us-raft.ogg","s":[{"p":"noun","d":[{"m":"(countable) A raft is a rough flat boat, often made from large logs of wood joined together."}]}]},"raid":{"h":"raid","i":"/reɪd/","a":"en-us-raid.ogg","s":[{"p":"noun","d":[{"m":"(countable) A raid is a rapid surprise attack on an enemy.","e":"The general planned a night raid on the enemy positions."}]},{"p":"verb","d":[{"m":"(transitive) To raid an enemy is to attack them suddenly, without giving a warning.","e":"The police raided a house where they thought the thief was hiding."}]}]},"raids":{"h":"raids","l":"raid","q":"noun"},"raided":{"h":"raided","l":"raid","q":"verb"},"raiding":{"h":"raiding","l":"raid","q":"verb"},"radiators":{"h":"radiators","l":"radiator","q":"noun"},"connotation":{"h":"connotation","i":"/ˌkɑnəˈteɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-connotation.wav","s":[{"p":"noun","d":[{"m":"(countable) A connotation of a word is something it means other than its literal meaning.","e":"That word has a negative connotation."}]}]},"connotations":{"h":"connotations","l":"connotation","q":"noun"},"sway":{"h":"sway","i":"/sweɪ/","a":"en-us-sway.ogg","s":[{"p":"verb","d":[{"m":"If you sway, you move slowly from side to side."}]}]},"swell":{"h":"swell","i":"/swɛl/","a":"LL-Q1860 (eng)-Vealhurl-swell.wav","s":[{"p":"verb","d":[{"m":"When something swells, it becomes larger, usually due to an increase in blood in an area of the body."}]}]},"swerve":{"h":"swerve","i":"/swɜːv/","a":"en-us-swerve.ogg","s":[{"p":"verb","d":[{"m":"move and change direction suddenly"}]}]},"swift":{"h":"swift","i":"/swɪft/","a":"en-us-swift.ogg","s":[{"p":"adjective","d":[{"m":"If something is swift, it is fast.","e":"A swift hit on the head should keep him unconscious for an hour."}]}]},"swerves":{"h":"swerves","l":"swerve","q":"verb"},"swerved":{"h":"swerved","l":"swerve","q":"verb"},"swerving":{"h":"swerving","l":"swerve","q":"verb"},"swells":{"h":"swells","l":"swell","q":"verb"},"swelled":{"h":"swelled","i":"/ˈswɛld/","a":"LL-Q1860 (eng)-Vealhurl-swelled.wav","l":"swell","q":"verb"},"swelling":{"h":"swelling","i":"/ˈswɛl.ɪŋ/","a":"en-us-swelling.ogg","l":"swell","q":"verb"},"excitement":{"h":"excitement","i":"/ɪkˈsaɪtmənt/","a":"en-us-excitement.ogg","s":[{"p":"noun","d":[{"m":"Excitement is looking forward to do something, or eager to do something.","e":"My excitement for riding the roller coaster was great."},{"m":"Excitement is a feeling of great enjoyment.","e":"I felt excitement when I started opening my Christmas present."}]}]},"neutron":{"h":"neutron","a":"en-us-neutron.ogg","s":[{"p":"noun","d":[{"m":"(countable) A neutron is a type particle in the nucleus (center) of an atom that is the largest out of all the particles in an atom, weighs the most and has no charge. There are sometimes different numbers of them in an atom, which make isotopes (atoms that have different numbers of neutrons). They can also change the atomic mass of an atom (how much an atom weighs).","e":"Neutrons take up most of the space in an atom."}]}]},"neutrons":{"h":"neutrons","l":"neutron","q":"noun"},"juicy":{"h":"juicy","i":"/ˈdʒusi/","a":"en-us-juicy.ogg","s":[{"p":"adjective","d":[{"m":"If something is juicy, it is full of juice.","e":"I bit into the juicy orange."},{"m":"If something is juicy, it is very rich or interesting, sometimes when not proper.","e":"Bits of juicy gossip were spreading slowly through the school."}]}]},"ya":{"h":"ya","a":"En-us-ya.ogg","s":[{"p":"pronoun","d":[{"m":"Refers to you.","e":"Will ya do this for me?"},{"m":"Your.","e":"Where's ya car?"}]}]},"colloquialism":{"h":"colloquialism","i":"/kəˈloʊ.kwi.əˌlɪz.əm/","a":"LL-Q1860 (eng)-Vealhurl-colloquialism.wav","s":[{"p":"noun","d":[{"m":".","e":"Using a colloquialism in formal writing is bad to do."}]}]},"colloquialisms":{"h":"colloquialisms","i":"/kəˈləʊ.kwi.əˌlɪz.əmz/","l":"colloquialism","q":"noun"},"zealander":{"h":"Zealander","s":[{"p":"noun","d":[{"m":"A Zealander is a resident of (someone who lives in) Zealand.","e":"People who have stayed in Zealand for quite a while are often called Zealanders."}]}]},"zealanders":{"h":"Zealanders","l":"zealander","q":"noun"},"worthless":{"h":"worthless","i":"/ˈwɝθləs/","a":"en-us-worthless.ogg","s":[{"p":"adjective","d":[{"m":"If something is worthless it has no value, meaning or importance.","e":"The china figure was worthless after I accidentally dropped it."}]}]},"pajamas":{"h":"pajamas","i":"/pəˈd͡ʒæ.məz/","a":"en-us-pajamas.ogg","s":[{"p":"noun","d":[{"m":"Pajamas are clothes worn at night, made up of soft loose-fitting pants and a soft shirt.","e":"Make sure when you go to sleep that you have your pajamas on."}]}]},"comet":{"h":"comet","i":"/ˈkɒmət/","a":"en-us-comet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A comet is an object in outer space in an orbit that has dust surrounding its main mass, including a tail formed from gas from it.","e":"I could see the bright blue comet passing my window at night."}]}]},"comets":{"h":"comets","l":"comet","q":"noun"},"quizzical":{"h":"quizzical","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-quizzical.wav","s":[{"p":"adjective","d":[{"m":"Something that is odd or weird.","e":"The painting, to me, was very quizzical."},{"m":"When something is quizzical, it is puzzling.","e":"The hieroglyphs on the stone wall were very quizzical in figuring out them."},{"m":"Something that is questionable.","e":"Algebra is very quizzical."}]}]},"dominion":{"h":"dominion","i":"/dəˈmɪnjən/","a":"en-us-dominion.ogg","s":[{"p":"noun","d":[{"m":"Power of right of ruling over something.","e":"I have dominion over my room."},{"m":"(countable) A dominion is a territory ruled by someone.","e":"My sister's iPhone is her dominion."}]}]},"dominions":{"h":"dominions","a":"En-us-dominions.ogg","l":"dominion","q":"noun"},"hygiene":{"h":"hygiene","i":"/ˈhaɪˌdʒiːn/","a":"en-us-hygiene.ogg","s":[{"p":"noun","d":[{"m":"A certain practice to the preservation of health (i.e. cleanliness)","e":"The nurse always told me to never give up on hygiene."}]}]},"hygienics":{"h":"hygienics","i":"/haɪdʒiˈɛnɪks/","a":"LL-Q1860 (eng)-Wodencafe-hygienics.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Hygienics is another word for hygiene."},{"m":"(uncountable) Hygienics is the part (field) of science which involves the preservation of health.","e":"Hygienics is mostly based on hygiene."}]}]},"hygienes":{"h":"hygienes","l":"hygiene","q":"noun"},"torpedo":{"h":"torpedo","i":"/ˌtɔː(r)ˈpiː.dəʊ/","a":"en-au-torpedo.ogg","s":[{"p":"noun","d":[{"m":"(countable) A missile with explosives that is shaped like a cigar that moves by itself, sometimes built with a targeting device. It is a weapon used in sea battle and is used to destroy ships overseas.","e":"The torpedo slammed into the submarine and in one hit, it destroyed the machine."}]}]},"torpedos":{"h":"torpedos","l":"torpedo","q":"noun"},"torpedoes":{"h":"torpedoes","l":"torpedo","q":"noun"},"kitchenette":{"h":"kitchenette","i":"/ˌkɪt͡ʃəˈnɛt/","a":"LL-Q1860 (eng)-Vealhurl-kitchenette.wav","s":[{"p":"noun","d":[{"m":"(countable) A kitchenette is a small, organized kitchen.","e":"In our apartment we have a kitchenette."}]}]},"kitchenettes":{"h":"kitchenettes","l":"kitchenette","q":"noun"},"valency":{"h":"valency","i":"/ˈveɪlənsi/","s":[{"p":"noun","d":[{"m":"Another term for valence."}]}]},"valencies":{"h":"valencies","l":"valency","q":"noun"},"valence":{"h":"valence","i":"/ˈveɪl(ə)ns/","a":"LL-Q1860 (eng)-Vealhurl-valence.wav","s":[{"p":"noun","d":[{"m":"(countable) A valence is something that determines the number of atoms that will bond with another kind of atom."},{"m":"(countable) A valence is a certain amount of atoms or groups in a basic combination that an atom or group can actually hold."}]}]},"valance":{"h":"valance","i":"/ˈvæləns/","a":"LL-Q1860 (eng)-Vealhurl-valance.wav","s":[{"p":"noun","d":[{"m":"(countable) A curtain that is hung from a covering / bed / etc.","e":"I pushed away the valance separating me from my room."},{"m":"(countable) A curtain that is hung on the top of a window for a decoration.","e":"I drew the valance and gazed out my window, looking at the blue skies."}]}]},"valances":{"h":"valances","l":"valance","q":"noun"},"valences":{"h":"valences","l":"valence","q":"noun"},"gill":{"h":"gill","i":"/ɡɪl/","a":"en-us-gill.ogg","s":[{"p":"noun","d":[{"m":"(countable) A gill is the breathing organ for animals that live in the sea. It helps them breathe oxygen inside of water.","e":"If I had a gill, then I could breathe underwater."}]},{"p":"verb","d":[{"m":"If you gill a fish, you remove the [[#Noun|gills]] from it."}]}]},"gills":{"h":"gills","a":"LL-Q1860 (eng)-Persent101-gills.wav","l":"gill","q":"noun"},"longitude":{"h":"longitude","i":"/ˈlɒnɡɪtjuːd/","a":"en-us-longitude.ogg","s":[{"p":"noun","d":[{"m":"The distance from an angle going east or west measured from any angle in comparison to the prime meridian, which is Greenwich, England. It is either measured in degrees or any other unit having to do with degrees.","e":"Greenwich, England is located at 0 degrees longitude."}]}]},"longitudes":{"h":"longitudes","l":"longitude","q":"noun"},"fin":{"h":"fin","i":"/fɪn/","a":"en-us-fin.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fin is a wing like organ that is attached to some parts of the body of undersea animals. It is used for turning in a certain direction,, and for propelling themselves.","e":"Some fish have a dorsal fin."}]}]},"fins":{"h":"fins","l":"fin","q":"noun"},"litany":{"h":"litany","s":[{"p":"noun","d":[{"m":"(countable) A litany is a formal prayer made up of invocations (callings upon God) with responses that are the same number as the questions.","e":"Today I am going to recite a litany."}]}]},"litanies":{"h":"litanies","l":"litany","q":"noun"},"encyclopedic":{"h":"encyclopedic","i":"/ɛnˌsaɪkləˈpidɪk/","s":[{"p":"adjective","d":[{"m":"If something is encyclopedic, then it is related to an encyclopedia or in the style of one.","e":"The excerpt was part of encyclopedic content."}]}]},"apathetic":{"h":"apathetic","i":"/æp.əˈθɛt.ɪk/","a":"LL-Q1860 (eng)-Vealhurl-apathetic.wav","s":[{"p":"adjective","d":[{"m":"A feeling of apathy for someone."}]}]},"juicier":{"h":"juicier","l":"juicy","q":"adjective"},"juiciest":{"h":"juiciest","l":"juicy","q":"adjective"},"australian":{"h":"Australian","i":"/əˈstræɪ.ljən/","a":"LL-Q1860 (eng)-Vealhurl-Australian.wav","s":[{"p":"noun","d":[{"m":"(countable) A person from Australia."}]},{"p":"adjective","d":[{"m":"If a person is Australian, they come from Australia."},{"m":"In a style typical of Australia."}]}]},"australians":{"h":"Australians","l":"australian","q":"noun"},"foreigner":{"h":"foreigner","i":"/ˈfɒr.ɪ.nə(r)/","a":"en-us-foreigner.ogg","s":[{"p":"noun","d":[{"m":"(countable) A foreigner is a person who is from a different country."}]}]},"foreigners":{"h":"foreigners","a":"En-us-foreigners.ogg","l":"foreigner","q":"noun"},"segregation":{"h":"segregation","i":"/sɛɡrəˈɡeɪ̯ʃən/","s":[{"p":"noun","d":[{"m":"(uncountable) Segregation is the process and keeping two or more groups apart, especially for racial, sexual or religious reasons."}]}]},"notation":{"h":"notation","i":"/noʊˈteɪʃən/","a":"en-us-notation.ogg","s":[{"p":"noun","d":[{"m":"A notation is a few words written to explain something, usually as a note."}]}]},"relieve":{"h":"relieve","i":"/rɪˈliːv/","a":"en-us-relieve.ogg","s":[{"p":"verb","d":[{"m":"If you relieve pain, pressure, sadness, difficulty, etc., you reduce it.","e":"These drugs are used to relieve pain."},{"m":"If you relieve yourself, you urinate.","e":"He went behind a tree to relieve himself."},{"m":"If you relieve somebody, you release them from duty, often by taking their place.","e":"When I arrived at 11:00 to relieve the guard, he was asleep."}]}]},"integrate":{"h":"integrate","i":"/ˈɪn.tɪ.ɡreɪt/","a":"LL-Q1860 (eng)-Vealhurl-integrate.wav","s":[{"p":"verb","d":[{"m":"If you integrate x into y, you combine them together to form one whole."}]}]},"overhaul":{"h":"overhaul","i":"/ˈəʊvəˌhɔːl/","a":"LL-Q1860 (eng)-Vealhurl-overhaul (noun).wav","s":[{"p":"noun","d":[{"m":"(countable) An overhaul is a major repair, remake, renovation, or revision.","e":"The engine required a complete overhaul to run properly."}]},{"p":"verb","d":[{"m":"(transitive) If you overhaul something, you make major changes or repairs to it."}]}]},"unserviceable":{"h":"unserviceable","s":[{"p":"adjective","d":[{"m":"Something that is no longer usable, unusable."},{"m":"Something that is impractical."}]}]},"overcrowding":{"h":"overcrowding","l":"overcrowd","q":"verb","s":[{"p":"noun","d":[{"m":"The action or event of a space having more occupants than that space can accommodate."}]}]},"relieves":{"h":"relieves","l":"relieve","q":"verb"},"relieved":{"h":"relieved","i":"/rɪˈliːvd/","a":"en-us-relieved.ogg","l":"relieve","q":"verb"},"relieving":{"h":"relieving","i":"/rɪˈliːvɪŋ/","l":"relieve","q":"verb"},"cadmium":{"h":"cadmium","i":"/ˈkædmiəm/","a":"LL-Q1860 (eng)-Vealhurl-cadmium.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Cadmium is a soft metal with the symbol Cd and atomic number 48.","e":"Cadmium has many common industrial uses as it is an important in battery production."}]}]},"enthraller":{"h":"enthraller","s":[{"p":"noun","d":[{"m":"(countable) An enthraller is someone or something that enthrals."}]}]},"succession":{"h":"succession","i":"/səkˈsɛʃ.ən/","a":"en-us-succession.ogg","s":[{"p":"noun","d":[{"m":"An act of following in sequence."},{"m":"A sequence of things in order."},{"m":"A passing of royal powers."},{"m":"A group of rocks or strata that succeed one another in chronological order."}]}]},"successions":{"h":"successions","l":"succession","q":"noun"},"surpriser":{"h":"surpriser","s":[{"p":"noun","d":[{"m":"(countable) A surpriser is someone or something that surprises.","e":"You always amaze me. What a surpriser you are!"}]}]},"surprisers":{"h":"surprisers","l":"surpriser","q":"noun"},"pesticide":{"h":"pesticide","i":"/ˈpɛstɨsaɪd/","a":"LL-Q1860 (eng)-Vealhurl-pesticide.wav","s":[{"p":"noun","d":[{"m":"Pesticide is a chemical that kills insects or other small living things dangerous to plants."}]}]},"furnish":{"h":"furnish","i":"/ˈfɝnɪʃ/","a":"en-us-furnish.ogg","s":[{"p":"verb","d":[{"m":"To furnish is to give a place furniture or other supplies.","e":"Our new house still needs to be furnished."},{"m":"To furnish something is to supply or give to it.","e":"My father will furnish me with gifts."}]}]},"furnishes":{"h":"furnishes","l":"furnish","q":"verb"},"furnished":{"h":"furnished","a":"En-us-furnished.ogg","l":"furnish","q":"verb"},"furnishing":{"h":"furnishing","a":"En-us-furnishing.ogg","l":"furnish","q":"verb"},"loyal":{"h":"loyal","s":[{"p":"adjective","d":[{"m":"To be loyal is to be true to someone; to always tell the truth to someone.","e":"Be loyal to me, friend."},{"m":"If you are loyal to someone you are faithful to them.","e":"Spot is a loyal dog."}]}]},"catlike":{"h":"catlike","s":[{"p":"adjective","d":[{"m":"If something is catlike, it is similar to a cat","e":"She moved across the dance floor with smooth catlike actions."}]}]},"exacerbate":{"h":"exacerbate","i":"/ɪɡˈzæsɚˌbeɪt/","a":"en-us-exacerbate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you exacerbate something, you make it worse than it already is.","e":"Your unkind remark exacerbates my anguish."}]}]},"arable":{"h":"arable","i":"/ˈærəbl̩/","a":"LL-Q1860 (eng)-Vealhurl-arable.wav","s":[{"p":"adjective","d":[{"m":"Arable land is land that is useful for farming crops.","e":"Most of the arable land in the area is already used for growing rice."}]}]},"squashes":{"h":"squashes","l":"squash","q":"verb"},"squashed":{"h":"squashed","l":"squash","q":"verb"},"squashing":{"h":"squashing","l":"squash","q":"verb"},"premiere":{"h":"premiere","i":"/prəˈmɪɚ/","a":"LL-Q1860 (eng)-Vealhurl-premiere.wav","s":[{"p":"noun","d":[{"m":"A premiere is the first showing of a movie, play, opera, musical, or other form of entertainment.","e":"The premiere of \"Gone with the Wind\" was in Atlanta, Georgia."},{"m":"A premiere is the first episode of a television show or the first episode of a season of that show.","e":"I saw the premiere of the new crime show."}]},{"p":"verb","d":[{"m":"To premiere is to show or perform a stage work or film for the first time.","e":"Curly: Will the play premiere in New York?"}]}]},"baritone":{"h":"baritone","i":"/ˈbɛr.ɪ.toʊn/","a":"LL-Q1860 (eng)-Vealhurl-baritone.wav","s":[{"p":"noun","d":[{"m":"(countable) A baritone is a male voice that is lower than tenor, but higher than bass","e":"Thomas Hampson sings operas with a loud baritone voice"},{"m":"(countable) A baritone is a musical instrument that plays notes that are between tenor and bass, such as a euphonium or a baritone saxophone."},{"m":"(countable) A baritone is a musical instrument that is as big as a euphonium.","e":"The baritone looks like a tuba or euphonium."}]}]},"tenor":{"h":"tenor","i":"/tɛnə(r)/","a":"en-uk-tenor.ogg","s":[{"p":"noun","d":[{"m":"A tenor is the highest male vocal range, higher than bass or baritone."},{"m":"A tenor is a musical instrument that is higher than a baritone, but lower than an alto.","e":"Tenor instruments include include the tenor saxophone and tenor horn."},{"m":"(countable) A tenor is a singer who sings in the tenor range.","e":"Bob McGrath and Red Grammer are famous tenors."}]}]},"humidity":{"h":"humidity","i":"/hjuːˈmɪdɪti/","a":"LL-Q1860 (eng)-Vealhurl-humidity.wav","s":[{"p":"noun","d":[{"m":"(countable) The humidity is how much water vapor is in the air.","e":"It was 90 degrees outside, but the high level of humidity made it feel much hotter"}]}]},"nay":{"h":"nay","i":"/neɪ/","a":"en-us-nay.ogg","s":[{"p":"interjection","d":[{"m":"You use nay to show disapproval, similar to no.","e":"Lord Charles Grantham wanted to speak in Parliament, but other members said, \"Nay!\""}]},{"p":"noun","d":[{"m":"(countable) A nay is a vote of no.","e":"The \"ayes\" are 220 and the \"nays\" are 180, so the \"ayes\" have it."}]}]},"humidities":{"h":"humidities","l":"humidity","q":"noun"},"nays":{"h":"nays","l":"nay","q":"noun"},"barber":{"h":"barber","i":"/ˈbɑː.bə/","a":"en-us-barber.ogg","s":[{"p":"noun","d":[{"m":"(countable) A barber is a person whose job is cutting hair and beards.","e":"I went to the local barber to get a shave and a haircut."}]}]},"barbers":{"h":"barbers","l":"barber","q":"noun"},"haircut":{"h":"haircut","i":"/ˈhɛə(r)kʌt/","a":"en-us-haircut.ogg","s":[{"p":"noun","d":[{"m":"(countable) A haircut is what happens when someone's hair is cut.","e":"I have an appointment this afternoon for a haircut."},{"m":"(countable) A haircut the style in which someone's hair is cut.","e":"After having long hair for three years, Olivia got a very short haircut."}]}]},"haircuts":{"h":"haircuts","l":"haircut","q":"noun"},"tapings":{"h":"tapings","l":"taping","q":"noun"},"tenors":{"h":"tenors","l":"tenor","q":"noun"},"baritones":{"h":"baritones","l":"baritone","q":"noun"},"arrival":{"h":"arrival","i":"/əˈraɪ.vəl/","a":"en-uk-arrival.ogg","s":[{"p":"noun","d":[{"m":"(countable) The act of reaching the place to which you were traveling."}]}]},"realization":{"h":"realization","i":"/ˌriəlɪˈzeɪʃən/","a":"en-us-realization.ogg","s":[{"p":"noun","d":[{"m":"Realization is the process or result of coming to understand something clearly.","e":"He slowly came to the realization that she wouldn't be coming back ever again."},{"m":"Realization is act or result of making an idea come true.","e":"He did not stay around long enough to see the realization of the idea."}]}]},"mutation":{"h":"mutation","i":"/mjuˈteɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-mutation.wav","s":[{"p":"noun","d":[{"m":"Any alteration or change."},{"m":"(genetics) A change in genetic material (DNA) which can be passed from parents to children."},{"m":"A mutant."}]}]},"intoxication":{"h":"intoxication","i":"/ɪntɑksɪˈkeɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-intoxication.wav","s":[{"p":"noun","d":[{"m":"An intoxication is a poisoning of the body by a foreign substance or toxic product."},{"m":"Intoxication is the state of being intoxicated or drunk."}]}]},"perception":{"h":"perception","i":"/pəˈsɛpʃ(ə)n/","a":"en-us-perception.ogg","s":[{"p":"noun","d":[{"m":"Perception is the action of seeing, hearing, smelling, touching and/or tasting an object that made an impression on the senses.","e":"The government hopes to change the public's perception of the problem."}]}]},"chromatophore":{"h":"chromatophore","i":"/krəˈmætəˌfɔr/","a":"LL-Q1860 (eng)-Yangolin-chromatophore.wav","s":[{"p":"noun","d":[{"m":"(countable) Chromatophores are cells that contain pigment and reflect light. They are found in amphibians, fish, reptiles, crustaceans, and cephalopods."}]}]},"arrivals":{"h":"arrivals","l":"arrival","q":"noun"},"realizations":{"h":"realizations","l":"realization","q":"noun"},"mutations":{"h":"mutations","l":"mutation","q":"noun"},"intoxications":{"h":"intoxications","l":"intoxication","q":"noun"},"perceptions":{"h":"perceptions","l":"perception","q":"noun"},"catchphrase":{"h":"catchphrase","s":[{"p":"noun","d":[{"m":"(countable) A phrase that someone uses a lot is called a catchphrase."}]}]},"chromatophores":{"h":"chromatophores","l":"chromatophore","q":"noun"},"survival":{"h":"survival","i":"/sɚˈvaɪvəl/","a":"LL-Q1860 (eng)-Vealhurl-survival.wav","s":[{"p":"noun","d":[{"m":"Survival is the state of continuing to live.","e":"Survival is a success for any species."}]}]},"catchphrases":{"h":"catchphrases","l":"catchphrase","q":"noun"},"stationary":{"h":"stationary","i":"/ˈsteɪʃ(ə)n(ə)ri/","a":"LL-Q1860 (eng)-Vealhurl-stationary.wav","s":[{"p":"adjective","d":[{"m":"When an object is stationary, it is not.","e":"When a car stops, it is stationary."}]}]},"neodymium":{"h":"neodymium","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-neodymium.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Neodymium is a soft silvery metal with the symbol Nd and atomic number 60."}]}]},"tabloid":{"h":"tabloid","i":"/ˈtæblɔɪd/","a":"LL-Q1860 (eng)-Vealhurl-tabloid.wav","s":[{"p":"noun","d":[{"m":"(countable) A tabloid is a newspaper having pages half the size. They mostly publish popular articles and sensational stories instead of serious news.","e":"Now Ulrich can be occasionally found in tabloid magazines looking haggard and old."}]}]},"tabloids":{"h":"tabloids","l":"tabloid","q":"noun"},"tact":{"h":"tact","s":[{"p":"noun","d":[{"m":"A tact is a skill and sensitivity to talk about difficult issues without making people feel unhappy or angry."}]}]},"tailor":{"h":"tailor","i":"/ˈteɪlɚ/","a":"en-us-tailor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tailor is someone who makes suits, trousers, and jackets for individual customers."}]},{"p":"verb","d":[{"m":"Made by a tailor; fitted.","e":"Will he tailor a suit to my specifications?"}]}]},"tailors":{"h":"tailors","l":"tailor","q":"noun"},"adoration":{"h":"adoration","i":"/ˌæ.dɚˈreɪ.ʃən/","a":"LL-Q1860 (eng)-Vealhurl-adoration.wav","s":[{"p":"noun","d":[{"m":"Adoration is the act of someone or something.","e":"She spoke about him with adoration."}]}]},"hoodie":{"h":"hoodie","a":"en-au-hoodie.ogg","s":[{"p":"noun","d":[{"m":"(countable) A hoodie is a hooded sweatshirt or jacket.","e":"\"Yes, I know I'm late, leave me alone!\" she said, tightening her hoodie around her waist while frantically looking for her second boot."}]}]},"jumper":{"h":"jumper","i":"/ˈd͡ʒʌmpə/","a":"en-us-jumper.ogg","s":[{"p":"noun","d":[{"m":"(countable) A garment that covers the body and arm, another word for sweater."}]}]},"legging":{"h":"legging","i":"/lɛɡ.ɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-legging.wav","s":[{"p":"noun","d":[{"m":"A legging is a protective covering that is worn from the knee to the ankle and is usually made of leather."}]}]},"sandal":{"h":"sandal","i":"/ˈsændəl/","a":"LL-Q1860 (eng)-Vealhurl-sandal.wav","s":[{"p":"noun","d":[{"m":"A sandal is a type of shoe that is usually worn in the summer. It is made of straps that are used to hold the sole to the foot."},{"m":"A sandal is a short form of sandalwood, a type of tropical tree in India, Australia, Hawaii and many south Pacific islands"}]}]},"tracksuit":{"h":"tracksuit","s":[{"p":"noun","d":[{"m":"(countable) A tracksuit is something that people wear. It has two parts: trousers and a jacket usually with front zipper. It was originally intended for use in sports."}]}]},"philosophe":{"h":"philosophe","i":"/ˌfɪl.əˈzɒf/","s":[{"p":"noun","d":[{"m":"(countable) A philosophe was an intellectual, or thinker of the 18th-century."}]}]},"tracksuits":{"h":"tracksuits","l":"tracksuit","q":"noun"},"hoodies":{"h":"hoodies","l":"hoodie","q":"noun"},"turmeric":{"h":"turmeric","i":"/ˈtjuːmərɪk/","s":[{"p":"noun","d":[{"m":"An Indian plant (taxonomic name: Curcuma longa), part of the ginger family."},{"m":"Flavor, a bright yellow color to food."},{"m":"A yellow to reddish-brown dye extracted from the turmeric plant."}]}]},"doorway":{"h":"doorway","i":"/ˈdɔrweɪ/","a":"en-us-doorway.ogg","s":[{"p":"noun","d":[{"m":"The opening of a door; the entrance to a room or house","e":"To move in to the room, I went through the doorway."}]}]},"doorways":{"h":"doorways","l":"doorway","q":"noun"},"overhauls":{"h":"overhauls","l":"overhaul","q":"noun"},"overhauled":{"h":"overhauled","l":"overhaul","q":"verb"},"overhauling":{"h":"overhauling","l":"overhaul","q":"verb"},"ulcer":{"h":"ulcer","i":"/ʌlsə/","s":[{"p":"noun","d":[{"m":"An ulcer is a painful area inside your stomach, mouth or skin. that fails to heal and may have unpleasant liquid."}]}]},"ulcers":{"h":"ulcers","l":"ulcer","q":"noun"},"unconscious":{"h":"unconscious","i":"/ˌʌnˈkɒnʃəs/","a":"en-us-unconscious.ogg","s":[{"p":"adjective","d":[{"m":"When someone is unconscious, the person is not awake, almost asleep, unaware.","e":"He became unconscious when the robber hit him with a baseball bat from behind."}]}]},"fluffy":{"h":"fluffy","i":"/flʌfi/","a":"LL-Q1860 (eng)-Vealhurl-fluffy.wav","s":[{"p":"adjective","d":[{"m":"If something is fluffy, it has fluff, fur or anything else which constitutes fluffiness.","e":"My hairy white cat Snowball and my cotton comforter are both very fluffy."}]}]},"shovel":{"h":"shovel","i":"/ˈʃʌvəl/","a":"en-us-shovel.ogg","s":[{"p":"noun","d":[{"m":"(countable) A shovel is an object made for scooping or digging"}]},{"p":"verb","d":[{"m":"(transitive) If you shovel, you use a shovel.","e":"He had to shovel the snow off of their driveway."}]}]},"aroma":{"h":"aroma","i":"/əˈrəʊmə/","a":"en-us-aroma.ogg","s":[{"p":"noun","d":[{"m":"(countable) An aroma is a scent or smell.","e":"As I walked into the shop, I caught the aroma of freshly baked bread."}]}]},"misuse":{"h":"misuse","i":"/mɪsˈjuːs/","a":"LL-Q1860 (eng)-Vealhurl-misuse.wav","s":[{"p":"noun","d":[{"m":"A misuse is an incorrect use of something."}]},{"p":"verb","d":[{"m":"(transitive) When you misuse something, you use it incorrectly."}]}]},"vacancy":{"h":"vacancy","i":"/ˈveɪkənsi/","a":"en-us-vacancy.ogg","s":[{"p":"noun","d":[{"m":"A vacancy is an unoccupied position or job."},{"m":"An available room in a hotel."}]}]},"vacant":{"h":"vacant","i":"/ˈveɪkənt/","a":"en-us-vacant.ogg","s":[{"p":"adjective","d":[{"m":"When something is vacant, it is unused, unoccupied or empty.","e":"That room has been vacant since my uncle moved out of the house."}]}]},"vaccine":{"h":"vaccine","i":"/vækˈsiːn/","a":"en-us-vaccine.ogg","s":[{"p":"noun","d":[{"m":"A vaccine is a liquid substance that is given to a person so that they don't get a certain disease or illness, usually through an injection or through the mouth.","e":"Vaccines have eliminated many diseases from the world, like smallpox."}]}]},"mechanical":{"h":"mechanical","i":"/mɪˈkanɪk(ə)l/","a":"en-us-mechanical.ogg","s":[{"p":"adjective","d":[{"m":"If something is mechanical it is related to a machine, like a machine, or done by a machine.","e":"Printing presses are mechanical devices for printing on paper."}]}]},"dazzle":{"h":"dazzle","s":[{"p":"verb","d":[{"m":"(transitive) To dazzle is to confuse by making a visual display which is hard to understand."},{"m":"(transitive) The verb 'to dazzle' can be used figuratively or metaphorically:"}]}]},"startle":{"h":"startle","i":"/ˈstɑrt.l̩d/","a":"en-us-startled.ogg","s":[{"p":"verb","d":[{"m":"If you are startled, you jump or move suddenly, often opening your eyes wide, because of a surprise.","e":"She thought she was alone, but was startled to hear someone behind her.."}]},{"p":"noun","d":[{"m":"A startle is a surprise or a fright.","e":"The birthday boy had a startle when we screamed \"Happy birthday\" from behind him."}]}]},"doctrine":{"h":"doctrine","i":"/ˈdɑktrɪn/","a":"en-us-doctrine.ogg","s":[{"p":"noun","d":[{"m":"(countable) A doctrine is a particular principle, position, or policy taught or advocated, as of a religion or government."},{"m":"(countable) A doctrine is something that is taught; teachings collectively: religious doctrine."},{"m":"(countable) A doctrine is a body or system of teachings relating to a particular subject: the doctrine of the Catholic Church."}]}]},"doctrines":{"h":"doctrines","i":"/ˈdɑktrɪnz/","a":"en-us-doctrines.ogg","l":"doctrine","q":"noun"},"wag":{"h":"wag","i":"/wæɡ/","a":"en-au-wag.ogg","s":[{"p":"verb","d":[{"m":"A wag is when an animal shakes a tail. For example, a dog shakes its tail from side to side.","e":"That dog wagged its tail"},{"m":"(informal) A person who wags does not go to school when they are supposed to be.","e":"He's wagging school."}]}]},"walnut":{"h":"walnut","a":"En-us-walnut.ogg","s":[{"p":"noun","d":[{"m":"A walnut is a large light brown nut having a wrinkled eatable seed with a hard shell."}]}]},"wander":{"h":"wander","i":"/ˈwɒndə/","a":"en-us-wander.ogg","s":[{"p":"verb","d":[{"m":"When you wander around, you walk or move slowly around without a purpose.","e":"He would wander through the city streets late at night when he could not sleep."}]}]},"forgery":{"h":"forgery","a":"En-us-forgery.ogg","s":[{"p":"noun","d":[{"m":"Forgery is the act of producing a fake copy of something.","e":"Copying someone else's signature is forgery."}]}]},"forgeries":{"h":"forgeries","l":"forgery","q":"noun"},"abbreviation":{"h":"abbreviation","i":"/əˌbriː.viˈeɪ.ʃən/","a":"LL-Q1860 (eng)-Vealhurl-abbreviation.wav","s":[{"p":"noun","d":[{"m":"(countable) An abbreviation is a shorter way of writing or saying a word or phrase.","e":"\"NASA\" is an abbreviation of the words \"National Aeronautics and Space Administration\"."}]}]},"abolish":{"h":"abolish","i":"/əˈbɒlɪʃ/","a":"en-us-abolish.ogg","s":[{"p":"verb","d":[{"m":"When you abolish something, you end it by making it invalid or illegal. You usually use the word \"abolish\" in regard to laws or actions.","e":"The censorship law was abolished due to huge opposition by many people."}]}]},"wags":{"h":"wags","l":"wag","q":"verb"},"wagged":{"h":"wagged","l":"wag","q":"verb"},"wagging":{"h":"wagging","l":"wag","q":"verb"},"abbreviations":{"h":"abbreviations","l":"abbreviation","q":"noun"},"littoral":{"h":"littoral","s":[{"p":"adjective","d":[{"m":"Littoral means on the shore, the zone between high and low tide.","e":"Barnacles often live in the littoral zone, between the marks of high and low tide."}]}]},"doe":{"h":"doe","i":"/dəʊ/","a":"LL-Q1860 (eng)-I learned some phrases-doe.wav","s":[{"p":"noun","d":[{"m":"(countable) A doe is a female deer."}]}]},"fawn":{"h":"fawn","i":"/fɔːn/","a":"LL-Q1860 (eng)-Vealhurl-fawn.wav","s":[{"p":"noun","d":[{"m":"(countable) A fawn is a baby deer."}]}]},"permeable":{"h":"permeable","i":"/ˈpɜː(r)miəbəl/","a":"LL-Q1860 (eng)-Vealhurl-permeable.wav","s":[{"p":"adjective","d":[{"m":"A substance is permeable if it lets some gases or liquids to pass through it.","e":"is a solid substance which is permeable to small amounts of water."}]}]},"fawns":{"h":"fawns","l":"fawn","q":"noun"},"congruent":{"h":"congruent","s":[{"p":"adjective","d":[{"m":"If shapes are congruent then they have exactly the same shape and size."}]}]},"subdivision":{"h":"subdivision","i":"/ˈsʌbdɪvɪʒən/","a":"LL-Q1860 (eng)-Vealhurl-subdivision.wav","s":[{"p":"noun","d":[{"m":"a division into smaller pieces of something that has already been divided; to separate something","e":"Subdivide the sentence into pieces and understand it a bit at a time."},{"m":"(countable) such a piece that has been divided","e":"Work on one subdivision at a time."},{"m":"(countable) a parcel of land that has been divided into lots"},{"m":"(countable) a group of houses created by the same builder or in the same general area","e":"They're putting in a new subdivision out past Black Ranch Road."}]}]},"redefining":{"h":"redefining","l":"redefine","q":"verb"},"redefine":{"h":"redefine","s":[{"p":"verb","d":[{"m":"To redefine something is to give it a new definition or meaning.","e":"Albert Einstein redefined physics as it was known."}]}]},"redefines":{"h":"redefines","l":"redefine","q":"verb"},"redefined":{"h":"redefined","l":"redefine","q":"verb"},"subdivisions":{"h":"subdivisions","l":"subdivision","q":"noun"},"storyline":{"h":"storyline","i":"/ˈstɔːrɪlʌɪn/","a":"en-us-storyline.ogg","s":[{"p":"noun","d":[{"m":"(countable) A storyline is basically what a story is about. It can be found in books, movies, television programs and even video games. It can be either true or not true, but it must have a beginning, middle and end to be classified as something with a storyline.","e":"It was hard to follow the storyline in the book because so many characters were described."}]}]},"bachelor":{"h":"bachelor","i":"/ˈbæt͡ʃ.ə.lə(r)/","a":"en-us-bachelor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bachelor is a man who is not and has never been, but is able to do so."}]}]},"badger":{"h":"badger","i":"/ˈbæd͡ʒə/","a":"en-us-badger.ogg","s":[{"p":"noun","d":[{"m":"(countable) A badger is a wild small short-legged animal with black and white fur that lives in a hole and comes out at night, a kind of weasel or mink."}]},{"p":"verb","d":[{"m":"If you badger a person, you annoy them persistently."}]}]},"baggy":{"h":"baggy","i":"/ˈbæɡi/","a":"LL-Q1860 (eng)-Vealhurl-baggy.wav","s":[{"p":"adjective","d":[{"m":"When clothes are baggy, they are very loose."}]}]},"bait":{"h":"bait","i":"/beɪt/","a":"en-us-bait.ogg","s":[{"p":"noun","d":[{"m":"Bait is food placed on a hook to catch fish or other animals"}]},{"p":"verb","d":[{"m":"If you bait an animal, you attract it using a [[#Noun|bait]]."}]}]},"canary":{"h":"canary","i":"/kəˈnɛəri/","a":"EN-AU ck1 canary.ogg","s":[{"p":"noun","d":[{"m":"(countable) A canary is a small yellow bird that sings well and is often kept as a pet."},{"m":"(uncountable) A light, slightly greenish, yellow colour."}]}]},"cane":{"h":"cane","i":"/keɪn/","a":"en-us-cane.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cane is a long thin stick, often bamboo.","e":"The blind man used a cane to feel his way along the path."}]},{"p":"verb","d":[{"m":"To cane is to hit someone with a long thin stick.","e":"The pupil was caned for being rude to the teacher."}]}]},"dagger":{"h":"dagger","i":"/ˈdæɡə(r)/","a":"LL-Q1860 (eng)-Vealhurl-dagger.wav","s":[{"p":"noun","d":[{"m":"(countable) A dagger is a short knife used as a weapon."}]}]},"daisy":{"h":"daisy","i":"/ˈdeɪ.zi/","a":"en-us-daisy.ogg","s":[{"p":"noun","d":[{"m":"(countable) A daisy is a small wild flower with round centre and rays.","e":"He planted daisies in the garden near the kitchen door."}]}]},"dalmatian":{"h":"dalmatian","i":"/dælˈmeɪ.ʃən/","a":"en-us-Dalmatian.oga","s":[{"p":"noun","d":[{"m":"(countable) A dalmatian is a kind of dog, it is large, white with black spots."}]}]},"dandruff":{"h":"dandruff","i":"/ˈdændrʌf/","a":"LL-Q1860 (eng)-Vealhurl-dandruff.wav","s":[{"p":"noun","d":[{"m":"Dandruff is small white pieces of loose skin in a person’s hair."}]}]},"daggers":{"h":"daggers","l":"dagger","q":"noun"},"easel":{"h":"easel","s":[{"p":"noun","d":[{"m":"An easel is a wooden frame for holding a painted picture.","e":"The artist set up his easel by the bank of the river."}]}]},"elf":{"h":"elf","i":"/ɛlf/","a":"en-us-elf.ogg","s":[{"p":"noun","d":[{"m":"(countable) An elf is a small imaginary creature of folk tales with pointed ears.","e":"Tolkien's book, the Lord of the Rings, has many stories about elves and their adventures."}]}]},"embrace":{"h":"embrace","i":"/ɛmˈbreɪs/","a":"en-uk-embrace.oga","s":[{"p":"verb","d":[{"m":"If you embrace someone, you hold them closely in your arms with love."}]}]},"embroidery":{"h":"embroidery","i":"/ɪmˈbrɔɪdəri/","a":"LL-Q1860 (eng)-Vininn126-embroidery.wav","s":[{"p":"noun","d":[{"m":"Embroidery is the art of beautiful sewing patterns on cloth, using a needle and thread."}]}]},"emigrate":{"h":"emigrate","i":"/ˈɛmɪɡreɪt/","a":"LL-Q1860 (eng)-Vealhurl-emigrate.wav","s":[{"p":"verb","d":[{"m":"When you emigrate, you leave your own country in order to live in another country."}]}]},"fable":{"h":"fable","i":"/ˈfeɪbəl/","a":"en-us-fable.ogg","s":[{"p":"noun","d":[{"m":"(countable) A fable is a short story that teaches people a moral, how they should behave."}]}]},"fabric":{"h":"fabric","i":"/ˈfæb.rɪk/","a":"en-us-fabric.ogg","s":[{"p":"noun","d":[{"m":"A fabric is a material made of fibers."}]}]},"fabulous":{"h":"fabulous","i":"/ˈfæbjʊləs/","a":"en-au-fabulous.ogg","s":[{"p":"adjective","d":[{"m":"When something is fabulous, it is very good, outstanding and wonderful.","e":"Your dress looks fabulous! I love it!"}]}]},"fahrenheit":{"h":"Fahrenheit","i":"/fɑːrənˈhaɪt/","a":"LL-Q1860 (eng)-Vealhurl-Fahrenheit.wav","s":[{"p":"adjective","d":[{"m":"Fahrenheit is a scale to measure degrees of temperature. Water freezes at 32 degrees and boils at 212 degrees."}]}]},"fairly":{"h":"fairly","i":"/ˈfɛə(r).li/","a":"en-us-fairly.ogg","s":[{"p":"adverb","d":[{"m":"Fairly is when something is between slightly and very.","e":"The sun was shining brightly today, however the light breeze still made it feel fairly chilly."},{"m":"If something is done fairly, it is just or proper.","e":"The teacher told the students they had to take turns and play fairly on the swings."}]}]},"hardware":{"h":"hardware","i":"/ˈhɑːdˌwɛə/","a":"en-us-hardware.ogg","s":[{"p":"noun","d":[{"m":"Tools and supplies needed to build and repair things.","e":"The hardware store sells hammers, nails, and screws."},{"m":"The part of the computer that is not software; the part that includes the motherboard and memory disks","e":"I ran out of memory, so I added 50 gigabytes more hardware."}]}]},"byte":{"h":"byte","i":"/baɪt/","a":"en-us-byte.ogg","s":[{"p":"noun","d":[{"m":"(countable) A unit of eight bits that is used to measure a computer's memory.","e":"The letter I wrote on the computer took up 5,000 bytes of memory."}]}]},"bytes":{"h":"bytes","l":"byte","q":"noun"},"gigabyte":{"h":"gigabyte","i":"/ˈɡɪɡəbaɪt/","a":"LL-Q1860 (eng)-Vealhurl-gigabyte.wav","s":[{"p":"noun","d":[{"m":"(countable) One billion (1,000,000,000) bytes","e":"My new computer has 100 gigabytes of memory and a 200 gigabyte hard drive."}]}]},"gigabytes":{"h":"gigabytes","l":"gigabyte","q":"noun"},"gale":{"h":"gale","a":"En-us-gale.ogg","s":[{"p":"noun","d":[{"m":"A gale is a very strong wind.","e":"There were gales at 40 miles per hour during the night."}]}]},"ghetto":{"h":"ghetto","i":"/ˈɡɛtəʊ/","a":"en-au-ghetto.ogg","s":[{"p":"noun","d":[{"m":"A ghetto is a part of a city lived by poor people, especially a slum area.","e":"was a poor child from the ghetto areas around St. Louis."}]}]},"glare":{"h":"glare","s":[{"p":"verb","d":[{"m":"When you glare at someone, you look at someone angrily.","e":"I glared at the person that knocked into me just now and making me spill my coffee."}]},{"p":"noun","d":[{"m":"A glare is an angry look."}]}]},"gleam":{"h":"gleam","i":"/ɡliːm/","a":"en-us-gleam.ogg","s":[{"p":"verb","d":[{"m":"When you gleam, you shine brightly like mirror, with reflected light.","e":"He gleamed with happiness when he received his examination results."}]}]},"glide":{"h":"glide","i":"/ˈɡlaɪd/","a":"LL-Q1860 (eng)-Vealhurl-glide.wav","s":[{"p":"verb","d":[{"m":"To glide is to move without making an effort.","e":"He glided over the dance-floor."},{"m":"To glide is to float in the air gradually downwards.","e":"When a bird glides, it goes forwards and downward without flapping its wings."},{"m":"To glide is to fly in a glider or an aircraft without an engine.","e":"After losing power, the pilot was able to glide his aircraft to land."}]}]},"gaol":{"h":"gaol","i":"/d͡ʒeɪ(ə)l/","a":"LL-Q1860 (eng)-Vealhurl-gaol.wav","s":[{"p":"noun","d":[{"m":"(countable) A gaol is an old-fashioned way of spelling jail."}]}]},"old-fashioned":{"h":"old-fashioned","i":"/oʊldˈfæʃənd/","a":"LL-Q1860 (eng)-Persent101-old-fashioned.wav","s":[{"p":"adjective","d":[{"m":"Something that looks or is done the way it was a long time ago; often with the intent that is no longer the way things look or are done anymore.","e":"People thought Obadiah Birdwell was old-fashioned because he drove a horse and buggy, wore homespun knickers, and churned his own butter."}]}]},"haddock":{"h":"haddock","i":"/ˈhædək/","s":[{"p":"noun","d":[{"m":"(countable) A haddock is a silvery-grey sea fish, you can eat as a food, related to the cod."}]}]},"hem":{"h":"hem","a":"En-us-hem.ogg","s":[{"p":"noun","d":[{"m":"The hem of clothes is the bottom edge of a cloth, shirt, dress or skirt, which has been turned under and sewn."}]}]},"herd":{"h":"herd","i":"/hɜːd/","a":"en-us-herd.ogg","s":[{"p":"noun","d":[{"m":"(countable) A herd is a large group of animals of the same kind, a group of elephants, cattle, etc."}]}]},"glares":{"h":"glares","l":"glare","q":"verb"},"glared":{"h":"glared","a":"En-us-glared.ogg","l":"glare","q":"verb"},"glaring":{"h":"glaring","i":"/ˈɡlɛərɪŋ/","l":"glare","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is glaring, it reflects a lot of light."}]}]},"gleams":{"h":"gleams","i":"/ɡliːmz/","l":"gleam","q":"verb"},"gleamed":{"h":"gleamed","i":"/ɡliːmd/","l":"gleam","q":"verb"},"gleaming":{"h":"gleaming","i":"/ˈɡliːmɪŋ/","a":"en-us-gleaming.ogg","l":"gleam","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is gleaming, it is very bright looking; it is shiny."}]},{"p":"noun","d":[{"m":"(countable) A gleaming is a flash of light."}]}]},"misuses":{"h":"misuses","l":"misuse","q":"noun"},"misused":{"h":"misused","l":"misuse","q":"verb"},"misusing":{"h":"misusing","l":"misuse","q":"verb"},"vacancies":{"h":"vacancies","l":"vacancy","q":"noun"},"walnuts":{"h":"walnuts","l":"walnut","q":"noun"},"wanders":{"h":"wanders","l":"wander","q":"verb"},"wandered":{"h":"wandered","i":"/ˈwɑndɚd/","a":"en-us-wandered.ogg","l":"wander","q":"verb"},"wandering":{"h":"wandering","a":"En-us-wandering.ogg","l":"wander","q":"verb"},"abolishes":{"h":"abolishes","l":"abolish","q":"verb"},"abolished":{"h":"abolished","l":"abolish","q":"verb"},"abolishing":{"h":"abolishing","l":"abolish","q":"verb"},"gaols":{"h":"gaols","l":"gaol","q":"noun"},"hems":{"h":"hems","l":"hem","q":"noun"},"herds":{"h":"herds","l":"herd","q":"noun"},"vaccines":{"h":"vaccines","l":"vaccine","q":"noun"},"successor":{"h":"successor","a":"en-us-successor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A successor is a person that comes after someone and takes their place.","e":"The king's successor is his son."}]}]},"successors":{"h":"successors","l":"successor","q":"noun"},"invalid":{"h":"invalid","i":"/ɪnˈvæ.lɪd/","a":"en-us-invalid-adj.ogg","s":[{"p":"adjective","d":[{"m":"Something that is invalid is not valid, meaning it is not correct, appropriate, or acceptable.","e":"I learned that my credit card was invalid when I tried to pay for dinner with it."}]},{"p":"noun","d":[{"m":"Someone who is invalid is very sick, often to the point of having to stay in bed or a wheelchair all the time.","e":"George Chaffey's invalid wife had to use a wheelchair for the last ten years of her life"}]}]},"iceberg":{"h":"iceberg","i":"/ˈaɪsbɜːɡ/","a":"en-au-iceberg.ogg","s":[{"p":"noun","d":[{"m":"(countable) An iceberg is a very large piece of ice floating in the sea"}]}]},"icebergs":{"h":"icebergs","l":"iceberg","q":"noun"},"icicle":{"h":"icicle","i":"/ˈʌɪsəkəl/","a":"en-ca-synth-icicle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A icicle is a hanging, tapering long piece of ice down from a roof covered with snow."}]}]},"idol":{"h":"idol","i":"/ˈaɪd(ə)l/","a":"LL-Q1860 (eng)-Vealhurl-idol.wav","s":[{"p":"noun","d":[{"m":"(countable) An idol is a famous person who is greatly admired, loved by many people."},{"m":"(countable) An image of a god that people pray to."}]}]},"ignorance":{"h":"ignorance","i":"/ˈɪɡnərəns/","a":"En-us-ignorance.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Ignorance is a lack of knowledge.","e":"The president's ignorance of the history is surprising."}]}]},"illegible":{"h":"illegible","s":[{"p":"adjective","d":[{"m":"When something is illegible, it can't be read easily; usually not written in common-looking letters.","e":"Your handwriting is illegible, I can't make any sense of it."}]}]},"illiterate":{"h":"illiterate","i":"/ɪˈlɪtərət/","a":"en-us-illiterate.ogg","s":[{"p":"noun","d":[{"m":"(countable) An illiterate person is someone who cannot read nor write."}]},{"p":"adjective","d":[{"m":"When someone is illiterate, it means that the person can't read nor write."}]}]},"javelin":{"h":"javelin","i":"/ˈdʒæv(ə)lɪn/","a":"LL-Q1860 (eng)-Vealhurl-javelin.wav","s":[{"p":"noun","d":[{"m":"(countable) A javelin is a long pointed stick, something like a spear thrown in track and field events."}]}]},"jeer":{"h":"jeer","s":[{"p":"verb","d":[{"m":"When you jeer at someone, you laugh rudely and unkindly with a mock or scoff at the person, humiliating the person.","e":"We jeered at our opponents when they lost to us in the 100m running event."}]}]},"itch":{"h":"itch","i":"/ɪt͡ʃ/","a":"en-us-itch.ogg","s":[{"p":"verb","d":[{"m":"An itch is when you have an uncomfortable feeling on the skin, then you want to scratch it."}]},{"p":"noun","d":[{"m":"(countable) An itch is an uncomfortable feeling on the skin that causes a desire to scratch."}]}]},"ivory":{"h":"ivory","i":"/ˈaɪvəri/","a":"en-us-ivory.ogg","s":[{"p":"noun","d":[{"m":"(singular) Ivory is a creamy-white color."},{"m":"(singular) A hard creamy-white substance taken from the long tooth of an elephant."}]}]},"irrigate":{"h":"irrigate","i":"/ˈɪrəˌɡeɪt/","a":"LL-Q1860 (eng)-Vealhurl-irrigate.wav","s":[{"p":"verb","d":[{"m":"To supply farms with water to grow crops."}]}]},"subtle":{"h":"subtle","i":"/ˈsʌt(ə)l/","a":"en-us-subtle.ogg","s":[{"p":"adjective","d":[{"m":"Subtle means small, slight, not easily noticed, understated.","e":"The smile on the Mona Lisa is a subtle smile."}]}]},"shriek":{"h":"shriek","i":"/ʃriːk/","a":"en-us-shriek.ogg","s":[{"p":"noun","d":[{"m":"(countable) A shriek is a very loud, fairly short cry.","e":"She let out a shriek when the car splashed water over her legs."}]},{"p":"verb","d":[{"m":"If a person shrieks, they give a very loud cry."}]}]},"kitty":{"h":"kitty","i":"/ˈkɪti/","a":"en-au-kitty.ogg","s":[{"p":"noun","d":[{"m":"(countable) A kitty is the offspring of a cat.","e":"My kitty is so playful."}]}]},"irrigates":{"h":"irrigates","l":"irrigate","q":"verb"},"knead":{"h":"knead","i":"/niːd/","a":"en-us-knead.ogg","s":[{"p":"verb","d":[{"m":"When you knead, you press a mixture of flour and water with the hands to make bread."},{"m":"with the hands."}]}]},"knit":{"h":"knit","i":"/ˈnɪt/","a":"en-uk-knit.ogg","s":[{"p":"verb","d":[{"m":"When you knit, you make a cloth from a long wool thread, usually by hands with needles.","e":"My mother loves to knit beautiful scarves for me to wear."}]}]},"knob":{"h":"knob","i":"/nɒb/","a":"en-uk-knob.ogg","s":[{"p":"noun","d":[{"m":"(countable) A knob is a rounded handle on a door or drawer."}]}]},"knuckle":{"h":"knuckle","i":"/ˈnʌkəl/","a":"en-us-knuckle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A knuckle is the joint of a finger, especially the bottom joint of a finger."}]}]},"icicles":{"h":"icicles","l":"icicle","q":"noun"},"ignorances":{"h":"ignorances","l":"ignorance","q":"noun"},"idols":{"h":"idols","l":"idol","q":"noun"},"illiterates":{"h":"illiterates","l":"illiterate","q":"noun"},"javelins":{"h":"javelins","l":"javelin","q":"noun"},"itches":{"h":"itches","l":"itch","q":"verb"},"itched":{"h":"itched","l":"itch","q":"verb"},"itching":{"h":"itching","l":"itch","q":"verb"},"jeers":{"h":"jeers","l":"jeer","q":"verb"},"jeered":{"h":"jeered","l":"jeer","q":"verb"},"jeering":{"h":"jeering","l":"jeer","q":"verb"},"irrigated":{"h":"irrigated","l":"irrigate","q":"verb"},"irrigating":{"h":"irrigating","l":"irrigate","q":"verb"},"shrieks":{"h":"shrieks","l":"shriek","q":"noun"},"ivories":{"h":"ivories","l":"ivory","q":"noun"},"kitties":{"h":"kitties","l":"kitty","q":"noun"},"kneads":{"h":"kneads","l":"knead","q":"verb"},"kneaded":{"h":"kneaded","l":"knead","q":"verb"},"kneading":{"h":"kneading","l":"knead","q":"verb"},"knobs":{"h":"knobs","l":"knob","q":"noun","s":[{"p":"noun","d":[{"m":"In the game of cribbage, knobs is the Jack of the same suit as the card that was revealed after the deck was cut."}]}]},"knits":{"h":"knits","l":"knit","q":"verb"},"knitted":{"h":"knitted","a":"En-us-knitted.ogg","l":"knit","q":"verb"},"knitting":{"h":"knitting","l":"knit","q":"verb"},"knuckles":{"h":"knuckles","l":"knuckle","q":"noun"},"legible":{"h":"legible","i":"/ˈlɛd͡ʒəbl/","a":"LL-Q1860 (eng)-Vealhurl-legible.wav","s":[{"p":"adjective","d":[{"m":"When something is legible, it is clear enough and easy to read and written in beautiful letters."}]}]},"lentil":{"h":"lentil","i":"/ˈlɛntəl/","a":"LL-Q1860 (eng)-Vealhurl-lentil.wav","s":[{"p":"noun","d":[{"m":"Lentil is a type of plants that have edible seeds. These seeds are usually orange, green, brown, dried, round, can be cooked and eaten."}]}]},"liable":{"h":"liable","i":"/ˈlaɪ̯əbəl/","a":"en-us-liable.ogg","s":[{"p":"adjective","d":[{"m":"When you are liable, you are responsible for something by law.","e":"She was liable for the damage her car had caused in the accident."},{"m":"To be liable is to be likely to begin something.","e":"When he had too much to drink he was liable to get into a fight."}]}]},"lick":{"h":"lick","i":"/lɪk/","a":"en-us-lick.ogg","s":[{"p":"verb","d":[{"m":"When you lick something, you touch it with your tongue in order to taste or moisten.","e":"That boy is licking on the ice-cream that his mother bought for him."}]}]},"lentils":{"h":"lentils","l":"lentil","q":"noun"},"licks":{"h":"licks","l":"lick","q":"verb"},"licked":{"h":"licked","l":"lick","q":"verb"},"licking":{"h":"licking","l":"lick","q":"verb"},"wildlife":{"h":"wildlife","s":[{"p":"noun","d":[{"m":"(uncountable) Wildlife is the natural stock of animals and plants found in a particular place. It usually means the native birds and mammals.","e":"The wildlife on the Isle of Skye includes the Red Deer and the Golden Eagle."}]}]},"scenery":{"h":"scenery","i":"/ˈsiːnəri/","a":"en-us-scenery.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Scenery is what you see when you look at the outdoor environment around you. It is a word used to describe places.","e":"The scenery on the island is beautiful."},{"m":"Scenery is the set in a play or other theatrical show.","e":"The scenery for Act Two of The Nutcracker was amazing."}]}]},"heritage":{"h":"heritage","i":"/ˈhɛr.ɪ.tɪd͡ʒ/","a":"en-us-heritage.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Heritage is the sum total of our history. It means what we gained from the past.","e":"The English language and customs are part of the heritage of Australia."}]}]},"picturesque":{"h":"picturesque","a":"En-us-picturesque.ogg","s":[{"p":"adjective","d":[{"m":"Picturesque is an adjective which means \"as pretty as a picture\".","e":"The Isle of Skye is picturesque."}]}]},"mane":{"h":"mane","i":"/meɪn/","a":"en-us-mane.ogg","s":[{"p":"noun","d":[{"m":"The mane of an animal refers to the long hair on the neck of a lion or horse."}]}]},"invalids":{"h":"invalids","l":"invalid","q":"noun"},"marble":{"h":"marble","i":"/ˈmɑːbəl/","a":"en-us-marble.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Marble is a hard stone, typically white or light yellow, polished smooth and shiny, used in making walls, floors or sculptures."},{"m":"(countable) A marble is a small ball made of coloured glass. Marbles are usually used as toys."}]},{"p":"verb","d":[{"m":"(transitive) If something is marbled it has the streaked or swirled appearance of certain types of marble."},{"m":"(transitive) If a piece of meat has great marbling, it is interlaced with fats and its appearance resembles that of marble."}]}]},"marsh":{"h":"marsh","i":"/mɑrʃ/","a":"en-us-marsh.ogg","s":[{"p":"noun","d":[{"m":"(countable) A marsh is an area of low wet soft land."}]}]},"mash":{"h":"mash","i":"/mæʃ/","a":"en-us-mash.ogg","s":[{"p":"verb","d":[{"m":"When you mash something, you crush it with a fork, a pestle, or a similar utensil until it is pulpy."}]}]},"nib":{"h":"nib","i":"/nɪb/","a":"LL-Q1860 (eng)-Vealhurl-nib.wav","s":[{"p":"noun","d":[{"m":"(countable) The nib is the pointed end part of a pen which the ink comes out from."},{"m":"(countable) A cocoa nib is a piece of a roasted and hulled cocoa bean."}]}]},"nibble":{"h":"nibble","i":"/ˈnɪbəl/","a":"LL-Q1860 (eng)-Vealhurl-nibble.wav","s":[{"p":"verb","d":[{"m":"When you nibble on something, you take small bites of a biscuit, bread or food.","e":"That squirrel nibbled on the nut it was holding."}]}]},"nightie":{"h":"nightie","i":"/ˈnaɪti/","s":[{"p":"noun","d":[{"m":"(countable) A nightie is a nightdress for women which they wear when they sleep.","e":"Mary climbed into bed after puttin on her nightie."}]}]},"nomadic":{"h":"nomadic","s":[{"p":"adjective","d":[{"m":"When someone is nomadic, the person is wandering and moving from place to place without a set home."}]}]},"manes":{"h":"manes","l":"mane","q":"noun"},"marshes":{"h":"marshes","l":"marsh","q":"noun"},"mashes":{"h":"mashes","l":"mash","q":"verb"},"mashed":{"h":"mashed","l":"mash","q":"verb"},"mashing":{"h":"mashing","l":"mash","q":"verb"},"marbles":{"h":"marbles","l":"marble","q":"noun"},"nibs":{"h":"nibs","l":"nib","q":"noun"},"nibbles":{"h":"nibbles","l":"nibble","q":"verb"},"nibbled":{"h":"nibbled","l":"nibble","q":"verb"},"nibbling":{"h":"nibbling","l":"nibble","q":"verb"},"nighties":{"h":"nighties","l":"nightie","q":"noun"},"ointment":{"h":"ointment","i":"/ˈɔɪnt.mɪnt/","s":[{"p":"noun","d":[{"m":"An ointment is a smooth oily medicinal substance, or a cosmetic substance that you rub on your skin, usually to ease pain.","e":"The first aid personnel applied ointment on the injured athlete."}]}]},"omelette":{"h":"omelette","i":"/ˈɒm.lɪt/","a":"en-uk-omelette.ogg","s":[{"p":"noun","d":[{"m":"(singular) An omelette is a dish of beaten eggs cooked in oil, often with cheese and sometimes with other ingredients.","e":"For breakfast, I had a three-egg ham and cheese omelette."}]}]},"ooze":{"h":"ooze","i":"/uːz/","a":"en-us-ooze.ogg","s":[{"p":"noun","d":[{"m":"A thick and often unpleasant liquid.","e":"You should put on cleaning gloves if you are going to clean up that nasty ooze."}]},{"p":"verb","d":[{"m":"When something oozes out, it refers to liquid slowly flowing out.","e":"Blood oozed out of the cut."}]}]},"opponent":{"h":"opponent","i":"/əˈpəʊnənt/","a":"LL-Q1860 (eng)-Vealhurl-opponent.wav","s":[{"p":"noun","d":[{"m":"(countable) An opponent is someone who is not in your team in a game, an opposite team."},{"m":"(countable) Someone that objects to something.","e":"The United Nations is an opponent of the possession of child pornography."}]}]},"optimist":{"h":"optimist","i":"/ˈɑptɪmɪst/","s":[{"p":"noun","d":[{"m":"(countable) An optimist is someone who always believes that happy things will happen."}]}]},"sprocket":{"h":"sprocket","s":[{"p":"noun","d":[{"m":"The tooth on a wheel; it goes with a chain or other band with holes."}]}]},"ointments":{"h":"ointments","l":"ointment","q":"noun"},"oozes":{"h":"oozes","l":"ooze","q":"verb"},"oozed":{"h":"oozed","l":"ooze","q":"verb"},"oozing":{"h":"oozing","l":"ooze","q":"verb"},"opponents":{"h":"opponents","a":"En-us-opponents.ogg","l":"opponent","q":"noun"},"optimists":{"h":"optimists","l":"optimist","q":"noun"},"sprockets":{"h":"sprockets","l":"sprocket","q":"noun"},"omelettes":{"h":"omelettes","l":"omelette","q":"noun"},"refuge":{"h":"refuge","i":"/ˈrɛfjuːdʒ/","a":"en-us-refuge.ogg","s":[{"p":"noun","d":[{"m":"(singular) A place that gives something or someone safety, protection or shelter"}]}]},"refuges":{"h":"refuges","l":"refuge","q":"noun"},"safety":{"h":"safety","i":"/ˈseɪfti/","a":"en-us-safety.ogg","s":[{"p":"noun","d":[{"m":"When something is safe or secure","e":"It is important to learn traffic safety so you do not get hurt while crossing the street"},{"m":"Something that keeps a device from accidentally going off","e":"It is important that the safety be on the curtain so that it does fall and hurt the actors"},{"m":"In American football, the player on defense who is furthest from the ball at the start of the play."}]}]},"safeties":{"h":"safeties","l":"safety","q":"noun"},"paddy":{"h":"paddy","a":"en-us-paddy.ogg","s":[{"p":"noun","d":[{"m":"A paddy is a field where rice is grown."},{"m":"Bad temper, bad mood."}]}]},"padlock":{"h":"padlock","i":"/ˈpadˌlɒk/","a":"LL-Q1860 (eng)-Vealhurl-padlock.wav","s":[{"p":"noun","d":[{"m":"(countable) A padlock is a small lock. You can hang it on the door, gate, bicycle."}]},{"p":"verb","d":[{"m":"If you padlock something, you lock it with a [[#Noun|padlock]]."}]}]},"painkiller":{"h":"painkiller","i":"/ˈpeɪnˌkɪlə(r)/","a":"LL-Q1860 (eng)-Vealhurl-painkiller.wav","s":[{"p":"noun","d":[{"m":"(countable) A painkiller is a medicine or a drug to reduce the feeling of pain.","e":"I just ate some painkillers to ease my headache."}]}]},"paddies":{"h":"paddies","l":"paddy","q":"noun"},"padlocks":{"h":"padlocks","l":"padlock","q":"noun"},"painkillers":{"h":"painkillers","l":"painkiller","q":"noun"},"server":{"h":"server","i":"/ˈsɜːvə/","a":"LL-Q1860 (eng)-Vealhurl-server.wav","s":[{"p":"noun","d":[{"m":"(countable) A server is a type of computer that people can access through the Internet to visit a website.","e":"I recently bought a server to host my online shop."},{"m":"(countable) A server is a person who serves food."}]}]},"servers":{"h":"servers","l":"server","q":"noun"},"eminent":{"h":"eminent","i":"/ˈɛmɪnənt/","a":"en-us-eminent.ogg","s":[{"p":"adjective","d":[{"m":"When something is eminent, it means that it is high, lofty; towering; prominent."},{"m":"Something that is noteworthy, remarkable, great.","e":"His eminent good sense has been a great help to this project."},{"m":"Of a person, distinguished, important, noteworthy","e":"In later years, the professor was known as an eminent historian."}]}]},"noteworthy":{"h":"noteworthy","i":"/ˈnəʊtˌwɜːði/","a":"LL-Q1860 (eng)-Vealhurl-noteworthy.wav","s":[{"p":"adjective","d":[{"m":"Deserving attention; notable; worthy of notice.","e":"Zukertort represent the other most noteworthy tournaments."}]},{"p":"noun","d":[{"m":"(countable) A [[#Adjective|noteworthy]] person."}]}]},"passage":{"h":"passage","i":"/ˈpæsɪd͡ʒ/","a":"en-us-passage.ogg","s":[{"p":"noun","d":[{"m":"A passage is the act of passing, from one place to another, or from one state to another","e":"Getting a driver's licence is a rite of passage from being a child to becoming an adult."},{"m":"A passage is a journey by air or water.","e":"His passage to Australia in a sailing ship took 180 days."},{"m":"A passage is a long narrow way or path.","e":"He heard footsteps in the passage outside his hotel room."},{"m":"A passage can be an opening, or a tube along which things can pass.","e":"The small boy had a pea stuck in his nasal passage."},{"m":"A passage is a short section from a book or other writing.","e":"She read to the class her favorite passage from Jane Austen's book."},{"m":"A passage is a short section from a musical work.","e":"There was a long oboe solo is the passage we listened to from Bach's work."}]}]},"passer-by":{"h":"passer-by","s":[{"p":"noun","d":[{"m":"(countable) A passer-by is someone who walks past a location or event.","e":"As the two argued, passers-by paid little attention."}]}]},"pastry":{"h":"pastry","i":"/ˈpeɪstri/","a":"en-us-pastry.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) A pastry is a mixture of flour, fat, and water.","e":"The cook rolled out the pastry to make it thin to use as a pie crust."},{"m":"(countable) A pastry is a small cake with a cream, jam, or fruit filling.","e":"The cake shop had rows of delicious looking pastries."}]}]},"pasture":{"h":"pasture","i":"/ˈpɑːstjə/","a":"en-us-pasture.ogg","s":[{"p":"noun","d":[{"m":"land covered with grass. there are cattle or sheep."}]}]},"patio":{"h":"patio","i":"/ˈpætiəʊ/","a":"en-us-patio.ogg","s":[{"p":"noun","d":[{"m":"(countable) A patio is an outdoor area near a house. Its surface is often covered with stones, tiles, or concrete."}]}]},"patios":{"h":"patios","l":"patio","q":"noun"},"patter":{"h":"patter","i":"/ˈpæt.ə/","a":"LL-Q1860 (eng)-Vealhurl-patter.wav","s":[{"p":"noun","d":[{"m":"Patter refers to the soft sound that feet makes when walking on a hard surface.","e":"The night was very quiet, and I could hear the patter of the mice crawling in the kitchen."},{"m":"When someone makes a patter, the person is speaking very fast and the words have no meaning.","e":"Before the magician started on his magic trick, he got the attention of the audience through his patter."},{"m":"A patter is someone who pats."}]},{"p":"verb","d":[{"m":"Pattering refers to the sound made by the rain when it hits a surface."},{"m":"When someone patters, the person is trying to speak quickly without having meaning in the words, to [[#Noun|patter]]."}]}]},"outdoor":{"h":"outdoor","i":"/ˌaʊtˈdɔː/","a":"LL-Q1860 (eng)-Vealhurl-outdoor.wav","s":[{"p":"adjective","d":[{"m":"not in a building; out of a building","e":"We cooked dinner on an outdoor barbecue rather than on the stove."}]}]},"barbecue":{"h":"barbecue","i":"/ˈbɑːbɪˌkjuː/","a":"en-us-barbecue.ogg","s":[{"p":"noun","d":[{"m":"A style of cooking that involves meat being cooked on a grill or in a pit, then often covered in a special sauce.","e":"Chris' Black Oak Restaurant serves barbecue ribs and chicken."},{"m":"The grill for cooking barbecue; or for grilling anything in general.","e":"I put two hot dogs and two hamburgers on the barbecue."},{"m":"A meal of barbecue.","e":"There was a big barbecue in Riverside Park for the Fourth of July."}]},{"p":"verb","d":[{"m":"To cook food in the barbecue style."}]}]},"barbecues":{"h":"barbecues","l":"barbecue","q":"noun"},"barbecued":{"h":"barbecued","l":"barbecue","q":"verb"},"barbecuing":{"h":"barbecuing","l":"barbecue","q":"verb"},"post-production":{"h":"post-production","s":[{"p":"noun","d":[{"m":"The last part of movie production, happening after the movie is filmed, where changes are made before the product is finished."}]}]},"ransom":{"h":"ransom","i":"/ˈrænsəm/","a":"LL-Q1860 (eng)-Vealhurl-ransom.wav","s":[{"p":"noun","d":[{"m":"A ransom is the money demanded by criminals usually paid for the release of a kidnapped person.","e":"The kidnappers wanted us to pay $2.5million as ransom to release the boy."}]}]},"rascal":{"h":"rascal","i":"/ˈrɑːskl̩/","a":"en-us-rascal.ogg","s":[{"p":"noun","d":[{"m":"(countable) A rascal is a bad child or a bad boy.","e":"That rascal made me spill milk all over the floor."}]}]},"rash":{"h":"rash","i":"/ræʃ/","a":"en-us-rash.ogg","s":[{"p":"adjective","d":[{"m":"When you do something rash, you do it too hurriedly without careful consideration.","e":"The accident was a result of his rash act."}]},{"p":"noun","d":[{"m":"(dermatology) Rashes are red spots on your skin that may cause irritation.","e":"A rash appeared on his leg."}]}]},"ration":{"h":"ration","i":"/ˈræʃən/","a":"en-us-ration.ogg","s":[{"p":"noun","d":[{"m":"(countable) A ration is a portion of a limited resource that is given to a person."}]},{"p":"verb","d":[{"m":"When food is being rationed, there is a limit on each person to have only a small amount of food, especially during wartime."}]}]},"draught":{"h":"draught","i":"/drɑːft/","a":"en-us-draught.ogg","s":[{"p":"noun","d":[{"m":"(countable) A draught is a wind which blows through a building."},{"m":"(countable) A draught is a piece which is used in a game called draughts."},{"m":"A draught is a mild vesicatory."}]},{"p":"verb","d":[{"m":"(transitive) To draught means to draw."},{"m":"(transitive) To draught means to pull something along, especially a vehicle or a tractor."}]}]},"draughts":{"h":"draughts","a":"en-us-draughts.ogg","l":"draught","q":"noun"},"symptom":{"h":"symptom","i":"/ˈsɪm(p)təm/","a":"LL-Q1860 (eng)-Vealhurl-symptom.wav","s":[{"p":"noun","d":[{"m":"(countable) A symptom is a sign or indication of something, usually an illness.","e":"He began to show symptoms of chicken pox a few days ago."}]}]},"sag":{"h":"sag","i":"/sæɡ/","a":"LL-Q1860 (eng)-Mélange a trois-sag.wav","s":[{"p":"verb","d":[{"m":"When something sags, it sink downwards, bend lower from the usual position usually due to a heavy weight."}]}]},"salute":{"h":"salute","i":"/səˈlut/","a":"en-us-salute.ogg","s":[{"p":"noun","d":[{"m":"(countable) A salute is a greeting gesture in the army and navy by hold up a right hand to the forehead."}]},{"p":"verb","d":[{"m":"When you salute at someone, you greet at the person, usually out of respect.","e":"The group of soldiers saluted at the parade's guest of honour."}]}]},"sap":{"h":"sap","a":"en-us-sap.ogg","s":[{"p":"noun","d":[{"m":"Sap is the liquid inside a plant that carries sugars and minerals."}]}]},"sapphire":{"h":"sapphire","i":"/ˈsæf.aɪ̯ə(r)/","a":"en-us-sapphire.ogg","s":[{"p":"noun","d":[{"m":"A sapphire is a transparent blue stone used in jewellery."},{"m":"(uncountable) A deep blue colour."}]}]},"sarcastic":{"h":"sarcastic","i":"/sɑːˈkæstik/","a":"LL-Q1860 (eng)-Vealhurl-sarcastic.wav","s":[{"p":"adjective","d":[{"m":"When someone is sarcastic, the person is using words in irony or unkindness, usually to mock people."}]}]},"coleslaw":{"h":"coleslaw","i":"/ˈkəʊlslɔː/","a":"en-ca-coleslaw.ogg","s":[{"p":"noun","d":[{"m":"Coleslaw is a type of salad. It is made with shredded cabbage, buttermilk and mayonnaise. Sometimes it contains other ingredients.","e":"For lunch, I had a chicken leg with a side of coleslaw."}]}]},"mayonnaise":{"h":"mayonnaise","i":"/ˈmeɪ.ə.neɪz/","a":"en-us-mayonnaise.ogg","s":[{"p":"noun","d":[{"m":"Mayonnaise is a condiment. It is often used as a spread or a dressing. It is made of eggs, oil and vinegar or lemon juice."}]}]},"vinegar":{"h":"vinegar","i":"/ˈvɪnəɡɚ/","a":"en-us-vinegar.ogg","s":[{"p":"noun","d":[{"m":"Vinegar is a liquid made by fermenting fruit or grain. It is also an acid.","e":"When you mix vinegar and baking soda, it explodes in a chemical reaction."}]}]},"ferment":{"h":"ferment","i":"/fəˈmɛnt/","a":"LL-Q1860 (eng)-Vealhurl-ferment.wav","s":[{"p":"verb","d":[{"m":"When something ferments, it turns into alcohol. This happens when sugar in fruit or grain ages or is acted on by yeast.","e":"When the grape juice was left in a barrel for a year, it fermented into wine."},{"m":"When you ferment an emotion, you stir it up or arouse it.","e":"The preacher fermented anger with the government from the pulpit."}]},{"p":"noun","d":[{"m":"A ferment is a state of arousal or change.","e":"There was a ferment of reform caused by the."}]}]},"ferments":{"h":"ferments","l":"ferment","q":"verb"},"fermented":{"h":"fermented","l":"ferment","q":"verb"},"fermenting":{"h":"fermenting","l":"ferment","q":"verb"},"constructive":{"h":"constructive","i":"/kənˈstrʌktɪv/","a":"LL-Q1860 (eng)-Vealhurl-constructive.wav","s":[{"p":"adjective","d":[{"m":"When something is constructive, it is usually carefully considered and meant to be helpful.","e":"Your constructive feedback is appreciated to help us improve our service in the future."}]}]},"fertilizer":{"h":"fertilizer","i":"/ˈfɜːtəlaɪzə/","a":"LL-Q1860 (eng)-Vealhurl-fertilizer.wav","s":[{"p":"noun","d":[{"m":"Fertilizer is something which is added to soil to help plants grow.","e":"I added two bags of fertilizer to my pumpkin patch."}]}]},"fertilizers":{"h":"fertilizers","l":"fertilizer","q":"noun"},"featureless":{"h":"featureless","i":"/ˈfi.t͡ʃɚ.ləs/","a":"LL-Q1860 (eng)-Qwertygiy-featureless.wav","s":[{"p":"adjective","d":[{"m":"When something is featureless, it is without features.","e":"The featureless landscape of the desert made the trip very boring."}]}]},"ransoms":{"h":"ransoms","l":"ransom","q":"noun"},"rascals":{"h":"rascals","l":"rascal","q":"noun"},"coleslaws":{"h":"coleslaws","l":"coleslaw","q":"noun"},"rashes":{"h":"rashes","l":"rash","q":"noun"},"rations":{"h":"rations","a":"en-us-rations.ogg","l":"ration","q":"noun"},"rationed":{"h":"rationed","l":"ration","q":"verb"},"rationing":{"h":"rationing","l":"ration","q":"verb"},"symptoms":{"h":"symptoms","l":"symptom","q":"noun"},"sags":{"h":"sags","l":"sag","q":"verb"},"sagged":{"h":"sagged","l":"sag","q":"verb"},"sagging":{"h":"sagging","l":"sag","q":"verb"},"salutes":{"h":"salutes","l":"salute","q":"noun"},"saluted":{"h":"saluted","i":"/səˈlutɪd/","a":"en-us-saluted.ogg","l":"salute","q":"verb"},"saluting":{"h":"saluting","l":"salute","q":"verb"},"sapphires":{"h":"sapphires","l":"sapphire","q":"noun"},"condiment":{"h":"condiment","i":"/ˈkɒn.dɪ.mənt/","a":"LL-Q1860 (eng)-Vealhurl-condiment.wav","s":[{"p":"noun","d":[{"m":"(countable) A condiment is something that is added to a food to give it more flavor or a different flavor. Examples include ketchup and horseradish.","e":"At the big picnic in the park, there were condiments for our hot dogs next to the buns."}]}]},"condiments":{"h":"condiments","l":"condiment","q":"noun"},"ketchup":{"h":"ketchup","i":"/ˈkɛtʃ.əp/","a":"en-us-ketchup.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Ketchup is a condiment. It is a liquid made mostly of tomato paste and vinegar.","e":"I covered my hamburger and french fries with a generous helping of ketchup."}]}]},"horseradish":{"h":"horseradish","i":"/ˈhɔrsrædɪʃ/","a":"en-us-horseradish.ogg","s":[{"p":"noun","d":[{"m":"A plant that is similar to the mustard plant."},{"m":"(uncountable) A very hot-tasting condiment that comes from the plant.","e":"After eating a steak with too much horseradish on it, Terrance burnt his tongue"}]}]},"horseradishes":{"h":"horseradishes","l":"horseradish","q":"noun"},"tedious":{"h":"tedious","i":"/ˈtiː.dɪəs/","a":"en-us-tedious.ogg","s":[{"p":"adjective","d":[{"m":"Something that is tedious takes a long time to do and is boring.","e":"I've stopped making Flash movies because the process is tedious and more trouble than its worth."}]}]},"telly":{"h":"telly","i":"/ˈtɛli/","a":"LL-Q1860 (eng)-Vealhurl-telly.wav","s":[{"p":"noun","d":[{"m":"(countable) (UK) A telly is a television."}]}]},"tellys":{"h":"tellys","l":"telly","q":"noun"},"tellies":{"h":"tellies","l":"telly","q":"noun"},"tempt":{"h":"tempt","i":"/tɛmpt/","a":"en-us-tempt.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you tempt someone, you try to get someone to do something, perhaps something bad or immoral.","e":"He was tempted to steal that expensive phone on the table."}]}]},"tenant":{"h":"tenant","i":"/ˈtɛ.nənt/","a":"LL-Q1860 (eng)-Vealhurl-tenant.wav","s":[{"p":"noun","d":[{"m":"(countable) A tenant is a person who occupies the land or house from a landlord. He pays money to a landlord as rent."}]},{"p":"verb","d":[{"m":"If someone tenants a place, they are occupying it as a [[#Noun|tenant]]."}]}]},"tempts":{"h":"tempts","l":"tempt","q":"verb"},"tempted":{"h":"tempted","l":"tempt","q":"verb"},"tempting":{"h":"tempting","i":"/ˈtɛmp.tɪŋ/","a":"en-us-tempting.ogg","l":"tempt","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is tempting, it is attractive or appeals to someone."}]}]},"tenants":{"h":"tenants","l":"tenant","q":"noun"},"co-worker":{"h":"co-worker","i":"/ˈkoʊˈwɝ.kɚ/","a":"en-us-coworker.ogg","s":[{"p":"noun","d":[{"m":"(countable) A co-worker is someone a person works with."}]}]},"intentional":{"h":"intentional","i":"/ɪnˈtɛnʃənəl/","a":"LL-Q1860 (eng)-Vealhurl-intentional.wav","s":[{"p":"adjective","d":[{"m":"Intentional means done deliberately; on purpose, not by accident.","e":"\"Teacher! Jimmy just stepped on my foot again! That was intentional! Please make him stop.\""}]}]},"verify":{"h":"verify","i":"/ˈvɛrɪfaɪ/","a":"LL-Q1860 (eng)-Vealhurl-verify.wav","s":[{"p":"verb","d":[{"m":"To verify something is to get evidence to show that it is true.","e":"My receipts verified that I had always paid my telephone bills."}]}]},"degeneration":{"h":"degeneration","i":"/dɪˌdʒɛnəˈreɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-degeneration.wav","s":[{"p":"noun","d":[{"m":"When something undergoes degeneration, it starts to get worse day by day. It is almost like it grows in reverse, with the most weak and delicate parts dying first."}]}]},"despise":{"h":"despise","i":"/dɪˈspaɪz/","a":"en-us-despise.ogg","s":[{"p":"verb","d":[{"m":"To despise something is to feel the very worst about it.","e":"The step-sisters of Cinderella despised her."}]}]},"possess":{"h":"possess","i":"/pəˈzɛs/","a":"en-us-possess.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To have or to own","e":"He does not possess a car."},{"m":"(transitive) To take control of someone's soul.","e":"The evil spirit was going to possess her."}]}]},"campaigner":{"h":"campaigner","i":"/kamˈpeɪnə/","s":[{"p":"noun","d":[{"m":"A campaigner is a person that tries to get support from others."},{"m":"A campaigner is a politician that runs for an office."}]}]},"possesses":{"h":"possesses","l":"possess","q":"verb"},"possessed":{"h":"possessed","i":"/pəˈzɛst/","a":"en-us-possessed.ogg","l":"possess","q":"verb"},"possessing":{"h":"possessing","a":"En-us-possessing.ogg","l":"possess","q":"verb"},"fanatical":{"h":"fanatical","i":"/fəˈnætɪkəl/","a":"LL-Q1860 (eng)-Vealhurl-fanatical.wav","s":[{"p":"adjective","d":[{"m":"When you are fanatical, you are in something strongly.","e":"was fanatical about the quality of his company's products."}]}]},"co-workers":{"h":"co-workers","l":"co-worker","q":"noun"},"verifies":{"h":"verifies","a":"En-us-verifies.ogg","l":"verify","q":"verb"},"verified":{"h":"verified","l":"verify","q":"verb"},"verifying":{"h":"verifying","l":"verify","q":"verb"},"degenerations":{"h":"degenerations","l":"degeneration","q":"noun"},"despises":{"h":"despises","l":"despise","q":"verb"},"despised":{"h":"despised","l":"despise","q":"verb","s":[{"p":"adjective","d":[{"m":"A despised person is someone who is hated."}]}]},"despising":{"h":"despising","l":"despise","q":"verb"},"campaigners":{"h":"campaigners","l":"campaigner","q":"noun"},"virtue":{"h":"virtue","i":"/ˈvɜː.t͡ʃuː/","a":"en-us-virtue.ogg","s":[{"p":"noun","d":[{"m":"A virtue is a morally good characteristic in a person. For example, honesty, patience, etc."}]}]},"vivid":{"h":"vivid","i":"/ˈvɪvɪd/","a":"en-us-vivid.ogg","s":[{"p":"adjective","d":[{"m":"When something is vivid, it is very bright or deep in color."},{"m":"Producing clear images in your mind."}]}]},"volleyball":{"h":"volleyball","i":"/ˈvɒlibɔ(ː)l/","a":"en-us-volleyball.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Volleyball is a ball game for two teams of six players across a high net, they hit a large ball with their hands to touch it on the opposite court."},{"m":"(countable) A volleyball refers to the ball that is used in a game of Volleyball."}]}]},"virtues":{"h":"virtues","a":"En-us-virtues.ogg","l":"virtue","q":"noun"},"volleyballs":{"h":"volleyballs","l":"volleyball","q":"noun"},"breakthrough":{"h":"breakthrough","i":"/ˈbreɪkθruː/","a":"en-us-breakthrough.ogg","s":[{"p":"noun","d":[{"m":"A breakthrough is a sudden change, a change from not being able to do something to being able to do something.","e":"After the breakthrough, rubber could be made in a factory and rubber trees were no longer the only source of rubber."}]}]},"publisher":{"h":"publisher","i":"/ˈpʌblɪʃɚ/","a":"en-us-publisher.ogg","s":[{"p":"noun","d":[{"m":"(countable) A publisher is a person or a company that prints books, magazines, etc. and sells them to people."}]}]},"warden":{"h":"warden","i":"/ˈwɔːdən/","a":"LL-Q1860 (eng)-Vealhurl-warden.wav","s":[{"p":"noun","d":[{"m":"(countable) A warden is a person who looks after a dormitory, a youth hostel."},{"m":"(countable) A warden is a person who watches a park, a traffic, etc."},{"m":"(countable) A warden is a head of a school, a prison, a hospital, a public office."}]}]},"warfare":{"h":"warfare","i":"/ˈwɔrfɛr/","a":"en-us-warfare.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) the fighting in a war."}]}]},"washbasin":{"h":"washbasin","s":[{"p":"noun","d":[{"m":"(countable) A washbasin is a large bowl fixed to a wall used for washing your hands and face."}]}]},"wasp":{"h":"wasp","i":"/wɒsp/","a":"En-us-wasp.ogg","s":[{"p":"noun","d":[{"m":"A wasp is a yellow and black insect which flies fast, has a narrow waist and a sting, bigger than a bee."}]}]},"watt":{"h":"watt","i":"/wɒt/","a":"LL-Q1860 (eng)-Vealhurl-watt.wav","s":[{"p":"noun","d":[{"m":"(countable) A watt is a measure of electrical power.","e":"One watt is equal to one joule per second."}]}]},"publishers":{"h":"publishers","l":"publisher","q":"noun"},"artifice":{"h":"artifice","s":[{"p":"noun","d":[{"m":"Something that is artifice refers to an artificial object, something that is man-made."}]}]},"unstable":{"h":"unstable","i":"/ʌnˈsteɪbəɫ/","a":"LL-Q1860 (eng)-Vealhurl-unstable.wav","s":[{"p":"adjective","d":[{"m":"Something that is not stable, can change suddenly."}]}]},"advert":{"h":"advert","i":"/ˈædvɜːt/","a":"LL-Q1860 (eng)-Vealhurl-advert1.wav","s":[{"p":"noun","d":[{"m":"(countable) An advert is something that advertises something."}]}]},"aerosol":{"h":"aerosol","i":"/ˈɛɚ.əˌsɔl/","a":"LL-Q1860 (eng)-Vealhurl-aerosol.wav","s":[{"p":"noun","d":[{"m":"(countable) An aerosol is a fine spray from a can (container) with a button on the top. When you push it, a liquid can be sprayed."}]}]},"agony":{"h":"agony","i":"/ˈæ.ɡə.niː/","a":"en-us-agony.ogg","s":[{"p":"noun","d":[{"m":"Agony is extremely bad suffering with strong pain."}]}]},"conquest":{"h":"conquest","a":"En-us-conquest.ogg","s":[{"p":"noun","d":[{"m":"(countable) a take-over by force"}]}]},"conquests":{"h":"conquests","a":"En-us-conquests.ogg","l":"conquest","q":"noun"},"banister":{"h":"banister","i":"/ˈbænɪstə(r)/","a":"en-us-banister.ogg","s":[{"p":"noun","d":[{"m":"A banister is a type of fence at the outer side of stairs."}]}]},"banner":{"h":"banner","i":"/ˈbænə/","a":"en-us-banner.ogg","s":[{"p":"noun","d":[{"m":"(countable) A banner is piece of long cloth with writing on."}]}]},"banquet":{"h":"banquet","i":"/ˈbæŋkwɪt/","a":"en-u