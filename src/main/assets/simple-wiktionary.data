 (eng)-Vealhurl-fertility.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Fertility is the condition of being fertile.","e":"ash increases the fertility of the soil."},{"m":"(countable) Fertility is the birth rate of a population; the number of live births per 1000 people per year."}]}]},"fertilities":{"h":"fertilities","l":"fertility","q":"noun"},"bleak":{"h":"bleak","i":"/bliːk/","a":"en-us-bleak.ogg","s":[{"p":"adjective","d":[{"m":"If a place is bleak, it is empty, and not or attractive."},{"m":"If a situation is bleak, there is little or no hope for the future:."}]},{"p":"noun","d":[{"m":"Bleaks are a small European river fish (), of the family."}]}]},"bleaks":{"h":"bleaks","l":"bleak","q":"noun"},"bleaker":{"h":"bleaker","l":"bleak","q":"adjective"},"bleakest":{"h":"bleakest","l":"bleak","q":"adjective"},"filthy":{"h":"filthy","i":"/ˈfɪlθi/","a":"en-us-filthy.ogg","s":[{"p":"adjective","d":[{"m":"If something is filthy it is very dirty."},{"m":"Something that is filthy is gross or undesirable."}]}]},"filthier":{"h":"filthier","l":"filthy","q":"adjective"},"filthiest":{"h":"filthiest","l":"filthy","q":"adjective"},"spicy":{"h":"spicy","i":"/ˈspaɪsi/","a":"LL-Q1860 (eng)-Vealhurl-spicy.wav","s":[{"p":"adjective","d":[{"m":"A spicy food feels hot in your mouth because of chilies or similar spices.","e":"This curry is too spicy for me. I can't eat it."},{"m":"A spicy situation is one that is challenging, intense, or potentially controversial.","e":"Their spicy relationship was full of angry arguments and hot sex."}]}]},"spicier":{"h":"spicier","l":"spicy","q":"adjective"},"spiciest":{"h":"spiciest","l":"spicy","q":"adjective"},"smelly":{"h":"smelly","i":"/ˈsmɛli/","a":"en-au-smelly.ogg","s":[{"p":"adjective","d":[{"m":"If something is smelly, it has a strong and unpleasant smell."}]}]},"smellier":{"h":"smellier","l":"smelly","q":"adjective"},"smelliest":{"h":"smelliest","l":"smelly","q":"adjective"},"rowdy":{"h":"rowdy","i":"/ˈraʊdi/","s":[{"p":"adjective","d":[{"m