n activity, or period of office."}]},{"p":"noun","d":[{"m":"An inaugural is a formal speech given at the beginning of an office.","e":"In his inaugural, President Obama proclaimed 'an end to the petty grievances and false promises, the recriminations and worn-out dogmas, that for far too long have strangled our politics'."}]}]},"inaugurals":{"h":"inaugurals","l":"inaugural","q":"noun"},"proclaim":{"h":"proclaim","i":"/proʊˈkleɪm/","a":"LL-Q1860 (eng)-Vealhurl-proclaim.wav","s":[{"p":"verb","d":[{"m":"If you proclaim something, you announce or declare it."}]}]},"proclaims":{"h":"proclaims","l":"proclaim","q":"verb"},"proclaimed":{"h":"proclaimed","l":"proclaim","q":"verb"},"proclaiming":{"h":"proclaiming","l":"proclaim","q":"verb"},"inaugurate":{"h":"inaugurate","i":"/ɪˈnɔːɡjʊreɪt/","a":"LL-Q1860 (eng)-Vealhurl-inaugurate.wav","s":[{"p":"verb","d":[{"m":"(transitive) If someone is being inaugurated, they are being sworn into office with a formal ceremony."}]}]},"inaugurates":{"h":"inaugurates","l":"inaugurate","q":"verb"},"inaugurated":{"h":"inaugurated","l":"inaugurate","q":"verb"},"inaugurating":{"h":"inaugurating","l":"inaugurate","q":"verb"},"inauguration":{"h":"inauguration","i":"/ɪnɔːɡ(j)ʊˈreɪʃən/","a":"LL-Q1860 (eng)-Vininn126-inauguration.wav","s":[{"p":"noun","d":[{"m":"Inauguration is the formal beginning or initiation of any act."},{"m":"Inauguration is the formal formal admission of someone to office.","e":"The President's inauguration will happen in 2 weeks."}]}]},"inaugurations":{"h":"inaugurations","l":"inauguration","q":"noun"},"initiation":{"h":"initiation","i":"/ɪ.nɪ.ʃi.ˈeɪ.ʃən/","a":"LL-Q1860 (eng)-Vealhurl-initiation.wav","s":[{"p":"noun","d":[{"m":"Initiation is the act of admitting someone into a secret society or group, usually with a ritual."},{"m":"Initiation is the action of beginning something."}]}]},"initiations":{"h":"initiations","l":"initiation","q":"noun"},"cue":{"h":"cue","i":"/kjuː/","a":"en-us-queue.ogg","s":[{"p":"noun","d":[{"m":"A cue is an action that signals somebody to do something."}]},{"p":"verb","d":[{"m":"If you cue someone, you give them a [[#Noun|cue]] signal."}]}]},"cues":{"h":"cues","l":"cue","q":"noun"},"cued":{"h":"cued","l":"cue","q":"verb"},"cueing":{"h":"cueing","l":"cue","q":"verb"},"contractor":{"h":"contractor","i":"/ˈkɒnˌtræk.tə(r)/","s":[{"p":"noun","d":[{"m":"(countable) A contractor is a person or company that is hired via a business contract to provide services or materials."}]}]},"contractors":{"h":"contractors","l":"contractor","q":"noun"},"constitute":{"h":"constitute","i":"/ˈkɒnstɪtjuːt/","a":"en-uk-constitute.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If something is being constituted, it is being set up or established.","e":"Laws appointed and constituted by lawful authority."},{"m":"(transitive) If A constitutes B, it combines to form C.","e":"Truth and reason constitute the intellectual gold that destruction."}]}]},"constitutes":{"h":"constitutes","i":"/ˈkɑnstɪtuts/","l":"constitute","q":"verb"},"constituted":{"h":"constituted","i":"/ˈkɑnstɪtutɪd/","l":"constitute","q":"verb"},"constituting":{"h":"constituting","l":"constitute","q":"verb"},"collapsable":{"h":"collapsable","s":[{"p":"adjective","d":[{"m":"If something is collapsable, it can be collapsed."}]}]},"collapsible":{"h":"collapsible","s":[{"p":"adjective","d":[{"m":"If something is collapsible, it can be collapsed."}]}]},"cookery":{"h":"cookery","i":"/ˈkʊkəri/","a":"LL-Q1860 (eng)-Vealhurl-cookery.wav","s":[{"p":"noun","d":[{"m":"Cookery is the practice of and cooking food."}]}]},"cookeries":{"h":"cookeries","l":"cookery","q":"noun"},"chronicle":{"h":"chronicle","i":"/ˈkrɑnɪkl̩/","a":"LL-Q1860 (eng)-Vealhurl-chronicle.wav","s":[{"p":"noun","d":[{"m":"A chronicle is a written account of events in the order of when they happened."}]},{"p":"verb","d":[{"m":"If something is chronicled, it is recorded in or as a [[#Noun|chronicle]]."}]}]},"chronicles":{"h":"chronicles","l":"chronicle","q":"noun"},"chron