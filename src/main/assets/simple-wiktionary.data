territory controlled by an earl."}]}]},"earldoms":{"h":"earldoms","l":"earldom","q":"noun"},"viscount":{"h":"viscount","i":"/ˈvaɪkaʊnt/","a":"en-uk-viscount.ogg","s":[{"p":"noun","d":[{"m":"(countable) A viscount is a British or Irish nobleman, above a baron but below a count or earl. A female using the style is termed a viscountess."}]}]},"viscounts":{"h":"viscounts","l":"viscount","q":"noun"},"viscountess":{"h":"viscountess","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-viscountess.wav","s":[{"p":"noun","d":[{"m":"(countable) A viscountess is the wife of a viscount."},{"m":"(countable) A viscountess is a woman holding the rank of viscount in her own right."}]}]},"viscountesses":{"h":"viscountesses","l":"viscountess","q":"noun"},"baron":{"h":"baron","i":"/ˈbærən/","a":"LL-Q1860 (eng)-Vealhurl-baron.wav","s":[{"p":"noun","d":[{"m":"(countable) A baron is the male ruler of a barony."},{"m":"(countable) A baron is a male member of the lowest rank of English nobility. A female using the style is termed a baroness."}]}]},"barons":{"h":"barons","l":"baron","q":"noun"},"barony":{"h":"barony","i":"/ˈbæ.rə.ni/","s":[{"p":"noun","d":[{"m":"A barony is the territory controlled by an baron."},{"m":"A barony is the rank or position of a baron."}]}]},"baronies":{"h":"baronies","l":"barony","q":"noun"},"baroness":{"h":"baroness","i":"/ˌbæ.rəˈnɛs/","a":"LL-Q1860 (eng)-Vealhurl-baroness.wav","s":[{"p":"noun","d":[{"m":"(countable) A baroness is the wife of a baron."},{"m":"(countable) A baroness is a woman holding the rank of baron in her own right."}]}]},"baronesses":{"h":"baronesses","l":"baroness","q":"noun"},"marquess":{"h":"marquess","i":"/ˈmɑː.kwɪs/","a":"en-us-marquess.ogg","s":[{"p":"noun","d":[{"m":"Marquess is the title of nobility for a man ranking beneath a duke and above an earl. A female using the style is termed a marchioness."}]}]},"marquesses":{"h":"marquesses","l":"marquess","q":"noun"},"marchioness":{"h":"marchioness","i":"/ˈmɑrʃənɨs/","s":[{"p":"