d":{"h":"endured","l":"endure","q":"verb"},"enduring":{"h":"enduring","l":"endure","q":"verb"},"antidepressant":{"h":"antidepressant","s":[{"p":"noun","d":[{"m":"(countable) An antidepressant is a medicine given to treat depression.","e":"I was depressed, so my doctor put me on antidepressant tablets to help me feel better."}]}]},"antidepressants":{"h":"antidepressants","l":"antidepressant","q":"noun"},"remote":{"h":"remote","i":"[rɪˈməʊt]","a":"en-us-remote.ogg","s":[{"p":"adjective","d":[{"m":"Something that is remote is a long way off, distant, not near anything.","e":"The internet is a powerful tool for bringing modern medicine to remote areas."},{"m":"When a television or radio broadcast is remote, it is done in someplace other than a studio","e":"The reporter did a live remote broadcast from the scene of the fire."}]},{"p":"noun","d":[{"m":"(countable) A remote is something used to change the volume or channel on a television.","e":"I wanted to change the channel after the show ended, but the remote was under the couch."}]}]},"renovate":{"h":"renovate","i":"/ˈrenəʊveɪt/","a":"LL-Q1860 (eng)-Vininn126-renovate.wav","s":[{"p":"verb","d":[{"m":"If you renovate something, you fix and change it to make it look newer and better.","e":"Joe is going to renovate his basement over the summer."}]}]},"renovates":{"h":"renovates","l":"renovate","q":"verb"},"renovated":{"h":"renovated","l":"renovate","q":"verb"},"renovating":{"h":"renovating","l":"renovate","q":"verb"},"renovation":{"h":"renovation","i":"/ˈrɛnəveɪʃən/","a":"LL-Q1860 (eng)-Vealhurl-renovation.wav","s":[{"p":"noun","d":[{"m":"A renovation is the process of changing or fixing a building to make it look newer and better.","e":"The school did renovations on the classrooms over the summer."}]}]},"renovations":{"h":"renovations","l":"renovation","q":"noun"},"rubidium":{"h":"rubidium","i":"/ˌrʊuˈbɪd.iː.ʌm/","a":"LL-Q1860 (eng)-Vealhurl-rubidium.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Rubidium is a chemical element (symbol Rb) with an atomic number of 37. It is a soft silver-coloured metal."}]}]},"gross":{"h":"gross","i":"/ɡrəʊs/","a":"en-us-gross.ogg","s":[{"p":"adjective","d":[{"m":"The gross amount is the total before you take away losses or expenses.","e":"Her gross pay was $500, but then they took out $60 for tax."},{"m":"A gross violation or abuse is very bad and clearly wrong.","e":"Leaving the bank unlocked was an act of gross carelessness."},{"m":"If something is gross is very unpleasant.","e":"There was a gross smell coming from the broken pipe."}]},{"p":"noun","d":[{"m":"A gross is twelve dozen = 144."}]}]},"renovator":{"h":"renovator","s":[{"p":"noun","d":[{"m":"(countable) A renovator is a person or company that does renovations.","e":"These tools are popular with buyers, builders and home renovators."}]}]},"androgyne":{"h":"androgyne","i":"/ˈæn.drə.d͡ʒaɪn/","a":"LL-Q1860 (eng)-Vealhurl-androgyne.wav","s":[{"p":"noun","d":[{"m":"(countable) A person who is masculine and feminine at the same time."},{"m":"(countable) A person who is androgynous."}]}]},"androgynes":{"h":"androgynes","l":"androgyne","q":"noun"},"stagnant":{"h":"stagnant","i":"/ˈstæɡnənt/","a":"LL-Q1860 (eng)-Mélange a trois-stagnant.wav","s":[{"p":"adjective","d":[{"m":"If something is stagnant, it is not moving."}]}]},"esperanto":{"h":"Esperanto","i":"/ˌɛspəˈræntəʊ/","a":"en-us-Esperanto.ogg","s":[{"p":"proper noun","d":[{"m":"Esperanto is a language that was created by."}]}]},"orphanage":{"h":"orphanage","i":"/ˈɔː(r)fənɪd͡ʒ/","a":"LL-Q1860 (eng)-Vealhurl-orphanage.wav","s":[{"p":"noun","d":[{"m":"(countable) An orphanage is a place where orphans live, and are cared for.","e":"He grew up in an orphanage after his parents died."}]}]},"orphanages":{"h":"orphanages","l":"orphanage","q":"noun"},"juvenile":{"h":"juvenile","i":"/ˈdʒuːvənaɪl/","a":"en-au-juvenile.ogg","s":[{"p":"adjective","d":[{"m":"If a person is juvenile, they are childish and immature."}]},{"p":"noun","d":[{"m":"(countable) A juvenile is a young stage in the development of an animal. It applies to animals which have 'direct development' from the egg, not those which undergo metamorphosis.","e":"Young male lions which do not have manes, and are not ready for breeding, are juveniles."}]}]},"remoter":{"h":"remoter","l":"remote","q":"adjective"},"remotest":{"h":"remotest","l":"remote","q":"adjective"},"juveniles":{"h":"juveniles","l":"juvenile","q":"noun"},"grosser":{"h":"grosser","l":"gross","q":"adjective"},"grossest":{"h":"grossest","l":"gross","q":"adjective"},"renovators":{"h":"renovators","l":"renovator","q":"noun"},"splinters":{"h":"splinters","l":"splinter","q":"noun"},"peculiar":{"h":"peculiar","i":"/pəˈkjuːl.jʊər/","a":"en-us-peculiar.ogg","s":[{"p":"adjective","d":[{"m":"When something is peculiar, it is out of the ordinary or is unusual.","e":"The girl there standing in the crowd of boys there looks rather peculiar."}]}]},"autonomy":{"h":"autonomy","i":"/ɔːˈtɒn.əm.i/","a":"en-us-autonomy.ogg","s":[{"p":"noun","d":[{"m":"Autonomy can be independence or freedom, as of the will or one's actions: the autonomy of the individual."},{"m":"Autonomy can be the condition of being autonomous; self-government, or the right of self-government; independence.","e":"The rebels demanded autonomy from Spain."},{"m":"An autonomy is a self-governing community."}]}]},"autonomies":{"h":"autonomies","l":"autonomy","q":"noun"},"restriction":{"h":"restriction","i":"/rɪˈstrɪkʃən/","a":"LL-Q1860 (eng)-Vealhurl-restriction.wav","s":[{"p":"noun","d":[{"m":"(countable) A restriction is something that restricts or limits something else.","e":"The restrictions on parking in the city during snowstorms make it almost impossible to find parking anywhere."},{"m":"(countable) A restriction is a rule or limit that tells you what you cannot do.","e":"On his first day at work, Kwame's new boss said: \"Let me tell you about our restrictions. No wearing jeans. No taking breaks. No sitting down at work. Oh, and you are not allowed to take any days off for the next six months. Welcome.\""}]}]},"restrictions":{"h":"restrictions","a":"En-us-restrictions.ogg","l":"restriction","q":"noun"},"glory":{"h":"glory","i":"/ˈɡlɔː.ri/","a":"en-us-glory.ogg","s":[{"p":"noun","d":[{"m":"(countable) If you have glory, you have honour, fame and pride."}]}]},"glories":{"h":"glories","l":"glory","q":"noun"},"fury":{"h":"fury","i":"/ˈfjʊri/","a":"en-us-fury.ogg","s":[{"p":"noun","d":[{"m":"Fury is when a person is more than angry and usually is at the level of putting it to act.","e":"The fury could be seen in the lion's eyes."}]}]},"furies":{"h":"furies","l":"fury","q":"noun"},"variegated":{"h":"variegated","i":"/veəriːəˈɡeɪtɛd/","a":"en-us-variegated.ogg","s":[{"p":"adjective","d":[{"m":"Variegated means to be marked with different colours.","e":"The leaves of this plant are variegated."}]}]},"turbid":{"h":"turbid","i":"/ˈtɜː(r)bɪd/","a":"LL-Q1860 (eng)-Vealhurl-turbid.wav","s":[{"p":"adjective","d":[{"m":"A turbid glass of water means that the water contains sediments or.","e":"This glass of water is turbid, could you get another glass with fresh water?"}]}]},"brutal":{"h":"brutal","i":"/ˈbruːtəl/","a":"LL-Q1860 (eng)-Vealhurl-brutal.wav","s":[{"p":"adjective","d":[{"m":"If something or someone is brutal, it is violent or cruel.","e":"She killed her victims in a brutal way."}]}]},"enroll":{"h":"enroll","i":"/ɪnˈrəʊl/","a":"en-us-enroll.ogg","s":[{"p":"verb","d":[{"m":"If you enroll in a group, organization, school, or club, you become a member of it.","e":"Have you enrolled in a school yet?"}]}]},"enrolls":{"h":"enrolls","l":"enroll","q":"verb"},"enrolled":{"h":"enrolled","l":"enroll","q":"verb"},"enrolling":{"h":"enrolling","l":"enroll","q":"verb"},"fluid":{"h":"fluid","i":"/flu̩ɪid/","a":"en-us-fluid.ogg","s":[{"p":"noun","d":[{"m":"A fluid is something that can flow smoothly and with ease.","e":"Water, air, and steam are all fluids."}]},{"p":"adjective","d":[{"m":"smoothly and with ease","e":"It was a fluid, graceful dance."}]}]},"slender":{"h":"slender","i":"/ˈslɛndə/","a":"en-us-slender.ogg","s":[{"p":"adjective","d":[{"m":"When something is slender, it means that the object is thin.","e":"That model is rather slender in shape, which explains why she received many invitations for her photograph to be taken."}]}]},"cramp":{"h":"cramp","i":"/kræmp/","a":"LL-Q1860 (eng)-Vealhurl-cramp.wav","s":[{"p":"noun","d":[{"m":"(countable) A cramp is a painful contraction of the muscle that cannot be controlled.","e":"Quick, save him! He is having muscle cramps and is about to drown in the water!"}]},{"p":"verb","d":[{"m":"(intransitive) If a muscle cramps, it contracts in a painful way.","e":"My legs cramped in the middle of my run."},{"m":"(transitive) If you are cramped by something, you are restricted by it in some way; you are not able to move around or express things."}]}]},"cramps":{"h":"cramps","i":"/kræmps/","l":"cramp","q":"noun"},"craft":{"h":"craft","i":"/krɑːft/","a":"en-us-craft.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you craft an object, it means that you make the object by hand.","e":"That craftsman is real good, he can craft out a complicated ship out of a block of wood."}]}]},"crafts":{"h":"crafts","l":"craft","q":"verb"},"crafted":{"h":"crafted","l":"craft","q":"verb"},"crafting":{"h":"crafting","l":"craft","q":"verb"},"foster":{"h":"foster","i":"/ˈfɒstə/","a":"en-us-foster.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you foster something, you do cultivate and grow it.","e":"In this school, they foster students with a talent in music."}]}]},"fosters":{"h":"fosters","l":"foster","q":"verb"},"fostered":{"h":"fostered","l":"foster","q":"verb"},"fostering":{"h":"fostering","l":"foster","q":"verb"},"subsidy":{"h":"subsidy","i":"/ˈsʌbsɨdi/","a":"LL-Q1860 (eng)-Vininn126-subsidy.wav","s":[{"p":"noun","d":[{"m":"(countable) A subsidy is a type of financial support, especially the use of tax revenues to support things which might otherwise fail.","e":"The government provides a subsidy for students that are in families not doing well financially."}]}]},"subsidies":{"h":"subsidies","l":"subsidy","q":"noun"},"incline":{"h":"incline","i":"/ɪnˈklaɪn/","a":"en-us-incline.ogg","s":[{"p":"noun","d":[{"m":"(countable) An incline is a slope uphill.","e":"You would have to climb a steep incline to get to the peak of this hill."}]},{"p":"verb","d":[{"m":"(intransitive) If you are inclined to do something, it means that you tend to do or believe it.","e":"I am more inclined to sleep now instead of going with you for basketball."}]}]},"inclines":{"h":"inclines","l":"incline","q":"noun"},"inclined":{"h":"inclined","a":"En-us-inclined.ogg","l":"incline","q":"verb","s":[{"p":"adjective","d":[{"m":"If you are inclined to do something, you are likely to do it.","e":"I am inclined to eat another cheeseburger."}]}]},"inclining":{"h":"inclining","l":"incline","q":"verb"},"merit":{"h":"merit","i":"/ˈmɛrɪt/","a":"en-us-merit.ogg","s":[{"p":"noun","d":[{"m":"(countable) A merit is something that deserves good or bad recognition.","e":"He received a reward of 50 dollars for his merit."}]}]},"merits":{"h":"merits","a":"En-us-merits.ogg","l":"merit","q":"noun"},"fluids":{"h":"fluids","l":"fluid","q":"noun"},"slenderer":{"h":"slenderer","l":"slender","q":"adjective"},"slenderest":{"h":"slenderest","l":"slender","q":"adjective"},"outcry":{"h":"outcry","i":"/ˈaʊtkraɪ/","a":"en-us-outcry.ogg","s":[{"p":"noun","d":[{"m":"(countable) An outcry is a large uproar or a loud cry.","e":"When the fans saw their favorite idol on stage, they made a large outcry."},{"m":"(countable) An outcry is a strong protest.","e":"The proposal resulted in a public outcry."}]}]},"outcries":{"h":"outcries","l":"outcry","q":"noun"},"holland":{"h":"Holland","i":"/ˈhɒlənd/","a":"LL-Q1860 (eng)-Vealhurl-Holland.wav","s":[{"p":"proper noun","d":[{"m":"Holland is a country that is part of the Netherlands.","e":"Holland is often wrongly said to represent the entire Netherlands."}]}]},"civilise":{"h":"civilise","i":"/ˈsɪvɪlaɪz/","a":"LL-Q1860 (eng)-Vininn126-civilize.wav","s":[{"p":"verb","d":[{"m":"(transitive) When you civilise someone, you educate that person on how to have a higher standard of behaviour.","e":"Our teacher civilised us today, stressing the importance of respecting others."}]}]},"veer":{"h":"veer","s":[{"p":"verb","d":[{"m":"(intransitive) When you veer, it means that you change your direction suddenly.","e":"The bus veered off the mountain track and went down the steep slope."}]}]},"veers":{"h":"veers","l":"veer","q":"verb"},"veered":{"h":"veered","l":"veer","q":"verb"},"veering":{"h":"veering","l":"veer","q":"verb"},"helipad":{"h":"helipad","i":"/ˈhɛlɪpad/","a":"LL-Q1860 (eng)-Vealhurl-helipad.wav","s":[{"p":"noun","d":[{"m":"(countable) A helipad is a platform for helicopters to land and take off from. It is usually marked with a letter \"H\".","e":"There is a helipad on top of this building for use by our country's military."}]}]},"helipads":{"h":"helipads","l":"helipad","q":"noun"},"inn":{"h":"inn","i":"/ɪn/","a":"en-us-inn.ogg","s":[{"p":"noun","d":[{"m":"(countable) An inn is a place where travellers can get lodging, food and drinks.","e":"My friend has already booked a place in the inn for us."}]}]},"inns":{"h":"inns","l":"inn","q":"noun"},"distal":{"h":"distal","i":"/ˈdɪs.təɫ/","a":"LL-Q1860 (eng)-Vealhurl-distal.wav","s":[{"p":"adjective","d":[{"m":"A distal location refers to a point furtherest from an attachment or origin.","e":"At the distal end of a bone or a muscle."}]}]},"lone":{"h":"lone","i":"/ləʊn/","a":"en-us-lone.ogg","s":[{"p":"adjective","d":[{"m":"If you are lone, you are isolated and have no companion.","e":"Dan avoids talking to others and is a bit of a lone wolf."},{"m":"The only one."}]}]},"discriminate":{"h":"discriminate","i":"/dɪsˈkrɪmɪneɪt/","a":"LL-Q1860 (eng)-Vealhurl-discriminate.wav","s":[{"p":"verb","d":[{"m":"(intransitive) When you discriminate against someone, you make decisions based on prejudice.","e":"The law makes it illegal for people to discriminate against others based on their skin colour."},{"m":"(intransitive) If you discriminate, you make a distinction.","e":"John is colorblind and cannot discriminate between red and green."}]}]},"discriminates":{"h":"discriminates","l":"discriminate","q":"verb"},"discriminated":{"h":"discriminated","l":"discriminate","q":"verb"},"discriminating":{"h":"discriminating","l":"discriminate","q":"verb"},"platform":{"h":"platform","i":"/ˈplætfɔːm/","a":"en-us-platform.ogg","s":[{"p":"noun","d":[{"m":"(countable) A platform is a raised stage where speeches, concerts and other performances are made.","e":"The principal of the school stood on the platform to give a speech to parents about the school's upcoming changes."},{"m":"(countable) A platform is a raised structure from which passengers can enter or leave a train, metro etc.","e":"The passengers waited for the train on the platform."}]}]},"platforms":{"h":"platforms","l":"platform","q":"noun"},"astronaut":{"h":"astronaut","i":"/ˈæstrəˌnɔːt/","a":"en-ca-astronaut.ogg","s":[{"p":"noun","d":[{"m":"(countable) An astronaut is a person who travels into space."}]}]},"astronauts":{"h":"astronauts","l":"astronaut","q":"noun"},"clocked":{"h":"clocked","l":"clock","q":"verb"},"clocking":{"h":"clocking","l":"clock","q":"verb"},"honorary":{"h":"honorary","s":[{"p":"adjective","d":[{"m":"Honorary means holding a title or office without payment or undertaking the duties.","e":"This young man works honorary for the animal shelter."}]}]},"bestseller":{"h":"bestseller","s":[{"p":"noun","d":[{"m":"(countable) A bestseller is a book or any other product that has sold in large numbers.","e":"The hula hoop was a bestseller in the late 1950s."}]}]},"entrails":{"h":"entrails","i":"/ˈentreɪlz/","s":[{"p":"noun","d":[{"m":"(uncountable) The entrails are the internal organs of an animal, especially the intestines."}]}]},"bestsellers":{"h":"bestsellers","l":"bestseller","q":"noun"},"fast-paced":{"h":"fast-paced","s":[{"p":"adjective","d":[{"m":"If something is fast-paced, it moves or changes very rapidly or quickly.","e":"We went to see a fast-paced action film. There was never a dull moment."}]}]},"snarky":{"h":"snarky","i":"/ˈsnɑr.ki/","a":"LL-Q1860 (eng)-Vealhurl-snarky.wav","s":[{"p":"adjective","d":[{"m":"(informal) If you are snarky, you say something in a sarcastic or snide way; usually because you are irritated, but also sometimes to be funny.","e":"I was asking you a serious question. There's no reason to be snarky with me."}]}]},"snarkier":{"h":"snarkier","l":"snarky","q":"adjective"},"snarkiest":{"h":"snarkiest","l":"snarky","q":"adjective"},"wagon":{"h":"wagon","i":"/wæɡ.ən/","a":"en-us-wagon.ogg","s":[{"p":"noun","d":[{"m":"(countable) A wagon is a cart with four wheels.","e":"This brown wagon has very small wheels."},{"m":"(countable) A wagon is railway car for goods.","e":"The wagon of the red train is loaded with wood."}]}]},"wagons":{"h":"wagons","a":"en-us-wagons.ogg","l":"wagon","q":"noun"},"bluff":{"h":"bluff","i":"/blʌf/","a":"en-au-bluff.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bluff is an action which suggests you are strong when you are not.","e":"He pretended to reach for a gun, but it was a bluff."}]},{"p":"verb","d":[{"m":"If you bluff, you pretend to be strong in order to deceive.","e":"He bluffed his way out of a tight corner."}]}]},"posture":{"h":"posture","i":"/ˈpɒstʃə/","a":"LL-Q1860 (eng)-Vealhurl-posture.wav","s":[{"p":"noun","d":[{"m":"(countable) A posture is a position of the body.","e":"At the start of a race, the runners crouch down into a starting posture."}]},{"p":"verb","d":[{"m":"To assume a pose or put on an appearance, literally or figuratively."}]}]},"postures":{"h":"postures","l":"posture","q":"noun"},"bluffs":{"h":"bluffs","i":"/blʌfs/","l":"bluff","q":"noun"},"bluffed":{"h":"bluffed","i":"/blʌft/","l":"bluff","q":"verb"},"bluffing":{"h":"bluffing","i":"/ˈblʌfɪŋ/","l":"bluff","q":"verb"},"floodplain":{"h":"floodplain","i":"/flʌdpleɪn/","s":[{"p":"noun","d":[{"m":"(countable) A floodplain is a plain which is formed by the removal of collection of very small bodies from the repeated flooding of a river and experiences occasional or repeated flooding."}]}]},"floodplains":{"h":"floodplains","l":"floodplain","q":"noun"},"sparrow":{"h":"sparrow","i":"/ˈspærəʊ/","a":"en-us-sparrow.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sparrow is a small bird.","e":"The sparrows sing softly."}]}]},"thundercloud":{"h":"thundercloud","s":[{"p":"noun","d":[{"m":"(countable) A thundercloud is a very dark cloud that might have thunder and rain."}]}]},"off-season":{"h":"off-season","s":[{"p":"noun","d":[{"m":"(uncountable) In sports, an off-season is when no games in a particular sport are played.","e":"No games were played during the off-season."}]}]},"offseason":{"h":"offseason","s":[{"p":"noun","d":[{"m":"Another spelling of off-season"}]}]},"fudge":{"h":"fudge","i":"/fʌdʒ/","a":"en-us-fudge.ogg","s":[{"p":"noun","d":[{"m":"Fudge is a kind of chocolate that usually comes in squares.","e":"We baked fudge for dessert."}]}]},"careful":{"h":"careful","i":"/ˈkɛːfəl/","a":"en-us-careful.ogg","s":[{"p":"adjective","d":[{"m":"If you are careful, then you do not take risks and are cautious; you have care.","e":"Edward had to be very careful when walking with the hot soup bowl in his hands because he could spill it and burn himself."}]}]},"careless":{"h":"careless","i":"/ˈkɛəlɪs/","a":"en-us-careless.ogg","s":[{"p":"adjective","d":[{"m":"If you are careless, then you don't have caution or care.","e":"Charles was careless and dropped the pencil, which caused it to break in half."}]}]},"syntactically":{"h":"syntactically","s":[{"p":"adverb","d":[{"m":"When doing something syntactically, it is following the rules of syntax.","e":"The text is syntactically correct, but it does not make any sense."}]}]},"sparrows":{"h":"sparrows","l":"sparrow","q":"noun"},"acarophobia":{"h":"acarophobia","i":"/ˌækərəˈfəʊbi.ə/","s":[{"p":"noun","d":[{"m":"(uncountable) Acarophobia is the fear of feeling felt on an area of the skin that makes a person or animal to want to rub the area with a sharp object."},{"m":"(uncountable) Acarophobia is also the fear of insects. It causes the feeling felt on an area of the skin that makes a person or animal to want to rub the area with a sharp object.","e":"Ben suffers from a normal form of acarophobia."}]}]},"thunderclouds":{"h":"thunderclouds","l":"thundercloud","q":"noun"},"pollute":{"h":"pollute","a":"en-us-pollute.ogg","s":[{"p":"verb","d":[{"m":"(transitive) To pollute means add dirt and other harmful things to water, land or air.","e":"The industry pollutes the air in this region."}]}]},"pollutes":{"h":"pollutes","l":"pollute","q":"verb"},"polluted":{"h":"polluted","a":"en-us-polluted.ogg","l":"pollute","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is polluted, it is made unclean or impure."}]}]},"polluting":{"h":"polluting","l":"pollute","q":"verb"},"dutches":{"h":"dutches","l":"dutch","q":"noun"},"precipitation":{"h":"precipitation","i":"/prɪˌsɪpɪˈteɪʃən/","a":"en-us-precipitation.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Precipitation is water that falls from the clouds in the sky as snow, water, or ice."}]}]},"duke":{"h":"duke","i":"/djuːk/","a":"en-us-duke.ogg","s":[{"p":"noun","d":[{"m":"(countable) A duke is the husband of a duchess and the male ruler of a duchy.","e":"The duke of Lorraine is very old."},{"m":"(countable) A duke is a high British nobleman."}]}]},"dukes":{"h":"dukes","l":"duke","q":"noun"},"loop":{"h":"loop","i":"/luːp/","a":"LL-Q1860 (eng)-Vealhurl-loop.wav","s":[{"p":"noun","d":[{"m":"(countable) A loop in a rope or thread is formed when the line is laid on top of itself so that an opening is formed.","e":"To tie the knot, first create a loop."},{"m":"(countable) A loop is a part of a computer program that repeats.","e":"My program became stuck in an infinite loop."}]},{"p":"verb","d":[{"m":"(transitive) To loop something is to make it into the shape of a loop.","e":"Loop the rope over your hands."},{"m":"(transitive) To move in a loop is to move in the path of a loop.","e":"The plane looped above us."}]}]},"loops":{"h":"loops","i":"/luːps/","l":"loop","q":"noun"},"looped":{"h":"looped","i":"/luːpt/","a":"en-au-looped.ogg","l":"loop","q":"verb"},"looping":{"h":"looping","l":"loop","q":"verb"},"predator":{"h":"predator","i":"/ˈpre.də.tər/","a":"LL-Q1860 (eng)-Vealhurl-predator.wav","s":[{"p":"noun","d":[{"m":"(countable) A predator is an animal that goes after other animals for food, or energy.","e":"The deer watched for predators as they approached the water."}]}]},"pickle":{"h":"pickle","i":"/ˈpɪkl̩/","a":"en-au-pickle.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pickle is a sour green food made from a cucumber."}]},{"p":"verb","d":[{"m":"When a person pickles, he preserves food in a salt, vinegar, or sugar solution."}]}]},"pickles":{"h":"pickles","l":"pickle","q":"noun"},"troublesome":{"h":"troublesome","i":"/ˈtrʌbəlsəm/","a":"en-us-troublesome.ogg","s":[{"p":"adjective","d":[{"m":"Someone or something that causes trouble is troublesome.","e":"He said some troublesome things, and I wasn't sure how to reply."}]}]},"plunger":{"h":"plunger","i":"/ˈplʌndʒɚ/","a":"en-au-plunger.ogg","s":[{"p":"noun","d":[{"m":"(countable) A plunger is an object used to free up a toilet, usually for faecal or waste.","e":"That plunger freed up the toilet so it could run properly."}]}]},"micro":{"h":"micro","i":"/ˈmaɪ.kroʊ/","a":"LL-Q1860 (eng)-Vealhurl-micro.wav","s":[{"p":"adjective","d":[{"m":"When something is micro, it refers to the size of the object being rather small. Used to compare how small an object is.","e":"At the micro level he was a good manager. At the more macro level he failed."}]},{"p":"noun","d":[{"m":"\"Micro\" is a short form of \"microcomputer\" or \"microscope\"."}]}]},"micros":{"h":"micros","l":"micro","q":"noun"},"loft":{"h":"loft","i":"/lɔft/","a":"LL-Q1860 (eng)-Vealhurl-loft.wav","s":[{"p":"noun","d":[{"m":"(countable) A loft is an attic or a space near the roof of a building.","e":"We will store those old chairs in the loft."}]},{"p":"verb","d":[{"m":"To loft an object is to lift it into the air.","e":"He lofted the baseball high into the sky."}]}]},"lofts":{"h":"lofts","l":"loft","q":"noun"},"lofted":{"h":"lofted","l":"loft","q":"verb"},"lofting":{"h":"lofting","l":"loft","q":"verb"},"loudmouth":{"h":"loudmouth","a":"en-us-loudmouth.ogg","s":[{"p":"noun","d":[{"m":"A loudmouth is someone who talks too much or too loudly."}]}]},"loudmouths":{"h":"loudmouths","l":"loudmouth","q":"noun"},"optional":{"h":"optional","i":"/ˈɒp.ʃə.nəl/","a":"LL-Q1860 (eng)-Vealhurl-optional.wav","s":[{"p":"adjective","d":[{"m":"If something is optional, you may choose it or not.","e":"At this event, dress is optional."}]}]},"saline":{"h":"saline","i":"/ˈseɪ.laɪn/","a":"LL-Q1860 (eng)-Vealhurl-saline.wav","s":[{"p":"adjective","d":[{"m":"If something is saline it is salty, especially water containing salt."}]}]},"classroom":{"h":"classroom","i":"/ˈklɑːsrʊm/","a":"en-uk-classroom.ogg","s":[{"p":"noun","d":[{"m":"(countable) A classroom is a room used for instruction and teaching, usually a room in a school."}]}]},"alertness":{"h":"alertness","i":"/əˈlɝt.nəs/","s":[{"p":"noun","d":[{"m":"Alertness is the state of being wide awake and noticing anything that happens.","e":"Cats' alertness can remain high, even when they look asleep."}]}]},"apathy":{"h":"apathy","i":"/æ.pə.θi/","a":"en-us-apathy.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Apathy is a lack of interest in something.","e":"He showed apathy by not completing the tasks that were assigned to him by his boss."}]}]},"precipitations":{"h":"precipitations","l":"precipitation","q":"noun"},"classrooms":{"h":"classrooms","l":"classroom","q":"noun"},"predators":{"h":"predators","l":"predator","q":"noun"},"plungers":{"h":"plungers","l":"plunger","q":"noun"},"frustration":{"h":"frustration","s":[{"p":"noun","d":[{"m":"(uncountable) Frustration is the bad feeling of not being able to do what you want to do.","e":"He stood on a chair, but to his frustration, he still could not reach the jar."},{"m":"(countable) A thing that frustrates."}]}]},"apathies":{"h":"apathies","l":"apathy","q":"noun"},"frustrations":{"h":"frustrations","l":"frustration","q":"noun"},"gratitude":{"h":"gratitude","i":"/ˈɡrætɪtud/","a":"en-us-gratitude.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Gratitude is the good feeling you have when someone else has done something for you.","e":"She showed her gratitude for his help with a big smile."}]}]},"hostility":{"h":"hostility","i":"/hɒˈstɪlɪti/","a":"en-us-hostility.ogg","s":[{"p":"noun","d":[{"m":"Hostility is a negative action or feeling against something or somebody.","e":"He wanted to reach an agreement, but her hostility was difficult to deal with."}]}]},"loneliness":{"h":"loneliness","i":"/ˈloʊnlinəs/","a":"en-us-loneliness.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Loneliness is the sad feeling of being alone and not having friends.","e":"Without his family and friends, his loneliness grew."}]}]},"promiscuity":{"h":"promiscuity","s":[{"p":"noun","d":[{"m":"(uncountable) Promiscuity is the state of having many different sexual partners.","e":"Promiscuity is thought to be a bad thing because it disturbs other people and may cause the spread of disease."}]}]},"remorse":{"h":"remorse","i":"/rɪˈmɔː(r)s/","a":"LL-Q1860 (eng)-Vealhurl-remorse.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Remorse is the feeling of having made a bad mistake. A person gets this bad feeling when they do or say something, and wish they had not.","e":"I lost a friend because of what I did, and now I feel such remorse about it."}]}]},"hostilities":{"h":"hostilities","s":[{"p":"noun","d":[{"m":"Hostilities is the fighting between two groups or countries during a war.","e":"Hostilities began after the results of the election were announced."}]}]},"lonelinesses":{"h":"lonelinesses","l":"loneliness","q":"noun"},"promiscuities":{"h":"promiscuities","l":"promiscuity","q":"noun"},"cave":{"h":"cave","i":"/keɪv/","a":"en-us-cave.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cave is a large, naturally-formed hole formed underground, or in the face of a cliff or a hillside.","e":"A storm is coming towards us, lets take shelter in that cave."},{"m":"(countable) A hole, depression, or gap in earth or rock, which could be natural or man-made."},{"m":"(countable) A storage cellar, especially for wine or cheese."},{"m":"A collapse or cave-in."}]},{"p":"verb","d":[{"m":"To surrender.","e":"Joe asked his mom for a new bike every day for a month and she finally caved and got him one."},{"m":"To collapse.","e":"First the braces buckled, then the roof began to cave, then we ran."}]}]},"caves":{"h":"caves","l":"cave","q":"noun"},"orissa":{"h":"Orissa","s":[{"p":"proper noun","d":[{"m":"Orissa is a state in India."}]}]},"chhattisgarh":{"h":"Chhattisgarh","s":[{"p":"proper noun","d":[{"m":"Chhattisgarh is a state in central India. Its capital is Raipur."}]}]},"goa":{"h":"Goa","s":[{"p":"proper noun","d":[{"m":"Goa is a state in India. Its capital is Panaji."}]}]},"kerala":{"h":"Kerala","s":[{"p":"proper noun","d":[{"m":"Kerala is a state in southern India. Its capital is Thiruvananthapuram."}]}]},"lakshadweep":{"h":"Lakshadweep","i":"/ləkˈʃɑːdwiːp/","s":[{"p":"proper noun","d":[{"m":"Lakshadweep is a Union territory in India. Its capital is Kavaratti."}]}]},"maharashtra":{"h":"Maharashtra","s":[{"p":"proper noun","d":[{"m":"Maharashtra is a state in India. The capital city is Bombay."}]}]},"manipur":{"h":"Manipur","i":"/ˌmənɪpʊr/","s":[{"p":"proper noun","d":[{"m":"Manipur is a state in India."}]}]},"meghalaya":{"h":"Meghalaya","s":[{"p":"proper noun","d":[{"m":"Meghalaya is a state in India."}]}]},"mizoram":{"h":"Mizoram","s":[{"p":"proper noun","d":[{"m":"Mizoram is a state in India."}]}]},"nagaland":{"h":"Nagaland","s":[{"p":"proper noun","d":[{"m":"Nagaland is a state in India."}]}]},"puducherry":{"h":"Puducherry","s":[{"p":"proper noun","d":[{"m":"Puducherry is a union territory in India."}]}]},"rajasthan":{"h":"Rajasthan","i":"/ˈrɑːd͡ʒəstæn/","a":"LL-Q1860 (eng)-Persent101-Rajasthan.wav","s":[{"p":"proper noun","d":[{"m":"Rajasthan is a state in India. The capital is Jaipur."}]}]},"udhampur":{"h":"Udhampur","s":[{"p":"proper noun","d":[{"m":"Udhampur is a district in the disputed territory of Jammu and Kashmir."}]}]},"forever":{"h":"forever","i":"/fərˈɛvɚ/","a":"en-us-forever.ogg","s":[{"p":"preposition","d":[{"m":"Forever means for a limitless time or very long time.","e":"I think the sun will last forever."}]}]},"accord":{"h":"accord","i":"/əˈkɔːd/","a":"en-us-accord.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) If two or more things are in accord, they match or agree.","e":"We are in accord that the bridge should be built."},{"m":"(countable) An accord is a formal agreement between two or more countries or groups.","e":"The Czech government signed an accord with the United States allowing Washington to use some Czech land for its armed forces."}]},{"p":"verb","d":[{"m":"(transitive) When two things accord with each other, they agree.","e":"Amy can trust him because his words accord with his actions."}]}]},"bagger":{"h":"bagger","s":[{"p":"noun","d":[{"m":"A bagger is someone who usually puts groceries in bags"}]}]},"analogy":{"h":"analogy","i":"/əˈnæləd͡ʒi/","a":"en-us-analogy.ogg","s":[{"p":"noun","d":[{"m":"(countable) An analogy is a likeness or a comparison between two things that have some features that are the same and others which are different.","e":"Several quite obvious analogies between the two authors can be made."}]}]},"discontinuity":{"h":"discontinuity","i":"/ˌdɪskɒntɪˈnjuːɪti/","s":[{"p":"noun","d":[{"m":"(countable) A discontinuity is a gap, break, separation or change in a series of things or events.","e":"A discontinuity occurred when the series of models was redesigned."}]}]},"baggers":{"h":"baggers","l":"bagger","q":"noun"},"analogies":{"h":"analogies","l":"analogy","q":"noun"},"discontinuities":{"h":"discontinuities","l":"discontinuity","q":"noun"},"discontinuous":{"h":"discontinuous","s":[{"p":"adjective","d":[{"m":"If something is discontinuous, it has breaks or interruptions; it has discontinuity.","e":"Our meeting was discontinuous; we had several breaks for eating and using the restroom."}]}]},"yangon":{"h":"Yangon","s":[{"p":"proper noun","d":[{"m":"Yangon is the largest city and previously the capital of Myanmar (Burma). It used to be called Rangoon."}]}]},"myanmar":{"h":"Myanmar","i":"/mjəmà/","a":"en-us-Myanmar.ogg","s":[{"p":"proper noun","d":[{"m":"Myanmar is a country in Southeast Asia. It is officially known as the Union of Myanmar and it was previously called Burma."}]}]},"naypyidaw":{"h":"Naypyidaw","s":[{"p":"proper noun","d":[{"m":"Naypyidaw is the capital of Myanmar (previously known as Burma)."}]}]},"underway":{"h":"underway","i":"/ʌndə(r)ˈweɪ/","a":"LL-Q1860 (eng)-Vealhurl-underway.wav","s":[{"p":"adverb","d":[{"m":"If something is underway, it has started and is happening now.","e":"The boy has been missing since this morning, and a search is currently underway."},{"m":"If a ship, train, bus, etc. is underway, it has started moving to where it is supposed to go.","e":"Even underway, there was almost no sound inside the ship."}]}]},"weave":{"h":"weave","i":"/wiːv/","a":"en-us-weave.ogg","s":[{"p":"verb","d":[{"m":"If you weave, you make cloth by crossing many threads.","e":"This loom weaves yarn into sweaters."},{"m":"To spin a cocoon or a web.","e":"Spiders weave beautiful but deadly webs."}]},{"p":"noun","d":[{"m":"Human or artificial hair that is worn to change your appearance, either in addition to or by covering the natural hair altogether."},{"m":"­A type or way of weaving.","e":"That rug has a very tight weave."}]}]},"shark":{"h":"shark","i":"/ʃɑrk/","a":"en-us-shark.ogg","s":[{"p":"noun","d":[{"m":"(countable) A shark is a type of fish. Some are dangerous to humans, for example the great white shark, while others are not.","e":"The great white shark is one of the largest sharks in the ocean."}]}]},"sunny":{"h":"sunny","i":"/ˈsʌni/","a":"en-us-sunny.ogg","s":[{"p":"adjective","d":[{"m":"If a day is sunny, you can see the sun clearly in the sky and there is a lot of sunshine.","e":"I'll go for a walk later if it is sunny; if not, I'll stay in my flat."},{"m":"If a place is sunny, it gets a lot of sunshine.","e":"I would describe Spain as sunny, but it's nothing in comparison to the Sahara."},{"m":"If a person is sunny, they are cheerful.","e":"Susie has a really sunny disposition."}]}]},"blot":{"h":"blot","i":"/blɒt/","a":"en-us-blot.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stain, spot or mark left by a colored object.","e":"There was a blot of wine on my shirt."}]},{"p":"verb","d":[{"m":"(intransitive) To soak up or absorb liquid.","e":"I tried to blot the spill as quickly as possibly, but it still left a stain."},{"m":"(transitive) To cause a blot (on something) by spilling a colored substance."}]}]},"knight":{"h":"knight","i":"/naɪt/","a":"en-us-knight.ogg","s":[{"p":"noun","d":[{"m":"(countable) A knight was a man who fought in battles on a horse during the.","e":"The knights rode up to the castle and broke in."},{"m":"(countable) A knight is a person who has been given knighthood by a king or queen."},{"m":"(countable), (chess) A chess piece, often in the shape of a horse's head, that is moved two squares in one direction and one at right angles to that direction in a single move, leaping over any pieces in between."}]}]},"requirement":{"h":"requirement","i":"/rɪˈkwʌɪəm(ə)nt/","a":"LL-Q1860 (eng)-Vealhurl-requirement.wav","s":[{"p":"noun","d":[{"m":"(countable) A requirement is something that you need, something that is necessary.","e":"There is a minimum age requirement of 18 years."}]}]},"requirements":{"h":"requirements","a":"En-us-requirements.ogg","l":"requirement","q":"noun"},"knights":{"h":"knights","i":"/naɪts/","a":"en-us-knights.ogg","l":"knight","q":"noun"},"blots":{"h":"blots","l":"blot","q":"noun"},"blotted":{"h":"blotted","l":"blot","q":"verb"},"blotting":{"h":"blotting","l":"blot","q":"verb"},"sunnier":{"h":"sunnier","l":"sunny","q":"adjective"},"sunniest":{"h":"sunniest","l":"sunny","q":"adjective"},"sharks":{"h":"sharks","l":"shark","q":"noun"},"pinky":{"h":"pinky","i":"/ˈpɪŋki/","a":"en-au-pinky.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pinky, also known as the little finger, is the smallest finger on the hand or foot."}]}]},"weaves":{"h":"weaves","l":"weave","q":"verb"},"wove":{"h":"wove","i":"/wəʊv/","a":"LL-Q1860 (eng)-Pvanp7-wove.wav","l":"weave","q":"verb"},"woven":{"h":"woven","i":"/ˈwəʊ.vən/","a":"LL-Q1860 (eng)-Pvanp7-woven.wav","l":"weave","q":"verb"},"weaving":{"h":"weaving","l":"weave","q":"verb"},"acorn":{"h":"acorn","i":"/ˈeɪ.kɔrn/","a":"en-us-acorn.ogg","s":[{"p":"noun","d":[{"m":"(countable) An acorn is a fruit of the oak."}]}]},"acquaint":{"h":"acquaint","i":"/əˈkweɪnt/","a":"LL-Q1860 (eng)-Vealhurl-acquaint.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you acquaint someone with something, you make them familiar with it.","e":"Are you acquainted with Mr. Green?"}]}]},"acquaints":{"h":"acquaints","l":"acquaint","q":"verb"},"acquainted":{"h":"acquainted","i":"/əˈkweɪntɪd/","a":"en-us-acquainted.ogg","l":"acquaint","q":"verb"},"acquainting":{"h":"acquainting","l":"acquaint","q":"verb"},"pinkies":{"h":"pinkies","l":"pinky","q":"noun"},"acorns":{"h":"acorns","l":"acorn","q":"noun"},"caved":{"h":"caved","l":"cave","q":"verb"},"caving":{"h":"caving","l":"cave","q":"verb"},"coarse":{"h":"coarse","i":"/kɔː(r)s/","a":"en-us-coarse.ogg","s":[{"p":"adjective","d":[{"m":"When an object is coarse, it is rough and not smooth.","e":"I prefer to season with fine salt instead of coarse salt because it mixes more easily."},{"m":"If a person is coarse, they are not refined or do not have tact.","e":"Why do you use such coarse language? It makes it seem as you have no manners at all."}]}]},"cobweb":{"h":"cobweb","i":"/ˈkɒbwɛb/","a":"en-us-cobweb.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cobweb is the remains of an old spiderweb."}]}]},"coarser":{"h":"coarser","l":"coarse","q":"adjective"},"coarsest":{"h":"coarsest","l":"coarse","q":"adjective"},"cobwebs":{"h":"cobwebs","l":"cobweb","q":"noun"},"gutted":{"h":"gutted","l":"gut","q":"verb"},"gutting":{"h":"gutting","l":"gut","q":"verb"},"pathogens":{"h":"pathogens","l":"pathogen","q":"noun"},"pathogen":{"h":"pathogen","i":"/ˈpæθədʒn̩/","a":"LL-Q1860 (eng)-Vealhurl-pathogen.wav","s":[{"p":"noun","d":[{"m":"A pathogen is something that is able to cause disease, such as bacteria or viruses."}]}]},"ruler":{"h":"ruler","i":"/ˈruːlə(r)/","a":"en-us-ruler.ogg","s":[{"p":"noun","d":[{"m":"(countable) A ruler is a device used for measuring things.","e":"The ruler says that the shelf is 12 centimeters wide."},{"m":"(countable) If a person is a ruler, they are in charge.","e":"The king was a ruler of many people."}]}]},"rulers":{"h":"rulers","a":"En-us-rulers.ogg","l":"ruler","q":"noun"},"slipper":{"h":"slipper","i":"/sːlip per/","a":"en-ca-slipper.oga","s":[{"p":"noun","d":[{"m":"(countable) A slipper is a type of shoe that can be slipped on and off easily.","e":"Jane loved to come home and put on her warm slippers."}]}]},"slippers":{"h":"slippers","i":"/ˈslɪpə(r)z/","a":"en-us-slippers.ogg","l":"slipper","q":"noun"},"eclipse":{"h":"eclipse","i":"/ɛˈklɪps/","a":"en-us-eclipse.ogg","s":[{"p":"noun","d":[{"m":"(countable) An eclipse is when the light of the Sun or Moon is blocked."}]},{"p":"verb","d":[{"m":"(transitive) If something eclipses something else, it passes or overshadows it."}]}]},"eclipses":{"h":"eclipses","l":"eclipse","q":"noun"},"posthumously":{"h":"posthumously","s":[{"p":"adverb","d":[{"m":"When something is done posthumously, it is done after death.","e":"The prize was awarded posthumously."}]}]},"flutter":{"h":"flutter","i":"/ˈflʌtə/","a":"en-us-flutter.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) If something flutters, it moves unsteadily quickly right and left or up and down, often because of wind.","e":"She was very sleepy, but from time to time, her eyes fluttered open."}]},{"p":"noun","d":[{"m":"(countable) A flutter is a quick movement up and down or left and right."},{"m":"(countable) A flutter is the sound of this movement."}]}]},"moustache":{"h":"moustache","i":"/ˈmʊstɑːʃ/","a":"en-us-moustache.ogg","s":[{"p":"noun","d":[{"m":"(countable) A moustache is hair grown on the face between the nose and lip."}]}]},"mustache":{"h":"mustache","i":"/ˈmʊstɑːʃ/","a":"en-us-mustache.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mustache is hair grown on the face between the nose and lip."}]}]},"hard-hearted":{"h":"hard-hearted","s":[{"p":"adjective","d":[{"m":"If you are hard-hearted, you are uncaring about other people's feelings.","e":"There's no point asking him for help. He's the most hard-hearted man I've ever met."}]}]},"handcuff":{"h":"handcuff","i":"/ˈhændˌkʌf/","a":"en-us-handcuff.ogg","s":[{"p":"verb","d":[{"m":"When you handcuff someone, you apply handcuffs on that person."}]},{"p":"noun","d":[{"m":"(countable) A handcuff is one of the two lockable linked metal rings for holding a prisoner’s wrists."}]}]},"halve":{"h":"halve","i":"/hɑːv/","s":[{"p":"verb","d":[{"m":"If you halve something, you divide it into two equal parts; you divide it in half","e":"Chop the onion, mince the garlic, and halve the cherry tomatoes."}]}]},"innate":{"h":"innate","i":"/ɪˈneɪt/","a":"en-us-innate.ogg","s":[{"p":"adjective","d":[{"m":"If something is innate, it is present at birth. Often used of abilities and behaviours rather than structures.","e":"A cat's ability to draw in its claws is innate."}]}]},"jolt":{"h":"jolt","i":"/dʒɒlt/","a":"en-us-jolt.ogg","s":[{"p":"verb","d":[{"m":"When you jolt something, you push or shake it suddenly.","e":"The bus was moving along a bumpy road, thus jolting its passengers along the way."}]},{"p":"noun","d":[{"m":"(countable) A jolt is a sudden violent movement."}]}]},"jot":{"h":"jot","i":"/dʒɑt/","s":[{"p":"verb","d":[{"m":"(transitive) When you jot something down, you write it quickly.","e":"I hurriedly jotted down what the professor was saying."}]}]},"flutters":{"h":"flutters","l":"flutter","q":"verb"},"fluttered":{"h":"fluttered","a":"en-us-fluttered.ogg","l":"flutter","q":"verb"},"fluttering":{"h":"fluttering","l":"flutter","q":"verb","s":[{"p":"adjective","d":[{"m":"quickly moving up and down or side to side","e":"My fluttering heart caused me to gasp aloud."}]}]},"moustaches":{"h":"moustaches","l":"moustache","q":"noun"},"mustaches":{"h":"mustaches","l":"mustache","q":"noun"},"handcuffs":{"h":"handcuffs","l":"handcuff","q":"noun","s":[{"p":"noun","d":[{"m":"Handcuffs are the two lockable linked metal rings for holding a prisoner’s wrists.","e":"After John was arrested, he was put in handcuffs, searched, placed in the squad car and transported to jail."}]}]},"handcuffed":{"h":"handcuffed","l":"handcuff","q":"verb"},"handcuffing":{"h":"handcuffing","l":"handcuff","q":"verb"},"halved":{"h":"halved","l":"halve","q":"verb"},"halving":{"h":"halving","l":"halve","q":"verb"},"jolts":{"h":"jolts","l":"jolt","q":"verb"},"jolted":{"h":"jolted","l":"jolt","q":"verb"},"jolting":{"h":"jolting","l":"jolt","q":"verb"},"jots":{"h":"jots","l":"jot","q":"verb"},"jotted":{"h":"jotted","l":"jot","q":"verb"},"jotting":{"h":"jotting","l":"jot","q":"verb"},"harboured":{"h":"harboured","l":"harbour","q":"verb"},"idles":{"h":"idles","l":"idle","q":"verb"},"idled":{"h":"idled","l":"idle","q":"verb"},"idling":{"h":"idling","l":"idle","q":"verb"},"warehouse":{"h":"warehouse","s":[{"p":"noun","d":[{"m":"A warehouse is a place where manufacturers and suppliers store their goods before they are sold to a customer."}]}]},"warehouses":{"h":"warehouses","l":"warehouse","q":"noun"},"rack":{"h":"rack","i":"/ræk/","a":"en-us-rack.ogg","s":[{"p":"noun","d":[{"m":"A rack is a series of shelves stacked on top of each other.","e":"I have a rack at home that holds the books that I have."},{"m":"A rack is a frame you can hang things on."},{"m":"A rack is a set of antlers."},{"m":"A rack is a cut of meat that has several connecting ribs.","e":"I bought a rack of lamb at the butcher's yesterday."},{"m":"A woman's breasts.","e":"Check out the rack on that woman."}]},{"p":"verb","d":[{"m":"If you rack somethin, you put it on a [[#Noun|rack]]."},{"m":"If you rack a person, you cause them to suffer pain."}]}]},"racks":{"h":"racks","i":"/ræks/","l":"rack","q":"noun"},"parse":{"h":"parse","i":"/pɑːz/","a":"en-us-parse.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you parse a word, a statement, a sentence, etc., you use its parts to think about a meaning that is not clear."},{"m":"(transitive) If you parse a sentence, you name the parts of speech of each word and their relations to each other; you analyze and describe it in grammatical terms."},{"m":"(transitive) If a computer parses a file or some other input, it breaks it into smaller groups for easier computing."}]}]},"parses":{"h":"parses","l":"parse","q":"verb"},"parsed":{"h":"parsed","l":"parse","q":"verb"},"parsing":{"h":"parsing","l":"parse","q":"verb"},"laundry":{"h":"laundry","i":"/ˈlɔːn.dri/","a":"en-us-laundry.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Laundry is clothes that need to be washed or that have been newly washed.","e":"Please don't leave your dirty laundry all over the house."}]}]},"launderette":{"h":"launderette","s":[{"p":"noun","d":[{"m":"A launderette is a shop with coin-operated washing machines and dryers for public use."}]}]},"launch":{"h":"launch","i":"/lɔːntʃ/","a":"en-us-launch.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you launch something, you throw it.","e":"During the fight, he launched a dart at my head. Luckily, he missed."},{"m":"(transitive) If you launch a boat, you put it in water.","e":"Bob is having a party to launch his new speed boat this weekend."},{"m":"(transitive) If you launch something, you start it or get it going.","e":"The movie star is going to launch her new clothing line next month."}]}]},"latitude":{"h":"latitude","i":"/ˈlæt.ɪ.tjuːd/","a":"en-us-latitude.ogg","s":[{"p":"noun","d":[{"m":"Latitude refers to the angular from the equator to the north or south pole of the earth"}]}]},"latch":{"h":"latch","i":"/lætʃ/","a":"en-us-latch.ogg","s":[{"p":"noun","d":[{"m":"A latch is a metal lever for fastening a door"},{"m":"A latch is a kind of electronics circuit which holds signal shortly."}]}]},"lash":{"h":"lash","i":"/læʃ/","a":"en-us-lash.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lash is a sharp blow by a whip or rope."},{"m":"(countable) A lash refers to an eyelash or hair that grows from the edge of the eyelid"}]},{"p":"verb","d":[{"m":"(transitive) When you lash something, you strike or beat it with a whip, move quickly and violently."}]}]},"blockade":{"h":"blockade","i":"/blɑˈkeɪd/","a":"LL-Q1860 (eng)-Vealhurl-blockade.wav","s":[{"p":"noun","d":[{"m":"(countable) A blockade is the blocking of a port or city, so that nothing can come in or out of it."},{"m":"(countable) A blockade refers to ships or armies used to block a port or city."}]},{"p":"verb","d":[{"m":"When you set up a blockade, you block a port or city, to form a blockade."}]}]},"neigh":{"h":"neigh","s":[{"p":"noun","d":[{"m":"A horse's neigh refers to the loud cry it makes."}]},{"p":"verb","d":[{"m":"When a horse neighs, it makes a high, long and loud sound."}]}]},"netball":{"h":"netball","s":[{"p":"noun","d":[{"m":"Netball refers to a game similar to basketball, usually played by seven girls"}]}]},"nettle":{"h":"nettle","i":"/ˈnɛt(ə)l/","a":"en-us-nettle.ogg","s":[{"p":"noun","d":[{"m":"A nettle is a wild plant whose leaves are covered with stings and a little poisonous hair that could hurt you."}]}]},"laundries":{"h":"laundries","l":"laundry","q":"noun"},"launderettes":{"h":"launderettes","l":"launderette","q":"noun"},"latitudes":{"h":"latitudes","l":"latitude","q":"noun"},"latches":{"h":"latches","l":"latch","q":"noun"},"lashes":{"h":"lashes","a":"En-us-lashes.ogg","l":"lash","q":"noun"},"lashed":{"h":"lashed","l":"lash","q":"verb"},"lashing":{"h":"lashing","l":"lash","q":"verb"},"blockades":{"h":"blockades","l":"blockade","q":"noun"},"blockaded":{"h":"blockaded","l":"blockade","q":"verb"},"blockading":{"h":"blockading","l":"blockade","q":"verb"},"neighs":{"h":"neighs","l":"neigh","q":"noun"},"neighed":{"h":"neighed","l":"neigh","q":"verb"},"neighing":{"h":"neighing","l":"neigh","q":"verb"},"netballs":{"h":"netballs","l":"netball","q":"noun"},"nettles":{"h":"nettles","l":"nettle","q":"noun"},"vase":{"h":"vase","i":"/vɑːz/","a":"en-us-vase.ogg","s":[{"p":"noun","d":[{"m":"(countable) A vase is something used for putting flowers in it.","e":"I gave that vase to my mother to put her flowers."}]}]},"launches":{"h":"launches","l":"launch","q":"verb"},"launched":{"h":"launched","l":"launch","q":"verb"},"launching":{"h":"launching","l":"launch","q":"verb"},"combat":{"h":"combat","i":"/ˈkɒmˌbæt/","a":"en-us-combat.ogg","s":[{"p":"noun","d":[{"m":"(countable) A combat is a fight or a battle."}]},{"p":"verb","d":[{"m":"(transitive) If you combat against someone or something, you fight or take action against it."}]}]},"pave":{"h":"pave","i":"/peɪv/","a":"en-us-pave.ogg","s":[{"p":"verb","d":[{"m":"When you pave a road, you cover it with flat stones, bricks or cement."}]}]},"paw":{"h":"paw","i":"/pɔː/","a":"en-us-paw.ogg","s":[{"p":"noun","d":[{"m":"(countable) A paw is the foot of a dog, cat or animal."}]},{"p":"verb","d":[{"m":"If an animal paws, it goes through it with its paws."},{"m":"(by extension) If you paw someone, you touch them in a sexual way."}]}]},"pea":{"h":"pea","i":"/piː/","a":"en-us-pea.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pea is a small green seed that you can eat as a vegetable."}]}]},"peacock":{"h":"peacock","i":"/ˈpikɑk/","a":"en-us-peacock.ogg","s":[{"p":"noun","d":[{"m":"(countable) A peacock is a male big bird that has a very long colorful tail feathers with eye-like markings on it.","e":"The peacock is the national bird of India."}]}]},"peal":{"h":"peal","s":[{"p":"noun","d":[{"m":"A peal is a sudden loud sound from a bell, thunder, cannon, etc."}]}]},"peasant":{"h":"peasant","a":"en-us-peasant.ogg","s":[{"p":"noun","d":[{"m":"A peasant is a poor agricultural worker in the countryside."}]}]},"pebble":{"h":"pebble","i":"/ˈpɛb.əl/","a":"LL-Q1860 (eng)-Vealhurl-pebble.wav","s":[{"p":"noun","d":[{"m":"(countable) A pebble is a small round stone."}]}]},"peck":{"h":"peck","i":"/pɛk/","a":"LL-Q1860 (eng)-Vealhurl-peck.wav","s":[{"p":"verb","d":[{"m":"When a bird pecks on something, it strikes or bites it with its beak."}]}]},"peep":{"h":"peep","i":"/piːp/","a":"en-us-peep.ogg","s":[{"p":"noun","d":[{"m":"(countable) A peep is a quick and secret look."}]},{"p":"verb","d":[{"m":"When you peep at something, you look quickly at it through a narrow opening eyes."}]}]},"peer":{"h":"peer","i":"/pɪə/","a":"en-us-peer.ogg","s":[{"p":"noun","d":[{"m":"(countable) A peer is someone of the same level as you.","e":"I have peers in school that often help me when I need their help."}]},{"p":"verb","d":[{"m":"When you peer at something, you look at it with difficulty and concentration. Usually a small thing or a small text."}]}]},"peg":{"h":"peg","i":"/pɛɡ/","a":"en-us-peg.ogg","s":[{"p":"noun","d":[{"m":"A peg is a short pin or bolt that is used for hanging things."}]},{"p":"verb","d":[{"m":"If you peg something, you fasten it using a peg."}]}]},"vases":{"h":"vases","l":"vase","q":"noun"},"paves":{"h":"paves","l":"pave","q":"verb"},"paved":{"h":"paved","a":"En-us-paved.ogg","l":"pave","q":"verb"},"paving":{"h":"paving","l":"pave","q":"verb"},"paws":{"h":"paws","i":"/pɔːz/","a":"en-us-paws.ogg","l":"paw","q":"noun"},"peas":{"h":"peas","l":"pea","q":"noun"},"peacocks":{"h":"peacocks","l":"peacock","q":"noun"},"peals":{"h":"peals","l":"peal","q":"noun"},"peasants":{"h":"peasants","a":"En-us-peasants.ogg","l":"peasant","q":"noun"},"pebbles":{"h":"pebbles","l":"pebble","q":"noun"},"pecks":{"h":"pecks","l":"peck","q":"verb"},"pecked":{"h":"pecked","l":"peck","q":"verb"},"pecking":{"h":"pecking","l":"peck","q":"verb"},"peeps":{"h":"peeps","l":"peep","q":"noun"},"peeped":{"h":"peeped","l":"peep","q":"verb"},"peeping":{"h":"peeping","i":"/ˈpiːpɪŋ/","l":"peep","q":"verb"},"peers":{"h":"peers","l":"peer","q":"noun"},"peered":{"h":"peered","l":"peer","q":"verb"},"peering":{"h":"peering","l":"peer","q":"verb"},"pegs":{"h":"pegs","l":"peg","q":"noun"},"combats":{"h":"combats","l":"combat","q":"noun"},"readily":{"h":"readily","i":"/ˈrɛdɪli/","a":"en-us-readily.ogg","s":[{"p":"adverb","d":[{"m":"When you do something readily, you do it without any doubt about it.","e":"When I needed help carrying my bag of groceries, a young man came over readily to help."}]}]},"reassure":{"h":"reassure","i":"/riəˈʃʊə(r)/","a":"LL-Q1860 (eng)-Vealhurl-reassure.wav","s":[{"p":"verb","d":[{"m":"When you reassure someone, you stop the person from having doubts and fears by giving advice and help."}]}]},"rebel":{"h":"rebel","i":"/ˈrɛbəl/","a":"en-us-rebel.ogg","s":[{"p":"noun","d":[{"m":"(countable) A rebel is somebody who fights against power, especially against your own government.","e":"There are six or more armed rebel groups fighting government forces in and around those forests."}]},{"p":"verb","d":[{"m":"(intransitive) If you rebel against something that has power over you, you fight against it.","e":"Teachers need to balance many things so their students don't rebel against them."}]}]},"reckless":{"h":"reckless","i":"/ˈrɛkləs/","a":"LL-Q1860 (eng)-Vealhurl-reckless.wav","s":[{"p":"adjective","d":[{"m":"If you are reckless, you act without caring about problems your action might cause.","e":"Many teens are involved in high-risk behaviors such as smoking and reckless driving."}]}]},"tame":{"h":"tame","i":"/teɪm/","a":"en-us-tame.ogg","s":[{"p":"adjective","d":[{"m":"If something is tame, it is not dangerous.","e":"Tame animals can live with people."}]},{"p":"verb","d":[{"m":"To tame is to train an animal to live with people.","e":"The monkey is tame. He will not hurt you."}]}]},"tangerine":{"h":"tangerine","i":"/ˈtæn.dʒəˌrin/","a":"LL-Q1860 (eng)-Vealhurl-tangerine.wav","s":[{"p":"noun","d":[{"m":"(countable) A tangerine is a small, sweet fruit that looks like an orange."},{"m":"(uncountable) A deep yellowish-orange colour, like that of a tangerine fruit."}]}]},"tangle":{"h":"tangle","i":"/ˈtæŋ.ɡəl/","a":"en-us-tangle.ogg","s":[{"p":"noun","d":[{"m":"A tangle is a twisted mass of something.","e":"There is a bad tangle in my hair."}]},{"p":"verb","d":[{"m":"To tangle is to twist something together into knots.","e":"Those ropes are in a tangled mess."}]}]},"tangled":{"h":"tangled","l":"tangle","q":"verb"},"tar":{"h":"tar","a":"En-us-tar.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Tar is a black, thick material used for making roads."}]}]},"tarmac":{"h":"tarmac","i":"/ˈtɑː(r)mæk/","a":"LL-Q1860 (eng)-Vealhurl-tarmac.wav","s":[{"p":"noun","d":[{"m":"(singular) A tarmac is a mixture of tar and very small stones, it is used for making roads."}]},{"p":"verb","d":[{"m":"(transitive) If you tarmac something, you cover it with tarmac."}]}]},"tart":{"h":"tart","i":"/tɑrt/","a":"en-au-tart.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tart is a food like a small pie, usually with a fruit inside it.","e":"We ate a strawberry tart for breakfast."},{"m":"A tart is a woman who does a lot of flirting, often used derogatorily.","e":"I think she's a real tart."},{"m":"A tart is a prostitute."}]},{"p":"adjective","d":[{"m":"When something is tart, it has an acidic taste to it.","e":"The lemonade was too tart to drink."}]}]},"lithe":{"h":"lithe","a":"En-uk-lithe.ogg","s":[{"p":"adjective","d":[{"m":"Flexible, thin, and graceful(especially of a person's body).","e":"The yoga instructor's body was lithe."}]}]},"tames":{"h":"tames","l":"tame","q":"verb"},"tamed":{"h":"tamed","l":"tame","q":"verb"},"taming":{"h":"taming","l":"tame","q":"verb"},"tarts":{"h":"tarts","l":"tart","q":"noun"},"tangerines":{"h":"tangerines","l":"tangerine","q":"noun"},"tangles":{"h":"tangles","l":"tangle","q":"noun"},"tangling":{"h":"tangling","l":"tangle","q":"verb"},"sardine":{"h":"sardine","i":"/sɑːˈdiːn/","a":"LL-Q1860 (eng)-Vealhurl-sardine.wav","s":[{"p":"noun","d":[{"m":"A sardine is a small oily fish related to herring.","e":"They opened a tin of sardines."}]}]},"vandalize":{"h":"vandalize","i":"/ˈvændəlaɪz/","a":"LL-Q1860 (eng)-Vealhurl-vandalize.wav","s":[{"p":"verb","d":[{"m":"When you vandalize something, you destroy or damage other people's work or property.","e":"John, please do not vandalize the wall!"}]}]},"varnish":{"h":"varnish","i":"/ˈvɑː(r)nɪʃ/","a":"en-us-varnish.ogg","s":[{"p":"noun","d":[{"m":"Varnish is a type of paint dissolved in a liquid for applying on wood to form a hard, clear, shiny surface."}]},{"p":"verb","d":[{"m":"If you varnish something, you apply or cover it with [[#Noun|varnish]]."}]}]},"vandalizes":{"h":"vandalizes","l":"vandalize","q":"verb"},"vandalized":{"h":"vandalized","l":"vandalize","q":"verb"},"vandalizing":{"h":"vandalizing","l":"vandalize","q":"verb"},"varnishes":{"h":"varnishes","l":"varnish","q":"noun"},"tars":{"h":"tars","l":"tar","q":"noun"},"startup":{"h":"startup","i":"/ˈstɑrtˌʌp/","s":[{"p":"noun","d":[{"m":"(countable) A startup is a new business.","e":"The startup had trouble making money at first."},{"m":"A startup is the act or process of starting a process or machine."}]}]},"startups":{"h":"startups","l":"startup","q":"noun"},"undercooked":{"h":"undercooked","s":[{"p":"adjective","d":[{"m":"Undercooked describes food that is not heated fully","e":"The chicken was undercooked."}]}]},"uplift":{"h":"uplift","i":"/ʌpˈlɪft/","a":"en-us-ncalif-uplift.ogg","s":[{"p":"verb","d":[{"m":"To uplift is to raise something or someone to a point where their physical or mental status is better","e":"To uplift my mode, I play music."}]}]},"uplifts":{"h":"uplifts","l":"uplift","q":"verb"},"uplifted":{"h":"uplifted","a":"En-us-uplifted.ogg","l":"uplift","q":"verb"},"uplifting":{"h":"uplifting","l":"uplift","q":"verb"},"twenty-one":{"h":"twenty-one","i":"/ˌtwɛntiˈwʌn/","a":"en-us-twenty-one.ogg","s":[{"p":"determiner","d":[{"m":"(ordinal twenty-first) The number 21.","e":"The legal age to drink is twenty-one years old in most states in the USA."}]}]},"referendum":{"h":"referendum","i":"/ˌrɛfəˈrɛndəm/","a":"LL-Q1860 (eng)-Vealhurl-referendum.wav","s":[{"p":"noun","d":[{"m":"(countable) A referendum is vote on a law by the general public","e":"California held a referendum on the new tax law."}]}]},"referendums":{"h":"referendums","l":"referendum","q":"noun"},"omelet":{"h":"omelet","s":[{"p":"noun","d":[{"m":"Another way of spelling omelette."}]}]},"omelets":{"h":"omelets","l":"omelet","q":"noun"},"imperial":{"h":"imperial","i":"/ɪmˈpɪ.ri.əl/","a":"en-us-imperial.ogg","s":[{"p":"adjective","d":[{"m":"Something that is imperial is something related to an empire.","e":"The imperial crown is kept with the other jewels in the tower."}]}]},"influenza":{"h":"influenza","i":"/ˌɪn.flu.ˈɛn.zə/","a":"en-us-influenza.ogg","s":[{"p":"noun","d":[{"m":"A virus that causes fevers and sickness. Often called the flu.","e":"The large number cases of influenza in the 1910s killed many."}]}]},"influenzas":{"h":"influenzas","l":"influenza","q":"noun"},"ballet":{"h":"ballet","i":"/ˈbæleɪ/","s":[{"p":"noun","d":[{"m":"(uncountable) Ballet is a type of dancing from France.","e":"Jim and Lisa liked to watch ballet."},{"m":"(countable) A ballet is any dance done in the style of ballet.","e":"What is your favorite ballet?"}]}]},"ballets":{"h":"ballets","l":"ballet","q":"noun"},"cafe":{"h":"cafe","i":"/ˌkæˈfeɪ/","a":"LL-Q1860 (eng)-Vealhurl-café.wav","s":[{"p":"noun","d":[{"m":"(countable) A cafe is a place where you can buy and drink coffee; usually you can buy and eat food there as well."}]}]},"progressive":{"h":"progressive","i":"/prəˈɡrɛsɪv/","a":"LL-Q1860 (eng)-Vealhurl-progressive.wav","s":[{"p":"adjective","d":[{"m":"Something that is progressive has to do with progress."},{"m":"In politics, someone who is progressive wants to make things better through new laws and methods.","e":"It's a victory for feminism and progressive politics."},{"m":"A progressive tax is a tax that makes the rich pay a much higher amount of their money than the poor."},{"m":"The progressive aspect is made with a form of the verb \"be\" and a verb with an \"-ing\" at the end.","e":"The present progressive of \"I go\" is \"I am going\" and the past progressive of \"I walk\" is \"I was walking\"."},{"m":"If a disease is progressive, it begins slowly and gets worse over time."}]}]},"teenage":{"h":"teenage","s":[{"p":"adjective","d":[{"m":"When someone is teenage, that person is older than twelve years old, but younger than twenty years old.","e":"During my teenage years, I had to fight for my own survival, as it was during the Great Depression."}]}]},"zapper":{"h":"zapper","i":"/ˈzæp.ə(r)/","a":"en-us-zapper.ogg","s":[{"p":"noun","d":[{"m":"(informal) A zapper is a remote control for a television.","e":"Please pass me the zapper, my show is starting on the other channel."}]}]},"zilch":{"h":"zilch","i":"/zɪlt͡ʃ/","a":"en-au-zilch.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) (informal) Zilch is nothing, zero."}]}]},"zillion":{"h":"zillion","i":"/ˈzɪljən/","a":"en-uk-zillion.ogg","s":[{"p":"noun","d":[{"m":"A zillion refers to an extremely large number."}]}]},"zillions":{"h":"zillions","l":"zillion","q":"noun"},"zappers":{"h":"zappers","l":"zapper","q":"noun"},"cafes":{"h":"cafes","l":"cafe","q":"noun"},"ape":{"h":"ape","i":"/eɪp/","a":"en-us-ape.ogg","s":[{"p":"noun","d":[{"m":"(countable) An ape is a primate that doesn't have a tail, including chimpanzees, gorillas, orangutans, gibbons and humans."}]}]},"appetite":{"h":"appetite","i":"/ˈæpɪtaɪt/","a":"en-us-appetite.ogg","s":[{"p":"noun","d":[{"m":"When you have appetite, you feel hungry and would like to eat some food.","e":"My blocked nose is making me lose appetite."}]}]},"applaud":{"h":"applaud","i":"/əˈplɔːd/","a":"en-us-applaud.ogg","s":[{"p":"verb","d":[{"m":"If you applaud something, you show you like it by hitting your hands together many times, making sounds. (clap) Especially if it is music or a play.","e":"I applaud your wonderful performance."}]}]},"applause":{"h":"applause","i":"/əˈplɔːz/","a":"en-us-applause.ogg","s":[{"p":"noun","d":[{"m":"An applause is to show praise or enjoyment of a music or play by hitting hands together many times with sounds (clapping).","e":"Please give a round of applause to this wonderful band for their music!"}]}]},"apricot":{"h":"apricot","i":"/ˈeɪ.prɪ.kɒt/","a":"en-uk-apricot.ogg","s":[{"p":"noun","d":[{"m":"(countable) An apricot is a juicy, soft fruit of an red-yellow colour.","e":"He ate a delicious apricot."},{"m":"A pale yellow-orange colour, like that of an apricot fruit."}]}]},"apes":{"h":"apes","i":"/eɪps/","a":"LL-Q1860 (eng)-Vealhurl-apes.wav","l":"ape","q":"noun"},"breadth":{"h":"breadth","i":"/brɛdθ/","a":"en-us-breadth.ogg","s":[{"p":"noun","d":[{"m":"The breadth of an object is the distance from side to side, to show how wide an object is."}]}]},"boulder":{"h":"boulder","i":"/ˈbəʊl.də(r)/","a":"en-us-boulder.ogg","s":[{"p":"noun","d":[{"m":"(countable) A boulder is a large piece of stone or rock."}]}]},"brace":{"h":"brace","i":"/breɪs/","a":"LL-Q1860 (eng)-Vealhurl-brace.wav","s":[{"p":"noun","d":[{"m":"A brace is a wire fitted in the child's mouth to straighten the teeth."}]},{"p":"verb","d":[{"m":"When you brace for something, you get yourself mentally prepared for it. preparing yourself for something bad that is going to happen.","e":"The residents braced themselves for the incoming earthquake by moving to shelters earlier today."}]}]},"braces":{"h":"braces","i":"/ˈbreɪsɪz/","a":"LL-Q1860 (eng)-Vealhurl-braces.wav","l":"brace","q":"noun","s":[{"p":"noun","d":[{"m":"Braces is something used to straighten teeth."},{"m":"Braces are a pair of straps that you wear over the shoulders and fasten to the top of trousers at the front and back to hold them up."}]}]},"brag":{"h":"brag","i":"/bræɡ/","a":"LL-Q1860 (eng)-Vealhurl-brag.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you brag about something, you say something in a too proud manner; you boast about what you have, what you can do or what you have done.","e":"Don't brag about it please."}]}]},"uncompetitiveness":{"h":"uncompetitiveness","s":[{"p":"noun","d":[{"m":"(uncountable) Not able to compete, not competing."}]}]},"competitor":{"h":"competitor","i":"/kəm.ˈpɛ.tɪ.tər/","a":"LL-Q1860 (eng)-Vealhurl-competitor.wav","s":[{"p":"noun","d":[{"m":"(countable) A competitor is someone who is in a race or an event."}]}]},"chick":{"h":"chick","i":"/t͡ʃɪk/","a":"en-us-chick.ogg","s":[{"p":"noun","d":[{"m":"(countable) A chick is a young bird, young chicken."},{"m":"(countable) Chick is a slang term for a woman or a girl."}]}]},"chirp":{"h":"chirp","i":"/tʃɜː(r)p/","a":"LL-Q1860 (eng)-Vealhurl-chirp.wav","s":[{"p":"noun","d":[{"m":"A chirp is a short, sharp, high-pitched sound by an insect or a small bird."}]}]},"choir":{"h":"choir","i":"/kwaɪə(r)/","a":"en-uk-choir.ogg","s":[{"p":"noun","d":[{"m":"(countable) A choir is a group of singers, especially in church","e":"The choir sang Jingle Bells"}]}]},"chuckle":{"h":"chuckle","i":"/ˈt͡ʃʌkəl/","a":"LL-Q1860 (eng)-Vealhurl-chuckle.wav","s":[{"p":"verb","d":[{"m":"If you chuckle, you laugh quietly or inwardly","e":"John chuckled because Fred told him a joke"}]}]},"detest":{"h":"detest","i":"/dɪˈtɛst/","a":"en-us-detest.ogg","s":[{"p":"verb","d":[{"m":"If you detest, something, you dislike it.","e":"I detest that television show"}]}]},"diaper":{"h":"diaper","i":"/ˈdaɪ(ə)pə/","a":"en-us-diaper.ogg","s":[{"p":"noun","d":[{"m":"(countable) (North America) A baby’s nappy, a napkin for between their legs."}]},{"p":"verb","d":[{"m":"If you diaper someone, you put on [[#Noun|diapers]] on someone.","e":"Diapering a baby is something you have to learn fast."}]}]},"diarrhoea":{"h":"diarrhoea","i":"/ˌdaɪ.əˈriː.ə/","a":"en-us-diarrhea.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Diarrhoea is an illness where the person's poop or feces are soft like water."}]}]},"dignified":{"h":"dignified","i":"/ˈdɪɡnɪfaɪd/","l":"dignify","q":"verb","s":[{"p":"adjective","d":[{"m":"When someone is dignified, that person has very good manners and is respectable."}]}]},"detests":{"h":"detests","l":"detest","q":"verb"},"detested":{"h":"detested","a":"En-us-detested.ogg","l":"detest","q":"verb"},"detesting":{"h":"detesting","l":"detest","q":"verb"},"diarrhoeas":{"h":"diarrhoeas","l":"diarrhoea","q":"noun"},"annex":{"h":"annex","i":"/ˈæn.ɛks/","a":"en-us-annex.ogg","s":[{"p":"verb","d":[{"m":"To attach, append, or add, especially to something larger or more important."},{"m":"To incorporate (territory) into the domain of a city, country, or state.","e":"Germany annexed part of Czechoslovakia."},{"m":"To take or appropriate, especially without permission."},{"m":"To attach as an attribute, condition, or consequence."}]}]},"envious":{"h":"envious","i":"/ˈɛnviːəs/","a":"en-uk-envious.ogg","s":[{"p":"adjective","d":[{"m":"When someone is envious, that person is jealous and has the feeling of wanting something that someone else has.","e":"As someone who does not own a car, I sometimes feel quite envious of my colleges that do."}]}]},"epidemic":{"h":"epidemic","i":"/ˌɛpɪˈdɛmɪk/","a":"en-us-epidemic.ogg","s":[{"p":"noun","d":[{"m":"(countable) An epidemic is a widespread illness, this spreads quickly to many people."}]}]},"errand":{"h":"errand","a":"En-us-errand.ogg","s":[{"p":"noun","d":[{"m":"An errand is a short journey to buy or deliver something.","e":"She had a few errands to do before she met me for coffee."}]}]},"errands":{"h":"errands","l":"errand","q":"noun"},"epidemics":{"h":"epidemics","l":"epidemic","q":"noun"},"fate":{"h":"fate","i":"/feɪt/","a":"En-us-fate.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Fate is a power that decides what will happen to us in the future."}]}]},"cliffhanger":{"h":"cliffhanger","i":"/ˌklɪfˈhæŋ.ə(r)/","a":"en-us-cliffhanger.ogg","s":[{"p":"noun","d":[{"m":"A cliffhanger is a story or movie that is exciting because you do not know what is going to happen next."}]}]},"cliffhangers":{"h":"cliffhangers","l":"cliffhanger","q":"noun"},"fates":{"h":"fates","l":"fate","q":"noun"},"chicks":{"h":"chicks","l":"chick","q":"noun"},"chirps":{"h":"chirps","l":"chirp","q":"noun"},"choirs":{"h":"choirs","l":"choir","q":"noun"},"chuckling":{"h":"chuckling","l":"chuckle","q":"verb"},"chuckles":{"h":"chuckles","l":"chuckle","q":"verb"},"chuckled":{"h":"chuckled","l":"chuckle","q":"verb"},"molt":{"h":"molt","i":"/moʊlt/","a":"LL-Q1860 (eng)-Vealhurl-moult.wav","s":[{"p":"noun","d":[{"m":"Molt is the process of shedding a covering of fur, feathers or skin etc."}]},{"p":"verb","d":[{"m":"(intransitive) If an insect or animal molts, it sheds its hair, fur, feathers, skin or horns, and replace it with a new one."}]}]},"groan":{"h":"groan","i":"/ɡrəʊn/","a":"en-us-groan.ogg","s":[{"p":"verb","d":[{"m":"A noise a person makes when they feel unhappy."}]}]},"groceries":{"h":"groceries","i":"/ˈɡroʊsəriz/","a":"en-us-groceries.ogg","l":"grocery","q":"noun","s":[{"p":"noun","d":[{"m":"Groceries are foods and other goods, for example, sugar, tea, tinned meat, and soap.","e":"We went shopping to get the groceries."}]}]},"grope":{"h":"grope","i":"/ɡrəʊp/","a":"LL-Q1860 (eng)-Vealhurl-grope.wav","s":[{"p":"verb","d":[{"m":"When you try to grope something, you search for it blindly, search something only by your hands without looking."}]}]},"growl":{"h":"growl","i":"/ˈɡraʊ̯l/","a":"en-us-growl.ogg","s":[{"p":"noun","d":[{"m":"(countable) A growl is a low angry sound, particularly one made by a dog","e":"When he got near the house, he heard a growl"}]},{"p":"verb","d":[{"m":"When you growl at someone, you make an angry sound at them."}]}]},"grub":{"h":"grub","i":"/ɡrʌb/","a":"EN-AU ck1 grub.ogg","s":[{"p":"noun","d":[{"m":"Grub is the child form of an insect that does not have wings. It especially refers to a young beetle."},{"m":"Grub is a term meaning food.","e":"This restaurant serves some good-tasting grub."}]},{"p":"verb","d":[{"m":"If you grub, you search in a clumsy manner."}]}]},"grubby":{"h":"grubby","s":[{"p":"adjective","d":[{"m":"When someone is grubby, the person is very dirty and unclean.","e":"Tommy was very grubby after playing football."}]}]},"grumble":{"h":"grumble","i":"/ˈɡrʌmbl̩/","a":"en-us-grumble.ogg","s":[{"p":"verb","d":[{"m":"When you grumble you complain about something.","e":"Don't grumble about it."}]},{"p":"noun","d":[{"m":"A grumble is a complaint.","e":"I do not want to hear another grumble."}]}]},"grunt":{"h":"grunt","a":"En-us-grunt.ogg","s":[{"p":"verb","d":[{"m":"When you grunt, you make a low short sound, usually to show your unhappiness about something."}]}]},"guerrilla":{"h":"guerrilla","i":"/ɡəˈrɪlə/","s":[{"p":"noun","d":[{"m":"(countable) A guerrilla is a member of a small independent group in military who fights against larger forces such as the government."}]}]},"guerrillas":{"h":"guerrillas","l":"guerrilla","q":"noun"},"grunts":{"h":"grunts","l":"grunt","q":"verb"},"grunted":{"h":"grunted","l":"grunt","q":"verb"},"grunting":{"h":"grunting","l":"grunt","q":"verb"},"grumbles":{"h":"grumbles","l":"grumble","q":"verb"},"grumbled":{"h":"grumbled","l":"grumble","q":"verb"},"grumbling":{"h":"grumbling","l":"grumble","q":"verb"},"grubs":{"h":"grubs","l":"grub","q":"noun"},"growls":{"h":"growls","l":"growl","q":"noun"},"growled":{"h":"growled","a":"En-us-growled.ogg","l":"growl","q":"verb"},"growling":{"h":"growling","l":"growl","q":"verb"},"gropes":{"h":"gropes","l":"grope","q":"verb"},"groped":{"h":"groped","l":"grope","q":"verb"},"groping":{"h":"groping","l":"grope","q":"verb"},"groans":{"h":"groans","i":"/ɡroʊnz/","a":"en-us-groans.ogg","l":"groan","q":"verb"},"groaned":{"h":"groaned","i":"/ɡroʊnd/","a":"en-us-groaning.ogg","l":"groan","q":"verb"},"groaning":{"h":"groaning","i":"/ˈɡroʊnɪŋ/","a":"en-us-groaning.ogg","l":"groan","q":"verb"},"molts":{"h":"molts","l":"molt","q":"verb"},"molted":{"h":"molted","l":"molt","q":"verb"},"molting":{"h":"molting","l":"molt","q":"verb"},"gallon":{"h":"gallon","i":"/ˈɡælən/","a":"en-us-gallon.ogg","s":[{"p":"noun","d":[{"m":"(countable) A unit of volume: eight pints, commonly used for measuring gasoline.","e":"Gas costs only 3 dollars and 20 cents per gallon here"}]}]},"gallons":{"h":"gallons","l":"gallon","q":"noun"},"diapers":{"h":"diapers","l":"diaper","q":"noun"},"competitors":{"h":"competitors","l":"competitor","q":"noun"},"hairstyle":{"h":"hairstyle","a":"LL-Q1860 (eng)-Wodencafe-hairstyle.wav","s":[{"p":"noun","d":[{"m":"The way in which someone's hair has been cut and arranged.","e":"His hairstyle is one which covers his ears"}]}]},"harsh":{"h":"harsh","i":"/hɑrʃ/","a":"en-au-harsh.ogg","s":[{"p":"adjective","d":[{"m":"When someone is harsh, that person is very unpleasant, rough and cruel.","e":"Our school's discipline master is very harsh on people who break the school rules."}]}]},"haste":{"h":"haste","i":"/heɪst/","a":"en-us-haste.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) If you make haste, you try to do something quickly and soon.","e":"We must make haste if we are to arrive on time."},{"m":"(uncountable) Your haste is the careless speed you do something with.","e":"In my haste to catch the bus, I forgot my bag."}]}]},"hasty":{"h":"hasty","i":"/ˈheɪsti/","a":"en-us-hasty.ogg","s":[{"p":"adjective","d":[{"m":"When something is hasty, it is done in haste, very quickly or in a hurried manner.","e":"Without taking time to think about it, they made a hasty decision to take up the project."}]}]},"haul":{"h":"haul","i":"/hɔːl/","a":"en-au-haul.ogg","s":[{"p":"verb","d":[{"m":"When you haul something heavy, you pull it up with big force, or drag with big force."}]}]},"haunt":{"h":"haunt","i":"/hɔːnt/","a":"LL-Q1860 (eng)-Vealhurl-haunt.wav","s":[{"p":"noun","d":[{"m":"(countable) A haunt is a place where someone is regularly found at."}]},{"p":"verb","d":[{"m":"If a ghost haunts a place, it visits and appears at the place frequently."}]}]},"haze":{"h":"haze","i":"/heɪz/","a":"LL-Q1860 (eng)-Vealhurl-haze.wav","s":[{"p":"noun","d":[{"m":"Haze is thin fog, slight mist, thin cloud and slight smoke"}]}]},"hazy":{"h":"hazy","i":"/ˈheɪzi/","a":"LL-Q1860 (eng)-Vininn126-hazy.wav","s":[{"p":"adjective","d":[{"m":"If it is a hazy day, the sky is not clear and covered by a haze."}]}]},"hairstyles":{"h":"hairstyles","l":"hairstyle","q":"noun"},"hazier":{"h":"hazier","l":"hazy","q":"adjective"},"haziest":{"h":"haziest","l":"hazy","q":"adjective"},"hazes":{"h":"hazes","l":"haze","q":"noun"},"haunts":{"h":"haunts","l":"haunt","q":"noun"},"haunted":{"h":"haunted","i":"/ˈhɔːntɪd/","a":"en-us-haunted.ogg","l":"haunt","q":"verb","s":[{"p":"adjective","d":[{"m":"If a place is haunted, it is frequented by ghosts."}]}]},"haunting":{"h":"haunting","l":"haunt","q":"verb"},"hauls":{"h":"hauls","l":"haul","q":"verb"},"hauled":{"h":"hauled","l":"haul","q":"verb"},"hauling":{"h":"hauling","l":"haul","q":"verb"},"hastier":{"h":"hastier","l":"hasty","q":"adjective"},"hastiest":{"h":"hastiest","l":"hasty","q":"adjective"},"appetites":{"h":"appetites","l":"appetite","q":"noun"},"apricots":{"h":"apricots","l":"apricot","q":"noun"},"boulders":{"h":"boulders","l":"boulder","q":"noun"},"applauses":{"h":"applauses","l":"applause","q":"noun"},"applauds":{"h":"applauds","l":"applaud","q":"verb"},"applauded":{"h":"applauded","i":"/əˈplɔːdɪd/","a":"en-us-applauded.ogg","l":"applaud","q":"verb"},"applauding":{"h":"applauding","l":"applaud","q":"verb"},"breadths":{"h":"breadths","l":"breadth","q":"noun"},"anonymously":{"h":"anonymously","i":"/əˈnɒnəməsli/","a":"LL-Q1860 (eng)-Vealhurl-anonymously.wav","s":[{"p":"adverb","d":[{"m":"If you do something anonymously, then you do it without giving out your name/identity; you do it in an anonymous manner.","e":"The book was written anonymously"}]}]},"wallpaper":{"h":"wallpaper","i":"/ˈwɔːlˌpeɪpə/","a":"en-us-wallpaper.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Something similar to paper that is put over walls, and often contains pretty patterns."},{"m":"(countable) The background image on a computer image"}]},{"p":"verb","d":[{"m":"To put [[#Noun|wallpaper]] on walls."}]}]},"unanimity":{"h":"unanimity","i":"/juːnəˈnɪmɪti/","a":"LL-Q1860 (eng)-Vealhurl-unanimity.wav","s":[{"p":"noun","d":[{"m":"Unanimity is when something is unanimous."}]}]},"unanimities":{"h":"unanimities","l":"unanimity","q":"noun"},"wallpapers":{"h":"wallpapers","l":"wallpaper","q":"noun"},"handicap":{"h":"handicap","i":"/ˈhændɪkæp/","a":"LL-Q1860 (eng)-Vealhurl-handicap.wav","s":[{"p":"noun","d":[{"m":"Something that makes someone disadvantaged. This often refers to being disabled physically or mentally."},{"m":"A change made in a race or competition to make it more equal. This might involve giving one player more time, or extra points at the start."}]},{"p":"verb","d":[{"m":"To figure out who has the best chance of winning a race or competition"},{"m":"To be disadvantaged"}]}]},"satellite":{"h":"satellite","i":"/ˈsætəlaɪt/","a":"LL-Q1860 (eng)-Vealhurl-satellite.wav","s":[{"p":"noun","d":[{"m":"A satellite is an object in orbit around another celestial object, such as the Moon orbiting the Earth."},{"m":"A satellite is a man-made object orbiting a celestial body, especially one sending back information to Earth or one helping with GPS trilateration or television signals."},{"m":"A television which uses a satellite dish."}]}]},"satellites":{"h":"satellites","l":"satellite","q":"noun"},"handica