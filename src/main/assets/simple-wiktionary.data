":"noun","d":[{"m":"(countable) A clipping is a piece of something removed by clipping."}]}]},"advertize":{"h":"advertize","i":"/ˈæd.vɚ.taɪz/","a":"en-us-advertize.ogg","s":[{"p":"verb","d":[{"m":"If you advertize something, you make it known publicly, usually to sell it.","e":"I'm advertizing my new business in the newspaper."}]}]},"advertizes":{"h":"advertizes","l":"advertize","q":"verb"},"advertized":{"h":"advertized","l":"advertize","q":"verb"},"advertizing":{"h":"advertizing","i":"/ˈædvə(r)ˌtaɪzɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-advertising.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Advertizing is the business or study of using newspapers, TV, etc. to sell products or inform people.","e":"Coke has a new advertizing campaign for a new drink."}]}]},"firework":{"h":"firework","i":"/ˈfaɪɚˌwɚk/","a":"LL-Q1860 (eng)-Vealhurl-firework.wav","s":[{"p":"noun","d":[{"m":"(countable) A firework is a device that, when set on fire, causes a bang and many colours in the sky.","e":"The firework show is on the Fourth of July."}]}]},"yield":{"h":"yield","i":"/jiːld/","a":"en-us-yield.ogg","s":[{"p":"noun","d":[{"m":"A yield is how much of a crop is grown in a year.","e":"This year's harvest had a good yield."}]},{"p":"verb","d":[{"m":"To yield is to give way to someone or something else","e":"Cars yield to the walkers when the walkers are in the crosswalk."},{"m":"To yield is to produce something.","e":"Most of the time, stocks yield more money than the original cost."}]}]},"zip":{"h":"zip","i":"/zɪp/","a":"en-us-zip.ogg","s":[{"p":"noun","d":[{"m":"A zip is a sound made by a small object.","e":"Zip!"},{"m":"(countable) A zip is a short form of zipper.","e":"Is the zip on your coat working."}]},{"p":"verb","d":[{"m":"(intransitive) If something zips somewhere, it move there quickly.","e":"The birds zip from tree to tree."},{"m":"(transitive) If you zip something up, you close its zipper.","e":"Zip up your coat before going outside."}]}]},"novel":{"h":"novel","i":"/ˈnɒvl̩/","a":"en-us-novel.ogg","s":[{"p":"adjective","d":[{"m":"Something that is novel is new and interesting.","e":"\"That's a novel idea!\""}]},{"p":"noun","d":[{"m":"(countable) A novel is a long story.","e":"I wrote a novel last November for National Novel Writing Month."}]}]},"youngish":{"h":"youngish","s":[{"p":"adjective","d":[{"m":"Sort of young.","e":"In spite of his youngish appearance, he had done much."}]}]},"vital":{"h":"vital","i":"/ˈvaɪtəl/","a":"en-us-vital.ogg","s":[{"p":"adjective","d":[{"m":"Something that is vital is something that is needed to live.","e":"Water is vital to life."},{"m":"Something that is vital is very important.","e":"Doing your homework is vital to success later in life."}]}]},"jew":{"h":"Jew","i":"/dʒuː/","a":"en-us-jew.ogg","s":[{"p":"noun","d":[{"m":"(countable) A Jew is someone of the Jewish faith, heritage or race.","e":"The Jews go to synagogue on Saturday."}]}]},"yields":{"h":"yields","a":"En-us-yields.ogg","l":"yield","q":"noun"},"yielded":{"h":"yielded","i":"/ˈjiːldɪd/","a":"en-us-yielded.ogg","l":"yield","q":"verb"},"yielding":{"h":"yielding","i":"/ˈjiːldɪŋ/","l":"yield","q":"verb"},"zips":{"h":"zips","l":"zip","q":"noun"},"zipped":{"h":"zipped","l":"zip","q":"verb"},"zipping":{"h":"zipping","l":"zip","q":"verb"},"novels":{"h":"novels","l":"novel","q":"noun"},"jews":{"h":"Jews","l":"jew","q":"noun"},"abusive":{"h":"abusive","i":"/əˈbjuː.sɪv/","a":"LL-Q1860 (eng)-Mélange a trois-abusive.wav","s":[{"p":"adjective","d":[{"m":"If someone is abusive, he is violent and abuses (takes advantage of) others.","e":"My father was abusive to us children. He always hit us when he was angry."}]}]},"gasps":{"h":"gasps","l":"gasp","q":"verb"},"gasped":{"h":"gasped","a":"en-us-gasped.ogg","l":"gasp","q":"verb"},"gasping":{"h":"gasping","l":"gasp","q":"verb"},"jigs":{"h":"jigs","l":"jig","q":"noun"},"brisker":{"h":"brisker","l":"brisk","q":"adjective"},"briskest":{"h":"briskest","l":"brisk","q":"adjective"},"cots":{"h":"cots","l":"cot","q":"noun"},"rag":{"h":"rag","i":"/ræɡ/","a":"en-us-rag.ogg","s":[{"p":"noun","d":[{"m":"(countable) A piece of cloth to clean dirty stuff, usually dirty.","e":"Use that dirty rag over there to wipe this mess."}]}]},"rags":{"h":"rags","a":"En-us-rags.ogg","l":"rag","q":"noun"},"usefulness":{"h":"usefulness","i":"/ˈjuːsfəlnəs/","a":"en-us-usefulness.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Something's usefulness is how useful it is."}]}]},"allude":{"h":"allude","i":"/əˈluːd/","a":"en-uk-allude.ogg","s":[{"p":"verb","d":[{"m":"If you allude to something, you bring it up without actually saying it.","e":"When he mocked her by saying \"I'm late! I'm late, for a very important date!\", he was clearly alluding to the White Rabbit in Alice's Adventures in Wonderland."}]}]},"alluded":{"h":"alluded","a":"en-us-alluded.ogg","l":"allude","q":"verb"},"alludes":{"h":"alludes","l":"allude","q":"verb"},"alluding":{"h":"alluding","l":"allude","q":"verb"},"metaphor":{"h":"metaphor","i":"/ˈmɛ.tə.fə/","a":"en-us-metaphor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A metaphor is a way of talking about one thing by using the language usually used for something else to show some kind of similarity between them.","e":"People often talk about brains using the metaphor of a computer."}]}]},"nepotism":{"h":"nepotism","a":"En-us-nepotism.ogg","s":[{"p":"noun","d":[{"m":"Nepotism is when someone in power unfairly favors a family member. Typically, nepotism happens when family members work together and the older family member gives the younger family additional pay or privileges.","e":"It was a clear cut case of nepotism when the father hired his incompetent son for the position instead of the more qualified applicants."}]}]},"totalitarianism":{"h":"totalitarianism","i":"/ˌtəʊtalɪˈtɛːrɪənɪz(ə)m/","a":"en-us-totalitarianism.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Totalitarianism is a word used to describe a society that is being ruled by a dictator. In totalitarianism, citizens have few rights and must obey incredibly strict and unfair laws. Typically, a dictator or ruling class is in charge and creates rules and punishments to establish an \"orderly society\" that keeps them in power.","e":"George Orwell's book Nineteen Eighty Four predicted that society could turn to totalitarianism if its citizens were indifferent enough."}]}]},"hyperbole":{"h":"hyperbole","i":"/haɪˈpɝːbəli/","a":"en-us-hyperbole.ogg","s":[{"p":"noun","d":[{"m":"Hyperbole is exaggeration. It is a type of figurative language commonly used in everyday speech, poetry, and literature. It makes something sound much better or much worse than it really is.","e":"She told Leo her father had cooked enough food to feed an army. Leo thought that was just hyperbole until HE saw the food."}]}]},"pamper":{"h":"pamper","i":"/ˈpæmpə(r)/","a":"LL-Q1860 (eng)-Vealhurl-pamper.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you pamper someone or something, then you are treating it very nicely and spoiling him/her/it.","e":"We tend to pamper our children when they are babies by providing everything they need."}]}]},"mistress":{"h":"mistress","i":"/ˈmɪstrɪs/","a":"en-us-mistress.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mistress is a woman who controls something."},{"m":"(countable) A mistress is a woman that a married man is having an affair with. She is not the man's wife, but the other woman that he is having a romantic or sexual relationship with. Usually, a mistress is kept secret."}]}]},"guile":{"h":"guile","s":[{"p":"noun","d":[{"m":"(uncountable) If you have guile, then you have a smart and cunning nature. A person with guile is crafty, quick witted, and usually sly."}]}]},"tilde":{"h":"tilde","i":"/ˈtɪldə/","a":"en-us-tilde-2.ogg","s":[{"p":"noun","d":[{"m":"(countable) A punctuation character used in some different languages.","e":"Tilde is used in the Spanish word piñata."},{"m":"(countable) Wikimedia's projects use tildes to sign comments on talk pages.","e":"Sign comments with four tildes."}]}]},"abacus":{"h":"abacus","i":"/ˈæbəkəs/","a":"en-us-abacus.ogg","s":[{"p":"noun","d":[{"m":"(countable) An abacus is an ancient calculating device. It is made of a frame with beads on various rods."}]}]},"abacuses":{"h":"abacuses","l":"abacus","q":"noun"},"nepotisms":{"h":"nepotisms","l":"nepotism","q":"noun"},"pampered":{"h":"pampered","l":"pamper","q":"verb"},"pampers":{"h":"pampers","l":"pamper","q":"verb"},"pampering":{"h":"pampering","l":"pamper","q":"verb"},"metaphors":{"h":"metaphors","l":"metaphor","q":"noun"},"mistresses":{"h":"mistresses","l":"mistress","q":"noun"},"guiles":{"h":"guiles","l":"guile","q":"noun"},"tildes":{"h":"tildes","l":"tilde","q":"noun"},"abase":{"h":"abase","i":"/əˈbeɪs/","a":"en-us-abase.ogg","s":[{"p":"verb","d":[{"m":"If you abase someone or something, then you are trying to lower its status. Typically, you abase by insulting,, or lowering worth.","e":"He felt that his moral principles were abased after the deal was done."}]}]},"abases":{"h":"abases","i":"/əˈbeɪses/","a":"en-ca-abases.ogg","l":"abase","q":"verb"},"abased":{"h":"abased","i":"/əˈbeɪst/","a":"LL-Q1860 (eng)-Vealhurl-abased.wav","l":"abase","q":"verb"},"abasing":{"h":"abasing","i":"/əˈbeɪsɪŋ/","a":"en-ca-abasing.ogg","l":"abase","q":"verb"},"economist":{"h":"economist","i":"/iːˈkɒn.ə.mɪst/","a":"LL-Q1860 (eng)-Vealhurl-economist.wav","s":[{"p":"noun","d":[{"m":"(countable) An economist is an expert in economics, especially one who studies economic information and extracts higher-level information or proposes ideas","e":"A University of Calgary economist expects the local oil industry to lose 13,000 jobs."}]}]},"economists":{"h":"economists","l":"economist","q":"noun"},"strategically":{"h":"strategically","s":[{"p":"adverb","d":[{"m":"In a strategic manner."}]}]},"formation":{"h":"formation","i":"/fɔr.meɪ.ʃən/","a":"en-us-formation.oga","s":[{"p":"noun","d":[{"m":"Something having structure or form.","e":"The chorus boys and girls were put through a variety of formations in the new Andrew Lloyd Webber musical."},{"m":"The act of building a group or structure."},{"m":"A rock or face of a mountain."},{"m":"A grouping of military units or smaller formations under a command, such as a brigade, division, wing, etc."},{"m":"An arrangement of moving troops, ships, or aircraft, such as a wedge, line abreast, or echelon. Often \"in formation\"."},{"m":"The process of influencing or guiding a person to a deeper understanding of a particular vocation."}]}]},"formations":{"h":"formations","l":"formation","q":"noun"},"tulip":{"h":"tulip","i":"/ˈt(j)uːlɪp/","a":"En-us-tulip.ogg","s":[{"p":"noun","d":[{"m":"A type of flowering plant, genus Tulipa."},{"m":"The flower of a tulip.","e":"The tulips are beautiful this time of year."}]}]},"heretic":{"h":"heretic","i":"/ˈhɛrɨtɪk/","a":"LL-Q1860 (eng)-Vealhurl-heretic.wav","s":[{"p":"noun","d":[{"m":"(countable) A heretic is someone who in the opinion of other people believes the opposite to the basic beliefs of a religion he claims to belong to."}]}]},"tulips":{"h":"tulips","l":"tulip","q":"noun"},"heretics":{"h":"heretics","l":"heretic","q":"noun"},"ventilation":{"h":"ventilation","i":"/ˌvɛntɪˈleɪʃ(ə)n/","a":"en-us-ventilation.ogg","s":[{"p":"noun","d":[{"m":"Ventilation is the replacement of stale air with fresh air."},{"m":"Ventilation is the bodily process of breathing; the inhalation of air to provide oxygen, and the exhalation of spent air to remove carbon dioxide."}]}]},"strategical":{"h":"strategical","s":[{"p":"adjective","d":[{"m":"Strategic"}]}]},"enforce":{"h":"enforce","i":"/ɪnˈfors/","a":"LL-Q1860 (eng)-Vealhurl-enforce.wav","s":[{"p":"verb","d":[{"m":"To enforce means to make sure that something will be made into effect and followed.","e":"The police enforce the law."}]}]},"enforces":{"h":"enforces","l":"enforce","q":"verb"},"enforced":{"h":"enforced","l":"enforce","q":"verb"},"enforcing":{"h":"enforcing","l":"enforce","q":"verb"},"testimony":{"h":"testimony","i":"/ˈtɛstɪmoʊni/","a":"en-us-testimony.ogg","s":[{"p":"noun","d":[{"m":"(countable) A testimony is statement made in order to prove something. Typically, testimony is given in a courtroom by a witness. Or, testimonies are used in advertisements to sell products.","e":"The eye-witness testimony of the robbery was enough for the jury to believe that the suspect was guilty."}]}]},"tout":{"h":"tout","i":"/taʊt/","a":"en-us-tout.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If someone touts something, they tell others it is good.","e":"The boy touted his basketball skills to the coach, hoping to be given a position of the team."}]}]},"stamina":{"h":"stamina","i":"/ˈstæmɪnə/","a":"LL-Q1860 (eng)-Vininn126-stamina.wav","l":"stamen"},"legislate":{"h":"legislate","i":"/ˈlɛdʒɪsˌleɪt/","a":"LL-Q1860 (eng)-Vealhurl-legislate.wav","s":[{"p":"verb","d":[{"m":"If you legislate, you create or change a law.","e":"The government legislated changes to the tax law."}]}]},"marathon":{"h":"marathon","i":"/ˈmærəθən/","a":"LL-Q1860 (eng)-Vealhurl-marathon.wav","s":[{"p":"noun","d":[{"m":"A marathon is a long distance race of exactly 26 miles and 385 yards (or 42.195 kilometers).","e":"The marathon is named after a soldier who ran 26 miles and 385 yards to tell the people of Athens about the Greek victory."},{"m":"A marathon is an activity that extends for a long period of time.","e":"Yesterday, we had a Star Wars movie marathon and watched all six films in a row."}]}]},"extracurricular":{"h":"extracurricular","i":"/ˌɛkstrəkəˈrɪkjʊlə(r)/","a":"LL-Q1860 (eng)-Vealhurl-extracurricular.wav","s":[{"p":"adjective","d":[{"m":"If an activity is extracurricular, then it is an activity that happens outside of school. Activities like clubs, sports, and volunteering are consider extracurricular.","e":"Some schools require that you have decent grades in order to participate in extracurricular activities."}]}]},"exploit":{"h":"exploit","i":"/ˈɛksplɔɪt/","a":"en-us-exploit.ogg","s":[{"p":"noun","d":[{"m":"An exploit is a program that takes advantage of a vulnerability in other software."}]},{"p":"verb","d":[{"m":"If you exploit someone or something, then you are taking advantage of it, usually in a harmful way. Mostly, you exploit when you don't pay someone enough for their hard work.","e":"Slaves were exploited for their free labor."}]}]},"spokesperson":{"h":"spokesperson","i":"/ˈspəʊkspɜːrsən/","a":"LL-Q1860 (eng)-Vealhurl-spokesperson.wav","s":[{"p":"noun","d":[{"m":"(countable) A spokesperson is a person who says what a group of people think or want."}]}]},"captivate":{"h":"captivate","i":"/ˈkæptɪveɪt/","a":"LL-Q1860 (eng)-Vealhurl-captivate.wav","s":[{"p":"verb","d":[{"m":"(transitive) If something captivates you, it makes you very interested in it.","e":"The show captivated audiences around the world."}]}]},"satire":{"h":"satire","i":"/ˈsætaɪr/","a":"en-us-satire.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Satire is a way of writing or speaking. It uses humor to say bad things about a person as a way to change people's thinking. Examples of satire are irony and sarcasm."}]}]},"testimonies":{"h":"testimonies","l":"testimony","q":"noun"},"touts":{"h":"touts","l":"tout","q":"verb"},"touted":{"h":"touted","l":"tout","q":"verb"},"touting":{"h":"touting","l":"tout","q":"verb"},"legislates":{"h":"legislates","l":"legislate","q":"verb"},"legislated":{"h":"legislated","l":"legislate","q":"verb"},"legislating":{"h":"legislating","l":"legislate","q":"verb"},"marathons":{"h":"marathons","l":"marathon","q":"noun"},"captivates":{"h":"captivates","l":"captivate","q":"verb"},"captivated":{"h":"captivated","l":"captivate","q":"verb"},"captivating":{"h":"captivating","l":"captivate","q":"verb"},"loyalists":{"h":"loyalists","l":"loyalist","q":"noun"},"loyalist":{"h":"loyalist","i":"/ˈlɔɪəlɪst/","s":[{"p":"noun","d":[{"m":"(countable) A person or group that strongly supports the government or ruler in power."}]}]},"slogan":{"h":"slogan","i":"/ˈsləʊɡ(ə)n/","a":"en-us-slogan.ogg","s":[{"p":"noun","d":[{"m":"(countable) A slogan is like a motto, but longer. It is like a catchphrase used in promoting products, candidate or a cause.","e":"The presidential candidate came up with a very catchy slogan that people can remember clearly."}]}]},"slogans":{"h":"slogans","l":"slogan","q":"noun"},"plump":{"h":"plump","i":"/plʌmp/","a":"LL-Q1860 (eng)-Vealhurl-plump.wav","s":[{"p":"adjective","d":[{"m":"A plump person is someone who has a rounded body shape."}]},{"p":"verb","d":[{"m":"(transitive) If you plump up something, you shake it to make it [[#Noun|plump]]."}]}]},"yip":{"h":"yip","i":"/jɪp/","a":"LL-Q1860 (eng)-Vealhurl-yip.wav","s":[{"p":"noun","d":[{"m":"(countable) A yip is a sharp, high-pitch bark."}]},{"p":"verb","d":[{"m":"(intransitive) To yip is to bark with a sharp, high-pitched voice.","e":"The dog yipped with joy."}]}]},"yipping":{"h":"yipping","l":"yip","q":"verb"},"yips":{"h":"yips","l":"yip","q":"noun"},"yipped":{"h":"yipped","l":"yip","q":"verb"},"manuscript":{"h":"manuscript","i":"/ˈmænjəˌskrɪpt/","a":"en-us-manuscript.ogg","s":[{"p":"adjective","d":[{"m":"A manuscript is something that is written by hand instead of being printed by machines."}]},{"p":"noun","d":[{"m":"(countable) A book or any other document written by hand, not made by a machine"},{"m":"(countable) The first copy of a book, article, or written work that was written by hand or even printed, handed over as the original for correcting and publication."}]}]},"manuscripts":{"h":"manuscripts","l":"manuscript","q":"noun"},"welch":{"h":"welch","i":"/wɛltʃ/","a":"LL-Q1860 (eng)-Vealhurl-welch.wav","s":[{"p":"verb","d":[{"m":"(intransitive) To be unable to repay a small debt."}]}]},"welches":{"h":"welches","l":"welch","q":"verb"},"welched":{"h":"welched","l":"welch","q":"verb"},"welching":{"h":"welching","l":"welch","q":"verb"},"scholarship":{"h":"scholarship","i":"/ˈskɒləʃɪp/","a":"en-au-scholarship.ogg","s":[{"p":"noun","d":[{"m":"(countable) A scholarship is a special grant usually provided to a student to continue his/her studies overseas.","e":"He came in top in his country, therefore he had a scholarship to come here and study."}]}]},"scholarships":{"h":"scholarships","l":"scholarship","q":"noun"},"dependant":{"h":"dependant","i":"/dɪˈpɛndənt/","s":[{"p":"noun","d":[{"m":"(countable) A dependant is a person who relies on another person for support.","e":"With two children and an ailing mother, she had three dependants in all"},{"m":"(countable) A dependant is an element in a phrase that is not the head."}]}]},"dependants":{"h":"dependants","l":"dependant","q":"noun"},"zenith":{"h":"zenith","i":"/ˈzɛn.ɪθ/","a":"en-us-zenith.ogg","s":[{"p":"noun","d":[{"m":"(countable) The zenith is the highest point/the tip of something.","e":"After climbing to the zenith of Mount Everest, I was exhausted!"}]}]},"precedent":{"h":"precedent","i":"/priˈsiː.dənt/","a":"en-us-precedent.ogg","s":[{"p":"noun","d":[{"m":"If something has a precedent, then either it has happened before or something very similar has happened before. A precedent is when a similar situation has preceded the current situation. People typically use precedent in an argument to claim that \"if it happened before, then it can happen again\".","e":"Outlawing tobacco products probably wouldn't work because of the precedent of prohibition in the 1920s."}]}]},"zeniths":{"h":"zeniths","l":"zenith","q":"noun"},"ribbon":{"h":"ribbon","i":"/ˈrɪbən/","a":"en-us-ribbon.ogg","s":[{"p":"noun","d":[{"m":"(countable) A ribbon is a small, thin piece of cloth that can be used to tie objects together.","e":"Wear this ribbon to support our movement."}]}]},"ribbons":{"h":"ribbons","l":"ribbon","q":"noun"},"satires":{"h":"satires","l":"satire","q":"noun"},"tolerances":{"h":"tolerances","l":"tolerance","q":"noun"},"hippopotomonstrosesquipedaliophobia":{"h":"hippopotomonstrosesquipedaliophobia","i":"/ˌhɪ.pə.pɒ.təˈmɒn.strəˌsɛ.skwɪ.pɪˈdeɪ.lɪəˌfoʊ.bɪə/","a":"en-uk-hippopotomonstrosesquipedaliophobia.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) The fear of long words.","e":"Ben suffers from a normal form of hippopotomonstrosesquipedaliophobia."}]}]},"acceptably":{"h":"acceptably","i":"/æk.ˈsɛp.tə.bli/","s":[{"p":"adverb","d":[{"m":"In an acceptable manner; in a manner to please or give satisfaction."},{"m":"To an acceptable degree."}]}]},"unacceptably":{"h":"unacceptably","i":"/ˌʌn.ækˈsɛp.tə.bl̩i/","a":"LL-Q1860 (eng)-Flame, not lame-unacceptably.wav","s":[{"p":"adverb","d":[{"m":"Not within the limits of what is generally considered to be acceptable; alternatively, within the limits of what is generally considered to be unacceptable","e":"The levels of lead in marine hull paints are still unacceptably high."}]}]},"owl":{"h":"owl","i":"/aʊl/","a":"en-us-owl.ogg","s":[{"p":"noun","d":[{"m":"(countable) An owl is a type of bird. Usually it is a large bird, with two large eyes in front, that catches smaller animals at night and sleeps during the day.","e":"There were three owls hooting during night."}]}]},"owls":{"h":"owls","l":"owl","q":"noun"},"trophy":{"h":"trophy","i":"/ˈtrəʊfi/","a":"LL-Q1860 (eng)-Vealhurl-trophy.wav","s":[{"p":"noun","d":[{"m":"(countable) A trophy is a special item given for winning a contest or competition.","e":"John is very talented. He has won many trophies from different competitions all over the world."}]}]},"trophies":{"h":"trophies","l":"trophy","q":"noun"},"moan":{"h":"moan","i":"/məʊn/","a":"en-us-moan.ogg","s":[{"p":"verb","d":[{"m":"When you moan, you complain about something to another person.","e":"I moaned at the unfair treatment given to me by the teacher."}]}]},"moans":{"h":"moans","l":"moan","q":"verb"},"moaned":{"h":"moaned","a":"En-us-moaned.ogg","l":"moan","q":"verb"},"moaning":{"h":"moaning","l":"moan","q":"verb"},"scrub":{"h":"scrub","i":"/skrʌb/","a":"LL-Q1860 (eng)-Vealhurl-scrub.wav","s":[{"p":"verb","d":[{"m":"When you scrub something, you use a piece of cloth to rub very hard against an object just to clean it.","e":"No matter how hard I scrub, I can never make this shirt shine again."}]}]},"scrubs":{"h":"scrubs","l":"scrub","q":"verb","s":[{"p":"noun","d":[{"m":"Clothing worn by surgeons or nurses."}]}]},"scrubbing":{"h":"scrubbing","l":"scrub","q":"verb"},"scrubbed":{"h":"scrubbed","l":"scrub","q":"verb"},"splash":{"h":"splash","i":"/splæʃ/","a":"en-us-splash.ogg","s":[{"p":"verb","d":[{"m":"If someone splashes something (usually water) on somebody, they pour water on another person.","e":"He playfully splashed water on the old man downstairs."}]}]},"splashes":{"h":"splashes","l":"splash","q":"verb"},"splashed":{"h":"splashed","l":"splash","q":"verb"},"splashing":{"h":"splashing","l":"splash","q":"verb"},"rescue":{"h":"rescue","i":"/ˈreskjuː/","a":"en-us-rescue.ogg","s":[{"p":"verb","d":[{"m":"If you rescue someone, you save them from any violence, emergency, or evil.","e":"The lifeguard jumped into the swimming pool to rescue the drowning woman."},{"m":"If you rescue someone, you free them from a prison or some other physical restraint.","e":"After capturing the enemy army, they rescued the prisoners."},{"m":"If you rescue something, you take it back using force."}]},{"p":"noun","d":[{"m":"A rescue is a saving of someone or something.","e":"We saw his rescue from the burning house."},{"m":"A rescue is a freeing of someone or something.","e":"The soldiers rescue of their target from the prison was all they could talk about."}]}]},"rescues":{"h":"rescues","l":"rescue","q":"verb"},"rescued":{"h":"rescued","i":"/ˈrɛs.kjuːd/","a":"LL-Q1860 (eng)-Back ache-rescued.wav","l":"rescue","q":"verb"},"rescuing":{"h":"rescuing","l":"rescue","q":"verb"},"whack":{"h":"whack","i":"/wæk/","a":"en-au-whack.ogg","s":[{"p":"verb","d":[{"m":"When you whack someone or something, you hit then with an object or body part. Usually the object is flat or blunt. The word is based on the sound it makes, so it's an onomatopoeia.","e":"I picked up the wooden club and whacked the running thief."}]}]},"whacks":{"h":"whacks","l":"whack","q":"verb"},"whacked":{"h":"whacked","l":"whack","q":"verb"},"whacking":{"h":"whacking","l":"whack","q":"verb"},"tale":{"h":"tale","i":"/ˈteɪl/","a":"en-au-tale.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tale is a type of story.","e":"Have you read the tale of three pigs?"}]}]},"tales":{"h":"tales","i":"/teɪlz/","a":"LL-Q1860 (eng)-Vealhurl-tales (tale).wav","l":"tale","q":"noun"},"hyper":{"h":"hyper","i":"/ˈhaɪpə/","a":"LL-Q1860 (eng)-Naomi Persephone Amethyst (NaomiAmethyst)-hyper.wav","s":[{"p":"adjective","d":[{"m":"If you are hyper, you are very excited or active.","e":"My dog was hyper today, having had the energy to run around the yard ten times."}]}]},"chai":{"h":"chai","i":"/t͡ʃaɪ/","a":"en-us-chai.ogg","s":[{"p":"noun","d":[{"m":"(uncountable) Chai is a type of tea, especially with spices.","e":"Maggie was drinking chai from a cup she'd brought from home."}]}]},"chais":{"h":"chais","l":"chai","q":"noun"},"abide":{"h":"abide","i":"/əˈbaɪd/","a":"en-us-abide.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you can't abide something, you really do not like it."},{"m":"(transitive) If you abide by a rule or decision, you follow or accept it.","e":"\"You will face a life sentence in prison if you do not abide by my rule!\" the king threatened."}]}]},"industrial":{"h":"industrial","i":"/ɪnˈdʌstrɪəl/","a":"en-us-industrial.ogg","s":[{"p":"adjective","d":[{"m":"If something is industrial, it has something to do with industry.","e":"Factories are industrial buildings."}]}]},"manse":{"h":"manse","i":"/mæns/","s":[{"p":"noun","d":[{"m":"(countable) A manse is a minister's house.","e":"Winston Churchill's manse was very aesthetic with only a rag, a bowl, and two books."}]}]},"manses":{"h":"manses","s":[{"p":"noun","d":[{"m":"The plural form of manse, ore than one manse."}]}]},"cumulative":{"h":"cumulative","i":"/cuɱ̩ul̩ɑtɪʌ/","a":"LL-Q1860 (eng)-Vealhurl-cumulative.wav","s":[{"p":"adjective","d":[{"m":"If something is cumulative it is combined or 