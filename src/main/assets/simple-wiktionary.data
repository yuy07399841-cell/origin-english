l":"creepy","q":"adjective"},"creepiest":{"h":"creepiest","l":"creepy","q":"adjective"},"great-grandparents":{"h":"great-grandparents","l":"great-grandparent","q":"noun"},"dependence":{"h":"dependence","i":"/dɪˈpɛndəns/","a":"LL-Q1860 (eng)-Vealhurl-dependence.wav","s":[{"p":"noun","d":[{"m":"Dependence is the state of depending on something or someone else other than one's self."},{"m":"Dependence is the relationship of a country under the rule of another country.","e":"The Isle of Man is in a state of dependence on the United Kingdom of Great Britain and Northern Ireland."}]}]},"pedestal":{"h":"pedestal","i":"/ˈpɛdɪstəl/","a":"LL-Q1860 (eng)-Vealhurl-pedestal.wav","s":[{"p":"noun","d":[{"m":"A pedestal is a platform that holds up objects such as statues and vases."}]},{"p":"verb","d":[{"m":"When you pedestal something, you put it on a [[#Noun|pedestal]]."}]}]},"pedestals":{"h":"pedestals","l":"pedestal","q":"noun"},"pedestaled":{"h":"pedestaled","l":"pedestal","q":"verb"},"pedestaling":{"h":"pedestaling","l":"pedestal","q":"verb"},"dependences":{"h":"dependences","l":"dependence","q":"noun"},"pushier":{"h":"pushier","l":"pushy","q":"adjective"},"pushiest":{"h":"pushiest","l":"pushy","q":"adjective"},"wikipedians":{"h":"Wikipedians","l":"wikipedian","q":"noun"},"great-grandfathers":{"h":"great-grandfathers","l":"great-grandfather","q":"noun"},"great-grandmothers":{"h":"great-grandmothers","l":"great-grandmother","q":"noun"},"retries":{"h":"retries","l":"retry","q":"noun"},"retried":{"h":"retried","l":"retry","q":"verb"},"retrying":{"h":"retrying","l":"retry","q":"verb"},"philatelies":{"h":"philatelies","l":"philately","q":"noun"},"communist":{"h":"communist","i":"/ˈkɒ.mjʊ.nɪst/","a":"LL-Q1860 (eng)-Simplificationalizer-communist.wav","s":[{"p":"noun","d":[{"m":"(countable) A communist is a person who supports the political idea of communism, which believes in everyone owning everything (such as property).","e":"was a well-known communist leader."}]},{"p":"adjective","d":[{"m":"When something is communist, it supports the belief of communism."}]}]},"pamphleteer":{"h":"pamphleteer","i":"/ˌpæmfləˈtɪr/","a":"LL-Q1860 (eng)-Eleanorrrrrrrrrr-pamphleteer.wav","s":[{"p":"noun","d":[{"m":"(countable) A pamphleteer is a person who writes pamphlets."}]},{"p":"verb","d":[{"m":"When someone pamphleteers, the person is publishing and pamphlets as a form of propaganda."}]}]},"perish":{"h":"perish","i":"/ˈpɛrɪʃ/","a":"en-us-perish.ogg","s":[{"p":"verb","d":[{"m":"(intransitive) To perish means to die (stop living).","e":"The fire destroyed the building, but luckily nobody inside perished."},{"m":"(intransitive) To perish means to stop existing.","e":"After new laws were created, slavery finally perished in the country."},{"m":"(intransitive) When something perishes, it decays and breaks apart.","e":"The apples perished after being left in the hot car for three days. By that time they were brown and rotten."}]}]},"penetration":{"h":"penetration","i":"/pɛnɪˈtreɪʃ(ə)n/","a":"LL-Q1860 (eng)-Vealhurl-penetration.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Penetration is the action of penetrating into something."},{"m":"(uncountable) Penetration is the penis being inserted into the vagina or another part of the body during sex."}]}]},"objectively":{"h":"objectively","i":"/əbˈdʒɛktɪvli/","s":[{"p":"adverb","d":[{"m":"If you think about something objectively, you are not influenced by emotions or personal prejudices.","e":"If you look at the situation objectively, you will see there is no reason for conflict."}]}]},"novelist":{"h":"novelist","i":"/ˈnɑvəlɪst/","s":[{"p":"noun","d":[{"m":"(countable) A novelist is a person who writes novels, a collection of short stories.","e":"is a famous Russian novelist and has written many novels."}]}]},"nonracial":{"h":"nonracial","s":[{"p":"adjective","d":[{"m":"When something is nonracial, it is not related to a person's race."}]}]},"priestly":{"h":"priestly","s":[{"p":"adjective","d":[{"m":"When something is priestly, it is related to priests or a high religious position."}]}]},"rapist":{"h":"rapist","i":"/ˈreɪ.pɪst/","a":"LL-Q1860 (eng)-Vealhurl-rapist.wav","s":[{"p":"noun","d":[{"m":"(countable) A rapist is a person who has committed one or more acts of rape.","e":"The police went into the house and arrested the rapist after 3 girls reported having been raped by him."}]}]},"reformation":{"h":"reformation","i":"/ˌrɛfəˈmeɪʃn̩/","a":"en-us-reformation.ogg","s":[{"p":"noun","d":[{"m":"A reformation is a change for the better. It is an improvement, a reform or a series of reforms so that there is a better social, political or religious environment."}]}]},"pamphleteers":{"h":"pamphleteers","l":"pamphleteer","q":"noun"},"robin":{"h":"robin","i":"/ˈrɒb.ɪn/","a":"en-us-robin.ogg","s":[{"p":"noun","d":[{"m":"A robin is a type of bird that usually has a red breast. European robins are called whereas American robins are called."}]}]},"republicanism":{"h":"republicanism","s":[{"p":"noun","d":[{"m":"(politics) Republicanism is a political viewpoint favoring a republic as a form of government."},{"m":"(politics) Republicanism is support for the Republican Party of the United States of America."}]}]},"pettiness":{"h":"pettiness","s":[{"p":"noun","d":[{"m":"Pettiness refers to the state or quality of being petty.","e":"The pettiness of the insurance company asking me to take a photo of my injury was unbelievable."}]}]},"peerage":{"h":"peerage","s":[{"p":"noun","d":[{"m":"The peerage of a state means those people who form the aristocracy of that state.","e":"The peerage in the Kingdom of Great Britain and Northern Ireland is represented in the Kingdom's House of Lords."}]}]},"bollock":{"h":"bollock","i":"/ˈbɒlək/","a":"en-au-bollock.ogg","s":[{"p":"verb","d":[{"m":"When you bollock someone, you scold or tell off the person very harshly.","e":"Our boss gave Harry a bollocking today for not submitting his project on time."}]},{"p":"noun","d":[{"m":"(countable) A bollock refers to a single testicle.","e":"My left bollock really hurts."}]}]},"bollocking":{"h":"bollocking","l":"bollock","q":"verb"},"bollocked":{"h":"bollocked","l":"bollock","q":"verb"},"additionally":{"h":"additionally","i":"/əˈdɪʃənəli/","a":"LL-Q1860 (eng)-Vealhurl-additionally.wav","s":[{"p":"adverb","d":[{"m":"; in addition to.","e":"We need you to pay $50 for the school fees. Additionally, $50 will need to be paid in March."}]}]},"shorts":{"h":"shorts","i":"/ʃɔː(r)ts/","s":[{"p":"noun","d":[{"m":"(plural); (uncountable) Shorts are an item of clothing. They are short trousers that reach someone's knees.","e":"It was very hot, so I put on shorts."}]}]},"panties":{"h":"panties","a":"LL-Q1860 (eng)-Wodencafe-panties.wav","s":[{"p":"noun","d":[{"m":"Panties refers to underwear (a piece of clothing) worn by a female."}]}]},"knickers":{"h":"knickers","i":"/ˈnɪkəz/","a":"LL-Q1860 (eng)-Vealhurl-knickers.wav","s":[{"p":"noun","d":[{"m":"Knickers refers to the underwear (a piece of clothing) that is worn by a female."}]}]},"agreeable":{"h":"agreeable","i":"/əˈɡriːəbl/","a":"en-us-agreeable.ogg","s":[{"p":"adjective","d":[{"m":"If something is agreeable, it is nice and good.","e":"Jill is a very agreeable person."}]}]},"disagreeable":{"h":"disagreeable","i":"[dɪsəˈɡri.əbəɫ]","a":"en-us-disagreeable.ogg","s":[{"p":"adjective","d":[{"m":"Not agreeable; not nice and bad.","e":"Alice is disagreeable because she is unfriendly and has a bad temper."}]}]},"unfriendly":{"h":"unfriendly","i":"/ʌnˈfrn(d)li/","a":"en-us-unfriendly.ogg","s":[{"p":"adjective","d":[{"m":"When someone is unfriendly, the person is not friendly and is mean.","e":"I do not understand why Luke is being so unfriendly today."},{"m":"When something is unfriendly, it is not favorable."}]},{"p":"noun","d":[{"m":"(countable) An unfriendly is an enemy, someone that is against you."}]}]},"reappearance":{"h":"reappearance","s":[{"p":"noun","d":[{"m":"Reappearance refers to when something appears again.","e":"She made an unexpected reappearance at the festival this year."}]}]},"reappearances":{"h":"reappearances","l":"reappearance","q":"noun"},"unexpected":{"h":"unexpected","i":"/ʌnɪkˈspɛktɪd/","a":"en-us-unexpected.ogg","s":[{"p":"adjective","d":[{"m":"When something is unexpected, it is not expected. It was not thought that it would happen.","e":"Lisa's surprise visit was unexpected and I was not prepared for it."}]}]},"negligence":{"h":"negligence","i":"/ˈnɛɡlɪd͡ʒəns/","a":"en-us-negligent.ogg","s":[{"p":"noun","d":[{"m":"Negligence is the state of being careless and negligent."},{"m":"(uncountable) Negligence refers to the state or quality of not taking care of the needs of a person or animal or not taking personal responsibility."}]}]},"masturbate":{"h":"masturbate","s":[{"p":"verb","d":[{"m":"When you masturbate, you touch your genitals (penis or vagina) with your hand so that you have sexual pleasure.","e":"She liked to masturbate when she was alone."}]}]},"masturbating":{"h":"masturbating","l":"masturbate","q":"verb"},"masturbates":{"h":"masturbates","l":"masturbate","q":"verb"},"masturbated":{"h":"masturbated","l":"masturbate","q":"verb"},"shrieves":{"h":"shrieves","l":"shrieve","q":"noun"},"baffles":{"h":"baffles","l":"baffle","q":"verb"},"baffled":{"h":"baffled","l":"baffle","q":"verb"},"baffling":{"h":"baffling","l":"baffle","q":"verb"},"patters":{"h":"patters","l":"patter","q":"noun"},"pattered":{"h":"pattered","l":"patter","q":"verb"},"pattering":{"h":"pattering","l":"patter","q":"verb"},"sunnify":{"h":"Sunnify","s":[{"p":"verb","d":[{"m":"(transitive) If you Sunnify an area, you give Sunnism an important role in society.","e":"They are trying to Sunnify Iraq to make it more religiously similar."}]}]},"novelists":{"h":"novelists","l":"novelist","q":"noun"},"philosopher":{"h":"philosopher","i":"/fɪˈlɒs.ə.fə(r)/","a":"LL-Q1860 (eng)-Vealhurl-philosopher.wav","s":[{"p":"noun","d":[{"m":"(countable) A philosopher is a person who studies philosophy and discusses philosophical ideas.","e":"Confucius is a very famous philosopher and his ideas are still being studied today."}]}]},"philosophical":{"h":"philosophical","i":"/ˌfɪləˈsɑfɪkl̩/","a":"LL-Q1860 (eng)-Vininn126-philosophical.wav","s":[{"p":"adjective","d":[{"m":"Of or related to philosophy."}]}]},"prosecution":{"h":"prosecution","s":[{"p":"noun","d":[{"m":"Prosecution is the act of taking legal action against a person, especially criminal action.","e":"The prosecution of Bob was for the rape crimes that he has committed."},{"m":"Prosecution refers to the agency that prosecutes a person in court, especially a person guilty of a criminal offence.","e":"The prosecution of Mike Tyson during his rape trial argued that his victim's injuries made it very unlikely that she had consented to sex with the man."},{"m":"Prosecution refers to the act of carrying out a scheme till the end."}]}]},"prosecute":{"h":"prosecute","i":"/ˈprɒsɪkjuːt/","a":"LL-Q1860 (eng)-Vealhurl-prosecute.wav","s":[{"p":"verb","d":[{"m":"When you prosecute someone, you are taking legal action against a person, especially criminal legal action against the person if he/she has broken the law."},{"m":"When you prosecute something (such as a scheme), you are carrying out or it to the end."}]}]},"philosophers":{"h":"philosophers","l":"philosopher","q":"noun"},"pursuer":{"h":"pursuer","s":[{"p":"noun","d":[{"m":"A pursuer is a person who pursues and tries to fight to get something."}]}]},"pursuers":{"h":"pursuers","l":"pursuer","q":"noun"},"enrage":{"h":"enrage","i":"/ɪnˈreɪd͡ʒ/","a":"LL-Q1860 (eng)-Vealhurl-enrage.wav","s":[{"p":"verb","d":[{"m":"(transitive) When you enrage someone, you fill the person with rage and anger. The person is furious and angry.","e":"The fact that he was betrayed by his close friend enraged him."}]}]},"allegation":{"h":"allegation","i":"/ˌæl.ɪˈɡeɪ.ʃən/","a":"en-us-allegation.ogg","s":[{"p":"noun","d":[{"m":"(countable) An allegation is a claim or a statement that is not proven and may or may not be true.","e":"The statement that our neighbor is a serial killer right now is an unconfirmed allegation."}]}]},"racialist":{"h":"racialist","s":[{"p":"noun","d":[{"m":"A racialist is a person who believes that different races have different abilities and that one race is superior to other races."}]}]},"racialists":{"h":"racialists","l":"racialist","q":"noun"},"refund":{"h":"refund","a":"en-us-refund-verb.ogg","s":[{"p":"verb","d":[{"m":"When you refund someone, you return money to the person or company, usually because the money was not used for the original purpose.","e":"As the product was broken, I gave the customer his refund."}]},{"p":"noun","d":[{"m":"A refund refers to the amount of money that was returned to someone."}]}]},"refunds":{"h":"refunds","l":"refund","q":"verb"},"abruptness":{"h":"abruptness","i":"/əˈbrʌptnəs/","a":"LL-Q1860 (eng)-Vealhurl-abruptness.wav","s":[{"p":"noun","d":[{"m":"(usually singular) The state or quality of being abrupt."}]}]},"pruner":{"h":"pruner","s":[{"p":"noun","d":[{"m":"A pruner is a person who removes things such as twigs from plants."},{"m":"A person who removes a rule or regulation, usually because it is not necessary or unwanted."}]}]},"privatize":{"h":"privatize","i":"/ˈpraɪvətaɪz/","s":[{"p":"verb","d":[{"m":"When a government privatizes something, it removes government control over an industry or a part of the economy, and let people manage it themselves.","e":"Senator Barry Goldwater's proposal to privatize Social Security had received a lot of opposition."},{"m":"When you privatize something (such as a variable or function), you make it private and making it only able to be used internally."}]}]},"protestation":{"h":"protestation","s":[{"p":"noun","d":[{"m":"Protestation is the act of protesting."}]}]},"penalise":{"h":"penalise","i":"/ˈpiː.nəl.aɪz/","a":"en-au-penalize.ogg","s":[{"p":"verb","d":[{"m":"When you penalise someone, you impose a penalty on the person, especially if the person has broken a rule or regulation.","e":