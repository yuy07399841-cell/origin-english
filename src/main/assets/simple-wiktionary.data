":"verb"},"groveling":{"h":"groveling","l":"grovel","q":"verb"},"grovelling":{"h":"grovelling","l":"grovel","q":"verb"},"travesty":{"h":"travesty","i":"/ˈtræv.ɪs.ti/","a":"en-us-travesty.oga","s":[{"p":"noun","d":[{"m":"(singular) A travesty is when something is shockingly unfair or incorrect.","e":"It was a travesty when the artwork was damaged by water."}]},{"p":"verb","d":[{"m":"(transitive) If a person travesties, they make a false representation of something."}]}]},"travesties":{"h":"travesties","l":"travesty","q":"noun"},"travestied":{"h":"travestied","l":"travesty","q":"verb"},"travestying":{"h":"travestying","l":"travesty","q":"verb"},"ingress":{"h":"ingress","i":"/ˈɪnɡrɛs/","a":"en-us-ingress.ogg","s":[{"p":"noun","d":[{"m":"An ingress is the act of entering a place."},{"m":"An ingress is the permission to enter a place."}]}]},"ingresses":{"h":"ingresses","l":"ingress","q":"noun"},"percolated":{"h":"percolated","l":"percolate","q":"verb"},"percolating":{"h":"percolating","l":"percolate","q":"verb"},"percolates":{"h":"percolates","l":"percolate","q":"verb"},"percolation":{"h":"percolation","s":[{"p":"noun","d":[{"m":"Percolation is the act of passing a liquid through a porous substance."}]}]},"percolate":{"h":"percolate","i":"/ˈpɜːkəleɪt/","a":"en-gb-percolate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you percolate a liquid, you pass it through a porous substance."}]}]},"improvident":{"h":"improvident","i":"/ɪmˈprɒvɪdənt/","s":[{"p":"adjective","d":[{"m":"If a person is improvident, they fail to provide or have no plans for future events."}]}]},"desiccate":{"h":"desiccate","i":"/ˈdɛsɪkeɪt/","a":"LL-Q1860 (eng)-Vealhurl-desiccate.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you desiccate something, you remove the moisture from it."}]}]},"desiccates":{"h":"desiccates","l":"desiccate","q":"verb"},"desiccated":{"h":"desiccated","i":"/ˈdɛsɪkeɪtəd/","l":"desiccate","q":"verb","s":[{"p":"adjective","d":[{"m":"If something is desiccated, it has been dried out."}]}]},"desiccating":{"h":"desiccating","l":"desiccate","q":"verb"},"recalcitrant":{"h":"recalcitrant","i":"/rɪ.ˈkæl.sɪ.trənt/","a":"en-au-recalcitrant.ogg","s":[{"p":"adjective","d":[{"m":"A recalcitrant person is someone who is stubborn and unwilling to obey instructions."}]}]},"factoid":{"h":"factoid","i":"/ˈfæktɔɪd/","a":"LL-Q1860 (eng)-Vealhurl-factoid.wav","s":[{"p":"noun","d":[{"m":"(countable) A factoid is something that sounds like it is a true, or something that people say is true, but it is not.","e":"Einstein did not fail math--that is a factoid!"},{"m":"(countable) A factoid is a bit of trivia--a small fun fact.","e":"Would you like to hear a cool factoid?"}]}]},"factoids":{"h":"factoids","l":"factoid","q":"noun"},"redhead":{"h":"redhead","i":"/ˈrɛdˌhɛd/","a":"LL-Q1860 (eng)-Vealhurl-redhead.wav","s":[{"p":"noun","d":[{"m":"(countable) A redhead is a person with red hair."},{"m":"(countable) A redhead is a type of duck."}]}]},"redheads":{"h":"redheads","l":"redhead","q":"noun"},"walker":{"h":"walker","i":"/ˈwɔkɚ/","a":"LL-Q1860 (eng)-Vealhurl-walker.wav","s":[{"p":"noun","d":[{"m":"(countable) A walker is someone who is walking, or going somewhere with their feet.","e":"Jim has walked five miles today; he's a walker!"},{"m":"(usually plural) A walker is a kind of shoe which is good to walk in.","e":"Those shoes are falling apart, let me buy you a new pair of walkers."}]}]},"walkers":{"h":"walkers","l":"walker","q":"noun"},"quietness":{"h":"quietness","s":[{"p":"noun","d":[{"m":"Quietness is the absence of noise; something has quietness if it is very quiet.","e":"I love the quietness of the park."},{"m":"Quietness is the absence of things that are moving or things that are annoying; something has quietness if is very calm"}]}]},"quietnesses":{"h":"quietnesses","l":"quietness","q":"noun"},"proscription":{"h":"proscription","i":"/prəˈskrɪp.ʃən/","s":[{"p":"noun","d":[{"m":"A proscription is something that proscribes--it tells you not to do something.","e":"The casino sent a proscription against cheating to all the players."}]}]},"proscriptions":{"h":"proscriptions","l":"proscription","q":"noun"},"proscribe":{"h":"proscribe","i":"/prəˈskraɪb/","a":"LL-Q1860 (eng)-Vealhurl-proscribe.wav","s":[{"p":"verb","d":[{"m":"(transitive) To proscribe something is to forbid it--to say it is not allowed.","e":"During prohibition in the US, drinking alcohol was proscribed."},{"m":"(transitive) To proscribe something is the opposite of supporting it--to proscribe something is to say that it is bad or that people should not do it.","e":"Many books proscribe the use of the word 'ain't'."}]}]},"proscribes":{"h":"proscribes","l":"proscribe","q":"verb"},"proscribed":{"h":"proscribed","l":"proscribe","q":"verb"},"synod":{"h":"synod","i":"/ˈsɪn.əd/","a":"LL-Q1860 (eng)-Vealhurl-synod.wav","s":[{"p":"noun","d":[{"m":"(countable) A synod is a council or meeting to consult on church matters."}]}]},"synods":{"h":"synods","l":"synod","q":"noun"},"affliction":{"h":"affliction","i":"/əˈflɪkʃən/","a":"en-us-affliction.ogg","s":[{"p":"noun","d":[{"m":"Affliction is the state of pain or suffering."}]}]},"afflictions":{"h":"afflictions","l":"affliction","q":"noun"},"afflict":{"h":"afflict","i":"/əˈflɪkt/","a":"en-us-afflict.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If something or someone afflicts you, it causes you to suffer on be in pain."}]}]},"afflicts":{"h":"afflicts","l":"afflict","q":"verb"},"afflicted":{"h":"afflicted","l":"afflict","q":"verb"},"afflicting":{"h":"afflicting","l":"afflict","q":"verb"},"prohibition":{"h":"prohibition","i":"/ˌprəʊ(h)ɪˈbɪʃən/","a":"en-us-prohibition.ogg","s":[{"p":"noun","d":[{"m":"A prohibition is something that prohibits--it says that something must not be done.","e":"The government's new law is a prohibition on in restaurants."}]}]},"prohibitions":{"h":"prohibitions","l":"prohibition","q":"noun"},"prohibitive":{"h":"prohibitive","i":"/prə(ʊ)ˈhɪbɪtɪv/","a":"en-us-prohibitive.ogg","s":[{"p":"adjective","d":[{"m":"Something is prohibitive if it prohibits often--if it says that many things are not allowed or if it likes to say that things are not allowed.","e":"North Korea is one of the most prohibitive on Earth."},{"m":"Something is prohibitive if it stops you from doing what you want.","e":"I want to buy a boat, but the price is prohibitive."}]}]},"benevolence":{"h":"benevolence","i":"/bəˈnɛvələns/","a":"LL-Q1860 (eng)-Vealhurl-benevolence.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Benevolence is the desire to do good, especially to give things away as charity—for free. If someone has benevolence, they are benevolent.","e":"What I love most about professor Miyahara is his benevolence; he always wants to help his students learn"},{"m":"(countable) A benevolence is a present someone gives away kindly","e":"The king gave benevolences to every one of his courtiers."}]}]},"benevolent":{"h":"benevolent","i":"/bəˈnɛvələnt/","s":[{"p":"adjective","d":[{"m":"If something is benevolent, it wants to do good.","e":"Even though were described as tricksters in fairy tales, in Disney movies, they are benevolent."}]}]},"courtier":{"h":"courtier","i":"/ˈkɔrtiɚ/","s":[{"p":"noun","d":[{"m":"(countable) A courtier is a person who helps a king, queen, prince, or other nobleman in the court.","e":"The queen summoned her favorite courtier. \"Bring me my crown,\" she said."}]}]},"courtiers":{"h":"courtiers","l":"courtier","q":"noun"},"concession":{"h":"concession","i":"/kənˈsɛʃən/","a":"LL-Q1860 (eng)-Vealhurl-concession.wav","s":[{"p":"noun","d":[{"m":"A concession is when someone concedes--they give up or give in to something.","e":"After 10 minutes, the score in the football game was 20-0. The loosing team volunteered their concession."}]}]},"concessions":{"h":"concessions","l":"concession","q":"noun"},"involuntarily":{"h":"involuntarily","i":"/ɪnˌvɑlənˈtɛrɪli/","s":[{"p":"adverb","d":[{"m":"If you do something involuntarily, you do it even though you don't want to, or you do it by accident.","e":"Don't worry, I'm not having a seizure: my arm twitches involuntarily."}]}]},"huskies":{"h":"huskies","l":"husky","q":"noun"},"seizure":{"h":"seizure","i":"/ˈsiʒɚ /","a":"en-us-seizure.ogg","s":[{"p":"noun","d":[{"m":"If someone seizes (takes) something from someone by force, or arrests someone, it is a seizure.","e":"The police captain said that the seizure of the drugs was going to help catch the criminals"},{"m":"(countable) If a person has a seizure, they move around without controlling it and their muscles get tense.","e":"He's on the floor and! I think he's having a seizure!"}]}]},"seizures":{"h":"seizures","l":"seizure","q":"noun"},"convulse":{"h":"convulse","i":"/kənˈvʌls/","a":"LL-Q1860 (eng)-Vealhurl-convulse.wav","s":[{"p":"verb","d":[{"m":"(transitive) If you convulse something, you shake it hard.","e":"He was convulsed with laughter at the movie."},{"m":"(intransitive) If you convulse, you have convulsions--unusual, unintentional and hard movements of your muscles.","e":"This guy's convulsing; I think he's having a seizure!"}]}]},"convulsed":{"h":"convulsed","l":"convulse","q":"verb"},"convulsing":{"h":"convulsing","l":"convulse","q":"verb"},"convulsion":{"h":"convulsion","i":"/kənˈvʌlʃən/","s":[{"p":"noun","d":[{"m":"A convulsion is when someone's muscles contract very hard without the person wanting it.","e":", my arm is having a convulsion! It's so tense and I can't relax it!"},{"m":"A convulsion is when there is a lot of turmoil--if nobody knows what is happening and people are afraid it is a convulsion.","e":"s can cause convulsions because they are so terrifying."}]}]},"ow":{"h":"ow","i":"/ˈaʊ/","a":"en-us-ow.ogg","s":[{"p":"interjection","d":[{"m":"If someone says ow, they are in pain","e":"Ow! Charlie bit my finger!"},{"m":"In music, singers say ow to show that they are feeling strong emotions.","e":"1987, Michael Jackson, (song)"}]}]},"convulsions":{"h":"convulsions","l":"convulsion","q":"noun"},"turmoil":{"h":"turmoil","i":"/ˈtɜːmɔɪl/","a":"en-us-turmoil.ogg","s":[{"p":"noun","d":[{"m":"If there is turmoil, there is confusion and disorder--people do not know what is going on. A group of people may be in turmoil, but one person can have turmoil in their mind as well.","e":"The city was in turmoil when the enemy stormed the gates."}]}]},"prudent":{"h":"prudent","i":"/ˈpruːdənt/","a":"en-us-prudent.ogg","s":[{"p":"adjective","d":[{"m":"If a person is prudent, they think for the future before they act."}]}]},"regiment":{"h":"regiment","i":"/ˈrɛdʒɪmənt/","a":"en-us-regiment.ogg","s":[{"p":"noun","d":[{"m":"(countable) A regiment is a unit of armed troops under the command of an officer that consists of several smaller units."}]}]},"regiments":{"h":"regiments","l":"regiment","q":"noun"},"twitch":{"h":"twitch","i":"/twɪt͡ʃ/","a":"LL-Q1860 (eng)-Vealhurl-twitch.wav","s":[{"p":"noun","d":[{"m":"A twitch is a small movement. If someone has a twitch, it might be on purpose, or it might happen without that person trying to do it.","e":"I saw a twitch in his eye when I mentioned her name."}]},{"p":"verb","d":[{"m":"(intransitive) If something twitches, it is having a twitch--a small movement.","e":"After I played basketball for three hours yesterday, my leg would not stop twitching!"},{"m":"(transitive) If you twitch something, you make it twitch like above.","e":"He wanted me to know he didn't like the food, so he twitched his nose at it."},{"m":"(transitive) If you twitch something, you jerk it hard","e":"Stop twitching my sleeve!"}]}]},"footballer":{"h":"footballer","i":"/ˈfʊtbɔːlə/","a":"LL-Q1860 (eng)-Vealhurl-footballer.wav","s":[{"p":"noun","d":[{"m":"(countable) (soccer) A footballer is someone who plays football."}]}]},"footballers":{"h":"footballers","l":"footballer","q":"noun"},"twitches":{"h":"twitches","l":"twitch","q":"noun"},"twitched":{"h":"twitched","l":"twitch","q":"verb"},"twitching":{"h":"twitching","l":"twitch","q":"verb"},"spaghetti":{"h":"spaghetti","i":"/spəˈɡɛti/","a":"LL-Q1