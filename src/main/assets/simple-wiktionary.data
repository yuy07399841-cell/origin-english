":"noun","d":[{"m":"(countable) A misopedist is a person who hates their own offspring.","e":"The misopedist was bullying her own son."}]}]},"misopedic":{"h":"misopedic","s":[{"p":"adjective","d":[{"m":"If something is misopedic, it is related to hatred of one's own offspring.","e":"She was being really misopedic to her daughters last week."}]}]},"megalomania":{"h":"megalomania","i":"/ˌmɛɡəloʊˈmeɪniə/","s":[{"p":"noun","d":[{"m":"Megalomania is when someone is when someone is obsessed with their ego and having the narcissistic power of social validation; a God complex; a delusion of grandeur.","e":"Her megalomania is the reason she wants to be a politician."}]}]},"megalomaniac":{"h":"megalomaniac","i":"/ˌmɛɡəloʊˈmeɪniæk/","a":"LL-Q1860 (eng)-Flame, not lame-megalomaniac.wav","s":[{"p":"noun","d":[{"m":"(countable) A megalomaniac is someone who is obsessed with their ego and having narcissistic power over social validation; a mimophant.","e":"You should be careful being around that megalomaniac."}]}]},"narcissism":{"h":"narcissism","i":"/ˈnɑːsəˌsɪzm/","a":"LL-Q1860 (eng)-Vininn126-narcissism.wav","s":[{"p":"noun","d":[{"m":"Narcissism is when someone is when someone has extreme admiration for their social validation; a God complex; a delusion of grandeur.","e":"Her narcissism started becoming irritating for those around her."}]}]},"megalomaniacs":{"h":"megalomaniacs","l":"megalomaniac","q":"noun"},"megalomanias":{"h":"megalomanias","l":"megalomania","q":"noun"},"teem":{"h":"teem","i":"/tiːm/","a":"en-uk-teem.ogg","s":[{"p":"verb","d":[{"m":"If a place is teeming, it is filled or overflowing with something."}]}]},"teems":{"h":"teems","l":"teem","q":"verb"},"teemed":{"h":"teemed","l":"teem","q":"verb"},"teeming":{"h":"teeming","l":"teem","q":"verb"},"narcissistic":{"h":"narcissistic","i":"/ˌnɑː.sɪˈsɪs.tɪk/","a":"en-us-narcissistic.ogg","s":[{"p":"adjective","d":[{"m":"Having narcissism or megalomania. If you are narcissistic you need other people to regulate your emoti