"s":[{"p":"noun","d":[{"m":"(countable) A transplant is when a plant is removed and moved somewhere else."},{"m":"(countable) A transplant is a type of surgery in which an organ or a tissue is moved from one body to another, or one part of the body to another.","e":"The patient received a successful heart transplant yesterday."}]},{"p":"verb","d":[{"m":"(transitive) If a plant is transplanted, it is removed and moved somewhere else."},{"m":"(transitive) If an organ or tissue is transplanted, it is moved from one body to another, or one part of the body to another."}]}]},"discern":{"h":"discern","i":"/dɪˈsɜːn/","a":"en-us-discern.ogg","s":[{"p":"verb","d":[{"m":"If you can discern a pattern, difference, or meaning you can notice, see, or identify it.","e":"It can be difficult to discern any pattern when there are so few examples."}]}]},"sextillion":{"h":"sextillion","i":"/sɛks.ˈtɪɫ.jən/","s":[{"p":"determiner","d":[{"m":"(ordinal sextillionth) The number 1,000,000,000,000,000,000,000"}]},{"p":"noun","d":[{"m":"The number 1,000,000,000,000,000,000,000","e":"One thousand quintillion is a sextillion."}]}]},"stepsister":{"h":"stepsister","i":"/ˈstepˌsɪs.tɚ/","a":"LL-Q1860 (eng)-Vealhurl-stepsister.wav","s":[{"p":"noun","d":[{"m":"(countable) Someone's stepsister is the daughter of their stepmother or stepfather.","e":"When my father married again, I got two stepsisters."}]}]},"stepbrother":{"h":"stepbrother","s":[{"p":"noun","d":[{"m":"(countable) Someone's stepbrother is the son of their stepmother or stepfather.","e":"When my mother and I went to live in her new partner's house, I was not an only child anymore: suddenly I had a stepbrother and a stepsister."}]}]},"screwball":{"h":"screwball","i":"/ˈskruːbɔːl/","a":"en-us-screwball.ogg","s":[{"p":"noun","d":[{"m":"(countable) (baseball) A screwball is a type of throw where the ball curves to one side.","e":"Screwballs are often described as being the opposite of curveballs."},{"m":"(countable) A screwball is someone tha