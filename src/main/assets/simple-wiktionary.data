e":{"h":"devastate","i":"/ˈdɛvəsteɪt/","a":"en-us-devastate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If something devastates something else such as a family, a city, or the economy, it partly or completely destroys it.","e":"The economies of several countries were devastated by the war."},{"m":"(transitive) If someone is devastated by a comment or situation, they are very upset by it.","e":"We were devastated by the loss of our son."}]}]},"devastates":{"h":"devastates","l":"devastate","q":"verb"},"devastated":{"h":"devastated","l":"devastate","q":"verb"},"devastating":{"h":"devastating","l":"devastate","q":"verb"},"eternal":{"h":"eternal","a":"en-us-eternal.ogg","s":[{"p":"adjective","d":[{"m":"If something is eternal, it does not end.","e":"God told men they would have eternal life."},{"m":"If you say something is eternal, it feels like it lasts too long.","e":"The walk to the classroom in the morning felt eternal."}]}]},"wale":{"h":"wale","s":[{"p":"noun","d":[{"m":"A wide, thick plank around the outside of a wooden ship."}]}]},"overgrazing":{"h":"overgrazing","s":[{"p":"noun","d":[{"m":"When animals keep eating plants in an area without giving the plants time to grow back."}]}]},"headbutt":{"h":"headbutt","i":"/ˈhɛdbʌt/","a":"en-us-headbutt.ogg","s":[{"p":"verb","d":[{"m":"If you headbutt someone or something, you hit it with your head or forehead.","e":"Soccer players sometimes headbutt each other when angered."}]}]},"moisturizer":{"h":"moisturizer","i":"/ˈmɔɪstʃərʌɪzə/","a":"LL-Q1860 (eng)-Vealhurl-moisturizer.wav","s":[{"p":"noun","d":[{"m":"(countable) A moisturizer is a liquid or lotion that can be put on an object to make it wet or moist.","e":"I put moisturizer on my skin every morning to keep it soft."}]}]},"newly":{"h":"newly","i":"/ˈnuli/","a":"LL-Q1860 (eng)-Vealhurl-newly.wav","s":[{"p":"adverb","d":[{"m":"If something is newly formed, discovered, arrived, etc., then the changed happened not long before.","e":"The female insect deposits its eggs on the newly formed fruit."}]}]},"overgrazings":{"h":"overgrazings","l":"overgrazing","q":"noun"},"moisturizers":{"h":"moisturizers","l":"moisturizer","q":"noun"},"headbutts":{"h":"headbutts","l":"headbutt","q":"verb"},"headbutted":{"h":"headbutted","l":"headbutt","q":"verb"},"headbutting":{"h":"headbutting","l":"headbutt","q":"verb"},"fasten":{"h":"fasten","i":"/ˈfɑːsən/","a":"en-us-fasten.ogg","s":[{"p":"verb","d":[{"m":"(transitive) When you fasten a belt, a coat, a bag, etc., you join the two sides of it so it is closed.","e":"Please remain seated with your seat belts fastened."},{"m":"(transitive) If you fasten one thing to another, you attach them.","e":"The blackboard had been fastened to the front wall for years."},{"m":"(transitive) If you fasten your eyes or gaze on something, you look at it carefully without looking away.","e":"The boy's eyes were fastened on the TV."},{"m":"(intransitive) If something won't fasten, its buttons or hooks won't join.","e":"The shirt was so small that the buttons wouldn't fasten."}]}]},"fastened":{"h":"fastened","i":"/ˈfɑːsn̩d/","a":"en-us-fastened.ogg","l":"fasten","q":"verb"},"fastens":{"h":"fastens","l":"fasten","q":"verb"},"similarity":{"h":"similarity","i":"/sɪmɪˈlærɪti/","a":"LL-Q1860 (eng)-Arlo Barnes-similarity.wav","s":[{"p":"noun","d":[{"m":"(countable) When there is a similarity between things, they are the same in one or more ways.","e":"There is a strong similarity between what happened here and what happened at the other schools."}]}]},"similarities":{"h":"similarities","l":"similarity","q":"noun"},"amiable":{"h":"amiable","i":"/ˈeɪ.mi.ə.bəl/","a":"en-au-amiable.ogg","s":[{"p":"adjective","d":[{"m":"If a person is amiable, they are friendly, pleasant and/or agreeable","e":"Susy's amiable personality makes her easy to get along with."}]}]},"reciprocal":{"h":"reciprocal","i":"/rɪˈsɪprək(ə)l/","a":"en-us-reciprocal.ogg","s":[{"p":"adjective","d":[{"m":"When something is a reciprocal of another, they both are the same in some regard."},{"m":"When something is a reciprocal in mathematics, then it is a fraction where its denominator is swapped for the numerator, and the numerator is swapped with the denominator."}]}]},"conatus":{"h":"conatus","i":"/kəʊˈneɪ.təs/","a":"LL-Q1860 (eng)-Vealhurl-conatus.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Conatus is the drive every living being has to survive, go forward, and better themselves."}]}]},"watermelon":{"h":"watermelon","i":"/ˈwɔːtəˌmɛlən/","a":"en-us-watermelon.ogg","s":[{"p":"noun","d":[{"m":"(countable) A watermelon is a fruit. It is red on the inside and green on the outside. It contains a lot of juice."},{"m":"(uncountable) Watermelon is a pinkish-red colour that is similar to that of watermelon flesh."}]}]},"watermelons":{"h":"watermelons","l":"watermelon","q":"noun"},"satisfactory":{"h":"satisfactory","i":"/sætɪsˈfækt(ə)ri/","a":"en-us-satisfactory.ogg","s":[{"p":"adjective","d":[{"m":"If something is satisfactory, it is good enough.","e":"We can't get the right materials, so the product quality is less than satisfactory."}]}]},"dumbass":{"h":"dumbass","i":"/ˈdʌm.æs/","a":"LL-Q1860 (eng)-Vealhurl-dumbass.wav","s":[{"p":"noun","d":[{"m":"(countable) A dumbass is someone who is foolish or stupid."}]},{"p":"adjective","d":[{"m":"A dumbass person is a foolish, stupid person."}]}]},"dumbasses":{"h":"dumbasses","l":"dumbass","q":"noun"},"horrid":{"h":"horrid","i":"/ˈhɒrɪd/","a":"en-us-horrid.ogg","s":[{"p":"adjective","d":[{"m":"If something is horrid, it causes horror and can be offensive."}]}]},"pawned":{"h":"pawned","l":"pawn","q":"verb"},"pawning":{"h":"pawning","l":"pawn","q":"verb"},"stellations":{"h":"stellations","l":"stellation","q":"noun"},"numb":{"h":"numb","i":"/nʌm/","a":"LL-Q1860 (eng)-Vealhurl-numb.wav","s":[{"p":"adjective","d":[{"m":"If someone is numb, they cannot sense or feel something.","e":"My hand was so cold it went numb."}]}]},"scarab":{"h":"scarab","i":"/ˈskærəb/","a":"LL-Q1860 (eng)-Vealhurl-scarab.wav","s":[{"p":"noun","d":[{"m":"(countable) A sort of dung beetle that was worshipped by the Ancient Egyptians."},{"m":"(countable) A badge made to look like this beetle."}]}]},"scarabs":{"h":"scarabs","l":"scarab","q":"noun"},"stinger":{"h":"stinger","s":[{"p":"noun","d":[{"m":"A stinger is a pointed item at the rear of an insect, for defence. Another name for it is a sting","e":"That wasp has a stinger!"}]}]},"tribe":{"h":"tribe","i":"/traɪb/","a":"en-us-tribe.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tribe is a social group of families and individuals who live together and have a long shared history.","e":"Most of the younger members of the tribe grew up speaking Spanish."}]}]},"moreover":{"h":"moreover","i":"/mɔːˈrəʊ.və/","a":"en-us-moreover.ogg","s":[{"p":"adverb","d":[{"m":"You use morever to show that there is another connected idea.","e":"It was a very long journey. Morever, it was uncomfortable."}]}]},"completion":{"h":"completion","i":"/kəmˈpliːʃən/","a":"LL-Q1860 (eng)-Vealhurl-completion.wav","s":[{"p":"noun","d":[{"m":"Completion is the action from the verb complete.","e":"The completion of the building took two years."}]}]},"roar":{"h":"roar","i":"/rɔː/","a":"en-us-roar.ogg","s":[{"p":"noun","d":[{"m":"(countable) A roar is a loud sound that some animals make, for example lions and tigers","e":"We heard the lion's roar from more than a kilometer away."}]},{"p":"verb","d":[{"m":"If an animal, for example a lion or tiger, roars, then it makes a loud sound.","e":"I felt scared when I heard the tiger roar in the zoo."},{"m":"If a person roars, it means they make a loud shouting sound, similar to a lion or tiger or similar animal."},{"m":"He roared with laughter at the funny joke."}]}]},"messenger":{"h":"messenger","i":"/ˈmɛs.ən.d͡ʒɚ/","a":"en-us-messenger.ogg","s":[{"p":"noun","d":[{"m":"(countable) A messenger is somebody that delivers a message","e":"The messenger told him that there was a meeting tomorrow."}]}]},"everlasting":{"h":"everlasting","i":"/ˌɛvɚˈlæstɪŋ/","a":"en-us-everlasting.ogg","s":[{"p":"adjective","d":[{"m":"If something is everlasting then it lasts forever."}]}]},"fatten":{"h":"fatten","i":"/ˈfætən/","a":"LL-Q1860 (eng)-Vealhurl-fatten.wav","s":[{"p":"verb","d":[{"m":"To fatten something means to cause it to become fatter.","e":"We have to fatten the turkey before we kill it."}]}]},"descent":{"h":"descent","i":"/dɪˈsɛnt/","a":"en-us-descent.ogg","s":[{"p":"noun","d":[{"m":"A descent is the act of going down something, for example a mountain.","e":"Going up the mountain was very tiring, but the descent seemed easier."},{"m":"(countable) A descent is the way down something.","e":"The descent on the east side of the mountain was particularly difficult."},{"m":"A person's descent is where they or their family come from.","e":"The president was of African American descent."}]}]},"tortoise":{"h":"tortoise","i":"/ˈtɔːr.təs/","a":"en-us-tortoise.ogg","s":[{"p":"noun","d":[{"m":"(countable) A tortoise is a type of reptile that lives on land. It walks very slowly and has a shell on its back"}]}]},"sunglasses":{"h":"sunglasses","a":"En-us-sunglasses.ogg","s":[{"p":"noun","d":[{"m":"Sunglasses are objects that people put on their eyes to protect their eyes from the sunlight","e":"You should wear sunglasses if it is a sunny day."}]}]},"snail":{"h":"snail","a":"En-us-snail.ogg","s":[{"p":"noun","d":[{"m":"A snail is a mollusc that moves very slowly. It has a shell on its back."}]}]},"spiderling":{"h":"spiderling","s":[{"p":"noun","d":[{"m":"(countable) A spiderling is a baby spider, or a spider that has not its adult size."}]}]},"abrasive":{"h":"abrasive","i":"/əˈbreɪ.sɪv/","a":"LL-Q1860 (eng)-Vealhurl-abrasive.wav","s":[{"p":"adjective","d":[{"m":"An abrasive substance, it is rough and can cut or scratch."},{"m":"If someone is abrasive, they are rude and unfriendly."}]},{"p":"noun","d":[{"m":"(countable) An abrasive is a rough substance used to clean a hard surface."}]}]},"opener":{"h":"opener","i":"/ˈəʊpənə/","a":"en-au-opener.ogg","s":[{"p":"noun","d":[{"m":"(countable) An opener is a tool for opening a container."}]}]},"roller":{"h":"roller","s":[{"p":"noun","d":[{"m":"A roller is a person or thing that rolls"}]}]},"abrase":{"h":"abrase","s":[{"p":"verb","d":[{"m":"When you abrase something, you rub it so that it becomes clean and smooth.","e":"The edges of this wooden table is getting rough, please use sandpaper to abrase it for me."}]}]},"truly":{"h":"truly","i":"/ˈtruːli/","a":"en-us-truly.ogg","s":[{"p":"adverb","d":[{"m":"You use truly before an adjective to emphasize that something it has all the characteristics of that adjective.","e":"This has become a truly global business."},{"m":"You use truly to emphasize that you are speaking truthfully, that you really meaning it."}]}]},"abrasion":{"h":"abrasion","i":"/əˈbreɪ.ʒn̩/","a":"en-us-abrasion.ogg","s":[{"p":"noun","d":[{"m":"An abrasion is a scraped spot or area."}]}]},"attendant":{"h":"attendant","i":"/əˈtɛndənt/","a":"en-us-attendant.ogg","s":[{"p":"noun","d":[{"m":"(countable) An attendant is a person who attends to do a service"}]},{"p":"adjective","d":[{"m":"Attendant problems, risks, costs, etc. come together with certain changes.","e":"The issue, and its attendant problems, are beginning to get more attention."}]}]},"baseless":{"h":"baseless","i":"/ˈbeɪsləs/","a":"LL-Q1860 (eng)-Vininn126-baseless.wav","s":[{"p":"adjective","d":[{"m":"If charges, claims, accusations, etc. are baseless, they are not supported by reason or fact.","e":"The gold medal winner called the drug charges against him baseless."}]}]},"bureau":{"h":"bureau","i":"/ˈbjʊr.əʊ/","a":"en-us-bureau.ogg","s":[{"p":"noun","d":[{"m":"(countable) A bureau is a large group of business."}]}]},"caravan":{"h":"caravan","i":"/ˈkærəvæn/","a":"en-us-caravan.ogg","s":[{"p":"noun","d":[{"m":"(countable) A caravan is a group of travelers passing through harsh territory."},{"m":"(countable) (UK, Australia, New Zealand, South Africa) A caravan is a furnished vehicle towed behind a car and is used as a dwelling when stationary.","e":"They spent a fishing holiday in a caravan"}]}]},"clementine":{"h":"clementine","i":"/ˈklɛməntaɪn/","a":"LL-Q1860 (eng)-Vealhurl-clementine.wav","s":[{"p":"noun","d":[{"m":"(countable) A clementine is a sweet variety of tangerine with orange red skin."}]}]},"dent":{"h":"dent","i":"/dɛnt/","a":"LL-Q1860 (eng)-Vealhurl-dent.wav","s":[{"p":"noun","d":[{"m":"(countable) A dent is a depression in a surface such as from a blow."}]},{"p":"verb","d":[{"m":"If you dent something, you make a dent in it."}]}]},"eternity":{"h":"eternity","i":"/ɪˈtɜː.nə.ti/","a":"LL-Q1860 (eng)-Vealhurl-eternity.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Eternity is time with no end."},{"m":"(countable) If something takes an eternity, it takes a very long time."}]}]},"ginger":{"h":"ginger","i":"/ˈdʒɪndʒə/","a":"LL-Q1860 (eng)-Vealhurl-ginger.wav","s":[{"p":"noun","d":[{"m":"(uncountable) Ginger is a strongly flavored root used in cooking.","e":"Ginger is used to make gingerbread and ginger beer."},{"m":"Ginger is a brown/red/orange color"},{"m":"(countable) A ginger is someone with reddish brown hair.","e":"Many gingers have freckles."}]}]},"overflow":{"h":"overflow","i":"/ˌəʊvəˈfləʊ/","a":"LL-Q1860 (eng)-Vealhurl-overflow (verb).wav","s":[{"p":"verb","d":[{"m":"If something overflows, it submerges the brim of the container.","e":"The bucket is now wider so the event of an overflow is unlikely."}]}]},"perk":{"h":"perk","i":"/pɝk/","a":"LL-Q1860 (eng)-Vealhurl-perk.wav","s":[{"p":"noun","d":[{"m":"(countable) A perk is an extra bonus or gift","e":"My new job does not have as many perks, like paid vacations."}]},{"p":"verb","d":[{"m":"If someone perks up, they become more cheerful, awake, or attentive.","e":"The sleepy student perked up when the teacher began giving hints for tomorrow's test."}]}]},"unsatisfactory":{"h":"unsatisfactory","i":"/ˌʌnsætɪsˈfækt(ə)ri/","a":"en-us-unsatisfactory.ogg","s":[{"p":"adjective","d":[{"m":"If something is unsatisfactory, it is not good enough.","e":"The team's results have been highly unsatisfactory, so the coach was fired."}]}]},"clementines":{"h":"clementines","l":"clementine","q":"noun"},"caravans":{"h":"caravans","l":"caravan","q":"noun"},"overflowed":{"h":"overflowed","l":"overflow","q":"verb"},"overflows":{"h":"overflows","l":"overflow","q":"verb"},"overflowing":{"h":"overflowing","a":"En-us-overflowing.ogg","l":"overflow","q":"verb"},"dents":{"h":"dents","l":"dent","q":"noun"},"gingers":{"h":"gingers","l":"ginger","q":"noun"},"abrasions":{"h":"abrasions","l":"abrasion","q":"noun"},"attendants":{"h":"attendants","l":"attendant","q":"noun"},"bureaus":{"h":"bureaus","l":"bureau","q":"noun"},"rollers":{"h":"rollers","l":"roller","q":"noun"},"occasional":{"h":"occasional","i":"/əˈkeɪʒənəl/","a":"en-us-occasional.ogg","s":[{"p":"adjective","d":[{"m":"Occasional things happen every now and then, but not often.","e":"Other than occasional attempts to draw him out, she respected his privacy."}]}]},"sling":{"h":"sling","i":"/ˈslɪŋ/","a":"en-au-sling.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sling is a device used to support a hurt part of the body."}]},{"p":"verb","d":[{"m":"If you sling something, you throw it with a circular motion."}]}]},"slings":{"h":"slings","l":"sling","q":"noun"},"instinct":{"h":"instinct","i":"/ˈɪn.stɪŋkt/","a":"en-us-instinct.ogg","s":[{"p":"noun","d":[{"m":"(countable) An instinct is a natural tendency or feeling for a living thing.","e":"My instinct is usually to trust people."}]}]},"instincts":{"h":"instincts","a":"En-us-instincts.ogg","l":"instinct","q":"noun"},"rudder":{"h":"rudder","i":"/ˈrʌdə(r)/","a":"en-us-rudder.ogg","s":[{"p":"noun","d":[{"m":"(countable) A rudder is a blade underwater that is used to steer a ship or boat."},{"m":"(countable) (aeronautics) A rudder is a part of the vertical stabilizer of an aircraft."}]}]},"rudders":{"h":"rudders","l":"rudder","q":"noun"},"claw":{"h":"claw","i":"/klɔː/","a":"en-us-claw.ogg","s":[{"p":"noun","d":[{"m":"(countable) A claw is the sharp part on the toe of an animal.","e":"The cat was mad at me so, it dug its claw into my skin."}]},{"p":"verb","d":[{"m":"If you claw something, you scratch or tear it."}]}]},"claws":{"h":"claws","l":"claw","q":"noun"},"eruption":{"h":"eruption","i":"/ɪˈrʌpʃən/","a":"LL-Q1860 (eng)-Vealhurl-eruption.wav","s":[{"p":"noun","d":[{"m":"(countable) An eruption is when a volcano puts out large amounts of gas and hot rock."},{"m":"(uncountable) Eruption is the state or process of erupting."}]}]},"eruptions":{"h":"eruptions","l":"eruption","q":"noun"},"perks":{"h":"perks","l":"perk","q":"noun"},"perked":{"h":"perked","l":"perk","q":"verb"},"perking":{"h":"perking","l":"perk","q":"verb"},"detergent":{"h":"detergent","i":"/dɪˈtɜːdʒənt/","a":"LL-Q1860 (eng)-Vealhurl-detergent.wav","s":[{"p":"noun","d":[{"m":"Detergent is a cleaning solution often used for washing clothes and dishes."}]},{"p":"adjective","d":[{"m":"When something is detergent, it is able to clean other things."}]}]},"detergents":{"h":"detergents","l":"detergent","q":"noun"},"neighborhood":{"h":"neighborhood","i":"/ˈneɪbə.hʊd/","a":"en-us-neighborhood.ogg","s":[{"p":"noun","d":[{"m":"(countable) A neighborhood is part of a town or city.","e":"They live in an Italian neighborhood on the west side of the city."},{"m":"(countable) Somebody or something's neighborhood is the area, people, or ideas around or near them.","e":"He goes to church on Sundays and has lunch at a restaurant in his neighborhood."}]}]},"neighborhoods":{"h":"neighborhoods","l":"neighborhood","q":"noun"},"stair":{"h":"stair","i":"/stɛər/","a":"en-us-stair.ogg","s":[{"p":"noun","d":[{"m":"(countable) A stair is one flight of steps."}]}]},"blimp":{"h":"blimp","i":"/blɪmp/","a":"LL-Q1860 (eng)-Vealhurl-blimp.wav","s":[{"p":"noun","d":[{"m":"(countable) A blimp is a small airship used for observation."}]}]},"blimps":{"h":"blimps","l":"blimp","q":"noun"},"lantern":{"h":"lantern","i":"/ˈlæntən/","a":"en-us-lantern.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lantern is a light covered by glass that can be carried by a handle."}]}]},"lanterns":{"h":"lanterns","l":"lantern","q":"noun"},"clarinet":{"h":"clarinet","i":"/ˌklærɪˈnɛt/","a":"en-us-clarinet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A clarinet is a musical instrument that is shaped like a tube and is played by blowing into the top of the tube through a special mouthpiece."}]}]},"clarinets":{"h":"clarinets","l":"clarinet","q":"noun"},"bassoon":{"h":"bassoon","i":"/bəˈsuːn/","a":"LL-Q1860 (eng)-Vealhurl-bassoon.wav","s":[{"p":"noun","d":[{"m":"(countable) A bassoon is a large musical instrument that is shaped like a tube, makes low sounds, and is played by blowing into a small, thin tube in its side.","e":"The piece has a bassoon solo."}]}]},"amorphous":{"h":"amorphous","i":"/əˈmɔrfəs/","a":"en-us-amorphous.ogg","s":[{"p":"adjective","d":[{"m":"When something is amorphous, it does not have a specific shape"}]}]},"ellipsis":{"h":"ellipsis","i":"/ɪˈlɪpsɪs/","a":"LL-Q1860 (eng)-Vininn126-ellipsis.wav","s":[{"p":"noun","d":[{"m":"An ellipsis is the punctuation mark written using three dots, sometimes with spaces between them (\"...\"). This -> … is an ellipsis. Ellipses are often used when quoting, by replacing unneeded words or phrases."}]}]},"estimation":{"h":"estimation","i":"/ɛstɪˈmeɪʃən/","a":"en-us-estimation.ogg","s":[{"p":"noun","d":[{"m":"(countable) Estimation is the act or process of."}]}]},"estimations":{"h":"estimations","l":"estimation","q":"noun"},"sandbox":{"h":"sandbox","i":"/ˈsændbɒks/","a":"en-us-sandbox.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sandbox is a small box filled with sand for children to play in.","e":"Go play in the sandbox, Billy."},{"m":"(countable) A sandbox is a place where a computer program can run without affecting other parts of the system."}]}]},"sandboxes":{"h":"sandboxes","l":"sandbox","q":"noun"},"untruth":{"h":"untruth","s":[{"p":"noun","d":[{"m":"(countable) An untruth is a lie or false statement."}]}]},"untruths":{"h":"untruths","l":"untruth","q":"noun"},"oat":{"h":"oat","i":"/əʊt/","a":"en-us-oat.ogg","s":[{"p":"noun","d":[{"m":"Oat is a type of cereal used to make oat bread, flour, cake, etc."}]}]},"oats":{"h":"oats","a":"En-us-oats.ogg","s":[{"p":"noun","d":[{"m":"Oats are an edible grain."}]}]},"grime":{"h":"grime","i":"/ɡraɪm/","a":"LL-Q1860 (eng)-Vealhurl-grime.wav","s":[{"p":"noun","d":[{"m":"Grime is dirt on the surface of something."}]}]},"investor":{"h":"investor","i":"/ɪnˈvɛstɚ/","a":"LL-Q1860 (eng)-Vealhurl-investor.wav","s":[{"p":"noun","d":[{"m":"(countable) An investor is someone who gives money to a business or person in order to receive financial returns."}]}]},"investors":{"h":"investors","a":"En-us-investors.ogg","l":"investor","q":"noun"},"cascade":{"h":"cascade","i":"/kæsˈkeɪd/","a":"en-au-cascade.ogg","s":[{"p":"noun","d":[{"m":"(countable) A cascade is a series of waterfalls over small rocks. Or simply, a waterfall (a fall of water)."}]},{"p":"verb","d":[{"m":"(intransitive) If something cascades, if falls as a waterfall.","e":"Whenever it rains, water will cascade down the roof."},{"m":"(transitive) If you cascade something, you pass it on successfully to others.","e":"s are able to cascade their knowledge effectively."},{"m":"(intransitive) If something is cascading, it occurs as a random sequence."}]}]},"cascades":{"h":"cascades","l":"cascade","q":"noun"},"inactivity":{"h":"inactivity","s":[{"p":"noun","d":[{"m":"Inactivity is the state of being inactive."}]}]},"inactivities":{"h":"inactivities","l":"inactivity","q":"noun"},"contemplate":{"h":"contemplate","i":"/ˈkɒn.təm.ˌpleɪt/","a":"en-us-contemplate.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you contemplate something, you think it over slowly and carefully.","e":"John contemplated how to solve the hard mathematics question."}]}]},"belligerent":{"h":"belligerent","i":"/bəˈlɪdʒ.(ə).rənt/","a":"en-us-belligerent.ogg","s":[{"p":"adjective","d":[{"m":"To be belligerent means to be currently in war."},{"m":"To be belligerent means to be very eager to fight; aggressive.","e":"Do not offend that belligerent man or else he will beat you up!"},{"m":"To be belligerent means to show force towards others."}]},{"p":"noun","d":[{"m":"(countable) A belligerent is a state or nation in war."}]}]},"superfluous":{"h":"superfluous","i":"/suːˈpɝːflu.əs/","a":"En-us-superfluous.ogg","s":[{"p":"adjective","d":[{"m":"If something is superfluous, it is more (or has more) than what is needed.","e":"Since you are walking along a sheltered walkway, having an umbrella with you would be superfluous."}]}]},"blah":{"h":"blah","i":"/blɑː/","a":"LL-Q1860 (eng)-Vealhurl-blah.wav","s":[{"p":"noun","d":[{"m":"(uncountable) (informal) A nonsense, idle, meaningless word."},{"m":"(informal) A feeling of discomfort, boredom, depression etc."}]},{"p":"adjective","d":[{"m":"(informal), uninteresting, boring."}]}]},"deterrence":{"h":"deterrence","i":"/dɪˈtɛrəns/","s":[{"p":"noun","d":[{"m":"(uncountable) Deterrence is actions taken to make other actions less likely."}]}]},"uninteresting":{"h":"uninteresting","s":[{"p":"adjective","d":[{"m":"The opposite of interesting."},{"m":"Very boring or uneventful."}]}]},"jamaican":{"h":"Jamaican","i":"/dʒəˈmeɪkən/","s":[{"p":"noun","d":[{"m":"(countable) A Jamaica is a person or thing that comes from Jamaica."}]},{"p":"adjective","d":[{"m":"Something or someone that is Jamaican comes from Jamaica."}]}]},"pothole":{"h":"pothole","s":[{"p":"noun","d":[{"m":"A pothole is a hole in a road. It is usually caused by erosion."}]}]},"sow":{"h":"sow","i":"/saʊ/","a":"en-us-sow-noun.ogg","s":[{"p":"noun","d":[{"m":"(countable) A sow is an adult female pig."},{"m":"A sow is an ugly, promiscuous woman."}]},{"p":"verb","d":[{"m":"To sow is to put something (usually seeds) into the ground to let it grow."}]}]},"curfew":{"h":"curfew","i":"/ˈkəː.fjuː/","s":[{"p":"noun","d":[{"m":"(countable) A curfew is an order that requires people to be indoors after a certain point at night."}]}]},"curfews":{"h":"curfews","l":"curfew","q":"noun"},"basque":{"h":"Basque","i":"/bɑːsk/","a":"LL-Q1860 (eng)-Vealhurl-Basque.wav","s":[{"p":"proper noun","d":[{"m":"Basque is an language spoken by the Basque people."}]}]},"galician":{"h":"Galician","i":"/ɡəˈlɪs.i.ən/","a":"en-us-Galician.ogg","s":[{"p":"proper noun","d":[{"m":"Galician is a language spoken in Galicia, which is a community in Spain."}]}]},"horizon":{"h":"horizon","i":"/həˈraɪzən/","a":"en-us-horizon.ogg","s":[{"p":"noun","d":[{"m":"(countable) The horizon is the line where the earth or sea seem to meet the sky."}]}]},"horizons":{"h":"horizons","l":"horizon","q":"noun"},"colourful":{"h":"colourful","i":"/ˈkʌlɚfəl/","a":"LL-Q1860 (eng)-Vininn126-colourful.wav","s":[{"p":"adjective","d":[{"m":"Something that is colourful has a lot of colors."},{"m":"If your language is colourful, it is rude.","e":"His language is very colourful."}]}]},"crude":{"h":"crude","i":"/kruːd/","a":"en-us-crude.ogg","s":[{"p":"adjective","d":[{"m":"When an object is crude, it is natural or raw.","e":"Crude oil needs to go through to obtain the components in it."},{"m":"When something is crude, it lacks maturity or is coarse and rude.","e":"The comedian told a crude joke."}]},{"p":"noun","d":[{"m":"If something is crude, it is in its natural state.","e":"Crude oil."}]}]},"unnecessary":{"h":"unnecessary","i":"/ʌnˈnɛ.sə.s(ə)rɪ /, /ʌnˈnɛ.səˌsɛ.rɪ/","a":"En-us-unnecessary.ogg","s":[{"p":"adjective","d":[{"m":"If something is unnecessary, it is not needed.","e":"Do not add unnecessary words to your comprehension answers."}]}]},"trigonometry":{"h":"trigonometry","i":"/ˌtrɪɡəˈnɒmətri/","a":"LL-Q1860 (eng)-Vealhurl-trigonometry.wav","s":[{"p":"noun","d":[{"m":"Trigonometry is mathematical problems that involve angles, triangles and etc."}]}]},"trigonometric":{"h":"trigonometric","s":[{"p":"adjective","d":[{"m":"If something is trigonome