:[{"p":"adjective","d":[{"m":"When a person is frail, they are weak and easy to break down physically and mentally."},{"m":"When an object is frail, it is not firm and easily broken."},{"m":"When a person is frail, they can be very easy to be led into sin."}]},{"p":"noun","d":[{"m":"A frail is a basket made of rushes which is used to put figs or raisins."},{"m":"A frail is also a girl."}]}]},"frailer":{"h":"frailer","l":"frail","q":"adjective"},"frailest":{"h":"frailest","l":"frail","q":"adjective"},"frails":{"h":"frails","l":"frail","q":"noun"},"malfunction":{"h":"malfunction","i":"/ˌmælˈfʌŋk.ʃən/","a":"en-us-malfunction.ogg","s":[{"p":"noun","d":[{"m":"(countable) A malfunction is a bad functioning or failure to function."}]},{"p":"verb","d":[{"m":"When an object (normally machines) malfunction, it functions badly or stop functioning.","e":"The automobile malfunctioned yesterday."}]}]},"malfunctions":{"h":"malfunctions","l":"malfunction","q":"noun"},"malfunctioned":{"h":"malfunctioned","l":"malfunction","q":"verb"},"malfunctioning":{"h":"malfunctioning","l":"malfunction","q":"verb"},"flyover":{"h":"flyover","s":[{"p":"noun","d":[{"m":"A flyover is a low-level flight of a formal nature. (called flypast in British English)"},{"m":"A flyover is a road or railway that passes over another, allowing both routes to cross smoothly."}]}]},"flypast":{"h":"flypast","s":[{"p":"noun","d":[{"m":"A flypast is a low-level flight of a formal nature. (called flyover in American English)"}]}]},"flyovers":{"h":"flyovers","l":"flyover","q":"noun"},"flypasts":{"h":"flypasts","l":"flypast","q":"noun"},"dumbfound":{"h":"dumbfound","i":"/ˌdʌmˈfaʊnd/","a":"en-us-dumbfound.ogg","s":[{"p":"verb","d":[{"m":"To dumbfound means to make someone lost for words."}]}]},"dumbfounding":{"h":"dumbfounding","l":"dumbfound","q":"verb"},"dumbfounded":{"h":"dumbfounded","l":"dumbfound","q":"verb","s":[{"p":"adjective","d":[{"m":"To be dumbfounded is to be shocked and lost for words.","e":"Nathan was left dumbfounded when he did not expect himself to score full marks for his science exams."}]}]},"slacker":{"h":"slacker","i":"/ˈslækɚ/","a":"LL-Q1860 (eng)-Vealhurl-slacker.wav","l":"slack","q":"adjective","s":[{"p":"noun","d":[{"m":"A slacker is someone who likes to do as little work as possible.","e":"Stop being a slacker! We have a lot of work to do."},{"m":"A slacker is someone who does not have a goal in life."}]}]},"slackest":{"h":"slackest","l":"slack","q":"adjective"},"oatmeal":{"h":"oatmeal","i":"/ˈoʊtmil/","a":"LL-Q1860 (eng)-Vealhurl-oatmeal.wav","s":[{"p":"noun","d":[{"m":"Oatmeal is a porridge like meal made of oats."}]}]},"slackers":{"h":"slackers","l":"slacker","q":"noun"},"evident":{"h":"evident","i":"/ˈɛvɪdənt/","a":"en-us-evident.ogg","s":[{"p":"adjective","d":[{"m":"If something is evident it is very easy to realize or understand.","e":"It is evident that he is angry by looking at his facial expression."}]}]},"eyesight":{"h":"eyesight","s":[{"p":"noun","d":[{"m":"(uncountable) Your eyesight is your ability to see.","e":"The motorist lost his eyesight after an accident with a lorry."}]}]},"slate":{"h":"slate","i":"/sleɪt/","a":"LL-Q1860 (eng)-Vealhurl-slate.wav","s":[{"p":"noun","d":[{"m":"(countable) A slate is a type of hard rock that splits easily into thin layers."}]}]},"slates":{"h":"slates","l":"slate","q":"noun"},"arizona":{"h":"Arizona","i":"/ˌærɪˈzoʊnə/","a":"en-us-Arizona.ogg","s":[{"p":"proper noun","d":[{"m":"Arizona is a state in the United States.","e":"Phoenix is the capital of Arizona."}]}]},"arkansas":{"h":"Arkansas","i":"/ˈɑr.kən.sɔ/","a":"en-us-Arkansas.ogg","s":[{"p":"proper noun","d":[{"m":"Arkansas is a state in the United States.","e":"Little Rock is the capital of Arkansas."}]}]},"colorado":{"h":"Colorado","i":"/kɑləˈrɑdoʊ/","a":"en-us-Colorado.ogg","s":[{"p":"proper noun","d":[{"m":"Colorado is a state in the United States.","e":"Denver is the capital of Colorado."}]}]},"gnome":{"h":"gnome","i":"/nəʊm/","a":"LL-Q1860 (eng)-Veal