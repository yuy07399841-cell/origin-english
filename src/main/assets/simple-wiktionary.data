ises":{"h":"raises","a":"en-us-raises.ogg","l":"raise","q":"noun"},"saturations":{"h":"saturations","l":"saturation","q":"noun"},"instruments":{"h":"instruments","i":"/ˈɪnstrəmənts/","a":"en-us-instruments.ogg","l":"instrument","q":"noun"},"incidences":{"h":"incidences","l":"incidence","q":"noun"},"fits":{"h":"fits","a":"en-us-fits.ogg","l":"fit","q":"noun"},"justify":{"h":"justify","i":"/ˈdʒʌstɪfaɪ/","a":"en-us-justify.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you justify something that people think is bad, you explain why it was good or why it had to happen that way.","e":"One problem in music education is always having to justify our existence to other teachers."},{"m":"If the ends justify the means, the way of doing something is bad, but the result is worth it.","e":"He feels that he can lie because the end justifies the means."},{"m":"(transitive) If you justify text, you make the left side of each line of writing line up and the same with the right side."}]}]},"throats":{"h":"throats","l":"throat","q":"noun"},"justifications":{"h":"justifications","l":"justification","q":"noun"},"cushions":{"h":"cushions","l":"cushion","q":"noun"},"anchovies":{"h":"anchovies","l":"anchovy","q":"noun"},"popes":{"h":"popes","l":"pope","q":"noun"},"falls":{"h":"falls","i":"/fɔːlz/","a":"en-us-falls.ogg","l":"fall","q":"noun"},"associates":{"h":"associates","i":"/əˈsoʊʃi.əts/","a":"en-us-associates.ogg","l":"associate","q":"noun"},"loanwords":{"h":"loanwords","l":"loanword","q":"noun"},"movies":{"h":"movies","l":"movie","q":"noun","s":[{"p":"noun","d":[{"m":"The movies is a term for a movie theater.","e":"Let's go to the movies today."}]}]},"chucks":{"h":"chucks","l":"chuck","q":"noun"},"runs":{"h":"runs","i":"/rʌnz/","a":"en-us-runs.ogg","l":"run","q":"noun","s":[{"p":"noun","d":[{"m":"If you have the runs, you have diarrhea"}]}]},"running":{"h":"running","i":"/ˈrʌnɪŋ/","a":"en-us-running.ogg","l":"run","q":"verb"},"exams":{"h":"exams","l":"exam","q":"noun"},"farthest":{"h":"farthest","i":"/ˈfɑrðɪst/","a":"en-us-farthest.ogg","l":"far","q":"preposition"},"complements":{"h":"complements","l":"complement","q":"noun"},"plots":{"h":"plots","l":"plot","q":"noun"},"tins":{"h":"tins","l":"tin","q":"noun"},"attributes":{"h":"attributes","a":"en-us-attributes.ogg","l":"attribute","q":"noun"},"affixes":{"h":"affixes","l":"affix","q":"noun"},"embarrassments":{"h":"embarrassments","l":"embarrassment","q":"noun"},"tablecloths":{"h":"tablecloths","l":"tablecloth","q":"noun"},"hides":{"h":"hides","l":"hide","q":"noun"},"hiding":{"h":"hiding","a":"en-us-hiding.ogg","l":"hide","q":"verb"},"nursing":{"h":"nursing","i":"/ˈnɝsɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-nursing.wav","l":"nurse","q":"verb","s":[{"p":"adjective","d":[{"m":"If a female is nursing, they are their young.","e":"The nursing bear wouldn't move far until her cubs were older."}]},{"p":"noun","d":[{"m":"(uncountable) Nursing is the profession of caring for patients as a nurse.","e":"She went into nursing as a career."}]}]},"grays":{"h":"grays","l":"gray","q":"noun"},"capillaries":{"h":"capillaries","l":"capillary","q":"noun"},"wipes":{"h":"wipes","i":"/waɪps/","l":"wipe","q":"noun"},"carbons":{"h":"carbons","l":"carbon","q":"noun"},"buoys":{"h":"buoys","l":"buoy","q":"noun"},"samples":{"h":"samples","l":"sample","q":"noun"},"insides":{"h":"insides","l":"inside","q":"noun"},"cuttings":{"h":"cuttings","l":"cutting","q":"noun"},"tons":{"h":"tons","i":"/tʌnz/","a":"en-us-tons.ogg","l":"ton","q":"noun","s":[{"p":"noun","d":[{"m":"; a lot.","e":"I can't go to the movie with you on Saturday because I have tons of homework to do this weekend."}]}]},"gracing":{"h":"gracing","l":"grace","q":"verb"},"crops":{"h":"crops","i":"/krɒps/","a":"en-us-crops.ogg","l":"crop","q":"noun"},"dressing":{"h":"dressing","i":"/ˈdrɛsɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-dressing.wav","l":"dress","q":"verb","s":[{"p":"noun","d":[{"m":"Something put on a wound to protect it."},{"m":"Dressing is a sauce that is put on salads or other foods."},{"m":"A bread-based food that is put on or around a turkey."},{"m":"Something added to the soil as a fertilizer etc."},{"m":"The activity of getting dressed.","e":"He liked dressing up in fancy costumes."}]}]},"rehearsing":{"h":"rehearsing","l":"rehearse","q":"verb"},"centres":{"h":"centres","l":"centre","q":"noun"},"middles":{"h":"middles","l":"middle","q":"noun"},"hourly":{"h":"hourly","i":"/ˈaʊ̯əli/","a":"LL-Q1860 (eng)-Vealhurl-hourly.wav","s":[{"p":"adjective","d":[{"m":"If something is hourly, then it happens once every hour.","e":"That train stops here hourly."}]},{"p":"noun","d":[{"m":"An hourly is something that is made every hour."}]}]},"hourlies":{"h":"hourlies","l":"hourly","q":"noun"},"purer":{"h":"purer","l":"pure","q":"adjective"},"purest":{"h":"purest","l":"pure","q":"adjective"},"collapses":{"h":"collapses","l":"collapse","q":"noun"},"undoing":{"h":"undoing","i":"/ʌnˈduːɪŋ/","a":"LL-Q1860 (eng)-AnotherFriendlyHuman-undoing.wav","l":"undo","q":"verb","s":[{"p":"noun","d":[{"m":"(usually singular) Somebody's undoing is the thing that causes them major problems, causes them to fail, or causes them to be discovered.","e":"He left behind a laptop computer loaded with details that would prove to be his undoing."}]}]},"environments":{"h":"environments","l":"environment","q":"noun"},"interacts":{"h":"interacts","l":"interact","q":"noun"},"graver":{"h":"graver","l":"grave","q":"adjective"},"undoings":{"h":"undoings","l":"undoing","q":"noun"},"lack":{"h":"lack","i":"/lak/","a":"en-us-lack.ogg","s":[{"p":"noun","d":[{"m":"(usually singular) If there is a lack of something, there is not enough of it or it doesn't exist at all.","e":"He was frustrated by the lack of progress."}]},{"p":"verb","d":[{"m":"(transitive) If you lack something, you don't have it, or you don't have enough of it.","e":"He lacked the time and expertise to get the job done."},{"m":"(formal) (intransitive) If you lack for something, you don't have it, or you don't have enough of it.","e":"She had never lacked for anything in her life."}]}]},"typewriter":{"h":"typewriter","i":"[ˈtaɪpˌraɪtə(r)]","a":"en-us-typewriter.ogg","s":[{"p":"noun","d":[{"m":"(countable) A typewriter is a machine used to type words by pressing keys that put ink onto paper."}]}]},"heroes":{"h":"heroes","l":"hero","q":"noun"},"seventh":{"h":"seventh","i":"/sɛv.nθ/","a":"en-us-seventh.ogg","s":[{"p":"adjective","d":[{"m":"The seventh thing is the one that is number seven (7) in order.","e":"There are six people in front of me in the queue. I'm the seventh."}]},{"p":"noun","d":[{"m":"(countable) A seventh of something is one of seven equal parts of that thing.","e":"Ten is one seventh of seventy."}]}]},"pan":{"h":"pan","i":"/pæn/","a":"en-us-pan.ogg","s":[{"p":"noun","d":[{"m":"(countable) A pan is a metal container usually with one long handle. It is used for cooking."},{"m":"(countable) A normally circular container with sloped sides and a large surface area."},{"m":"(countable) The contents of a pan."}]},{"p":"verb","d":[{"m":"To turn horizontally (especially with a camera)."}]}]},"pans":{"h":"pans","l":"pan","q":"noun"},"submission":{"h":"submission","i":"/səbˈmɪʃən/","a":"en-us-submission.ogg","s":[{"p":"noun","d":[{"m":"(countable) A submission is something that you give to somebody to be checked or accepted."},{"m":"Submission is the act of accepting that somebody has power over you."}]}]},"submissions":{"h":"submissions","l":"submission","q":"noun"},"sevenths":{"h":"sevenths","l":"seventh","q":"noun"},"incomplete":{"h":"incomplete","i":"/ɪn.kəm.ˈpliːt/","a":"en-us-incomplete.ogg","s":[{"p":"adjective","d":[{"m":"If something is incomplete, it is not finished.","e":"Sam's homework was incomplete as he had missed out question two."}]}]},"landlord":{"h":"landlord","i":"/ˈlænd.lɔːd/","a":"en-au-landlord.ogg","s":[{"p":"noun","d":[{"m":"(countable) A landlord is a person that owns living space and rents it to people (called tenants).","e":"For an extra thirty dollars a month the landlord rented him the two upstairs rooms, a toilet in the middle of one, as a one-bedroom apartment."}]}]},"lane":{"h":"lane","i":"/leɪn/","a":"en-us-lane.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lane is one part of the road that cars traveling in one direction stay in, usually divided by white or yellow paint from other lanes.","e":"Widening traffic lanes from 9.5 to 10 or 11 feet reduces car crashes."},{"m":"(countable) A lane is a small country road, also used in the name of many small roads.","e":"We walked slowly along quiet back roads and narrow, tree-lined lanes."}]}]},"dryers":{"h":"dryers","l":"dryer","q":"noun"},"photocopiers":{"h":"photocopiers","l":"photocopier","q":"noun"},"hypothetical":{"h":"hypothetical","i":"/ˌhaɪpəˈθɛtɪkl/","a":"LL-Q1860 (eng)-Vealhurl-hypothetical.wav","s":[{"p":"adjective","d":[{"m":"If something is hypothetical, it is based on a hypothesis or a guess."}]},{"p":"noun","d":[{"m":"A hypothetical situation.","e":"These hypotheticals serve no purpose until we have more information."}]}]},"leaflet":{"h":"leaflet","i":"/ˈliːflɪt/","a":"en-us-leaflet.ogg","s":[{"p":"noun","d":[{"m":"(countable) A leaflet is piece of paper or a small book, usually given away for free.","e":"People were distributing leaflets about the dangers of cell-phone use."},{"m":"(countable) A leaflet is a small leaf or a leaf-like part of a leaf."}]}]},"league":{"h":"league","i":"/liːɡ/","a":"en-us-league.ogg","s":[{"p":"noun","d":[{"m":"(countable) A league is a group of sports teams that play against each other.","e":"Rodriguez won the American League most-valuable-player award in 2003 and 2005."},{"m":"(countable) A league is a group of people who have joined together to promote a similar idea.","e":"The League of Conservation Voters is one of the largest and most political environmental groups in the country."},{"m":"If you are not in the same league as somebody else, they are much better than or different from you.","e":"The Toyota Corolla is not even in the same league as the beautiful new Jaguar."},{"m":"If you are out of your league, you're trying something too difficult for you."},{"m":"If you are in league with somebody, you are working with them, usually in secret and for a bad reason."},{"m":"(countable) A league is a distance of 4,828 metres on land or 5,556 metres at sea."}]}]},"leaflets":{"h":"leaflets","l":"leaflet","q":"noun"},"literal":{"h":"literal","i":"/ˈlɪt(ə)rəl/","a":"LL-Q1860 (eng)-Mélange a trois-literal.wav","s":[{"p":"adjective","d":[{"m":"The literal meaning of a word or phrase is the plain meaning: exactly what it says.","e":"It is not enough to understand the literal meaning of speech."}]}]},"dutch":{"h":"Dutch","i":"/dʌtʃ/","a":"en-uk-Dutch.ogg","s":[{"p":"proper noun","d":[{"m":"The main language of the Netherlands and Flanders (i.e., the northern half of Belgium)."},{"m":"The Dutch are the people of the Netherlands."}]},{"p":"adjective","d":[{"m":"Something that is related to the Netherlands."},{"m":"Something that is related to the Dutch people."},{"m":"Something that is related to the Dutch language."}]}]},"lorry":{"h":"lorry","i":"/ˈlɒri/","s":[{"p":"noun","d":[{"m":"(countable) A lorry is a large vehicle for carrying goods, materials and equipment.","e":"The lorry driver was taking a load of soft drinks to shops when the accident happened."}]}]},"ducked":{"h":"ducked","i":"/dʌkt/","l":"duck","q":"verb"},"ate":{"h":"ate","i":"/eɪt/","a":"en-us-ate.ogg","l":"eat","q":"verb"},"eaten":{"h":"eaten","i":"/'iːtən/","a":"en-us-eaten.ogg","l":"eat","q":"verb"},"ducking":{"h":"ducking","i":"/ˈdʌkɪŋ/","a":"en-au-ducking.ogg","l":"duck","q":"verb"},"coined":{"h":"coined","l":"coin","q":"verb"},"eating":{"h":"eating","i":"/iːtɪŋ/","a":"en-us-eating.ogg","l":"eat","q":"verb"},"winds":{"h":"winds","l":"wind","q":"noun"},"winding":{"h":"winding","i":"/ˈwaɪndɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-winding1.wav","l":"wind","q":"verb"},"needs":{"h":"needs","i":"/niːdz/","a":"LL-Q1860 (eng)-Back ache-needs.wav","l":"need","q":"noun"},"needed":{"h":"needed","i":"/ˈniːdɪd/","a":"en-us-needed.ogg","l":"need","q":"verb"},"needing":{"h":"needing","l":"need","q":"verb"},"hangs":{"h":"hangs","l":"hang","q":"verb"},"mangos":{"h":"mangos","l":"mango","q":"noun"},"beats":{"h":"beats","l":"beat","q":"noun"},"beaten":{"h":"beaten","i":"/'bitən/","a":"en-us-beaten.ogg","l":"beat","q":"verb"},"beating":{"h":"beating","i":"/ˈbiːtɪŋ/","a":"en-us-beating.ogg","l":"beat","q":"verb","s":[{"p":"noun","d":[{"m":"Beating is a stroke; a blow."}]}]},"bitten":{"h":"bitten","i":"/ˈbɪtən/","a":"LL-Q1860 (eng)-Vealhurl-bitten.wav","l":"bite","q":"verb"},"biting":{"h":"biting","i":"/ˈbaɪtɪŋ/","a":"LL-Q1860 (eng)-Vealhurl-biting.wav","l":"bite","q":"verb","s":[{"p":"adjective","d":[{"m":"Something that is biting causes a stinging feeling.","e":"a biting wind"},{"m":"Something that is biting is hurtful or sharp.","e":"a biting criticism"},{"m":"Something that is biting tends to bite.","e":"a biting insect"}]}]},"interprets":{"h":"interprets","l":"interpret","q":"verb"},"interpreted":{"h":"interpreted","a":"en-us-interpreted.ogg","l":"interpret","q":"verb"},"interpreting":{"h":"interpreting","l":"interpret","q":"verb"},"lump":{"h":"lump","i":"/lʌmp/","a":"en-us-lump.ogg","s":[{"p":"noun","d":[{"m":"(countable) A lump is a small hard part of something smooth, soft, or continuous.","e":"She felt the lump in her throat getting bigger and becoming even more painful."},{"m":"(countable) A lump is a person who is not active or clever.","e":"Come on, let's go. Don't be such a lump."},{"m":"If you take your lumps, bad things happen to you.","e":"He isn't the only member of the organization who has taken his lumps this year."}]},{"p":"verb","d":[{"m":"To treat different things as the same thing or as part of the same group.","e":"People tend to lump turtles and tortoises together, when in fact they are different animals."}]}]},"accommodates":{"h":"accommodates","l":"accommodate","q":"verb"},"accommodated":{"h":"accommodated","l":"accommodate","q":"verb"},"accommodating":{"h":"accommodating","i":"/əˌkɒməˈdeɪtɪŋ/","l":"accommodate","q":"verb","s":[{"p":"adjective","d":[{"m":"to help or please;."}]}]},"accompanies":{"h":"accompanies","l":"accompany","q":"verb"},"accompanied":{"h":"accompanied","i":"/əˈkʌmpənid/","a":"en-us-accompanied.ogg","l":"accompany","q":"verb"},"accompanying":{"h":"accompanying","i":"/əˈkʌm.p(ə.)ni.ɪŋ/","a":"en-us-accompanying.ogg","l":"accompany","q":"verb"},"accounted":{"h":"accounted","i":"/əˈkaʊntɪd/","a":"en-us-accounted.ogg","l":"account","q":"verb"},"achieves":{"h":"achieves","i":"/əˈtʃiːvz/","l":"achieve","q":"verb"},"achieved":{"h":"achieved","i":"/əˈtʃiːvd/","l":"achieve","q":"verb"},"achieving":{"h":"achieving","i":"/əˈtʃiːvɪŋ/","l":"achieve","q":"verb"},"acknowledges":{"h":"acknowledges","l":"acknowledge","q":"verb"},"acknowledged":{"h":"acknowledged","a":"en-us-acknowledged.ogg","l":"acknowledge","q":"verb"},"acknowledging":{"h":"acknowledging","l":"acknowledge","q":"verb"},"acquires":{"h":"acquires","l":"acquire","q":"verb"},"acquired":{"h":"acquired","i":"/əˈkwaɪrd/","a":"en-us-acquired.ogg","l":"acquire","q":"verb"},"acquiring":{"h":"acquiring","i":"/əˈkwaɪ(ə)rɪŋ/","l":"acquire","q":"verb"},"recognise":{"h":"recognise","i":"/ˈrɛkəgnaɪz/","a":"en-us-recognize.ogg","s":[{"p":"verb","d":[{"m":"If you recognise something, you realise what it is.","e":"I don't recognise him. Is he a friend of yours?"},{"m":"If something is recognised, it is accepted.","e":"You have to recognise that you can't be right all the time."},{"m":"If something is recognised, it is given an award.","e":"John was recognised for his achievements as a scientist."}]}]},"ma":{"h":"ma","i":"/mɑː/","a":"en-us-ma.ogg","s":[{"p":"noun","d":[{"m":"Some people sometimes refer or address to their mother as ma.","e":"Ma was still at work when I got back."}]}]},"mas":{"h":"mas","l":"ma","q":"noun"},"exponent":{"h":"exponent","i":"/ɛkˈspəʊnənt/","a":"LL-Q1860 (eng)-Vealhurl-exponent.wav","s":[{"p":"noun","d":[{"m":"(countable) An exponent is the number of times something is multiplied by itself.","e":"\"3\" is the exponent in x^3."}]}]},"exponents":{"h":"exponents","l":"exponent","q":"noun"},"madam":{"h":"madam","i":"/ˈmædəm/","a":"en-au-madam.ogg","s":[{"p":"noun","d":[{"m":"(countable) (formal) Madam is used to call or talk to a woman.","e":"Madam C.J. Walker became the nation's first self-made female millionaire."},{"m":"(countable) A madam is a woman who is in charge of a brothel."}]}]},"maintain":{"h":"maintain","i":"/meɪnˈteɪn/","a":"en-us-maintain.ogg","s":[{"p":"verb","d":[{"m":"(transitive) If you maintain something, you keep it at the same level.","e":"Who's more likely to maintain the status quo?"},{"m":"(transitive) If you maintain something, you say or write that it's a fact.","e":"Ford maintains the cars are safe."},{"m":"(transitive) If you maintain a machine, you keep it working well and fix it when it breaks.","e":"There was lots of money to buy the machines, but no money was available to maintain them."}]}]},"madams":{"h":"madams","l":"madam","q":"noun"},"pets":{"h":"pets","l":"pet","q":"noun"},"margin":{"h":"margin","i":"/ˈmɑːdʒɪn/","a":"en-us-margin.ogg","s":[{"p":"noun","d":[{"m":"(countable) A margin is the space on the sides of a page where there is no writing.","e":"If you own the book, write notes in the margin."},{"m":"(countable) A margin is the difference between what the winner has and what the loser has.","e":"The team won every game with an average 24-point victory margin per game."},{"m":"(countable) A margin is the difference between what a business pays for something and what it sells it for.","e":"The current profit margins on those products run between 55 and 62 percent."},{"m":"(countable) A margin is extra time, room, money, etc. that you plan for in case something needs more.","e":"There's almost no margin for error with the landing the plane."},{"m":"(countable) A margin of error is the amount that the true value varies from the measured value.","e":"The poll had a margin of error of plus or minus 4 percentage points."},{"m":"If somebody is on the margin(s), they are not a central member and have little power."}]}]},"petted":{"h":"petted","l":"pet","q":"verb"},"petting":{"h":"petting","i":"/ˈpɛtɪŋ/","a":"LL-Q1860 (eng)-Persent101-petting.wav","l":"pet","q":"verb","s":[{"p":"noun","d":[{"m":"Petting is the act of kissing, a person in a sexual manner."}]}]},"toyed":{"h":"toyed","l":"toy","q":"verb"},"toying":{"h":"toying","l":"toy","q":"verb"},"maintained":{"h":"maintained","a":"en-us-maintained.ogg","l":"maintain","q":"verb"},"maintaining":{"h":"maintaining","a":"en-us-maintaining.ogg","l":"maintain","q":"verb"},"troll":{"h":"troll","i":"/trəʊl/","a":"En-au-troll.ogg","s":[{"p":"noun","d":[{"m":"A monster in stories that looks something like a human but a different size, and very ugly, that lives in caves or hills or under bridges.","e":"A magic troll lives under the bridge and stops anyone who tries to cross it."},{"m":"(internet) A person who posts a comment to try to make other people angry and to cause trouble (drama and disruption)."}]},{"p":"verb","d":[{"m":"(intransitive) To disrupt the operation of an online community."}]}]},"stripe":{"h":"stripe","i":"/straɪp/","a":"en-ca-stripe.ogg","s":[{"p":"noun","d":[{"m":"(countable) A long, thin part of something which is a different colour from the parts beside it.","e":"A zebra has black and white stripes."}]},{"p":"verb","d":[{"m":"(transitive) To mark with stripes."}]}]},"skeptic":{"h":"skeptic","i":"/ˈskɛp.tɪk/","a":"en-us-skeptic.ogg","s":[{"p":"noun","d":[{"m":"(countable) A skeptic is a person who doesn't believe things before seeing very good reasons to believe them.","e":"I'm a skeptic, so I don't believe things just because they're in the newspaper."}]}]},"meme":{"h":"meme","i":"/miːm/","a":"en-us-meme.ogg","s":[{"p":"noun","d":[{"m":"(countable) A meme is an idea that one person can pass to another person by talking about it or by showing them. It can be a thought, idea, song, dance, a way of doing things, etc."},{"m":"(countable) A meme is a picture (or video or other thing) with funny words on it, that is sent to many people."}]}]},"idiots":{"h":"idiots","l":"idiot","q":"noun"},"pinch":{"h":"pinch","i":"/pɪntʃ/","a":"en-us-pinch.ogg","s":[{"p":"verb","d":[{"m":"To squeeze or press between two things in a painful or uncomfortable way."},{"m":"To steal."},{"m":"To arrest."}]},{"p":"noun","d":[{"m":"A very small amount.","e":"The sauce just needs a pinch of oregano and it will be perfect."},{"m":"An awkward or stressful situation.","e":"A true friend will always help you in a pinch."}]}]},"mayor":{"h":"mayor","i":"/ˈmeɪ.ɚ/","a":"en-us-mayor.ogg","s":[{"p":"noun","d":[{"m":"(countable) A mayor is the government leader of a village, town, or city.","e":"Next November, city council and Mayor Arakawa are up for reelection."}]}]},"mere":{"h":"mere","i":"/mɪə/","a":"en-us-mere.ogg","s":[{"p":"adjective","d":[{"m":"You use mere to show how small or unimportant something is or seems to be.","e":"A mere 1% increase in pay made little difference."}]}]},"merest":{"h":"merest","l":"mere","q":"adjective"},"chased":{"h":"chased","i":"/t͡ʃeɪst/","a":"LL-Q1860 (eng)-Vealhurl-chased.wav","l":"chase","q":"verb"},"chasing":{"h":"chasing","l":"chase","q":"verb"},"astronomies":{"h":"astronomies","l":"astronomy","q":"noun"},"shares":{"h":"shares","i":"/ʃɛrz/","a":"LL-Q1860 (eng)-I learned some phrases-shares.wav","l":"share","q":"verb"},"shared":{"h":"shared","i":"/ˈʃɛə(r)d/","a":"en-us-shared.ogg","l":"share","q":"verb"},"sharing":{"h":"sharing","i":"/ˈʃɛrɪŋ/","l":"share","q":"verb"},"passes":{"h":"passes","a":"en-us-passes.ogg","l":"pass","q":"verb"},"passing":{"h":"passing","a":"en-us-passing.ogg","l":"pass","q":"verb"},"perfects":{"h":"perfects","l":"perfect","q":"verb"},"perfected":{"h":"perfected","l":"perfect","q":"verb"},"perfecting":{"h":"perfecting","l":"per